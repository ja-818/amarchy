#!/usr/bin/env python3
"""amarchy: parallel Claude Code sessions, one git worktree each, as part of the desktop.

Every session is a branch + worktree off the latest main, with a Claude Code
window and a dev terminal, living on its own Hyprland workspace "A:<id>".
Claude sits in a centered column with your sessions listed in the gap to its
left and the session's terminal in the gap to its right. Zen mode (amarchy
zen) leaves Claude alone in the column, with the sessions under the Ⓐ in the
Omarchy bar; asking for the terminal brings the panels back.

Every action in the UI is one of these commands, so scripts and agents can do
anything you can. Commands print results to stdout and fail with a non-zero exit.

  amarchy help [command]                this, or the usage of one command (also amarchy <command> --help)

Projects (git repos directly inside AMARCHY_WORK):
  amarchy projects [--json]             your projects and their session counts
  amarchy projects --github [--json]    your GitHub repos (✓ = already added)
  amarchy add <owner/repo|git url>      clone a project (prints its path)
  amarchy add --new <name> [--github]   start an empty project (and a private GitHub repo)
  amarchy add                           start a new project interactively (New project in the menu)

Sessions:
  amarchy new [project] [name]          create a session (menu without a project; name like wobbly-bakunin if omitted);
                                        prints its id
  amarchy new <project> [name] --prompt <text|->
                                        the same, with the first thing its Claude is asked (- reads it from stdin)
  amarchy new <project> [name] --no-jump [--prompt <text|->]
                                        the same, out of sight: it shows up in the list and the screen
                                        stays where it is (for starting sessions from a script or agent)
  amarchy list [--compact]              sessions as JSON, in list order (task, age, current, and agent: the
                                        name its Claude goes by for other Claude sessions' SendMessage)
  amarchy open                          go to the last session you were in (nothing if already in one)
  amarchy next | prev                   go down | up one session in the list (wraps around)
  amarchy jump <id>                     go to a session
  amarchy close [id] [--force]          close a session (current one if no id); --force discards uncommitted changes
  amarchy close [id] --confirm          the same, asking first in the Omarchy menu
  amarchy rename [title]                name the current session (asks in the Omarchy menu if omitted)
  amarchy rename --id <id> [title]      the same for another session; --reset goes back to the one made from Claude's title
  amarchy zen [on|off]                  toggle zen mode: Claude alone, without the sessions and the terminal beside it
  amarchy terminal [on|off]             move the keyboard between Claude and the terminal (leaves zen mode)
  amarchy run                           run the project in the session's terminal (again: restart it; leaves zen mode)
  amarchy run --show | --set [command]  the project's run command (guessed from the repo until you set one)
  amarchy run <name>                    run another saved command of the project, the same way
  amarchy run --save <name> [command]   save one (asks for the command if omitted); --forget <name> drops it
  amarchy run --list                    the project's saved commands, name and command
  amarchy run --pick                    choose one in the Omarchy menu, or save a new one there
  amarchy show                          open the session list under the Ⓐ in the bar, from anywhere
  amarchy search                        type to find a session by name: the list beside Claude, or under the Ⓐ
  amarchy pick [close]                  choose a session in the Omarchy menu, jump to it (or close it)
  amarchy menu                          everything you can do from here, in a menu (Amarchy in Super+Space too)
  amarchy menu --json | --omarchy       that menu as the card under the Ⓐ draws it / as Omarchy menu entries
  amarchy priority [high|normal|low|up|down] [--id <id>]
                                        how much the session matters (prints it without a level): the
                                        list puts higher priority first, unless it's sorted by date;
                                        new sessions are normal
  amarchy group [project|priority|status] [on|off]
                                        group the list by project, priority (High, Normal, Low) and/or
                                        status (Needs you, Working, Idle), nested in the order you
                                        turn them on (a new one goes inside the others); without
                                        on|off switches it, without anything prints the grouping
                                        outermost first; `group none` drops them all
  amarchy group <grouping> <grouping>...
                                        group by these, nested in this order, outermost first, e.g.
                                        `group priority project`: each priority, its projects inside
  amarchy sort [priority|newest|oldest] sort the list inside its groups: by priority (the default),
                                        or by when the session was opened; prints it without one

Sleep (a session you're not using lets go of its Claude Code, and its memory, until you type in it;
nothing on screen changes, and what you type goes to Claude when it's back):
  amarchy sleep [id] [--force]          put a session to sleep (current one if no id); it says why not when
                                        something would be lost, and --force does it anyway
  amarchy sleep --all [--force]         every session that can sleep, except the one on screen
  amarchy sleep --after [minutes|off]   how long a session sits idle off screen before it sleeps on its
                                        own (default 1; prints it without a value)
  amarchy wake [id]                     wake a session without typing in it

Theme (amarchy in its own Omarchy theme, the rest of the desktop in yours):
  amarchy theme                         pick it in Omarchy's theme switcher (the one with previews); System comes first
  amarchy theme <name> | system         set it (any theme from `omarchy theme list`), or look like the rest of the desktop
  amarchy theme --show                  print it
  amarchy theme --refresh               put it back after something else repainted (Omarchy's theme-set hook runs this)

Keys (the modifiers of amarchy's keys in Hyprland; the rest is set in hypr/amarchy.lua):
  amarchy keys                          pick them in the Omarchy menu, each with what it would clash with
  amarchy keys inside|anywhere <mod>    set one: inside for the keys in amarchy (default "CTRL + ALT"), anywhere
                                        for Open and New session (default "SUPER + ALT"), e.g. "CTRL + SHIFT"
  amarchy keys --show                   print both, as bound now
  amarchy keys reset                    back to hypr/amarchy.lua (your `amarchy` table there, or the defaults)

Sound (the chime of a notification, when a session needs you or is done):
  amarchy sound                         pick it in a menu where each one plays as the cursor lands on it
  amarchy sound <name> | off            set it (one of --list, or off for none)
  amarchy sound --show                  print it
  amarchy sound --list [--json]         every sound: amarchy's, then yours from ~/.config/amarchy/sounds
  amarchy sound --play [name] | --stop  hear one (the one set now without a name), cutting off the one before
  amarchy sound --add                   open the folder your own sounds go in

Remote (sessions on a machine that's always on, e.g. a server, so they go on working with this one
asleep; that machine runs amarchy too, installed with ./install.sh --host):
  amarchy remote <ssh host>             new sessions start there: same list, keys and windows, each window
                                        attached to the session over ssh (the host has to answer ssh without
                                        a password; keep it on a private network such as Tailscale)
  amarchy remote off                    new sessions start here again; the host's leave the list and keep
                                        running there (amarchy remote <host> again brings them back)
  amarchy remote [--status]             where new sessions start / whether the host answers

Phone (on a host: its sessions on your phone, as an app on the home screen, reachable only on your
Tailscale network):
  amarchy app on                        serve it on your tailnet (https://<this machine>.<tailnet>.ts.net,
                                        with tailscale serve), now and after every reboot; prints its address
  amarchy app off                       stop serving it (the phones keep it, for when it's on again)
  amarchy app [--status]                whether it's on, where, and how many phones it notifies
  amarchy app --test                    send each phone a test notification

Plumbing:
  amarchy ui                            state for the Omarchy shell plugin (JSON)
  amarchy layout                        resize the zen column for the current monitor
  amarchy setup <id>                    make a new session's worktree, then start Claude (old windows)
  amarchy claude | asleep | woke <id>   the steps of the loop in a session's Claude window: set up and
                                        start Claude; keep the session on screen asleep; the prompt
                                        you type in while it sleeps
  amarchy sleep --idle                  put the sessions idle long enough to sleep (the timer runs it)
  amarchy reap <id>                     the rest of closing a session, detached from what closed it
  amarchy shorten <repo> <title>        cut Claude's title for the list down to "Keyword: a few words"
  amarchy editor <file>                 Claude's $VISUAL in a session (bin/amarchy-editor)
  amarchy hook <id> <state>             Claude Code hook: record working/waiting/idle and the conversation
                                        (start: idle, and tell Claude it's in amarchy)
  amarchy watch                         repaint the desktop as you enter and leave amarchy (runs while a theme is set)
  amarchy remote --sync                 keep this desktop's copy of the host's list, and send its phone app
                                        your look (the shell plugin starts it)
  amarchy events [--once]               on a host: its sessions as a line of JSON, again on every change
  amarchy attach <id> [claude|term]     on a host: show a session's Claude or terminal (tmux) in this terminal
  amarchy held <id>                     on a host: after its Claude exits, Enter starts it again
  amarchy app serve                     on a host: the phone app's server (amarchy-app.service runs it)
  amarchy app theme                     on a host: keep the look the phone app wears (JSON on stdin, from remote --sync)

Environment:
  AMARCHY_WORK         where your repos live (default ~/Work); every git repo directly inside is offered
  AMARCHY_WORKTREES    where worktrees go (default $AMARCHY_WORK/.worktrees/<repo>/<name>)
  AMARCHY_TERMINAL     foot, kitty, alacritty or ghostty (default: first one installed)
  AMARCHY_ZEN_WIDTH    width of the Claude column in logical pixels (default 900)
  AMARCHY_HEADER_HEIGHT    height of the strip above Claude with the session's name in zen mode (default 30, 0 for none)
  AMARCHY_CLAUDE_ARGS  extra arguments for claude (default "--permission-mode auto")
  AMARCHY_SOUND        off for silent notifications, whatever `amarchy sound` picked
  AMARCHY_SHORT_NAMES  off to show Claude Code's titles as they are, not cut down to "Keyword: a few words"

A session's Claude and terminal have AMARCHY=1, AMARCHY_SESSION (its id), $AMARCHY_PATH
(the worktree), $AMARCHY_NAME, $AMARCHY_BRANCH, $AMARCHY_REPO and $AMARCHY_ROOT (the
project's main checkout). From there, run, rename and close act on that session, whatever
is on screen. Claude is told it's in amarchy when it starts (and that it can message the
other sessions' Claude), and the amarchy skill (skill/, linked into ~/.claude/skills by
install.sh) has the rest.

Run commands are saved per project, start in the session's worktree and can use the same
variables. Quote them when setting from a shell:
  amarchy run --set '$AMARCHY_PATH/install.sh && omarchy-restart-shell'
(install.sh asks before replacing an install that runs from another session's worktree,
and stops without a terminal to ask in; --force goes on anyway. Closing the session an
install runs from puts it back on the main checkout.)

State: ~/.local/state/amarchy/.
"""

import base64
import calendar
import fcntl
import hashlib
import hmac
import json
import os
import random
import re
import select
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import unicodedata
import threading
import time
import urllib.parse
from pathlib import Path

HOME = Path.home()
WORK = Path(os.environ.get("AMARCHY_WORK", HOME / "Work")).expanduser()
WORKTREES = Path(os.environ.get("AMARCHY_WORKTREES", WORK / ".worktrees")).expanduser()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "amarchy"
SESSIONS = STATE / "sessions"
STATUS = STATE / "status"
RUN = STATE / "run"             # per project: <repo> its run command, <repo>.json its other saved commands
ZEN = STATE / "zen"             # exists while zen mode is on
LAYOUT = STATE / "layout.lua"
THEME = STATE / "theme"         # the amarchy theme: its name and a rendered snapshot
THEME_LOG = STATE / "theme.log" # every repaint and how each step of it went
LAST = STATE / "last"
GROUP_FILE = STATE / "group"    # how the list is grouped: "project", "priority", "status", any or none, outermost first
SORT_FILE = STATE / "sort"      # how it's sorted inside its groups: "priority", "newest" or "oldest"
ORDER_FILE = STATE / "order"    # the same from before: "activity" was grouped by status
CLOSING = STATE / "closing"     # sessions closed but not yet cleaned up (see "reap")
CLAUDE_STATE = STATE / "claude" # per session: its conversation, and what sleep keeps for it (see "sleep")
SLEEP_AFTER = STATE / "sleep-after"     # minutes idle and off screen before a session sleeps, or "off"
HIDDEN = "special:amarchy"
SELF = str(Path(__file__).resolve())
# What runs later, after this has exited (Claude's hooks, a click on a
# notification), goes through the installed amarchy: it follows install.sh
# instead of staying on the copy that set it up, a worktree maybe long gone.
INSTALLED = Path.home() / ".local/bin/amarchy"
ENTRY = str(INSTALLED) if INSTALLED.exists() else SELF
SOUNDS = Path(SELF).parent.parent / "sounds"       # amarchy's chimes, one played with a session's notification
KEYS_FILE = STATE / "keys.lua"                     # the modifiers picked in `amarchy keys`
KEYS_BOUND = STATE / "keys.bound"                  # the modifiers bound now, for the menu's ✓
SOUND_FILE = STATE / "sound"                       # the one picked (its name, or "off")
SOUND = os.environ.get("AMARCHY_SOUND", "on").lower() not in ("0", "off", "no", "false")

PREFIX = "amarchy"          # window classes: amarchy.claude.<id>, amarchy.term.<id>
WS_PREFIX = "A:"            # session workspaces: A:<id>

# Sessions created by the pre-release "factory" script keep their old window
# classes and F: workspaces until they're closed.
# The Omarchy shell plugin (omarchy/plugin in this repo) lists the sessions
# under the Ⓐ in the bar.
SHELL_PLUGIN = HOME / ".config/omarchy/plugins/amarchy/manifest.json"

OMARCHY = Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy")
# Hyprland runs amarchy's keys without Omarchy's own commands on PATH (the shell
# and the terminals have them). Without them amarchy can't nudge the shell
# plugin, and it sizes Claude's column as if there were no plugin, so the next
# command run from elsewhere resizes it all again.
if (OMARCHY / "bin").is_dir() and str(OMARCHY / "bin") not in os.environ.get("PATH", "").split(os.pathsep):
    os.environ["PATH"] = os.pathsep.join(filter(None, (os.environ.get("PATH"), str(OMARCHY / "bin"))))
# Host mode: amarchy on a machine without a desktop (a server), keeping
# sessions for desktops elsewhere to show (see "remote"). Each session's
# Claude and terminal run in tmux there instead of in windows.
# `install.sh --host` marks it (a host may have Hyprland installed too); a
# machine without hyprctl can't be anything else.
_host_env = os.environ.get("AMARCHY_HOST_MODE", "")
HOST_MODE = _host_env == "1" or (_host_env != "0" and (
    (Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "amarchy/host").exists()
    or not shutil.which("hyprctl")))
# Reached over ssh, which gives a bare PATH: Claude Code's installer puts
# claude in ~/.local/bin.
if HOST_MODE and str(HOME / ".local/bin") not in os.environ.get("PATH", "").split(os.pathsep):
    os.environ["PATH"] = os.pathsep.join(filter(None, (str(HOME / ".local/bin"), os.environ.get("PATH"))))
DESKTOP = HOME / ".local/state/omarchy/current"     # the Omarchy theme the rest of the desktop wears
CLAUDE_THEME = HOME / ".claude/themes/amarchy.json"
# Who last painted over the Omarchy theme ("amarchy" while ours shows, empty
# when nobody has). Any tool that themes a workspace this way can share it:
# take the lock, paint, write your name; only repaint the desktop on leaving
# if the name is still yours, so two of them never undo each other.
LAYER = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "theme-layer"

LEGACY_STATE = HOME / ".local/state/jaken/factory"
LEGACY_PREFIX = "factory"
LEGACY_WS_PREFIX = "F:"

ZEN_WIDTH = int(os.environ.get("AMARCHY_ZEN_WIDTH") or os.environ.get("READING_WIDTH") or 900)
CLAUDE_ARGS = shlex.split(os.environ.get("AMARCHY_CLAUDE_ARGS", "--permission-mode auto"))
# The strip above the zen column where the shell plugin writes the session's name.
HEADER_HEIGHT = max(int(os.environ.get("AMARCHY_HEADER_HEIGHT") or 30), 0)
TERMINALS = ("foot", "kitty", "alacritty", "ghostty")
PAD = 8                 # between Claude's column and the panels beside it
MIN_SIDE = 200          # narrower than this beside the column and there's no room for them
IMAGES = (".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp")


# ------------------------------------------------------------------ helpers

def sh(*args, check=False, cwd=None):
    """Run a command and capture what it says. One that isn't there (hyprctl
    in host mode) or a folder that's gone fails like a command would."""
    try:
        return subprocess.run(args, capture_output=True, text=True, check=check, cwd=cwd)
    except (FileNotFoundError, NotADirectoryError) as e:
        if check:
            raise
        return subprocess.CompletedProcess(args, 127, "", str(e))


def notify(title, body="", glyph="Ⓐ", click=()):
    """A notification; click is the amarchy command a click on it runs."""
    if HOST_MODE:
        return      # nobody's there: the desktops showing its sessions notify
    if shutil.which("omarchy-notification-send"):
        sh("omarchy-notification-send", "-g", glyph, title, body, *(["--exec", ENTRY, *click] if click else []))
    else:
        sh("notify-send", title, body)


def chime():
    """The sound of a session's notification, the same whether it needs you or
    is done: the one `amarchy sound` picked. AMARCHY_SOUND=off for none."""
    if SOUND and not HOST_MODE:
        play(sound_file(sound_name()))


def hypr(expr):
    sh("hyprctl", "dispatch", expr)


def clients():
    return json.loads(sh("hyprctl", "clients", "-j").stdout or "[]")


def active_workspace():
    return json.loads(sh("hyprctl", "activeworkspace", "-j").stdout or "{}")


def find(cls, title=None):
    for c in clients():
        if c["class"] == cls and (title is None or c["title"] == title):
            return c
    return None


def wait_for(cls, title=None, timeout=10, besides=None):
    """The window of a class once it's there; with besides, one other than
    the window at that address."""
    end = time.time() + timeout
    while time.time() < end:
        c = next((c for c in clients() if c["class"] == cls and (title is None or c["title"] == title)
                  and c["address"] != besides), None)
        if c:
            return c
        time.sleep(0.05 if besides else 0.15)
    return None


# Set by a running Claude Code for its own children. When an agent drives
# amarchy, they'd leak into the sessions it opens (e.g. turning off transcript
# saving), so windows start without them.
INHERITED_CLAUDE_ENV = ("CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_CODE_CHILD_SESSION",
                        "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_ENTRYPOINT",
                        "CLAUDE_CODE_EXECPATH", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                        "CLAUDE_CODE_AUTO_COMPACT_WINDOW", "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS")


# A session's own environment (session_env), when amarchy runs inside one: what
# it opens belongs to whatever session it opens it for, if any.
SESSION_ENV = ("AMARCHY", "AMARCHY_SESSION", "AMARCHY_PATH", "AMARCHY_NAME", "AMARCHY_REPO",
               "AMARCHY_BRANCH", "AMARCHY_ROOT")


def clean_env():
    return {k: v for k, v in os.environ.items() if k not in INHERITED_CLAUDE_ENV + SESSION_ENV}


def spawn(argv):
    launcher = ["uwsm-app", "--"] if shutil.which("uwsm-app") else []
    # On its own (setsid -f leaves no parent behind): a session's Claude window
    # opens its terminal, and becomes Claude, which may then sleep and exit.
    detached = ["setsid", "-f"] if shutil.which("setsid") else []
    subprocess.Popen([*detached, *launcher, *argv], stdin=subprocess.DEVNULL, env=clean_env(),
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def detach(argv):
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, env=clean_env(), stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def terminal():
    choice = os.environ.get("AMARCHY_TERMINAL")
    if choice:
        return choice
    return next((t for t in TERMINALS if shutil.which(t)), "foot")


# Where each terminal keeps how see-through its background is.
TERMINAL_ALPHA = {"foot": (".config/foot/foot.ini", r"^\s*alpha\s*=\s*([\d.]+)"),
                  "kitty": (".config/kitty/kitty.conf", r"^\s*background_opacity\s+([\d.]+)"),
                  "alacritty": (".config/alacritty/alacritty.toml", r"^\s*opacity\s*=\s*([\d.]+)"),
                  "ghostty": (".config/ghostty/config", r"^\s*background-opacity\s*=\s*([\d.]+)")}
WINDOW_OPACITY = 0.96   # what Omarchy's Hyprland config gives a window without the keyboard


def terminal_alpha():
    """How opaque the session terminal's background ends up on screen, so the
    session list on the other side of Claude can match it."""
    path, pattern = TERMINAL_ALPHA.get(terminal(), ("", ""))
    try:
        found = re.findall(pattern, (HOME / path).read_text(), re.M) if path else []
        alpha = min(max(float(found[-1]), 0.0), 1.0) if found else 1.0
    except (OSError, ValueError):
        alpha = 1.0
    return round(alpha * WINDOW_OPACITY, 3)


def term_argv(cls, title, cwd, cmd=()):
    """A terminal window with a given Wayland app-id (that's how we track windows)."""
    t = terminal()
    if t == "kitty":
        return ["kitty", "--class", cls, "--title", title, "--directory", str(cwd), *cmd]
    if t == "alacritty":
        return ["alacritty", "--class", cls, "--title", title, "--working-directory", str(cwd),
                *(["-e", *cmd] if cmd else [])]
    if t == "ghostty":
        return ["ghostty", f"--class={cls}", f"--title={title}", f"--working-directory={cwd}",
                "--gtk-single-instance=false", *(["-e", *cmd] if cmd else [])]
    return ["foot", "--app-id", cls, "--title", title, "-D", str(cwd), *cmd]


def open_term(cls, title, cwd, cmd=(), env=None):
    if env:
        # Through env(1), inside the terminal: a terminal server or uwsm's
        # launcher would drop it from our own environment.
        cmd = ["env", *(f"{k}={v}" for k, v in env.items()), *(cmd or [os.environ.get("SHELL", "bash")])]
    osc = THEME / "osc"
    if theme_name() and osc.exists():
        # Start in the amarchy theme's colors rather than the desktop's.
        cmd = ["sh", "-c", 'cat "$0"; exec "$@"', str(osc), *(cmd or [os.environ.get("SHELL", "bash")])]
    spawn(term_argv(cls, title, cwd, cmd))


def move_to(addr, workspace):
    hypr(f'hl.dsp.window.move({{ window = "address:{addr}", workspace = "{workspace}", follow = false }})')


def place(addr, x, y, w, h):
    hypr(f'hl.dsp.window.float({{ window = "address:{addr}", action = "enable" }})')
    hypr(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {w}, y = {h} }})')
    hypr(f'hl.dsp.window.move({{ window = "address:{addr}", x = {x}, y = {y} }})')


def focus_workspace(name):
    hypr(f'hl.dsp.focus({{ workspace = "name:{name}" }})')


def focus_window(addr):
    hypr(f'hl.dsp.focus({{ window = "address:{addr}" }})')


def processes():
    """Every process: {pid: (ppid, comm, cpu ticks)}, from /proc."""
    out = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            stat = Path(f"/proc/{d}/stat").read_text()
        except OSError:
            continue
        # comm is in parentheses and may hold anything, spaces and parentheses too.
        fields = stat[stat.rfind(")") + 2:].split()
        out[int(d)] = (int(fields[1]), stat[stat.find("(") + 1:stat.rfind(")")], int(fields[11]) + int(fields[12]))
    return out


def descendants(pid, procs):
    """A process's children, grandchildren... nearest first."""
    children = {}
    for p, (ppid, *_) in procs.items():
        children.setdefault(ppid, []).append(p)
    out, todo = [], [pid]
    while todo:
        kids = sorted(children.get(todo.pop(0), []))
        out += kids
        todo += kids
    return out


def cmdline(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace").split("\0")
    except OSError:
        return []


def slug(text):
    return re.sub(r"[^a-z0-9-]+", "-", text.strip().lower()).strip("-")[:40]


def repos():
    if not WORK.is_dir():
        return []
    return sorted(p.name for p in WORK.iterdir()
                  if not p.name.startswith(".") and (p / ".git").exists())


def fail(msg):
    print(f"amarchy: {msg}", file=sys.stderr)
    return 1


# ------------------------------------------------------------------ projects

def github_slug(url):
    """owner/repo (lowercased) for a GitHub remote URL, else None."""
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$", url or "")
    return m.group(1).lower() if m else None


def projects():
    """Your projects: those in AMARCHY_WORK, or the remote host's while new
    sessions go there."""
    host = remote_host()
    if host:
        return remote_projects(host)
    counts = {}
    for s in sessions():
        counts[s["repo"]] = counts.get(s["repo"], 0) + 1
    out = []
    for name in repos():
        remote = sh("git", "remote", "get-url", "origin", cwd=WORK / name).stdout.strip()
        out.append({"name": name, "path": str(WORK / name), "remote": remote,
                    "sessions": counts.get(name, 0)})
    return out


def github_repos():
    """Your GitHub repos (owned, collaborator, org), most recently pushed first.

    None when gh is missing or not logged in."""
    if not shutil.which("gh"):
        return None
    r = sh("gh", "api", "user/repos?affiliation=owner,collaborator,organization_member&sort=pushed&per_page=100",
           "--jq", "[.[] | {name: .full_name, private, pushed: .pushed_at, description}]")
    if r.returncode != 0:
        return None
    added = {github_slug(p["remote"]) for p in projects()}
    rs = json.loads(r.stdout or "[]")
    for repo in rs:
        repo["added"] = repo["name"].lower() in added
    return rs


def add_project(source):
    """Clone owner/repo, a GitHub URL or any git URL into AMARCHY_WORK.

    Returns (name, error). Adding a project that's already there is not an error."""
    if remote_host():
        return remote_add(remote_host(), [source.strip()])
    source = source.strip()
    url = f"https://github.com/{source}.git" if re.fullmatch(r"[\w.-]+/[\w.-]+", source) else source
    name = re.sub(r"\.git$", "", re.split(r"[/:]", url.rstrip("/"))[-1])
    if not name:
        return None, f"can't tell the project name from {source!r}"
    gh_slug = github_slug(url)
    for p in projects():
        if p["name"] == name and (not gh_slug or github_slug(p["remote"]) == gh_slug):
            return name, None
    dest = WORK / name
    if dest.exists():
        return None, f"{dest} already exists and isn't {source}"
    WORK.mkdir(parents=True, exist_ok=True)
    # Not captured: git's progress shows when run from a terminal.
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}  # fail instead of hanging on a password prompt
    if subprocess.run(["git", "clone", url, str(dest)], env=env).returncode != 0:
        return None, f"git clone {url} failed"
    return name, None


def new_project(name, github=False):
    """An empty git repo with one commit (worktrees need a base), optionally
    pushed to a new private GitHub repo. Returns (name, error)."""
    if remote_host():
        return remote_add(remote_host(), ["--new", name, *(["--github"] if github else [])])
    name = slug(name)
    if not name:
        return None, "the project needs a name"
    dest = WORK / name
    if dest.exists():
        return None, f"{dest} already exists"
    dest.mkdir(parents=True)
    sh("git", "init", "--quiet", "-b", "main", cwd=dest)
    sh("git", "commit", "--quiet", "--allow-empty", "-m", "Initial commit", cwd=dest)
    if github:
        r = sh("gh", "repo", "create", name, "--private", "--source", str(dest), "--push")
        if r.returncode != 0:
            return name, f"created {dest}, but gh repo create failed: {r.stderr.strip()[:200]}"
    return name, None


def cmd_add(args):
    if not args:
        menu_add_project()
        return 0
    if args[0] == "--new":
        names = [a for a in args[1:] if not a.startswith("--")]
        if not names:
            return fail("usage: amarchy add --new <name> [--github]")
        name, err = new_project(names[0], github="--github" in args)
    else:
        name, err = add_project(args[0])
    if err:
        return fail(err)
    print(WORK / name)
    return 0


def cmd_projects(args):
    if "--github" in args:
        rs = github_repos()
        if rs is None:
            return fail("gh isn't installed or logged in (gh auth login)")
        if "--json" in args:
            print(json.dumps(rs, indent=2))
        else:
            for r in rs:
                print(f"{'✓' if r['added'] else ' '} {r['name']}{'  (private)' if r['private'] else ''}")
        return 0
    ps = projects()
    if "--json" in args:
        print(json.dumps(ps, indent=2))
    else:
        for p in ps:
            n = p["sessions"]
            print(f"{p['name']:<30} {n} session{'s' if n != 1 else ''}  {p['remote']}")
    return 0


# ------------------------------------------------------------------ sessions

def with_defaults(s):
    s.setdefault("prefix", PREFIX)
    s.setdefault("workspace", WS_PREFIX + s["id"])
    return s


def sessions():
    out = []
    for f in sorted(SESSIONS.glob("*.json")):
        try:
            s = with_defaults(json.loads(f.read_text()))
        except (ValueError, KeyError):
            continue
        st = STATUS / s["id"]
        s["status"] = st.read_text().strip() if st.exists() else "idle"
        out.append(s)
    # And the sessions of the remote host, as it last said (a session here wins a clash of ids).
    ids = {s["id"] for s in out}
    out += [s for s in remote_sessions() if s["id"] not in ids]
    return out


def session(sid):
    f = SESSIONS / f"{sid}.json"
    try:
        return with_defaults(json.loads(f.read_text()))
    except (OSError, ValueError):
        return next((s for s in remote_sessions() if s["id"] == sid), None)


def save_session(s):
    """Write a session's file in one go: the list (and every other amarchy
    reading it meanwhile) never sees half of it."""
    if s.get("host"):
        return      # the remote host keeps it: changes go there (remote_call)
    SESSIONS.mkdir(parents=True, exist_ok=True)
    keep = {k: v for k, v in s.items() if k not in VIEW_FIELDS}
    tmp = SESSIONS / f".{s['id']}.json.{os.getpid()}"
    tmp.write_text(json.dumps(keep))
    os.replace(tmp, SESSIONS / f"{s['id']}.json")


# What session_view() adds for the UIs, never saved.
VIEW_FIELDS = ("status", "awake", "sleeping", "task", "claude_title", "age", "current", "background", "agent")


def claude_class(s):
    return f"{s['prefix']}.claude.{s['id']}"


def term_class(s):
    return f"{s['prefix']}.term.{s['id']}"


def current_session_id():
    name = active_workspace().get("name", "")
    return next((s["id"] for s in sessions() if s["workspace"] == name), None)


def own_session_id():
    """The session a command is about when none is named: the one it runs in
    (from its Claude or its terminal, $AMARCHY_SESSION), else the one on screen."""
    sid = os.environ.get("AMARCHY_SESSION", "")
    return sid if session(sid) else current_session_id()


def zen(width=None):
    """Whether Claude is alone in its column: zen mode is on, or the monitor
    has no room beside the column for the sessions and the terminal."""
    if ZEN.exists():
        return True
    if width is None:
        width = monitor_geometry()[0]
    return (width - ZEN_WIDTH) // 2 < MIN_SIDE


def active_class():
    return json.loads(sh("hyprctl", "activewindow", "-j").stdout or "{}").get("class")


def native_panel():
    return SHELL_PLUGIN.exists() and shutil.which("omarchy-shell")


def tell_shell(*args):
    """Nudge the shell plugin so it redraws now instead of on its next poll."""
    if native_panel():
        subprocess.Popen(["omarchy-shell", "amarchy", *args], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def header_height():
    """How tall the strip with the session's name is; the shell plugin draws
    it, so there's none without the plugin."""
    return HEADER_HEIGHT if native_panel() else 0


def header_room(width=None):
    """Room kept above Claude for that strip: only in zen mode, where the list
    (which shows the session you're in) isn't beside it."""
    return header_height() if zen(width) else 0


def monitor_geometry():
    for m in json.loads(sh("hyprctl", "monitors", "-j").stdout or "[]"):
        if m.get("focused"):
            scale = m["scale"]
            _, top, _, bottom = (m.get("reserved") or [0, 0, 0, 0])
            return int(m["width"] / scale), int(m["height"] / scale), top, bottom
    return 1728, 1085, 35, 0


def migrate_legacy():
    """Adopt sessions from the pre-release "factory" script, once."""
    if not (LEGACY_STATE / "sessions").is_dir() or SESSIONS.exists():
        return
    SESSIONS.mkdir(parents=True, exist_ok=True)
    STATUS.mkdir(parents=True, exist_ok=True)
    for f in (LEGACY_STATE / "sessions").glob("*.json"):
        s = json.loads(f.read_text())
        s.update(prefix=LEGACY_PREFIX, workspace=LEGACY_WS_PREFIX + s["id"])
        (SESSIONS / f.name).write_text(json.dumps(s))
        st = LEGACY_STATE / "status" / s["id"]
        if st.exists():
            (STATUS / s["id"]).write_text(st.read_text())
    old_mc = find(f"{LEGACY_PREFIX}.mc")
    if old_mc:
        hypr(f'hl.dsp.window.close({{ window = "address:{old_mc["address"]}" }})')
    LEGACY_STATE.rename(LEGACY_STATE.with_name("factory.migrated"))


# ------------------------------------------------------------------ layout

def cmd_layout():
    """Write the Hyprland rule that keeps a session's windows in a centered column,
    with room above it for the session's name in zen mode.

    Loaded by hypr/amarchy.lua; only rewritten on change, and then applied live
    (no reload), so entering zen mode just opens the strip above Claude."""
    width, *_ = monitor_geometry()
    side = max((width - ZEN_WIDTH) // 2, 0)
    top = header_room(width)
    prefixes = {WS_PREFIX} | {s["workspace"][:2] for s in sessions()}
    rules = "".join(
        f'hl.workspace_rule({{ workspace = "n[s:{p}]", '
        f'gaps_out = {{ top = {top}, right = {side}, bottom = 0, left = {side} }} }})\n'
        for p in sorted(prefixes))
    text = f"-- Generated by `amarchy layout` ({width}px wide monitor, {ZEN_WIDTH}px column)\n{rules}"
    if LAYOUT.exists() and LAYOUT.read_text() == text:
        return
    STATE.mkdir(parents=True, exist_ok=True)
    LAYOUT.write_text(text)
    for rule in rules.splitlines():
        sh("hyprctl", "eval", rule)


def arrange(sid, focus="claude", term=None):
    """Put a session's windows where they belong. Claude is always tiled in
    the column, so it never moves. The terminal (this one, when there are two
    for a moment) floats in the gap to its right, and waits on the hidden
    workspace in zen mode."""
    s = session(sid)
    if not s:
        return
    claude = find(claude_class(s))
    term = term or find(term_class(s))
    width, height, top, bottom = monitor_geometry()
    beside = not zen(width)

    def floating(win, on):
        hypr(f'hl.dsp.window.float({{ window = "address:{win["address"]}", '
             f'action = "{"enable" if on else "disable"}" }})')

    if claude and claude["floating"]:
        floating(claude, False)
    if term and beside:
        # Floated before it gets to the workspace, so Claude isn't pushed around.
        if not term["floating"]:
            floating(term, True)
        # Sized and placed where it is (out of sight, usually), then brought
        # over, so it shows up already in place.
        side = (width - ZEN_WIDTH) // 2
        box = [width - side + PAD, top, side - PAD, height - top - bottom]
        if not term["floating"] or [*term["at"], *term["size"]] != box:
            place(term["address"], *box)
        if term["workspace"]["name"] != s["workspace"]:
            move_to(term["address"], f"name:{s['workspace']}")
            # Hyprland shifts a window by its border on the way over.
            place(term["address"], *box)
    elif term and term["workspace"]["name"] != HIDDEN:
        move_to(term["address"], HIDDEN)
    target = term if focus == "terminal" and term and beside else claude
    if target and focus:
        focus_window(target["address"])


def tell_shell_zen():
    """Tell the shell plugin whether Claude is alone right now, so the list
    beside it comes and goes with the terminal instead of a poll later."""
    tell_shell("zen", "true" if zen() else "false")


def leave_zen():
    """Bring the panels back for something that needs the terminal. False
    when the monitor has no room beside Claude for it."""
    if ZEN.exists():
        ZEN.unlink()
        tell_shell_zen()
        cmd_layout()
    if zen():
        notify("amarchy", "No room for the terminal beside Claude on this monitor.")
        return False
    return True


def cmd_terminal(args):
    """The terminal key: move the keyboard between Claude and the terminal
    beside it (on: to the terminal, off: back to Claude). The terminal is
    only ever beside Claude, so asking for it in zen mode leaves zen mode."""
    sid = current_session_id()
    if not sid:
        return 1
    s = session(sid)
    if args and args[0] in ("on", "off"):
        on = args[0] == "on"
    else:
        on = zen() or active_class() != term_class(s)
    if on and not leave_zen():
        return 1
    ensure_windows(s)
    arrange(sid, focus="terminal" if on else "claude")
    return 0


def cmd_zen(args):
    """Toggle zen mode (or turn it on|off): Claude alone in its column,
    without the sessions and the terminal beside it. It holds for every
    session until you toggle it back, or ask for the terminal."""
    on = args[0] == "on" if args and args[0] in ("on", "off") else not ZEN.exists()
    STATE.mkdir(parents=True, exist_ok=True)
    if on:
        ZEN.touch()
    else:
        ZEN.unlink(missing_ok=True)
    tell_shell_zen()
    cmd_layout()
    sid = current_session_id()
    if sid:
        s = session(sid)
        ensure_windows(s)
        arrange(sid)
    return 0


# ------------------------------------------------------------------ theme
#
# amarchy can wear its own Omarchy theme: the bar, menus, notifications,
# wallpaper and window borders change while a session is on screen and change
# back when you leave. It's a coat of paint over the desktop, not a theme
# switch: your Omarchy theme never changes, nothing is rewritten or reloaded,
# so it happens in the time it takes to switch workspace. The session windows
# themselves (Claude, the terminal) simply stay in the amarchy theme.

SYSTEM = "system"       # no theme of its own: amarchy looks like the rest of the desktop


def theme_name():
    f = THEME / "name"
    return f.read_text().strip() if f.exists() else ""


def theme_key(name):
    return name.strip().lower().replace(" ", "-")


def theme_render(name):
    """Snapshot a theme into THEME exactly as Omarchy would render it, without
    applying it. Returns an error, or None.

    Omarchy's template step always works in ~/.local/state/omarchy/current/next-theme,
    so it runs with a scratch HOME. Lua a theme ships is left out: the border
    colors come from Omarchy's own template."""
    key = theme_key(name)
    sources = [d for d in (OMARCHY / "themes" / key, HOME / ".config/omarchy/themes" / key) if d.is_dir()]
    if not key or not sources:
        return f"no Omarchy theme called {name!r} (see omarchy theme list)"
    with tempfile.TemporaryDirectory() as tmp:
        stage = Path(tmp) / ".local/state/omarchy/current/next-theme"
        for src in sources:     # the user's copy of a theme goes over Omarchy's, like omarchy-theme-set
            shutil.copytree(src, stage, dirs_exist_ok=True, ignore_dangling_symlinks=True,
                            ignore=shutil.ignore_patterns("backgrounds", "*.lua", ".git"))
        templates = HOME / ".config/omarchy/themed"
        if templates.is_dir():
            (Path(tmp) / ".config/omarchy").mkdir(parents=True)
            (Path(tmp) / ".config/omarchy/themed").symlink_to(templates)
        if not (stage / "colors.toml").exists() and (stage / "alacritty.toml").exists():
            sh("omarchy-theme-colors-from-alacritty", str(stage))
        subprocess.run(["omarchy-theme-set-templates"], capture_output=True,
                       env={**os.environ, "HOME": tmp, "OMARCHY_PATH": str(OMARCHY)})
        if not (stage / "colors.toml").exists() or not (stage / "shell.toml").exists():
            return f"couldn't render {name} (omarchy-theme-set-templates gave no shell.toml)"
        THEME.mkdir(parents=True, exist_ok=True)
        for f in ("colors.toml", "shell.toml", "hyprland.lua", "claude.json"):
            if (stage / f).exists():
                shutil.copy(stage / f, THEME / f)
            else:
                (THEME / f).unlink(missing_ok=True)
    (THEME / "osc").write_text(sh("omarchy-theme-osc", str(THEME / "colors.toml")).stdout)

    # The wallpaper Omarchy would start the theme on. A screen-sized copy
    # decodes much faster than a 4K original, so it doesn't blink on the way in.
    images = {}
    for src in sources:
        images.update({f.name: f for f in (src / "backgrounds").glob("*") if f.suffix.lower() in IMAGES})
    own = HOME / ".config/omarchy/backgrounds" / key
    images = sorted(f for f in own.glob("*") if f.suffix.lower() in IMAGES) + [images[n] for n in sorted(images)]
    # It's named after the image it was made from: the shell leaves a path it
    # already shows alone and keeps its pixels cached, so one wallpaper.jpg for
    # every theme would go on showing the first.
    sized = None
    if images and shutil.which("magick"):
        mon = next((m for m in json.loads(sh("hyprctl", "monitors", "-j").stdout or "[]") if m.get("focused")), {})
        size = f"{mon.get('width', 3840)}x{mon.get('height', 2160)}"
        stat = images[0].stat()
        stamp = hashlib.sha1(f"{images[0]} {stat.st_mtime_ns} {stat.st_size} {size}".encode()).hexdigest()[:12]
        sized = THEME / f"wallpaper-{stamp}.jpg"
        if not sized.exists():
            sh("magick", f"{images[0]}[0]", "-resize", size + "^", "-gravity", "center", "-extent", size,
               "-quality", "90", "-strip", str(sized))
    for old in THEME.glob("wallpaper*.jpg"):
        if old != sized:
            old.unlink(missing_ok=True)
    (THEME / "background").write_text(str(sized if sized and sized.exists() else images[0] if images else ""))
    return None


def claude_theme(source):
    """Claude Code's side of the theme: sessions start with "custom:amarchy"
    (see hook_settings), and Claude reloads the file when it changes. On
    System it's a copy of your Omarchy theme's, so a session started then
    still follows a theme picked later."""
    try:
        data = json.loads(source.read_text())
    except (OSError, ValueError):
        return
    data["name"] = "Amarchy"
    CLAUDE_THEME.parent.mkdir(parents=True, exist_ok=True)
    tmp = CLAUDE_THEME.with_name(".amarchy.json.tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, CLAUDE_THEME)


def theme_log(msg):
    try:
        if THEME_LOG.exists() and THEME_LOG.stat().st_size > 200_000:
            THEME_LOG.write_text("".join(THEME_LOG.read_text().splitlines(True)[-500:]))
        with open(THEME_LOG, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} [{os.getpid()}] {msg}\n")
    except OSError:
        pass


def paint(theme_dir, background):
    """Show a rendered theme and a wallpaper: the shell (bar, menus,
    notifications) takes the palette over IPC, Hyprland the border colors.
    False when any of them didn't take it (a shell that's still starting)."""
    def b64(f):
        return base64.b64encode(f.read_bytes()).decode() if f.is_file() else ""
    calls = {"shell": ["omarchy-shell", "shell", "applyTheme",
                       b64(theme_dir / "colors.toml"), b64(theme_dir / "shell.toml")]}
    if background and Path(background).is_file():
        calls["wallpaper"] = ["omarchy-shell", "background", "setInstant", str(background)]
    if (theme_dir / "hyprland.lua").is_file():
        calls["borders"] = ["hyprctl", "eval", f'dofile("{theme_dir / "hyprland.lua"}")']
    procs = {step: subprocess.Popen(["timeout", "2", *c], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
             for step, c in calls.items()}
    failed = [step for step, p in procs.items() if p.wait() != 0]
    theme_log(f"paint {theme_dir} wallpaper={background or '-'}: "
              + (f"FAILED {', '.join(failed)}" if failed else f"ok ({', '.join(calls)})"))
    return not failed


def retint(osc):
    """Recolor the session windows that are already open (terminal colors as
    OSC sequences, the way omarchy-theme-set-foot does it)."""
    pids = [str(c["pid"]) for c in clients() if c["class"].startswith((PREFIX + ".", LEGACY_PREFIX + "."))]
    if not osc or not pids:
        return
    for child in sh("pgrep", "-P", ",".join(pids)).stdout.split():
        try:
            tty = os.readlink(f"/proc/{child}/fd/1")
            if tty.startswith("/dev/pts/"):
                Path(tty).write_text(osc)
        except OSError:
            pass


def themed_workspace(name):
    return name.startswith(WS_PREFIX) or any(s["workspace"] == name for s in sessions())


def theme_sync(workspace=None, force=False):
    """Make the desktop wear what the workspace on screen calls for: the
    amarchy theme on a session, your Omarchy theme everywhere else. False
    when the paint didn't take, so the desktop is not what it should be yet."""
    if workspace is None:
        workspace = active_workspace().get("name", "")
    inside = bool(theme_name()) and themed_workspace(workspace)
    with open(LAYER, "a+") as layer:
        fcntl.flock(layer, fcntl.LOCK_EX)
        layer.seek(0)
        ours = layer.read().strip() == PREFIX
        if inside and (force or not ours):
            painted = paint(THEME, (THEME / "background").read_text().strip())
            # Whatever painted before us (Omarchy's own theme switch included)
            # recolors every terminal, ours too.
            retint((THEME / "osc").read_text())
        elif ours and not inside:
            background = DESKTOP / "background"
            painted = paint(DESKTOP / "theme", os.path.realpath(background) if background.exists() else None)
        else:
            return True
        if not painted:
            return False    # the layer keeps saying what's really there
        layer.seek(0)
        layer.truncate()
        layer.write(PREFIX if inside else "")
        return True


def ensure_watcher():
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "watch.lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return  # it's running
    detach([SELF, "watch"])


# Coming in paints right away. Leaving waits a moment longer, so that when you
# go straight to another workspace with a coat of its own, that one gets there
# first and the desktop doesn't flash your Omarchy theme in between.
PAINT_IN, PAINT_OUT = 0.02, 0.07
# A shell that just started comes up in your Omarchy theme and wallpaper, and
# takes a moment to finish loading them; a paint that failed is tried again.
PAINT_SHELL, PAINT_RETRY, PAINT_RETRIES = 0.4, 0.5, 8
# ...and once more when it has settled, in case it was still loading your
# wallpaper when the first paint landed.
PAINT_SETTLE = 1.5
SHELL_LAYERS = ("omarchy-background", "omarchy-bar")


def watch_restart_if_updated(version):
    """Run the amarchy that's on disk now (an install or a pull changed it),
    unless it's half-written. Returns the version the watcher is on."""
    try:
        if os.stat(SELF).st_mtime_ns == version:
            return version
        compile(Path(SELF).read_text(), SELF, "exec")
    except (OSError, ValueError, SyntaxError):
        return version      # gone or mid-save; look again after the next paint
    theme_log("amarchy was updated, starting again")
    try:
        os.execv(sys.executable, [sys.executable, SELF, "watch"])
    except OSError as e:
        theme_log(f"couldn't start again: {e!r}")
        return os.stat(SELF).st_mtime_ns


def cmd_watch():
    """Follow Hyprland's events and repaint as sessions come on and go off
    screen. One per desktop; it ends when the theme is turned off."""
    if not theme_name():
        return 0
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "watch.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0
    try:
        events = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        events.connect(str(Path(os.environ["XDG_RUNTIME_DIR"]) / "hypr" / os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
                           / ".socket2.sock"))
    except (KeyError, OSError):
        return fail("can't reach Hyprland's event socket")
    # Starts with a repaint: whatever happened while no watcher ran (a shell
    # restart, say), the desktop is right again.
    workspace, force, due, settle, retries, buf = None, True, time.monotonic(), None, 0, b""
    version = os.stat(SELF).st_mtime_ns
    theme_log(f"watch started ({SELF})")
    while True:
        timers = [t for t in (due, settle) if t is not None]
        if not select.select([events], [], [], max(min(timers) - time.monotonic(), 0) if timers else None)[0]:
            if settle is not None and settle <= time.monotonic():
                force, settle = True, None
            try:
                painted = theme_sync(workspace, force)
            except Exception as e:      # Hyprland or the shell didn't answer; never worth dying over
                theme_log(f"sync failed: {e!r}")
                painted = False
            if not theme_name():
                return 0
            if painted or retries >= PAINT_RETRIES:
                if not painted:
                    theme_log(f"gave up after {retries} retries; the next event paints")
                force, due, retries = False, None, 0
                if settle is None:
                    version = watch_restart_if_updated(version)
            else:
                due, retries = time.monotonic() + PAINT_RETRY, retries + 1
            continue
        chunk = events.recv(4096)
        if not chunk:
            return 0
        *lines, buf = (buf + chunk).split(b"\n")
        for line in lines:
            event, _, data = line.decode(errors="replace").partition(">>")
            now = time.monotonic()
            if event == "workspacev2":          # ID,NAME
                workspace = data.split(",", 1)[-1]
                try:
                    inside = themed_workspace(workspace)
                except Exception:
                    inside = True
                due = now + (PAINT_IN if inside else PAINT_OUT)
            elif event == "focusedmonv2":       # MONITOR,WORKSPACEID: ask which workspace that is
                workspace, due = None, now + PAINT_IN
            elif event == "configreloaded":     # Hyprland is back on your theme's border colors
                force, due = True, now + PAINT_IN
            elif event == "openlayer" and data in SHELL_LAYERS:    # the shell restarted
                force, due, settle = True, now + PAINT_SHELL, now + PAINT_SHELL + PAINT_SETTLE


def cmd_theme(args):
    if args and args[0] == "--show":
        print(theme_name() or SYSTEM)
        return 0
    if args and args[0] == "--refresh":
        return theme_refresh()
    name = args[0] if args else menu_pick_theme()
    if not name:
        return 1
    if name.lower() in (SYSTEM, "off"):
        (THEME / "name").unlink(missing_ok=True)
        painted = theme_sync()
        retint(sh("omarchy-theme-osc", str(DESKTOP / "theme/colors.toml")).stdout)
        claude_theme(DESKTOP / "theme/claude.json")
        return 0 if painted else fail(f"the desktop didn't take your Omarchy theme back (see {THEME_LOG})")
    err = theme_render(name)
    if err:
        return fail(err)
    (THEME / "name").write_text(theme_key(name).replace("-", " ").title() + "\n")
    claude_theme(THEME / "claude.json")
    painted = theme_sync(force=True)
    retint((THEME / "osc").read_text())
    ensure_watcher()    # it tries again if this paint didn't take
    return 0 if painted else fail(f"the desktop didn't take the theme yet (see {THEME_LOG})")


def theme_refresh():
    """Something else repainted the desktop and recolored every terminal
    (Omarchy switching your theme, mostly): put amarchy's own look back. On
    System, hand Claude your new Omarchy theme."""
    if not theme_name():
        claude_theme(DESKTOP / "theme/claude.json")
        return 0
    painted = theme_sync(force=True)
    retint((THEME / "osc").read_text())     # also when no session is on screen
    ensure_watcher()
    return 0 if painted else 1


# ------------------------------------------------------------------ sound

# amarchy's own chimes (sounds/, where sounds/CREDITS says where each is from),
# in the order the menu offers them; the first is the default.
CHIMES = ("kalimba", "vibraphone", "tine", "fairy", "ocean", "elementary")
USER_SOUNDS = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy/sounds"
AUDIO = (".wav", ".oga", ".ogg", ".opus", ".flac", ".mp3")   # what pw-play and paplay read
PREVIEW = STATE / "preview"     # the pid of the sound playing in the picker, so the next one cuts it off
ICON_SOUND = "󰕾"
ICON_MUTE = "󰖁"
ADD_SOUND = "Add your own"


def sounds():
    """Every sound to pick from, {name: file}: amarchy's, then the files in
    ~/.config/amarchy/sounds, named after the file. One of yours with the
    name of one of amarchy's replaces it."""
    found = {name: SOUNDS / f"{name}.oga" if (SOUNDS / f"{name}.oga").exists() else SOUNDS / f"{name}.wav"
             for name in CHIMES}
    mine = sorted(f for f in USER_SOUNDS.glob("*") if f.suffix.lower() in AUDIO and f.is_file()) \
        if USER_SOUNDS.is_dir() else []
    for f in mine:
        found.pop(f.stem.lower(), None)
        found[f.stem] = f
    return found


def sound_label(name):
    """How a sound is called in the menu: amarchy's capitalized, yours as you named the file."""
    return name.capitalize() if name in CHIMES else name


def sound_key(name, found=None):
    """The name of a sound as sounds() has it, whatever its case; None if there's none."""
    found = sounds() if found is None else found
    return next((n for n in found if n.lower() == name.strip().lower()), None)


def sound_name():
    """The sound picked: its name, "off", or the default when nothing (or a
    file since removed) was picked."""
    picked = SOUND_FILE.read_text().strip() if SOUND_FILE.exists() else ""
    if picked == "off":
        return picked
    return (sound_key(picked) if picked else None) or CHIMES[0]


def sound_file(name):
    found = sounds()
    key = sound_key(name, found) if name != "off" else None
    return found[key] if key else None


def player():
    return shutil.which("pw-play") or shutil.which("paplay")


def play(path):
    if player() and path and path.exists():
        detach([player(), str(path)])


def stop_preview():
    """Cut off the sound the picker is playing, if it's still ours."""
    try:
        pid = int(PREVIEW.read_text())
        if Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")[0] == player().encode():
            os.kill(pid, 15)
    except (OSError, ValueError, AttributeError):
        pass
    PREVIEW.unlink(missing_ok=True)


def preview(path):
    """Play a sound in the picker: one at a time, the last one picked cutting
    the one before it off, as the cursor runs down the list."""
    stop_preview()
    if player() and path and path.exists():
        p = subprocess.Popen([player(), str(path)], stdin=subprocess.DEVNULL, env=clean_env(),
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        STATE.mkdir(parents=True, exist_ok=True)
        PREVIEW.write_text(str(p.pid))


def set_sound(name):
    STATE.mkdir(parents=True, exist_ok=True)
    SOUND_FILE.write_text(name + "\n")


def add_sound():
    """Open the folder your own sounds go in."""
    USER_SOUNDS.mkdir(parents=True, exist_ok=True)
    if shutil.which("xdg-open"):
        detach(["xdg-open", str(USER_SOUNDS)])
    notify("amarchy", f"Put a sound file in {USER_SOUNDS}, then pick it in Sound.", ICON_SOUND)


def menu_pick_sound():
    """The sounds in the Omarchy menu, for when the shell plugin isn't there:
    picking one sets it and plays it, and the menu comes back to try another;
    Escape keeps the last one picked."""
    while True:
        found, now = sounds(), sound_name()
        rows = [(ICON_CHECK if name == now else ICON_SOUND, sound_label(name)) for name in found]
        rows.append((ICON_CHECK if now == "off" else ICON_MUTE, "Off"))
        rows.append((ICON_ADD, ADD_SOUND))
        choice = menu_select("Sound", rows)
        if not choice:
            return 0
        if choice == ADD_SOUND:
            add_sound()
            return 0
        if choice == "Off":
            set_sound("off")
            return 0
        name = sound_key(choice, found)
        if name:
            set_sound(name)
            preview(found[name])


def cmd_sound(args):
    """`amarchy sound`: the picker (a menu with each sound playing as the
    cursor lands on it). With a name, set it; --show, --list [--json],
    --play [name], --stop and --add for the rest."""
    if args and args[0] == "--show":
        print(sound_name())
        return 0
    if args and args[0] == "--list":
        found = sounds()
        if "--json" in args:
            print(json.dumps({"current": sound_name(), "sounds": [
                {"name": name, "label": sound_label(name), "path": str(path)} for name, path in found.items()]}))
        else:
            for name, path in found.items():
                print(f"{name}\t{path}")
        return 0
    if args and args[0] == "--play":
        name = " ".join(args[1:]) or sound_name()
        if name == "off":
            return fail("the sound is off (name one to hear it: amarchy sound --play <name>)")
        path = sound_file(name)
        if not path:
            return fail(f"no sound {name!r} (see amarchy sound --list)")
        preview(path)
        return 0
    if args and args[0] == "--stop":
        stop_preview()
        return 0
    if args and args[0] == "--add":
        add_sound()
        return 0
    if not args:
        if native_panel():
            tell_shell("sounds")
            return 0
        return menu_pick_sound()
    name = " ".join(args)
    if name.lower() == "off":
        set_sound("off")
    else:
        key = sound_key(name)
        if not key:
            return fail(f"no sound {name!r} (see amarchy sound --list)")
        set_sound(key)
    print(sound_name())
    return 0


# ------------------------------------------------------------------ run

def guess_run(path):
    """A project's usual "start the app" command, from what's in the repo."""
    path = Path(path)
    if (path / "bin/dev").exists():
        return "bin/dev"
    if (path / "package.json").exists():
        try:
            scripts = json.loads((path / "package.json").read_text()).get("scripts", {})
        except ValueError:
            scripts = {}
        pm = next((pm for lock, pm in (("bun.lock", "bun"), ("bun.lockb", "bun"), ("pnpm-lock.yaml", "pnpm"),
                                       ("yarn.lock", "yarn")) if (path / lock).exists()), "npm")
        for script in ("dev", "start"):
            if script in scripts:
                return f"{pm} run {script}"
    if (path / "Cargo.toml").exists():
        return "cargo run"
    if (path / "go.mod").exists():
        return "go run ."
    if (path / "manage.py").exists():
        return "python manage.py runserver"
    if (path / "Makefile").exists() and re.search(r"^run:", (path / "Makefile").read_text(errors="ignore"), re.M):
        return "make run"
    return ""


def run_command(s):
    saved = RUN / s["repo"]
    return saved.read_text().strip() if saved.exists() else guess_run(s["path"])


def set_run_command(repo, command):
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / repo).write_text(command.strip() + "\n")


def run_env(s):
    """What a run command can refer to, as $AMARCHY_PATH and so on. One command
    is saved per project, these make it fit each of its sessions."""
    return {"AMARCHY_PATH": s["path"], "AMARCHY_NAME": s["name"], "AMARCHY_REPO": s["repo"],
            "AMARCHY_BRANCH": s["branch"], "AMARCHY_ROOT": str(WORK / s["repo"])}


def session_env(s):
    """The environment of a session's windows, Claude and the terminal: AMARCHY=1
    says it's amarchy, AMARCHY_SESSION which session (what `amarchy run`,
    `rename` and `close` act on from there, whatever is on screen), plus what
    a run command can refer to."""
    return {"AMARCHY": "1", "AMARCHY_SESSION": s["id"], **run_env(s)}


def saved_commands(repo):
    """The project's other saved commands, {name: command}."""
    try:
        return json.loads((RUN / f"{repo}.json").read_text())
    except (OSError, ValueError):
        return {}


def save_command(repo, name, command):
    """Save a named command, or drop it when command is empty."""
    commands = saved_commands(repo)
    if command:
        commands[name] = command.strip()
    else:
        commands.pop(name, None)
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / f"{repo}.json").write_text(json.dumps(commands, indent=2) + "\n")


def run_in_terminal(s, command):
    """Restart the session's terminal on command: it shows, runs, and leaves
    you in a shell when it ends. The new terminal opens out of sight, takes
    the old one's place beside Claude and only then is the old one closed, so
    the terminal on the right just starts over."""
    if HOST_MODE:
        return host_run(s, command)
    # From the session on screen it shows (leaving zen mode). An agent in
    # another session restarts its terminal where it is, out of sight in zen
    # mode, and leaves the keyboard alone.
    on_screen = current_session_id() == s["id"]
    if on_screen and not leave_zen():
        return 1
    old = find(term_class(s))
    shell = os.environ.get("SHELL", "bash")
    script = (f"printf '\\033[2m$ %s\\033[0m\\n' {shlex.quote(command)}; "
              f"{command}; exec {shlex.quote(shell)}")
    open_term(term_class(s), f"{s['repo']} · {s['name']} · terminal", s["path"], [shell, "-ic", script],
              env=session_env(s))
    new = wait_for(term_class(s), besides=old and old["address"])
    if not new:
        return fail("the terminal didn't open")
    if new["workspace"]["name"] != HIDDEN:     # without amarchy's window rule (an old Hyprland config)
        move_to(new["address"], HIDDEN)
    # Over the old one, which then goes.
    arrange(s["id"], focus="claude" if on_screen else None, term=new)
    if old:
        hypr(f'hl.dsp.window.close({{ window = "address:{old["address"]}" }})')
    return 0


ICON_RUN = "󰐊"
RUN_DEFAULT = "run"
SAVE_COMMAND = "Save a command"


def pick_command(s):
    """Choose one of the project's commands in the Omarchy menu and run it."""
    commands = saved_commands(s["repo"])
    rows = [(ICON_RUN, RUN_DEFAULT, run_command(s) or "Not set yet")]
    rows += [(ICON_RUN, name, command) for name, command in commands.items() if name != RUN_DEFAULT]
    rows.append((ICON_ADD, SAVE_COMMAND, "Name it, then type it"))
    choice = menu_select(f"Run in {s['repo']}", rows)
    if not choice:
        return 1
    if choice == RUN_DEFAULT:
        return cmd_run([])
    if choice != SAVE_COMMAND:
        return run_in_terminal(s, commands[choice])
    name = menu_input("Name for the command")
    command = name and menu_input(f"Command for {name}")
    if not command:
        return 1
    save_command(s["repo"], name, command)
    notify("amarchy", f"Saved {name} for {s['repo']}")
    return 0


def cmd_run(args):
    """Run the project in the session's terminal: the command shows, runs, and
    leaves you in a shell when it ends. Running again restarts it. A name runs
    one of the project's other saved commands instead."""
    sid = own_session_id()
    s = session(sid) if sid else None
    if not s:
        return 1
    if s.get("host"):
        return remote_run(s, args)
    if s.get("setup") and (not args or not args[0].startswith("--") or args[0] == "--pick"):
        return fail(f"{s['name']} is still being set up: run it once Claude has started")
    flag = args[0] if args else ""
    if flag == "--set":
        command = " ".join(args[1:]) or menu_input(f"Run command for {s['repo']}")
        if not command:
            return 1
        set_run_command(s["repo"], command)
        return 0
    if flag == "--save":
        if len(args) < 2 or args[1] == RUN_DEFAULT:
            return fail("Usage: amarchy run --save <name> [command] (the run command itself: amarchy run --set)")
        command = " ".join(args[2:]) or menu_input(f"Command for {args[1]}")
        if not command:
            return 1
        save_command(s["repo"], args[1], command)
        return 0
    if flag == "--forget":
        if len(args) < 2 or args[1] not in saved_commands(s["repo"]):
            return fail(f"No saved command {' '.join(args[1:])!r} for {s['repo']}")
        save_command(s["repo"], args[1], "")
        return 0
    if flag == "--pick":
        return pick_command(s)
    command = run_command(s)
    if flag == "--list":
        for name, saved in {RUN_DEFAULT: command, **saved_commands(s["repo"])}.items():
            if saved:
                print(f"{name}\t{saved}")
        return 0
    if flag == "--show":
        print(command)
        return 0 if command else 1
    if flag:
        command = saved_commands(s["repo"]).get(flag)
        if not command:
            return fail(f"No saved command {flag!r} for {s['repo']}. Save it: amarchy run --save {flag} <command>")
        return run_in_terminal(s, command)
    if not command:
        command = menu_input(f"Run command for {s['repo']}")
        if not command:
            return 1
        set_run_command(s["repo"], command)
    return run_in_terminal(s, command)


def cmd_show():
    """Open the session list under the Ⓐ in the bar (the Omarchy menu without the plugin)."""
    if native_panel():
        return subprocess.run(["omarchy-shell", "amarchy-bar", "toggle"], stdout=subprocess.DEVNULL).returncode
    return cmd_pick([])


def cmd_search():
    """Put the keyboard in the session search, as a click on it would: the
    list beside Claude on a session, else the list under the Ⓐ (the Omarchy
    menu, which searches as you type, without the plugin)."""
    if native_panel():
        return subprocess.run(["omarchy-shell", "amarchy", "search"], stdout=subprocess.DEVNULL).returncode
    return cmd_pick([])


def cmd_jump(sid):
    s = session(sid)
    if not s:
        return
    LAST.write_text(sid)
    if theme_name():
        ensure_watcher()
    # The windows open out of sight and go over first, so you land on the
    # session as it is rather than watching it fill in.
    ensure_windows(s)
    focus_workspace(s["workspace"])
    arrange(sid)


def last_session_id(ids):
    last = LAST.read_text().strip() if LAST.exists() else ""
    return last if last in ids else ids[-1]


def cmd_open():
    """Go to amarchy: the last session you were in. Already in a session, this
    does nothing (next/prev move between them). With no sessions yet, start one."""
    ids = [s["id"] for s in sessions()]
    if not ids:
        cmd_new([])
    elif current_session_id() not in ids:
        cmd_jump(last_session_id(ids))


def cmd_step(delta):
    """Move down (+1) or up (-1) the session list, wrapping around.
    From outside amarchy, go to the last session you were in. In zen mode the
    list peeks out of the bar for a moment to show where you landed."""
    ids = [s["id"] for s in session_view()]
    if not ids:
        return 1
    current = current_session_id()
    if current not in ids:
        cmd_jump(last_session_id(ids))
    else:
        cmd_jump(ids[(ids.index(current) + delta) % len(ids)])
    tell_shell("peek")
    return 0


# ------------------------------------------------------------------ new / close

def has_origin(repo_dir):
    return "origin" in sh("git", "remote", cwd=repo_dir).stdout.split()


def default_base(repo_dir):
    """What a new session branches off: origin's default branch, else the
    local main or master. From what's already fetched, so it's instant."""
    if has_origin(repo_dir):
        head = sh("git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=repo_dir).stdout.strip()
        if head:
            return head
        for b in ("origin/main", "origin/master"):
            if sh("git", "rev-parse", "--verify", "--quiet", b, cwd=repo_dir).returncode == 0:
                return b
    for b in ("main", "master"):
        if sh("git", "rev-parse", "--verify", "--quiet", b, cwd=repo_dir).returncode == 0:
            return b
    return "HEAD"


FETCH_TIMEOUT = 30


def fetch_base(repo_dir, base):
    """Bring base up to date from origin, and return it (it can change when
    origin's branches were never fetched). Only that branch when base is on
    origin, which is much quicker than fetching everything in a big repo.
    The error, if any, comes second: without the network the session still
    starts, from what was fetched last."""
    if not has_origin(repo_dir):
        return base, None
    branch = base.removeprefix("origin/") if base.startswith("origin/") else None
    try:
        r = subprocess.run(["git", "fetch", "--quiet", "origin", *([branch] if branch else [])], cwd=repo_dir,
                           capture_output=True, text=True, timeout=FETCH_TIMEOUT, stdin=subprocess.DEVNULL,
                           env={**os.environ, "GIT_TERMINAL_PROMPT": "0", "GIT_SSH_COMMAND": os.environ.get(
                               "GIT_SSH_COMMAND", "ssh -o BatchMode=yes")})
        error = r.stderr.strip() if r.returncode else None
    except subprocess.TimeoutExpired:
        error = f"no answer from origin in {FETCH_TIMEOUT}s"
    return (base if branch else default_base(repo_dir)), error


def set_trust(path, trusted):
    """Pre-accept (or forget) Claude Code's per-folder trust prompt for a worktree.

    Written atomically; ~/.claude.json is shared with running Claude processes."""
    cfg = HOME / ".claude.json"
    try:
        data = json.loads(cfg.read_text())
    except (OSError, ValueError):
        return
    projects = data.setdefault("projects", {})
    if trusted:
        projects.setdefault(str(path), {})["hasTrustDialogAccepted"] = True
    else:
        projects.pop(str(path), None)
    tmp = cfg.with_name(".claude.json.amarchy-tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, cfg)


def hook_settings(sid):
    def h(state):
        return [{"hooks": [{"type": "command", "command": f"{shlex.quote(ENTRY)} hook {sid} {state}"}]}]
    settings = {"hooks": {
        "SessionStart": h("start"),
        "UserPromptSubmit": h("working"),
        "PreToolUse": h("working"),
        "Notification": h("waiting"),
        "Stop": h("idle"),
    }}
    if not theme_name():
        claude_theme(DESKTOP / "theme/claude.json")
    if CLAUDE_THEME.exists():
        settings["theme"] = "custom:amarchy"
    return json.dumps(settings)


# Session names: a silly adjective and a famous anarchist, e.g. "wobbly-bakunin".
ADJECTIVES = ("bewildered", "caffeinated", "chaotic", "cranky", "crunchy", "disgruntled", "feral",
              "fluffy", "giddy", "grumpy", "jittery", "mischievous", "rowdy", "sassy", "sleepy",
              "smug", "sneaky", "soggy", "spicy", "squeaky", "stubborn", "suspicious", "unbothered",
              "unruly", "wobbly", "wonky", "zesty", "dramatic", "fancy", "rebellious")
ANARCHISTS = ("bakunin", "berkman", "bookchin", "decleyre", "diogenes", "durruti", "godwin",
              "goldman", "graeber", "kotoku", "kropotkin", "landauer", "magon", "makhno",
              "malatesta", "michel", "parsons", "proudhon", "reclus", "rocker", "sacco", "stirner",
              "tolstoy", "vanzetti", "ward", "ferrer", "steimer", "lum", "fabbri", "ito")


def auto_name(repo):
    """A free branch name like "wobbly-bakunin", so a session needs no naming up front."""
    taken = set(sh("git", "branch", "--format=%(refname:short)", cwd=WORK / repo).stdout.split())
    taken |= {s["name"] for s in sessions() if s["repo"] == repo}
    for _ in range(100):
        name = f"{random.choice(ADJECTIVES)}-{random.choice(ANARCHISTS)}"
        if name not in taken:
            return name
    return f"session-{int(time.time())}"


def create(repo, name, prompt=None, jump=True):
    """Start a session, and show it right away: its row in the list, its
    workspace, and Claude's window, where `amarchy setup` makes the worktree
    in front of you and then becomes Claude, asked prompt first if given.
    Without jump it starts the same way out of sight: its row shows up in the
    list and the screen stays where it is. Returns the session id."""
    repo_dir = WORK / repo
    name = slug(name)
    if not name or not (repo_dir / ".git").exists():
        notify("amarchy", f"Can't create session: bad repo or name ({repo}/{name})")
        return None
    sid = f"{repo}-{name}"
    if session(sid):
        if prompt is not None:
            # Its Claude is already running: a first prompt can't reach it.
            notify("amarchy", f"{repo} · {name} is already open, so it can't take a first prompt")
            print(f"{sid} already exists: message its Claude instead (amarchy list has its agent name)",
                  file=sys.stderr)
            return None
        if jump and not HOST_MODE:
            cmd_jump(sid)
        return sid
    if sh("git", "rev-parse", "--verify", "--quiet", "HEAD", cwd=repo_dir).returncode != 0:
        notify("amarchy", f"{repo} has no commits yet. Commit something to branch off first.")
        return None

    SESSIONS.mkdir(parents=True, exist_ok=True)
    STATUS.mkdir(parents=True, exist_ok=True)
    (STATE / "failed" / sid).unlink(missing_ok=True)
    # "setup" until the worktree is there. Working meanwhile, so the list
    # spins on it; Claude's SessionStart hook settles it.
    s = {"id": sid, "repo": repo, "name": name, "branch": name, "base": default_base(repo_dir),
         "path": str(WORKTREES / repo / name), "created": int(time.time()),
         "prefix": PREFIX, "workspace": WS_PREFIX + sid, "setup": True}
    if prompt is not None:
        s["prompt"] = prompt      # taken (once) by `amarchy claude` when Claude starts
    if not jump:
        s["no_jump"] = True       # no "is ready" toast: nobody's waiting for it
    save_session(s)
    (STATUS / sid).write_text("working")
    if HOST_MODE:
        host_start(s)       # its tmux sets it up and becomes Claude, as a window would
        return sid
    tell_shell("refresh")
    cmd_layout()
    if jump:
        cmd_jump(sid)
    else:
        # Claude's window (where the setup runs) opens out of sight and goes
        # to the session's workspace without following it.
        ensure_windows(s)
    return sid


def make_worktree(s):
    """Fetch the session's base and add its worktree, saying how it goes.
    Returns an error message, or None once the worktree is there (and the
    session no longer being set up)."""
    repo_dir, path, name = WORK / s["repo"], Path(s["path"]), s["branch"]
    base = s["base"]
    # Already there when the window was closed before Claude started.
    if not (path / ".git").exists():
        with step(f"Fetching the latest {base}") as st:
            base, error = fetch_base(repo_dir, base)
            if error:
                st.warn(f"Couldn't fetch, so from what was fetched last: {gist(error)}")
        with step(f"Making the worktree, branch {name} off {base}") as st:
            path.parent.mkdir(parents=True, exist_ok=True)
            r = sh("git", "worktree", "add", "-b", name, str(path), base, cwd=repo_dir)
            if r.returncode != 0 and sh("git", "rev-parse", "--verify", "--quiet", f"refs/heads/{name}",
                                        cwd=repo_dir).returncode == 0:
                # The branch is already there (e.g. a kept, unmerged one): pick it back up.
                st.note(f"Branch {name} was already there: picked it back up")
                sh("git", "worktree", "prune", cwd=repo_dir)
                r = sh("git", "worktree", "add", str(path), name, cwd=repo_dir)
            if r.returncode != 0:
                st.fail()
                return r.stderr.strip() or "git worktree add failed"
    if (CLOSING / f"{s['id']}.json").exists():
        return "closed"           # meanwhile: leave it gone
    s = session(s["id"]) or s     # as it is now: it may have been renamed meanwhile
    s.pop("setup", None)
    s["base"] = base
    save_session(s)
    return None


def gist(error):
    """The line of git's error that says what went wrong."""
    lines = [l.strip() for l in error.splitlines() if l.strip()]
    return next((l for l in lines if l.lower().startswith(("fatal:", "error:"))), lines[0] if lines else "")[:200]


class step:
    """One line of `amarchy setup`: a spinner while it runs, then ✓ (or ✗)."""
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, text):
        self.text, self.mark, self.notes = text, "\033[32m✓\033[0m", []

    def __enter__(self):
        self.started, self.done = time.time(), False

        def spin():
            i = 0
            while not self.done and sys.stdout.isatty():
                print(f"\r\033[K  {self.FRAMES[i % len(self.FRAMES)]} {self.text}…", end="", flush=True)
                i += 1
                time.sleep(0.08)
        self.thread = threading.Thread(target=spin, daemon=True)
        self.thread.start()
        return self

    def warn(self, text):
        self.mark = "\033[33m!\033[0m"
        self.notes.append(text)

    def note(self, text):
        self.notes.append(text)

    def fail(self):
        self.mark = "\033[31m✗\033[0m"

    def __exit__(self, *exc):
        self.done = True
        self.thread.join()
        took = time.time() - self.started
        print(f"\r\033[K  {self.mark} {self.text} \033[2m{took:.1f}s\033[0m", flush=True)
        for n in self.notes:
            print(f"    \033[2m{n}\033[0m", flush=True)


def setup_session(sid):
    """The first thing in a new session's Claude window: make its worktree and
    open the terminal beside it. On failure, say why, drop the session, and
    return the error."""
    s = session(sid)
    if not s:
        fail(f"No session {sid!r}")
        return f"no session {sid!r}"
    print(f"\n  \033[1m{s['repo']} · {s['name']}\033[0m\n", flush=True)
    error = make_worktree(s)
    if error and (CLOSING / f"{sid}.json").exists():
        return error        # closed meanwhile: its reap is cleaning up
    if error:
        print(f"\n  \033[31m{error}\033[0m\n", flush=True)
        (SESSIONS / f"{sid}.json").unlink(missing_ok=True)
        (STATUS / sid).unlink(missing_ok=True)
        tell_shell("refresh")
        notify("amarchy", f"Couldn't start {s['repo']} · {s['name']}: {gist(error)}")
        if HOST_MODE:
            # Nobody may be watching: the desktop's window shows it on attach.
            write_file(STATE / "failed" / sid, gist(error) or error)
            time.sleep(3)
            return error
        try:
            input("  Press Enter to close this window. ")
        except (EOFError, KeyboardInterrupt):
            pass
        return error
    s = session(sid)
    if not s:
        return "closed"     # while it was being set up
    set_trust(Path(s["path"]), True)
    tell_shell("refresh")
    if HOST_MODE:
        host_start(s)       # the terminal beside it, now that the worktree is there
        print("  \033[32m✓\033[0m Starting Claude Code", flush=True)
        return None
    with step("Starting Claude Code"):
        # The terminal beside it, out of sight until it's in place. Nothing
        # takes the keyboard: you may have gone somewhere else meanwhile.
        ensure_windows(s)
        arrange(sid, focus=None)
    s = session(sid) or s
    if s.pop("no_jump", None):
        save_session(s)
    elif current_session_id() != sid:
        notify("amarchy", f"{s['repo']} · {s['name']} is ready", click=("jump", sid))
    return None


def cmd_setup(sid):
    """`amarchy setup`, what windows opened before the window loop ran: set
    the session up, then become Claude."""
    if setup_session(sid):
        return 1
    return cmd_claude(sid)


def projects_dir(path):
    """Where Claude Code keeps the conversations of a folder."""
    return HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", str(path))


def has_conversation(path):
    """Whether Claude Code has a saved conversation for this folder."""
    return any(projects_dir(path).glob("*.jsonl"))


def claude_dir(sid):
    """What amarchy keeps about a session's Claude: its conversation, and
    while it sleeps, that it does and the prompt it had."""
    return CLAUDE_STATE / sid


def conversation_id(sid):
    try:
        return (claude_dir(sid) / "conversation").read_text().strip()
    except OSError:
        return ""


def set_conversation_id(sid, conversation):
    """Record which conversation the session's Claude is in (it changes with
    /clear), to resume exactly that one."""
    if not re.fullmatch(r"[0-9a-f-]{36}", conversation or "") or conversation == conversation_id(sid):
        return
    write_file(claude_dir(sid) / "conversation", conversation)


def write_file(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}")
    tmp.write_bytes(text) if isinstance(text, bytes) else tmp.write_text(text)
    os.replace(tmp, path)


def transcript(s):
    """The file of the conversation the session is in, if there is one yet."""
    conversation = conversation_id(s["id"])
    f = projects_dir(s["path"]) / f"{conversation}.jsonl" if conversation else None
    return f if f and f.exists() else None


def claude_argv(s, prefill="", prompt=None):
    """Claude Code for a session, picking its conversation back up: the one it
    was in, else the latest in its folder (sessions from before amarchy kept
    track), with prefill already typed in the prompt, or asked prompt first
    (after --, so it may start with a dash)."""
    if transcript(s):
        resume = ["--resume", conversation_id(s["id"])]
    else:
        resume = ["--continue"] if has_conversation(s["path"]) else []
    first = ["--", prompt] if prompt is not None else []
    return ["claude", *CLAUDE_ARGS, *resume, *(["--prefill", prefill] if prefill and prompt is None else []),
            "--settings", hook_settings(s["id"]), *first]


# What runs in a session's Claude window: Claude, and while the session sleeps
# (Claude has exited, the window stays) a wait for the first key, which then
# goes to a stand-in for Claude's prompt (woke). Quitting Claude yourself
# closes the window, as it always did. A shell rather than amarchy, because
# it's what stays while the session sleeps; amarchy itself only runs in between.
WINDOW_LOOP = ('while :; do "$0" claude "$1"; "$0" asleep "$1" || exit; '
               '"$0" woke "$1" "$(stty -icanon -echo -isig -ixon min 1 time 0; dd bs=1 count=1 2>/dev/null | od -An -tx1)"; '
               'done')


def window_argv(s):
    return ["sh", "-c", WINDOW_LOOP, ENTRY, s["id"]]


def window_loop(win, procs):
    """The pid of the window loop in a Claude window, or None for a window
    opened before there was one (Claude then is the window's own process)."""
    return next((p for p in descendants(win["pid"], procs)[:3]
                 if procs[p][1] == "sh" and '"$0" claude "$1"' in " ".join(cmdline(p))), None)


def window_claude(win, procs):
    """The pid of the Claude Code running in a session's window, if it is."""
    return next((p for p in descendants(win["pid"], procs) if procs[p][1] == "claude"), None)


def your_editor():
    """The editor you set for Claude Code's Ctrl+G, as a command line."""
    visual = os.environ.get("VISUAL", "")
    if visual.startswith(str(STATE / "editor")):    # ours, from a Claude it started
        visual = ""
    return os.environ.get("AMARCHY_VISUAL") or visual or os.environ.get("EDITOR") or "vi"


def editor_shim(editor):
    """What Claude runs as $VISUAL (Ctrl+G, "edit the prompt in your editor"):
    bin/amarchy-editor, which hands the prompt to amarchy when it's putting
    the session to sleep, and opens your editor any other time. Claude takes
    $VISUAL as one command, without arguments, and names it in a hint ("ctrl+g
    to edit in Nvim"), so it's a link named after your editor."""
    name = Path(shlex.split(editor)[0] if editor.strip() else "vi").name
    link = STATE / "editor" / name
    target = Path(SELF).parent / "amarchy-editor"
    try:
        if not link.is_symlink() or os.readlink(link) != str(target):
            link.parent.mkdir(parents=True, exist_ok=True)
            tmp = link.with_name(f".{name}.{os.getpid()}")
            tmp.unlink(missing_ok=True)
            tmp.symlink_to(target)
            os.replace(tmp, link)
    except OSError:
        return None
    return link


def take(f):
    """A file's text, removing the file (a prompt meant for Claude once)."""
    try:
        text = f.read_text()
    except OSError:
        return None
    f.unlink(missing_ok=True)
    return text


def cmd_claude(sid):
    """The window loop's first step: set a new session up, then become Claude
    Code: with the message you sent while it slept, or what you had typed in
    its prompt. Asleep, it does nothing: the loop shows the session."""
    s = session(sid)
    if not s:
        return fail(f"No session {sid!r}")
    if s.get("setup"):
        if setup_session(sid):
            return 1
        s = session(sid)
    if asleep_since(sid) is not None:
        return 0
    # The first prompt (amarchy new --prompt) goes to Claude once: if the window
    # is closed and comes back, Claude picks the conversation up instead.
    prompt = s.pop("prompt", None)
    if prompt is not None:
        save_session(s)
    sent = take(claude_dir(sid) / "send")
    prompt = sent if sent is not None and prompt is None else prompt
    prefill = take(claude_dir(sid) / "draft") or ""
    path = Path(s["path"])
    os.chdir(path)
    os.environ["PWD"] = str(path)
    editor = your_editor()
    shim = editor_shim(editor)
    if shim:
        os.environ["AMARCHY_VISUAL"] = editor
        os.environ["VISUAL"] = str(shim)
    argv = claude_argv(s, prefill.strip("\n"), prompt)
    try:
        os.execvp(argv[0], argv)
    except OSError as e:
        print(f"\n  \033[31mCouldn't start Claude Code: {e}\033[0m\n", flush=True)
        try:
            input("  Press Enter to close this window. ")
        except (EOFError, KeyboardInterrupt):
            pass
        return 1


def ensure_windows(s, wake=False):
    """Open whatever a session is missing: Claude's window and, outside zen
    mode, the terminal. Both open out of sight and are moved over once there,
    so nothing lands on whatever workspace you're on. Windows are disposable,
    like any other window in Omarchy: close one with Super+W and the next jump
    (or terminal key) brings it back. The session itself only ends with close.

    A Claude window that comes back opens asleep (the conversation, and a key
    to wake it), so going through your sessions doesn't start a Claude in each;
    wake starts it right away instead. A new session sets itself up first."""
    path = Path(s["path"])
    setting_up = bool(s.get("setup"))
    # A remote session's windows are views of its tmux on the host (attach_argv),
    # which never sleeps; its terminal waits there for the worktree.
    remote = s.get("host")
    if not remote and not setting_up and not path.is_dir():
        return
    opened = []
    if not find(claude_class(s)):
        if remote:
            open_term(claude_class(s), f"amarchy:{s['id']}", HOME, attach_argv(s, "claude"))
        else:
            if not setting_up and not wake and asleep_since(s["id"]) is None:
                mark_asleep(s["id"])
            # A new session's worktree isn't there yet: it starts in the project's checkout.
            open_term(claude_class(s), f"amarchy:{s['id']}", WORK / s["repo"] if setting_up else path,
                      window_argv(s), env=session_env(s))
        opened.append(claude_class(s))
    if (remote or not setting_up) and not zen() and not find(term_class(s)):
        title = f"{s['repo']} · {s['name']} · terminal"
        if remote:
            open_term(term_class(s), title, HOME, attach_argv(s, "term"))
        else:
            open_term(term_class(s), title, path, env=session_env(s))
        opened.append(term_class(s))
    for cls in opened:
        win = wait_for(cls)
        # The terminal stays hidden; arrange() puts it beside Claude.
        if win and cls == claude_class(s) and win["workspace"]["name"] != s["workspace"]:
            move_to(win["address"], f"name:{s['workspace']}")
        elif win and cls == term_class(s) and win["workspace"]["name"] != HIDDEN:
            move_to(win["address"], HIDDEN)


def cmd_new(args):
    """amarchy new [project] [name] [--prompt <text>|-] [--no-jump]: the new
    session's id on stdout. --prompt is the first thing its Claude is asked
    (- reads it from stdin). --no-jump starts it out of sight: it shows up in
    the list, and the screen stays where it is."""
    prompt, jump, rest = None, True, []
    it = iter(args)
    for a in it:
        if a == "--no-jump":
            jump = False
        elif a == "--prompt":
            prompt = next(it, None)
            if prompt is None:
                return fail("--prompt needs the text, or - to read it from stdin")
        elif a.startswith("--prompt="):
            prompt = a.split("=", 1)[1]
        elif a.startswith("--"):
            return fail(f"amarchy new doesn't know {a} (it takes --prompt and --no-jump)")
        else:
            rest.append(a)
    if len(rest) > 2:
        return fail("usage: amarchy new [project] [name] [--prompt <text|->]")
    if prompt == "-":
        prompt = sys.stdin.read()
    if prompt is not None and not prompt.strip():
        return fail("--prompt is empty")
    repo = rest[0] if rest else menu_pick_project()
    if not repo:
        return 1
    if remote_host():
        sid = remote_create(remote_host(), repo, rest[1] if len(rest) > 1 else None, prompt, jump)
    else:
        sid = create(repo, rest[1] if len(rest) > 1 else auto_name(repo), prompt, jump)
    if not sid:
        return 1
    print(sid)
    return 0


# ------------------------------------------------------------------ sleep
#
# A session you're not using sleeps, with only a badge in its window saying so
# (sleep_badge): its Claude Code exits, so it holds no memory, and everything
# else stays as it was. Claude is stopped outright (SIGKILL), so it never gets to put the terminal back: its
# last screen stays in the window, the conversation, its prompt and the cursor
# in it. Type there and a stand-in for that prompt (woke) shows what you type
# right where Claude would; send it (Enter) and Claude comes back with it
# (`claude --resume <conversation> -- <message>`), its first screen replacing
# the old one in a single repaint. Anything the stand-in doesn't do (arrows,
# Ctrl keys, a new line, scrolling, a line too long) brings Claude back at
# once, with what you typed already in its prompt (--prefill). Whatever was
# typed in the prompt and not sent yet comes back too: before Claude exits,
# amarchy asks it for the prompt with Ctrl+G (Claude's "edit the prompt in your
# editor"), with amarchy-editor as the editor.
#
# A window that was closed comes back asleep as well: there's no screen of
# Claude's to keep then, so amarchy draws the conversation and a prompt like
# Claude's, and the stand-in works the same.
#
# What would be lost with Claude's process keeps a session awake: a turn in
# progress, a question waiting for you, commands running in the background,
# background agents still working, a /loop or a scheduled task, Remote Control.
# The timer (`amarchy sleep --idle`, every 30s from a systemd user timer) puts
# sessions to sleep once they've been idle and off screen for `sleep --after`
# minutes.

SLEEP_AFTER_DEFAULT = 1         # minutes
QUIET = 30                      # seconds the conversation has to have been still
BUSY_CPU = 0.05                 # share of a core above which an idle-looking Claude is still doing something
HANDOVER_TIMEOUT = 3            # seconds Claude has to hand its prompt over
HANDOVER_STALE = 15             # seconds a request for the prompt counts
REPAINT = 0.3                   # seconds Claude gets to draw its prompt again after handing it over


def sleep_after():
    """Minutes a session waits, idle and off screen, before it sleeps (None: never)."""
    try:
        value = SLEEP_AFTER.read_text().strip()
    except OSError:
        return SLEEP_AFTER_DEFAULT
    if value == "off":
        return None
    try:
        return max(float(value), 0)
    except ValueError:
        return SLEEP_AFTER_DEFAULT


def asleep_since(sid):
    """When the session went to sleep, or None while it's awake."""
    try:
        return (claude_dir(sid) / "asleep").stat().st_mtime
    except OSError:
        return None


# How a sleeping session's window looks: Claude's own last screen, still there
# ("frozen"), or one amarchy draws (a window that opened with Claude asleep).
FROZEN, DRAWN = "frozen", "drawn"


def mark_asleep(sid, look=DRAWN):
    write_file(claude_dir(sid) / "asleep", f"{time.strftime('%Y-%m-%d %H:%M:%S')}\n{look}\n")


def asleep_look(sid):
    try:
        lines = (claude_dir(sid) / "asleep").read_text().split("\n")
    except OSError:
        return None
    return lines[1] if len(lines) > 1 and lines[1] in (FROZEN, DRAWN) else DRAWN


def clear_asleep(sid):
    (claude_dir(sid) / "asleep").unlink(missing_ok=True)


def all_background_sessions():
    """Every Claude Code background session (/bg, `claude --bg`) still
    running, as Claude Code lists them in ~/.claude/sessions."""
    out = []
    for f in (HOME / ".claude/sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if d.get("kind") == "bg" and d.get("pid") and Path(f"/proc/{d['pid']}").exists():
            out.append(d)
    return out


def background_sessions(s, every=None):
    """The background sessions started in this session's worktree (of every,
    if they were already read)."""
    return [d for d in (all_background_sessions() if every is None else every)
            if (d.get("cwd") or "") == s["path"] or (d.get("cwd") or "").startswith(s["path"] + "/")]


def stop_background(s, only_idle=True):
    """Stop the session's background sessions (all of them, or those with
    nothing to do). Claude Code keeps their conversations: `claude attach`
    brings one back. Returns how many it stopped."""
    stopped = 0
    for d in background_sessions(s):
        if only_idle and d.get("status") != "idle":
            continue
        try:
            exe = os.readlink(f"/proc/{d['pid']}/exe").removesuffix(" (deleted)")
        except OSError:
            exe = ""
        exe = exe if exe and os.path.exists(exe) else shutil.which("claude")
        job = d.get("jobId") or d.get("sessionId", "")[:8]
        if not exe or not job:
            continue
        try:
            r = subprocess.run([exe, "stop", job], capture_output=True, text=True, timeout=20,
                               stdin=subprocess.DEVNULL, env=clean_env())
        except subprocess.TimeoutExpired:
            continue
        stopped += r.returncode == 0
    return stopped


def claude_key(name):
    """The key Claude Code has for one of its actions (keybindings.json), as
    Hyprland names it: ("CTRL", "G")."""
    key = {"chat:externalEditor": "ctrl+g"}.get(name, "")
    try:
        data = json.loads((HOME / ".claude/keybindings.json").read_text())
    except (OSError, ValueError):
        data = {}

    def walk(node):
        if isinstance(node, dict):
            for k, v in node.items():
                if v == name and "+" in k and " " not in k:
                    yield k
                else:
                    yield from walk(v)
        elif isinstance(node, list):
            for v in node:
                yield from walk(v)
    key = next(walk(data), key)
    *mods, last = key.lower().split("+")
    names = {"ctrl": "CTRL", "control": "CTRL", "alt": "ALT", "meta": "ALT", "option": "ALT",
             "shift": "SHIFT", "super": "SUPER", "cmd": "SUPER"}
    return " ".join(names.get(m, m.upper()) for m in mods), last.upper()


def hand_over_prompt(s, win):
    """Ask the session's Claude for what's typed in its prompt, and keep it
    for when it wakes. False when Claude didn't hand it over (a menu or a
    dialog open, say), so the session had better stay awake."""
    d = claude_dir(s["id"])
    (d / "draft").unlink(missing_ok=True)
    write_file(d / "handover", str(time.time()))
    mods, key = claude_key("chat:externalEditor")
    hypr(f'hl.dsp.send_shortcut({{ mods = "{mods}", key = "{key}", window = "address:{win["address"]}" }})')
    end = time.time() + HANDOVER_TIMEOUT
    while time.time() < end and (d / "handover").exists():
        time.sleep(0.05)
    handed = not (d / "handover").exists()
    (d / "handover").unlink(missing_ok=True)
    # Claude reads its prompt back from the file it gave the editor, deletes
    # the file, then draws its prompt again where it said "Save and close
    # editor to continue": that last screen is the one that stays.
    try:
        given = Path((d / "handover-file").read_text())
    except OSError:
        given = None
    while handed and given and given.exists() and time.time() < end:
        time.sleep(0.03)
    (d / "handover-file").unlink(missing_ok=True)
    if handed:
        time.sleep(REPAINT)
    return handed


def cmd_editor(args):
    """amarchy-editor, Claude's $VISUAL in a session: while amarchy is putting
    the session to sleep it keeps the prompt Claude hands it (and gives it
    back untouched); any other time it's just your editor."""
    sid = os.environ.get("AMARCHY_SESSION", "")
    files = [a for a in args if not a.startswith("-")]
    request = claude_dir(sid) / "handover" if sid else None
    if request and files and request.exists() and time.time() - request.stat().st_mtime < HANDOVER_STALE:
        try:
            text = Path(files[-1]).read_text(errors="replace")
        except OSError:
            text = ""
        write_file(claude_dir(sid) / "draft", text if text.strip() else "")
        write_file(claude_dir(sid) / "handover-file", files[-1])
        request.unlink(missing_ok=True)
        return 0
    editor = shlex.split(your_editor())
    try:
        os.execvp(editor[0], [*editor, *args])
    except OSError as e:
        return fail(f"can't run your editor {editor[0]}: {e}")


def conversation_records(f, tail=None):
    """The records of a conversation file, the last `tail` bytes of it only if given."""
    try:
        with open(f, "rb") as fh:
            if tail:
                fh.seek(max(fh.seek(0, 2) - tail, 0))
                fh.readline()       # most likely cut in half
            data = fh.read()
    except OSError:
        return []
    out = []
    for line in data.splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def tool_uses(records):
    for r in records:
        if r.get("type") == "assistant":
            for block in r.get("message", {}).get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    yield r, block


def timestamp(record):
    try:
        return calendar.timegm(time.strptime(record["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
    except (KeyError, ValueError, TypeError):
        return 0


def sleep_blockers(s, win, procs, auto):
    """Why the session's Claude had better not exit now, if anything: what
    it would lose. Empty when it can sleep."""
    reasons = []
    sid = s["id"]
    pid = window_claude(win, procs)
    status = (STATUS / sid).read_text().strip() if (STATUS / sid).exists() else "idle"
    if status == "working":
        reasons.append("it's working")
    elif status == "waiting":
        reasons.append("it's waiting for your answer")
    if not window_loop(win, procs):
        reasons.append("its window is from before sessions could sleep, so its prompt can't be kept "
                       "(--force closes the window, anything typed and not sent is lost)")
    if not pid:
        return reasons + ["Claude isn't running in its window"]
    shells = [p for p in descendants(pid, procs) if "/shell-snapshots/" in " ".join(cmdline(p))]
    if shells:
        command = " ".join(cmdline(shells[0]))
        command = re.sub(r"^.*?&& eval '?|'? < /dev/null.*$|' && pwd -P.*$", "", command)[:60]
        reasons.append(f"a command is running in the background ({command})" if command else
                       "a command is running in the background")
    f = transcript(s)
    if f:
        subagents = f.with_suffix("") / "subagents"
        files = [f, *(subagents.glob("*.jsonl") if subagents.is_dir() else [])]
        latest = max((x.stat().st_mtime for x in files if x.exists()), default=0)
        if time.time() - latest < QUIET:
            reasons.append("its conversation is still moving")
        if (f.with_suffix("") / "bridge-pointer.json").exists():
            reasons.append("Remote Control is on")
        records = conversation_records(f, tail=4_000_000)
        wakes, crons = None, 0
        for r, use in tool_uses(records):
            given = use.get("input") or {}
            if use.get("name") == "ScheduleWakeup":
                wakes = None if given.get("stop") else timestamp(r) + float(given.get("delaySeconds") or 0)
            elif use.get("name") == "CronCreate" and time.time() - timestamp(r) < 7 * 86400:
                crons += 1
            elif use.get("name") == "CronDelete":
                crons = max(crons - 1, 0)
        if wakes and wakes + 120 > time.time():
            reasons.append(f"a /loop wakes it again at {time.strftime('%H:%M', time.localtime(wakes))}")
        if crons:
            reasons.append("it has scheduled tasks")
    if auto:
        # Busy without a sign of it anywhere else (a background agent thinking, say).
        sample = claude_dir(sid) / "cpu"
        try:
            was_pid, was_ticks, was_at = json.loads(sample.read_text())
        except (OSError, ValueError):
            was_pid, was_ticks, was_at = None, 0, 0
        ticks, now = procs[pid][2], time.time()
        write_file(sample, json.dumps([pid, ticks, now]))
        if was_pid != pid or now - was_at > 600:
            reasons.append("amarchy is still getting a sense of how busy it is")
        elif (ticks - was_ticks) / os.sysconf("SC_CLK_TCK") / max(now - was_at, 1) > BUSY_CPU:
            reasons.append("it's busy")
    return reasons


def put_to_sleep(s, auto=False, force=False):
    """Stop a session's Claude Code, keeping the session as it was. Returns
    None once it sleeps, else why it didn't."""
    sid = s["id"]
    if s.get("host"):
        return f"it runs on {s['host']}, where sessions don't sleep"
    if s.get("setup"):
        return "it's still being set up"
    win = find(claude_class(s))
    if not win:
        if asleep_since(sid) is None:
            mark_asleep(sid)
            tell_shell("refresh")
        return None
    if asleep_since(sid) is not None:
        return None
    procs = processes()
    reasons = sleep_blockers(s, win, procs, auto)
    if reasons and not force:
        return "; ".join(reasons)
    pid = window_claude(win, procs)
    loop = window_loop(win, procs)
    if loop and pid and not hand_over_prompt(s, win) and not force:
        return "Claude didn't hand over its prompt (a menu or a dialog open?)"
    if auto and current_session_id() == sid:
        (claude_dir(sid) / "draft").unlink(missing_ok=True)    # it's still in Claude's prompt
        return "you came back to it"
    try:
        set_conversation_id(sid, json.loads((HOME / f".claude/sessions/{pid}.json").read_text()).get("sessionId", ""))
    except (OSError, ValueError, TypeError):
        pass
    mark_asleep(sid, FROZEN if loop else DRAWN)
    try:
        stop_background(s)
        if pid:
            freeze_claude(pid, procs)
    except BaseException:
        clear_asleep(sid)       # it isn't asleep: say so, for whoever tries next
        raise
    if not loop:
        # Its window went with it: it opens again, asleep, when you go there.
        hypr(f'hl.dsp.window.close({{ window = "address:{win["address"]}" }})')
    tell_shell("refresh")
    return None


def freeze_claude(pid, procs):
    """Stop a Claude Code at once, before it can put the terminal back (its
    last screen stays), then what it ran (MCP servers) and what it leaves in
    ~/.claude/sessions. Not the windows it may have opened, nor what runs in
    them. It's idle: its conversation is all written already."""
    windows = [p for p in descendants(pid, procs) if procs[p][1] in TERMINALS]
    spared = {q for w in windows for q in (w, *descendants(w, procs))}
    children = [p for p in descendants(pid, procs) if p not in spared]
    try:
        info = json.loads((HOME / f".claude/sessions/{pid}.json").read_text())
    except (OSError, ValueError):
        info = {}
    try:
        os.kill(pid, 9)
    except ProcessLookupError:
        pass
    end = time.time() + 3
    while time.time() < end and Path(f"/proc/{pid}").exists():
        time.sleep(0.05)
    for p in children:
        try:
            os.kill(p, 15)
        except ProcessLookupError:
            pass
    if info.get("pid") == pid:
        (HOME / f".claude/sessions/{pid}.json").unlink(missing_ok=True)
        for key in (HOME / ".claude/sessions").glob(f"{pid}.*.key"):
            key.unlink(missing_ok=True)
        if info.get("messagingSocketPath"):
            Path(info["messagingSocketPath"]).unlink(missing_ok=True)


def wake(s):
    """Start a sleeping session's Claude again, in its window (opening the
    window if it was closed)."""
    sid = s["id"]
    if asleep_since(sid) is None:
        return
    clear_asleep(sid)
    win = find(claude_class(s))
    if not win:
        ensure_windows(s, wake=True)
    else:
        # The window loop waits for a key: stop waiting, as if one came.
        end = time.time() + 3
        while time.time() < end:
            procs = processes()
            loop = window_loop(win, procs)
            readers = [p for p in descendants(loop, procs) if procs[p][1] == "dd"] if loop else []
            for p in readers:
                os.kill(p, 15)
            if readers or not loop:
                break
            time.sleep(0.1)
    tell_shell("refresh")


def sleep_lock(wait):
    """One sleeper at a time, the timer or you: the held lock. The timer
    doesn't wait (None: it's running already); you wait for it."""
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "sleep.lock", "a")
    end = time.time() + (30 if wait else 0)
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except OSError:
            if time.time() >= end:
                lock.close()
                return None
            time.sleep(0.2)


def say(message):
    """A result for whoever asked: printed, and a notification when that was
    you from a key or the menu (no terminal, and not a session's Claude or
    script, which read what's printed)."""
    print(message)
    if not sys.stdout.isatty() and not os.environ.get("AMARCHY_SESSION"):
        notify("amarchy", message, "󰒲")


def cmd_sleep(args):
    """`amarchy sleep [id] [--force]`, `--all`, `--idle` (the timer),
    `--after [minutes|off]`."""
    force = "--force" in args
    rest = [a for a in args if a != "--force"]
    if rest[:1] == ["--after"]:
        if len(rest) == 1:
            after = sleep_after()
            print("off" if after is None else f"{after:g}")
            return 0
        value = rest[1].lower()
        try:
            if value != "off" and float(value) < 0:
                raise ValueError
        except ValueError:
            return fail("usage: amarchy sleep --after <minutes>|off")
        write_file(SLEEP_AFTER, value + "\n")
        return 0
    idle = rest[:1] == ["--idle"]
    lock = sleep_lock(wait=not idle)
    if not lock:
        return 0 if idle else fail("another amarchy is putting sessions to sleep")
    with lock:
        if idle:
            return sleep_idle()
        if rest[:1] == ["--all"]:
            current, slept, kept = current_session_id(), [], []
            for s in session_view():
                if s["awake"] and not s["sleeping"] and s["id"] != current and s["status"] in ("idle", "waiting"):
                    err = put_to_sleep(session(s["id"]), force=force)
                    (kept if err else slept).append((s, err))
            for s, err in kept:
                print(f"{s['id']}: awake, {err}")
            say(f"{len(slept)} session{'s' if len(slept) != 1 else ''} asleep"
                + (f", {len(kept)} kept awake" if kept else ""))
            tell_shell("refresh")
            return 0
        sid = rest[0] if rest else own_session_id()
        s = session(sid) if sid else None
        if not s:
            return fail(f"No session {sid!r}" if sid else "Not in a session (name one: amarchy sleep <id>)")
        err = put_to_sleep(s, force=force)
        if err:
            say(f"{s['repo']} · {s['name']} stays awake: {err}"
                + ("" if force else ". amarchy sleep --force puts it to sleep anyway."))
            return 1
        return 0


def sleep_idle():
    """What the timer does: every session that has been idle and off screen
    for long enough goes to sleep, if nothing would be lost."""
    after = sleep_after()
    if after is None:
        return 0
    current = current_session_id()
    for s in session_view():
        if s.get("host") or not s["awake"] or s["sleeping"] or s["current"] or s["id"] == current or s["status"] not in ("idle", "waiting"):
            continue
        try:
            idle = time.time() - (STATUS / s["id"]).stat().st_mtime
        except OSError:
            idle = float("inf")
        if idle >= after * 60:
            put_to_sleep(session(s["id"]), auto=True)
    return 0


def cmd_wake(args):
    sid = args[0] if args else own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one: amarchy wake <id>)")
    wake(s)
    return 0


# The badge in the top right corner of a sleeping session's window: what you
# see instead of a status glyph (the list keeps showing the session as idle).
# It says the session is asleep, and the moment a key wakes it, that Claude
# is on its way, for the second or so until Claude's first screen covers it.
ASLEEP_BADGE = "Asleep, its memory freed · type to wake"
TYPING_BADGE = "Asleep · Enter wakes Claude with this"
WAKING_BADGE = "Waking Claude…"


def sleep_badge(text, loud=False):
    """Draw the badge, leaving the cursor where it was: dim while the session
    sleeps, in reverse video while it wakes."""
    try:
        width = os.get_terminal_size(1).columns
    except OSError:
        return
    label = f" 󰒲 {text} "
    if text_width(label) + 2 > width:
        label = " 󰒲 "
    col = max(width - text_width(label), 1)
    style = "\033[1;7m" if loud else "\033[2;7m"
    os.write(1, f"\0337\033[1;{col}H{style}{label}\033[0m\0338".encode())


# What a waking window turns off for the second before Claude is back:
# mouse reports (the rest of a scroll would pile up and land in Claude as keys)
# and the alternate scroll mode a terminal falls back to without them (the
# wheel as arrow keys, which Claude's prompt takes for its history). Claude
# turns the mouse back on as it starts.
MOUSE_OFF = b"\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l\033[?1007l"


def cmd_asleep(sid):
    """The window loop, once Claude has exited: 0 if the session sleeps (the
    window keeps showing it), 1 if Claude was quit (the window closes)."""
    s = session(sid)
    if not s or asleep_since(sid) is None:
        return 1
    out = sys.stdout
    if asleep_look(sid) == FROZEN:
        # Claude's screen stays as it was. Only what would now come in without
        # Claude to take it is turned off: mouse movement and focus changes.
        # The wheel and clicks still report, as they did to Claude: they wake it.
        out.write("\033[?1003l\033[?1002l\033[?1004l\033[?2004h")
        out.flush()
        sleep_badge(ASLEEP_BADGE)
        return 0
    sh("stty", "sane")
    try:
        width = os.get_terminal_size().columns
    except OSError:
        width = 100
    draft = (claude_dir(sid) / "draft").read_text() if (claude_dir(sid) / "draft").exists() else ""
    lines = draft.rstrip("\n").split("\n")
    rule = f"\033[2m{'─' * width}\033[0m"
    out.write("\033[H\033[2J\033[3J")
    out.write(f"\033]0;{session_task(s, '') or s['repo'] + ' · ' + s['name']}\007")
    out.write("".join(line + "\n" for line in conversation_lines(s, width)))
    out.write(f"\n{rule}\n\033[1m❯\033[0m {lines[0]}\n" + "".join(f"  {line}\n" for line in lines[1:]))
    out.write(f"{rule}\n\033[2m  ? for shortcuts\033[0m")
    # The cursor where Claude's would be, at the end of the prompt; keys come
    # in the way Claude asks for them (kitty's protocol, pastes bracketed).
    out.write(f"\033[2A\r\033[{2 + text_width(lines[-1])}C\033[>5u\033[?2004h")
    out.flush()
    sleep_badge(ASLEEP_BADGE)
    return 0


def text_width(text):
    """Columns a text takes in a terminal."""
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
               for c in text)


def next_key(buf):
    """The first key in what the terminal sent: (kind, bytes), and the rest.
    kind is None when the key isn't all there yet."""
    if not buf:
        return None, buf
    if buf.startswith(b"\x1b[200~"):
        end = buf.find(b"\x1b[201~")
        return (("paste", buf[6:end]), buf[end + 6:]) if end >= 0 else (None, buf)
    if buf.startswith(b"\x1b["):
        m = re.match(rb"\x1b\[[\x30-\x3f]*[\x20-\x2f]*[\x40-\x7e]", buf)
        return (("csi", m.group()), buf[m.end():]) if m else (None, buf)
    if buf.startswith(b"\x1b"):
        return (("esc", buf[:2]), buf[2:]) if len(buf) > 1 else (None, buf)
    size = 1 if buf[0] < 0xc0 else 2 if buf[0] < 0xe0 else 3 if buf[0] < 0xf0 else 4
    if len(buf) < size:
        return None, buf
    return ("char", buf[:size]), buf[size:]


TYPING_IDLE = 120       # seconds typing in a sleeping session can pause before it sleeps on


def waking(keep_typing=False):
    """A sleeping window, the moment it starts waking: the badge says so, the
    mouse stops reporting until Claude is back, and what came in meanwhile
    is taken off the terminal so Claude doesn't get it as keys. What was typed
    there (the text, if keep_typing) is returned to go in Claude's prompt;
    a scroll or a click is dropped (Claude's own screen takes the next one)."""
    os.write(1, MOUSE_OFF)
    sleep_badge(WAKING_BADGE, loud=True)
    time.sleep(0.03)            # what was already on its way
    buf, typed = b"", ""
    while select.select([0], [], [], 0)[0]:
        more = os.read(0, 4096)
        if not more:
            break
        buf += more
    while buf:
        token, buf = next_key(buf)
        if token is None:
            break
        kind, raw = token
        if kind == "paste":
            typed += raw.decode(errors="ignore").replace("\r\n", "\n").replace("\r", "\n")
        elif kind == "char" and raw.decode(errors="ignore").isprintable():
            typed += raw.decode(errors="ignore")
    return typed if keep_typing else ""


def cmd_woke(sid, key):
    """The window loop, once a key came in a sleeping session (or `amarchy
    wake`): a stand-in for Claude's prompt. What you type shows where Claude
    would show it, and Enter brings Claude back with it, sent. Anything else
    (arrows, Ctrl keys, a new line, the wheel, a line too long for the box)
    brings Claude back with what you typed in its prompt. Returns 0 to start
    Claude, 3 to go on sleeping (nothing typed, or a long pause)."""
    d = claude_dir(sid)
    if asleep_since(sid) is None:
        waking()                # woken from outside
        return 0
    buf = bytes.fromhex(key.replace(" ", "").strip()) if key.strip() else b""
    if not buf:
        return 3
    draft = (d / "draft").read_text() if (d / "draft").exists() else ""
    text = draft.rstrip("\n")

    def read(timeout):
        if not select.select([0], [], [], timeout)[0]:
            return None
        return os.read(0, 4096) or None

    # Where the cursor is (Claude leaves it at the end of its prompt): the
    # terminal's answer comes in among the keys.
    os.write(1, b"\033[6n")
    where, end = None, time.time() + 0.5
    while time.time() < end:
        m = re.search(rb"\x1b\[(\d+);(\d+)R", buf)
        if m:
            where, buf = int(m.group(2)), buf[:m.start()] + buf[m.end():]
            break
        more = read(0.05)
        if more:
            buf += more
    try:
        width = os.get_terminal_size(1).columns
    except OSError:
        width = 100
    # Typing goes on in place only where amarchy knows what's on the line:
    # the cursor right after the prompt's last line ("❯ " or "  " before it).
    in_place = where == 3 + text_width(text.split("\n")[-1])
    edited = False

    def wake(typed):
        typed += waking(keep_typing=True)
        if typed:
            write_file(d / "draft", typed)
        else:
            (d / "draft").unlink(missing_ok=True)
        clear_asleep(sid)
        tell_shell("refresh")
        return 0

    while True:
        token, buf = next_key(buf)
        if token is None:
            more = read(TYPING_IDLE if edited else 0.3)
            if more:
                buf += more
                continue
            if buf == b"\x1b":
                token, buf = ("esc", buf), b""
            else:
                # A pause: what's typed stays, as Claude's prompt, until it wakes.
                if edited:
                    write_file(d / "draft", text)
                return 3
        kind, raw = token
        if kind == "paste" or kind == "char" and (raw.decode(errors="ignore").isprintable() or raw == b"\r"):
            typed = raw.decode(errors="ignore").replace("\r\n", "\n").replace("\r", "\n" if kind == "paste" else "\r")
            if typed == "\r":
                if text.strip():
                    waking()
                    write_file(d / "send", text)
                    (d / "draft").unlink(missing_ok=True)
                    clear_asleep(sid)
                    tell_shell("refresh")
                    return 0
                continue
            if not in_place or "\n" in typed or 3 + text_width(text.split("\n")[-1] + typed) >= width:
                return wake(text + typed)
            if not edited:
                os.write(1, b"\033[K")      # a suggestion Claude showed in the empty prompt
                sleep_badge(TYPING_BADGE)
                edited = True
            os.write(1, typed.encode())
            text += typed
        elif kind == "char" and raw in (b"\x7f", b"\x08"):
            line = text.split("\n")[-1]
            if not in_place or not line and "\n" in text:
                return wake(text)
            if line:
                cols = text_width(line[-1])
                os.write(1, b"\b" * cols + b" " * cols + b"\b" * cols)
                text, edited = text[:-1], True
        elif kind == "csi" and raw[-1:] in b"Mm" and raw.startswith(b"\x1b[<"):
            if int(raw[3:].split(b";")[0] or 0) & 64:
                return wake(text)       # the wheel: Claude scrolls its conversation
        elif kind == "csi" and raw in (b"\x1b[I", b"\x1b[O") or raw.endswith(b"R"):
            continue                    # focus, a late cursor report
        elif kind == "csi" and raw == b"\x1b[13u":
            buf = b"\r" + buf           # Enter, the kitty way
        elif kind == "csi" and re.fullmatch(rb"\x1b\[13;\d+u", raw):
            return wake(text + "\n")    # Shift+Enter and the like: a new line
        else:
            return wake(text)


ANSI = re.compile(r"\x1b\[[0-9;]*m")


def wrap(line, width, hang=""):
    """Wrap a line at spaces to width visible characters (color codes take
    none), the lines after the first indented by hang. Long words are cut."""
    out, current, size = [], "", 0
    for word in re.split(r"(?<=\S)(?= )|(?<= )(?=\S)", line):
        visible = len(ANSI.sub("", word))
        if size + visible > width and current.strip():
            out.append(current.rstrip())
            current, size = hang, len(hang)
            if not word.strip():
                continue
        while size + visible > width and len(word) > 1:
            cut = max(width - size, 1)
            out.append(current + word[:cut])
            word = word[cut:]
            current, size, visible = hang, len(hang), len(ANSI.sub("", word))
        current += word
        size += visible
    return [*out, current.rstrip()]


def conversation_lines(s, width):
    """The conversation as the asleep window shows it: what you said, what
    Claude answered, a line for each tool it used. The latest part of it, as
    much as fits in the scrollback."""
    f = transcript(s)
    if not f:
        logs = sorted(projects_dir(s["path"]).glob("*.jsonl"), key=lambda x: x.stat().st_mtime)
        f = logs[-1] if logs else None
    if not f:
        return ["", "  \033[2mNo conversation yet.\033[0m"]
    records = conversation_records(f, tail=8_000_000)
    by_uuid = {r["uuid"]: r for r in records if r.get("uuid")}
    leaf = next((r for r in reversed(records) if r.get("type") in ("user", "assistant") and r.get("uuid")), None)
    chain, seen = [], set()
    while leaf and leaf["uuid"] not in seen:
        seen.add(leaf["uuid"])
        chain.append(leaf)
        leaf = by_uuid.get(leaf.get("parentUuid"))
    chain.reverse()
    out = []

    def markdown(line):
        """Claude's Markdown, lightly: headings and bold in bold, code in color."""
        if re.match(r"#{1,6} ", line):
            return f"\033[1m{line.lstrip('#').strip()}\033[22m"
        line = re.sub(r"\*\*(.+?)\*\*", "\033[1m\\1\033[22m", line)
        return re.sub(r"`([^`]+)`", "\033[36m\\1\033[39m", line)

    def para(text, first, rest, style="", md=False):
        fence = False
        for i, line in enumerate(text.rstrip().splitlines() or [""]):
            if line.lstrip().startswith("```"):
                fence = not fence
                continue
            # A list item's lines wrap under its text, not under its bullet.
            hang = " " * len(re.match(r"\s*(?:[-*+] |\d+[.)] )?", line).group())
            if md and not fence:
                line = markdown(line)
            elif fence:
                line = f"\033[36m{line}\033[39m"
            wrapped = wrap(line, max(width - len(rest) - 1, 20), hang)
            for j, w in enumerate(wrapped):
                prefix = first if i == 0 and j == 0 else rest
                out.append(f"{style}{prefix}{w}\033[0m" if style else f"{prefix}{w}\033[0m")

    for r in chain:
        if r.get("isMeta") or r.get("isSidechain"):
            continue
        content = r.get("message", {}).get("content")
        if r["type"] == "user":
            if r.get("isCompactSummary"):
                out += ["", "\033[2m  ··· earlier in the conversation (compacted) ···\033[0m"]
                continue
            blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
            for b in blocks:
                if not isinstance(b, dict) or b.get("type") != "text":
                    if isinstance(b, dict) and b.get("type") == "image":
                        out += ["", "\033[1m❯\033[0m [image]"]
                    continue
                text = b.get("text", "")
                command = re.search(r"<command-name>(.*?)</command-name>", text)
                if command:
                    args = re.search(r"<command-args>(.*?)</command-args>", text, re.S)
                    out += ["", f"\033[1m❯ {command.group(1)} {args.group(1).strip() if args else ''}\033[0m"]
                    continue
                if text.startswith(("<local-command", "<system-reminder")):
                    continue
                if text.startswith("<task-notification>"):
                    summary = re.search(r"<summary>(.*?)</summary>", text, re.S)
                    out += ["", f"\033[2m  ⏺ {(summary.group(1) if summary else 'a background task finished').strip()[:width - 6]}\033[0m"]
                    continue
                text = re.sub(r"<pasted_content[^>]*>.*?</pasted_content[^>]*>", "[pasted text]", text, flags=re.S)
                lines = text.strip().splitlines()
                if len(lines) > 30:
                    text = "\n".join(lines[:30] + [f"… {len(lines) - 30} more lines"])
                out.append("")
                para(text, "❯ ", "  ", "\033[1m")
        else:
            for b in content or []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text", "").strip():
                    out.append("")
                    para(b["text"], "● ", "  ", md=True)
                elif b.get("type") == "tool_use":
                    given = b.get("input") or {}
                    detail = next((str(given[k]) for k in ("description", "command", "file_path", "pattern",
                                                           "prompt", "url", "query", "skill") if given.get(k)), "")
                    detail = " ".join(detail.split())
                    line = f"  ⎿ {b.get('name', 'tool')}" + (f"({detail})" if detail else "")
                    out.append(f"\033[2m{line[:width - 1]}\033[0m")
    return out[-3000:]


# ------------------------------------------------------------------ menus
#
# The interactive flows use Omarchy's own menu (the one behind Super+Space), so
# they look and search like the rest of the desktop. Each one ends in a plain
# CLI call (create, add_project, new_project).

ICON_PROJECT = "󰉋"
ICON_ADD = "󰐕"
ICON_GITHUB = "󰊤"
ICON_LINK = "󰌷"
ICON_NEW = "󰝒"
ICON_LOCK = "󰌾"
ICON_THEME = "󰏘"
ICON_CHECK = "󰄬"
ADD_PROJECT = "New project"


def menu_select(prompt, rows):
    """Pick one of rows (icon, label[, subtext]). Returns the label, or None."""
    # Always icon<TAB>label: without an icon the menu would take the label for one.
    options = ["\t".join([row[0] or " ", *(str(x) for x in row[1:] if x)]) for row in rows]
    r = subprocess.run(["omarchy-menu-select", prompt, *options], capture_output=True, text=True)
    return r.stdout.split("\t")[0].strip() if r.returncode == 0 and r.stdout.strip() else None


def menu_input(prompt):
    r = subprocess.run(["omarchy-menu-input", prompt], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def menu_pick_theme():
    """Omarchy's own theme switcher (the previews), with System first and
    opened on what amarchy wears now. Returns the theme picked, or None."""
    current = theme_key(theme_name()) or SYSTEM
    if not shutil.which("omarchy-theme-switcher"):
        names = ["System", *sh("omarchy-theme-list").stdout.splitlines()]
        return menu_select("Amarchy theme", [(ICON_CHECK if theme_key(t) == current else ICON_THEME, t, "")
                                             for t in names])
    # The switcher only lists themes and opens on your desktop's. So let it
    # build its previews (--preload shows nothing) and call its menu ourselves,
    # with a System tile in front that looks like your desktop does.
    sh("omarchy-theme-switcher", "--preload")
    cache = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache")
    previews = cache / "omarchy/theme-selector/previews"
    desktop = (DESKTOP / "theme.name").read_text().strip() if (DESKTOP / "theme.name").exists() else ""
    look = next(iter(sorted(previews.glob(desktop + ".*"))), None) if desktop else None
    first = cache / "amarchy/theme-picker"
    tile = first / (SYSTEM + look.suffix) if look else None
    if not tile or not tile.is_symlink() or os.readlink(tile) != str(look.resolve()):
        shutil.rmtree(first, ignore_errors=True)
        first.mkdir(parents=True)
        if tile:
            tile.symlink_to(look.resolve())
    selected = tile if current == SYSTEM else next(iter(sorted(previews.glob(current + ".*"))), None)
    r = sh("omarchy-menu-images", "--print-name", "--show-labels", "--filterable", "--lazy-thumbnails",
           *(["--selected", str(selected)] if selected else []), str(first), str(previews))
    return r.stdout.strip() or None


def project_subtext(p):
    n = p["sessions"]
    where = github_slug(p["remote"]) or p["remote"] or "local only"
    return f"{n} session{'s' if n != 1 else ''} · {where}" if n else where


def menu_pick_project():
    rows = [(ICON_PROJECT, p["name"], project_subtext(p)) for p in projects()]
    rows.append((ICON_ADD, ADD_PROJECT))
    repo = menu_select("New session", rows)
    return menu_add_project() if repo == ADD_PROJECT else repo


def menu_add_project():
    """Add a project through the menu; returns its name, or None."""
    how = menu_select(ADD_PROJECT, [
        (ICON_GITHUB, "From GitHub"),
        (ICON_LINK, "Git URL"),
        (ICON_NEW, "New empty project"),
    ])
    if how == "From GitHub":
        rs = github_repos()
        if rs is None:
            notify("amarchy", "gh isn't installed or logged in. Run: gh auth login")
            return None
        rows = [(ICON_LOCK if r["private"] else ICON_GITHUB, r["name"], r["description"])
                for r in rs if not r["added"]]
        if not rows:
            notify("amarchy", "All your GitHub repos are already added")
            return None
        source = menu_select("From GitHub", rows)
    elif how == "Git URL":
        source = menu_input("Git URL or owner/repo")
    elif how == "New empty project":
        name = menu_input("Project name")
        if not name:
            return None
        where = menu_select(f"Create {slug(name)}", [
            (ICON_LOCK, "Local + private GitHub repo"),
            (ICON_PROJECT, "Local only"),
        ])
        if not where:
            return None
        name, err = new_project(name, github=where.startswith("Local +"))
        notify("amarchy", f"✗ {err}" if err else f"Created {name}")
        return name
    else:
        return None
    if not source:
        return None
    notify("amarchy", f"Cloning {source}…")
    name, err = add_project(source)
    notify("amarchy", f"✗ {err}" if err else f"Added {name}")
    return name


def dirty(path):
    return bool(sh("git", "status", "--porcelain", cwd=path).stdout.strip())


def close(sid, force=False):
    """Close a session: you're taken to the next one in the list and its row
    goes at once; then, out of sight, its Claude Code exits the way it would
    on its own, its windows close, the worktree is removed and the branch
    dropped if merged (reap).

    Returns an error string instead of closing when the worktree has
    uncommitted changes and force is False."""
    s = session(sid)
    if not s:
        return None
    path = Path(s["path"])
    if path.exists() and dirty(path) and not force:
        return "uncommitted changes"
    # Don't make you watch it go: go to the session after it in the list
    # (before it, when it was the last) first.
    if current_session_id() == sid:
        ids = [x["id"] for x in session_view()]
        i = ids.index(sid) if sid in ids else len(ids)
        rest = ids[i + 1:] + ids[:i][::-1]
        if rest:
            cmd_jump(rest[0])
    # Out of the list, and out of reach of everything that reads it (a jump,
    # its Claude's hooks, the window loop, which then lets the window close).
    # The file waits in CLOSING until reap is done with it.
    CLOSING.mkdir(parents=True, exist_ok=True)
    keep = {k: v for k, v in s.items() if k not in VIEW_FIELDS}
    if force:
        keep["force"] = True
    write_file(CLOSING / f"{sid}.json", json.dumps(keep))
    (SESSIONS / f"{sid}.json").unlink(missing_ok=True)
    (STATUS / sid).unlink(missing_ok=True)
    if LAST.exists() and LAST.read_text().strip() == sid:
        LAST.unlink(missing_ok=True)
    tell_shell("refresh")
    detach([ENTRY, "reap", sid])
    return None


def resume_closing():
    """Finish closing the sessions a reap was cut short on (a crash, a
    reboot): those in CLOSING that nothing is reaping."""
    for f in CLOSING.glob("*.json") if CLOSING.is_dir() else ():
        lock = reap_lock(f.stem)
        if lock:
            lock.close()
            detach([ENTRY, "reap", f.stem])


def installed_from(path):
    """Whether the installed amarchy (its CLI or its shell plugin, which
    install.sh links together) runs from the checkout at path."""
    inside = str(path).rstrip("/") + "/"
    for link in (INSTALLED, SHELL_PLUGIN.parent):
        try:
            if os.readlink(link).startswith(inside):
                return True
        except OSError:
            pass
    return False


def last_line(result, fallback):
    """The last line a command wrote to stderr (or stdout): why it failed."""
    return ((result.stderr or result.stdout).strip().splitlines() or [fallback])[-1]


def reap_lock(sid):
    """The lock of a session's reap, held while it lasts: the open file, or
    None when another reap has it."""
    CLOSING.mkdir(parents=True, exist_ok=True)
    lock = open(CLOSING / f"{sid}.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return None
    return lock


def stop_claude(win):
    """End the Claude Code in a session's window as quitting it would (its
    SessionEnd hooks run, the conversation is saved): SIGTERM, and SIGKILL
    only if it's still there after a while."""
    procs = processes()
    pid = window_claude(win, procs)
    if not pid:
        return
    try:
        os.kill(pid, 15)
    except ProcessLookupError:
        return
    end = time.time() + 8
    while time.time() < end and Path(f"/proc/{pid}").exists():
        time.sleep(0.1)
    try:
        os.kill(pid, 9)
    except ProcessLookupError:
        pass


def cmd_reap(sid):
    """The rest of close, detached from whatever asked for it (a key, the
    list, a terminal that's about to close): the session's Claude Code and
    its background sessions stop, its windows close, then the worktree goes."""
    f = CLOSING / f"{sid}.json"
    lock = reap_lock(sid) if f.exists() else None
    if not lock or not f.exists():     # another reap has it, or had it and is done
        return 0
    try:
        s = with_defaults(json.loads(f.read_text()))
    except (OSError, ValueError):
        return 0
    force = bool(s.pop("force", False))
    path = Path(s["path"])
    # Its background sessions (/bg) would go on working in a worktree that's gone.
    stop_background(s, only_idle=False)
    if HOST_MODE:
        host_stop(s)
    claude = find(claude_class(s))
    if claude:
        stop_claude(claude)
    for cls in (claude_class(s), term_class(s)):
        win = find(cls)
        if win:
            hypr(f'hl.dsp.window.close({{ window = "address:{win["address"]}" }})')
    # Let what ran in them (the dev server, a setup still cloning) let go of
    # the worktree before it's removed.
    end = time.time() + 5
    while time.time() < end and (find(claude_class(s)) or find(term_class(s))):
        time.sleep(0.1)
    repo_dir = WORK / s["repo"]

    def keep_open(why):
        # Back in the list rather than lost, with why.
        save_session(s)
        f.unlink(missing_ok=True)
        (CLOSING / f"{sid}.lock").unlink(missing_ok=True)
        tell_shell("refresh")
        notify("amarchy", f"Couldn't close {s['repo']} · {s['name']}: {why}. It's back in your list.")
        return 1

    # The installed amarchy runs from this worktree (it was being tried live):
    # put it back on the main checkout first, or the CLI, the keys and the
    # shell plugin would go with the worktree.
    if installed_from(path) and (repo_dir / "install.sh").exists():
        put = sh(str(repo_dir / "install.sh"), "--force", cwd=repo_dir)
        if put.returncode != 0:
            return keep_open("amarchy runs from it, and putting it back on "
                             f"{repo_dir} failed ({last_line(put, 'install.sh failed')})")
        sh("omarchy-restart-shell")
    removed = sh("git", "worktree", "remove", *(["--force"] if force else []), str(path), cwd=repo_dir)
    sh("git", "worktree", "prune", cwd=repo_dir)
    if path.exists() and removed.returncode != 0:
        # Changed after close looked (something still running wrote to it).
        return keep_open(last_line(removed, "git worktree remove failed"))
    had_branch = sh("git", "rev-parse", "--verify", "--quiet", f"refs/heads/{s['branch']}",
                    cwd=repo_dir).returncode == 0
    kept = had_branch and sh("git", "branch", "-d", s["branch"], cwd=repo_dir).returncode != 0
    shutil.rmtree(claude_dir(sid), ignore_errors=True)
    set_trust(path, False)
    f.unlink(missing_ok=True)
    (CLOSING / f"{sid}.lock").unlink(missing_ok=True)
    note = (f"branch {s['branch']} kept (not merged)" if kept else
            "branch deleted" if had_branch else "it was still being set up")
    notify("amarchy", f"Closed {s['repo']} · {s['name']} ({note})")
    return 0


ICON_CLOSE = "󰆴"
ICON_CANCEL = "󰜺"


def confirm_close(s):
    """Ask in the Omarchy menu before closing. Returns "close", "force" (throw
    away uncommitted changes too) or None."""
    path = Path(s["path"])
    if s.get("host"):
        changes = len(remote_sh(s["host"], ["git", "-C", s["path"], "status", "--porcelain"]).stdout.splitlines())
    else:
        changes = len(sh("git", "status", "--porcelain", cwd=path).stdout.splitlines()) if path.exists() else 0
    if changes:
        yes = "Close and discard changes"
        detail = f"{changes} uncommitted file{'s' if changes != 1 else ''} lost"
    else:
        yes, detail = "Close session", "Removes its worktree"
    if installed_from(path):
        detail += f" · amarchy runs from it, and goes back to {WORK / s['repo']}"
    picked = menu_select(f"Close {s['repo']} · {s['name']}?", [
        (ICON_CLOSE, yes, detail),
        (ICON_CANCEL, "Cancel", "Keep the session"),
    ])
    if picked != yes:
        return None
    return "force" if changes else "close"


def cmd_close(args):
    sid = args[0] if args and not args[0].startswith("-") else own_session_id()
    s = session(sid) if sid else None
    if not s:
        return 1
    force = "--force" in args
    if s.get("host"):
        return remote_close(s, force, confirm="--confirm" in args)
    if "--confirm" in args:
        answer = confirm_close(s)
        if not answer:
            return 1
        force = force or answer == "force"
    err = close(sid, force=force)
    if err:
        notify("amarchy", f"{sid}: {err}. Use amarchy close {sid} --confirm to discard them.")
        print(f"amarchy: {sid}: {err}", file=sys.stderr)
        return 1
    return 0


def cmd_rename(args):
    """Give a session a name of your own, shown above Claude and in every list
    instead of the one made from Claude's title. The branch and worktree keep theirs."""
    args = list(args)
    sid = None
    if "--id" in args:
        i = args.index("--id")
        if i + 1 >= len(args):
            return fail("Usage: amarchy rename --id <id> [title]")
        sid = args[i + 1]
        del args[i:i + 2]
    reset = "--reset" in args
    title = " ".join(a for a in args if a != "--reset").strip()
    sid = sid or own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one with --id <id>)")
    if not reset and not title:
        title = menu_input(f"Name for {s.get('title') or s['repo'] + ' · ' + s['name']}")
        if not title:
            return 1
    if s.get("host"):
        return remote_call(s, "rename", "--id", sid, *(["--reset"] if reset else [title]))
    if reset:
        s.pop("title", None)
    else:
        s["title"] = title
    save_session(s)
    tell_shell("refresh")
    return 0


def agent_context(s):
    """What Claude is told when its session starts (and again after a /clear or a
    compaction): that it runs in amarchy, which session it is, and where the rest
    is (the amarchy skill, installed with amarchy, has the details)."""
    return (f"This Claude Code session runs inside amarchy, the user's parallel Claude Code sessions on "
            f"their Omarchy desktop. You are session {s['name']}: a git worktree of {s['repo']} at "
            f"{s['path']}, on branch {s['branch']} (made from {s['base']}). The project's main checkout "
            f"is {WORK / s['repo']}; other sessions work in worktrees of their own. On screen you sit in "
            f"a column, with the user's sessions on your left and this session's terminal on your right, "
            f"where the project runs. The `amarchy` CLI drives all of it and acts on this session "
            f"(AMARCHY_SESSION={s['id']} in your environment). The other sessions are Claude Code too: "
            f"you can message them (ListAgents, SendMessage), and start one with a task of its own "
            f"(amarchy new <project> --no-jump --prompt). Use the amarchy skill before running it, or when the "
            f"work involves other sessions, worktrees, that terminal or merging back into main."
            + (host_context() if HOST_MODE else ""))


# The notifications of Claude Code that mean it's blocked on you. Others aren't
# a question: "idle_prompt" comes a minute after it finished, if you haven't
# answered, and would ring a session that's done a second time, as needing you.
NEEDS_YOU = ("permission_prompt", "elicitation_dialog", "elicitation_url_dialog", "agent_needs_input")


def hook_claude():
    """The Claude Code process a hook runs for (the nearest claude above it)
    and what Claude Code says about it in ~/.claude/sessions."""
    pid = os.getppid()
    for _ in range(6):
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            return {}
        if stat[stat.find("(") + 1:stat.rfind(")")] == "claude":
            try:
                return json.loads((HOME / f".claude/sessions/{pid}.json").read_text())
            except (OSError, ValueError):
                return {"pid": pid}
        pid = int(stat[stat.rfind(")") + 2:].split()[1])
    return {}


def cmd_hook(sid, state):
    # Claude Code passes the event as JSON on stdin.
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except Exception:
        event = {}
    s = session(sid)
    if not s:
        return
    kind = event.get("notification_type") if isinstance(event, dict) else None
    if state == "waiting" and kind and kind not in NEEDS_YOU:
        return
    if state == "start":
        # SessionStart: Claude is ready (idle), and learns where it is.
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                                 "additionalContext": agent_context(s)}}))
        state = "idle"
    # A background session forked from this one (/bg) carries its hooks, but
    # it isn't the Claude in the window: it says nothing about the session.
    if hook_claude().get("kind") == "bg":
        return
    set_conversation_id(sid, event.get("session_id", ""))
    if asleep_since(sid) is not None and state != "idle":
        clear_asleep(sid)   # it's running after all (woken some other way)
    prev = (STATUS / sid).read_text().strip() if (STATUS / sid).exists() else ""
    if state == prev == "idle":
        return      # Claude coming back from sleep: idle all along, since when it was
    (STATUS / sid).write_text(state)
    if state == prev:
        return
    claude = find(claude_class(s))
    focused = claude and claude.get("focusHistoryID") == 0
    if focused:
        return
    # The session's row in the list, as a notification: the icon of its state,
    # what it's about, and project · branch under it. A click takes you there.
    if state == "waiting" or (state == "idle" and prev == "working"):
        task = session_task(s, claude["title"] if claude else "")
        where = f"{s['repo']} · {s['name']}"
        notify(task or where, where if task else "", PICK_ICONS[state], click=("jump", sid))
        chime()


# ------------------------------------------------------------------ mission control

def task_title(window_title):
    """What a session is about, from the title Claude Code gives its window
    (a short slug like "fix-login-redirect", after a status glyph)."""
    title = re.sub(r"^[^\w]+", "", window_title or "").strip()
    if not title or title.startswith("amarchy:") or title == "Claude Code":
        return ""
    if " " not in title:
        title = title.replace("-", " ").replace("_", " ")
    return title[:1].upper() + title[1:]

# States, most urgent first, for the list grouped by status.
ORDER = {state: i for i, state in enumerate(("waiting", "working", "idle", "asleep"))}
# How much a session matters to you, most first (`amarchy priority`). New
# sessions are normal; the list always puts the higher ones first.
PRIORITIES = ("high", "normal", "low")
RANK = {p: i for i, p in enumerate(PRIORITIES)}
# How the list can be grouped: any of them, on its own or together, nested in
# whatever order you pick (`amarchy group priority project`).
GROUPS = ("project", "priority", "status")
# How it's sorted inside its groups (or all of it, ungrouped); priority is the default.
SORTS = ("priority", "newest", "oldest")


def list_groups():
    """How every list of sessions is grouped: by project, priority and/or
    status, outermost first, or none of them."""
    try:
        groups = []
        for g in GROUP_FILE.read_text().split():
            if g in GROUPS and g not in groups:
                groups.append(g)
        return groups
    except OSError:
        pass
    # `amarchy order activity`, from before there was more than one grouping.
    try:
        return ["status"] if ORDER_FILE.read_text().strip() == "activity" else []
    except OSError:
        return []


def priority(s):
    p = s.get("priority")
    return p if p in RANK else "normal"


def list_sort():
    """How the list is sorted inside its groups: by priority (higher first,
    then the order you opened them in), newest first or oldest first."""
    try:
        how = SORT_FILE.read_text().strip()
    except OSError:
        return "priority"
    return how if how in SORTS else "priority"


def session_order(s, groups=None, how=None):
    """Grouped first (outermost first, in the order the groupings nest), then
    sorted inside each group: by priority, higher first, or by when it was
    opened. Ties keep the order you opened them in, so each one keeps its place."""
    groups = list_groups() if groups is None else groups
    how = list_sort() if how is None else how
    rank = RANK[priority(s)]
    created = s.get("created", 0)
    by = {"project": s["repo"].lower(), "priority": rank,
          "status": ORDER.get(s["status"], len(ORDER))}
    return (*(by[g] for g in groups),
            rank if how == "priority" else 0,
            -created if how == "newest" else created, s["id"])


def set_groups(groups):
    STATE.mkdir(parents=True, exist_ok=True)
    GROUP_FILE.write_text(" ".join(groups) + "\n")
    ORDER_FILE.unlink(missing_ok=True)
    tell_shell("refresh")


def cmd_group(args):
    """Group the list by project, priority and/or status: `group project`
    switches one, `group project on|off` sets it, `group none` drops them all,
    `group priority project` sets them all, nested in that order. One turned
    on goes inside the ones already on; one already on keeps its place.
    Prints what the list is grouped by now, outermost first."""
    groups = list_groups()
    usage = "usage: amarchy group [project|priority|status [on|off] | <grouping> <grouping>... | none]"
    if args == ["none"]:
        groups = []
    elif len(args) > 1 and all(a in GROUPS for a in args):
        if len(set(args)) < len(args):
            return fail(usage)
        groups = list(args)
    elif args:
        what, *how = args
        if what not in GROUPS or len(how) > 1 or how and how[0] not in ("on", "off"):
            return fail(usage)
        on = how[0] == "on" if how else what not in groups
        if not on:
            groups = [g for g in groups if g != what]
        elif what not in groups:
            groups = groups + [what]
    if args:
        set_groups(groups)
    print(" ".join(groups) or "none")
    return 0


def cmd_sort(args):
    """`amarchy sort priority|newest|oldest`: how the list is sorted inside its
    groups. Prints how it's sorted now."""
    if len(args) > 1 or args and args[0] not in SORTS:
        return fail("usage: amarchy sort [priority|newest|oldest]")
    if args:
        STATE.mkdir(parents=True, exist_ok=True)
        SORT_FILE.write_text(args[0] + "\n")
        tell_shell("refresh")
    print(list_sort())
    return 0


def cmd_order(args):
    """`amarchy order opened|activity`, from before `amarchy group`: activity
    is grouped by status. Grouping by project is left as it is."""
    groups = list_groups()
    order = args[0] if args else ("opened" if "status" in groups else "activity")
    if order not in ("opened", "activity"):
        return fail(f"unknown order {order!r} (opened or activity)")
    return cmd_group(["status", "on" if order == "activity" else "off"])


def cmd_priority(args):
    """`amarchy priority high|normal|low|up|down [--id <id>]`: how much a
    session matters, for the order of the list. Without a level, prints it."""
    sid = None
    if "--id" in args:
        i = args.index("--id")
        if i + 1 >= len(args):
            return fail("usage: amarchy priority [high|normal|low|up|down] [--id <id>]")
        sid = args[i + 1]
        args = args[:i] + args[i + 2:]
    sid = sid or own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one with --id <id>)")
    now = priority(s)
    if not args:
        print(now)
        return 0
    level = args[0]
    if level in ("up", "down"):
        level = PRIORITIES[max(0, min(len(PRIORITIES) - 1, RANK[now] + (-1 if level == "up" else 1)))]
    if len(args) > 1 or level not in RANK:
        return fail("usage: amarchy priority [high|normal|low|up|down] [--id <id>]")
    if s.get("host"):
        return remote_call(s, "priority", level, "--id", sid)
    if level == "normal":
        s.pop("priority", None)
    else:
        s["priority"] = level
    save_session(s)
    tell_shell("refresh")
    print(level)
    return 0


def age(sid):
    """How long a session has been in its current state, e.g. "3m"."""
    try:
        return since_age((STATUS / sid).stat().st_mtime)
    except OSError:
        return ""


def since_age(since):
    secs = time.time() - since
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return "now"


TITLES = STATE / "titles.json"  # what saved_title() read last, so it only reads what's new


def saved_title(s):
    """The title Claude Code gave the session's conversation (for sessions
    whose Claude isn't running): the one it's in, else the latest in its
    folder. Conversations only grow, so only what's new since last time is read."""
    f = transcript(s)
    if not f:
        logs = sorted(projects_dir(s["path"]).glob("*.jsonl"), key=lambda x: x.stat().st_mtime, reverse=True)
        f = logs[0] if logs else None
    if not f:
        return ""
    try:
        cache = json.loads(TITLES.read_text())
    except (OSError, ValueError):
        cache = {}
    try:
        size = f.stat().st_size
    except OSError:
        return ""
    seen, title = cache.get(str(f), [0, ""])
    if seen == size:
        return task_title(title)
    try:
        with open(f, "rb") as fh:
            fh.seek(seen if seen < size else 0)
            for row in fh:
                if b'"ai-title"' in row or b'"custom-title"' in row:
                    try:
                        d = json.loads(row)
                    except ValueError:
                        continue
                    title = d.get("customTitle") or d.get("aiTitle") or title
            size = fh.tell()
    except OSError:
        return task_title(title)
    cache[str(f)] = [size, title]
    # Only the conversations of sessions still around.
    keep = {str(projects_dir(x["path"])) for x in sessions()}
    try:
        write_file(TITLES, json.dumps({k: v for k, v in cache.items() if str(Path(k).parent) in keep}))
    except OSError:
        pass
    return task_title(title)


def session_task(s, window_title):
    """What a session is about: your own name for it (amarchy rename), else
    Claude's, from its window or its latest conversation, cut down to
    "Keyword: a few words" (short_title) once that's ready."""
    if s.get("setup"):
        return s.get("title") or "Setting up the worktree"
    if s.get("title"):
        return s["title"]
    title = claude_title(s, window_title)
    return short_title(s["repo"], title) or title


def claude_title(s, window_title):
    """The title Claude Code gave the session, whole: from its window, else its latest conversation."""
    return task_title(window_title) or saved_title(s)


SHORT_NAMES = os.environ.get("AMARCHY_SHORT_NAMES", "on").lower() not in ("0", "off", "no", "false")
SHORT = STATE / "short.json"         # Claude's title (with its project) → the short name for it
SHORTENING = STATE / "shortening"    # one file per title being cut down right now
SHORT_RETRY = 600                    # how long a title that couldn't be cut down waits to try again
SHORT_PROMPT = """Name a coding session for a narrow sidebar list, so it can be told apart from the others at a glance.

Format: Keyword: a few words
- Keyword: one word, two at most: the thing being worked on, the word you'd look for in the list. Capitalized.
- After the colon: one to three lowercase words on what about it. Only what the title says; don't invent.
- 26 characters at most in all. In English, whatever the title's language.
- Leave out the project's name ({repo}) and filler like session, setup, analysis, implementation.
- Reply with the name only: no quotes, no period, nothing else.

Examples:
Fix login redirect loop after OAuth callback -> Login: redirect loop
Add dark mode toggle to settings page -> Dark mode: toggle
Investigate flaky CI tests in payments module -> CI: flaky payment tests
Configurar notificaciones push en Android -> Push: Android

Session title: {title}"""


def short_key(repo, title):
    return f"{repo}\t{title}"


def short_title(repo, title):
    """Claude's title for a session cut down to "Keyword: a few words", the
    keyword first so a list of them reads at a glance. Claude Code's titles
    are a sentence each; Haiku cuts each one down once, in the background
    (amarchy shorten), and until then (or without claude) there's none."""
    if not SHORT_NAMES or not title:
        return ""
    try:
        short = json.loads(SHORT.read_text()).get(short_key(repo, title))
    except (OSError, ValueError):
        short = None
    if short is not None:
        return short
    marker = SHORTENING / hashlib.sha1(short_key(repo, title).encode()).hexdigest()
    try:
        if time.time() - marker.stat().st_mtime < SHORT_RETRY:
            return ""     # on its way, or it failed a moment ago
    except OSError:
        pass
    if shutil.which("claude"):
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.touch()
        detach([ENTRY, "shorten", repo, title])
    return ""


def shorten(repo, title):
    """Ask Haiku for the short name of a title: one line, Keyword: words, short
    enough for the list. None if it couldn't give one."""
    for _ in range(2):
        try:
            r = subprocess.run(
                ["claude", "-p", "--model", "haiku", "--no-session-persistence", "--setting-sources", "",
                 "--tools", "", "--strict-mcp-config", SHORT_PROMPT.format(repo=repo, title=title)],
                capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL,
                env=clean_env(), cwd=STATE)
        except (OSError, subprocess.TimeoutExpired):
            return None
        lines = [l.strip() for l in r.stdout.strip().splitlines() if l.strip()]
        name = lines[0].strip("\"'`*. ") if len(lines) == 1 else ""
        m = re.fullmatch(r"([^:]{1,20}):\s*([^:]{1,26})", name)
        if r.returncode == 0 and m and len(name) <= 34:
            return f"{m.group(1).strip()}: {m.group(2).strip()}"
    return None


def cmd_shorten(repo, title):
    """amarchy shorten <repo> <title>: cut a Claude title down (short_title
    starts it), keep it, and redraw the list with it."""
    key = short_key(repo, title)
    marker = SHORTENING / hashlib.sha1(key.encode()).hexdigest()
    name = shorten(repo, title)
    if not name:
        return 1          # the marker stays, so it's tried again in a while
    with open(STATE / "short.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cache = json.loads(SHORT.read_text())
        except (OSError, ValueError):
            cache = {}
        cache[key] = name
        # Only the titles of sessions still around, and the one just made.
        windows = {c["class"]: c["title"] for c in clients()}
        keep = {short_key(s["repo"], t) for s in sessions()
                for t in (claude_title(s, windows.get(claude_class(s), "")),)}
        write_file(SHORT, json.dumps({k: v for k, v in cache.items() if k in keep or k == key}))
    marker.unlink(missing_ok=True)
    tell_shell("refresh")
    return 0


def claude_agents():
    """The name each running Claude Code goes by for ListAgents and SendMessage
    (what other Claude sessions message it as), by its folder. Claude Code keeps
    one ~/.claude/sessions/<pid>.json per running instance; an interactive one
    wins over a background job in the same folder, unless it has handed its
    conversation over to that job (parked: ListAgents then shows only the job)."""
    agents = {}
    for f in (HOME / ".claude/sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
            os.kill(int(d["pid"]), 0)
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if not d.get("name") or not d.get("cwd") or d.get("parkedJobId"):
            continue
        rank = (d.get("kind") == "interactive", d.get("startedAt") or 0)
        if d["cwd"] not in agents or rank > agents[d["cwd"]][0]:
            agents[d["cwd"]] = (rank, d["name"])
    return {cwd: name for cwd, (_, name) in agents.items()}


def session_view():
    """Sessions as every UI shows them (the bar widget, the Omarchy menu): in list order, with what each one is
    about, how long it has been in its state, and which one is on screen."""
    resume_closing()
    ensure_remote_sync()
    titles = host_titles() if HOST_MODE else {c["class"]: c["title"] for c in clients()}
    current = current_session_id()
    agents = claude_agents()
    ss = sessions()
    background = all_background_sessions()
    for s in ss:
        if s.get("host"):
            # As the host shows it; its agent names only reach the Claude sessions there.
            s["current"], s["agent"] = s["id"] == current, ""
            continue
        # Sleeping (its Claude stopped until you type in it) looks just as it
        # did, idle. So does a session whose window was closed: it opens again
        # asleep, and looks the same.
        s["awake"] = claude_class(s) in titles
        s["sleeping"] = asleep_since(s["id"]) is not None or not s["awake"]
        s["agent"] = agents.get(s["path"], "") if not s["sleeping"] else ""
        s.pop("prompt", None)
        if s["sleeping"] and not s.get("setup"):
            s["status"] = "idle"    # only an idle session sleeps (or one left from before)
        s["task"] = session_task(s, titles.get(claude_class(s), ""))
        # Claude's whole title, so a search finds a session by any word of it.
        s["claude_title"] = "" if s.get("setup") else claude_title(s, titles.get(claude_class(s), ""))
        s["age"] = age(s["id"]) if s["awake"] else ""
        # Claude Code background sessions (/bg) still running in its worktree.
        s["background"] = len(background_sessions(s, background))
        s["current"] = s["id"] == current
        s["priority"] = priority(s)
    groups, how = list_groups(), list_sort()
    ss.sort(key=lambda s: session_order(s, groups, how))
    return ss


MOD_NAMES = ((64, "Super"), (32, "Hyper"), (4, "Ctrl"), (8, "Alt"), (1, "Shift"))
NAV_BINDS = (("Next amarchy session", "next"), ("Previous amarchy session", "prev"),
             ("Search amarchy sessions", "search"), ("Toggle amarchy zen", "zen"),
             ("Toggle amarchy terminal", "terminal"), ("Run amarchy project", "run"),
             ("Run amarchy command", "commands"),
             ("New amarchy session here", "new"), ("New amarchy project", "add"),
             ("Pick amarchy theme", "theme"), ("Rename amarchy session", "rename"),
             ("Raise amarchy priority", "raise"), ("Lower amarchy priority", "lower"),
             ("Close amarchy session", "close"),
             ("amarchy menu", "menu"))


def hypr_binds():
    """What's bound in Hyprland, by description (hypr/amarchy.lua names ours)."""
    try:
        return {b.get("description"): b for b in json.loads(sh("hyprctl", "binds", "-j").stdout)}
    except ValueError:
        return {}


def mod_names(bind):
    return [n for bit, n in MOD_NAMES if bind["modmask"] & bit]


def nav_keys(binds=None):
    """The session keys as bound in Hyprland (hypr/amarchy.lua), for the
    tooltips of the session list: {"mod": "Ctrl+Alt", "next": "J", ...}."""
    binds = hypr_binds() if binds is None else binds
    keys = {}
    for description, action in NAV_BINDS:
        b = binds.get(description)
        if b:
            keys[action] = b["key"]
            keys.setdefault("mod", "+".join(mod_names(b)))
    return keys


# ------------------------------------------------------------------ keys

# The two modifiers `amarchy keys` sets: the option of hypr/amarchy.lua, what
# it's for, its default, and the binds under it (by description).
KEY_SCOPES = {
    "inside": ("nav_mod", "Inside amarchy", "CTRL + ALT", tuple(d for d, _ in NAV_BINDS)),
    "anywhere": ("mod", "From anywhere", "SUPER + ALT", ("Open amarchy", "New amarchy session")),
}
# What it offers, in Hyprland's spelling: never a lone modifier, which apps
# (and Omarchy, for Super) use for themselves. The menu lists them under
# Settings → Keys.
KEY_MODS = ("CTRL + ALT", "CTRL + SHIFT", "ALT + SHIFT", "CTRL + ALT + SHIFT",
            "SUPER + ALT", "SUPER + CTRL", "SUPER + SHIFT", "SUPER + CTRL + ALT", "MOD3")
MOD_BITS = {"SHIFT": 1, "CTRL": 4, "CONTROL": 4, "ALT": 8, "MOD1": 8, "MOD3": 32, "HYPER": 32,
            "SUPER": 64, "MOD4": 64, "WIN": 64}
# What Hyprland can't see: apps that use a modifier themselves, and lose
# those keys to amarchy's.
KEY_MOD_NOTES = {"CTRL + SHIFT": "apps use it: copy/paste in terminals, tabs in browsers",
                 "ALT + SHIFT": "some apps and keyboard layouts use it"}
ICON_KEYS = "󰌌"


def mod_mask(mod):
    return sum(MOD_BITS.get(m.strip().upper(), 0) for m in mod.split("+"))


def mod_label(mask):
    return "+".join(n for bit, n in MOD_NAMES if mask & bit)


def picked_keys():
    """What `amarchy keys` wrote: {"nav_mod": "CTRL + SHIFT", ...}."""
    try:
        return dict(re.findall(r'(\w+) = "([^"]*)"', KEYS_FILE.read_text()))
    except OSError:
        return {}


def bound_mask(scope, binds=None):
    """The modifier a scope's keys are bound with now, or None (unbound)."""
    binds = hypr_binds() if binds is None else binds
    b = next((binds[d] for d in KEY_SCOPES[scope][3] if d in binds), None)
    return b["modmask"] if b else None


def key_clashes(scope, mask, binds):
    """The binds a scope's keys would land on with that modifier: Omarchy's,
    yours, and amarchy's other scope as it's bound now."""
    ours = KEY_SCOPES[scope][3]
    keys = {binds[d]["key"].upper() for d in ours if d in binds}
    return [b for d, b in binds.items()
            if d not in ours and b["modmask"] == mask and b["key"].upper() in keys and not b.get("mouse")]


def note_bound_keys(binds):
    """Keep KEYS_BOUND ("inside Ctrl+Alt" per line) up to date: the menu's ✓
    reads it, since its checks have to be cheap."""
    text = "".join(f"{scope} {mod_label(m) if (m := bound_mask(scope, binds)) is not None else 'none'}\n"
                   for scope in KEY_SCOPES)
    try:
        if KEYS_BOUND.read_text() == text:
            return
    except OSError:
        pass
    STATE.mkdir(parents=True, exist_ok=True)
    KEYS_BOUND.write_text(text)


def write_keys(keys):
    STATE.mkdir(parents=True, exist_ok=True)
    if not keys:
        KEYS_FILE.unlink(missing_ok=True)
        return
    body = ", ".join(f'{k} = "{v}"' for k, v in sorted(keys.items()))
    KEYS_FILE.write_text(f"-- Picked in amarchy's menu (`amarchy keys`); hypr/amarchy.lua loads it.\nreturn {{ {body} }}\n")


def apply_keys(keys):
    """Write the modifiers, reload Hyprland so the keys move, and check they
    did. Returns an error message, or None."""
    write_keys(keys)
    if sh("hyprctl", "reload").returncode != 0:
        return "Hyprland didn't reload"
    binds = {}
    for _ in range(20):  # the reload rebinds a moment later
        binds = hypr_binds()
        if all(bound_mask(sc, binds) in (None, mod_mask(keys.get(KEY_SCOPES[sc][0], KEY_SCOPES[sc][2])))
               for sc in KEY_SCOPES if KEY_SCOPES[sc][0] in keys):
            break
        time.sleep(0.1)
    else:
        return "Hyprland didn't take the new keys (is hypr/amarchy.lua loaded from hyprland.lua?)"
    note_bound_keys(binds)
    tell_shell("refresh")
    return None


def set_key_mod(scope, mod):
    """Set one scope's modifier; returns an error message, or None."""
    option, label, default, _ = KEY_SCOPES[scope]
    parts = [m.strip().upper() for m in mod.split("+")]
    mask = mod_mask(mod)
    if not mask or any(m not in MOD_BITS for m in parts):
        return f"unknown modifier {mod!r} (e.g. \"CTRL + SHIFT\")"
    if mask in (1, 4, 8, 64):
        return f"{mod_label(mask)} alone is taken by your apps and Omarchy; pick two (e.g. \"CTRL + SHIFT\")"
    keys = picked_keys()
    keys[option] = " + ".join(parts)
    err = apply_keys(keys)
    if err:
        return err
    # What it lands on, said once it's done: the menu has one line per choice.
    clashes = key_clashes(scope, mask, hypr_binds())
    said = [f"{mod_label(mask)}+{b['key'].capitalize()} also does {b.get('description') or b.get('arg') or 'something of yours'}"
            for b in clashes[:3]] + (["…"] if len(clashes) > 3 else [])
    if scope == "inside" and keys[option] in KEY_MOD_NOTES:
        said.append(KEY_MOD_NOTES[keys[option]])
    notify("amarchy keys", f"{label} is now {mod_label(mask)}" + (". " + "; ".join(said) if said else ""), ICON_KEYS)
    return None


def cmd_keys(args):
    """`amarchy keys`: Settings → Keys in the amarchy menu. `keys inside|anywhere
    <mod>` sets one (what the menu runs), `--show` prints them, `reset` goes
    back to hypr/amarchy.lua."""
    if not args:
        if native_panel():
            tell_shell("menuAt", "Settings/Keys")
            return 0
        return subprocess.run(["omarchy-menu", "summon", "amarchy.settings.keys"], stdout=subprocess.DEVNULL).returncode
    if args == ["--show"]:
        binds = hypr_binds()
        for scope in KEY_SCOPES:
            mask = bound_mask(scope, binds)
            print(f"{scope}\t{mod_label(mask) if mask is not None else 'not bound'}")
        return 0
    if args == ["reset"]:
        err = apply_keys({})
        return fail(err) if err else 0
    if len(args) >= 2 and args[0] in KEY_SCOPES:
        err = set_key_mod(args[0], " ".join(args[1:]))
        if err:
            notify("amarchy keys", err, ICON_KEYS)  # from the menu, nobody reads stderr
            return fail(err)
        return 0
    return fail("usage: amarchy keys [inside|anywhere <mod> | --show | reset]")


# The amarchy menu, in one place: the card the shell plugin opens
# (`amarchy menu`, Ctrl+Alt+M) and Amarchy in the Omarchy menu (Super+Space,
# written by `amarchy menu --omarchy` when installing) are both made from it.
# A row runs an amarchy command or holds rows of its own; `where` keeps it to
# a session's workspace ("in") or off one ("out"); `binds` are the
# descriptions its key may be bound under (hypr/amarchy.lua), for the
# shortcut the card shows on the selected row.

def menu_item(icon, label, command=None, binds=(), where=None, children=None, check=None):
    return {"icon": icon, "label": label, "command": command, "binds": binds, "where": where,
            "children": children, "check": check}


def menu_keys(scope):
    return [menu_item(ICON_KEYS, mod_label(mod_mask(mod)), ["keys", scope, mod], check=(scope, mod_mask(mod)))
            for mod in KEY_MODS]


MENU = [
    menu_item("󰁔", "Go to amarchy", ["open"], ("Open amarchy",), where="out"),
    menu_item("󰐕", "New session", ["new"], ("New amarchy session here", "New amarchy session")),
    menu_item("󰉋", "New project", ["add"], ("New amarchy project",)),
    menu_item("󰐊", "Run", where="in", children=[
        menu_item("󰐊", "Run project", ["run"], ("Run amarchy project",)),
        menu_item("󰐊", "Run a command", ["run", "--pick"], ("Run amarchy command",)),
        menu_item("󰆍", "Terminal", ["terminal"], ("Toggle amarchy terminal",)),
    ]),
    menu_item("󰘔", "This session", where="in", children=[
        menu_item("󰏫", "Rename", ["rename"], ("Rename amarchy session",)),
        menu_item("󰁝", "Raise priority", ["priority", "up"], ("Raise amarchy priority",)),
        menu_item("󰁅", "Lower priority", ["priority", "down"], ("Lower amarchy priority",)),
        menu_item("󰒲", "Sleep", ["sleep"], ("Sleep amarchy session",)),
        menu_item("󰆴", "Close", ["close", "--confirm"], ("Close amarchy session",)),
    ]),
    menu_item("󰕰", "Sessions", children=[
        menu_item("󰁅", "Next session", ["next"], ("Next amarchy session",), where="in"),
        menu_item("󰁝", "Previous session", ["prev"], ("Previous amarchy session",), where="in"),
        menu_item("󰊓", "Zen mode", ["zen"], ("Toggle amarchy zen",), where="in"),
        menu_item("󰒲", "Sleep idle sessions", ["sleep", "--all"], ("Sleep idle amarchy sessions",)),
        menu_item("󰅖", "Close a session", ["pick", "close"]),
    ]),
    menu_item("󰒓", "Settings", children=[
        menu_item("󰏘", "Theme", ["theme"], ("Pick amarchy theme",)),
        menu_item("󰕾", "Sound", ["sound"]),
        menu_item(ICON_KEYS, "Keys", children=[
            menu_item(ICON_KEYS, KEY_SCOPES[scope][1], children=menu_keys(scope)) for scope in KEY_SCOPES
        ]),
    ]),
]


def menu_tree(items=MENU, inside=None, binds=None):
    """The menu for where you are, for the card: [{icon, label, key, command,
    checked, children}]. A group left empty goes."""
    binds = hypr_binds() if binds is None else binds
    inside = current_session_id() is not None if inside is None else inside
    rows = []
    for it in items:
        if it["where"] == ("out" if inside else "in"):
            continue
        row = {"icon": it["icon"], "label": it["label"]}
        if it["children"] is not None:
            row["children"] = menu_tree(it["children"], inside, binds)
            if not row["children"]:
                continue
        else:
            b = next((binds[d] for d in it["binds"] if d in binds), None)
            row["key"] = "+".join([*mod_names(b), b["key"].capitalize()]) if b else ""
            row["command"] = it["command"]
        if it["check"]:
            row["checked"] = bound_mask(it["check"][0], binds) == it["check"][1]
        rows.append(row)
    return rows


def menu_slug(label):
    return re.sub(r"[^a-z0-9]+", "-", label.lower()).strip("-")


# What a row's `when` asks in the Omarchy menu: is the screen on a session's
# workspace (amarchy's A:, or the old factory F:)? Cheap, since the menu asks
# every time it opens.
ON_SESSION = "hyprctl activeworkspace | grep -q '^workspace ID .* ([AF]:'"


def menu_omarchy(items=MENU, parent="amarchy"):
    """The menu as entries of the Omarchy menu's JSONC, under Amarchy."""
    lines = []
    if parent == "amarchy":
        lines = ["  // >>> amarchy (managed by amarchy/install.sh, from `amarchy menu --omarchy`)",
                 '  "amarchy": {"icon":"Ⓐ","label":"Amarchy","aliases":["agents","sessions"]},']
    for it in items:
        key = f"{parent}.{menu_slug(it['label'])}"
        row = {"icon": it["icon"], "label": it["label"]}
        if it["where"]:
            row["when"] = ON_SESSION if it["where"] == "in" else f"! {ON_SESSION}"
        if it["check"]:
            scope, mask = it["check"]
            row["checked"] = f"grep -qx '{scope} {mod_label(mask)}' ~/.local/state/amarchy/keys.bound"
        if it["command"]:
            row["action"] = "~/.local/bin/amarchy " + shlex.join(it["command"])
        lines.append(f"  {json.dumps(key)}: {json.dumps(row, ensure_ascii=False, separators=(',', ':'))},")
        if it["children"]:
            lines += menu_omarchy(it["children"], key)
    if parent == "amarchy":
        lines.append("  // <<< amarchy")
    return lines


def cmd_menu(args):
    """`amarchy menu`: everything amarchy does from where you are, in a card
    like the Omarchy menu's (from the shell plugin; without it, Amarchy in the
    Omarchy menu). --json is what the card shows, --omarchy the entries for
    the Omarchy menu."""
    if args == ["--json"]:
        print(json.dumps({"title": "Amarchy", "items": menu_tree()}, ensure_ascii=False))
        return 0
    if args == ["--omarchy"]:
        print("\n".join(menu_omarchy()))
        return 0
    if args:
        return fail("usage: amarchy menu [--json | --omarchy]")
    if native_panel():
        tell_shell("menu")
        return 0
    return subprocess.run(["omarchy-menu", "summon", "amarchy"], stdout=subprocess.DEVNULL).returncode


def cmd_ui():
    """Everything the shell plugin draws, in one call. It runs every second or
    so, which also keeps the menu's ✓ on the keys bound now."""
    binds = hypr_binds()
    note_bound_keys(binds)
    print(json.dumps({"zen": zen(), "zen_width": ZEN_WIDTH, "panel_gap": PAD, "terminal_alpha": terminal_alpha(),
                      "header_height": header_height(), "keys": nav_keys(binds),
                      "group": list_groups(), "sort": list_sort(), "sessions": session_view()}))


PICK_ICONS = {"waiting": "󰂞", "working": "󰔟", "idle": "󰄬", "asleep": "󰒲"}


def cmd_pick(args):
    """Choose a session in the Omarchy menu, then jump to it (or close it)."""
    ss = session_view()
    if not ss:
        notify("amarchy", "No sessions yet. Start one with amarchy new.")
        return 1
    closing = bool(args) and args[0] == "close"
    # Rows carry "project · session" as their subtext, which the menu hands
    # back with the label, so identical task titles still pick the right one.
    by_sub = {f"{s['repo']} · {s['name']}": s for s in ss}
    options = [f"{PICK_ICONS.get(s['status'], '󰄬')}\t{s['task'] or 'new session'}\t{sub}"
               for sub, s in by_sub.items()]
    r = subprocess.run(["omarchy-menu-select", "Close session" if closing else "Sessions", *options],
                       capture_output=True, text=True)
    s = by_sub.get(r.stdout.strip().split("\t")[-1]) if r.returncode == 0 else None
    if not s:
        return 1
    if closing:
        return cmd_close([s["id"], "--confirm"])
    else:
        cmd_jump(s["id"])
    return 0


# ------------------------------------------------------------------ remote
#
# Sessions can live on another machine: a server that's always on, so their
# Claude Code goes on working with your laptop closed, and any of your devices
# can pick them up. That machine runs amarchy too, without a desktop (host
# mode, install.sh --host), each session's Claude and terminal in tmux. A
# desktop shows them as it shows its own: the same list, keys and windows,
# each window a terminal attached to the session's tmux over ssh.
#
#   amarchy remote <ssh host>   new sessions start there (any host ssh reaches
#                               without a password: a Host in ~/.ssh/config, a
#                               Tailscale name...)
#   amarchy remote off          new sessions start here again; the host's leave this
#                               list and go on there (amarchy remote <host> brings them back)
#
# The desktop keeps a copy of the host's list (remote.json), which `amarchy
# events` on the host streams over one ssh connection (`amarchy remote
# --sync`, kept running by the shell plugin's poll), and notifies you when one
# of the host's sessions needs you or is done, as it does for its own. What
# you do to one (rename, priority, run, close) is done there.
#
# amarchy opens no port of its own: everything goes through ssh, so the host
# is as reachable as its ssh is. Keep that to a private network (Tailscale,
# say), not the internet.

REMOTE_FILE = STATE / "remote"          # the ssh host new sessions start on
REMOTE_STATE = STATE / "remote.json"    # what it last said: its sessions and projects
HOST_AMARCHY = ".local/bin/amarchy"     # amarchy on the host (install.sh links it there), from its home
# One connection to the host, shared by every window and command (ControlMaster),
# that notices within seconds when the network is gone (a laptop that slept).
SSH_OPTS = ("-o", "ControlMaster=auto", "-o", f"ControlPath={STATE}/ssh-%C", "-o", "ControlPersist=10m",
            "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=3", "-o", "ConnectTimeout=15")
REMOTE_TERM = "~term"                   # a session's terminal on the host: tmux session <id>~term
KEEPALIVE = 15                          # seconds between events' lines when nothing changes


def remote_host():
    """The ssh host new sessions start on, or None for this machine."""
    if HOST_MODE:
        return None
    host = os.environ.get("AMARCHY_REMOTE")
    if host is None:
        try:
            host = REMOTE_FILE.read_text().strip()
        except OSError:
            host = ""
    return host if host and host != "off" else None


def ssh_argv(host, command, tty=False):
    """ssh to the host running a command line. With tty, for a window: a
    terminal there, and ssh may ask you things (a host key). Without, it
    fails rather than wait for an answer nobody gives."""
    return ["ssh", *SSH_OPTS, *(["-t"] if tty else ["-T", "-o", "BatchMode=yes"]), "--", host, command]


def amarchy_line(*args, sid=None):
    """The command line of amarchy on the host, acting on session sid when given."""
    return shlex.join([*(["env", f"AMARCHY_SESSION={sid}"] if sid else []), HOST_AMARCHY, *args])


def remote_sh(host, command, input=None, timeout=30):
    """Run a command line on the host (a list is quoted into one)."""
    line = command if isinstance(command, str) else shlex.join(command)
    try:
        return subprocess.run(ssh_argv(host, line), capture_output=True, text=True, input=input,
                              stdin=None if input is not None else subprocess.DEVNULL,
                              timeout=timeout, env=clean_env())
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(line, 255, "", f"ssh {host}: {e}")


def remote_amarchy(host, *args, sid=None, input=None, timeout=30):
    return remote_sh(host, amarchy_line(*args, sid=sid), input=input, timeout=timeout)


def remote_snapshot():
    host = remote_host()
    if not host:
        return {}
    try:
        snap = json.loads(REMOTE_STATE.read_text())
    except (OSError, ValueError):
        return {}
    return snap if isinstance(snap, dict) and snap.get("host") == host else {}


def remote_clean(sessions):
    """The host's sessions as this desktop can use them: well-formed ones only.
    Ids end up in Hyprland commands (workspaces, window classes): only plain
    ones, and the workspace and classes this desktop gives every session."""
    out = []
    for s in sessions if isinstance(sessions, list) else []:
        if not (isinstance(s, dict) and re.fullmatch(r"[\w.-]{1,120}", str(s.get("id", "")))
                and all(isinstance(s.get(k), str) for k in ("repo", "name", "path"))):
            continue
        s = {**s, "prefix": PREFIX, "workspace": WS_PREFIX + s["id"], "branch": str(s.get("branch") or s["name"])}
        for k in ("status", "task", "claude_title", "age", "priority"):
            s[k] = str(s.get(k) or "")
        s["status"] = s["status"] if s["status"] in ORDER else "idle"
        s["created"] = s["created"] if isinstance(s.get("created"), (int, float)) else 0
        s["background"] = s["background"] if isinstance(s.get("background"), int) else 0
        out.append(s)
    return out


def remote_sessions():
    """The remote host's sessions, as it last said, each with "host"."""
    snap = remote_snapshot()
    return [{**s, "host": snap["host"]} for s in remote_clean(snap.get("sessions"))]


def remote_projects(host):
    snap = remote_snapshot()
    if "projects" not in snap:
        remote_refresh(host)
        snap = remote_snapshot()
    return snap.get("projects") or []


def remote_update(host, data, seen=None, quiet=False):
    """Take in what the host says (a line of `amarchy events`): keep it and
    redraw the list. With seen (the statuses the sync has already told you
    about, which it keeps), tell you about each session that went on to need
    you or be done, the way a session here does (unless you're looking at it).
    quiet: only take note (the first list, which just arrived), but still
    tell you about one that needs you."""
    if not isinstance(data, dict) or not isinstance(data.get("sessions"), list):
        return
    sessions = remote_clean(data["sessions"])
    before = remote_snapshot()
    projects = data["projects"] if isinstance(data.get("projects"), list) else before.get("projects", [])
    snap = {"host": host, "online": True, "at": time.time(), "hostname": str(data.get("hostname", "")),
            "sessions": sessions, "projects": [p for p in projects if isinstance(p, dict) and p.get("name")]}
    write_file(REMOTE_STATE, json.dumps(snap))
    tell_shell("refresh")
    if seen is None:
        return
    first, was = not seen, dict(seen)
    seen.clear()
    seen.update({s["id"]: s["status"] for s in sessions})
    seen.setdefault("", "")          # not empty even with no sessions: the first list is in
    if first:
        return
    for s in sessions:
        state, prev = s["status"], was.get(s["id"])
        if state == prev or not (state == "waiting" or (state == "idle" and prev == "working")):
            continue
        if quiet and state != "waiting":
            continue
        s = {**s, "host": host}
        claude = find(claude_class(s))
        if claude and claude.get("focusHistoryID") == 0:
            continue
        where = f"{s['repo']} · {s['name']}"
        notify(s.get("task") or where, where if s.get("task") else "", PICK_ICONS[state], click=("jump", s["id"]))
        chime()


def remote_offline(host, why=""):
    snap = remote_snapshot() or {"host": host, "sessions": []}
    if snap.get("online", True):
        snap.update(online=False, error=why)
        write_file(REMOTE_STATE, json.dumps(snap))
        tell_shell("refresh")


def remote_refresh(host):
    """Ask the host for its list right away (after a change made there),
    rather than wait for the stream. False if it didn't answer."""
    r = remote_amarchy(host, "events", "--once")
    try:
        data = json.loads(r.stdout.strip().splitlines()[-1]) if r.returncode == 0 else None
    except (ValueError, IndexError):
        data = None
    if data:
        remote_update(host, data)
    return bool(data)


def ensure_remote_sync():
    """Keep `amarchy remote --sync` running while new sessions go to a host."""
    if not remote_host():
        return
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "remote.lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return      # it's running
    detach([SELF, "remote", "--sync"])


def phone_look():
    """The look the phone app on the host wears: the theme your sessions wear
    here (the amarchy theme, else your Omarchy theme), Hyprland's rounding,
    the monospace font and the wallpaper. (look, font, wallpaper), each with
    a "sig" that changes with it; Nones when there's no theme to read."""
    amarchy_theme = bool(theme_name()) and (THEME / "colors.toml").is_file()
    src = THEME if amarchy_theme else DESKTOP / "theme"
    try:
        colors = (src / "colors.toml").read_text()
        shell = (src / "shell.toml").read_text() if (src / "shell.toml").is_file() else ""
    except OSError:
        return None, None, None
    try:
        name = theme_name() or (DESKTOP / "theme.name").read_text().strip()
    except OSError:
        name = ""
    try:
        rounding = int(json.loads(sh("hyprctl", "-j", "getoption", "decoration:rounding").stdout or "{}").get("int", 0))
    except (ValueError, TypeError, AttributeError):
        rounding = 0
    look = {"name": name.replace("-", " ").title(), "colors": colors, "shell": shell, "rounding": rounding}
    look["sig"] = hashlib.sha1(json.dumps(look, sort_keys=True).encode()).hexdigest()
    font = {"family": "", "files": {}}
    for weight, pattern in (("regular", "monospace"), ("bold", "monospace:bold")):
        family, _, path = sh("fc-match", "-f", "%{family[0]}\t%{file}", pattern).stdout.partition("\t")
        if path and Path(path).suffix.lower() in (".ttf", ".otf", ".woff", ".woff2") and Path(path).is_file():
            font["files"][weight] = path
            font["family"] = font["family"] or family
    if font["files"].get("bold") == font["files"].get("regular"):
        font["files"].pop("bold", None)
    stats = {w: (p, os.stat(p).st_mtime_ns, os.stat(p).st_size) for w, p in font["files"].items()}
    # No font to send: the host keeps none either, so the two agree.
    font["sig"] = hashlib.sha1(json.dumps([font["family"], stats], sort_keys=True).encode()).hexdigest() if stats else ""
    # The wallpaper the desktop shows with that theme (an image; a video has none to send).
    try:
        path = (THEME / "background").read_text().strip() if amarchy_theme \
            else os.path.realpath(DESKTOP / "background")
        st = os.stat(path) if Path(path).suffix.lower() in IMAGES else None
    except OSError:
        st = None
    wallpaper = {"path": path if st else "",
                 "sig": hashlib.sha1(json.dumps([path, st.st_mtime_ns, st.st_size]).encode()).hexdigest() if st else ""}
    return look, font, wallpaper


_wallpaper_failed = set()
PHONE_WALLPAPER = "1290x2796"   # an iPhone's screen in pixels, upright: the wallpaper is cut to it


def phone_wallpaper(path):
    """The wallpaper as the phone shows it: its middle, cut to a phone's
    screen, as a JPEG (a few hundred KB, not the 4K original). Without
    ImageMagick, the original if it isn't too big; else None."""
    if not shutil.which("magick"):
        try:
            raw = Path(path).read_bytes() if os.path.getsize(path) <= APP_WALLPAPER_MAX else b""
        except OSError:
            raw = b""
        return raw if image_kind(raw) else None
    with tempfile.TemporaryDirectory() as tmp:
        out = Path(tmp) / "wallpaper.jpg"
        r = sh("magick", f"{path}[0]", "-resize", PHONE_WALLPAPER + "^", "-gravity", "center",
               "-extent", PHONE_WALLPAPER, "-quality", "82", "-strip", str(out))
        try:
            return out.read_bytes() if r.returncode == 0 else None
        except OSError:
            return None


LOOK_EVERY = 15             # seconds between checks that the host's phone app wears this desktop's look
LOOK_RETRY = 600            # and after it didn't take it


def remote_look(host, has):
    """Send the host's phone app this desktop's look, when what it wears
    (has: its "phone" in `amarchy events`) isn't that. The font and the
    wallpaper go only when they changed. False if the host didn't take it."""
    look, font, wallpaper = phone_look()
    if not look:
        return True
    # A wallpaper goes to a host that takes one, once: one that can't be cut
    # to size isn't tried again until it changes.
    if "wallpaper" not in has or wallpaper["sig"] in _wallpaper_failed:
        wallpaper = {"path": "", "sig": has.get("wallpaper", "")}
    if has.get("look") == look["sig"] and has.get("font") == font["sig"] and has.get("wallpaper", "") == wallpaper["sig"]:
        return True
    data = {"look": look["sig"], **{k: look[k] for k in ("name", "colors", "shell", "rounding")}}
    if has.get("font") != font["sig"]:
        data["font"] = {"sig": font["sig"], "family": font["family"]}
        for weight, path in font["files"].items():
            try:
                data["font"][weight] = base64.b64encode(Path(path).read_bytes()).decode()
            except OSError:
                pass
    if has.get("wallpaper", "") != wallpaper["sig"]:
        image = phone_wallpaper(wallpaper["path"]) if wallpaper["path"] else None
        if wallpaper["path"] and not image:
            _wallpaper_failed.add(wallpaper["sig"])
        data["wallpaper"] = {"sig": wallpaper["sig"] if image else "",
                             "image": base64.b64encode(image).decode() if image else ""}
    r = remote_amarchy(host, "app", "theme", input=json.dumps(data), timeout=120)
    if r.returncode:
        print(f"amarchy: the phone app on {host} didn't take the theme: {(r.stderr or '').strip()}",
              file=sys.stderr)
    return r.returncode == 0


def remote_sync():
    """Follow the host's `amarchy events` for as long as it's the remote, over
    and over: a dropped connection (a laptop that slept, a host that
    rebooted) is tried again, sooner at first."""
    host = remote_host()
    if not host:
        return 0
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "remote.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0
    version, wait, seen = os.stat(SELF).st_mtime_ns, 1, {}
    phone = {"has": None, "at": 0.0, "busy": threading.Lock()}

    def look():
        """Now and then, and as soon as the host says what its phone app
        wears: send it this desktop's look if that changed (in the
        background, so the list doesn't wait on a font going over)."""
        if phone["has"] is None or time.time() - phone["at"] < LOOK_EVERY or not phone["busy"].acquire(blocking=False):
            return
        phone["at"] = time.time()

        def send(has):
            try:
                ok = remote_look(host, has)
            except Exception as e:
                print(f"amarchy: couldn't send {host} the look: {e}", file=sys.stderr)
                ok = False
            try:
                if not ok:      # not again for a while: it may be a few MB each time
                    phone["at"] = time.time() + LOOK_RETRY
            finally:
                phone["busy"].release()
        threading.Thread(target=send, args=(dict(phone["has"]),), daemon=True).start()

    def updated():
        """amarchy changed on disk, or is installed from somewhere else now."""
        try:
            return os.stat(SELF).st_mtime_ns != version or str(Path(ENTRY).resolve()) != SELF
        except OSError:
            return True

    while remote_host() == host and not updated():
        why = ""
        try:
            p = subprocess.Popen(ssh_argv(host, amarchy_line("events")), stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=clean_env())
        except OSError as e:
            p, why = None, str(e)
        if p:
            fresh = True        # the first line of a connection: what changed while away
            for line in p.stdout:
                if remote_host() != host or updated():
                    break
                if line.strip():
                    try:
                        data = json.loads(line)
                        remote_update(host, data, seen, quiet=fresh)
                        wait, fresh = 1, False
                    except ValueError:
                        data = {}
                    # What the phone app there wears; nothing when it's off.
                    if isinstance(data, dict) and data:
                        has = data.get("phone")
                        if not isinstance(has, dict):
                            phone["has"] = None
                        elif has != phone["has"]:
                            phone.update(has=has, at=0.0)
                else:       # nothing changed there: still, it was heard from
                    snap = remote_snapshot()
                    if snap.get("online"):
                        write_file(REMOTE_STATE, json.dumps({**snap, "at": time.time()}))
                look()
            p.terminate()
            try:
                why = (p.communicate(timeout=5)[1] or "").strip().splitlines()[-1:] or [""]
                why = why[0]
            except (subprocess.TimeoutExpired, ValueError):
                p.kill()
        if remote_host() != host or updated():
            break
        remote_offline(host, why)
        time.sleep(wait)
        wait = min(wait * 2, 30)
    lock.close()
    if updated() and remote_host():
        os.execv(sys.executable, [sys.executable, ENTRY, "remote", "--sync"])
    return 0


def remote_call(s, *args):
    """Do something to a remote session on its host (rename it, say), then
    show the list as it is there now. Returns the exit code."""
    r = remote_amarchy(s["host"], *args, sid=s["id"])
    if r.stdout:
        print(r.stdout, end="")
    if r.returncode != 0:
        why = gist(r.stderr) or f"{s['host']} didn't answer"
        print(r.stderr, end="", file=sys.stderr)
        notify("amarchy", f"{s['repo']} · {s['name']}: {why}")
    remote_refresh(s["host"])
    return r.returncode


def remote_create(host, repo, name, prompt, jump=True):
    """Start a session on the host and go to it (without jump, the screen
    stays where it is): its windows show the worktree being made there, then
    Claude. Returns its id."""
    args = ["new", repo, *([name] if name else []), *(["--prompt", "-"] if prompt is not None else [])]
    r = remote_amarchy(host, *args, input=prompt, timeout=60)
    lines = r.stdout.strip().splitlines()
    sid = lines[-1].strip() if lines else ""
    if r.returncode != 0 or not sid:
        print(r.stderr, end="", file=sys.stderr)
        notify("amarchy", f"Couldn't start a session on {host}: {gist(r.stderr) or 'no answer'}")
        return None
    remote_refresh(host)
    if not session(sid):
        notify("amarchy", f"Started {sid} on {host}, but it isn't in the list yet")
        return sid
    tell_shell("refresh")
    cmd_layout()
    if jump:
        cmd_jump(sid)
    return sid


def remote_add(host, args):
    """Add a project on the host (clone it, or start an empty one). Returns (name, error)."""
    r = remote_amarchy(host, "add", *args, timeout=900)
    lines = r.stdout.strip().splitlines()
    if r.returncode != 0 or not lines:
        return None, gist(r.stderr) or f"{host} didn't answer"
    remote_refresh(host)
    return Path(lines[-1].strip()).name, None


def remote_close(s, force, confirm):
    """Close a remote session there (its worktree is removed on the host),
    and its windows here."""
    if confirm:
        answer = confirm_close(s)
        if not answer:
            return 1
        force = force or answer == "force"
    elif not force:
        r = remote_sh(s["host"], ["git", "-C", s["path"], "status", "--porcelain"])
        if r.returncode == 0 and r.stdout.strip():
            sid = s["id"]
            notify("amarchy", f"{sid}: uncommitted changes. Use amarchy close {sid} --confirm to discard them.")
            return fail(f"{sid}: uncommitted changes")
    sid = s["id"]
    if current_session_id() == sid:
        ids = [x["id"] for x in session_view()]
        i = ids.index(sid) if sid in ids else len(ids)
        rest = ids[i + 1:] + ids[:i][::-1]
        if rest:
            cmd_jump(rest[0])
    if remote_call(s, "close", sid, *(["--force"] if force else [])) != 0:
        return 1
    for cls in (claude_class(s), term_class(s)):
        win = find(cls)
        if win:
            hypr(f'hl.dsp.window.close({{ window = "address:{win["address"]}" }})')
    if LAST.exists() and LAST.read_text().strip() == sid:
        LAST.unlink(missing_ok=True)
    return 0


def remote_run(s, args):
    """amarchy run for a remote session: the host runs it in the session's
    terminal there, which the terminal beside Claude shows. What has to be
    asked (a command not set yet, a pick) is asked here."""
    flag = args[0] if args else ""
    if flag == "--pick":
        r = remote_amarchy(s["host"], "run", "--list", sid=s["id"])
        commands = dict(l.split("\t", 1) for l in r.stdout.splitlines() if "\t" in l)
        rows = [(ICON_RUN, RUN_DEFAULT, commands.pop(RUN_DEFAULT, "") or "Not set yet")]
        rows += [(ICON_RUN, name, command) for name, command in commands.items()]
        rows.append((ICON_ADD, SAVE_COMMAND, "Name it, then type it"))
        choice = menu_select(f"Run in {s['repo']}", rows)
        if not choice:
            return 1
        if choice == SAVE_COMMAND:
            name = menu_input("Name for the command")
            command = name and menu_input(f"Command for {name}")
            return remote_call(s, "run", "--save", name, command) if command else 1
        args = [] if choice == RUN_DEFAULT else [choice]
        flag = args[0] if args else ""
    if flag in ("--set", "--save") and len(args) < (2 if flag == "--set" else 3):
        command = menu_input(f"Run command for {s['repo']}" if flag == "--set" else f"Command for {args[1:] and args[1]}")
        if not command or (flag == "--save" and len(args) < 2):
            return 1
        args = [*args, command]
    if flag.startswith("--"):
        return remote_call(s, "run", *args)
    if not args and remote_amarchy(s["host"], "run", "--show", sid=s["id"]).returncode != 0:
        command = menu_input(f"Run command for {s['repo']}")
        if not command or remote_call(s, "run", "--set", command) != 0:
            return 1
    on_screen = current_session_id() == s["id"]
    if on_screen and not leave_zen():
        return 1
    code = remote_call(s, "run", *args)
    if on_screen:
        ensure_windows(s)
        arrange(s["id"], focus="claude")
    return code


# A remote session's window: attached to its tmux on the host, and again
# whenever the connection drops, until the host says the session is gone (3).
ATTACH_LOOP = ('while :; do "$@"; [ $? -eq 3 ] && exit; '
               'printf "\\r\\n  \\033[2mReconnecting…\\033[0m\\r\\n"; sleep 2; done')


def attach_argv(s, which):
    return ["sh", "-c", ATTACH_LOOP, "amarchy-attach",
            *ssh_argv(s["host"], amarchy_line("attach", s["id"], which), tty=True)]


def cmd_remote(args):
    """amarchy remote [<ssh host>|off|--status]."""
    if args[:1] == ["--sync"]:
        return remote_sync()
    if HOST_MODE:
        return fail("this is a host: desktops start sessions here with `amarchy remote <this host>`")
    if not args:
        print(remote_host() or "off")
        return 0
    if args[0] == "--status":
        host = remote_host()
        if not host:
            print("off")
            return 0
        snap = remote_snapshot()
        heard = since_age(snap["at"]) if snap.get("at") else ""
        seen = "" if not heard else ", last heard just now" if heard == "now" else f", last heard {heard} ago"
        state = "online" if snap.get("online") else f"offline{': ' + snap['error'] if snap.get('error') else ''}"
        print(f"{host}: {state}{seen}, {len(snap.get('sessions') or [])} sessions")
        return 0 if snap.get("online") else 1
    if args[0] == "off":
        REMOTE_FILE.unlink(missing_ok=True)
        REMOTE_STATE.unlink(missing_ok=True)
        tell_shell("refresh")
        print("off: new sessions start on this machine (the host's go on there)")
        return 0
    host = args[0]
    if host.startswith("-") or not re.fullmatch(r"[\w.@:%+=-]+", host):
        return fail(f"{host!r} isn't an ssh host")
    r = remote_amarchy(host, "events", "--once")
    if r.returncode != 0:
        why = gist(r.stderr) or "no answer"
        return fail(f"couldn't reach amarchy on {host}: {why}\n"
                    f"  ssh {host} has to work without a password, and amarchy be installed there "
                    f"(git clone amarchy, ./install.sh --host).")
    try:
        data = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        data = {}
    if not data.get("host_mode"):
        return fail(f"amarchy on {host} isn't set up as a host: run ./install.sh --host there "
                    f"(an amarchy from before remote sessions? update it)")
    STATE.mkdir(parents=True, exist_ok=True)
    REMOTE_FILE.write_text(host + "\n")
    remote_update(host, data)
    ensure_remote_sync()
    print(f"{host}: new sessions start there ({len(remote_sessions())} running)")
    return 0


# ------------------------------------------------------------------ host mode
#
# On the host, a session's Claude runs in tmux session <id> and its terminal in
# <id>~term, on a tmux server of amarchy's own (tmux -L amarchy), so your own
# tmux is left alone. Its settings make tmux disappear: no status bar, no
# prefix key, your terminal's keys, colors, titles and clipboard passed
# through, and the mouse scrolls back through what Claude printed.

TMUX_CONF = """# Written by amarchy (host mode): the tmux that keeps its sessions.
set -g prefix None
unbind C-b
set -g status off
set -g escape-time 0
set -g history-limit 100000
set -g mouse on
set -g default-terminal tmux-256color
set -s terminal-features[90] '*:RGB:clipboard:extkeys:hyperlinks:usstyle:strikethrough:overline'
set -g extended-keys always
set -g extended-keys-format csi-u
set -g set-clipboard on
set -g allow-passthrough on
set -g focus-events on
set -g set-titles on
set -g set-titles-string '#{pane_title}'
set -g window-size latest
set -g aggressive-resize on
set -g destroy-unattached off
"""

# A session's Claude in tmux: Claude, and when you quit it, a key to start it again.
HOST_LOOP = 'while :; do "$0" claude "$1"; "$0" held "$1" || exit; done'


HOST_CONFIG = HOME / ".config/amarchy/host"     # NAME= and BIND= lines, for the network below


def host_setting(key):
    """AMARCHY_HOST_<key>, from the environment or ~/.config/amarchy/host."""
    value = os.environ.get(f"AMARCHY_HOST_{key}")
    if value is None:
        try:
            for line in HOST_CONFIG.read_text().splitlines():
                k, _, v = line.partition("=")
                if k.strip() == key:
                    value = v.strip()
        except OSError:
            pass
    return value or None


_network = None


def host_network():
    """How your devices reach what a session serves here: (name, address to
    listen on). Set in ~/.config/amarchy/host (NAME=, BIND=); else, on
    Tailscale, this machine's Tailscale name and address, so it's only
    reachable from your tailnet; else nothing but localhost (an ssh tunnel)."""
    global _network
    if _network:
        return _network
    name, bind = host_setting("NAME"), host_setting("BIND")
    if (not name or not bind) and shutil.which("tailscale"):
        try:
            me = json.loads(sh("tailscale", "status", "--json").stdout or "{}").get("Self") or {}
        except ValueError:
            me = {}
        ips = [ip for ip in me.get("TailscaleIPs") or [] if "." in ip]
        if ips and me.get("Online", True):
            name = name or (me.get("DNSName") or "").split(".")[0] or None
            bind = bind or ips[0]
    _network = (name or socket.gethostname(), bind)
    return _network


def host_name():
    return host_network()[0]


def host_context():
    """What a session's Claude on a host is told about where it is."""
    name, bind = host_network()
    text = (f" This session runs on a server, {name}, that the user reaches from their own devices: they "
            f"see your window and the terminal through amarchy, but their browser isn't on this machine. ")
    if bind:
        text += (f"For them to open something you serve (a dev server, a preview), listen on {bind} "
                 f"(reachable only from their private network), and give them http://{name}:<port>. ")
    else:
        text += (f"What you serve here is reachable only on this machine: listen on localhost, and to open "
                 f"it they forward the port (ssh -L <port>:localhost:<port> {name}) and use "
                 f"http://localhost:<port>. ")
    return text + "Other sessions share this machine, so a port may be taken: pick a free one."


def login_shell(script, *args):
    """A sh script run by the user's login shell (when it speaks sh), so it
    has the PATH and tools they set up (mise, nvm, cargo), as their own
    terminal would."""
    shell = os.environ.get("SHELL") or ""
    if Path(shell).name in ("bash", "zsh", "sh", "dash", "ksh"):
        return [shell, "-lc", script, *args]
    return ["sh", "-c", script, *args]


def tmux(*args):
    conf = STATE / "tmux.conf"
    try:
        fresh = conf.read_text() != TMUX_CONF
    except OSError:
        fresh = True
    if fresh:
        write_file(conf, TMUX_CONF)
    run = lambda *a: subprocess.run(["tmux", "-u", "-L", "amarchy", "-f", str(conf), *a], capture_output=True,
                                    text=True, stdin=subprocess.DEVNULL, env=clean_env())
    try:
        if fresh:
            run("source-file", str(conf))     # a server already up takes the new settings
        return run(*args)
    except FileNotFoundError:
        return subprocess.CompletedProcess(args, 127, "", "tmux isn't installed")


def tmux_name(sid, which="claude"):
    """A session's tmux session name: its id, without what tmux reads in a
    target ("." splits off the pane, ":" the window)."""
    return re.sub(r"[.:]", "_", sid) + (REMOTE_TERM if which == "term" else "")


def tmux_has(name):
    return tmux("has-session", "-t", f"={name}").returncode == 0


def tmux_env(s):
    return [x for k, v in session_env(s).items() for x in ("-e", f"{k}={v}")]


def host_start(s):
    """Start whatever of a session's tmux isn't running: Claude (setting the
    worktree up first, for a new one) and, once the worktree is there, the
    terminal. After a reboot, attaching brings them back like this."""
    sid, path = s["id"], Path(s["path"])
    claude, term = tmux_name(sid), tmux_name(sid, "term")
    if not tmux_has(claude):
        cwd = path if path.is_dir() else WORK / s["repo"]
        tmux("new-session", "-d", "-s", claude, "-x", "200", "-y", "50", "-c", str(cwd), *tmux_env(s),
             *login_shell(HOST_LOOP, ENTRY, sid))
        tmux("select-pane", "-t", f"={claude}:", "-T", f"amarchy:{sid}")
    if not s.get("setup") and path.is_dir() and not tmux_has(term):
        tmux("new-session", "-d", "-s", term, "-x", "100", "-y", "50", "-c", str(path), *tmux_env(s))


def host_stop(s):
    """End a session's tmux: Claude first, the way quitting it would."""
    sid = s["id"]
    pid = tmux("display-message", "-p", "-t", f"={tmux_name(sid)}:", "#{pane_pid}").stdout.strip()
    if pid.isdigit():
        stop_claude({"pid": int(pid)})
    for name in (tmux_name(sid), tmux_name(sid, "term")):
        tmux("kill-session", "-t", f"={name}")


def host_run(s, command):
    """Restart the session's terminal on command, as run_in_terminal does on a desktop."""
    host_start(s)
    shell = os.environ.get("SHELL") or "bash"
    script = (f"printf '\\033[2m$ %s\\033[0m\\n' {shlex.quote(command)}; "
              f"{command}; exec {shlex.quote(shell)}")
    r = tmux("respawn-pane", "-k", "-t", f"={tmux_name(s['id'], 'term')}:", "-c", s["path"], *tmux_env(s),
             shell, "-ic", script)
    return 0 if r.returncode == 0 else fail(f"couldn't run it: {r.stderr.strip()}")


def host_titles():
    """The title Claude gave each session (its tmux pane's), by window class,
    as a desktop has them from its windows."""
    panes = {}
    for line in tmux("list-panes", "-a", "-F", "#{session_name}\t#{pane_title}").stdout.splitlines():
        name, _, title = line.partition("\t")
        panes[name] = title
    return {claude_class(s): panes[tmux_name(s["id"])] for s in sessions() if tmux_name(s["id"]) in panes}


def cmd_attach(args):
    """Host mode: show a session's Claude (or with term, its terminal) in this
    terminal, starting it if needed. Exits 3 when there's no such session."""
    if not HOST_MODE:
        return fail("attach runs on a host (see amarchy remote)")
    sid, which = args[0], (args[1] if len(args) > 1 else "claude")
    s = session(sid)
    if not s or (CLOSING / f"{sid}.json").exists():
        try:
            why = f": {(STATE / 'failed' / sid).read_text().strip()}"
        except OSError:
            why = ""
        print(f"\r\n  {sid} {'could not start' if why else 'was closed'}{why}\r\n", flush=True)
        if why:
            time.sleep(5)
        return 3
    name = tmux_name(sid, which)
    end, said = time.time() + 600, False
    while True:
        host_start(s)
        if tmux_has(name):
            break
        if not s.get("setup") and not Path(s["path"]).is_dir():
            print(f"\r\n  {sid}'s worktree is gone ({s['path']}). Close the session.\r\n", flush=True)
            time.sleep(5)
            return 3
        if which == "term" and s.get("setup") and time.time() < end:
            if not said:
                print("\r\n  \033[2mWaiting for the worktree…\033[0m", flush=True)
                said = True
            time.sleep(0.5)
            s = session(sid)
            if not s:
                return 3
            continue
        return fail(f"couldn't start {name} in tmux")
    env = clean_env()
    # Your terminal's own TERM, if this machine knows it; else close enough.
    if not env.get("TERM") or sh("infocmp", env["TERM"]).returncode != 0:
        env["TERM"] = "xterm-256color"
    os.execvpe("tmux", ["tmux", "-u", "-L", "amarchy", "-f", str(STATE / "tmux.conf"),
                        "attach-session", "-t", f"={name}"], env)


def cmd_held(sid):
    """Host mode, after the session's Claude has exited: start it again on
    Enter. Fails (ending its tmux) when the session is gone."""
    if not session(sid) or (CLOSING / f"{sid}.json").exists():
        return 1
    print("\n  \033[2mClaude Code exited. Press Enter to start it again.\033[0m", flush=True)
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        time.sleep(1)
    return 0 if session(sid) and not (CLOSING / f"{sid}.json").exists() else 1


def cmd_events(args):
    """Host mode: the session list and projects as one line of JSON, and again
    whenever they change (or a blank line now and then, to show it's there),
    for the desktops showing these sessions. --once: just the one."""
    version, last, quiet, projects_at, ps = os.stat(SELF).st_mtime_ns, None, time.time(), 0, []
    while True:
        if time.time() - projects_at > 10:
            ps, projects_at = projects(), time.time()
        view = {"hostname": host_name(), "host_mode": HOST_MODE, "sessions": session_view(), "projects": ps}
        if (UNITS / APP_UNIT).exists():     # the phone app is on: which look it wears (see remote_look)
            view["phone"] = app_look_stamp()
        line = json.dumps(view)
        try:
            if line != last:
                print(line, flush=True)
                last, quiet = line, time.time()
            elif time.time() - quiet > KEEPALIVE:
                print(flush=True)
                quiet = time.time()
        except BrokenPipeError:
            return 0
        if "--once" in args:
            return 0
        time.sleep(1)
        try:
            if os.stat(SELF).st_mtime_ns != version:     # updated: the desktop reconnects to the new one
                return 0
        except OSError:
            pass


# ------------------------------------------------------------------ phone app
#
# `amarchy app` on a host: its sessions on your phone, a web app (app/) you add
# to the home screen. The list as amarchy shows it, each session's
# conversation from its transcript, what you type pasted into its Claude in
# tmux, its questions as buttons, and a notification when one needs you or is
# done (Web Push, the same moments as the desktop's chime).
#
# It's reachable from your tailnet only: the server listens on localhost, and
# `tailscale serve` puts it on https://<this machine>.<tailnet>.ts.net, where
# Tailscale says who's asking (the Tailscale-User-Login header). Only you (the
# machine's owner on Tailscale, or APP_USERS= in ~/.config/amarchy/host) get
# in, and only pages of its own can change anything (Origin), so a website
# open on your phone can't drive your sessions.
#
# Web Push needs a key pair (VAPID) and each notification encrypted for the
# phone (RFC 8291): openssl does the elliptic curve parts, Python the rest.

APP = STATE / "app"                         # its key (vapid.pem) and the phones it notifies (push.json)
APP_PAGES = Path(SELF).parent.parent / "app"
APP_UNIT = "amarchy-app.service"
APP_PORT = 7397                             # on localhost; APP_PORT= in ~/.config/amarchy/host
APP_HTTPS = 443                             # on the tailnet; APP_HTTPS= (443, 8443 or 10000)
# Who a push service should write to about this sender (Apple requires one).
APP_CONTACT = "https://github.com/ja-818/amarchy"
APP_TYPES = {".html": "text/html; charset=utf-8", ".css": "text/css; charset=utf-8",
             ".js": "text/javascript; charset=utf-8", ".webmanifest": "application/manifest+json",
             ".svg": "image/svg+xml", ".png": "image/png"}
APP_CSP = ("default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; "
           "connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; "
           "base-uri 'none'; form-action 'none'")
APP_CHUNK = 1_500_000           # bytes of a transcript read at a time (the latest first, earlier on request)
APP_KEYS = {"Enter", "Escape", "Up", "Down", "Left", "Right", "Tab", "BTab", "Space", "BSpace",
            *"0123456789"}
APP_SEEN = 15                   # seconds a session you're looking at on the phone counts as seen
P256_SPKI = bytes.fromhex("3059301306072a8648ce3d020106082a8648ce3d030107034200")
UNITS = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "systemd/user"


def b64u(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def unb64u(text):
    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))


def openssl(*args, input=None):
    r = subprocess.run(["openssl", *args], input=input, capture_output=True)
    if r.returncode != 0:
        raise OSError(f"openssl {args[0]}: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def ec_new(path):
    """A new P-256 private key, readable by you only."""
    old = os.umask(0o077)
    try:
        openssl("ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", str(path))
    finally:
        os.umask(old)


def ec_public(path):
    """The public key of a private key file, as the 65 bytes of its point."""
    return openssl("ec", "-in", str(path), "-pubout", "-outform", "DER")[-65:]


def es256(path, data):
    """data signed with the key (ECDSA, SHA-256) as JWT wants it: r and s, 32 bytes each."""
    der = openssl("dgst", "-sha256", "-sign", str(path), input=data)
    i, ints = 2, []
    while i < len(der):
        n = der[i + 1]
        ints.append(int.from_bytes(der[i + 2:i + 2 + n], "big"))
        i += 2 + n
    return b"".join(v.to_bytes(32, "big") for v in ints)


def ecdh(path, peer):
    """The secret the key shares with a public key (65 bytes of its point)."""
    with tempfile.NamedTemporaryFile(suffix=".der") as f:
        f.write(P256_SPKI + peer)
        f.flush()
        return openssl("pkeyutl", "-derive", "-inkey", str(path), "-peerkey", f.name, "-peerform", "DER")


def gf_mult(x, y):
    """Multiplication in GCM's field (NIST SP 800-38D)."""
    z = 0
    for i in range(127, -1, -1):
        if (x >> i) & 1:
            z ^= y
        y = (y >> 1) ^ (0xE1 << 120) if y & 1 else y >> 1
    return z


def aes128gcm(key, nonce, data):
    """AES-128-GCM, ciphertext and tag. openssl's command line has no GCM, so
    it only runs AES on the counter blocks; the mode is done here."""
    n = -(-len(data) // 16)
    blocks = bytes(16) + nonce + b"\0\0\0\1" + b"".join(nonce + (i + 2).to_bytes(4, "big") for i in range(n))
    out = openssl("enc", "-aes-128-ecb", "-K", key.hex(), "-nopad", input=blocks)
    h, mask, stream = int.from_bytes(out[:16], "big"), out[16:32], out[32:]
    ct = bytes(a ^ b for a, b in zip(data, stream))
    x = 0
    for i in range(0, len(ct), 16):
        x = gf_mult(x ^ int.from_bytes(ct[i:i + 16].ljust(16, b"\0"), "big"), h)
    x = gf_mult(x ^ (len(ct) * 8), h)
    return ct + bytes(a ^ b for a, b in zip(x.to_bytes(16, "big"), mask))


def hkdf(salt, ikm, info, n):
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    return hmac.new(prk, info + b"\1", hashlib.sha256).digest()[:n]


def push_encrypt(keys, payload):
    """A notification's payload as only that phone can read it (RFC 8291, aes128gcm)."""
    ua_public, auth = unb64u(keys["p256dh"]), unb64u(keys["auth"])
    with tempfile.TemporaryDirectory() as d:
        key = Path(d) / "key.pem"
        ec_new(key)
        as_public, secret = ec_public(key), ecdh(key, ua_public)
    ikm = hkdf(auth, secret, b"WebPush: info\0" + ua_public + as_public, 32)
    salt = os.urandom(16)
    cek = hkdf(salt, ikm, b"Content-Encoding: aes128gcm\0", 16)
    nonce = hkdf(salt, ikm, b"Content-Encoding: nonce\0", 12)
    return salt + (4096).to_bytes(4, "big") + bytes([65]) + as_public + aes128gcm(cek, nonce, payload + b"\2")


def app_key():
    """The app's own key, made the first time: phones subscribe to it, and
    push services check it signed what it sends."""
    key = APP / "vapid.pem"
    if not key.exists():
        APP.mkdir(parents=True, exist_ok=True)
        APP.chmod(0o700)
        ec_new(key)
    return key


_app_public = {}


def app_public():
    """The app's public key, as phones subscribe with it (base64url)."""
    key = app_key()
    stamp = key.stat().st_mtime_ns
    if _app_public.get("stamp") != stamp:
        _app_public.update(stamp=stamp, key=b64u(ec_public(key)))
    return _app_public["key"]


def app_subscriptions():
    try:
        subs = json.loads((APP / "push.json").read_text())
    except (OSError, ValueError):
        return []
    return [s for s in subs if isinstance(s, dict) and isinstance(s.get("endpoint"), str)]


_push_lock = threading.Lock()


def app_save_subscriptions(change):
    """Change the list of phones to notify (change(list) -> list), in one go."""
    with _push_lock:
        subs = change(app_subscriptions())
        APP.mkdir(parents=True, exist_ok=True)
        old = os.umask(0o077)
        try:
            write_file(APP / "push.json", json.dumps(subs))
        finally:
            os.umask(old)


def push_send(sub, payload):
    """Send one notification: True if the push service took it, False if
    that phone is gone for good (its subscription ended), None on any other
    failure (it may work next time)."""
    import urllib.error
    import urllib.request
    endpoint = sub["endpoint"]
    u = urllib.parse.urlsplit(endpoint)
    claims = {"aud": f"{u.scheme}://{u.netloc}", "exp": int(time.time()) + 12 * 3600, "sub": APP_CONTACT}
    head = b64u(b'{"typ":"JWT","alg":"ES256"}') + "." + b64u(json.dumps(claims).encode())
    key = app_key()
    jwt = head + "." + b64u(es256(key, head.encode()))
    body = push_encrypt(sub["keys"], json.dumps(payload).encode())
    req = urllib.request.Request(endpoint, data=body, method="POST", headers={
        "TTL": "86400", "Urgency": "high", "Content-Encoding": "aes128gcm",
        "Content-Type": "application/octet-stream",
        "Authorization": f"vapid t={jwt}, k={app_public()}"})
    try:
        with urllib.request.urlopen(req, timeout=20):
            return True
    except urllib.error.HTTPError as e:
        if e.code in (404, 410):
            return False
        print(f"amarchy app: push to {u.netloc} failed: {e.code} {e.read()[:200]!r}", file=sys.stderr)
    except (OSError, ValueError) as e:
        print(f"amarchy app: push to {u.netloc} failed: {e}", file=sys.stderr)
    return None


def push_all(payload):
    """Send a notification to every phone, dropping the ones that are gone.
    The number that took it."""
    sent, gone = 0, set()
    for sub in app_subscriptions():
        try:
            ok = push_send(sub, payload)
        except (OSError, KeyError, ValueError) as e:
            print(f"amarchy app: couldn't send a notification: {e}", file=sys.stderr)
            ok = None
        sent += ok is True
        if ok is False:
            gone.add(sub["endpoint"])
    if gone:
        app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] not in gone])
    return sent


# The app wears your desktop's look. A host has no Omarchy theme of its own:
# the desktop showing its sessions (amarchy remote) sends the theme they wear
# there (the amarchy theme, else your Omarchy theme) with its monospace font
# and Hyprland's rounding (see remote_look), and `amarchy app theme` keeps it
# here. Until one has, the app wears Omarchy's default, Tokyo Night.

APP_LOOK = APP / "look"                     # look.json and the font it names
APP_FONTS = {b"\x00\x01\x00\x00": ("ttf", "font/ttf"), b"true": ("ttf", "font/ttf"),
             b"OTTO": ("otf", "font/otf"), b"wOFF": ("woff", "font/woff"), b"wOF2": ("woff2", "font/woff2")}
APP_FONT_MAX = 12_000_000       # bytes of one font file
APP_WALLPAPER_MAX = 8_000_000   # bytes of the wallpaper, a phone-sized copy
APP_LOOK_TYPES = {"ttf": "font/ttf", "otf": "font/otf", "woff": "font/woff", "woff2": "font/woff2",
                  "jpg": "image/jpeg", "png": "image/png", "webp": "image/webp"}


def image_kind(raw):
    """jpg, png or webp, by what the file starts with; None for anything else."""
    if raw[:3] == b"\xff\xd8\xff":
        return "jpg"
    if raw[:8] == b"\x89PNG\r\n\x1a\n":
        return "png"
    if raw[:4] == b"RIFF" and raw[8:12] == b"WEBP":
        return "webp"
    return None
SIG = re.compile(r"[0-9a-f]{40}")


def parse_color(value):
    """A color the way Omarchy and Hyprland write one (#rrggbb[aa],
    rgb[a](rrggbb[aa]), rgb[a](r,g,b[,a]), 0xaarrggbb) as (r, g, b, alpha),
    or None."""
    v = str(value).strip()
    m = re.fullmatch(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?", v) or \
        re.fullmatch(r"(?i)rgba?\(([0-9a-f]{6})([0-9a-f]{2})?\)", v)
    if m:
        hx, alpha = m.group(1), m.group(2)
        return (int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16), int(alpha, 16) / 255 if alpha else 1.0)
    m = re.fullmatch(r"(?i)rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)", v)
    if m:
        return (*(min(int(x), 255) for x in m.groups()[:3]), min(float(m.group(4) or 1), 1.0))
    m = re.fullmatch(r"0x([0-9a-fA-F]{2})([0-9a-fA-F]{6})", v)
    if m:
        hx = m.group(2)
        return (int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16), int(m.group(1), 16) / 255)
    return None


def css_rgba(c, alpha=1.0):
    r, g, b, a = c
    a = round(a * alpha, 3)
    return f"#{r:02x}{g:02x}{b:02x}" if a >= 1 else f"rgb({r} {g} {b} / {a})"


def qt_darker(c, factor):
    """Qt's darker(): the same hue and saturation, its HSV value divided by
    factor (what the shell dims text with)."""
    import colorsys
    h, s, v = colorsys.rgb_to_hsv(*(x / 255 for x in c[:3]))
    return (*(round(x * 255) for x in colorsys.hsv_to_rgb(h, s, v / factor)), c[3])


def app_look_vars(colors, shell, rounding):
    """The app's CSS variables from a theme's colors.toml and shell.toml (as
    dicts): the same choices the Omarchy shell makes for its menus, popups
    and controls, so the app reads like them."""
    def section(name):
        v = shell.get(name)
        return v if isinstance(v, dict) else {}

    def number(name, key, default):
        v = section(name).get(key, default)
        return min(max(float(v), 0.0), 1.0) if isinstance(v, (int, float)) else default

    def colors_of(spec):
        """A shell value's colors and angle: a color, a Hyprland gradient
        ("c1 c2 45deg"), or a reference to one ("hyprland.active-border")."""
        if isinstance(spec, str) and re.fullmatch(r"[\w-]+\.[\w-]+", spec.strip()):
            ref, key = spec.strip().split(".")
            spec = section(ref).get(key)
        if not isinstance(spec, str):
            return [], None
        angle = next((float(p[:-3]) for p in spec.split() if re.fullmatch(r"-?\d+(\.\d+)?deg", p)), None)
        return [c for c in (parse_color(p) for p in spec.split() if not p.endswith("deg")) if c], angle

    def color(name, key, fallback):
        found = colors_of(section(name).get(key))[0]
        return found[0] if found else fallback

    def base(key, fallback):
        return parse_color(colors.get(key, "")) or parse_color(fallback)

    bg = color("menu", "background", base("background", "#1a1b26"))
    fg = color("menu", "text", base("foreground", "#a9b1d6"))
    accent = base("accent", "#7aa2f7")
    border, angle = colors_of(section("popups").get("border", "hyprland.active-border"))
    border = border or [accent]
    # Hyprland's 0deg runs left to right, CSS's bottom to top.
    gradient = (f"linear-gradient({round(90 - (angle or 0), 2)}deg, {', '.join(css_rgba(c) for c in border)})"
                if len(border) > 1 else css_rgba(border[0]))
    controls = section("controls")
    light = colors.get("mode") == "light" if colors.get("mode") in ("light", "dark") \
        else sum(bg[:3]) / 3 > 140
    out = {
        "bg": css_rgba(bg),
        "fg": css_rgba(fg),
        "dim": css_rgba(qt_darker(fg, 1.4)),
        "accent": css_rgba(accent),
        "line": css_rgba(fg, 0.12),
        "rule": css_rgba(fg, 0.2),
        "sel-bg": css_rgba(color("menu", "selected-background", fg), number("menu", "selected-background-alpha", 0.08)),
        "sel-text": css_rgba(color("menu", "selected-text", accent)),
        "sel-border": css_rgba(color("menu", "selected-border", fg), number("menu", "selected-border-alpha", 0.25)),
        "menu-border": css_rgba(color("menu", "border", fg), number("menu", "border-alpha", 1.0)),
        "popup-border": gradient,
        "popup-border-solid": css_rgba(border[0]),
        "scrim": css_rgba(color("menu", "scrim", bg), number("menu", "scrim-alpha", 0.5)),
        "control-fill": css_rgba(fg, number("controls", "normal-fill-alpha", 0.04)),
        "control-border": css_rgba(color("controls", "normal-border", fg), number("controls", "normal-border-alpha", 0.4)),
        "control-hover": css_rgba(fg, number("controls", "hover-cursor-fill-alpha", 0.08)),
        "control-selected": css_rgba(color("controls", "selected-color", fg),
                                     number("controls", "selected-fill-alpha", 0.18)),
        "control-pressed": css_rgba(fg, number("controls", "pressed-fill-alpha", 0.22)),
        "radius": f"{rounding}px",
    }
    for key, fallback in (("red", "#f7768e"), ("yellow", "#e0af68"), ("green", "#9ece6a"), ("blue", "#7aa2f7"),
                          ("magenta", "#ad8ee6"), ("cyan", "#449dab"), ("orange", "#eb927b"),
                          ("selection", "#292e42"), ("dark_background", "#13141c"),
                          ("lighter_background", "#24283b")):
        out[key.replace("_", "-")] = css_rgba(base(key, fallback))
    return out, "light" if light else "dark"


def app_look():
    """What the app wears, as the last desktop sent it, or None."""
    try:
        look = json.loads((APP_LOOK / "look.json").read_text())
    except (OSError, ValueError):
        return None
    return look if isinstance(look, dict) and isinstance(look.get("vars"), dict) else None


def app_look_stamp():
    """Which look the app wears (it changes with each one sent), for the
    host's events and the app's list."""
    look = app_look() or {}
    return {"look": look.get("look", ""), "font": look.get("font", ""), "wallpaper": look.get("wallpaper", "")}


def app_theme(data):
    """Keep the look a desktop sent (`amarchy app theme`, JSON on stdin; see
    remote_look). Everything in it is checked: what the app is sent are
    colors this parsed and font files that are what they say."""
    import tomllib
    if not isinstance(data, dict) or not SIG.fullmatch(str(data.get("look", ""))):
        return fail("app theme: expects the look as JSON, from the desktop")
    try:
        colors = tomllib.loads(str(data.get("colors", "")))
        shell = tomllib.loads(str(data.get("shell", "")))
    except tomllib.TOMLDecodeError as e:
        return fail(f"app theme: its colors don't read: {e}")
    rounding = data.get("rounding")
    rounding = min(max(int(rounding), 0), 40) if isinstance(rounding, (int, float)) else 0
    variables, mode = app_look_vars(colors, shell, rounding)
    name = re.sub(r"[^\w .'+-]", "", str(data.get("name", "")))[:60]
    APP_LOOK.mkdir(parents=True, exist_ok=True)
    old = app_look() or {}
    look = {"look": data["look"], "name": name, "mode": mode, "vars": variables,
            "font": old.get("font", ""), "family": old.get("family", ""), "nerd": old.get("nerd", False),
            "wallpaper": old.get("wallpaper", ""), "files": dict(old.get("files", {}))}
    font = data.get("font")
    if isinstance(font, dict) and SIG.fullmatch(str(font.get("sig", ""))) and font["sig"] != old.get("font"):
        files = {}
        for weight in ("regular", "bold"):
            try:
                raw = base64.b64decode(font.get(weight) or "", validate=True)
            except ValueError:
                raw = b""
            kind = APP_FONTS.get(raw[:4])
            if not kind or len(raw) > APP_FONT_MAX:
                continue
            name_on_disk = f"{font['sig'][:12]}-{weight}.{kind[0]}"
            write_file(APP_LOOK / name_on_disk, raw)
            files[weight] = name_on_disk
        family = re.sub(r"[^\w .-]", "", str(font.get("family", "")))[:64]
        look["files"] = {k: v for k, v in look["files"].items() if k not in ("regular", "bold")} | files
        look.update(font=font["sig"] if files else "", family=family if files else "",
                    nerd=bool(files) and "nerd" in family.lower())
    # The wallpaper: "" for none (a desktop without one), else its sig and the image.
    wall = data.get("wallpaper")
    if isinstance(wall, dict) and wall.get("sig", None) != old.get("wallpaper"):
        look["files"].pop("wallpaper", None)
        look["wallpaper"] = ""
        try:
            raw = base64.b64decode(wall.get("image") or "", validate=True)
        except ValueError:
            raw = b""
        kind = image_kind(raw)
        if SIG.fullmatch(str(wall.get("sig", ""))) and kind and len(raw) <= APP_WALLPAPER_MAX:
            name_on_disk = f"{wall['sig'][:12]}-wallpaper.{kind}"
            write_file(APP_LOOK / name_on_disk, raw)
            look["files"]["wallpaper"] = name_on_disk
            look["wallpaper"] = wall["sig"]
    write_file(APP_LOOK / "look.json", json.dumps(look, indent=1))
    keep = set(look["files"].values()) | {"look.json"}
    for f in APP_LOOK.iterdir():
        if f.name not in keep:
            f.unlink(missing_ok=True)
    return 0


def app_theme_css():
    """/theme.css: the look over app.css's own (Tokyo Night), and the font."""
    look = app_look()
    if not look:
        return "/* Omarchy's default look until a desktop sends yours (amarchy remote). */\n"
    out = [f"/* {look.get('name') or 'Your theme'}, as your desktop wears it. */", ":root {"]
    out += [f"  --{k}: {v};" for k, v in look["vars"].items() if re.fullmatch(r"[\w-]+", k)
            and re.fullmatch(r"[\w#().,/% -]+", str(v))]
    out.append(f"  color-scheme: {'light' if look.get('mode') == 'light' else 'dark'};")
    files = dict(look.get("files") or {})
    wallpaper = files.pop("wallpaper", None)
    if wallpaper:
        out.append(f'  --wallpaper: url("/look/{wallpaper}");')
    if files:
        out.append('  --font: "amarchy-mono", ui-monospace, Menlo, monospace;')
    out.append("}")
    for weight, f in files.items():
        kind = Path(f).suffix.lstrip(".")
        fmt = {"ttf": "truetype", "otf": "opentype"}.get(kind, kind)
        out.append(f'@font-face {{ font-family: "amarchy-mono"; src: url("/look/{f}") format("{fmt}"); '
                   f'font-weight: {700 if weight == "bold" else 400}; font-display: swap; }}')
    if "regular" in files and "bold" not in files:      # one file: the browser makes the bold
        out[-1] = out[-1].replace("font-weight: 400", "font-weight: 100 900")
    return "\n".join(out) + "\n"


def tailscale_status():
    try:
        return json.loads(sh("tailscale", "status", "--json").stdout or "{}")
    except ValueError:
        return {}


def app_address(status=None):
    """This machine's name on the tailnet (amarchy.tail1234.ts.net), the one
    its HTTPS certificate is for, or None."""
    status = status if status is not None else tailscale_status()
    name = ((status.get("Self") or {}).get("DNSName") or "").rstrip(".")
    return name or None


def app_users(status=None):
    """The Tailscale logins let in: APP_USERS= (comma separated), else the
    owner of this machine."""
    users = host_setting("APP_USERS")
    if users:
        return {u.strip() for u in users.split(",") if u.strip()}
    status = status if status is not None else tailscale_status()
    me = status.get("Self") or {}
    login = ((status.get("User") or {}).get(str(me.get("UserID"))) or {}).get("LoginName", "")
    return {login} if login and "@" in login else set()


def app_port():
    try:
        return int(host_setting("APP_PORT") or APP_PORT)
    except ValueError:
        return APP_PORT


def app_https():
    try:
        return int(host_setting("APP_HTTPS") or APP_HTTPS)
    except ValueError:
        return APP_HTTPS


def app_url(address):
    https = app_https()
    return f"https://{address}" + ("" if https == 443 else f":{https}") + "/"


# ---- what the app shows of a session

def app_where(s):
    return f"{s['repo']} · {s.get('branch') or s['name']}"


def short_path(path, s):
    """A file path as the worktree sees it."""
    root = s["path"].rstrip("/") + "/"
    return path[len(root):] if isinstance(path, str) and path.startswith(root) else path


def tool_summary(name, args, s):
    """A tool call in a line: the command it runs, the file it reads, what it searches."""
    if not isinstance(args, dict):
        return ""
    if name == "TodoWrite" and isinstance(args.get("todos"), list):
        return f"{len(args['todos'])} to-dos"
    if name == "AskUserQuestion" and isinstance(args.get("questions"), list) and args["questions"]:
        q = args["questions"][0]
        return q.get("question", "") if isinstance(q, dict) else ""
    for key in ("command", "file_path", "notebook_path", "pattern", "url", "query", "description", "prompt",
                "skill", "message", "path"):
        value = args.get(key)
        if isinstance(value, str) and value.strip():
            return short_path(value, s) if key in ("file_path", "notebook_path", "path") else value
    for value in args.values():
        if isinstance(value, str) and value.strip():
            return value
    return ""


def result_text(content):
    if isinstance(content, str):
        return content
    out = []
    for b in content if isinstance(content, list) else []:
        if isinstance(b, dict):
            out.append(b.get("text", "") if b.get("type") == "text" else f"[{b.get('type', '')}]")
    return "\n".join(out)


def tag_text(text, tag):
    m = re.search(rf"<{tag}>(.*?)</{tag}>", text, re.S)
    return m.group(1).strip() if m else None


def user_item(text):
    """What you said, as the conversation shows it: Claude Code wraps slash
    commands, ! commands and their output in tags, and adds reminders for Claude."""
    text = re.sub(r"<system-reminder>.*?</system-reminder>", "", text, flags=re.S).strip()
    if not text or text.startswith("<local-command-caveat>"):
        return None
    name = tag_text(text, "command-name")
    if name is not None:
        args = tag_text(text, "command-args") or ""
        return {"kind": "command", "text": f"{name} {args}".strip()}
    for tag, kind in (("bash-input", "command"), ("local-command-stdout", "note"), ("bash-stdout", "note"),
                      ("bash-stderr", "note")):
        inner = tag_text(text, tag)
        if inner is not None:
            if kind == "command":
                return {"kind": "command", "text": f"! {inner}"}
            return {"kind": "note", "text": inner} if inner else None
    if text.startswith("[Request interrupted"):
        return {"kind": "note", "text": "Interrupted"}
    return {"kind": "user", "text": text}


def app_items(records, s):
    """A conversation's records as the app shows them: what you said, what
    Claude said, its tool calls (each result follows as "result", for the
    call it answers) and notes. Thinking and Claude Code's bookkeeping are left out."""
    out = []
    for r in records:
        if not isinstance(r, dict) or r.get("isSidechain") or r.get("isMeta"):
            continue
        kind, rid, at = r.get("type"), r.get("uuid") or "", r.get("timestamp") or ""
        message = r.get("message") if isinstance(r.get("message"), dict) else {}
        content = message.get("content")
        blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
        found = []
        if kind == "user":
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text":
                    found.append(user_item(b.get("text") or ""))
                elif b.get("type") == "image":
                    found.append({"kind": "user", "text": "[image]"})
                elif b.get("type") == "tool_result":
                    text = result_text(b.get("content"))
                    found.append({"kind": "result", "tool": b.get("tool_use_id", ""), "error": bool(b.get("is_error")),
                                  "text": text[:4000] + ("\n…" if len(text) > 4000 else "")})
        elif kind == "assistant":
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and (b.get("text") or "").strip():
                    found.append({"kind": "claude", "text": b["text"].strip()})
                elif b.get("type") == "tool_use":
                    found.append({"kind": "tool", "id": b.get("id", ""), "name": b.get("name", ""),
                                  "summary": tool_summary(b.get("name"), b.get("input"), s)[:600]})
        elif kind == "system":
            sub = r.get("subtype")
            if sub == "away_summary" and r.get("content"):
                found.append({"kind": "note", "text": re.sub(r"\s*\(disable recaps.*?\)$", "", str(r["content"]))})
            elif sub == "compact_boundary":
                found.append({"kind": "note", "text": "Conversation compacted"})
            elif sub == "local_command" and isinstance(r.get("content"), str):
                found.append(user_item(r["content"]))
        for i, item in enumerate(x for x in found if x):
            out.append({**item, "key": f"{rid}:{i}", "at": at})
    return out


def line_start(fh, pos):
    """The start of the line pos is in (0, or just after a newline)."""
    if pos <= 0:
        return 0
    fh.seek(pos - 1)
    fh.readline()
    return fh.tell()


def read_records(f, start, end):
    """The records of a transcript between two offsets (at line starts)."""
    with open(f, "rb") as fh:
        fh.seek(start)
        data = fh.read(max(end - start, 0))
    out = []
    for line in data.splitlines():
        if b'"type":"api-request' in line[:40] or not line.strip():
            continue        # copies of what went to the API: big, and nothing to show
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


class AppConversation:
    """Follows the conversation a session is in (it changes with /clear): the
    latest of it first, then what's added."""

    def __init__(self, s):
        self.s, self.file, self.start, self.offset = s, None, 0, 0

    def poll(self):
        """(items, reset): what's new, or with reset, all there is to show from scratch."""
        f = transcript(self.s)
        if f != self.file:
            self.file = f
            if not f:
                self.start = self.offset = 0
                return [], True
            with open(f, "rb") as fh:
                end = fh.seek(0, 2)
                self.start = line_start(fh, end - APP_CHUNK)
            self.offset = self.start
            return self.read(), True
        return (self.read(), False) if f else ([], False)

    def read(self):
        try:
            with open(self.file, "rb") as fh:
                fh.seek(self.offset)
                data = fh.read()
        except OSError:
            return []
        done = data.rfind(b"\n") + 1        # a line still being written waits for the next time
        records = read_records(self.file, self.offset, self.offset + done) if done else []
        self.offset += done
        return app_items(records, self.s)


def app_earlier(s, before):
    """The part of the conversation before an offset: (items, its start)."""
    f = transcript(s)
    if not f or before <= 0:
        return [], 0
    with open(f, "rb") as fh:
        start = line_start(fh, before - APP_CHUNK)
    return app_items(read_records(f, start, before), s), start


OPTION = re.compile(r"^(\s{0,8})(❯\s*)?(\d{1,2})\.\s+(\S.*)$")
RULE = re.compile(r"^\s*[─━]{8,}\s*$")
DASHES = re.compile(r"^\s*[╌┄-]{8,}\s*$")
# The line under each of Claude Code's dialogs, saying how to answer it.
DIALOG_HINT = re.compile(r"Esc to (cancel|exit|go back)|Enter to (select|confirm|continue|submit)|to navigate")


def claude_dialog(lines):
    """A question Claude Code shows (a permission prompt, AskUserQuestion, a
    menu), read off its screen: {id, question, options: [{label, detail,
    keys}], hint}, or None. Each option's keys pick it: its number, or the
    arrows to it and Enter in a menu without numbers."""
    width = max((len(l) for l in lines), default=0)
    hint = next((i for i in range(len(lines) - 1, max(len(lines) - 7, -1), -1)
                 if DIALOG_HINT.search(lines[i])), None)
    if hint is None:
        return None
    found, expect = [], None
    for j in range(hint - 1, max(hint - 60, -1), -1):
        m = OPTION.match(lines[j])
        if not m:
            continue
        n = int(m.group(3))
        if expect is not None and n != expect:
            break
        found.insert(0, (j, m))
        expect = n - 1
        if n == 1:
            break
    options = []
    if found and expect == 0:
        top = found[0][0]
        for k, (j, m) in enumerate(found):
            label, detail = m.group(4).strip(), []
            stop = found[k + 1][0] if k + 1 < len(found) else hint
            # A label too long for the line goes on below it, cut at a space
            # or, where the line is full to the edge, inside a word.
            prev = lines[j]
            for line in lines[j + 1:stop]:
                if not line.strip() or RULE.match(line) or DASHES.match(line):
                    prev = ""
                    continue
                if len(prev) >= width - 3:
                    label += ("" if len(prev) == width else " ") + line.strip()
                    prev = line
                else:
                    detail.append(line.strip())
                    prev = ""
            n = int(m.group(3))
            options.append({"label": label, "detail": " ".join(detail), "selected": bool(m.group(2)),
                            "keys": [str(n)] if n <= 9 else ["Down"] * (n - 1) + ["Enter"]})
    else:
        # A menu without numbers: the line with ❯ and the ones beside it, lined up with it.
        mark = next((j for j in range(hint - 1, max(hint - 30, -1), -1)
                     if re.match(r"^\s+❯\s+\S", lines[j])), None)
        if mark is None:
            return None
        col = re.match(r"^(\s+❯\s+)", lines[mark]).end()
        def sibling(line):
            return len(line) > col and line[:col].strip() in ("", "❯") and line[col] != " "
        top = mark
        while top > 0 and sibling(lines[top - 1]):
            top -= 1
        bottom = mark
        while bottom + 1 < hint and sibling(lines[bottom + 1]):
            bottom += 1
        for j in range(top, bottom + 1):
            d = j - mark
            options.append({"label": lines[j][col:].strip(), "detail": "", "selected": j == mark,
                            "keys": ["Up"] * -d + ["Down"] * d + ["Enter"]})
    rule = next((j for j in range(top - 1, -1, -1) if RULE.match(lines[j])), -1)
    # (A question's tab in AskUserQuestion has a box before it, ☐ or ☒ once answered.)
    question = [re.sub(r"^[☐☒✔]\s*", "", l.strip()) for l in lines[rule + 1:top] if l.strip() and not DASHES.match(l)]
    if not options:
        return None
    question = "\n".join(question[-14:])
    sig = json.dumps([question, [o["label"] for o in options]])
    return {"id": hashlib.sha1(sig.encode()).hexdigest()[:12], "question": question, "options": options,
            "hint": lines[hint].strip()}


EXITED = "Claude Code exited. Press Enter"


def app_screen(s):
    """What the session's Claude shows now: its screen as text, the question
    on it if any, and whether Claude is there at all (exited: it's waiting
    for Enter to start again)."""
    r = tmux("capture-pane", "-p", "-t", f"={tmux_name(s['id'])}:")
    if r.returncode != 0:
        return {"live": False, "text": "", "dialog": None, "exited": False}
    lines = [l.rstrip() for l in r.stdout.splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    exited = any(EXITED in l for l in lines[-4:])
    return {"live": True, "text": "\n".join(lines), "exited": exited,
            "dialog": None if exited else claude_dialog(lines)}


def app_type(s, text):
    """Send a message to the session's Claude, as if typed and sent: pasted
    (so new lines stay in it) and Enter."""
    pane = f"={tmux_name(s['id'])}:"
    buffer = f"amarchy-app-{os.getpid()}-{threading.get_ident()}"
    r = tmux("set-buffer", "-b", buffer, "--", text)
    if r.returncode == 0:
        r = tmux("paste-buffer", "-p", "-r", "-d", "-b", buffer, "-t", pane)
    if r.returncode != 0:
        return r.stderr.strip() or "tmux failed"
    time.sleep(0.25)      # Claude takes the paste in before Enter sends it
    r = tmux("send-keys", "-t", pane, "Enter")
    return None if r.returncode == 0 else (r.stderr.strip() or "tmux failed")


def valid_keys(keys):
    return isinstance(keys, list) and 0 < len(keys) <= 20 and all(isinstance(k, str) and k in APP_KEYS for k in keys)


def app_keys(s, keys):
    pane = f"={tmux_name(s['id'])}:"
    for i, key in enumerate(keys):
        if i:
            time.sleep(0.06)
        r = tmux("send-keys", "-t", pane, key)
        if r.returncode != 0:
            return r.stderr.strip() or "tmux failed"
    return None


# ---- the server

class AppState:
    """What every connection shares: the list as last read, the moments it
    changed, and which sessions you're looking at on the phone."""

    def __init__(self):
        self.changed = threading.Condition()
        self.view, self.version, self.statuses = {}, 0, None
        self.seen = {}          # session id -> when the phone last said it's on screen

    def row(self, sid):
        return next((s for s in self.view.get("sessions", []) if s["id"] == sid), None)


def app_watch(st):
    """Read the list every second; on a change wake the streams, and tell the
    phones about a session that went on to need you or be done."""
    ps, projects_at = [], 0
    while True:
        try:
            if time.time() - projects_at > 10:
                ps, projects_at = [{"name": p["name"], "sessions": p.get("sessions", 0)} for p in projects()], time.time()
            ss = session_view()
            view = {"hostname": host_name(), "sessions": ss, "projects": ps, "group": list_groups(),
                    "sort": list_sort(), "look": app_look_stamp(), "nerd": bool((app_look() or {}).get("nerd"))}
        except Exception as e:      # a half-written file, say: the next second will do
            print(f"amarchy app: couldn't read the sessions: {e}", file=sys.stderr)
            time.sleep(1)
            continue
        with st.changed:
            if view != st.view:
                st.view = view
                st.version += 1
                st.changed.notify_all()
        app_moments(st, ss)
        time.sleep(1)


def app_moments(st, ss):
    """Notify about each session that went on to need you or finished, as the
    desktop does (cmd_hook): unless it's the one on your phone's screen."""
    now = {s["id"]: s["status"] for s in ss}
    was, st.statuses = st.statuses, now
    if was is None:
        return
    waiting = sum(1 for s in ss if s["status"] == "waiting")
    for s in ss:
        state, prev = s["status"], was.get(s["id"])
        if state == prev or not (state == "waiting" or (state == "idle" and prev == "working")):
            continue
        if time.time() - st.seen.get(s["id"], 0) < APP_SEEN:
            continue
        where = app_where(s)
        body = "Needs you" if state == "waiting" else "Done"
        if state == "waiting":
            time.sleep(0.3)         # the question is on screen by now
            dialog = app_screen(s).get("dialog")
            if dialog and dialog["question"]:
                body += ": " + " · ".join(dialog["question"].splitlines()[-3:])[:300]
        payload = {"title": s.get("task") or where, "body": f"{body}\n{where}" if s.get("task") else body,
                   "tag": s["id"], "url": f"/#/s/{s['id']}", "waiting": waiting}
        threading.Thread(target=push_all, args=(payload,), daemon=True).start()


def app_handler(st, users, address):
    import http.server

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "amarchy"
        sys_version = ""

        def log_message(self, fmt, *args):
            pass

        def log_error(self, fmt, *args):
            print("amarchy app: " + fmt % args, file=sys.stderr)

        def head(self, code, ctype, extra=(), cache="no-cache"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            for k, v in (("Content-Security-Policy", APP_CSP), ("X-Content-Type-Options", "nosniff"),
                         ("Referrer-Policy", "no-referrer"), ("X-Frame-Options", "DENY"),
                         ("Cache-Control", cache), *extra):
                self.send_header(k, v)

        def send(self, code, body, ctype="application/json"):
            data = json.dumps(body).encode() if ctype == "application/json" else body
            self.head(code, ctype, [("Content-Length", str(len(data)))])
            self.end_headers()
            self.wfile.write(data)

        def error(self, code, why):
            self.send(code, {"error": why})

        def allowed(self, write=False):
            """Only you, through tailscale serve, at this machine's address;
            changes only from the app's own pages."""
            host = self.headers.get("Host", "")
            if self.headers.get("Tailscale-User-Login", "") not in users or host.split(":")[0] != address:
                self.error(403, "not yours")
                return False
            if write:
                site = self.headers.get("Sec-Fetch-Site")
                if (self.headers.get("Origin") != f"https://{host}" or (site and site != "same-origin")
                        or not self.headers.get("Content-Type", "").startswith("application/json")):
                    self.error(403, "only from the app")
                    return False
            return True

        def body(self):
            try:
                n = int(self.headers.get("Content-Length") or 0)
                data = json.loads(self.rfile.read(n) if 0 < n <= 200_000 else b"{}")
            except ValueError:
                data = None
            return data if isinstance(data, dict) else {}

        def session(self, sid):
            s = session(sid) if re.fullmatch(r"[\w][\w.-]{0,119}", sid) else None
            if not s or s.get("host") or (CLOSING / f"{sid}.json").exists():
                self.error(404, "no such session")
                return None
            return s

        def do_GET(self):
            if not self.allowed():
                return
            path, _, query = self.path.partition("?")
            args = urllib.parse.parse_qs(query)
            if path == "/api/state":
                with st.changed:
                    view = dict(st.view)
                return self.send(200, {**view, "key": app_public(),
                                       "user": self.headers.get("Tailscale-User-Login")})
            if path == "/api/events":
                return self.list_stream()
            m = re.fullmatch(r"/api/session/([^/]+)/(stream|earlier)", path)
            if m:
                s = self.session(m.group(1))
                if not s:
                    return
                if m.group(2) == "stream":
                    return self.session_stream(s)
                try:
                    items, start = app_earlier(s, int(args.get("before", ["0"])[0]))
                except (ValueError, OSError):
                    return self.error(400, "bad offset")
                return self.send(200, {"items": items, "start": start})
            if path == "/theme.css":
                return self.send(200, app_theme_css().encode(), "text/css; charset=utf-8")
            m = re.fullmatch(r"/look/([0-9a-f]{12}-(?:regular|bold|wallpaper)\.(ttf|otf|woff2?|jpg|png|webp))", path)
            if m:
                f = APP_LOOK / m.group(1)
                if not f.is_file():
                    return self.error(404, "not found")
                data = f.read_bytes()
                # Named after what it is: the same name is always the same file.
                self.head(200, APP_LOOK_TYPES[m.group(2)], [("Content-Length", str(len(data)))],
                          cache="max-age=31536000, immutable")
                self.end_headers()
                self.wfile.write(data)
                return
            return self.page(path)

        def page(self, path):
            name = "index.html" if path == "/" else path.lstrip("/")
            f = APP_PAGES / name
            if not re.fullmatch(r"[\w-]+(\.[\w-]+)+", name) or Path(name).suffix not in APP_TYPES or not f.is_file():
                return self.error(404, "not found")
            extra = [("Service-Worker-Allowed", "/")] if name == "sw.js" else []
            data = f.read_bytes()
            self.head(200, APP_TYPES[Path(name).suffix], [("Content-Length", str(len(data))), *extra])
            self.end_headers()
            self.wfile.write(data)

        def stream_start(self):
            self.head(200, "text/event-stream", [("X-Accel-Buffering", "no")])
            self.end_headers()
            self.close_connection = True

        def event(self, name, data):
            self.wfile.write(f"event: {name}\ndata: {json.dumps(data)}\n\n".encode())
            self.wfile.flush()

        def list_stream(self):
            """The list, and again on every change."""
            self.stream_start()
            version = -1
            try:
                while True:
                    with st.changed:
                        if st.version == version or not st.view:
                            st.changed.wait(KEEPALIVE)
                        if not st.view:
                            continue
                        view, changed, version = st.view, st.version != version, st.version
                    if changed:
                        self.event("list", view)
                    else:
                        self.wfile.write(b": still here\n\n")
                        self.wfile.flush()
            except OSError:
                pass

        def session_stream(self, s):
            """A session as it goes on: its row in the list, its conversation
            (the latest of it first), and its screen with any question on it."""
            if not s.get("setup") and Path(s["path"]).is_dir() and not tmux_has(tmux_name(s["id"])):
                host_start(s)       # after a reboot, before anyone attached: Claude picks up where it was
            self.stream_start()
            conv, screen, row, beat = AppConversation(s), None, None, time.time()
            try:
                while True:
                    now = st.row(s["id"])
                    if now is None and (not session(s["id"]) or (CLOSING / f"{s['id']}.json").exists()):
                        self.event("gone", {})
                        return
                    if now is not None and now != row:
                        row = now
                        self.event("session", row)
                    items, reset = conv.poll()
                    if reset:
                        self.event("conversation", {"reset": True, "items": items, "start": conv.start})
                    elif items:
                        self.event("conversation", {"items": items})
                    seen = app_screen(s)
                    if seen != screen:
                        screen = seen
                        self.event("screen", screen)
                    if time.time() - beat > KEEPALIVE:
                        self.wfile.write(b": still here\n\n")
                        self.wfile.flush()
                        beat = time.time()
                    time.sleep(0.5)
            except OSError:
                pass

        def do_POST(self):
            if not self.allowed(write=True):
                return
            data = self.body()
            if self.path == "/api/new":
                return self.new(data)
            if self.path in ("/api/push", "/api/push/remove", "/api/push/test"):
                return self.push(data)
            m = re.fullmatch(r"/api/session/([^/]+)/(send|keys|priority|seen)", self.path)
            s = self.session(m.group(1)) if m else self.error(404, "not found")
            if not s:
                return
            what = m.group(2)
            if what == "seen":
                st.seen[s["id"]] = time.time()
                return self.send(200, {})
            if what == "priority":
                level = data.get("level")
                if level not in PRIORITIES:
                    return self.error(400, "high, normal or low")
                r = run_amarchy("priority", level, "--id", s["id"])
                return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            screen = app_screen(s)
            if what == "send":
                text = data.get("text")
                if not isinstance(text, str) or not text.strip() or len(text) > 60_000:
                    return self.error(400, "nothing to send")
                if not screen["live"]:
                    return self.error(409, "Claude isn't running yet: try again in a moment")
                if screen["exited"]:
                    return self.error(409, "Claude Code exited: start it again first")
                # An answer in your own words to a question ("Type something."):
                # that option's keys first, then the text.
                answer = data.get("answer") if isinstance(data.get("answer"), dict) else None
                if screen["dialog"] and not answer:
                    return self.error(409, "Claude is asking you something: answer that first")
                if answer:
                    keys = answer.get("keys")
                    if (screen["dialog"] or {}).get("id") != answer.get("dialog"):
                        return self.error(409, "The question changed: look again")
                    if not valid_keys(keys):
                        return self.error(400, "keys it doesn't send")
                    why = app_keys(s, keys)
                    if why:
                        return self.error(500, why)
                    time.sleep(0.2)
                why = app_type(s, text.replace("\r\n", "\n").replace("\r", "\n"))
            else:
                keys = data.get("keys")
                if not valid_keys(keys):
                    return self.error(400, "keys it doesn't send")
                expect = data.get("dialog")
                if expect is not None and (screen["dialog"] or {}).get("id") != expect:
                    return self.error(409, "The question changed: look again")
                why = app_keys(s, keys)
            st.seen[s["id"]] = time.time()
            return self.send(200, {}) if why is None else self.error(500, why)

        def new(self, data):
            repo, prompt = data.get("repo"), data.get("prompt")
            if not isinstance(repo, str) or repo not in {p["name"] for p in st.view.get("projects", [])}:
                return self.error(400, "no such project")
            if not isinstance(prompt, str) or not prompt.strip() or len(prompt) > 60_000:
                return self.error(400, "say what it's for")
            r = run_amarchy("new", repo, "--no-jump", "--prompt", "-", input=prompt, timeout=300)
            sid = (r.stdout.strip().splitlines() or [""])[-1]
            if r.returncode != 0 or not sid:
                return self.error(500, gist(r.stderr) or "couldn't start it")
            return self.send(200, {"id": sid})

        def push(self, data):
            if self.path == "/api/push/test":
                n = push_all({"title": "Amarchy", "body": "Notifications work.", "tag": "amarchy-test", "url": "/"})
                return self.send(200, {"sent": n})
            endpoint = data.get("endpoint")
            if not isinstance(endpoint, str) or not endpoint.startswith("https://"):
                return self.error(400, "not a push subscription")
            if self.path == "/api/push/remove":
                app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] != endpoint])
                return self.send(200, {})
            keys = data.get("keys") if isinstance(data.get("keys"), dict) else {}
            try:
                if len(unb64u(keys["p256dh"])) != 65 or len(unb64u(keys["auth"])) != 16:
                    raise ValueError
            except (KeyError, ValueError, TypeError):
                return self.error(400, "not a push subscription")
            sub = {"endpoint": endpoint, "keys": {"p256dh": keys["p256dh"], "auth": keys["auth"]},
                   "added": int(time.time()), "device": str(self.headers.get("User-Agent", ""))[:200]}
            app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] != endpoint] + [sub])
            return self.send(200, {})

    return Handler


def run_amarchy(*args, input=None, timeout=60):
    try:
        return subprocess.run([sys.executable, SELF, *args], capture_output=True, text=True, input=input,
                              stdin=None if input is not None else subprocess.DEVNULL, timeout=timeout,
                              env=clean_env())
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(args, 1, "", str(e))


def app_serve():
    """Run the app's server (what amarchy-app.service runs) until amarchy is
    updated, when systemd starts the new one."""
    import http.server
    if not HOST_MODE:
        return fail("the phone app runs on a host (see amarchy remote)")
    status = tailscale_status()
    address, users = app_address(status), app_users(status)
    if not address:
        return fail("this machine isn't on Tailscale (or Tailscale isn't up): the app is served on your tailnet")
    if not users:
        return fail("couldn't tell who owns this machine on Tailscale: set APP_USERS=<your login> "
                    f"in {HOST_CONFIG}")
    app_key()
    st = AppState()
    server = http.server.ThreadingHTTPServer(("127.0.0.1", app_port()), app_handler(st, users, address))
    server.daemon_threads = True
    threading.Thread(target=app_watch, args=(st,), daemon=True).start()
    version = os.stat(SELF).st_mtime_ns

    def updated():
        while True:
            time.sleep(2)
            try:
                if os.stat(SELF).st_mtime_ns != version:
                    break
            except OSError:
                pass
        server.shutdown()

    threading.Thread(target=updated, daemon=True).start()
    print(f"amarchy app: {app_url(address)} for {', '.join(sorted(users))} "
          f"(on 127.0.0.1:{app_port()})", file=sys.stderr, flush=True)
    server.serve_forever()
    return 0


def app_unit():
    return f"""[Unit]
Description=amarchy phone app: your sessions on your phone, on your tailnet
After=network-online.target tailscaled.service

[Service]
ExecStart={ENTRY} app serve
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
"""


def serve_config():
    """What tailscale serve proxies the app's HTTPS port to, or None."""
    try:
        conf = json.loads(sh("tailscale", "serve", "status", "--json").stdout or "{}")
    except ValueError:
        return None
    for hostport, web in (conf.get("Web") or {}).items():
        if hostport.endswith(f":{app_https()}"):
            return ((web.get("Handlers") or {}).get("/") or {}).get("Proxy")
    return None


def app_on():
    status = tailscale_status()
    address = app_address(status)
    if not shutil.which("tailscale") or not address:
        return fail("the app is served on your tailnet: install Tailscale and run `sudo tailscale up` first")
    if not status.get("CertDomains"):
        return fail("Tailscale has no HTTPS certificates for your tailnet yet: turn them on at "
                    "https://login.tailscale.com/admin/dns (HTTPS Certificates), then run this again")
    if not app_users(status):
        return fail(f"couldn't tell who owns this machine on Tailscale: set APP_USERS=<your login> in {HOST_CONFIG}")
    target = f"http://127.0.0.1:{app_port()}"
    taken = serve_config()
    if taken and taken != target:
        return fail(f"tailscale serve already sends port {app_https()} to {taken}: set APP_HTTPS=8443 "
                    f"in {HOST_CONFIG} to put the app on another port")
    app_key()
    UNITS.mkdir(parents=True, exist_ok=True)
    unit = UNITS / APP_UNIT
    if not unit.exists() or unit.read_text() != app_unit():
        write_file(unit, app_unit())
        sh("systemctl", "--user", "daemon-reload")
    r = sh("systemctl", "--user", "enable", "--now", APP_UNIT)
    if r.returncode != 0:
        return fail(f"couldn't start {APP_UNIT}: {gist(r.stderr)}")
    sh("systemctl", "--user", "restart", APP_UNIT)
    if taken != target:
        r = sh("tailscale", "serve", "--bg", f"--https={app_https()}", target)
        if r.returncode != 0:
            why = gist(r.stderr or r.stdout)
            if "access denied" in (r.stderr + r.stdout).lower():
                why = "Tailscale won't let you change it: run `sudo tailscale set --operator=$USER` once"
            return fail(f"couldn't serve it on your tailnet: {why}")
    if sh("loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger").stdout.strip() == "Linger=no":
        print("  Note: it stops when you log out of this machine. `sudo loginctl enable-linger $USER` keeps it running.")
    print(f"{app_url(address)}\n"
          f"  On your phone (on your tailnet): open it in Safari, then Share → Add to Home Screen.\n"
          f"  Open it from the home screen and turn on notifications there.")
    return 0


def app_off():
    if serve_config() == f"http://127.0.0.1:{app_port()}":
        sh("tailscale", "serve", f"--https={app_https()}", "off")
    sh("systemctl", "--user", "disable", "--now", APP_UNIT)
    (UNITS / APP_UNIT).unlink(missing_ok=True)
    sh("systemctl", "--user", "daemon-reload")
    print("off: the app is no longer served (your phones keep it, and it works again with `amarchy app on`)")
    return 0


def app_status():
    running = sh("systemctl", "--user", "is-active", APP_UNIT).stdout.strip() == "active"
    served = serve_config() == f"http://127.0.0.1:{app_port()}"
    address = app_address()
    phones = len(app_subscriptions())
    if not running and not served:
        print("off (amarchy app on starts it)")
        return 1
    where = app_url(address) if address and served else "not on your tailnet (amarchy app on)"
    print(f"{'on' if running else 'stopped'}: {where}, {phones} phone{'' if phones == 1 else 's'} notified")
    return 0 if running and served else 1


def cmd_app(args):
    """amarchy app [on|off|--status|--test|serve]."""
    if not HOST_MODE:
        return fail("the phone app runs on a host: the machine your desktops reach with amarchy remote")
    what = args[0] if args else "--status"
    if what == "serve":
        return app_serve()
    if what == "theme":
        try:
            return app_theme(json.loads(sys.stdin.read()))
        except ValueError:
            return fail("app theme: expects the look as JSON, from the desktop")
    if what == "on":
        return app_on()
    if what == "off":
        return app_off()
    if what == "--test":
        if not app_subscriptions():
            return fail("no phone has turned on notifications yet (in the app: the gear, then Turn on notifications)")
        n = push_all({"title": "Amarchy", "body": "Notifications work.", "tag": "amarchy-test", "url": "/"})
        print(f"sent to {n} of {len(app_subscriptions())}")
        return 0 if n else 1
    if what == "--status":
        return app_status()
    return fail("usage: amarchy app [on|off|--status|--test]")


# ------------------------------------------------------------------ main

# What each command takes, for `amarchy <command> --help` and for catching an
# option it doesn't know before it acts on it: `close --help` would otherwise
# close the session, `new --help` start one named --help. Flags are the
# options it knows; values, those that take the next word (skipped when
# checking); text, those after which the rest is free text (a command, a
# prompt), left alone. Commands with None are plumbing whose arguments come
# from amarchy itself or from Claude Code: only a first --help is theirs (none for editor).
OPTIONS = {
    "new": ({"--prompt", "--no-jump"}, {"--prompt"}, set()),
    "add": ({"--new", "--github"}, set(), set()),
    "projects": ({"--github", "--json"}, set(), set()),
    "list": ({"--compact"}, set(), set()),
    "open": (set(), set(), set()),
    "next": (set(), set(), set()),
    "prev": (set(), set(), set()),
    "jump": (set(), set(), set()),
    "close": ({"--force", "--confirm"}, set(), set()),
    "rename": ({"--id", "--reset"}, {"--id"}, set()),
    "zen": (set(), set(), set()),
    "terminal": (set(), set(), set()),
    "run": ({"--show", "--set", "--save", "--forget", "--list", "--pick"}, {"--forget"}, {"--set", "--save"}),
    "show": (set(), set(), set()),
    "search": (set(), set(), set()),
    "pick": (set(), set(), set()),
    "menu": ({"--json", "--omarchy"}, set(), set()),
    "priority": ({"--id"}, {"--id"}, set()),
    "group": (set(), set(), set()),
    "sort": (set(), set(), set()),
    "order": (set(), set(), set()),
    "sleep": ({"--force", "--all", "--after", "--idle"}, {"--after"}, set()),
    "wake": (set(), set(), set()),
    "theme": ({"--show", "--refresh"}, set(), set()),
    "keys": ({"--show"}, set(), set()),
    "sound": ({"--show", "--list", "--json", "--play", "--stop", "--add"}, set(), set()),
    "ui": (set(), set(), set()),
    "layout": (set(), set(), set()),
    "watch": (set(), set(), set()),
    "remote": ({"--status", "--sync"}, set(), set()),
    "events": ({"--once"}, set(), set()),
    "app": ({"--status", "--test"}, set(), set()),
    "setup": None, "claude": None, "asleep": None, "woke": None, "hook": None,
    "reap": None, "shorten": None, "editor": None, "attach": None, "held": None,
}
ALIASES = {"cockpit": "terminal"}     # cockpit: the old name of terminal, still bound in some configs
HELP = ("-h", "--help")
OLD_USAGE = {"order": "  amarchy order [opened|activity]       from before `amarchy group`: activity is "
                      "`group status on`, opened `group status off`"}


def usage(cmd):
    """The lines of this file's docstring for one command (with the ones
    continuing them), or None for a command it doesn't know."""
    lines, found, keep = __doc__.splitlines(), [], False
    for line in lines:
        words = line.split()
        if line.startswith("  amarchy ") and len(words) > 1:
            names, i = [words[1]], 2
            while i + 1 < len(words) and words[i] == "|" and re.fullmatch(r"[a-z]+", words[i + 1]):
                names.append(words[i + 1])
                i += 2
            keep = cmd in names
            if keep:
                found.append(line)
        elif keep and line.startswith(" " * 40) and line.strip():
            found.append(line)
        else:
            keep = False
    if not found and cmd in OLD_USAGE:
        found = [OLD_USAGE[cmd]]
    return "usage:\n" + "\n".join(found) if found else None


def check_args(cmd, args):
    """`--help` or `-h` for a command: its usage (0). An option it doesn't know:
    the usage on stderr (1). Otherwise None, and the command runs."""
    spec = OPTIONS.get(cmd)
    if spec is None:
        if cmd != "editor" and args[:1] and args[0] in HELP:
            print(usage(cmd))
            return 0
        return None
    flags, values, text = spec
    it = iter(args)
    for a in it:
        if a in HELP:
            print(usage(cmd))
            return 0
        name = "--prompt" if cmd == "new" and a.startswith("--prompt=") else a     # new's only --option=value
        if name in text:
            break
        if name in values and name == a:
            next(it, None)
        elif re.fullmatch(r"--[A-Za-z][\w-]*(=.*)?", a) and name not in flags:
            print(f"amarchy {cmd}: unknown option {name}\n{usage(cmd)}", file=sys.stderr)
            return 1
    return None


def cmd_help(args):
    """`amarchy help [command]`: everything, or one command's usage."""
    if not args:
        print(__doc__)
        return 0
    cmd = ALIASES.get(args[0], args[0])
    text = usage(cmd) if cmd in OPTIONS else None
    if not text:
        return fail(f"unknown command {args[0]!r} (amarchy help lists them)")
    print(text)
    return 0


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("help", [])
    if cmd in ("help", *HELP):
        return cmd_help(args)
    if ALIASES.get(cmd, cmd) not in OPTIONS:
        return fail(f"unknown command {cmd!r} (amarchy help lists them)")
    checked = check_args(ALIASES.get(cmd, cmd), args)
    if checked is not None:
        return checked
    migrate_legacy()
    if cmd == "new":
        return cmd_new(args)
    elif cmd == "add":
        return cmd_add(args)
    elif cmd == "projects":
        return cmd_projects(args)
    elif cmd == "close":
        return cmd_close(args)
    elif cmd == "rename":
        return cmd_rename(args)
    elif cmd == "priority":
        return cmd_priority(args)
    elif cmd == "open":
        cmd_open()
    elif cmd in ("next", "prev"):
        return cmd_step(1 if cmd == "next" else -1)
    elif cmd == "jump" and len(args) == 1:
        if not session(args[0]):
            return fail(f"No session {args[0]!r}")
        cmd_jump(args[0])
    elif cmd == "list":
        print(json.dumps(session_view(), indent=None if "--compact" in args else 2))
    elif cmd in ("terminal", "cockpit"):   # cockpit: the old name, still bound in some configs
        return cmd_terminal(args)
    elif cmd == "zen":
        return cmd_zen(args)
    elif cmd == "run":
        return cmd_run(args)
    elif cmd == "show":
        return cmd_show()
    elif cmd == "search":
        return cmd_search()
    elif cmd == "ui":
        cmd_ui()
    elif cmd == "pick":
        return cmd_pick(args)
    elif cmd == "menu":
        return cmd_menu(args)
    elif cmd == "theme":
        return cmd_theme(args)
    elif cmd == "sound":
        return cmd_sound(args)
    elif cmd == "keys":
        return cmd_keys(args)
    elif cmd == "watch":
        return cmd_watch()
    elif cmd == "group":
        return cmd_group(args)
    elif cmd == "sort":
        return cmd_sort(args)
    elif cmd == "order":
        return cmd_order(args)
    elif cmd == "layout":
        cmd_layout()
    elif cmd == "setup" and len(args) == 1:
        return cmd_setup(args[0])
    elif cmd == "hook" and len(args) == 2:
        cmd_hook(*args)
    elif cmd == "sleep":
        return cmd_sleep(args)
    elif cmd == "wake":
        return cmd_wake(args)
    elif cmd == "reap" and len(args) == 1:
        return cmd_reap(args[0])
    elif cmd == "claude" and len(args) == 1:
        return cmd_claude(args[0])
    elif cmd == "shorten" and len(args) == 2:
        return cmd_shorten(*args)
    elif cmd == "asleep" and len(args) == 1:
        return cmd_asleep(args[0])
    elif cmd == "woke" and len(args) in (1, 2):
        return cmd_woke(args[0], args[1] if len(args) > 1 else "")
    elif cmd == "editor":
        return cmd_editor(args)
    elif cmd == "remote":
        return cmd_remote(args)
    elif cmd == "attach" and args:
        return cmd_attach(args)
    elif cmd == "held" and len(args) == 1:
        return cmd_held(args[0])
    elif cmd == "events":
        return cmd_events(args)
    elif cmd == "app":
        return cmd_app(args)
    else:   # a command it knows, with the wrong number of arguments
        print(usage(ALIASES.get(cmd, cmd)), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
