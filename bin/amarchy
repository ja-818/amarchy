HOME = Path.home()
WORK = Path(os.environ.get("AMARCHY_WORK", HOME / "Work")).expanduser()
WORKTREES = Path(os.environ.get("AMARCHY_WORKTREES", WORK / ".worktrees")).expanduser()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "amarchy"
SESSIONS = STATE / "sessions"
STATUS = STATE / "status"
UNSEEN = STATE / "unseen"       # sessions that finished while you weren't looking, until you open them
SEEN = STATE / "seen"           # when you last looked at each session (its file's time): what came after is unread
SENT_BY = STATE / "sent-by"     # <id>.jsonl: what a script, a timer or another chat sent a session (amarchy send), not you
RUN = STATE / "run"             # per project: <repo> its run command, <repo>.json its other saved commands
PROJECT_ORDER = STATE / "project-order"  # the order your projects come in, one name a line (see project_order)
CLOSING = STATE / "closing"     # sessions closed but not yet cleaned up (see "reap")
MISSIONS = STATE / "missions.jsonl"   # every chat completed (closed): when, which, how long it took (missions_view)
CLAUDE_STATE = STATE / "claude" # per session: its conversation, and what sleep keeps for it (see "sleep")
SLEEP_AFTER = STATE / "sleep-after"     # minutes idle and open nowhere before a session sleeps, or "off"
SELF = str(Path(__file__).resolve())
# What runs later, after this has exited (Claude's hooks, the timers, the
# app's service), goes through the installed amarchy: it follows install.sh
# instead of staying on the copy that set it up, a worktree maybe long gone.
INSTALLED = Path.home() / ".local/bin/amarchy"
ENTRY = str(INSTALLED) if INSTALLED.exists() else SELF
SOUNDS = Path(SELF).parent.parent / "sounds"       # amarchy's chimes, one played with a session's notification
SOUND_FILE = STATE / "sound"                       # the one picked (its name, or "off")
ASSISTANT_SOUND_FILE = STATE / "sound-assistant"   # your assistant's own (its name, or "off"; see "assistant")
CLAUDE_THEME = HOME / ".claude/themes/amarchy.json"

# Reached over ssh, or from a systemd unit, with a bare PATH: Claude Code's
# installer puts claude in ~/.local/bin.
if str(HOME / ".local/bin") not in os.environ.get("PATH", "").split(os.pathsep):
    os.environ["PATH"] = os.pathsep.join(filter(None, (str(HOME / ".local/bin"), os.environ.get("PATH"))))

# AMARCHY_CLAUDE_ARGS, else ~/.config/amarchy/claude-args: a file reaches every way a
# session starts (ssh, the app's service, another session).
_CLAUDE_ARGS_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy/claude-args"
CLAUDE_ARGS = shlex.split(os.environ.get("AMARCHY_CLAUDE_ARGS")
                          or (_CLAUDE_ARGS_FILE.read_text().strip() if _CLAUDE_ARGS_FILE.is_file() else "")
                          or "--permission-mode auto")


# ------------------------------------------------------------------ helpers

def sh(*args, check=False, cwd=None):
    """Run a command and capture what it says. One that isn't there (tailscale,
    say) or a folder that's gone fails like a command would. `tailscale` is
    this computer's: the system's, or amarchy's own node's (track H)."""
    if args and args[0] == "tailscale":
        args = tuple(tailscale_argv(args[1:]))
    try:
        return subprocess.run(args, capture_output=True, text=True, check=check, cwd=cwd)
    except (FileNotFoundError, NotADirectoryError) as e:
        if check:
            raise
        return subprocess.CompletedProcess(args, 127, "", str(e))


# Set by a running Claude Code for its own children. When an agent drives
# amarchy, they'd leak into the sessions it opens (e.g. turning off transcript
# saving), so the sessions it starts go without them.
INHERITED_CLAUDE_ENV = ("CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_CODE_CHILD_SESSION",
                        "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_ENTRYPOINT",
                        "CLAUDE_CODE_EXECPATH", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                        "CLAUDE_CODE_AUTO_COMPACT_WINDOW", "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS")


# A session's own environment (session_env), when amarchy runs inside one: what
# it opens belongs to whatever session it opens it for, if any.
SESSION_ENV = ("AMARCHY", "AMARCHY_SESSION", "AMARCHY_PATH", "AMARCHY_NAME", "AMARCHY_REPO",
               "AMARCHY_BRANCH", "AMARCHY_ROOT")


def clean_env():
    return {k: v for k, v in os.environ.items() if k not in INHERITED_CLAUDE_ENV + SESSION_ENV}


def detach(argv):
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, env=clean_env(), stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def processes():
    """Every process: {pid: (ppid, comm, cpu ticks)}, from /proc."""
    out = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            stat = Path(f"/proc/{d}/stat").read_text()
        except OSError:
            continue
        # comm is in parentheses and may hold anything, spaces and parentheses too.
        fields = stat[stat.rfind(")") + 2:].split()
        out[int(d)] = (int(fields[1]), stat[stat.find("(") + 1:stat.rfind(")")], int(fields[11]) + int(fields[12]))
    return out


def descendants(pid, procs):
    """A process's children, grandchildren... nearest first."""
    children = {}
    for p, (ppid, *_) in procs.items():
        children.setdefault(ppid, []).append(p)
    out, todo = [], [pid]
    while todo:
        kids = sorted(children.get(todo.pop(0), []))
        out += kids
        todo += kids
    return out


def cmdline(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace").split("\0")
    except OSError:
        return []


def slug(text):
    return re.sub(r"[^a-z0-9-]+", "-", text.strip().lower()).strip("-")[:40]


def repos():
    if not WORK.is_dir():
        return []
    return sorted(p.name for p in WORK.iterdir()
                  if not p.name.startswith(".") and (p / ".git").exists())


def fail(msg):
    print(f"amarchy: {msg}", file=sys.stderr)
    return 1


# ------------------------------------------------------------------ projects

def github_slug(url):
    """owner/repo (lowercased) for a GitHub remote URL, else None."""
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$", url or "")
    return m.group(1).lower() if m else None


def projects(remotes=True):
    """Your projects: the git repos in AMARCHY_WORK, with their session counts
    (remotes=False: without their remote, a git each, the list's every few seconds)."""
    counts = {}
    for s in sessions():
        counts[s["repo"]] = counts.get(s["repo"], 0) + 1
    out = []
    for name in repos():
        p = {"name": name, "path": str(WORK / name), "sessions": counts.get(name, 0)}
        if remotes:
            p["remote"] = sh("git", "remote", "get-url", "origin", cwd=WORK / name).stdout.strip()
        out.append(p)
    return out


# Your projects come in the order you put them in (`amarchy projects order`,
# or moved one at a time from any list): the
# pickers. One you haven't placed goes after the ones you have, by name, so
# a project you add shows up last until you move it.

_github_memo = {}


def project_github(name):
    """A project's GitHub address (owner/repo), or None: what another machine
    clones it from (a new chat there, "Where"). Read again only when its git
    config changes; never the remote itself (it may carry a token)."""
    conf = WORK / name / ".git" / "config"
    try:
        sig = conf.stat().st_mtime_ns
    except OSError:
        return None
    kept = _github_memo.get(name)
    if kept and kept[0] == sig:
        return kept[1]
    slug = github_slug(sh("git", "remote", "get-url", "origin", cwd=WORK / name).stdout.strip())
    _github_memo[name] = (sig, slug)
    return slug


def project_order():
    """The projects you put in order, first first (names; one may be gone)."""
    try:
        names = PROJECT_ORDER.read_text().split("\n")
    except OSError:
        return []
    out = []
    for n in (n.strip() for n in names):
        if n and n not in out:
            out.append(n)
    return out


def project_rank(order):
    """A sort key for a project's name: placed ones in their place, the rest after, by name."""
    at = {n: i for i, n in enumerate(order)}
    return lambda name: (at.get(name, len(at)), name.lower(), name)


def ordered_projects(ps, order=None):
    """Projects (dicts with a name) in your order."""
    rank = project_rank(project_order() if order is None else order)
    return sorted(ps, key=lambda p: rank(p["name"]))


def project_names():
    """Every project there is, in your order: yours, and any a session is in."""
    names = {p["name"] for p in projects(remotes=False)} | {s["repo"] for s in sessions()}
    return sorted(names, key=project_rank(project_order()))


def set_project_order(names, rest=True):
    """Put these projects first, in this order; the ones you had placed
    before keep their order after them (rest=False: they're unplaced, back
    after them by name). None, or what's wrong with it."""
    if not isinstance(names, list) or not all(isinstance(n, str) and n.strip() and "\n" not in n for n in names):
        return "projects: a list of project names"
    names = [n.strip() for n in names]
    if len(set(names)) < len(names):
        return "projects: each one once"
    order = names + ([n for n in project_order() if n not in names] if rest else [])
    if order != project_order():
        write_file(PROJECT_ORDER, "".join(n + "\n" for n in order))
    return None


PROJECT_MOVES = ("up", "down", "top", "bottom", "before", "after")


def move_project(name, where, other=None):
    """Move a project up or down one, to the top or bottom, or right before or
    after another one. None, or what's wrong."""
    names = project_names()
    if name not in names:
        return f"no project {name!r}"
    if where not in PROJECT_MOVES:
        return f"move it {', '.join(PROJECT_MOVES[:-1])} or {PROJECT_MOVES[-1]}"
    if where in ("before", "after"):
        if other not in names:
            return f"no project {other!r}" if other else f"{where} which project?"
        if other == name:
            return None
    at = names.index(name)
    names.remove(name)
    if where == "up":
        names.insert(max(at - 1, 0), name)
    elif where == "down":
        names.insert(min(at + 1, len(names)), name)
    elif where == "top":
        names.insert(0, name)
    elif where == "bottom":
        names.append(name)
    else:
        names.insert(names.index(other) + (where == "after"), name)
    return set_project_order(names)


def github_repos():
    """Your GitHub repos (owned, collaborator, org), most recently pushed first.

    None when gh is missing or not logged in."""
    if not shutil.which("gh"):
        return None
    r = sh("gh", "api", "user/repos?affiliation=owner,collaborator,organization_member&sort=pushed&per_page=100",
           "--jq", "[.[] | {name: .full_name, private, pushed: .pushed_at, description}]")
    if r.returncode != 0:
        return None
    added = {github_slug(p["remote"]) for p in projects()}
    rs = json.loads(r.stdout or "[]")
    for repo in rs:
        repo["added"] = repo["name"].lower() in added
    return rs


def add_project(source):
    """Clone owner/repo, a GitHub URL or any git URL into AMARCHY_WORK.

    Returns (name, error). Adding a project that's already there is not an error."""
    source = source.strip()
    url = f"https://github.com/{source}.git" if re.fullmatch(r"[\w.-]+/[\w.-]+", source) else source
    name = re.sub(r"\.git$", "", re.split(r"[/:]", url.rstrip("/"))[-1])
    if not name:
        return None, f"can't tell the project name from {source!r}"
    gh_slug = github_slug(url)
    for p in projects():
        if p["name"] == name and (not gh_slug or github_slug(p["remote"]) == gh_slug):
            return name, None
    dest = WORK / name
    if dest.exists():
        return None, f"{dest} already exists and isn't {source}"
    WORK.mkdir(parents=True, exist_ok=True)
    # Not captured: git's progress shows when run from a terminal.
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}  # fail instead of hanging on a password prompt
    if subprocess.run(["git", "clone", url, str(dest)], env=env).returncode != 0:
        return None, f"git clone {url} failed"
    return name, None


def new_project(name, github=False):
    """An empty git repo with one commit (worktrees need a base), optionally
    pushed to a new private GitHub repo. Returns (name, error)."""
    name = slug(name)
    if not name:
        return None, "the project needs a name"
    dest = WORK / name
    if dest.exists():
        return None, f"{dest} already exists"
    dest.mkdir(parents=True)
    sh("git", "init", "--quiet", "-b", "main", cwd=dest)
    # A machine with no git identity (a fresh one) still gets its first commit: the chat branches off it.
    known = sh("git", "config", "user.email", cwd=dest).returncode == 0
    who = [] if known else ["-c", "user.name=amarchy", "-c", "user.email=amarchy@localhost"]
    r = sh("git", *who, "commit", "--quiet", "--allow-empty", "-m", "Initial commit", cwd=dest)
    if r.returncode != 0:
        return name, f"created {dest}, but its first commit failed: {r.stderr.strip()[:200]}"
    if github:
        r = sh("gh", "repo", "create", name, "--private", "--source", str(dest), "--push")
        if r.returncode != 0:
            return name, f"created {dest}, but gh repo create failed: {r.stderr.strip()[:200]}"
    return name, None


def cmd_add(args):
    if not args:
        print(usage("add"), file=sys.stderr)
        return 1
    if args[0] == "--new":
        names = [a for a in args[1:] if not a.startswith("--")]
        if not names:
            return fail("usage: amarchy add --new <name> [--github]")
        name, err = new_project(names[0], github="--github" in args)
    else:
        name, err = add_project(args[0])
    if err:
        return fail(err)
    print(WORK / name)
    return 0


def cmd_projects(args):
    if "--github" in args:
        rs = github_repos()
        if rs is None:
            return fail("gh isn't installed or logged in (gh auth login)")
        if "--json" in args:
            print(json.dumps(rs, indent=2))
        else:
            for r in rs:
                print(f"{'✓' if r['added'] else ' '} {r['name']}{'  (private)' if r['private'] else ''}")
        return 0
    if args[:1] == ["order"]:
        if len(args) > 1:
            names, known = args[1:], set(project_names())
            missing = [n for n in names if n not in known]
            why = f"no project {missing[0]!r}" if missing else set_project_order(names)
            if why:
                return fail(why)
        print("\n".join(project_names()))
        return 0
    if args[:1] == ["move"]:
        if len(args) not in (3, 4) or args[2] not in PROJECT_MOVES or (len(args) == 4) != (args[2] in ("before", "after")):
            return fail("usage: amarchy projects move <project> up|down|top|bottom | before|after <other>")
        why = move_project(args[1], args[2], args[3] if len(args) == 4 else None)
        if why:
            return fail(why)
        print("\n".join(project_names()))
        return 0
    if args:
        unknown = [a for a in args if a not in ("--json",)]
        if unknown:
            return fail("usage: amarchy projects [--json] | --github [--json] | order [project...] | move ...")
    ps = ordered_projects(projects())
    if "--json" in args:
        print(json.dumps(ps, indent=2))
    else:
        for p in ps:
            n = p["sessions"]
            print(f"{p['name']:<30} {n} session{'s' if n != 1 else ''}  {p['remote']}")
    return 0


# ------------------------------------------------------------------ sessions

def sessions():
    out = []
    for f in sorted(SESSIONS.glob("*.json")):
        try:
            s = json.loads(f.read_text())
            st = STATUS / s["id"]
        except (ValueError, KeyError, TypeError):
            continue
        s["status"] = st.read_text().strip() if st.exists() else "idle"
        out.append(s)
    return out


def session(sid):
    try:
        return json.loads((SESSIONS / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None


def save_session(s):
    """Write a session's file in one go: the list (and every other amarchy
    reading it meanwhile) never sees half of it."""
    SESSIONS.mkdir(parents=True, exist_ok=True)
    keep = {k: v for k, v in s.items() if k not in VIEW_FIELDS}
    if isinstance(keep.get("previews"), list):      # (each as the list has it: what it adds isn't saved)
        keep["previews"] = [preview_stored(p) for p in keep["previews"] if isinstance(p, dict)]
    tmp = SESSIONS / f".{s['id']}.json.{os.getpid()}"
    tmp.write_text(json.dumps(keep))
    os.replace(tmp, SESSIONS / f"{s['id']}.json")


# What session_view() adds for the UIs, never saved.
VIEW_FIELDS = ("status", "awake", "sleeping", "waking", "task", "claude_title", "age", "background", "agent",
               "running", "serving", "unseen", "assistant", "assistant_name", "said", "said_at", "unread", "picture", "chime",
               "today", "permission", "merged", "cut", "interrupted", "moving", "move_error")


def own_session_id():
    """The session a command is about when none is named: the one it runs in
    (from its Claude or its terminal, $AMARCHY_SESSION), or None."""
    sid = os.environ.get("AMARCHY_SESSION", "")
    return sid if session(sid) else None


# ------------------------------------------------------------------ sound

# amarchy's own chimes (sounds/, where sounds/CREDITS says where each is from),
# in the order the app offers them; the first is the default. The app plays
# the one picked when a session needs you or is done.
CHIMES = ("kalimba", "vibraphone", "tine", "fairy", "ocean", "elementary", "herald")
ASSISTANT_CHIME = "herald"      # your assistant's, until you pick another (amarchy sound --assistant)
USER_SOUNDS = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy/sounds"
AUDIO = (".wav", ".oga", ".ogg", ".opus", ".flac", ".mp3")   # what a sound of yours can be


def sounds():
    """Every sound to pick from, {name: file}: amarchy's, then the files in
    ~/.config/amarchy/sounds, named after the file. One of yours with the
    name of one of amarchy's replaces it."""
    found = {name: SOUNDS / f"{name}.oga" if (SOUNDS / f"{name}.oga").exists() else SOUNDS / f"{name}.wav"
             for name in CHIMES}
    mine = sorted(f for f in USER_SOUNDS.glob("*") if f.suffix.lower() in AUDIO and f.is_file()) \
        if USER_SOUNDS.is_dir() else []
    for f in mine:
        found.pop(f.stem.lower(), None)
        found[f.stem] = f
    return found


def sound_label(name):
    """How a sound is called in the app: amarchy's capitalized, yours as you named the file."""
    return name.capitalize() if name in CHIMES else name


def sound_key(name, found=None):
    """The name of a sound as sounds() has it, whatever its case; None if there's none."""
    found = sounds() if found is None else found
    return next((n for n in found if n.lower() == name.strip().lower()), None)


def sound_name():
    """The sound picked: its name, "off", or the default when nothing (or a
    file since removed) was picked."""
    picked = SOUND_FILE.read_text().strip() if SOUND_FILE.exists() else ""
    if picked == "off":
        return picked
    return (sound_key(picked) if picked else None) or CHIMES[0]


def assistant_sound_name():
    """Your assistant's chime: its name, "off", or herald."""
    try:
        picked = ASSISTANT_SOUND_FILE.read_text().strip()
    except OSError:
        picked = ""
    if picked == "off":
        return picked
    return (sound_key(picked) if picked else None) or ASSISTANT_CHIME


def sound_file(name):
    found = sounds()
    key = sound_key(name, found) if name != "off" else None
    return found[key] if key else None


def set_sound(name):
    STATE.mkdir(parents=True, exist_ok=True)
    SOUND_FILE.write_text(name + "\n")


def cmd_sound(args):
    """`amarchy sound`: the chime the app plays, printed (or --show). With a
    name, set it; --assistant [name] your assistant's; --list [--json] every
    sound (yours added in the app, or put in ~/.config/amarchy/sounds)."""
    if not args or args[0] == "--show":
        print(sound_name())
        return 0
    if args and args[0] == "--assistant":
        name = " ".join(args[1:])
        if name:
            key = "off" if name.lower() == "off" else sound_key(name)
            if not key:
                return fail(f"no sound {name!r} (see amarchy sound --list)")
            write_file(ASSISTANT_SOUND_FILE, key + "\n")
        print(assistant_sound_name())
        return 0
    if args and args[0] == "--list":
        found = sounds()
        if "--json" in args:
            print(json.dumps({"current": sound_name(), "sounds": [
                {"name": name, "label": sound_label(name), "path": str(path)} for name, path in found.items()]}))
        else:
            for name, path in found.items():
                print(f"{name}\t{path}")
        return 0
    name = " ".join(args)
    if name.lower() == "off":
        set_sound("off")
    else:
        key = sound_key(name)
        if not key:
            return fail(f"no sound {name!r} (see amarchy sound --list)")
        set_sound(key)
    print(sound_name())
    return 0


# ------------------------------------------------------------------ run

def guess_run(path):
    """A project's usual "start the app" command, from what's in the repo."""
    path = Path(path)
    if (path / "bin/dev").exists():
        return "bin/dev"
    if (path / "package.json").exists():
        try:
            scripts = json.loads((path / "package.json").read_text()).get("scripts", {})
        except ValueError:
            scripts = {}
        pm = next((pm for lock, pm in (("bun.lock", "bun"), ("bun.lockb", "bun"), ("pnpm-lock.yaml", "pnpm"),
                                       ("yarn.lock", "yarn")) if (path / lock).exists()), "npm")
        for script in ("dev", "start"):
            if script in scripts:
                return f"{pm} run {script}"
    if (path / "Cargo.toml").exists():
        return "cargo run"
    if (path / "go.mod").exists():
        return "go run ."
    if (path / "manage.py").exists():
        return "python manage.py runserver"
    if (path / "Makefile").exists() and re.search(r"^run:", (path / "Makefile").read_text(errors="ignore"), re.M):
        return "make run"
    return ""


def run_command(s):
    saved = RUN / s["repo"]
    return saved.read_text().strip() if saved.exists() else guess_run(s["path"])


def set_run_command(repo, command):
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / repo).write_text(command.strip() + "\n")


def run_env(s):
    """What a run command can refer to, as $AMARCHY_PATH and so on. One command
    is saved per project, these make it fit each of its sessions."""
    return {"AMARCHY_PATH": s["path"], "AMARCHY_NAME": s["name"], "AMARCHY_REPO": s["repo"],
            "AMARCHY_BRANCH": s["branch"], "AMARCHY_ROOT": str(WORK / s["repo"])}


def session_env(s):
    """The environment of a session's Claude and its terminal: AMARCHY=1 says
    it's amarchy, AMARCHY_SESSION which session (what `amarchy run`, `rename`
    and `close` act on from there), plus what a run command can refer to."""
    return {"AMARCHY": "1", "AMARCHY_SESSION": s["id"], **run_env(s)}


def saved_commands(repo):
    """The project's other saved commands, {name: command}."""
    try:
        return json.loads((RUN / f"{repo}.json").read_text())
    except (OSError, ValueError):
        return {}


def save_command(repo, name, command):
    """Save a named command, or drop it when command is empty."""
    commands = saved_commands(repo)
    if command:
        commands[name] = command.strip()
    else:
        commands.pop(name, None)
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / f"{repo}.json").write_text(json.dumps(commands, indent=2) + "\n")


RUN_DEFAULT = "run"


_tailnet = None
def preview_tls():
    """The name previews are served at over HTTPS, on the tailnet (the one
    its certificate is for: amarchy.tail1234.ts.net), or None where they
    can't be: no Tailscale, no HTTPS certificates on the tailnet, or a host
    whose address was set by hand (BIND= in the host config)."""
    global _tailnet
    if _tailnet is None:
        name, bind = "", host_network()[1]
        own = tailnet_own()     # amarchy's own node: it serves 127.0.0.1's previews, no bind of its own
        if (bind and shutil.which("tailscale")) or own:
            status = tailscale_status()
            me = status.get("Self") or {}
            if status.get("CertDomains") and (own or bind in (me.get("TailscaleIPs") or [])):
                name = (me.get("DNSName") or "").rstrip(".").lower()
        _tailnet = name
    return _tailnet or None


def preview_fronted(url):
    """Whether amarchy serves a preview's address over HTTPS itself
    (https://<this machine's tailnet name>:<port>): tailscale serve has that
    port on the tailnet, and its server listens on 127.0.0.1:<port>."""
    tls = preview_tls()
    try:
        u = urllib.parse.urlsplit(url)
        port = u.port
    except ValueError:
        return False
    return bool(tls) and u.scheme == "https" and (u.hostname or "").lower() == tls and bool(port) and port != app_https()


def preview_local(url):
    """Where on this machine a preview's address lands: (host, port), or None
    for one served elsewhere (a deploy). One amarchy serves over HTTPS lands
    on its server, on 127.0.0.1 (not on tailscale serve, in front of it)."""
    u = urllib.parse.urlsplit(url)
    if preview_fronted(url):
        return ("127.0.0.1", u.port)
    name, bind = host_network()
    here = {"localhost", "127.0.0.1", "::1", "0.0.0.0", name.lower(), socket.gethostname().lower()} | ({bind} if bind else set())
    host = (u.hostname or "").lower()
    if host not in here and host.split(".")[0] != name.lower():
        return None
    try:
        port = u.port or (443 if u.scheme == "https" else 80)
    except ValueError:
        return None
    return (bind if bind and host not in ("localhost", "127.0.0.1", "::1", "0.0.0.0") else "127.0.0.1", port)


def preview_direct(url):
    """A preview's address by this machine's number address (http://100.x.y.z:port)
    when it's served here under the machine's name, else None. A Mac's Dock
    app keeps a link to a name like the app's own in a window of the app; one
    to a number address it gives to the default browser. (What the app does
    when links_out isn't there to send the link on.)"""
    try:
        u = urllib.parse.urlsplit(url)
        where = preview_local(url)
    except ValueError:
        return None
    bind = host_network()[1]
    if not where or not bind or where[0] != bind or u.scheme != "http":
        return None
    return urllib.parse.urlunsplit((u.scheme, f"{bind}:{where[1]}", u.path, u.query, u.fragment))


_preview_up = {}
def preview_up(url):
    """Whether a chat's preview answers: its port on this machine takes a
    connection (at once when nothing listens). One served elsewhere isn't
    tried: taken to be up."""
    where = preview_local(url)
    if not where:
        return True
    known = _preview_up.get(where)
    if known and time.time() - known[0] < 2:       # (the list is read every second or so)
        return known[1]
    try:
        socket.create_connection(where, timeout=0.15).close()
        up = True
    except OSError:
        up = False
    _preview_up[where] = (time.time(), up)
    return up


# ---- a chat's previews: what it serves for you to look at
#
# A preview is the chat's, not its Claude's: Claude registers it once
# (`amarchy preview --run '<command>' <url>`), with the ports it takes (the
# URL's, an HMR port) and maybe a command that tears it down (`--stop`), and
# amarchy runs it as a systemd user service of its own, amarchy-preview-<id>:
# outside the chat's panes, so it outlives its Claude's sleep (left_running
# stops what Claude left serving, never this); capped (PREVIEW_MEMORY, and
# among the first the kernel kills when memory runs out, before a chat); its
# output in a log Claude can read (`amarchy preview log`). Its Preview button
# starts it when it isn't running, no message to Claude. It stops when nobody
# had its page open for PREVIEW_IDLE while its chat sat idle (preview_tend),
# and when the chat closes: Complete stops it, runs its stop command, and
# checks every one of its ports is free before the chat goes (preview_close).
#
# A chat can have several (an app and its admin, a storybook beside it):
# each has a name (`--name API`), its own service, ports, record and log, and
# the button is Previews, a dropdown of them. Each keeps the key it was
# made with (its name's, or "" for the chat's first one with no name: the one
# a chat had before there could be several), so a new name changes nothing
# that runs. Without --name a command is about the only one, or all of them.
#
# On a tailnet with HTTPS (the app's own way in), a preview is served over
# HTTPS too: https://<this machine>.<tailnet>.ts.net:<port>, its server on
# 127.0.0.1:<port>. While it runs, tailscale serve has each of its ports (the
# URL's, each --port: an HMR websocket's) on the tailnet at the same number,
# sending it on to 127.0.0.1 (preview_front; off again when it stops,
# preview_unfront). That's HTTP/2: a dev server's page is hundreds of files,
# which plain http fetches six at a time, each a round trip away from a phone
# (16 s for Houston's, 148 ms away; 3 s this way). Same numbers, so a page's
# own links to its other ports (its live reload) work as they are; and its
# server can't take those ports on every address (0.0.0.0) or the tailnet's:
# tailscale serve has them there. One at http://<this machine>:<port> (its
# server on the tailnet address) is from before, and works as it did.
#
# A preview served elsewhere (a deploy) is an address only: `amarchy preview
# <url>`. One registered before (an address, no command) answers nothing: its
# button asks its Claude to start it, and register it.

PREVIEW_MEMORY = "2G"           # its memory at most (`--memory`): over it, its own processes are killed, nothing else
PREVIEW_IDLE = 3 * 3600         # seconds unused before it stops (`--idle`): no page open, its chat idle
PREVIEW_WAIT = 90               # seconds `amarchy preview --run` / `start` waits for it to answer
PREVIEW_STOP_WAIT = 45          # seconds its stop command gets
PREVIEW_NAME = 40               # a preview's name, at most (it's a line in a dropdown)
PREVIEWS = STATE / "previews"   # per preview: <slot>.json (when it started, was last used, why it stopped), <slot>.log
                                # (not STATE/preview: the desktop's old file of that name, migrate takes it away)
PREVIEW_VIEW = ("label", "state")       # what the list adds to each of a chat's previews, never saved


def preview_key(name):
    """What a name comes to as a preview's key, what its service is named by:
    App, app and APP are one, Página is pagina; one in letters a unit can't
    have (ドキュメント) is known by its hash."""
    name = re.sub(r"\s+", " ", name or "").strip()
    plain = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode().lower()
    key = re.sub(r"[^a-z0-9]+", "-", plain).strip("-")[:PREVIEW_NAME]
    return key or (f"p{hashlib.sha1(name.lower().encode()).hexdigest()[:8]}" if name else "")


def previews(s):
    """A chat's previews, in the order they came: [{key, name?, url, run?,
    stop?, ports?, memory?, idle?}]. (A chat from before there could be
    several has its one as "preview".)"""
    got = s.get("previews")
    if not isinstance(got, list):
        got = [s["preview"]] if isinstance(s.get("preview"), dict) else []
    return [{**{k: v for k, v in p.items() if k not in PREVIEW_VIEW}, "key": p.get("key") or ""}
            for p in got if isinstance(p, dict) and p.get("url")]


def preview_stored(p):
    """A preview as it's saved: without what the list adds, nor the first's
    key ("")."""
    return {k: v for k, v in p.items() if k not in PREVIEW_VIEW and not (k == "key" and not v)}


def preview_save(s, ps):
    """A chat's previews, saved (as "previews", whatever it had before)."""
    s.pop("preview", None)
    s["previews"] = [preview_stored(p) for p in ps]
    if not s["previews"]:
        s.pop("previews")
    save_session(s)


def preview_label(p):
    """What a preview is called (its dropdown, what amarchy says): its name,
    else its address without http:// (amarchy:5180/app)."""
    if p.get("name"):
        return p["name"]
    u = urllib.parse.urlsplit(p.get("url") or "")
    if preview_fronted(p.get("url") or ""):       # amarchy:5180, not amarchy.tail1234.ts.net:5180
        return f"{u.hostname.split('.')[0]}:{u.port}{u.path}".rstrip("/")
    return (u.netloc + u.path).rstrip("/") or p.get("url") or "Preview"


def preview_named(ps, name):
    """The one of a chat's previews by that name, or None."""
    key = preview_key(name)
    return next((p for p in ps if key and preview_key(p.get("name")) == key), None)


def preview_names(ps):
    return ", ".join(preview_label(p) for p in ps)


def preview_slot(sid, key=""):
    """What a chat's preview's service, record and log are named by: the
    chat's id (its first one's), and its key after it for one more."""
    return f"{sid}--{key}" if key else sid


def preview_unit(slot):
    return f"amarchy-preview-{re.sub(r'[^A-Za-z0-9_.-]', '_', slot)}.service"


_app_slice = []
def preview_cgroup(slot):
    """Where a preview's service runs: its cgroup (the user manager's
    app.slice, where systemd-run --user puts it)."""
    if not _app_slice:
        uid = os.getuid()
        base = Path(f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/app.slice")
        if not base.is_dir():
            got = sh("systemctl", "--user", "show", "-p", "ControlGroup", "--value", "app.slice").stdout.strip()
            base = Path("/sys/fs/cgroup" + got) if got else base
        _app_slice.append(base)
    return _app_slice[0] / preview_unit(slot)


def preview_pids(slot):
    return scope_pids(preview_cgroup(slot))


def chat_preview_pids(s):
    """What every one of a chat's previews runs: its services' processes."""
    out = set()
    for p in previews(s):
        if p.get("run"):
            out |= preview_pids(preview_slot(s["id"], p["key"]))
    return out


def preview_failed(slot):
    """Whether its service ended on its own, in error: systemd keeps a failed
    transient unit (its file) until it's reset; one stopped cleanly is gone."""
    return (Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "systemd/transient"
            / preview_unit(slot)).exists()


def preview_record(slot):
    try:
        d = json.loads((PREVIEWS / f"{slot}.json").read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def preview_note(slot, **changes):
    d = {**preview_record(slot), **changes}
    write_file(PREVIEWS / f"{slot}.json", json.dumps({k: v for k, v in d.items() if v is not None}))


def preview_log(slot, lines=40):
    """The last lines its service wrote (what it said, its errors)."""
    try:
        with open(PREVIEWS / f"{slot}.log", "rb") as f:
            f.seek(0, 2)
            f.seek(max(f.tell() - 64_000, 0))
            text = f.read().decode(errors="replace")
    except OSError:
        return ""
    text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07|\r(?!\n)", "", text)
    return mask_secrets("\n".join(text.splitlines()[-lines:]))


def preview_ports(p):
    """The ports a chat's preview takes on this machine: its address's (when
    it's here) and the ones registered with it (an HMR port)."""
    where = preview_local(p.get("url") or "")
    return sorted({*(p.get("ports") or []), *([where[1]] if where else [])})


# ---- a preview over HTTPS: tailscale serve in front of it (see above)

def serve_target(port):
    """Where tailscale serve sends a preview's port: its server, on localhost."""
    return f"http://127.0.0.1:{port}"


_serve_web = [0.0, {}]
def serve_web(fresh=False):
    """What tailscale serve does with each port it has on the tailnet:
    {port: where it sends it} (http://127.0.0.1:<port> for a preview's, the
    app's own for its port). Read again after 2 s, or fresh."""
    if not fresh and time.time() - _serve_web[0] < 2:
        return _serve_web[1]
    try:
        conf = json.loads(sh("tailscale", "serve", "status", "--json").stdout or "{}")
    except ValueError:
        conf = {}
    out = {}
    for port, tcp in (conf.get("TCP") or {}).items():
        if str(port).isdigit():
            out[int(port)] = f"tcp {tcp['TCPForward']}" if isinstance(tcp, dict) and tcp.get("TCPForward") else "something else"
    for hostport, web in (conf.get("Web") or {}).items():
        port = hostport.rsplit(":", 1)[-1]
        if port.isdigit():
            handlers = (web or {}).get("Handlers") or {}
            out[int(port)] = (handlers.get("/") or {}).get("Proxy") or ("something else" if handlers else out.get(int(port), "something else"))
    _serve_web[:] = [time.time(), out]
    return out


@contextlib.contextmanager
def serve_lock():
    """One change to tailscale serve's settings at a time, on this machine
    (it reads them all, changes one, writes them all back)."""
    PREVIEWS.mkdir(parents=True, exist_ok=True)
    with open(PREVIEWS / "serve.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            yield
        finally:
            _serve_web[0] = 0.0
            fcntl.flock(lock, fcntl.LOCK_UN)


def front_socket(x, web=None):
    """Whether something listening on a port (listeners) is tailscale serve
    in front of a preview's server: tailscaled, on this machine's tailnet
    address, sending it on to 127.0.0.1 at that port."""
    if loopback(x["local"]) or set(x["local"]) == {"0"}:
        return False
    if x["pid"] is None:
        if x["uid"] != 0:
            return False
    elif "tailscaled" not in os.path.basename((cmdline(x["pid"]) or [""])[0]):
        return False
    return (serve_web() if web is None else web).get(x["port"]) == serve_target(x["port"])


def serve_claims(but=None):
    """Which preview has each port tailscale serve has for one, of the ones
    running: {port: slot} (but that one)."""
    out = {}
    for f in PREVIEWS.glob("*.json") if PREVIEWS.is_dir() else []:
        if f.stem == but:
            continue
        ports = preview_record(f.stem).get("fronted") or []
        if ports and preview_pids(f.stem):
            out.update({n: f.stem for n in ports})
    return out


def serve_why(r):
    """Why a tailscale serve change didn't take, in words."""
    said = (r.stderr or r.stdout or "").strip()
    if "access denied" in said.lower():
        return "Tailscale won't let amarchy change what it serves: run `sudo tailscale set --operator=$USER` once"
    return gist(said) or "tailscale serve failed"


def preview_front(s, p):
    """Put a preview's ports on the tailnet over HTTPS (one amarchy serves
    that way, preview_fronted): tailscale serve has each at its own number,
    sending it on to 127.0.0.1. Kept in its record (fronted), to take off
    again. None, or why not."""
    if not preview_fronted(p.get("url") or ""):
        return None
    slot = preview_slot(s["id"], p["key"])
    ports = preview_ports(p)
    if app_https() in ports:
        return f"port {app_https()} is amarchy's own on your tailnet: give it another"
    with serve_lock():
        web = serve_web(fresh=True)
        taken = [f"port {n} to {web[n]}" for n in ports if n in web and web[n] != serve_target(n)]
        if taken:
            return f"tailscale serve already sends {'; '.join(taken)}: give it other ports"
        done = set(preview_record(slot).get("fronted") or [])
        why = None
        for n in ports:
            if web.get(n) != serve_target(n):
                r = sh("tailscale", "serve", "--bg", f"--https={n}", serve_target(n))
                if r.returncode != 0:
                    why = f"couldn't put port {n} on your tailnet over HTTPS: {serve_why(r)}"
                    break
            done.add(n)
        preview_note(slot, fronted=sorted(done), fronted_at=time.time())
    if why:
        preview_unfront(slot)
    return why


def preview_unfront(slot):
    """Take a preview's ports off the tailnet (what preview_front put there),
    but the ones another preview running has now."""
    ports = set(preview_record(slot).get("fronted") or [])
    if not ports:
        return
    claimed = serve_claims(but=slot)
    with serve_lock():
        web = serve_web(fresh=True)
        for n in sorted(ports):
            if n not in claimed and web.get(n) == serve_target(n):
                sh("tailscale", "serve", f"--https={n}", "off")
        preview_note(slot, fronted=[])
    _preview_up.clear()


def preview_loose(p):
    """What listens on one of a preview amarchy serves over HTTPS's ports on
    more than 127.0.0.1 (on 0.0.0.0, or the tailnet's address): where
    tailscale serve can't have it. [words]."""
    if not preview_fronted(p.get("url") or ""):
        return []
    web = serve_web()
    return [holder_words(x) + f" on {address_words(x['local'])}" for x in listeners(preview_ports(p))
            if not loopback(x["local"]) and not front_socket(x, web)]


def address_words(hexed):
    """An address as /proc/net/tcp writes it, as people do: 0.0.0.0, 100.89.29.4, ::."""
    try:
        raw = bytes.fromhex(hexed)
        if len(raw) == 4:
            return socket.inet_ntop(socket.AF_INET, raw[::-1])
        return socket.inet_ntop(socket.AF_INET6, b"".join(raw[i:i + 4][::-1] for i in range(0, 16, 4)))
    except (ValueError, OSError):
        return hexed


PREVIEW_IN_USE = re.compile(r"EADDRINUSE|address already in use|port \d+ is already in use", re.I)


def preview_state(s, p):
    """Where one of a chat's previews stands: up (it answers), starting (its
    service runs, nothing answers yet), failed (its service ended in error),
    stopped (registered, not running), or down (an address only, nothing
    answering)."""
    if preview_up(p["url"]):
        return "up"
    if not p.get("run"):
        return "down"
    slot = preview_slot(s["id"], p["key"])
    if preview_pids(slot):
        return "starting"
    return "failed" if preview_failed(slot) else "stopped"


def preview_shown(s):
    """A chat's previews as the list has them: each with what it's called and
    where it stands."""
    return [{**p, "label": preview_label(p), "state": preview_state(s, p)} for p in previews(s)]


def listeners(ports):
    """What listens on these TCP ports: [{port, pid (None when it isn't
    yours to see: root's docker-proxy, say), uid, local}]."""
    ports = set(ports)
    found = []
    for name in ("tcp", "tcp6"):
        try:
            lines = Path(f"/proc/net/{name}").read_text().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            f = line.split()
            if len(f) < 10 or f[3] != "0A":
                continue
            la, lp = f[1].split(":")
            if int(lp, 16) in ports:
                found.append({"port": int(lp, 16), "inode": f[9], "uid": int(f[7]), "local": la, "pid": None})
    if not found:
        return []
    want = {x["inode"] for x in found}
    owner = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            for fd in os.listdir(f"/proc/{d}/fd"):
                try:
                    link = os.readlink(f"/proc/{d}/fd/{fd}")
                except OSError:
                    continue
                if link.startswith("socket:[") and link[8:-1] in want:
                    owner.setdefault(link[8:-1], int(d))
        except OSError:
            continue
    out, seen = [], set()
    for x in found:
        x["pid"] = owner.get(x["inode"])
        key = (x["port"], x["pid"])
        if key not in seen:
            seen.add(key)
            out.append({k: x[k] for k in ("port", "pid", "uid", "local")})
    return out


def holder_words(x):
    """What holds a port, in words: `node …/vite --port 5180` (pid 123)."""
    if front_socket(x):
        claimed = serve_claims().get(x["port"])
        rec = preview_record(claimed) if claimed else {}
        whose = f" of chat {rec['sid']}'s preview" if rec.get("sid") else ""
        return f"port {x['port']}: tailscale serve (HTTPS{whose}, for a server on 127.0.0.1:{x['port']})"
    if x["pid"] is None:
        try:
            import pwd
            who = pwd.getpwuid(x["uid"]).pw_name
        except (KeyError, ImportError):
            who = str(x["uid"])
        return f"port {x['port']}: a process of {who}'s (docker?)"
    line = " ".join(a for a in cmdline(x["pid"]) if a)[:90] or "a process"
    return f"port {x['port']}: {line} (pid {x['pid']})"


def holder_preview(pid):
    """The preview a process is of, by its service: (chat id, its preview),
    or None."""
    try:
        cg = Path(f"/proc/{pid}/cgroup").read_text()
    except OSError:
        return None
    m = re.search(r"/(amarchy-preview-[^/]+\.service)$", cg.strip(), re.M)
    if not m:
        return None
    for s in sessions():
        for p in previews(s):
            if preview_unit(preview_slot(s["id"], p["key"])) == m.group(1):
                return s["id"], p
    return None


def holder_session(pid, procs=None):
    """The chat a process is of, by where it runs (its worktree) or its
    preview service: its id, or None."""
    of = holder_preview(pid)
    if of:
        return of[0]
    for s in sessions():
        if in_tree(s["path"], [pid]):
            return s["id"]
    return None


def preview_strays(s, holders, procs=None):
    """Of what holds a preview's ports, what is this chat's own (a server its
    Claude started before, in its worktree or its panes): the pids. Its
    previews' services' aren't strays (one of its others is a preview too)."""
    procs = procs or processes()
    own = chat_preview_pids(s)
    mine = left_running(s, procs) | in_tree(s["path"], procs)
    return {x["pid"] for x in holders if x["pid"] and x["pid"] not in own and x["pid"] in mine}


def preview_exec_env(s, p):
    env = clean_env()
    env.update(session_env(s))
    env.update(secret_env(s))
    rec = preview_record(preview_slot(s["id"], p["key"]))
    if rec.get("path"):
        env["PATH"] = rec["path"]       # the PATH of whoever registered it (Claude's: mise's, nvm's tools)
    name, bind = host_network()
    env.update(AMARCHY_PREVIEW_URL=p.get("url", ""), AMARCHY_PREVIEW_NAME=p.get("name") or "",
               AMARCHY_BIND=bind or "127.0.0.1")
    return env


def cmd_preview_exec(args):
    """What a chat's preview service runs (plumbing): `preview-exec <chat>
    [<key>] [--stop]`, its command, in its worktree, with the session's
    environment and the project's secrets (not in the unit, where systemctl
    would show them); `--stop` its stop command instead."""
    s = session(args[0]) if args else None
    key = next((a for a in args[1:] if not a.startswith("--")), "")
    p = next((x for x in previews(s) if x["key"] == key), None) if s else None
    command = (p or {}).get("stop") if "--stop" in args[1:] else (p or {}).get("run")
    if not s or not command:
        return fail("no such preview")
    os.chdir(s["path"])
    os.execve("/bin/bash", ["bash", "-lc", command], preview_exec_env(s, p))


def cmd_previews_off(args):
    """Every chat's preview stopped, and off the tailnet (plumbing: install.sh
    --uninstall, since nothing would look after them once amarchy is gone)."""
    for s in sessions():
        for p in previews(s):
            if p.get("run") or p.get("ports"):
                preview_stop(s, p, why="stopped")
    for rec in PREVIEWS.glob("*.json") if PREVIEWS.is_dir() else []:    # (a chat's gone, a test's)
        if preview_pids(rec.stem):
            sh("systemctl", "--user", "stop", preview_unit(rec.stem))
        preview_unfront(rec.stem)
    return 0


_preview_starting = threading.Lock()     # the app's server: two taps (the button, its sheet) start it once


def preview_start(s, p, restart=False, wait=0, say=None):
    """Start one of a chat's previews (again, with restart). Its ports first:
    a server of the chat's own on one (started the old way) is stopped, one
    of anyone else's (another of its previews too) refuses it. With wait, it
    waits that many seconds for it to answer. Returns None, or why it didn't
    start (or isn't answering)."""
    with _preview_starting:
        why = preview_launch(s, p, restart, say or (lambda text: None))
    if why or not wait:
        return why
    return preview_wait(s, p, wait, say or (lambda text: None))


def preview_launch(s, p, restart, say):
    sid = s["id"]
    slot = preview_slot(sid, p["key"])
    if not p.get("run"):
        return "it has no command to start it with (amarchy preview --run '<command>' <url>)"
    if s.get("setup") or not Path(s["path"]).is_dir():
        return "its worktree isn't there"
    unit = preview_unit(slot)
    if preview_pids(slot):
        if not restart:
            return preview_front(s, p)      # (on the tailnet still: put back, if it was taken off)
        sh("systemctl", "--user", "stop", unit)
    holders = preview_holders(s, p)
    strays = preview_strays(s, holders)
    if strays:
        say(f"Stopping what this chat left on its ports: " + "; ".join(holder_words(x) for x in holders if x["pid"] in strays))
        stop_processes(strays)
        holders = [x for x in preview_holders(s, p) if x["pid"] not in strays]
    own = preview_pids(slot)
    taken = [x for x in holders if x["pid"] not in own]
    if taken:
        words = []
        for x in taken:
            of = holder_preview(x["pid"]) if x["pid"] else None
            other = of[0] if of else (holder_session(x["pid"]) if x["pid"] else None)
            if of and of[0] == sid:
                words.append(holder_words(x) + f", its preview {preview_label(of[1])}")
            else:
                words.append(holder_words(x) + (f", chat {other}" if other and other != sid else ""))
        return "its ports are taken: " + "; ".join(words)
    sh("systemctl", "--user", "reset-failed", unit)
    PREVIEWS.mkdir(parents=True, exist_ok=True)
    # On the tailnet over HTTPS before it starts: it answers there the
    # moment it answers at all (and can't take those ports on 0.0.0.0).
    why = preview_front(s, p)
    if why:
        return why
    log = PREVIEWS / f"{slot}.log"
    log.write_text("")
    memory = p.get("memory") or PREVIEW_MEMORY
    r = sh("systemd-run", "--user", "--quiet", f"--unit={unit}",
           f"--description=Preview of {sid}{f' ({preview_label(p)})' if p['key'] else ''} (amarchy)",
           "-p", f"MemoryMax={memory}", "-p", "MemorySwapMax=256M", "-p", "OOMScoreAdjust=500",
           "-p", "KillMode=control-group", "-p", "TimeoutStopSec=10", "-p", f"WorkingDirectory={s['path']}",
           "-p", f"StandardOutput=append:{log}", "-p", f"StandardError=append:{log}",
           "--setenv=AMARCHY=1", f"--setenv=AMARCHY_SESSION={sid}",
           # amarchy's state where this amarchy has it (preview-exec reads the session there)
           *[f"--setenv={k}={os.environ[k]}" for k in ("HOME", "XDG_STATE_HOME", "XDG_CONFIG_HOME", "AMARCHY_WORK") if os.environ.get(k)],
           ENTRY, "preview-exec", sid, *([p["key"]] if p["key"] else []))
    if r.returncode != 0:
        if preview_pids(slot):
            return None
        preview_unfront(slot)
        return f"systemd couldn't start it: {last_line(r, 'systemd-run failed')}"
    now = time.time()
    preview_note(slot, sid=sid, key=p["key"], started=now, used=now, stopped=None, why=None)
    _preview_up.clear()
    return None


def preview_holders(s, p):
    """What listens on a preview's ports, before it starts (listeners), but
    tailscale serve in front of one of them for no other preview running
    now: kept for an HTTPS one (it's what it would put there), taken off
    the tailnet for one from before (its server takes that address)."""
    ports = preview_ports(p)
    holders = listeners(ports)
    web = serve_web()
    claimed = serve_claims(but=preview_slot(s["id"], p["key"]))
    spare = {x["port"] for x in holders if front_socket(x, web) and x["port"] not in claimed}
    if not spare:
        return holders
    if not preview_fronted(p.get("url") or ""):
        with serve_lock():
            for n in sorted(spare):
                sh("tailscale", "serve", f"--https={n}", "off")
        end = time.time() + 3
        while time.time() < end and any(front_socket(x, web) for x in listeners(sorted(spare))):
            time.sleep(0.1)
    return [x for x in holders if not (x["port"] in spare and front_socket(x, web))]


def preview_wait(s, p, wait, say):
    """Wait for a preview to answer: None once it does, else why not. One
    over HTTPS has to listen on 127.0.0.1 only (tailscale serve has its ports
    on the tailnet): said when it doesn't, or its log says a port was taken."""
    slot = preview_slot(s["id"], p["key"])
    fronted = preview_fronted(p["url"])
    where = preview_local(p["url"])
    only = (f"amarchy serves {', '.join(map(str, preview_ports(p)))} on your tailnet over HTTPS, so its server "
            f"must listen on 127.0.0.1 only (--host 127.0.0.1), not on 0.0.0.0 or {host_network()[1]}: its live "
            f"reload too (a websocket on a port of its own binds 0.0.0.0 unless told; best, have it ride on the "
            f"main port: Vite's server.ws.server, hmr.server before Vite 8)") if fronted else ""
    end = time.time() + wait
    while time.time() < end:
        _preview_up.clear()
        if preview_up(p["url"]):
            loose = preview_loose(p)
            if loose:
                return f"it listens on more than 127.0.0.1 ({'; '.join(loose)}): {only}"
            if fronted and PREVIEW_IN_USE.search(preview_log(slot, 200)):
                say(f"It answers, but its log says a port was in use: {only}.")
            return None
        if not preview_pids(slot):
            time.sleep(0.3)
            if not preview_pids(slot):
                taken = fronted and PREVIEW_IN_USE.search(preview_log(slot, 200))
                return "it stopped on its own" + (f": a port it wanted was in use ({only})" if taken else "")
        time.sleep(0.5)
    if fronted:
        loose = preview_loose(p)
        if loose:
            return f"it listens on more than 127.0.0.1 ({'; '.join(loose)}): {only}"
        if any(x["local"] == "0" * 24 + "01000000" for x in listeners([where[1]])):
            return (f"it listens on ::1 only (localhost, as Node may take it): make it listen on 127.0.0.1 "
                    f"(--host 127.0.0.1), where amarchy sends it from {p['url']}")
        return f"nothing answers on 127.0.0.1:{where[1]} after {wait} s: {only}"
    loose = [x for x in listeners([where[1]]) if where] if where else []
    if loose and where and where[0] != "127.0.0.1" and all(loopback(x["local"]) for x in loose):
        tls = preview_tls()
        if tls:
            return (f"it listens on localhost only: register it as https://{tls}:{where[1]} instead, and amarchy "
                    f"serves it on your tailnet over HTTPS (or make it listen on {where[0]})")
        return f"it listens on localhost only: make it listen on {where[0]} (--host {where[0]})"
    return f"nothing answers at {p['url']} after {wait} s"


def preview_leftovers(s, p, wait=5):
    """What's left of a chat's preview after it stopped: its service's
    processes, and what still listens on its ports (but another chat's, or
    another of its previews). Waits that long for it to go. [words]."""
    sid = s["id"]
    slot = preview_slot(sid, p["key"])
    others = {x for q in previews(s) if q["key"] != p["key"] and q.get("run") for x in preview_pids(preview_slot(sid, q["key"]))}
    named = f" ({preview_label(p)})" if len(previews(s)) > 1 else ""
    end = time.time() + wait
    while True:
        n = len(preview_pids(slot))
        left = [f"its preview service{named}: {n} process{'es' if n != 1 else ''}"] if n else []
        for x in listeners(preview_ports(p)):
            if x["pid"] in others or front_socket(x):       # (tailscale serve's: another preview's now, or going)
                continue
            other = holder_session(x["pid"]) if x["pid"] else None
            if not other or other == sid:
                left.append(holder_words(x))
        if not left or time.time() >= end:
            return left
        time.sleep(0.3)


def preview_stop(s, p, teardown=True, why="stopped"):
    """Stop one of a chat's previews: its stop command (with teardown), its
    service, and then what of the chat's own still holds its ports. What's
    left of it after that (preview_leftovers): [words], empty when it's all
    gone."""
    sid = s["id"]
    slot = preview_slot(sid, p["key"])
    unit = preview_unit(slot)
    if teardown and p.get("stop") and Path(s["path"]).is_dir():
        try:
            with open(PREVIEWS / f"{slot}.log", "a") as log:
                log.write(f"\n$ {p['stop']}\n")
                log.flush()
                subprocess.run([ENTRY, "preview-exec", sid, *([p["key"]] if p["key"] else []), "--stop"],
                               stdin=subprocess.DEVNULL, stdout=log, stderr=log, timeout=PREVIEW_STOP_WAIT, cwd=s["path"])
        except (OSError, subprocess.TimeoutExpired):
            pass
    if p.get("run"):
        sh("systemctl", "--user", "stop", unit)
        sh("systemctl", "--user", "reset-failed", unit)
        preview_note(slot, stopped=time.time(), why=why)
    preview_unfront(slot)       # off the tailnet with it (what it had there, whatever its address is now)
    strays = preview_strays(s, listeners(preview_ports(p)))
    if strays:
        stop_processes(strays)
    _preview_up.clear()
    return preview_leftovers(s, p) if p.get("run") or p.get("ports") else []


def preview_close(s):
    """Before a chat closes: every one of its previews stopped, and nothing
    of them left (their services, their ports). [words] of what's still there."""
    left = []
    for p in previews(s):
        if p.get("run") or p.get("ports"):
            left += preview_stop(s, p, why="closed")
    return left


def preview_info(s, p, lines=40):
    """One of a chat's previews, whole, for the app (its sheet, Details) and
    `amarchy preview status`."""
    slot = preview_slot(s["id"], p["key"])
    rec = preview_record(slot)
    out = {"key": p["key"], "name": p.get("name") or "", "label": preview_label(p), "url": p["url"],
           "run": p.get("run") or "", "stop": p.get("stop") or "", "ports": preview_ports(p),
           "memory_max": p.get("memory") or PREVIEW_MEMORY, "idle": p.get("idle") or PREVIEW_IDLE, "state": preview_state(s, p)}
    direct = links_out(p["url"]) or preview_direct(p["url"])
    if direct:
        out["direct"] = direct
    if p.get("run"):
        pids = preview_pids(slot)
        if pids:
            try:
                out["memory"] = int((preview_cgroup(slot) / "memory.current").read_text())
            except (OSError, ValueError):
                pass
            out["since"] = rec.get("started")
            out["used"] = rec.get("used")
        else:
            out["stopped"], out["why"] = rec.get("stopped"), rec.get("why")
        out["log"] = preview_log(slot, lines)
    return out


def preview_pick(s, key=None):
    """One of a chat's previews by its key (the app's), the first with none
    given; None when there's no such one."""
    ps = previews(s)
    if key is None:
        return ps[0] if ps else None
    return next((p for p in ps if p["key"] == key), None)


def preview_running():
    """Every chat's preview running now, for Automations: [info + id, task]."""
    out = []
    for s in sessions():
        for p in previews(s):
            if p.get("run") and preview_pids(preview_slot(s["id"], p["key"])):
                info = preview_info(s, p, lines=0)
                info.pop("log", None)
                out.append({"id": s["id"], "task": s.get("title") or s["name"], "repo": s["repo"], **info})
    return out


def preview_tend():
    """The sleep timer's (every 30 s): a preview nobody used for its idle
    time stops (used: its page open, its chat open on a device or at work);
    one whose chat is gone (closed while amarchy wasn't looking), or that its
    chat has no more, too."""
    shown, _ = on_screen()
    known = set()
    for s in sessions():
        for p in previews(s):
            slot = preview_slot(s["id"], p["key"])
            known.add(slot)
            pids = preview_pids(slot) if p.get("run") else set()
            rec, now = preview_record(slot), time.time()
            if not pids:
                # Not running (it failed, the machine restarted): off the
                # tailnet too, but while it's being put there to start.
                if rec.get("fronted") and now - (rec.get("fronted_at") or 0) > 60:
                    preview_unfront(slot)
                continue
            if watched(pids) or s["id"] in shown or s.get("status") in ("working", "waiting", "running"):
                if now - (rec.get("used") or 0) > 60:
                    preview_note(slot, used=now)
                continue
            if now - (rec.get("used") or rec.get("started") or now) >= (p.get("idle") or PREVIEW_IDLE):
                preview_stop(s, p, why="idle")
    # A chat gone (closed while amarchy wasn't looking, a close cut off), or
    # a preview it no longer has: it goes too. Only the ones this amarchy
    # started (its record of each): never another's, as a test's with a
    # state of its own.
    for rec in PREVIEWS.glob("*.json") if PREVIEWS.is_dir() else []:
        slot = rec.stem
        if slot in known or (CLOSING / f"{preview_record(slot).get('sid') or slot}.json").exists():
            continue
        if preview_pids(slot) or preview_failed(slot):
            sh("systemctl", "--user", "stop", preview_unit(slot))
            sh("systemctl", "--user", "reset-failed", preview_unit(slot))
        preview_unfront(slot)
        rec.unlink(missing_ok=True)
        (PREVIEWS / f"{slot}.log").unlink(missing_ok=True)
    chats = {re.sub(r"[^A-Za-z0-9_.-]", "_", s["id"]) for s in sessions()}
    for lock in PREVIEWS.glob(".*.lock") if PREVIEWS.is_dir() else []:      # (cmd_preview's, of a chat gone)
        sid = lock.name[1:-5]
        if sid not in chats and not (CLOSING / f"{sid}.json").exists():
            lock.unlink(missing_ok=True)


def duration(text):
    """'3h', '90m', '45s', '2d' or seconds: seconds, or None."""
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([smhd]?)\s*", str(text))
    if not m:
        return None
    return int(float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)])


def preview_name_given(text):
    """A name for a preview as given (--name, --rename): its spaces tidied,
    at most PREVIEW_NAME long; None when there's nothing in it to know it by."""
    name = re.sub(r"\s+", " ", text or "").strip()[:PREVIEW_NAME]
    return name if preview_key(name) else None


def cmd_preview(args):
    """A session's live previews: addresses the app keeps a button for (a
    dropdown, with several), and the commands that serve them, run by
    amarchy (see above)."""
    args = list(args)
    opts, ports = {}, []
    for name in ("--id", "--run", "--stop", "--url", "--memory", "--idle", "--lines", "--name", "--rename"):
        while name in args:
            i = args.index(name)
            if i + 1 >= len(args):
                return fail(f"{name} needs a value\n{usage('preview')}")
            opts[name] = args[i + 1]
            del args[i:i + 2]
    while "--port" in args:
        i = args.index("--port")
        value = args[i + 1] if i + 1 < len(args) else ""
        if not value.isdigit() or not 0 < int(value) < 65536:
            return fail(f"--port takes a port number, not {value!r}")
        ports.append(int(value))
        del args[i:i + 2]
    flags = {a for a in args if a.startswith("--")}
    args = [a for a in args if not a.startswith("--")]
    sid = opts.get("--id") or own_session_id()
    if not sid or not session(sid):
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one with --id <id>)")
    # One at a time for a chat: two registered at once (Claude's commands
    # side by side) each keep theirs. Let go of before what waits (a start).
    PREVIEWS.mkdir(parents=True, exist_ok=True)
    with open(PREVIEWS / f".{re.sub(r'[^A-Za-z0-9_.-]', '_', sid)}.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return preview_command(sid, opts, ports, flags, args, lambda: fcntl.flock(lock, fcntl.LOCK_UN))


def preview_command(sid, opts, ports, flags, args, unlock):
    """cmd_preview, its chat's previews to itself (unlock: let them go)."""
    s = session(sid)
    if not s:
        return fail(f"No session {sid!r}")
    ps = previews(s)
    named = "--name" in opts
    name = preview_name_given(opts.get("--name"))
    if named and not name:
        return fail("--name takes a name to know it by, like App, API or Storybook")
    one = preview_named(ps, name) if named else None
    some = f": it has {preview_names(ps)}" if ps else ""
    if "--rename" in opts:
        # A new name, nothing else: what runs goes on running.
        new = preview_name_given(opts["--rename"])
        if not new:
            return fail("--rename takes a name to know it by, like App, API or Storybook")
        target = one if named else (next((p for p in ps if not p.get("name")), None) or (ps[0] if len(ps) == 1 else None))
        if not target:
            return fail(f"This chat has no preview named {name}{some}" if named else
                        "This chat has no preview" if not ps else f"Which one? Say it with --name{some}")
        clash = preview_named([p for p in ps if p is not target], new)
        if clash:
            return fail(f"It has a preview named {preview_label(clash)} already")
        target["name"] = new
        preview_save(s, ps)
        print(f"Its preview at {target['url']} is {new} now")
        return 0
    if named and not one and (flags & {"--clear"} or (args and args[0] in ("start", "restart", "stop", "log", "status"))):
        return fail(f"This chat has no preview named {name}{some}")
    which = [one] if one else ps      # what --clear and the actions are about
    if "--clear" in flags:
        left = []
        for p in which:
            left += preview_stop(s, p, why="cleared")
        preview_save(s, [p for p in ps if p not in which])
        if left:
            print("Forgotten, but still there: " + "; ".join(left))
        return 0
    action = args[0] if args and args[0] in ("start", "restart", "stop", "log", "status") else None
    if action:
        unlock()        # (nothing it does is saved with the chat)
        if not ps:
            return fail("This chat has no preview: amarchy preview --run '<command>' <url>")
        several = len(which) > 1
        if action == "status":
            infos = [preview_info(s, p) for p in which]
            print(json.dumps(infos if several else infos[0], indent=2))
            return 0
        if action == "log":
            n = opts.get("--lines", "60")
            for p in which:
                if several:
                    print(f"── {preview_label(p)} ({p['url']})")
                print(preview_log(preview_slot(sid, p["key"]), int(n) if n.isdigit() else 60))
            return 0
        if action == "stop":
            left = []
            for p in which:
                left += preview_stop(s, p, why="stopped")
            if left:
                return fail("Stopped, but still there: " + "; ".join(left))
            return 0
        bad = []
        for p in which:
            if not p.get("run"):
                if not several:
                    return fail(f"{p['url']}: it has no command to start it with (amarchy preview --run '<command>' {p['url']})")
                print(f"{preview_label(p)} ({p['url']}): an address only, nothing to start")
                continue
            why = preview_start(s, p, restart=action == "restart", wait=PREVIEW_WAIT, say=print)
            if why:
                log = preview_log(preview_slot(sid, p["key"]), 15)
                bad.append(f"{p['url']}: {why}" + (f"\nIts log ends:\n{log}" if log else ""))
            else:
                print(f"Up at {p['url']}" + (f" ({preview_label(p)})" if several else ""))
        return fail("\n".join(bad)) if bad else 0
    url = (opts.get("--url") or (args[0] if args else "")).strip()
    if not url and not ({"--run", "--stop", "--memory", "--idle"} & opts.keys() or ports):
        if named and not one:
            return fail(f"This chat has no preview named {name}{some}")
        for p in which:
            print(p["url"] if len(which) == 1 else f"{preview_label(p)}: {p['url']}")
        return 0
    # A command serving localhost, on a tailnet with HTTPS: amarchy serves it
    # there (https://<this machine's tailnet name>:<port>).
    tls, moved = preview_tls(), None
    commanding = "--run" in opts or bool({"--stop", "--memory", "--idle"} & opts.keys() or ports)
    try:
        given = urllib.parse.urlsplit(url)
        given_port = given.port
    except ValueError:
        given, given_port = None, None
    if (tls and commanding and given and given.scheme == "http" and given_port
            and (given.hostname or "").lower() in ("localhost", "127.0.0.1", "::1", "0.0.0.0")):
        moved = url
        url = urllib.parse.urlunsplit(("https", f"{tls}:{given_port}", given.path or "/", given.query, given.fragment))
    # Which one this is: the one of that name; else the one at that address;
    # with no name, else its only one (its address changed); else a new one.
    target = one or next((p for p in ps if url and p["url"] == url), None)
    if not target and not named and ps:
        if len(ps) > 1:
            return fail(f"This chat has {len(ps)} previews ({preview_names(ps)}): say which with --name <its name> "
                        f"(a new name adds one)")
        target = ps[0]
    if not target and not url:
        return fail(f"This chat has no preview{f' named {name}' if named else ''} to change{some}: "
                    "amarchy preview --run '<command>' <url>")
    base = target or {}
    url = url or base.get("url", "")
    u = urllib.parse.urlsplit(url)
    if u.scheme not in ("http", "https") or not u.hostname:
        return fail(f"Not an address to open: {url} (http://... or https://...)")
    host, bind = host_network()
    if bind and u.hostname.lower() in ("localhost", "127.0.0.1", "::1", "0.0.0.0"):
        if tls:
            return fail(f"{url} doesn't reach their browser: listen on 127.0.0.1 and register it with the command "
                        f"that serves it (amarchy preview --run '<command>' https://{tls}:<port>), and amarchy "
                        f"serves it on their tailnet over HTTPS")
        return fail(f"{url} doesn't reach their browser: listen on {bind} and give http://{host}:<port>")
    try:
        u_port = u.port
    except ValueError:
        return fail(f"Not an address to open: {url} (its port isn't a number)")
    if tls and u.scheme == "https" and u.hostname.lower() == tls and u_port in (None, app_https()):
        return fail(f"{url} is amarchy's own address: give the preview a port of its own (https://{tls}:<port>)")
    new = {"url": url}
    # Its name: the one given (the one it has, when that's the same name in
    # other letters: only --rename changes how it's written).
    if name or base.get("name"):
        new["name"] = base["name"] if base.get("name") and preview_key(base["name"]) == preview_key(name or base["name"]) else name
    # --run sets the command; --stop, --port, --memory or --idle alone change
    # the one it has; an address alone is an address only (a deploy).
    edits = bool({"--stop", "--memory", "--idle"} & opts.keys() or ports)
    run = opts.get("--run") or (base.get("run") if edits else None)
    if edits and not run:
        return fail("--stop, --port, --memory and --idle go with a command: amarchy preview --run '<command>' <url>")
    if preview_fronted(url) and not run:
        return fail(f"amarchy serves {url} over HTTPS only for a command it runs: "
                    f"amarchy preview --run '<command>' {url} (its server on 127.0.0.1)")
    if run:
        if not preview_local(url):
            return fail(f"{url} isn't on this machine: a command amarchy runs serves here (http://{host}:<port>)")
        new["run"] = run.strip()
        stop = opts.get("--stop", base.get("stop"))
        if stop:
            new["stop"] = stop.strip()
        new_ports = sorted(set(ports or base.get("ports") or []))
        if new_ports:
            new["ports"] = new_ports
        memory = opts.get("--memory", base.get("memory"))
        if memory:
            if not re.fullmatch(r"\d+(?:\.\d+)?[KMGT]?", memory, re.I):
                return fail(f"--memory takes a size like 2G or 1500M, not {memory!r}")
            new["memory"] = memory.upper()
        idle = opts.get("--idle", base.get("idle"))
        if idle is not None:
            secs = duration(idle)
            if not secs or secs < 300:
                return fail(f"--idle takes a time of 5 minutes or more, like 3h or 90m, not {idle!r}")
            new["idle"] = secs
        # Its ports are its own: two of a chat's previews can't both run on one.
        mine = set(preview_ports(new))
        for o in ps:
            clash = mine & set(preview_ports(o)) if o is not target and (o.get("run") or o.get("ports")) else set()
            if clash:
                return fail(f"Port {min(clash)} is its preview {preview_label(o)}'s already: give this one a port of its own"
                            + ("" if named else ", and a name (--name)"))
    # Its key: the one it has, else its name's (or "" for a chat's first with
    # none), made its own when another has it.
    if target:
        key = target["key"]
    else:
        taken = {p["key"] for p in ps}
        key = root = "" if not new.get("name") and "" not in taken else preview_key(new.get("name")) or "preview"
        n = 2
        while key in taken:
            key, n = f"{root}-{n}", n + 1
    new["key"] = key
    slot = preview_slot(sid, key)
    serves = lambda p: {k: v for k, v in p.items() if k not in ("key", "name")}       # (a new name changes nothing that runs)
    if target and target.get("run") and serves(target) != serves(new) and preview_pids(slot):
        preview_stop(s, target, teardown=not run, why="changed")       # started again with what it is now (below)
    ps = [new if p is target else p for p in ps] if target else [*ps, new]
    preview_save(s, ps)
    replaced = target and not named and target["url"] != url
    also = (f"\nIt replaced the one at {target['url']}: for one beside it, give it a name (--name <what it is>)." if replaced else
            f"\nThis chat has {len(ps)} previews now: its button is Previews, a list to pick from." if not target and len(ps) > 1 else "")
    if not target and len(ps) > 1 and any(not p.get("name") for p in ps):
        nameless = next(p for p in ps if not p.get("name"))
        also += f" Name the one at {nameless['url']} too: amarchy preview --rename '<what it is>'"
    if run:
        preview_note(slot, sid=sid, key=key, path=os.environ.get("PATH", ""))
    unlock()
    if run:
        at = f"It's at {url} (amarchy serves {moved} there, on their tailnet over HTTPS)." if moved else ""
        if "--no-start" in flags:
            if also or at:
                print(" ".join(x for x in (at, also.strip()) if x))
            return 0
        why = preview_start(s, new, wait=PREVIEW_WAIT, say=print)
        if why:
            log = preview_log(slot, 15)
            again = f" --name {shlex.quote(new['name'])}" if len(ps) > 1 and new.get("name") else ""
            return fail(f"Saved, but {why}" + (f"\n{at}" if at else "") + (f"\nIts log ends:\n{log}" if log else "") +
                        f"\nFix it, then: amarchy preview restart{again}")
        print(f"Up at {url}: its Preview button opens it, and starts it again whenever it isn't running." + also)
        if moved:
            print(f"(amarchy serves {moved} there, on their tailnet over HTTPS.)")
        elif tls and not preview_fronted(url):
            where = preview_local(url)
            print(f"Over plain http it loads slowly on their phone (a browser fetches a dev server's files a few at a "
                  f"time, each a round trip away): make it listen on 127.0.0.1 and register "
                  f"https://{tls}:{where[1] if where else '<port>'} instead, and amarchy serves it over HTTPS.")
        return 0
    if not preview_up(url):
        print(f"Saved, but nothing answers at {url} yet: its button says so until it does." + also)
    elif also:
        print(also.strip())
    return 0


def cmd_run(args):
    """Run the project in the session's terminal: the command shows, runs, and
    leaves you in a shell when it ends. Running again restarts it. A name runs
    one of the project's other saved commands instead."""
    sid = own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail("Not in a session: run it from a session's Claude or terminal")
    if s.get("setup") and (not args or not args[0].startswith("--")):
        return fail(f"{s['name']} is still being set up: run it once Claude has started")
    flag = args[0] if args else ""
    if flag == "--set":
        command = " ".join(args[1:]).strip()
        if not command:
            return fail("Usage: amarchy run --set <command>")
        set_run_command(s["repo"], command)
        return 0
    if flag == "--save":
        command = " ".join(args[2:]).strip()
        if len(args) < 2 or args[1] == RUN_DEFAULT or not command:
            return fail("Usage: amarchy run --save <name> <command> (the run command itself: amarchy run --set)")
        save_command(s["repo"], args[1], command)
        return 0
    if flag == "--forget":
        if len(args) < 2 or args[1] not in saved_commands(s["repo"]):
            return fail(f"No saved command {' '.join(args[1:])!r} for {s['repo']}")
        save_command(s["repo"], args[1], "")
        return 0
    command = run_command(s)
    if flag == "--list":
        for name, saved in {RUN_DEFAULT: command, **saved_commands(s["repo"])}.items():
            if saved:
                print(f"{name}\t{saved}")
        return 0
    if flag == "--show":
        print(command)
        return 0 if command else 1
    if flag:
        command = saved_commands(s["repo"]).get(flag)
        if not command:
            return fail(f"No saved command {flag!r} for {s['repo']}. Save it: amarchy run --save {flag} <command>")
        return host_run(s, command)
    if not command:
        return fail(f"No run command for {s['repo']} yet: amarchy run --set <command>")
    return host_run(s, command)


# ------------------------------------------------------------------ secrets
#
# A key or a password a project needs (an OpenAI key for its tests, a Stripe
# secret...), given in the app, never in the chat: the transcript keeps
# everything said there, and Claude reads it all. Claude asks for one with
# `amarchy secret ask NAME --why "..."` (the amarchy skill says when): the
# app shows a card with a password field, the session waits for you as it
# does for a question, and Claude hears back only that it's saved. You can
# also add one in Settings → Secrets, or with `amarchy secret set`.
#
# Kept in ~/.config/amarchy/secrets/ (a 0700 folder, 0600 files, outside every
# repo, so nothing commits them): projects/<project>.env for one project's
# sessions, all.env for every project's (a project's own wins over one for
# all). As shell assignments, NAME='value', that a shell sources.
#
# They reach, as environment variables by name ($OPENAI_API_KEY):
# - Claude's commands: its SessionStart hook writes a line into Claude Code's
#   CLAUDE_ENV_FILE that sources the files, and Claude Code sources that
#   before each Bash command (checked on 2.1.309, -p and the TUI), so one
#   saved or forgotten mid-session counts from the next command, no restart.
#   Claude Code itself starts with them too (an MCP server's ${NAME}).
# - the session's terminal and its run commands: `amarchy shell` starts the
#   shell with them, and a bash there reads them again at each prompt when
#   they changed. A program already running (a dev server) has the ones it
#   started with: Run starts it again.
# Never Claude's own credentials (ANTHROPIC_API_KEY...): with one, Claude
# Code bills that API account instead of your subscription. Claude's Read and
# Edit of the folder are denied (hook_settings), a Bash command naming it is
# refused (secret_guard), and the app masks a secret's value wherever it
# would show (mask_secrets).

SECRETS = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy/secrets"
SECRETS_ALL = SECRETS / "all.env"
SECRET_ASKS = "secret-asks"     # in claude_dir(<session>): <ask id>.json, Claude's ask waiting; <ask id>.answer
SECRET_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]{0,99}")
SECRET_MAX = 64 * 1024
SECRET_MASK = "••••••••"
SECRET_MASK_MIN = 8             # shorter values aren't masked: they'd match ordinary words
SECRET_WAIT = 590               # seconds `secret ask` waits by default (Claude's Bash allows 600 at most)
# What a shell or amarchy needs as it is: kept as a secret it would break it.
SECRET_SYSTEM = {"PATH", "HOME", "USER", "LOGNAME", "SHELL", "PWD", "OLDPWD", "TERM", "COLORTERM", "LANG",
                 "LANGUAGE", "TZ", "TMUX", "TMUX_PANE", "SHLVL", "TMPDIR", "DISPLAY", "WAYLAND_DISPLAY",
                 "XDG_RUNTIME_DIR", "XDG_CONFIG_HOME", "XDG_STATE_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME",
                 "DBUS_SESSION_BUS_ADDRESS", "SSH_AUTH_SOCK", "LD_PRELOAD", "LD_LIBRARY_PATH", "PYTHONPATH",
                 "PYTHONHOME", "NODE_OPTIONS", "BASH_ENV", "ENV", "PROMPT_COMMAND", "IFS", "PS1", "PS2", "PS4",
                 "CDPATH", "MAIL", "EDITOR", "VISUAL", "PAGER", "HISTFILE", "SUDO_ASKPASS", "GIT_DIR",
                 "GIT_WORK_TREE", "GIT_SSH_COMMAND", "GIT_TERMINAL_PROMPT"}
SECRET_SUGGESTIONS = ("OPENAI_API_KEY", "GEMINI_API_KEY", "STRIPE_SECRET_KEY", "GITHUB_TOKEN", "DATABASE_URL",
                      "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "SUPABASE_SERVICE_ROLE_KEY",
                      "RESEND_API_KEY", "HF_TOKEN", "SENTRY_AUTH_TOKEN", "CLOUDFLARE_API_TOKEN")


def secret_refused(name):
    """Why a name can't be a secret, or None."""
    if not isinstance(name, str) or not SECRET_NAME.fullmatch(name):
        return "a secret's name is letters, digits and _, not starting with a digit (like OPENAI_API_KEY)"
    up = name.upper()
    if up.startswith("ANTHROPIC_") or up in ("CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_API_KEY"):
        return (f"{name} can't be kept as a secret: Claude Code reads it, and with an Anthropic key or token "
                f"in its environment Claude bills that API account instead of your Claude subscription (the "
                f"login it runs on here). If the project itself calls Anthropic's API, keep its key under a "
                f"name of the project's own (say MYAPP_ANTHROPIC_KEY) and have the project read that one")
    if up.startswith("CLAUDE_"):
        return f"{name} is one of Claude Code's own settings, not a secret: it can't be kept as one"
    if up.startswith("AMARCHY"):
        return f"{name} is amarchy's own: it can't be kept as a secret"
    if up in SECRET_SYSTEM:
        return f"{name} is the system's own: as a secret it would break the shell"
    return None


def secret_file(repo):
    """Where a project's secrets are kept (repo None: every project's)."""
    if repo is None:
        return SECRETS_ALL
    return SECRETS / "projects" / f"{repo}.env"


def secret_quote(value):
    return "'" + value.replace("'", "'\\''") + "'"


def secrets_read(f):
    """The secrets in one file: {name: (value, set at)}, in its order."""
    try:
        text = f.read_text()
    except OSError:
        return {}
    at = dict(re.findall(r"^# (\w+) set (\d+)$", text, re.M))
    out = {}
    try:
        words = shlex.split(text, comments=True)
    except ValueError:      # not one of ours
        return {}
    for w in words:
        name, eq, value = w.partition("=")
        if eq and SECRET_NAME.fullmatch(name):
            out[name] = (value, int(at.get(name) or 0))
    return out


def secrets_write(f, secrets):
    """Write one file of secrets (or remove it when there are none), 0600 in
    0700 folders, all at once."""
    for d in (SECRETS, f.parent):
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(d, 0o700)
    if not secrets:
        f.unlink(missing_ok=True)
        return
    text = "# amarchy's secrets (amarchy secret list): kept out of every repo and every chat\n" + "".join(
        f"# {name} set {at}\n{name}={secret_quote(value)}\n" for name, (value, at) in secrets.items())
    tmp = f.with_name(f".{f.name}.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as out:
        out.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, f)


def secrets_lock():
    SECRETS.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock = open(SECRETS / ".lock", "a")
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def secret_set(repo, name, value):
    """Keep a secret for a project (None: for all of them). Why not, or None."""
    why = secret_refused(name)
    if why:
        return why
    if not isinstance(value, str) or not value.strip("\n"):
        return "the secret is empty"
    value = value.rstrip("\n").removesuffix("\r")       # a pasted line's end isn't part of it
    if "\0" in value or len(value.encode()) > SECRET_MAX:
        return "that isn't a secret amarchy can keep (64 KB of text at most)"
    if repo is not None and not (WORK / repo / ".git").exists():
        return f"no project {repo!r}"
    f = secret_file(repo)
    with secrets_lock():
        secrets = secrets_read(f)
        secrets[name] = (value, int(time.time()))
        secrets_write(f, secrets)
    return None


def secret_forget(repo, name):
    """Drop a secret: whether there was one."""
    f = secret_file(repo)
    with secrets_lock():
        secrets = secrets_read(f)
        if name not in secrets:
            return False
        del secrets[name]
        secrets_write(f, secrets)
    return True


def secrets_list():
    """Every secret's name (never its value) and when it was set, per scope:
    {"all": [{name, at}], "projects": {project: [{name, at}]}}."""
    def names(f):
        return [{"name": n, "at": at} for n, (_, at) in sorted(secrets_read(f).items())]
    projects = {}
    for f in sorted((SECRETS / "projects").glob("*.env")):
        if names(f):
            projects[f.stem] = names(f)
    return {"all": names(SECRETS_ALL), "projects": projects}


def secret_scope(repo, name):
    """Where a project's commands get a secret from: "project", "all" or None."""
    if name in secrets_read(secret_file(repo)):
        return "project"
    return "all" if name in secrets_read(SECRETS_ALL) else None


def session_secrets(repo):
    """The secrets a project's sessions get: {name: value}, its own over the ones for all."""
    out = {n: v for n, (v, _) in secrets_read(SECRETS_ALL).items()}
    out.update({n: v for n, (v, _) in secrets_read(secret_file(repo)).items()})
    return {n: v for n, v in out.items() if not secret_refused(n)}


def secret_env(s):
    """A session's secrets, for the environment Claude Code or its terminal
    starts in, and AMARCHY_SECRET_NAMES: which they were (so a forgotten one
    can be taken away again, see secrets_sh)."""
    found = session_secrets(s["repo"])
    return {**found, "AMARCHY_SECRET_NAMES": " ".join(found)}


def secrets_sh(repo):
    """A line of shell that takes the project's secrets as they are now:
    the ones it started with away, then the files' (exported)."""
    files = " ".join(shlex.quote(str(f)) for f in (SECRETS_ALL, secret_file(repo)))
    return (f'[ -n "${{AMARCHY_SECRET_NAMES:-}}" ] && unset $AMARCHY_SECRET_NAMES; '
            f'for __amarchy_f in {files}; do [ -r "$__amarchy_f" ] && {{ set -a; . "$__amarchy_f"; set +a; }}; '
            f'done; unset __amarchy_f')


_MASKS = {"sig": None, "values": ()}


def secret_values():
    """Every secret's value long enough to mask, longest first (read again
    when a file changes)."""
    files = [SECRETS_ALL, *sorted((SECRETS / "projects").glob("*.env"))]
    sig = []
    for f in files:
        try:
            st_ = f.stat()
            sig.append((str(f), st_.st_mtime_ns, st_.st_size))
        except OSError:
            pass
    if sig != _MASKS["sig"]:
        values = {v for f in files for v, _ in secrets_read(f).values() if len(v) >= SECRET_MASK_MIN}
        _MASKS.update(sig=sig, values=tuple(sorted(values, key=len, reverse=True)))
    return _MASKS["values"]


def mask_secrets(text):
    """Text with every secret's value in it masked: as it is, and as JSON
    writes it (for a payload already encoded)."""
    values = secret_values()
    if not values or not text:
        return text
    for v in values:
        if v in text:
            text = text.replace(v, SECRET_MASK)
        encoded = json.dumps(v)[1:-1]
        if encoded != v and encoded in text:
            text = text.replace(encoded, SECRET_MASK)
    return text


SECRET_READERS = ("cat|tac|less|more|head|tail|bat|nl|grep|egrep|fgrep|rg|ag|sed|awk|gawk|cut|sort|uniq|strings|"
                  "xxd|od|hexdump|base64|base32|cp|mv|scp|rsync|tar|zip|gzip|ln|tee|diff|cmp|python|python3|node|"
                  "perl|ruby|php|source|\\.|env|dotenv|jq|yq|vim?|nvim|nano|emacs|code|open|xdg-open|curl|wget|"
                  "find|ls|stat|file|wc|md5sum|sha\\w*sum|openssl|gpg|printf|echo|eval|exec|sh|bash|zsh|fish")


def preview_template():
    """A preview's address as Claude is told to give it: https://<this
    machine>.<tailnet>.ts.net:<port> where amarchy serves it over HTTPS."""
    tls = preview_tls() if host_network()[1] else None
    return f"https://{tls}:<port> (listening on 127.0.0.1)" if tls else "http://<host>:<port>"


def serve_reminder(event):
    """PreToolUse: a dev server Claude starts in the background (Bash's
    run_in_background, or `&`) stops when its chat sleeps. What it's told,
    for one the user is to open, or None (it goes ahead either way: a server
    for its own test run is fine)."""
    if not isinstance(event, dict) or event.get("tool_name") != "Bash":
        return None
    given = event.get("tool_input") or {}
    command = str(given.get("command") or "")
    if "amarchy preview" in command or not SERVING_RUN.search(command):
        return None
    if not (given.get("run_in_background") or re.search(r"&\s*(?:$|\)|disown)|\bnohup\b|\bsetsid\b|systemd-run", command)):
        return None
    return ("amarchy: a server started here stops when this chat sleeps (a minute after it goes idle). If it's "
            "for the user to look at, don't keep it here: register it as the chat's preview, and amarchy runs it "
            "outside your shells, starts it again from its Preview button, and stops it when the chat is "
            f"completed: amarchy preview --run '<command>' {preview_template()} [--port <hmr port>] "
            "[--stop '<teardown>'] (with --name <what it is> for each, when there's more than one; the amarchy "
            "skill). Only a server for your own check (a test run) belongs here.")


def secret_guard(event):
    """PreToolUse: a Bash command that reads the secrets' folder is refused
    (Claude's Read and Edit of it are denied by its settings), so a value
    doesn't end up in the conversation. The reason Claude gets, or None."""
    if not isinstance(event, dict) or event.get("tool_name") != "Bash":
        return None
    command = str((event.get("tool_input") or {}).get("command") or "")
    home = str(HOME)
    folder = str(SECRETS)
    spelled = {folder, folder.replace(home, "~", 1), folder.replace(home, "$HOME", 1),
               folder.replace(home, "${HOME}", 1)}
    if not any(p in command for p in spelled):
        return None
    # Only what reads it: a command that reads files with the folder on the
    # same line after it, or the folder as a redirect's input. Naming it (in
    # a doc being written, a grep for the words) is fine.
    paths = "|".join(re.escape(p) for p in sorted(spelled, key=len, reverse=True))
    if not re.search(rf"(?:^|[\s;&|(`$])(?:{SECRET_READERS})(?:\s[^\n;&|]*)?\s[\"']?(?:{paths})"
                     rf"|<\s*[\"']?(?:{paths})", command):
        return None
    return ("amarchy keeps secrets out of the conversation, so this command can't read their folder. Your "
            "commands already have each one as an environment variable ($NAME, see `amarchy secret list`); "
            "use it by name, and never print it. To get one that's missing: amarchy secret ask NAME --why \"...\"")


# ---- Claude asks for one: amarchy secret ask

def secret_asks_dir(sid):
    return claude_dir(sid) / SECRET_ASKS


def secret_asks(sid):
    """What a session's Claude asks for now: [{id, name, why, scope, repo,
    again, at, waiting}] (waiting: the asking command is still there, so
    Claude hears the answer itself)."""
    out = []
    for f in sorted(secret_asks_dir(sid).glob("*.json")):
        try:
            a = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(a, dict) or (f.with_suffix(".answer")).exists():
            continue
        a["waiting"] = pid_alive(a.get("pid"))
        a.pop("pid", None)
        out.append(a)
    return sorted(out, key=lambda a: a.get("at", 0))


def secret_answer(s, ask_id, value=None, scope="project", decline=False, message=""):
    """Your answer to what Claude asked (secret ask): the secret kept, or
    not given. The asking command tells Claude; when it's gone (Claude
    stopped waiting), Claude is told in a message. Why not, or None."""
    sid = s["id"]
    if not isinstance(ask_id, str) or not re.fullmatch(r"[0-9a-f]{12}", ask_id):
        return "which request?"
    f = secret_asks_dir(sid) / f"{ask_id}.json"
    try:
        a = json.loads(f.read_text())
    except (OSError, ValueError):
        return "gone"
    name = a.get("name")
    if decline:
        answer = {"declined": True, "message": str(message or "")[:2000]}
    else:
        if scope not in ("project", "all"):
            return "scope: project or all"
        why = secret_set(None if scope == "all" else s["repo"], name, value)
        if why:
            return why
        answer = {"saved": True, "scope": scope}
    write_file(f.with_suffix(".answer"), json.dumps(answer))
    if not pid_alive(a.get("pid")):
        f.unlink(missing_ok=True)
        f.with_suffix(".answer").unlink(missing_ok=True)
        if answer.get("saved"):
            note = (f"[amarchy] The user saved the secret {name} you asked for. It's in your Bash commands' "
                    f"environment now as ${name} (and in this chat's terminal and run commands); use it by "
                    f"name and never print its value.")
            detach([ENTRY, "send", sid, note, "--no-wait"])
    return None


def cmd_secret_ask(s, args):
    name, why, scope, again, wait = None, "", "project", False, SECRET_WAIT
    it = iter(args)
    for a in it:
        if a == "--why":
            why = next(it, "")
        elif a.startswith("--why="):
            why = a[6:]
        elif a in ("--all", "--all-projects", "--global"):
            scope = "all"
        elif a == "--again":
            again = True
        elif a == "--timeout":
            try:
                wait = max(5, int(next(it, "")))
            except ValueError:
                return fail("--timeout <seconds>")
        elif name is None and not a.startswith("-"):
            name = a
        else:
            return fail(usage("secret"))
    if not name:
        return fail(usage("secret"))
    why_not = secret_refused(name)
    if why_not:
        return fail(why_not)
    sid, repo = s["id"], s["repo"]
    have = secret_scope(repo, name)
    if have and not again:
        print(f"{name} is set already ({'for this project' if have == 'project' else 'for every project'}): "
              f"your commands have it as ${name}. Use it by name, never print it. If the user says it's wrong, "
              f"ask again with --again.")
        return 0
    ask_id = uuid.uuid4().hex[:12]
    d = secret_asks_dir(sid)
    f = d / f"{ask_id}.json"
    answer_f = f.with_suffix(".answer")
    write_file(f, json.dumps({"id": ask_id, "name": name, "why": " ".join(why.split())[:500], "scope": scope,
                              "repo": repo, "again": bool(have), "at": int(time.time()), "pid": os.getpid()}))

    def done(*_):
        f.unlink(missing_ok=True)
        answer_f.unlink(missing_ok=True)
        # Back to working, unless something else waits for you meanwhile.
        if (STATUS / sid).exists() and (STATUS / sid).read_text().strip() == "waiting" and not secret_asks(sid) \
                and not (agent_live(sid).get("pending") if engine(s) == "chat" else None):
            set_status(sid, "working")

    def stopped(signum, _):
        # Claude stopped waiting (its command's time ran out, or you pressed
        # Stop): the card stays, and saving it then tells Claude in a message.
        if (STATUS / sid).exists() and (STATUS / sid).read_text().strip() == "waiting":
            set_status(sid, "working")
        sys.exit(128 + signum)

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, stopped)
    set_status(sid, "waiting")
    print(f"Asked the user for {name} in the amarchy app (a card with a password field)… waiting for them.",
          file=sys.stderr, flush=True)
    end = time.time() + wait
    while time.time() < end:
        if answer_f.exists() or not f.exists():
            break
        if not session(sid):
            break
        time.sleep(0.3)
    try:
        answer = json.loads(answer_f.read_text())
    except (OSError, ValueError):
        answer = None
    if answer is None and f.exists():
        done()
        print(f"The user hasn't given {name} yet (asked {wait // 60} minutes ago). Don't ask for it in the chat: "
              f"tell them you need it, and run `amarchy secret ask {name}` again when they're ready (or they add "
              f"it in Settings → Secrets).")
        return 2
    done()
    if not answer:      # the card was dismissed with the session, or the folder cleared
        print(f"The request for {name} was withdrawn.")
        return 1
    if answer.get("declined"):
        said = answer.get("message") or ""
        print(f"The user chose not to give {name}." + (f" They said: \"{said}\"." if said else "") +
              " Don't ask for it in the chat.")
        return 1
    where = "every project's sessions" if answer.get("scope") == "all" else f"{repo}'s sessions"
    print(f"Saved. {name} is set for {where}: your Bash commands have it as ${name} from now on (no restart), "
          f"and so do the session's terminal (from its next prompt) and its run commands. Refer to it by name "
          f"(${name}) and never print, echo or log its value. A program already running (a dev server) "
          f"needs restarting to get it: amarchy run.")
    return 0


def cmd_secret(args):
    """amarchy secret ask|set|list|forget ... (see usage)."""
    if not args:
        print(usage("secret"), file=sys.stderr)
        return 1
    sub, rest = args[0], args[1:]
    sid = own_session_id()
    s = session(sid) if sid else None
    if sub == "ask":
        if not s:
            return fail("amarchy secret ask runs from a session's Claude: the card shows in that session")
        return cmd_secret_ask(s, rest)
    scope_all = any(a in ("--all", "--all-projects", "--global") for a in rest)
    project = None
    words = []
    it = iter(rest)
    for a in it:
        if a == "--project":
            project = next(it, "")
        elif a in ("--all", "--all-projects", "--global", "--json"):
            continue
        else:
            words.append(a)
    repo = None if scope_all else (project or (s["repo"] if s else None))
    if sub == "list":
        listed = secrets_list()
        if "--json" in rest:
            print(json.dumps(listed, indent=2))
            return 0
        for scope, names in [("every project", listed["all"]), *listed["projects"].items()]:
            for n in names:
                print(f"{n['name']}\t{scope}")
        return 0
    if sub in ("set", "forget", "rm"):
        if len(words) != 1:
            return fail(usage("secret"))
        name = words[0]
        if repo is None and not scope_all:
            return fail("which project? --project <name>, or --all for every project (from a session: its own)")
        if sub == "set":
            why = secret_refused(name)
            if why:
                return fail(why)
            # Never on the command line: it would be in the shell's history,
            # and in Claude's transcript when Claude runs it.
            if sys.stdin.isatty():
                import getpass
                value = getpass.getpass(f"{name}: ")
            else:
                value = sys.stdin.read()
            why = secret_set(repo, name, value)
            if why:
                return fail(why)
            print(f"{name} saved for {'every project' if repo is None else repo}")
            return 0
        if not secret_forget(repo, name):
            return fail(f"no secret {name} for {'every project' if repo is None else repo}")
        print(f"{name} forgotten for {'every project' if repo is None else repo}")
        return 0
    print(usage("secret"), file=sys.stderr)
    return 1


# ---- the session's terminal: amarchy shell

SHELL_RC = STATE / "shell" / "bashrc"


def shell_rc():
    """The rc file of a session terminal's bash: the login files it would
    read as tmux starts it, then a prompt hook that takes its secrets again
    when they changed (an interactive bash doesn't read them by itself)."""
    text = r'''# amarchy: a session terminal's bash (amarchy shell). Read as a login shell is.
[ -r /etc/profile ] && . /etc/profile
if [ -r ~/.bash_profile ]; then . ~/.bash_profile
elif [ -r ~/.bash_login ]; then . ~/.bash_login
elif [ -r ~/.profile ]; then . ~/.profile
fi
# The project's secrets (amarchy secret), again when they changed.
__amarchy_secrets() {
  local sig names n said=""
  sig=$(command stat -c '%Y.%s' -- $AMARCHY_SECRET_FILES 2>/dev/null | command tr '\n' ' ')
  [ "$sig" = "${__amarchy_sig-}" ] && return
  names=$(command sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' -- $AMARCHY_SECRET_FILES 2>/dev/null | command sort -u | command tr '\n' ' ')
  if [ -n "${__amarchy_sig+x}" ]; then
    for n in $names; do case " ${AMARCHY_SECRET_NAMES:-} " in *" $n "*) ;; *) said="$said +$n" ;; esac; done
    for n in ${AMARCHY_SECRET_NAMES:-}; do case " $names " in *" $n "*) ;; *) said="$said -$n" ;; esac; done
    [ -n "$said" ] && printf '\033[2mamarchy secrets:%s\033[0m\n' "$said"
  fi
  __amarchy_sig=$sig
  [ -n "${AMARCHY_SECRET_NAMES:-}" ] && unset $AMARCHY_SECRET_NAMES
  for n in $AMARCHY_SECRET_FILES; do [ -r "$n" ] && { set -a; . "$n"; set +a; }; done
  AMARCHY_SECRET_NAMES=$names
}
__amarchy_secrets
PROMPT_COMMAND="__amarchy_secrets${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
'''
    try:
        if SHELL_RC.read_text() == text:
            return SHELL_RC
    except OSError:
        pass
    write_file(SHELL_RC, text)
    return SHELL_RC


def cmd_shell(args):
    """amarchy shell <id> [command]: the shell of a session's terminal (tmux
    starts it), with the project's secrets in its environment; with a command,
    that command first (a run command), then the shell."""
    if not args:
        return fail("usage: amarchy shell <id> [command]")
    s = session(args[0])
    shell = os.environ.get("SHELL") or "/bin/bash"
    env = dict(os.environ)
    if s:
        env.update(secret_env(s))
        env["AMARCHY_SECRET_FILES"] = f"{SECRETS_ALL} {secret_file(s['repo'])}"
    bash = Path(shell).name == "bash"
    if len(args) > 1:
        script = args[1]
        if bash:
            script = f"{script}; exec {shlex.quote(shell)} --rcfile {shlex.quote(str(shell_rc()))}"
        else:
            script = f"{script}; exec {shlex.quote(shell)}"
        argv = [shell, "-ic", script]
    elif bash:
        argv = [shell, "--rcfile", str(shell_rc())]
    else:
        argv = ["-" + Path(shell).name]       # a login shell, as tmux starts one
    try:
        os.execve(shell, argv, env)
    except OSError as e:
        print(f"amarchy shell: {e}", file=sys.stderr)
        os.execve("/bin/sh", ["sh"], env)


# ---- the model a new chat starts on
#
# The new chat's model pill (the app) picks it, and it stays the default of
# every new chat after (on every device: it's the host's) until you pick
# another. amarchy new --model picks one for a single chat. Claude Code's own
# default (its "default", Haiku on some accounts) only if you pick that.

NEW_MODEL_FILE = STATE / "new-model"    # an alias (opus, sonnet...) or a model id
NEW_MODEL = "opus"                      # until you pick one
MODEL_RE = r"[\w.:\[\]-]{1,100}"        # a model as Claude Code takes it (set_model, --model)


def new_model():
    try:
        m = NEW_MODEL_FILE.read_text().strip()
    except OSError:
        m = ""
    return m if re.fullmatch(MODEL_RE, m) else NEW_MODEL


# How hard Claude thinks (Claude Code's effort): beside the model on every
# pill, and picked in the model's menu. The new chat's is the host's too
# (new-effort), "auto" (Claude Code's default for the model) until you pick
# one. A chat's own lives in its chosen.json, and its Claude wakes in it.

EFFORTS = ("low", "medium", "high", "xhigh", "max")
NEW_EFFORT_FILE = STATE / "new-effort"      # one of EFFORTS, or "auto"


def effort_choice(e):
    """e if it's an effort you can pick (EFFORTS, or "auto"), else None."""
    return e if isinstance(e, str) and (e in EFFORTS or e == "auto") else None


def new_effort():
    try:
        e = NEW_EFFORT_FILE.read_text().strip()
    except OSError:
        e = ""
    return effort_choice(e) or "auto"


# The effort each model starts on when nobody picked one (Claude Code's
# default: what a chat on "auto" was last seen on), for the new chat's pill.
DEFAULT_EFFORTS = STATE / "default-efforts.json"    # {resolved model: effort}


def default_efforts():
    try:
        d = json.loads(DEFAULT_EFFORTS.read_text())
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in d.items() if isinstance(k, str) and v in EFFORTS} if isinstance(d, dict) else {}


def saw_default_effort(model, effort):
    if not (isinstance(model, str) and model and effort in EFFORTS):
        return
    had = default_efforts()
    if had.get(model) != effort:
        write_file(DEFAULT_EFFORTS, json.dumps({**had, model: effort}))


_known_models = [None, []]      # (the agent.json read, its mtime), its models


def known_models():
    """The models the newest Claude said there are (its agent.json, from
    initialize), for the new chat's pill before it has a Claude of its own;
    [] before any Claude said (the app has a short list of its own then)."""
    try:
        f = max(CLAUDE_STATE.glob("*/agent.json"), key=lambda f: f.stat().st_mtime, default=None)
        key = (f, f.stat().st_mtime) if f else None
    except OSError:
        return _known_models[1]
    if key != _known_models[0]:
        try:
            told = json.loads(f.read_text()) if f else {}
        except (OSError, ValueError):
            told = {}
        _known_models[:] = [key, models_of(told)]
    return _known_models[1]


def models_of(told):
    """The models in what a Claude said (agent.json), as the app has them."""
    told = told if isinstance(told, dict) else {}
    return [{k: m.get(k) for k in ("value", "resolvedModel", "displayName", "description", "supportsAutoMode",
                                   "supportsEffort", "supportedEffortLevels")}
            for m in told.get("models") or [] if isinstance(m, dict) and m.get("value")]


# ---- Show terminals: whether the app shows the sessions' terminals at all

SHOW_TERMINALS = STATE / "show-terminals"   # "on" or "off"; off unless set (an install from before is on)


def show_terminals():
    try:
        return SHOW_TERMINALS.read_text().strip() == "on"
    except OSError:
        return False


def cmd_terminals(args):
    """amarchy terminals [on|off]: prints it, or sets it."""
    if len(args) > 1 or args and args[0] not in ("on", "off"):
        print(usage("terminals"), file=sys.stderr)
        return 1
    if args:
        write_file(SHOW_TERMINALS, args[0] + "\n")
    print("on" if show_terminals() else "off")
    return 0


# ------------------------------------------------------------------ new / close

def has_origin(repo_dir):
    return "origin" in sh("git", "remote", cwd=repo_dir).stdout.split()


def default_base(repo_dir):
    """What a new session branches off: origin's default branch, else the
    local main or master. From what's already fetched, so it's instant."""
    if has_origin(repo_dir):
        head = sh("git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=repo_dir).stdout.strip()
        if head:
            return head
        for b in ("origin/main", "origin/master"):
            if sh("git", "rev-parse", "--verify", "--quiet", b, cwd=repo_dir).returncode == 0:
                return b
    for b in ("main", "master"):
        if sh("git", "rev-parse", "--verify", "--quiet", b, cwd=repo_dir).returncode == 0:
            return b
    return "HEAD"


FETCH_TIMEOUT = 30


def git_net_env():
    """git talking to origin from a script: it never stops to ask for a
    password or a host key, it fails instead."""
    return {**os.environ, "GIT_TERMINAL_PROMPT": "0",
            "GIT_SSH_COMMAND": os.environ.get("GIT_SSH_COMMAND", "ssh -o BatchMode=yes")}


def origin_head(repo_dir):
    """Ask origin which branch is its default now, and remember it
    (refs/remotes/origin/HEAD, what default_base reads). It's set when the
    repo is cloned and stays there when the project changes it on GitHub
    (houston-os went from main to dev): new chats would start from a branch
    the work no longer goes to. As it was when origin doesn't answer."""
    try:
        subprocess.run(["git", "remote", "set-head", "origin", "--auto"], cwd=repo_dir, capture_output=True,
                       text=True, timeout=FETCH_TIMEOUT, stdin=subprocess.DEVNULL, env=git_net_env())
    except (subprocess.TimeoutExpired, OSError):
        pass


def fetch_base(repo_dir, base):
    """Bring base up to date from origin, and return it (it can change when
    origin's branches were never fetched). Only that branch when base is on
    origin, which is much quicker than fetching everything in a big repo.
    The error, if any, comes second: without the network the session still
    starts, from what was fetched last."""
    if not has_origin(repo_dir):
        return base, None
    branch = base.removeprefix("origin/") if base.startswith("origin/") else None
    try:
        r = subprocess.run(["git", "fetch", "--quiet", "origin", *([branch] if branch else [])], cwd=repo_dir,
                           capture_output=True, text=True, timeout=FETCH_TIMEOUT, stdin=subprocess.DEVNULL,
                           env=git_net_env())
        error = r.stderr.strip() if r.returncode else None
    except subprocess.TimeoutExpired:
        error = f"no answer from origin in {FETCH_TIMEOUT}s"
    return (base if branch else default_base(repo_dir)), error


def set_trust(path, trusted):
    """Pre-accept (or forget) Claude Code's per-folder trust prompt for a worktree.

    Written atomically; ~/.claude.json is shared with running Claude processes."""
    cfg = HOME / ".claude.json"
    try:
        data = json.loads(cfg.read_text())
    except (OSError, ValueError):
        return
    projects = data.setdefault("projects", {})
    if trusted:
        projects.setdefault(str(path), {})["hasTrustDialogAccepted"] = True
    else:
        projects.pop(str(path), None)
    tmp = cfg.with_name(".claude.json.amarchy-tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, cfg)


def hook_settings(sid):
    def h(state):
        return [{"hooks": [{"type": "command", "command": f"{shlex.quote(ENTRY)} hook {sid} {state}"}]}]
    settings = {"hooks": {
        "SessionStart": h("start"),
        "UserPromptSubmit": h("working"),
        "PreToolUse": h("working"),
        "Notification": h("waiting"),
        "Stop": h("idle"),
    }}
    # Messages from other sessions (SendMessage) get in whatever permission
    # mode their sender runs in. Left unset, Claude Code holds one from a
    # session in another class (bypass vs. asking) for the user to approve,
    # and a chat-engine session can't approve anything: docs/agent-protocol.md.
    settings["crossSessionInbound"] = "accept"
    # The secrets' folder isn't Claude's to read (see "secrets"): their values
    # would be in the conversation. Its commands have them by name.
    # Nor the boards' files (see "Tasks: boards"): what's done there in your
    # name is yours, from the app; an agent's side is amarchy board.
    settings["permissions"] = {"deny": [f"{tool}(/{folder}/**)" for folder in (SECRETS, BOARDS)
                                        for tool in ("Read", "Edit")]}     # Edit: every writing tool
    if CLAUDE_THEME.exists():       # the app's theme (see look_claude)
        settings["theme"] = "custom:amarchy"
    return json.dumps(settings)


# Session names: a silly adjective and a famous anarchist, e.g. "wobbly-bakunin".
ADJECTIVES = ("bewildered", "caffeinated", "chaotic", "cranky", "crunchy", "disgruntled", "feral",
              "fluffy", "giddy", "grumpy", "jittery", "mischievous", "rowdy", "sassy", "sleepy",
              "smug", "sneaky", "soggy", "spicy", "squeaky", "stubborn", "suspicious", "unbothered",
              "unruly", "wobbly", "wonky", "zesty", "dramatic", "fancy", "rebellious")
ANARCHISTS = ("bakunin", "berkman", "bookchin", "decleyre", "diogenes", "durruti", "godwin",
              "goldman", "graeber", "kotoku", "kropotkin", "landauer", "magon", "makhno",
              "malatesta", "michel", "parsons", "proudhon", "reclus", "rocker", "sacco", "stirner",
              "tolstoy", "vanzetti", "ward", "ferrer", "steimer", "lum", "fabbri", "ito")


def auto_name(repo):
    """A free branch name like "wobbly-bakunin", so a session needs no naming up front."""
    taken = set(sh("git", "branch", "--format=%(refname:short)", cwd=WORK / repo).stdout.split())
    taken |= {s["name"] for s in sessions() if s["repo"] == repo}
    # Not a closed chat's name either (Claude Code still has its conversations,
    # under its worktree's folder): a new chat isn't taken for an old one.
    for _ in range(100):
        name = f"{random.choice(ADJECTIVES)}-{random.choice(ANARCHISTS)}"
        if name not in taken and not has_conversation(WORKTREES / repo / name):
            return name
    return f"session-{int(time.time())}"


def create(repo, name, prompt=None, model=None, images=None, effort=None, agent=None):
    """Start a session: its row in the list right away, and its Claude in
    tmux, which makes the worktree first (setup_session) and is then Claude,
    asked prompt first if given (images, Claude's image blocks, going with
    it), on model and effort (else the new chat's: new_model, new_effort).
    agent: a name, and it's one of your agents from the start (its Claude
    starts writing as someone you text: CHAT_FORMAT). Returns the session id,
    or None, having said why not."""
    repo_dir = WORK / repo
    name = slug(name)
    if not (repo_dir / ".git").exists():
        fail(f"no project {repo!r} (amarchy projects lists them)")
        return None
    if not name:
        fail(f"not a session name: {name!r}")
        return None
    sid = f"{repo}-{name}"
    if session(sid):
        if prompt is not None or agent is not None:
            # Its Claude is already running: a first prompt can't reach it,
            # and a chat of yours isn't made an agent by surprise.
            fail(f"{sid} already exists: message its Claude instead (amarchy list has its agent name)"
                 if agent is None else f"{sid} already exists: amarchy agents {sid} makes it an agent")
            return None
        return sid
    if sh("git", "rev-parse", "--verify", "--quiet", "HEAD", cwd=repo_dir).returncode != 0:
        fail(f"{repo} has no commits yet. Commit something to branch off first.")
        return None

    SESSIONS.mkdir(parents=True, exist_ok=True)
    STATUS.mkdir(parents=True, exist_ok=True)
    (STATE / "failed" / sid).unlink(missing_ok=True)
    # "setup" until the worktree is there. Working meanwhile, so the list
    # spins on it: until its Claude is up with nothing to do (idle, and not
    # done), or through its first message's turn (Agent.run, session_started).
    s = {"id": sid, "repo": repo, "name": name, "branch": name, "base": default_base(repo_dir),
         "path": str(WORKTREES / repo / name), "created": int(time.time()), "setup": True, "engine": "chat"}
    if prompt is not None:
        s["prompt"] = prompt      # taken (once) by `amarchy claude` when Claude starts
    save_session(s)
    if agent is not None:
        # One of your agents before its Claude starts: it starts with their format.
        rows = [a for a in agents_saved() if a["id"] != sid]
        agents_write(rows + [{"id": sid, "name": agent, "sound": agent_free_chime(but=sid)}])
    if images:
        chat_attach_later(sid, images)      # with that first message (Agent.load_attached), before its Claude starts
    # Its Claude starts on it (Agent.restore, before the first message; the
    # classic terminal's first start: claude_argv) and wakes in it.
    agent_remember(sid, model=model or new_model(), effort=effort_choice(effort) or new_effort())
    (STATUS / sid).write_text("working")
    host_start(s)       # its tmux sets it up and becomes Claude
    return sid


def make_worktree(s):
    """Fetch the session's base and add its worktree, saying how it goes.
    Returns an error message, or None once the worktree is there (and the
    session no longer being set up)."""
    repo_dir, path, name = WORK / s["repo"], Path(s["path"]), s["branch"]
    base = s["base"]
    # Already there when its tmux went before Claude started.
    if not (path / ".git").exists():
        with step(f"Fetching the latest {base}") as st:
            if has_origin(repo_dir) and base == default_base(repo_dir):
                origin_head(repo_dir)       # origin's default: it may be another branch by now
                base = default_base(repo_dir)
                st.text = f"Fetching the latest {base}"
            base, error = fetch_base(repo_dir, base)
            if error:
                st.warn(f"Couldn't fetch, so from what was fetched last: {gist(error)}")
        with step(f"Making the worktree, branch {name} off {base}") as st:
            path.parent.mkdir(parents=True, exist_ok=True)
            r = sh("git", "worktree", "add", "-b", name, str(path), base, cwd=repo_dir)
            if r.returncode != 0 and sh("git", "rev-parse", "--verify", "--quiet", f"refs/heads/{name}",
                                        cwd=repo_dir).returncode == 0:
                # The branch is already there (e.g. a kept, unmerged one): pick it back up.
                st.note(f"Branch {name} was already there: picked it back up")
                sh("git", "worktree", "prune", cwd=repo_dir)
                r = sh("git", "worktree", "add", str(path), name, cwd=repo_dir)
            if r.returncode != 0:
                st.fail()
                return r.stderr.strip() or "git worktree add failed"
    if (CLOSING / f"{s['id']}.json").exists():
        return "closed"           # meanwhile: leave it gone
    s = session(s["id"]) or s     # as it is now: it may have been renamed meanwhile
    s.pop("setup", None)
    s["base"] = base
    save_session(s)
    return None


def gist(error):
    """The line of git's error that says what went wrong."""
    lines = [l.strip() for l in error.splitlines() if l.strip()]
    return next((l for l in lines if l.lower().startswith(("fatal:", "error:"))), lines[0] if lines else "")[:200]


class step:
    """One line of a new session's setup: a spinner while it runs, then ✓ (or ✗)."""
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, text):
        self.text, self.mark, self.notes = text, "\033[32m✓\033[0m", []

    def __enter__(self):
        self.started, self.done = time.time(), False

        def spin():
            i = 0
            while not self.done and sys.stdout.isatty():
                print(f"\r\033[K  {self.FRAMES[i % len(self.FRAMES)]} {self.text}…", end="", flush=True)
                i += 1
                time.sleep(0.08)
        self.thread = threading.Thread(target=spin, daemon=True)
        self.thread.start()
        return self

    def warn(self, text):
        self.mark = "\033[33m!\033[0m"
        self.notes.append(text)

    def note(self, text):
        self.notes.append(text)

    def fail(self):
        self.mark = "\033[31m✗\033[0m"

    def __exit__(self, *exc):
        self.done = True
        self.thread.join()
        took = time.time() - self.started
        print(f"\r\033[K  {self.mark} {self.text} \033[2m{took:.1f}s\033[0m", flush=True)
        for n in self.notes:
            print(f"    \033[2m{n}\033[0m", flush=True)


def setup_session(sid):
    """The first thing in a new session's Claude pane: make its worktree, then
    start the terminal beside it. On failure, say why, drop the session, and
    return the error."""
    s = session(sid)
    if not s:
        fail(f"No session {sid!r}")
        return f"no session {sid!r}"
    print(f"\n  \033[1m{s['repo']} · {s['name']}\033[0m\n", flush=True)
    error = make_worktree(s)
    if error and (CLOSING / f"{sid}.json").exists():
        return error        # closed meanwhile: its reap is cleaning up
    if error:
        print(f"\n  \033[31m{error}\033[0m\n", flush=True)
        (SESSIONS / f"{sid}.json").unlink(missing_ok=True)
        (STATUS / sid).unlink(missing_ok=True)
        mark_seen(sid)
        # Nobody may be watching: a terminal attaching later says so (cmd_attach).
        write_file(STATE / "failed" / sid, gist(error) or error)
        time.sleep(3)
        return error
    s = session(sid)
    if not s:
        return "closed"     # while it was being set up
    set_trust(Path(s["path"]), True)
    host_start(s)       # the terminal beside it, now that the worktree is there
    print("  \033[32m✓\033[0m Starting Claude Code", flush=True)
    return None


def projects_dir(path):
    """Where Claude Code keeps the conversations of a folder."""
    return HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", str(path))


def has_conversation(path):
    """Whether Claude Code has a saved conversation for this folder."""
    return any(projects_dir(path).glob("*.jsonl"))


def latest_conversation(s):
    """The file of the latest conversation in the session's folder that is
    its own: written since the session was made. A closed chat's
    conversations stay in Claude Code's folder for its worktree, and a new
    chat given the same name (so the same folder) isn't that old chat: not
    its conversation, its title, or what it said."""
    since, logs = s.get("created") or 0, []
    for f in projects_dir(s["path"]).glob("*.jsonl"):
        try:
            at = f.stat().st_mtime
        except OSError:
            continue
        if at >= since:
            logs.append((at, f))
    return max(logs)[1] if logs else None


def claude_dir(sid):
    """What amarchy keeps about a session's Claude: its conversation, and
    while it sleeps, that it does and the prompt it had."""
    return CLAUDE_STATE / sid


def conversation_id(sid):
    try:
        return (claude_dir(sid) / "conversation").read_text().strip()
    except OSError:
        return ""


def set_conversation_id(sid, conversation):
    """Record which conversation the session's Claude is in (it changes with
    /clear), to resume exactly that one."""
    if not re.fullmatch(r"[0-9a-f-]{36}", conversation or "") or conversation == conversation_id(sid):
        return
    write_file(claude_dir(sid) / "conversation", conversation)


def write_file(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}")
    tmp.write_bytes(text) if isinstance(text, bytes) else tmp.write_text(text)
    os.replace(tmp, path)


def transcript(s):
    """The file of the conversation the session is in, if there is one yet."""
    conversation = conversation_id(s["id"])
    f = projects_dir(s["path"]) / f"{conversation}.jsonl" if conversation else None
    return f if f and f.exists() else None


def claude_argv(s, prefill="", prompt=None):
    """Claude Code for a session, picking its conversation back up: the one it
    was in, else the latest in its folder (sessions from before amarchy kept
    track), with prefill already typed in the prompt, or asked prompt first
    (after --, so it may start with a dash)."""
    first = ["--", prompt] if prompt is not None else []
    # A new session's first start: on the model it was made with (create).
    model = chosen_model(s["id"]) if prompt is not None else None
    effort = chosen_effort(s["id"]) if prompt is not None else None
    return ["claude", *CLAUDE_ARGS, *(["--model", model] if model else []),
            *(["--effort", effort] if effort in EFFORTS else []), *claude_resume(s),
            *(["--prefill", prefill] if prefill and prompt is None else []),
            *reply_format_args(s), "--settings", hook_settings(s["id"]), *first]


def pane_loop(pane, procs):
    """The pid of the loop in a session's Claude pane (HOST_LOOP, the pane's
    own process), or None for a pane from before sessions could sleep."""
    pid = pane["pid"]
    return pid if pid in procs and '"$0" asleep "$1"' in " ".join(cmdline(pid)) else None


def pane_claude(pane, procs):
    """The pid of the Claude Code running in a session's pane, if it is."""
    return next((p for p in descendants(pane["pid"], procs) if procs[p][1] == "claude"), None)


def take(f):
    """A file's text, removing the file (a prompt meant for Claude once)."""
    try:
        text = f.read_text()
    except OSError:
        return None
    f.unlink(missing_ok=True)
    return text


def cmd_claude(sid):
    """The pane loop's first step: set a new session up, then become Claude
    Code: with the message you sent while it slept, or what you had typed in
    its prompt. Asleep, it does nothing: the loop shows the session."""
    s = session(sid)
    if not s:
        return fail(f"No session {sid!r}")
    if s.get("setup"):
        if setup_session(sid):
            return 1
        s = session(sid)
    if asleep_since(sid) is not None:
        return 0
    s = settle_engine(s)
    if engine(s) == "chat":
        return Agent(s).run()       # amarchy agent: see "the chat engine"
    other = claim_driver(sid, "terminal")
    if other:
        print(f"\n  \033[31mThis conversation is open in another Claude already (pid {other.get('pid')}, "
              f"the {other.get('engine')} engine).\033[0m\n", flush=True)
        return 1
    # The first prompt (amarchy new --prompt) goes to Claude once: if Claude
    # starts again later, it picks the conversation up instead.
    prompt = s.pop("prompt", None)
    if prompt is not None:
        save_session(s)
        # It starts on it: working all along, not idle (and "done") in between (session_started).
        write_file(claude_dir(sid) / "first", "")
        set_status(sid, "working")
    else:
        (claude_dir(sid) / "first").unlink(missing_ok=True)
    prefill = take(claude_dir(sid) / "draft") or ""     # what was typed in the sleeping session's prompt
    path = Path(s["path"])
    os.chdir(path)
    os.environ["PWD"] = str(path)
    # Ctrl+V pastes what you pasted in the app (see "clipboard").
    os.environ["PATH"] = paste_path()
    os.environ.update(secret_env(s))      # the project's secrets (its Bash commands read them afresh: cmd_hook)
    argv = claude_argv(s, prefill.strip("\n"), prompt)
    try:
        os.execvp(argv[0], argv)
    except OSError as e:
        print(f"\n  \033[31mCouldn't start Claude Code: {e}\033[0m\n", flush=True)
        return 1


def cmd_new(args):
    """amarchy new <project> [name] [--prompt <text>|-] [--attach <image>]
    [--model <model>] [--effort <effort>] [--agent <name>]: the new
    session's id on stdout. --prompt is the first thing its Claude is asked
    (- reads it from stdin), each --attach a picture going with it; --model
    the model it's on and --effort how hard it thinks (else the new chat's:
    new_model, new_effort); --agent makes it one of your agents, called
    that, from its start (amarchy agents). --no-jump, from when a desktop
    showed the new session, is still taken, and changes nothing: nothing
    opens anywhere."""
    prompt, model, effort, agent, rest, attach, on = None, None, None, None, [], [], None
    it = iter(args)
    for a in it:
        if a == "--no-jump":
            pass
        elif a == "--attach" or a.startswith("--attach="):
            f = a.split("=", 1)[1] if "=" in a else next(it, None)
            if not f:
                return fail("--attach needs a picture's file")
            attach.append(f)
        elif a == "--prompt":
            prompt = next(it, None)
            if prompt is None:
                return fail("--prompt needs the text, or - to read it from stdin")
        elif a.startswith("--prompt="):
            prompt = a.split("=", 1)[1]
        elif a == "--model" or a.startswith("--model="):
            model = a.split("=", 1)[1] if "=" in a else next(it, None)
            if not model or not re.fullmatch(MODEL_RE, model):
                return fail("--model needs a model: opus, sonnet, haiku, or a model id (claude-opus-5-5)")
        elif a == "--effort" or a.startswith("--effort="):
            effort = a.split("=", 1)[1] if "=" in a else next(it, None)
            if not effort_choice(effort):
                return fail(f"--effort needs one of {', '.join(EFFORTS)}, or auto")
        elif a == "--agent" or a.startswith("--agent="):
            agent = (a.split("=", 1)[1] if "=" in a else next(it, None) or "").strip()
            if not agent or len(agent) > 40:
                return fail("--agent takes what to call it (40 characters at most)")
        elif a == "--on" or a.startswith("--on="):
            on = a.split("=", 1)[1] if "=" in a else next(it, None)
            if not on:
                return fail("--on needs a machine (amarchy machines lists them)")
        elif a.startswith("--"):
            return fail(f"amarchy new doesn't know {a} (it takes --prompt, --attach, --model, --effort, --agent and --on)")
        else:
            rest.append(a)
    if not rest or len(rest) > 2:
        print(usage("new"), file=sys.stderr)
        return 1
    if prompt == "-":
        prompt = sys.stdin.read()
    if prompt is not None and not prompt.strip():
        return fail("--prompt is empty")
    if attach and prompt is None:
        return fail("--attach goes with --prompt: the pictures go with that first message")
    images = []
    for f in attach:
        kind = PICTURE_TYPES.get(Path(f).suffix.lower(), "")
        if not CLIP_TYPES.fullmatch(kind):
            return fail(f"{f}: only pictures (PNG, JPEG, GIF or WebP)")
        try:
            data = Path(f).read_bytes()
        except OSError as e:
            return fail(f"can't read {f}: {e.strerror}")
        images.append({"type": kind, "data": base64.b64encode(data).decode()})
    blocks = chat_images(images) if images else []
    if isinstance(blocks, str):
        return fail(f"--attach: {blocks}")
    repo = rest[0]
    if on and on != machine_name():
        return new_on(on, repo, rest[1] if len(rest) > 1 else None, prompt, model, images, effort, agent)
    sid = create(repo, rest[1] if len(rest) > 1 else auto_name(repo), prompt, model, blocks, effort, agent)
    if not sid:
        return 1
    print(sid)
    return 0


def new_on(name, repo, chat_name, prompt, model, images, effort, agent):
    """amarchy new --on <machine>: the chat started on another machine of
    yours, through its app (as this machine), its project cloned there first
    from GitHub when it isn't there. Prints <machine>:<id>."""
    m = machine_find(name)
    if not m:
        return fail(f"no machine {name} is paired with this one (amarchy machines lists them)")
    try:
        status, there = peer_json(m, "GET", "/api/peer/state")
        if status != 200:
            return fail(there.get("error") or f"{m['label']} said no ({status})")
        if repo not in {p.get("name") for p in there.get("projects") or [] if isinstance(p, dict)}:
            slug = project_github(repo) if (WORK / repo / ".git").exists() else (repo if re.fullmatch(r"[\w.-]+/[\w.-]+", repo) else None)
            if not slug:
                return fail(f"{repo} isn't on {m['label']}, and has no GitHub address here to clone it from: add it there first")
            print(f"cloning {slug} on {m['label']} first…", file=sys.stderr, flush=True)
            status, added = peer_json(m, "POST", "/api/add", {"repo": slug}, timeout=930)
            if status != 200:
                return fail(f"couldn't clone {slug} on {m['label']}: {added.get('error') or status}")
            repo = Path(str(added.get("name") or repo)).name     # (one from before: its path)
        body = {"repo": repo, **{k: v for k, v in (("prompt", prompt), ("model", model), ("effort", effort), ("agent", agent)) if v},
                **({"images": images} if images else {})}
        if chat_name:
            body["name"] = chat_name
        status, d = peer_json(m, "POST", "/api/new", body, timeout=330)
    except PeerError as e:
        return fail(f"{m['label']} is off: {e}")
    if status != 200 or not d.get("id"):
        return fail(d.get("error") or f"{m['label']} couldn't start it ({status})")
    print(f"{m['name']}:{d['id']}")
    return 0


# ------------------------------------------------------------------ sleep
#
# A session you're not using sleeps, with only a badge on its Claude's screen
# saying so (sleep_badge): its Claude Code exits, so it holds no memory, and
# everything else stays as it was. Claude is stopped outright (SIGKILL), so it
# never gets to put the terminal back: its last screen stays in its tmux pane,
# the conversation, its prompt and the cursor in it. Type there (in Claude's
# terminal in a browser) and a stand-in for that prompt (woke) shows what you type
# right where Claude would; send it (Enter) and Claude comes back with it
# (`claude --resume <conversation> -- <message>`), its first screen replacing
# the old one in a single repaint. Anything the stand-in doesn't do (arrows,
# Ctrl keys, a new line, scrolling, a line too long) brings Claude back at
# once, with what you typed already in its prompt (--prefill). A message typed
# in the prompt of a classic terminal keeps it awake instead (sleep_blockers):
# nothing hands it over.
#
# A session whose tmux is gone (after a reboot) comes back asleep as well:
# there's no screen of Claude's to keep then, so amarchy draws the
# conversation and a prompt like Claude's, and the stand-in works the same.
# Sending it something from the phone or `amarchy send` wakes it with that
# as Claude's first message.
#
# What would be lost with Claude's process keeps a session awake: a turn in
# progress, a question waiting for you, commands running in the background,
# background agents still working, a /loop or a scheduled task, Remote Control.
# The timer (`amarchy sleep --idle`, every 30s from a systemd user timer) puts
# sessions to sleep once they've been idle, and open on no phone or browser,
# for `sleep --after` minutes.

SLEEP_AFTER_DEFAULT = 1         # minutes
QUIET = 30                      # seconds the conversation has to have been still
BUSY_CPU = 0.05                 # share of a core above which an idle-looking Claude is still doing something


def sleep_after():
    """Minutes a session waits, idle and open nowhere, before it sleeps (None: never)."""
    try:
        value = SLEEP_AFTER.read_text().strip()
    except OSError:
        return SLEEP_AFTER_DEFAULT
    if value == "off":
        return None
    try:
        return max(float(value), 0)
    except ValueError:
        return SLEEP_AFTER_DEFAULT


def asleep_since(sid):
    """When the session went to sleep, or None while it's awake."""
    try:
        return (claude_dir(sid) / "asleep").stat().st_mtime
    except OSError:
        return None


# How a sleeping session's pane looks: Claude's own last screen, still there
# ("frozen"), or one amarchy draws (a pane that started with Claude asleep).
FROZEN, DRAWN = "frozen", "drawn"


def mark_asleep(sid, look=DRAWN):
    write_file(claude_dir(sid) / "asleep", f"{time.strftime('%Y-%m-%d %H:%M:%S')}\n{look}\n")


def asleep_look(sid):
    try:
        lines = (claude_dir(sid) / "asleep").read_text().split("\n")
    except OSError:
        return None
    return lines[1] if len(lines) > 1 and lines[1] in (FROZEN, DRAWN) else DRAWN


def clear_asleep(sid):
    (claude_dir(sid) / "asleep").unlink(missing_ok=True)


def asleep_if_gone(s):
    """A session whose Claude's tmux is gone (the machine restarted, or its
    user's systemd did) with no mark saying it sleeps: asleep, as attaching
    to it would say (host_start), so waking it and sending it something
    start its Claude again instead of waiting on a pane that isn't there.
    Whether it was."""
    sid = s["id"]
    if (s.get("setup") or asleep_since(sid) is not None or waking_now(sid) or not Path(s["path"]).is_dir()
            or (CLOSING / f"{sid}.json").exists() or tmux_has(tmux_name(sid))):
        return False
    mark_asleep(sid)
    return True


WAKING = 60     # seconds a session counts as waking until its Claude says it's up


def woken(sid):
    """The session isn't asleep any more, and its Claude is on its way: it's
    waking until Claude's SessionStart hook says it's up (or for WAKING)."""
    write_file(claude_dir(sid) / "waking", "")
    clear_asleep(sid)


def waking_now(sid):
    """Whether the session's Claude was woken and isn't up yet."""
    try:
        return time.time() - (claude_dir(sid) / "waking").stat().st_mtime < WAKING
    except OSError:
        return False


def clear_waking(sid):
    (claude_dir(sid) / "waking").unlink(missing_ok=True)


def all_background_sessions():
    """Every Claude Code background session (/bg, `claude --bg`) still
    running, as Claude Code lists them in ~/.claude/sessions."""
    out = []
    for f in (HOME / ".claude/sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if d.get("kind") == "bg" and d.get("pid") and Path(f"/proc/{d['pid']}").exists():
            out.append(d)
    return out


def background_sessions(s, every=None):
    """The background sessions started in this session's worktree (of every,
    if they were already read)."""
    return [d for d in (all_background_sessions() if every is None else every)
            if (d.get("cwd") or "") == s["path"] or (d.get("cwd") or "").startswith(s["path"] + "/")]


# A background command that serves rather than finishes: a dev server, a
# watcher, a log followed. It runs until it's stopped, so it doesn't keep its
# chat "Running" (Claude isn't waiting on it to go on); it's "Serving". Told
# by what Claude called it (the task's description: "Start the dev server",
# "Serve the app on port 8080") or by the command itself (npm run dev, vite,
# python -m http.server, uvicorn...). A test run that starts a server of its
# own on the way (Playwright's webServer) is still a run: its command and
# its description say test, not serve.
SERVING_SAID = re.compile(r"(?:\b(?:dev|web|http|app|api|static|local|preview|file)[ -]?server\b"
                          r"|\b(?:start|starting|run|running|launch|launching|boot|restart|restarting)s?\s+(?:the\s+|a\s+)?(?:[\w-]+\s+){0,2}server\b"
                          r"|\bserv(?:e|es|ing)\b|\bon port \d+|\btail(?:ing)? the logs?\b)"
                          r"(?!(?:'s)?\s+(?:tests?|specs?|e2e|checks?|suite|build)\b)", re.I)
SERVING_NOT = re.compile(r"\b(?:tests?|testing|e2e|specs?|checks?|suite|build|lint|playwright|pytest|benchmark)\b", re.I)
SERVING_RUN = re.compile(r"\b(?:npm|pnpm|yarn|bun)\s+(?:run\s+)?(?:dev|start|serve|preview|watch)\b"
                         r"|\bvite\s*(?:$|[;&|])|\b(?:vite|next|nuxt|astro)\s+(?:dev|preview|start)\b"
                         r"|http\.server|\brunserver\b|\b(?:uvicorn|gunicorn|hypercorn|nodemon|live-server|webpack-dev-server)\b"
                         r"|\bflask\s+run\b|\brails\s+s(?:erver)?\b|\bphp\s+-S\b|\bjekyll\s+serve\b|\bhugo\s+server\b"
                         r"|\bamarchy\s+app\s+serve\b|--watch\b|\btail\s+-[fF]\b|\bjournalctl\b.*\s-f\b", re.I)
# What waits for something to end, whatever else it says: a run, never a
# server, though its command has --watch in it (`gh pr checks 310 --watch`) or
# Claude called it watching ("Watch the PR's CI checks until they finish").
# Claude goes on when it ends: its chat is Running, kept awake until then.
RUNS_SAID = re.compile(r"\buntil\b|\bwait(?:s|ing)?\s+(?:for|on|until)\b", re.I)
RUNS_CMD = re.compile(r"\bgh\s+(?:pr\s+checks|run\s+watch)\b|\bkubectl\s+(?:rollout\s+status|wait)\b"
                      r"|--exit-status\b", re.I)
_task_commands = {}     # task id -> its command ("" not found yet: (at, "") to look again later)


def task_command(task_id):
    """The command a background Bash task runs: its shell's, the one whose
    output goes to Claude Code's tasks/<id>.output (its stdout). "" when
    it can't be found (gone, or not a Bash task). Looked up once, and again
    no sooner than a minute after it wasn't found."""
    if not task_id or not re.fullmatch(r"[\w-]{1,64}", task_id):
        return ""
    known = _task_commands.get(task_id)
    if known is not None and (known[1] or time.time() - known[0] < 60):
        return known[1]
    found = ""
    end = f"/tasks/{task_id}.output"
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            if not os.readlink(f"/proc/{d}/fd/1").endswith(end):
                continue
        except OSError:
            continue
        line = " ".join(cmdline(d))
        if "eval " in line:
            found = re.sub(r"^.*?&& eval '?|'? < /dev/null.*$|' && pwd -P.*$", "", line, flags=re.S)
            break
        found = found or line
    if len(_task_commands) > 500:
        _task_commands.clear()
    _task_commands[task_id] = (time.time(), found)
    return found


def task_serves(t):
    """Whether a background task serves (a dev server, a watcher) rather than
    runs to an end: see SERVING_SAID. Helpers (subagents) and watches
    (Monitor) end, and Claude goes on when they do. By its command as the
    chat engine kept it (the Bash call's, so the same whether it still runs
    or not), else as its shell has it."""
    if t.get("task_type") != "local_bash":
        return False
    said = t.get("description") or ""
    command = t.get("command") or task_command(t.get("task_id") or "")
    # What says it waits for an end ("until they finish", gh pr checks --watch) runs.
    if RUNS_SAID.search(said) or RUNS_CMD.search(command):
        return False
    # "Run e2e against the dev server" is a test run: when in doubt, it runs
    # (a chat left Running costs less than a run stopped halfway).
    return bool((SERVING_SAID.search(said) and not SERVING_NOT.search(said)) or SERVING_RUN.search(command))


def task_words(t):
    return " ".join(str(t.get("description") or t.get("summary") or t.get("command") or t.get("subagent_type")
                        or "a task in the background").split())[:200]


def background_runs(tasks, bgs):
    """What a session has going in the background, split in two: what runs
    to an end, and Claude goes on when it does (a test run, a build, a
    helper, a busy /bg session), and what serves until it's stopped (a dev
    server: task_serves). The words for each, in order."""
    runs, serves = [], []
    for t in tasks:
        if isinstance(t, dict):
            (serves if task_serves(t) else runs).append(task_words(t))
    for d in bgs:
        if d.get("status") not in (None, "", "idle"):
            runs.append(" ".join(str(d.get("name") or "a background session").split())[:200])
    return runs, serves


def stop_background(s, only_idle=True):
    """Stop the session's background sessions (all of them, or those with
    nothing to do). Claude Code keeps their conversations: `claude attach`
    brings one back. Returns how many it stopped."""
    stopped = 0
    for d in background_sessions(s):
        if only_idle and d.get("status") != "idle":
            continue
        try:
            exe = os.readlink(f"/proc/{d['pid']}/exe").removesuffix(" (deleted)")
        except OSError:
            exe = ""
        exe = exe if exe and os.path.exists(exe) else shutil.which("claude")
        job = d.get("jobId") or d.get("sessionId", "")[:8]
        if not exe or not job:
            continue
        try:
            r = subprocess.run([exe, "stop", job], capture_output=True, text=True, timeout=20,
                               stdin=subprocess.DEVNULL, env=clean_env())
        except subprocess.TimeoutExpired:
            continue
        stopped += r.returncode == 0
    return stopped


def conversation_records(f, tail=None):
    """The records of a conversation file, the last `tail` bytes of it only if given."""
    try:
        with open(f, "rb") as fh:
            if tail and fh.seek(0, 2) > tail:
                fh.seek(-tail, 2)
                fh.readline()       # most likely cut in half
            else:
                fh.seek(0)          # all of it: its first line is whole
            data = fh.read()
    except OSError:
        return []
    out = []
    for line in data.splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def tool_uses(records):
    for r in records:
        if r.get("type") == "assistant":
            for block in r.get("message", {}).get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    yield r, block


def timestamp(record):
    try:
        return calendar.timegm(time.strptime(record["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
    except (KeyError, ValueError, TypeError):
        return 0


def proc_started(pid):
    """When a process started (clock ticks since boot): with its pid, which
    process it is, so a pid used again by a new one isn't taken for it."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    return int(stat[stat.rfind(")") + 2:].split()[19])


def stop_processes(pids, wait=5):
    """Stop these processes: SIGTERM (a whole process group at once when all
    of it is among them), then SIGKILL for what's still there after `wait`
    seconds. Never this process or what started it. How many it stopped."""
    procs = processes()
    spared, pid = set(), os.getpid()
    while pid > 1 and pid not in spared:
        spared.add(pid)
        pid = procs.get(pid, (0,))[0]
    found = {p: proc_started(p) for p in pids if p in procs and p not in spared and p > 1}
    found = {p: t for p, t in found.items() if t is not None}
    if not found:
        return 0
    groups = {}
    for p in procs:
        try:
            groups.setdefault(os.getpgid(p), set()).add(p)
        except OSError:
            pass
    for p in found:
        try:
            g = os.getpgid(p)
        except OSError:
            continue
        if g > 1 and groups.get(g, set()) <= found.keys():
            try:
                os.killpg(g, 15)
                continue
            except OSError:
                pass
        try:
            os.kill(p, 15)
        except OSError:
            pass

    def running(p):
        try:
            stat = Path(f"/proc/{p}/stat").read_text()
        except OSError:
            return False
        # A zombie only waits for its parent; a new process may have its pid.
        return stat[stat.rfind(")") + 2] != "Z" and proc_started(p) == found[p]

    end = time.time() + wait
    while time.time() < end and any(running(p) for p in found):
        time.sleep(0.1)
    for p in found:
        if running(p):
            try:
                os.kill(p, 9)
            except OSError:
                pass
    return len(found)


def pane_scope(pid):
    """The cgroup of a tmux pane's process, when the pane has one of its own
    (systemd gives each a tmux-spawn-*.scope): everything started in the
    pane stays in it, what was let go of too (`(pnpm dev &)`, a browser a
    script left behind). None otherwise: panes share tmux's then."""
    try:
        lines = Path(f"/proc/{pid}/cgroup").read_text().splitlines()
    except OSError:
        return None
    path = next((l[3:] for l in lines if l.startswith("0::")), "")
    name = path.rsplit("/", 1)[-1]
    if not (name.startswith("tmux-spawn-") and name.endswith(".scope")):
        return None
    return Path("/sys/fs/cgroup" + path)


def scope_pids(scope):
    try:
        return {int(x) for x in (scope / "cgroup.procs").read_text().split()} if scope else set()
    except (OSError, ValueError):
        return set()


def term_pane(s):
    """The pid of a session's terminal pane's process (its shell), or None."""
    pid = tmux("display-message", "-p", "-t", f"={tmux_name(s['id'], 'term')}:", "#{pane_pid}").stdout.strip()
    return int(pid) if pid.isdigit() else None


def in_tree(path, procs):
    """The processes whose working directory or executable is in a folder."""
    inside = str(path).rstrip("/") + "/"
    out = set()
    for p in procs:
        for link in ("cwd", "exe"):
            try:
                target = os.readlink(f"/proc/{p}/{link}").removesuffix(" (deleted)")
            except OSError:       # gone, or not ours
                continue
            if (target + "/").startswith(inside):
                out.add(p)
                break
    return out


AMARCHY_OWN = {"send", "reap", "claude-reload", "shorten", "protocol-check", "dictation", "move"}


def amarchy_own(pid):
    """Whether a process is amarchy's own work, started from a pane and let go
    of (closing another session, a message on its way): never a session's to stop."""
    line = cmdline(pid)
    return any(Path(a).name == "amarchy" and line[i + 1:i + 2] and line[i + 1] in AMARCHY_OWN
               for i, a in enumerate(line[:3]))


def left_running(s, procs, pane=None, claude=None):
    """What a session leaves running besides its Claude: the dev servers,
    watchers and browsers its Claude started and let go of (still in its
    pane's scope, outside the pane's loop), its Claude's background commands
    (a `pnpm dev` with run_in_background), and what runs in its terminal (its
    run command), the terminal's shell aside. Claude's MCP servers aren't
    among them: they go with Claude. The pids."""
    out = set()
    pane = pane or host_pane(s)
    if pane:
        loop = pane["pid"]
        family = {loop, *descendants(loop, procs)}      # the loop and what it runs: Claude, its broker, the wait for a key
        scope = pane_scope(loop)
        if scope:
            out |= scope_pids(scope) - family
        else:       # no scope of its own: what runs from its worktree, outside the loop
            out |= in_tree(s["path"], procs) - family
    if claude:
        for p in descendants(claude, procs):
            if "/shell-snapshots/" in " ".join(cmdline(p)):
                out |= {p, *descendants(p, procs)}
    term = term_pane(s)
    if term and term in procs:
        out |= set(descendants(term, procs)) | scope_pids(pane_scope(term))
    # Never a Claude (nor what it runs) that isn't this session's own: a
    # pane's scope holds its own only, but should one ever hold another's,
    # that one is awake.
    claudes = {p for p in out if procs.get(p, (0, ""))[1] == "claude" and p != claude}
    for c in list(claudes):
        claudes |= set(descendants(c, procs))
    # Its previews are the chat's, not its Claude's: they stay (preview_tend
    # stops one when it's gone unused).
    preview = chat_preview_pids(s)
    return {p for p in out if p in procs and p != term and p not in claudes and p not in preview and not amarchy_own(p)}


def tcp_sockets():
    """Every TCP socket: [(state, (local address, port), (remote address, port), inode)],
    addresses as the kernel writes them (hex)."""
    out = []
    for name in ("tcp", "tcp6"):
        try:
            lines = Path(f"/proc/net/{name}").read_text().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            f = line.split()
            if len(f) < 10:
                continue
            (la, lp), (ra, rp) = f[1].split(":"), f[2].split(":")
            out.append((f[3], (la, int(lp, 16)), (ra, int(rp, 16)), f[9]))
    return out


def loopback(address):
    return (address[-2:] == "7F" if len(address) == 8 else
            address == "0" * 24 + "01000000" or (address.startswith("0" * 16 + "FFFF0000") and address[-2:] == "7F"))


def watched(pids):
    """Whether you have a page of what these processes serve open: a port one
    of them listens on has a connection in from another machine (a browser
    on your phone or computer: a dev server's page holds its live-reload
    connection open while it's open)."""
    inodes = set()
    for p in pids:
        try:
            for fd in os.listdir(f"/proc/{p}/fd"):
                try:
                    link = os.readlink(f"/proc/{p}/fd/{fd}")
                except OSError:
                    continue
                if link.startswith("socket:["):
                    inodes.add(link[8:-1])
        except OSError:
            continue
    if not inodes:
        return False
    sockets = tcp_sockets()
    ports = {local[1] for state, local, _, inode in sockets if state == "0A" and inode in inodes}
    return any(state == "01" and local[1] in ports and not loopback(remote[0]) and remote[0] != local[0]
               for state, local, remote, _ in sockets)


def stop_left_running(s, procs=None):
    """Stop what a sleeping session left running (left_running), unless you
    have a page of it open (watched): then it's kept, and the sleep timer
    looks again. Returns how many it stopped, or None if it kept them."""
    procs = procs or processes()
    pane = host_pane(s)
    # Only a session that sleeps, its Claude gone: never one that's awake.
    if asleep_since(s["id"]) is None or waking_now(s["id"]) or not pane or pane_claude(pane, procs):
        return 0
    left = left_running(s, procs, pane)
    if not left:
        return 0
    if watched(left):
        return None
    return stop_processes(left)


def shell_serves(pid, tasks=()):
    """Whether a background command of Claude's serves rather than runs to an
    end (a dev server, a watcher: task_serves): by its task (the one its
    output goes to) on the chat engine, else by the command itself."""
    try:
        out = os.readlink(f"/proc/{pid}/fd/1")
    except OSError:
        out = ""
    m = re.search(r"/tasks/([\w-]{1,64})\.output$", out)
    task = next((t for t in tasks if isinstance(t, dict) and m and t.get("task_id") == m.group(1)), None)
    if task:
        return task_serves(task)
    command = re.sub(r"^.*?&& eval '?|'? < /dev/null.*$|' && pwd -P.*$", "", " ".join(cmdline(pid)), flags=re.S)
    return bool(SERVING_RUN.search(command)) and not RUNS_CMD.search(command)


def sleep_blockers(s, pane, procs, auto):
    """Why the session's Claude had better not exit now, if anything: what
    it would lose. Empty when it can sleep."""
    reasons = []
    sid = s["id"]
    pid = pane_claude(pane, procs)
    status = (STATUS / sid).read_text().strip() if (STATUS / sid).exists() else "idle"
    if status == "working":
        reasons.append("it's working")
    elif status == "waiting":
        reasons.append("it's waiting for your answer")
    if not pid:
        return reasons + ["Claude isn't running in its pane"]
    if engine(s) == "terminal" and claude_prompt(s):
        # What's typed in a classic terminal's prompt would go with it: it waits for you.
        reasons.append("a message is typed in its prompt")
    live = agent_live(sid) if engine(s) == "chat" else {}
    if engine(s) == "chat":
        if live.get("pending") and status != "waiting":
            reasons.append("it's waiting for your answer")
        # What only serves (a dev server) doesn't keep it awake: it's stopped
        # with it (put_to_sleep), unless you have its page open.
        runs = [t for t in live_tasks(live) if not task_serves(t)]
        if runs:
            reasons.append(f"a task is running in the background ({runs[0].get('description') or ''})")
        if live.get("queue"):
            reasons.append("a message is waiting to go in")
    shells = [p for p in descendants(pid, procs) if "/shell-snapshots/" in " ".join(cmdline(p))
              and not shell_serves(p, live_tasks(live))]
    if shells:
        command = " ".join(cmdline(shells[0]))
        command = re.sub(r"^.*?&& eval '?|'? < /dev/null.*$|' && pwd -P.*$", "", command)[:60]
        reasons.append(f"a command is running in the background ({command})" if command else
                       "a command is running in the background")
    f = transcript(s)
    if f:
        subagents = f.with_suffix("") / "subagents"
        files = [f, *(subagents.glob("*.jsonl") if subagents.is_dir() else [])]
        latest = max((x.stat().st_mtime for x in files if x.exists()), default=0)
        if time.time() - latest < QUIET:
            reasons.append("its conversation is still moving")
        if (f.with_suffix("") / "bridge-pointer.json").exists():
            reasons.append("Remote Control is on")
        records = conversation_records(f, tail=4_000_000)
        wakes, crons = None, 0
        for r, use in tool_uses(records):
            given = use.get("input") or {}
            if use.get("name") == "ScheduleWakeup":
                wakes = None if given.get("stop") else timestamp(r) + float(given.get("delaySeconds") or 0)
            elif use.get("name") == "CronCreate" and time.time() - timestamp(r) < 7 * 86400:
                crons += 1
            elif use.get("name") == "CronDelete":
                crons = max(crons - 1, 0)
        if wakes and wakes + 120 > time.time():
            reasons.append(f"a /loop wakes it again at {time.strftime('%H:%M', time.localtime(wakes))}")
        if crons:
            reasons.append("it has scheduled tasks")
    if auto:
        # Busy without a sign of it anywhere else (a background agent thinking, say).
        sample = claude_dir(sid) / "cpu"
        try:
            was_pid, was_ticks, was_at = json.loads(sample.read_text())
        except (OSError, ValueError):
            was_pid, was_ticks, was_at = None, 0, 0
        ticks, now = procs[pid][2], time.time()
        write_file(sample, json.dumps([pid, ticks, now]))
        if was_pid != pid or now - was_at > 600:
            reasons.append("amarchy is still getting a sense of how busy it is")
        elif (ticks - was_ticks) / os.sysconf("SC_CLK_TCK") / max(now - was_at, 1) > BUSY_CPU:
            reasons.append("it's busy")
    return reasons


def put_to_sleep(s, auto=False, force=False):
    """Stop a session's Claude Code, keeping the session as it was. Returns
    None once it sleeps, else why it didn't."""
    sid = s["id"]
    if s.get("setup"):
        return "it's still being set up"
    pane = host_pane(s)
    if not pane:
        if asleep_since(sid) is None:
            mark_asleep(sid)
        return None
    if asleep_since(sid) is not None:
        return None
    procs = processes()
    reasons = sleep_blockers(s, pane, procs, auto)
    if reasons and not force:
        return "; ".join(reasons)
    pid = pane_claude(pane, procs)
    loop = pane_loop(pane, procs)
    # What it leaves running (a dev server, a headless browser) goes with it,
    # unless you have a page of it open: then it stays, and the timer looks
    # again once you've closed it (sleep_idle).
    left = left_running(s, procs, pane, pid)
    held = left if left and watched(left) else set()
    try:
        set_conversation_id(sid, json.loads((HOME / f".claude/sessions/{pid}.json").read_text()).get("sessionId", ""))
    except (OSError, ValueError, TypeError):
        pass
    mark_asleep(sid, FROZEN if loop else DRAWN)
    clear_waking(sid)
    try:
        stop_background(s)
        gone = freeze_claude(pid, procs, spare=held) if pid else set()
    except BaseException:
        clear_asleep(sid)       # it isn't asleep: say so, for whoever tries next
        raise
    if not loop:
        host_respawn(s)         # on the loop that sleeps, showing the conversation as amarchy draws it
    stop_processes((gone | left) - held)
    return None


def freeze_claude(pid, procs, spare=()):
    """Stop a Claude Code at once, before it can put the terminal back (its
    last screen stays), then what it ran (MCP servers, but what's in spare)
    and what it leaves in ~/.claude/sessions. It's idle: its conversation is
    all written already. Returns what it ran, sent SIGTERM, for
    stop_processes to see to the end."""
    children = [p for p in descendants(pid, procs) if p not in spare]
    try:
        info = json.loads((HOME / f".claude/sessions/{pid}.json").read_text())
    except (OSError, ValueError):
        info = {}
    try:
        os.kill(pid, 9)
    except ProcessLookupError:
        pass
    end = time.time() + 3
    while time.time() < end and Path(f"/proc/{pid}").exists():
        time.sleep(0.05)
    for p in children:
        try:
            os.kill(p, 15)
        except ProcessLookupError:
            pass
    if info.get("pid") == pid:
        (HOME / f".claude/sessions/{pid}.json").unlink(missing_ok=True)
        for key in (HOME / ".claude/sessions").glob(f"{pid}.*.key"):
            key.unlink(missing_ok=True)
        if info.get("messagingSocketPath"):
            Path(info["messagingSocketPath"]).unlink(missing_ok=True)
    return set(children)


def wake(s):
    """Start a sleeping session's Claude again, in its tmux pane (starting
    its tmux if it's gone)."""
    sid = s["id"]
    if asleep_since(sid) is None and not asleep_if_gone(s):
        return
    woken(sid)
    pane = host_pane(s)
    if not pane:
        host_start(s, wake=True)
    else:
        # The pane's loop waits for a key: stop waiting, as if one came.
        end = time.time() + 3
        while time.time() < end:
            procs = processes()
            loop = pane_loop(pane, procs)
            readers = [p for p in descendants(loop, procs) if procs[p][1] == "dd"] if loop else []
            for p in readers:
                os.kill(p, 15)
            if readers:
                break
            if not loop:        # a pane from before sessions slept, at "Press Enter"
                tmux("send-keys", "-t", f"={tmux_name(sid)}:", "Enter")
                break
            time.sleep(0.1)


def sleep_lock(wait):
    """One sleeper at a time, the timer or you: the held lock. The timer
    doesn't wait (None: it's running already); you wait for it."""
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "sleep.lock", "a")
    end = time.time() + (30 if wait else 0)
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except OSError:
            if time.time() >= end:
                lock.close()
                return None
            time.sleep(0.2)


def sleep_all(force=False):
    """Every session that can sleep and is open nowhere goes to sleep now:
    (the ids that did, [(id, why not)] for the ones kept awake). Called with
    the sleep lock held."""
    shown, slept, kept = on_screen()[0], [], []
    for s in session_view():
        if s["awake"] and not s["sleeping"] and s["id"] not in shown and s["status"] in ("idle", "waiting"):
            err = put_to_sleep(session(s["id"]), force=force)
            if err:
                kept.append((s["id"], err))
            else:
                slept.append(s["id"])
    return slept, kept


def cmd_sleep(args):
    """`amarchy sleep [id] [--force]`, `--all`, `--idle` (the timer),
    `--after [minutes|off]`."""
    force = "--force" in args
    rest = [a for a in args if a != "--force"]
    if rest[:1] == ["--after"]:
        if len(rest) == 1:
            after = sleep_after()
            print("off" if after is None else f"{after:g}")
            return 0
        value = rest[1].lower()
        try:
            if value != "off" and float(value) < 0:
                raise ValueError
        except ValueError:
            return fail("usage: amarchy sleep --after <minutes>|off")
        write_file(SLEEP_AFTER, value + "\n")
        return 0
    idle = rest[:1] == ["--idle"]
    lock = sleep_lock(wait=not idle)
    if not lock:
        return 0 if idle else fail("another amarchy is putting sessions to sleep")
    with lock:
        if idle:
            follow_engines()
            return sleep_idle()
        if rest[:1] == ["--all"]:
            slept, kept = sleep_all(force)
            for sid, err in kept:
                print(f"{sid}: awake, {err}")
            print(f"{len(slept)} session{'s' if len(slept) != 1 else ''} asleep"
                  + (f", {len(kept)} kept awake" if kept else ""))
            return 0
        sid = rest[0] if rest else own_session_id()
        s = session(sid) if sid else None
        if not s:
            return fail(f"No session {sid!r}" if sid else "Not in a session (name one: amarchy sleep <id>)")
        err = put_to_sleep(s, force=force)
        if err:
            print(f"{s['repo']} · {s['name']} stays awake: {err}"
                  + ("" if force else ". amarchy sleep --force puts it to sleep anyway."))
            return 1
        return 0


def sleep_idle():
    """What the timer does: every session that has been idle and open on no
    phone or browser (on_screen) for long enough goes to sleep, if nothing
    would be lost. The time counts from when it was last open on one, if
    that's later."""
    try:
        preview_tend()
    except OSError as e:
        print(f"amarchy: couldn't look after the previews: {e}", file=sys.stderr)
    after = sleep_after()
    if after is None:
        return 0
    shown, last = on_screen()
    for s in session_view():
        if not s["awake"]:
            asleep_if_gone(session(s["id"]) or s)      # after a restart: asleep, so it wakes
            continue
        if s["id"] in shown:
            continue
        if s["sleeping"]:
            # Asleep: what it still leaves running (kept while you had its
            # page open, or started in its terminal since) stops too, once
            # it's been off your screens as long.
            if asleep_since(s["id"]) is not None and time.time() - last.get(s["id"], 0) >= after * 60:
                stop_left_running(session(s["id"]))
            continue
        if s["status"] not in ("idle", "waiting"):
            continue
        try:
            since = (STATUS / s["id"]).stat().st_mtime
        except OSError:
            since = 0
        if time.time() - max(since, last.get(s["id"], 0)) >= after * 60:
            put_to_sleep(session(s["id"]), auto=True)
    return 0


def on_screen():
    """The sessions open on a device now (their conversation on a phone,
    their terminals in a browser), as the app's server keeps them in
    APP_VIEWING, and when each was last open on one: (ids, {id: time})."""
    try:
        d = json.loads(APP_VIEWING.read_text())
    except (OSError, ValueError):
        d = {}
    d = d if isinstance(d, dict) else {}
    last = {k: v for k, v in (d.get("at") if isinstance(d.get("at"), dict) else {}).items()
            if isinstance(v, (int, float))}
    # A server that's gone (restarting, say) shows nothing anymore.
    up = isinstance(d.get("pid"), int) and Path(f"/proc/{d['pid']}").exists()
    shown = {x for x in d.get("open") or [] if isinstance(x, str)} if up else set()
    return shown | {k for k, v in last.items() if time.time() - v < APP_SEEN}, last


def cmd_wake(args):
    sid = args[0] if args else own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one: amarchy wake <id>)")
    wake(s)
    return 0


# The badge in the top right corner of a sleeping session's Claude: what you
# see instead of a status glyph (the list keeps showing the session as idle).
# It says the session is asleep, and the moment a key wakes it, that Claude
# is on its way, for the second or so until Claude's first screen covers it.
ASLEEP_BADGE = "Asleep, its memory freed · type to wake"
TYPING_BADGE = "Asleep · Enter wakes Claude with this"
WAKING_BADGE = "Waking Claude…"


def sleep_badge(text, loud=False):
    """Draw the badge, leaving the cursor where it was: dim while the session
    sleeps, in reverse video while it wakes."""
    try:
        width = os.get_terminal_size(1).columns
    except OSError:
        return
    label = f" 󰒲 {text} "
    if text_width(label) + 2 > width:
        label = " 󰒲 "
    col = max(width - text_width(label), 1)
    style = "\033[1;7m" if loud else "\033[2;7m"
    os.write(1, f"\0337\033[1;{col}H{style}{label}\033[0m\0338".encode())


# What a waking pane turns off for the second before Claude is back:
# mouse reports (the rest of a scroll would pile up and land in Claude as keys)
# and the alternate scroll mode a terminal falls back to without them (the
# wheel as arrow keys, which Claude's prompt takes for its history). Claude
# turns the mouse back on as it starts.
MOUSE_OFF = b"\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l\033[?1007l"


def cmd_asleep(sid):
    """The pane loop, once Claude has exited: 0 if the session sleeps (the
    pane keeps showing it), 1 if Claude was quit (the loop then offers to
    start it again: held)."""
    s = session(sid)
    if not s:
        return 1
    if asleep_since(sid) is None:
        # Woken as Claude was stopped, before this got here: on to the wait
        # for a key, which wake() ends (it looks for it a moment).
        return 0 if waking_now(sid) else 1
    out = sys.stdout
    if asleep_look(sid) == FROZEN:
        # Claude's screen stays as it was. Only what would now come in without
        # Claude to take it is turned off: mouse movement and focus changes.
        # The wheel and clicks still report, as they did to Claude: they wake it.
        out.write("\033[?1003l\033[?1002l\033[?1004l\033[?2004h")
        out.flush()
        sleep_badge(ASLEEP_BADGE)
        return 0
    sh("stty", "sane")
    try:
        width = os.get_terminal_size().columns
    except OSError:
        width = 100
    draft = (claude_dir(sid) / "draft").read_text() if (claude_dir(sid) / "draft").exists() else ""
    lines = draft.rstrip("\n").split("\n")
    rule = f"\033[2m{'─' * width}\033[0m"
    out.write("\033[H\033[2J\033[3J")
    out.write(f"\033]0;{session_task(s, '') or s['repo'] + ' · ' + s['name']}\007")
    out.write("".join(line + "\n" for line in conversation_lines(s, width)))
    out.write(f"\n{rule}\n\033[1m❯\033[0m {lines[0]}\n" + "".join(f"  {line}\n" for line in lines[1:]))
    out.write(f"{rule}\n\033[2m  ? for shortcuts\033[0m")
    # The cursor where Claude's would be, at the end of the prompt; keys come
    # in the way Claude asks for them (kitty's protocol, pastes bracketed).
    out.write(f"\033[2A\r\033[{2 + text_width(lines[-1])}C\033[>5u\033[?2004h")
    out.flush()
    sleep_badge(ASLEEP_BADGE)
    return 0


def text_width(text):
    """Columns a text takes in a terminal."""
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
               for c in text)


def next_key(buf):
    """The first key in what the terminal sent: (kind, bytes), and the rest.
    kind is None when the key isn't all there yet."""
    if not buf:
        return None, buf
    if buf.startswith(b"\x1b[200~"):
        end = buf.find(b"\x1b[201~")
        return (("paste", buf[6:end]), buf[end + 6:]) if end >= 0 else (None, buf)
    if buf.startswith(b"\x1b["):
        m = re.match(rb"\x1b\[[\x30-\x3f]*[\x20-\x2f]*[\x40-\x7e]", buf)
        return (("csi", m.group()), buf[m.end():]) if m else (None, buf)
    if buf.startswith(b"\x1b"):
        return (("esc", buf[:2]), buf[2:]) if len(buf) > 1 else (None, buf)
    size = 1 if buf[0] < 0xc0 else 2 if buf[0] < 0xe0 else 3 if buf[0] < 0xf0 else 4
    if len(buf) < size:
        return None, buf
    return ("char", buf[:size]), buf[size:]


TYPING_IDLE = 120       # seconds typing in a sleeping session can pause before it sleeps on


def waking(keep_typing=False):
    """A sleeping pane, the moment it starts waking: the badge says so, the
    mouse stops reporting until Claude is back, and what came in meanwhile
    is taken off the terminal so Claude doesn't get it as keys. What was typed
    there (the text, if keep_typing) is returned to go in Claude's prompt;
    a scroll or a click is dropped (Claude's own screen takes the next one)."""
    os.write(1, MOUSE_OFF)
    sleep_badge(WAKING_BADGE, loud=True)
    time.sleep(0.03)            # what was already on its way
    buf, typed = b"", ""
    while select.select([0], [], [], 0)[0]:
        more = os.read(0, 4096)
        if not more:
            break
        buf += more
    while buf:
        token, buf = next_key(buf)
        if token is None:
            break
        kind, raw = token
        if kind == "paste":
            typed += raw.decode(errors="ignore").replace("\r\n", "\n").replace("\r", "\n")
        elif kind == "char" and raw.decode(errors="ignore").isprintable():
            typed += raw.decode(errors="ignore")
    return typed if keep_typing else ""


def cmd_woke(sid, key):
    """The pane loop, once a key came in a sleeping session (or `amarchy
    wake`): a stand-in for Claude's prompt. What you type shows where Claude
    would show it, and Enter brings Claude back with it, sent. Anything else
    (arrows, Ctrl keys, a new line, the wheel, a line too long for the box)
    brings Claude back with what you typed in its prompt. Returns 0 to start
    Claude, 3 to go on sleeping (nothing typed, or a long pause)."""
    d = claude_dir(sid)
    if asleep_since(sid) is None:
        waking()                # woken from outside
        return 0
    buf = bytes.fromhex(key.replace(" ", "").strip()) if key.strip() else b""
    if not buf:
        return 3
    s = session(sid)
    if s and engine(settle_engine(s)) == "chat":
        return woke_chat(sid, buf)
    draft = (d / "draft").read_text() if (d / "draft").exists() else ""
    text = draft.rstrip("\n")

    def read(timeout):
        if not select.select([0], [], [], timeout)[0]:
            return None
        return os.read(0, 4096) or None

    # Where the cursor is (Claude leaves it at the end of its prompt): the
    # terminal's answer comes in among the keys.
    os.write(1, b"\033[6n")
    where, end = None, time.time() + 0.5
    while time.time() < end:
        m = re.search(rb"\x1b\[(\d+);(\d+)R", buf)
        if m:
            where, buf = int(m.group(2)), buf[:m.start()] + buf[m.end():]
            break
        more = read(0.05)
        if more:
            buf += more
    try:
        width = os.get_terminal_size(1).columns
    except OSError:
        width = 100
    # Typing goes on in place only where amarchy knows what's on the line:
    # the cursor right after the prompt's last line ("❯ " or "  " before it).
    in_place = where == 3 + text_width(text.split("\n")[-1])
    edited = False

    def wake(typed):
        typed += waking(keep_typing=True)
        if typed:
            write_file(d / "draft", typed)
        else:
            (d / "draft").unlink(missing_ok=True)
        woken(sid)
        return 0

    while True:
        token, buf = next_key(buf)
        if token is None:
            more = read(TYPING_IDLE if edited else 0.3)
            if more:
                buf += more
                continue
            if buf == b"\x1b":
                token, buf = ("esc", buf), b""
            else:
                # A pause: what's typed stays, as Claude's prompt, until it wakes.
                if edited:
                    write_file(d / "draft", text)
                return 3
        kind, raw = token
        if kind == "paste" or kind == "char" and (raw.decode(errors="ignore").isprintable() or raw == b"\r"):
            typed = raw.decode(errors="ignore").replace("\r\n", "\n").replace("\r", "\n" if kind == "paste" else "\r")
            if typed == "\r":
                if text.strip():
                    waking()
                    write_file(d / "send", text)
                    (d / "draft").unlink(missing_ok=True)
                    woken(sid)
                    return 0
                continue
            if not in_place or "\n" in typed or 3 + text_width(text.split("\n")[-1] + typed) >= width:
                return wake(text + typed)
            if not edited:
                os.write(1, b"\033[K")      # a suggestion Claude showed in the empty prompt
                sleep_badge(TYPING_BADGE)
                edited = True
            os.write(1, typed.encode())
            text += typed
        elif kind == "char" and raw in (b"\x7f", b"\x08"):
            line = text.split("\n")[-1]
            if not in_place or not line and "\n" in text:
                return wake(text)
            if line:
                cols = text_width(line[-1])
                os.write(1, b"\b" * cols + b" " * cols + b"\b" * cols)
                text, edited = text[:-1], True
        elif kind == "csi" and raw[-1:] in b"Mm" and raw.startswith(b"\x1b[<"):
            if int(raw[3:].split(b";")[0] or 0) & 64:
                return wake(text)       # the wheel: Claude scrolls its conversation
        elif kind == "csi" and raw in (b"\x1b[I", b"\x1b[O") or raw.endswith(b"R"):
            continue                    # focus, a late cursor report
        elif kind == "csi" and raw == b"\x1b[13u":
            buf = b"\r" + buf           # Enter, the kitty way
        elif kind == "csi" and re.fullmatch(rb"\x1b\[13;\d+u", raw):
            return wake(text + "\n")    # Shift+Enter and the like: a new line
        else:
            return wake(text)


def woke_chat(sid, buf):
    """cmd_woke for a session on the chat engine: its pane shows the
    conversation as the broker wrote it, with no prompt to stand in for.
    What's typed shows where the cursor is, and Enter brings Claude back with
    it, sent; keys that aren't text do nothing. A pause keeps it (draft)."""
    d = claude_dir(sid)
    text = (d / "draft").read_text() if (d / "draft").exists() else ""
    edited = False

    def read(timeout):
        if not select.select([0], [], [], timeout)[0]:
            return None
        return os.read(0, 4096) or None

    while True:
        token, buf = next_key(buf)
        if token is None:
            more = read(TYPING_IDLE if edited else 0.3)
            if more:
                buf += more
                continue
            if edited:
                write_file(d / "draft", text)
            return 3
        kind, raw = token
        typed = raw.decode(errors="ignore")
        if kind == "char" and raw in (b"\r", b"\n") or kind == "csi" and raw == b"\x1b[13u":
            if text.strip():
                waking()
                write_file(d / "send", text)
                (d / "draft").unlink(missing_ok=True)
                woken(sid)
                return 0
        elif kind == "paste" or kind == "char" and typed.isprintable():
            typed = typed.replace("\r\n", "\n").replace("\r", "\n")
            if not edited:
                sleep_badge(TYPING_BADGE)
                edited = True
            os.write(1, typed.replace("\n", "\r\n").encode())
            text += typed
        elif kind == "char" and raw in (b"\x7f", b"\x08") and text and text[-1] != "\n":
            cols = text_width(text[-1])
            os.write(1, b"\b" * cols + b" " * cols + b"\b" * cols)
            text, edited = text[:-1], True


ANSI = re.compile(r"\x1b\[[0-9;]*m")


def wrap(line, width, hang=""):
    """Wrap a line at spaces to width visible characters (color codes take
    none), the lines after the first indented by hang. Long words are cut."""
    out, current, size = [], "", 0
    for word in re.split(r"(?<=\S)(?= )|(?<= )(?=\S)", line):
        visible = len(ANSI.sub("", word))
        if size + visible > width and current.strip():
            out.append(current.rstrip())
            current, size = hang, len(hang)
            if not word.strip():
                continue
        while size + visible > width and len(word) > 1:
            cut = max(width - size, 1)
            out.append(current + word[:cut])
            word = word[cut:]
            current, size, visible = hang, len(hang), len(ANSI.sub("", word))
        current += word
        size += visible
    return [*out, current.rstrip()]


def conversation_lines(s, width):
    """The conversation as an asleep pane shows it: what you said, what
    Claude answered, a line for each tool it used. The latest part of it, as
    much as fits in the scrollback."""
    f = transcript(s) or latest_conversation(s)
    if not f:
        return ["", "  \033[2mNo conversation yet.\033[0m"]
    records = conversation_records(f, tail=8_000_000)
    by_uuid = {r["uuid"]: r for r in records if r.get("uuid")}
    leaf = next((r for r in reversed(records) if r.get("type") in ("user", "assistant") and r.get("uuid")), None)
    chain, seen = [], set()
    while leaf and leaf["uuid"] not in seen:
        seen.add(leaf["uuid"])
        chain.append(leaf)
        leaf = by_uuid.get(leaf.get("parentUuid"))
    chain.reverse()
    out = []

    def markdown(line):
        """Claude's Markdown, lightly: headings and bold in bold, code in color."""
        if re.match(r"#{1,6} ", line):
            return f"\033[1m{line.lstrip('#').strip()}\033[22m"
        line = re.sub(r"\*\*(.+?)\*\*", "\033[1m\\1\033[22m", line)
        return re.sub(r"`([^`]+)`", "\033[36m\\1\033[39m", line)

    def para(text, first, rest, style="", md=False):
        fence = False
        for i, line in enumerate(text.rstrip().splitlines() or [""]):
            if line.lstrip().startswith("```"):
                fence = not fence
                continue
            # A list item's lines wrap under its text, not under its bullet.
            hang = " " * len(re.match(r"\s*(?:[-*+] |\d+[.)] )?", line).group())
            if md and not fence:
                line = markdown(line)
            elif fence:
                line = f"\033[36m{line}\033[39m"
            wrapped = wrap(line, max(width - len(rest) - 1, 20), hang)
            for j, w in enumerate(wrapped):
                prefix = first if i == 0 and j == 0 else rest
                out.append(f"{style}{prefix}{w}\033[0m" if style else f"{prefix}{w}\033[0m")

    for r in chain:
        if r.get("isMeta") or r.get("isSidechain"):
            continue
        content = r.get("message", {}).get("content")
        if r["type"] == "user":
            if r.get("isCompactSummary"):
                out += ["", "\033[2m  ··· earlier in the conversation (compacted) ···\033[0m"]
                continue
            blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
            for b in blocks:
                if not isinstance(b, dict) or b.get("type") != "text":
                    if isinstance(b, dict) and b.get("type") == "image":
                        out += ["", "\033[1m❯\033[0m [image]"]
                    continue
                text = b.get("text", "")
                command = re.search(r"<command-name>(.*?)</command-name>", text)
                if command:
                    args = re.search(r"<command-args>(.*?)</command-args>", text, re.S)
                    out += ["", f"\033[1m❯ {command.group(1)} {args.group(1).strip() if args else ''}\033[0m"]
                    continue
                if text.startswith(("<local-command", "<system-reminder")):
                    continue
                if text.startswith("<task-notification>"):
                    summary = re.search(r"<summary>(.*?)</summary>", text, re.S)
                    out += ["", f"\033[2m  ⏺ {(summary.group(1) if summary else 'a background task finished').strip()[:width - 6]}\033[0m"]
                    continue
                text = re.sub(r"<pasted_content[^>]*>.*?</pasted_content[^>]*>", "[pasted text]", text, flags=re.S)
                lines = text.strip().splitlines()
                if len(lines) > 30:
                    text = "\n".join(lines[:30] + [f"… {len(lines) - 30} more lines"])
                out.append("")
                para(text, "❯ ", "  ", "\033[1m")
        else:
            for b in content or []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text", "").strip():
                    out.append("")
                    para(b["text"], "● ", "  ", md=True)
                elif b.get("type") == "tool_use":
                    given = b.get("input") or {}
                    detail = next((str(given[k]) for k in ("description", "command", "file_path", "pattern",
                                                           "prompt", "url", "query", "skill") if given.get(k)), "")
                    detail = " ".join(detail.split())
                    line = f"  ⎿ {b.get('name', 'tool')}" + (f"({detail})" if detail else "")
                    out.append(f"\033[2m{line[:width - 1]}\033[0m")
    return out[-3000:]


# ------------------------------------------------------------------ close

def dirty(path):
    return bool(sh("git", "status", "--porcelain", cwd=path).stdout.strip())


PREVIEW_LEFT = "its preview is still running: "     # (one of them, with several)


def close(sid, force=False):
    """Close a session: its row goes at once; then, in the background, its
    Claude Code exits the way it would on its own, its tmux ends, the
    worktree is removed and the branch dropped if merged (reap).

    Returns an error string instead of closing when the worktree has
    uncommitted changes and force is False."""
    s = session(sid)
    if not s:
        return None
    path = Path(s["path"])
    if path.exists() and dirty(path) and not force:
        return "uncommitted changes"
    # Its preview stopped, and nothing of it left behind (its service, a
    # process on one of its ports): else it stays open, to stop that first.
    left = preview_close(s)
    if left:
        return PREVIEW_LEFT + "; ".join(left)
    # Out of the list, and out of reach of everything that reads it (the
    # app, its Claude's hooks, the pane's loop, which then lets its tmux end).
    # The file waits in CLOSING until reap is done with it.
    CLOSING.mkdir(parents=True, exist_ok=True)
    keep = {k: v for k, v in s.items() if k not in VIEW_FIELDS}
    if force:
        keep["force"] = True
    write_file(CLOSING / f"{sid}.json", json.dumps(keep))
    (SESSIONS / f"{sid}.json").unlink(missing_ok=True)
    (STATUS / sid).unlink(missing_ok=True)
    mark_seen(sid)
    mission_done(s)
    detach([ENTRY, "reap", sid])
    return None


def mission_log(rec):
    """A line of what you've done, at the end of MISSIONS: a mission (a chat
    completed, or a task's Done: kind "task"), an all clear ("clear"), a
    question or permission answered ("reply": how long it waited)."""
    try:
        MISSIONS.parent.mkdir(parents=True, exist_ok=True)
        with open(MISSIONS, "a") as f:
            # rid: this record, the same on every machine (see "your stuff on every machine").
            f.write(json.dumps({"at": int(time.time()), **rec, "rid": f"{machine_name()}:{time.time_ns() // 1000}"}) + "\n")
    except OSError as e:
        print(f"amarchy: couldn't write down the mission: {e}", file=sys.stderr)


def mission_done(s):
    """A chat closed (completed), from the app or amarchy close alike: written
    down, with how many merges of its work there were. Only merges count
    toward your score (merge_scan writes each down as it happens); a chat
    completed without one closes without counting. Your assistant's and
    your agents' (they live on), and a worktree still being set up, aren't
    missions at all."""
    if s.get("setup") or is_agent(s):
        return
    try:
        task = session_task(s, "")
    except Exception:
        task = s.get("title") or ""
    try:
        merge_scan([{**s, "task": task}], use_gh=False)       # one just merged here, before it's gone
    except Exception as e:
        print(f"amarchy: couldn't look for its merges: {e}", file=sys.stderr)
    n = len((merges_read().get(s["id"]) or {}).get("merges") or [])
    mission_log({"id": s["id"], "repo": s.get("repo", ""), "task": task, "created": s.get("created"), "merged": n})


# ---- merges: what counts
#
# A mission counts once its change is merged: the chat's branch merged into
# its project's main (amarchy's "ship it": a merge commit "Merge branch
# '<branch>'", or a fast-forward of a commit seen unmerged before), or a
# GitHub pull request from it merged (gh pr list). Every open chat is looked
# at each minute (app_merges, GitHub every two), a closing one once more
# before its worktree goes (reap). Each merge is kept per chat in MERGES (the
# chat's "Merged ✓", in session_view) and, from MISSIONS_SINCE on, written to
# MISSIONS as kind "merge": your score.

MERGES = STATE / "merges.json"                 # chat id -> {merges: [...], pending, branches, since, key}
MERGES_LOCK = STATE / "merges.lock"
MISSIONS_SINCE = STATE / "missions-since"      # merges from then on count (a reset starts it again)
MISSIONS_RESET = STATE / "missions-reset"      # your last reset, on any machine (see "your stuff on every machine")
MERGE_EVERY = 60            # each open chat looked at this often
MERGE_GH_EVERY = 120        # its GitHub pull requests this often
MERGE_RE = re.compile(r"^Merge (?:remote-tracking )?branch '(?:origin/)?([^']+)'")
_merge_gh = {}              # repo -> (when, [merged pull requests])
_merges_seen = {}


def missions_since():
    """When merges started counting: the last reset, else the first look."""
    try:
        return int(MISSIONS_SINCE.read_text().strip())
    except (OSError, ValueError):
        now = int(time.time())
        try:
            write_file(MISSIONS_SINCE, f"{now}\n")
        except OSError:
            pass
        return now


def merges_read():
    """MERGES as it is (read again only when it changed)."""
    try:
        st = MERGES.stat()
        stamp = (st.st_mtime_ns, st.st_size)
    except OSError:
        return {}
    if _merges_seen.get("stamp") != stamp:
        try:
            d = json.loads(MERGES.read_text())
        except (OSError, ValueError):
            d = {}
        _merges_seen.update(stamp=stamp, data=d if isinstance(d, dict) else {})
    return _merges_seen["data"]


def merge_branches(s, path, entry):
    """Every name the chat's work went by: its branch, the one its worktree
    is on now, the ones it moved between (its HEAD's reflog), and those seen
    before (a branch made for a pull request: os-159-sidebar)."""
    names = {s.get("branch") or "", *(entry.get("branches") or [])}
    now = sh("git", "rev-parse", "--abbrev-ref", "HEAD", cwd=path).stdout.strip()
    names.add(now)
    for line in sh("git", "reflog", "-n", "200", "--format=%gs", cwd=path).stdout.splitlines():
        m = re.match(r"checkout: moving from (\S+) to (\S+)$", line)
        if m:
            names.update(m.groups())
    return sorted(n for n in names if n and n != "HEAD" and not re.fullmatch(r"[0-9a-f]{7,40}", n))


def merge_targets(repo_dir, s):
    """What a chat's work merges into, here: its project's main (local and
    origin's) and the base it was made from, those that are there: [(ref, sha)]."""
    base = default_base(repo_dir)
    refs = [base.removeprefix("origin/"), base, s.get("base") or ""]
    out, seen = [], set()
    for ref in refs:
        if not ref or ref == "HEAD" or ref in seen:
            continue
        seen.add(ref)
        sha = sh("git", "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}", cwd=repo_dir).stdout.strip()
        if sha:
            out.append((ref, sha))
    return out


# What in a worktree's reflog is a commit it made: a commit, an amend, a
# merge it made, a rebase's or cherry-pick's new commit (not a fast-forward,
# a reset or a checkout: those are commits made elsewhere).
OWN_COMMIT = re.compile(r"^(commit( \([a-z]+\))?|rebase( -i)? \((pick|continue|squash|fixup|reword|edit)\)|cherry-pick|revert|"
                        r"(merge|pull)\b[^:]*: Merge made)")


def merge_own(path, created):
    """The commits a chat made itself since it opened, oldest first."""
    out, seen = [], set()
    log = sh("git", "reflog", "-n", "500", "--format=%H%x00%gs%x00%ct", "HEAD", cwd=path).stdout
    for line in reversed(log.splitlines()):
        parts = line.split("\0")
        if len(parts) == 3 and parts[0] not in seen and OWN_COMMIT.match(parts[1]) and parts[2].isdigit() \
                and int(parts[2]) >= created - 60:
            seen.add(parts[0])
            out.append(parts[0])
    return out


def merge_when(repo_dir, ref, sha, created):
    """When ref first had sha (its reflog), else now."""
    log = sh("git", "reflog", "show", "-n", "300", "--date=unix", "--format=%H %gd", ref, cwd=repo_dir).stdout
    for line in reversed(log.splitlines()):
        m = re.match(r"([0-9a-f]+) .*@\{(\d+)\}$", line)
        if m and int(m.group(2)) >= created - 60 and is_ancestor(sha, m.group(1), repo_dir):
            return int(m.group(2))
    return int(time.time())


def is_ancestor(a, b, cwd):
    return bool(a and b) and sh("git", "merge-base", "--is-ancestor", a, b, cwd=cwd).returncode == 0


def merge_prs(repo_dir, repo, fresh=False):
    """The project's GitHub pull requests merged lately (gh), every two
    minutes at most (fresh: now): [{number, url, mergedAt, headRefName,
    headRefOid, baseRefName}]. None of them where gh can't tell."""
    was = _merge_gh.get(repo)
    if was and not fresh and time.time() - was[0] < MERGE_GH_EVERY:
        return was[1]
    url = sh("git", "remote", "get-url", "origin", cwd=repo_dir).stdout.strip()
    prs = []
    if "github.com" in url and shutil.which("gh"):
        try:
            r = subprocess.run(["gh", "pr", "list", "--state", "merged", "--limit", "60", "--json",
                                "number,url,mergedAt,headRefName,headRefOid,baseRefName"],
                               cwd=repo_dir, capture_output=True, text=True, timeout=20)
            prs = json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else []
        except (OSError, ValueError, subprocess.TimeoutExpired):
            prs = was[1] if was else []
    _merge_gh[repo] = (time.time(), prs if isinstance(prs, list) else [])
    return _merge_gh[repo][1]


def gh_time(t):
    try:
        return int(datetime.datetime.fromisoformat(t.replace("Z", "+00:00")).timestamp())
    except (AttributeError, ValueError):
        return 0


def merge_found(s, path, repo_dir, entry, use_gh, fresh):
    """What's new of one chat's merges: [{at, tip, via, into, sha?, pr?, url?}],
    and entry brought up to date (its branches, the commit waiting to be
    merged, how many commits since the last merge)."""
    created = int(s.get("created") or 0)
    head = sh("git", "rev-parse", "--verify", "--quiet", "HEAD", cwd=path).stdout.strip()
    if not head:
        return []
    branches = merge_branches(s, path, entry)
    entry["branches"] = branches[-20:]
    targets = merge_targets(repo_dir, s)
    known = entry.setdefault("merges", [])
    tips = {m.get("tip") for m in known}
    found = []

    def covered(tip):
        return tip in tips or any(is_ancestor(tip, t, path) for t in tips if t)

    key = json.dumps([head, targets, branches])
    if key != entry.get("key"):
        # Merge commits into main naming its branch, since it was made.
        shas = set()
        for ref, sha in targets:
            log = sh("git", "log", "--merges", "--first-parent", f"--since=@{max(0, created - 60)}",
                     "--format=%H%x00%P%x00%ct%x00%s", sha, "-n", "200", cwd=repo_dir).stdout
            for line in log.splitlines():
                parts = line.split("\0")
                if len(parts) != 4 or parts[0] in shas:
                    continue
                m = MERGE_RE.match(parts[3])
                parents = parts[1].split()
                if not m or m.group(1) not in branches or len(parents) < 2:
                    continue
                shas.add(parts[0])
                tip = parents[1]
                if any(k.get("sha") == parts[0] for k in known) or tip in tips:
                    continue
                found.append({"at": int(parts[2]), "tip": tip, "via": "local", "into": ref, "sha": parts[0]})
                tips.add(tip)
        # Commits the chat made itself (its worktree's reflog), in main now:
        # merged (a fast-forward), when main took them (main's reflog). Each
        # time main took some, one merge; seen or not before (the app away).
        groups = {}
        for sha in merge_own(path, created):
            if covered(sha):
                continue
            into = next((ref for ref, t in targets if is_ancestor(sha, t, repo_dir)), None)
            if into:
                groups.setdefault((into, merge_when(repo_dir, into, sha, created)), []).append(sha)
        for (into, at), shas in sorted(groups.items(), key=lambda g: g[0][1]):
            if any(k.get("into") == into and k["at"] == at for k in found):
                continue
            found.append({"at": at, "tip": shas[-1], "via": "local", "into": into})
            tips.add(shas[-1])
        # A commit seen unmerged before, in main now: merged (a fast-forward).
        pending = entry.get("pending")
        if pending and any(is_ancestor(pending, sha, repo_dir) for _, sha in targets):
            if not covered(pending):
                into = next(ref for ref, sha in targets if is_ancestor(pending, sha, repo_dir))
                found.append({"at": int(time.time()), "tip": pending, "via": "local", "into": into})
                tips.add(pending)
            entry["pending"] = None
        # Its work not in main: waiting to be merged.
        if targets and not any(is_ancestor(head, sha, repo_dir) for _, sha in targets):
            entry["pending"] = head
        entry["key"] = key
    # Its pull requests merged on GitHub.
    if use_gh and has_origin(repo_dir):
        for pr in merge_prs(repo_dir, s["repo"], fresh=fresh):
            if not isinstance(pr, dict) or pr.get("headRefName") not in branches:
                continue
            at = gh_time(pr.get("mergedAt"))
            if at < created - 300 or any(k.get("url") == pr.get("url") for k in known + found):
                continue
            rec = {"at": at, "tip": pr.get("headRefOid") or "", "via": "pr", "into": pr.get("baseRefName") or "",
                   "pr": pr.get("number"), "url": pr.get("url") or ""}
            same = next((k for k in known + found if k.get("tip") and k["tip"] == rec["tip"]), None)
            if same:        # seen merged here already (a fast-forward fetched): the same merge, now its PR's
                same.update(via="pr", pr=rec["pr"], url=rec["url"], into=rec["into"])
                continue
            found.append(rec)
    every = known + found
    last = max(reversed(every), key=lambda m: m["at"], default=None)      # (the same second: the newer)
    if last and last.get("tip"):
        n = sh("git", "rev-list", "--count", f"{last['tip']}..HEAD", cwd=path).stdout.strip()
        entry["since"] = int(n) if n.isdigit() else 0
    return found


def merge_scan(ss, use_gh=True, fresh=False):
    """Look at these chats' merges (merge_found), keep what's new (MERGES),
    and write each new one from MISSIONS_SINCE on to MISSIONS: a mission
    counted. Returns the new ones, as written."""
    floor = missions_since()
    crew = team()
    MERGES_LOCK.parent.mkdir(parents=True, exist_ok=True)
    out = []
    with open(MERGES_LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            d = json.loads(MERGES.read_text())
            d = d if isinstance(d, dict) else {}
        except (OSError, ValueError):
            d = {}
        before = json.dumps(d, sort_keys=True)
        for s in ss:
            if s.get("setup") or is_agent(s, crew):       # your assistant's and agents' don't count
                continue
            path, repo_dir = Path(s.get("path") or ""), WORK / s.get("repo", "")
            if not path.is_dir() or not repo_dir.is_dir():
                continue
            entry = d.setdefault(s["id"], {})
            try:
                found = merge_found(s, path, repo_dir, entry, use_gh, fresh)
            except Exception as e:
                print(f"amarchy: couldn't look at {s['id']}'s merges: {e}", file=sys.stderr)
                continue
            for m in sorted(found, key=lambda m: m["at"]):
                m["counted"] = m["at"] >= floor
                entry["merges"].append(m)
                if m["counted"]:
                    rec = {"kind": "merge", "at": m["at"], "id": s["id"], "repo": s.get("repo", ""),
                           "task": s.get("task") or "", "created": s.get("created"), "via": m["via"],
                           "into": m.get("into", "")}
                    if m.get("url"):
                        rec.update(pr=m.get("pr"), url=m["url"])
                    mission_log(rec)
                    out.append(rec)
        # Chats closed a week ago: forgotten.
        live = {s["id"] for s in ss}
        for sid in list(d):
            e = d[sid]
            last = max([m.get("at", 0) for m in e.get("merges") or []] + [e.get("seen", 0)])
            if sid in live:
                e["seen"] = int(time.time())
            elif time.time() - last > 7 * 86400:
                d.pop(sid)
        if json.dumps(d, sort_keys=True) != before:
            write_file(MERGES, json.dumps(d))
    return out


def chat_merged(sid, merges=None):
    """A chat's merges, for the app: {at (the last one's), n, via, url, pr,
    since (commits after it)}, or None."""
    e = (merges_read() if merges is None else merges).get(sid) or {}
    ms = e.get("merges") or []
    if not ms:
        return None
    last = max(reversed(ms), key=lambda m: m.get("at", 0))
    return {"at": last.get("at"), "n": len(ms), "via": last.get("via"), "url": last.get("url") or "",
            "pr": last.get("pr"), "into": last.get("into") or "", "since": e.get("since") or 0}


MERGE_TURN_EVERY = 5        # how often a chat's turn ending is looked for


def app_merges(st):
    """Each minute, every open chat's merges (merge_scan): a merge is on its
    chat and on your score within a minute of it; GitHub's every two. A chat
    whose turn just ended (working or running, now idle) is looked at within
    seconds, GitHub too: the turn that merged its pull request or shipped it
    ends on Merged ✓, not on "not merged" for minutes."""
    time.sleep(5)
    last, was = 0.0, {}
    while True:
        try:
            ss = [s for s in list(st.view.get("sessions") or []) if not s.get("setup")]
            now = {s["id"]: s.get("status") or "" for s in ss}
            ended = [s for s in ss if now[s["id"]] == "idle" and was.get(s["id"]) in ("working", "running")]
            was = now
            found = False
            if time.time() - last >= MERGE_EVERY:
                last = time.time()
                found = merge_scan(ss)
            for s in ended:
                found = merge_scan([s], fresh=True) or found
            if found:
                st.poke.set()
        except Exception as e:
            print(f"amarchy app: merges: {e}", file=sys.stderr)
        time.sleep(MERGE_TURN_EVERY)


_missions = {}

MISSION_COMBO = 15 * 60       # merged this soon after the one before: the same combo
MISSION_GOAL = STATE / "missions-goal"      # how many a day you aim for (0: none)
MISSION_BADGES = STATE / "missions-badges.json"     # badges earned outside the log (five at once): key -> when
MISSION_TOLD = STATE / "missions-told.json"         # the streak's reminder and the week's recap: the day each was last sent
MISSION_FAST = 120            # a question or permission answered this soon: a fast reply
MISSION_GOAL_DEFAULT = 5

