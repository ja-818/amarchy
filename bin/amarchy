#!/usr/bin/env python3
"""amarchy: parallel Claude Code sessions, one git worktree each, on a server you reach from your phone and browser.

Every session is a branch + worktree off the latest main, with its Claude Code and a dev terminal in tmux on
this machine. The amarchy app (amarchy app on) shows them on your phone, as an app on the home screen, and in
a computer's browser, with the session's real terminals beside the list; it's reachable only on your Tailscale
network.

Every action in the app is one of these commands, so scripts and agents can do anything you can. Commands print
results to stdout and fail with a non-zero exit.

  amarchy help [command]                this, or the usage of one command (also amarchy <command> --help)

Projects (git repos directly inside AMARCHY_WORK):
  amarchy projects [--json]             your projects and their session counts
  amarchy projects --github [--json]    your GitHub repos (✓ = already added)
  amarchy projects order [project...]   the order your projects come in (the list's project groups, the
                                        app's pickers): prints it, or puts these first, in this order; the
                                        rest keep theirs, and new ones go last, by name
  amarchy projects move <project> up|down|top|bottom
                                        move one project in that order
  amarchy projects move <project> before|after <other>
                                        the same, next to another one
  amarchy add <owner/repo|git url>      clone a project (prints its path)
  amarchy add --new <name> [--github]   start an empty project (and a private GitHub repo)

Sessions:
  amarchy new <project> [name]          create a session (name like wobbly-bakunin if omitted); prints its id
  amarchy new <project> [name] --prompt <text|->
                                        the same, with the first thing its Claude is asked (- reads it from stdin)
  amarchy send <id> <text|->            a message for a session's Claude, as if typed and sent (- reads it
                                        from stdin), once Claude is free: after the turn under way, not
                                        over a question it asks; a session asleep or whose Claude exited
                                        starts again with it. Waits until Claude has it (60 minutes at most)
  amarchy send <id> <text|-> [--no-wait] [--timeout <minutes>]
                                        the same, returning at once (it's delivered in the background), or
                                        waiting that long; from the session's own Claude it never waits
  amarchy list [--compact]              sessions as JSON, in list order (task, age, and agent: the name its
                                        Claude goes by for other Claude sessions' SendMessage)
  amarchy close [id] [--force]          close a session (current one if no id); --force discards uncommitted changes
  amarchy rename <title>                name the current session
  amarchy rename --id <id> <title>      the same for another session; --reset instead of a title goes back to the
                                        one made from Claude's title
  amarchy run                           run the project in the session's terminal (again: restart it)
  amarchy run --show | --set <command>  the project's run command (guessed from the repo until you set one)
  amarchy run <name>                    run another saved command of the project, the same way
  amarchy run --save <name> <command>   save one; --forget <name> drops it
  amarchy run --list                    the project's saved commands, name and command
  amarchy priority [high|normal|low|up|down] [--id <id>]
                                        how much the session matters (prints it without a level): the
                                        list puts higher priority first, unless it's sorted by date;
                                        new sessions are normal
  amarchy group [project|priority|status] [on|off]
                                        group the list by project, priority (High, Normal, Low) and/or
                                        status (Needs you, Working, Done, Idle), nested in the order you
                                        turn them on (a new one goes inside the others); without
                                        on|off switches it, without anything prints the grouping
                                        outermost first; `group none` drops them all
  amarchy group <grouping> <grouping>...
                                        group by these, nested in this order, outermost first, e.g.
                                        `group priority project`: each priority, its projects inside
  amarchy sort [priority|newest|oldest] sort the list inside its groups: by priority (the default),
                                        or by when the session was opened; prints it without one

Sleep (a session you're not using lets go of its Claude Code, and its memory, until you type in it or send
it something; its screen stays as it was, and what you type goes to Claude when it's back):
  amarchy sleep [id] [--force]          put a session to sleep (current one if no id); it says why not when
                                        something would be lost, and --force does it anyway
  amarchy sleep --all [--force]         every session that can sleep, except those open on a phone or in a
                                        browser
  amarchy sleep --after [minutes|off]   how long a session sits idle, open on no phone or browser, before it
                                        sleeps on its own (default 1; prints it without a value)
  amarchy wake [id]                     wake a session without typing in it

The app (your sessions on your phone, as an app on the home screen, and in a computer's browser, with real
terminals; reachable only on your Tailscale network):
  amarchy app on                        serve it on your tailnet (https://<this machine>.<tailnet>.ts.net,
                                        with tailscale serve), now and after every reboot; prints its address
  amarchy app off                       stop serving it (the phones keep it, for when it's on again)
  amarchy app [--status]                whether it's on, where, and how many phones and browsers it notifies
  amarchy app --test                    send each phone a test notification
  amarchy notify <title> [body] [--session <id>] [--urgent]
                                        a notification of your own on each phone (and browser) the app
                                        notifies; a tap opens that session. --urgent: it stays until
                                        dismissed where the browser lets it (a computer's; iOS shows it as
                                        any other)

Theme (the app's look, on every phone and browser; Settings, Look in the app):
  amarchy theme [--show]                print it: the theme, the font and the wallpaper
  amarchy theme <name>                  wear one of amarchy's themes (Omarchy's palettes); Claude Code wears it too
                                        (a theme of yours, e.g. the look an Omarchy desktop sent, kept by
                                        amarchy migrate, keeps Claude Code's own colors)
  amarchy theme --font <name>           the font: JetBrains Mono (the default), Caskaydia Mono, Fira Code,
                                        System (the device's own), or one a theme of yours came with
  amarchy theme --wallpaper theme|own|none|<picture>
                                        the theme's wallpaper, your own (a picture you give it here or in
                                        the app, cut for a phone and a computer), or none
  amarchy theme --list [--json]         the themes, fonts and wallpapers, * on the ones worn

Sound (the chime the app plays in a browser when a session needs you or is done):
  amarchy sound [--show]                print it
  amarchy sound <name> | off            set it (one of --list, or off for none)
  amarchy sound --list [--json]         every sound: amarchy's, then yours (added in the app, or put in
                                        ~/.config/amarchy/sounds)

Your assistant (one session that keeps your day rather than writing code: at the top of every list,
above the groups, bigger and with its picture, the other sessions of its project under it; it always
tells you when it needs you or is done, under its name and picture, with a chime of its own):
  amarchy assistant                     which session it is (id, then its name), or none
  amarchy assistant <id> [--name <name>]
                                        make a session your assistant (named after its project unless
                                        you name it); --name alone renames the one you have
  amarchy assistant off                 no assistant: it's a session like the others again
  amarchy assistant --picture <file>|off [--crop x,y,size]
                                        its picture in every list and by its notifications: yours (a PNG,
                                        JPEG or WebP, cut to a round square: the middle of it, or the square
                                        at x,y of that size in its pixels), or amarchy's own again
  amarchy sound --assistant [name|off]  its chime (herald until you pick one); prints it without one
  amarchy alerts [all|needs-you|assistant]
                                        what the other sessions tell you about on your phones: when they
                                        need you or are done (all), only when one needs you (needs-you,
                                        the default: a finished one is marked done in the list, quietly),
                                        or nothing (assistant); prints it without one

Dictation (the app's mic button: what you say, written into the box you type in, by a speech-to-text model
on this machine that knows Spanish, English and 23 more languages and tells them apart by itself):
  amarchy dictation [--status]          whether it's set up, and how to set it up if not
  amarchy dictation setup               fetch the model (Parakeet TDT 0.6B v3, 670 MB) into the state; needs
                                        whisper.cpp 1.9 or newer, with its libparakeet (Arch: whisper-cpp)
  amarchy dictation remove              delete the model again
  amarchy dictation log [--json]        the last dictations, from any phone or browser: how each went (which
                                        way it was written down, how long it took) and what came of it
  amarchy dictation transcribe <file>   write down a recording (anything ffmpeg reads), as a dictation would be

Updating:
  amarchy update                        to the latest amarchy on GitHub (origin's main): pull the checkout it
                                        runs from (when it's on main, with nothing uncommitted) and install it.
                                        It does it by itself every 5 minutes (AUTO_UPDATE=off in
                                        ~/.config/amarchy/host to stop that)

Plumbing:
  amarchy claude | asleep | woke <id>   the steps of the loop in a session's Claude pane (tmux): set up and
                                        start Claude; keep the session asleep on screen; the prompt you
                                        type in while it sleeps
  amarchy held <id>                     after its Claude exits, Enter starts it again
  amarchy attach <id> [claude|term]     show a session's Claude or terminal (tmux) in this terminal: what the
                                        app's terminals run, or you over ssh
  amarchy sleep --idle                  put the sessions idle long enough to sleep (the timer runs it)
  amarchy reap <id>                     the rest of closing a session, detached from what closed it
  amarchy shorten <repo> <title>        cut Claude's title for the list down to "Keyword: a few words"
  amarchy editor <file>                 Claude's $VISUAL in a session (bin/amarchy-editor)
  amarchy hook <id> <state>             Claude Code hook: record working/waiting/idle and the conversation
                                        (start: idle, and tell Claude it's in amarchy)
  amarchy seen <id>                     you've opened a session that finished: its row drops the done mark
  amarchy paste [wl-paste options]      wl-paste for a session's Claude (bin/amarchy-paste): what you last
                                        pasted or copied in the app (phone or browser), so Ctrl+V pastes an
                                        image there
  amarchy rec [rec options]             SoX's rec for a session's Claude (bin/amarchy-rec): the phone's or the
                                        browser's microphone while you dictate there, else the real rec
  amarchy dictation worker              keeps the dictation model loaded for the app's server (Transcriber)
  amarchy agent <id>                    the chat engine's broker in a session's Claude pane: Claude Code on
                                        claude -p, with a live state, a socket and a log of the conversation
                                        (experimental, test sessions only; docs/agent-protocol.md)
  amarchy agent engine <id> [chat|terminal]
                                        which engine a session's Claude runs on (prints it without one);
                                        chat only for a session named test-...; its Claude starts again
                                        on it, the conversation kept
  amarchy agent state|watch <id>        its live state (JSON) / everything Claude says, as it comes
  amarchy agent send <id> <text|-> [--next|--now|--later]
                                        a message: when Claude is free (or taken into the turn under way,
                                        ending it, or after it, queued by Claude)
  amarchy agent answer <id> <request> allow|always|deny [why]
                                        answer what Claude asks (--json <response> for a question's answers)
  amarchy agent interrupt <id> [--all]  Stop (--all: and drop what's queued)
  amarchy agent mode|model <id> <value> switch the permission mode or the model
  amarchy agent control <id> <json>     any other control request, e.g. '{"subtype": "get_context_usage"}'
  amarchy app serve                     the app's server (amarchy-app.service runs it)
  amarchy migrate                       bring the state from before (a desktop's) up to date, once (the app's
                                        server and install.sh run it): the look the desktop sent becomes a
                                        theme of yours, "<name> (yours)", and is picked

Environment:
  AMARCHY_WORK         where your repos live (default ~/Work); every git repo directly inside is offered
  AMARCHY_WORKTREES    where worktrees go (default $AMARCHY_WORK/.worktrees/<repo>/<name>)
  AMARCHY_CLAUDE_ARGS  extra arguments for claude (else ~/.config/amarchy/claude-args, else "--permission-mode auto")
  AMARCHY_SHORT_NAMES  off to show Claude Code's titles as they are, not cut down to "Keyword: a few words"

~/.config/amarchy/host (KEY=value lines): NAME= and BIND= (how your devices reach what a session serves,
else this machine's Tailscale name and address), APP_USERS= (the Tailscale logins the app lets in, else
this machine's owner), APP_PORT= and APP_HTTPS= (the app's ports), AUTO_UPDATE=off.

A session's Claude and terminal have AMARCHY=1, AMARCHY_SESSION (its id), $AMARCHY_PATH
(the worktree), $AMARCHY_NAME, $AMARCHY_BRANCH, $AMARCHY_REPO and $AMARCHY_ROOT (the
project's main checkout). From there, run, rename, close, priority and sleep act on that
session. Claude is told it's in amarchy when it starts (and that it can message the other
sessions' Claude), and the amarchy skill (skill/, linked into ~/.claude/skills by install.sh)
has the rest.

Run commands are saved per project, start in the session's worktree and can use the same
variables. Quote them when setting from a shell:
  amarchy run --set '$AMARCHY_PATH/install.sh && systemctl --user restart amarchy-app'
(install.sh asks before replacing an install that runs from another session's worktree,
and stops without a terminal to ask in; --force goes on anyway. Closing the session an
install runs from puts it back on the main checkout.)

State: ~/.local/state/amarchy/.
"""

import base64
import calendar
import fcntl
import hashlib
import hmac
import json
import os
import random
import re
import select
import shlex
import signal
import shutil
import socket
import struct
import subprocess
import sys
import tempfile
import termios
import unicodedata
import threading
import time
import urllib.parse
import uuid
from pathlib import Path

HOME = Path.home()
WORK = Path(os.environ.get("AMARCHY_WORK", HOME / "Work")).expanduser()
WORKTREES = Path(os.environ.get("AMARCHY_WORKTREES", WORK / ".worktrees")).expanduser()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "amarchy"
SESSIONS = STATE / "sessions"
STATUS = STATE / "status"
UNSEEN = STATE / "unseen"       # sessions that finished while you weren't looking, until you open them
RUN = STATE / "run"             # per project: <repo> its run command, <repo>.json its other saved commands
GROUP_FILE = STATE / "group"    # how the list is grouped: "project", "priority", "status", any or none, outermost first
SORT_FILE = STATE / "sort"      # how it's sorted inside its groups: "priority", "newest" or "oldest"
ORDER_FILE = STATE / "order"    # the same from before: "activity" was grouped by status
PROJECT_ORDER = STATE / "project-order"  # the order your projects come in, one name a line (see project_order)
CLOSING = STATE / "closing"     # sessions closed but not yet cleaned up (see "reap")
CLAUDE_STATE = STATE / "claude" # per session: its conversation, and what sleep keeps for it (see "sleep")
SLEEP_AFTER = STATE / "sleep-after"     # minutes idle and open nowhere before a session sleeps, or "off"
SELF = str(Path(__file__).resolve())
# What runs later, after this has exited (Claude's hooks, the timers, the
# app's service), goes through the installed amarchy: it follows install.sh
# instead of staying on the copy that set it up, a worktree maybe long gone.
INSTALLED = Path.home() / ".local/bin/amarchy"
ENTRY = str(INSTALLED) if INSTALLED.exists() else SELF
SOUNDS = Path(SELF).parent.parent / "sounds"       # amarchy's chimes, one played with a session's notification
SOUND_FILE = STATE / "sound"                       # the one picked (its name, or "off")
ASSISTANT_SOUND_FILE = STATE / "sound-assistant"   # your assistant's own (its name, or "off"; see "assistant")
CLAUDE_THEME = HOME / ".claude/themes/amarchy.json"

# Reached over ssh, or from a systemd unit, with a bare PATH: Claude Code's
# installer puts claude in ~/.local/bin.
if str(HOME / ".local/bin") not in os.environ.get("PATH", "").split(os.pathsep):
    os.environ["PATH"] = os.pathsep.join(filter(None, (str(HOME / ".local/bin"), os.environ.get("PATH"))))

# AMARCHY_CLAUDE_ARGS, else ~/.config/amarchy/claude-args: a file reaches every way a
# session starts (ssh, the app's service, another session).
_CLAUDE_ARGS_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy/claude-args"
CLAUDE_ARGS = shlex.split(os.environ.get("AMARCHY_CLAUDE_ARGS")
                          or (_CLAUDE_ARGS_FILE.read_text().strip() if _CLAUDE_ARGS_FILE.is_file() else "")
                          or "--permission-mode auto")


# ------------------------------------------------------------------ helpers

def sh(*args, check=False, cwd=None):
    """Run a command and capture what it says. One that isn't there (tailscale,
    say) or a folder that's gone fails like a command would."""
    try:
        return subprocess.run(args, capture_output=True, text=True, check=check, cwd=cwd)
    except (FileNotFoundError, NotADirectoryError) as e:
        if check:
            raise
        return subprocess.CompletedProcess(args, 127, "", str(e))


# Set by a running Claude Code for its own children. When an agent drives
# amarchy, they'd leak into the sessions it opens (e.g. turning off transcript
# saving), so the sessions it starts go without them.
INHERITED_CLAUDE_ENV = ("CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_CODE_CHILD_SESSION",
                        "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_ENTRYPOINT",
                        "CLAUDE_CODE_EXECPATH", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                        "CLAUDE_CODE_AUTO_COMPACT_WINDOW", "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS")


# A session's own environment (session_env), when amarchy runs inside one: what
# it opens belongs to whatever session it opens it for, if any.
SESSION_ENV = ("AMARCHY", "AMARCHY_SESSION", "AMARCHY_PATH", "AMARCHY_NAME", "AMARCHY_REPO",
               "AMARCHY_BRANCH", "AMARCHY_ROOT")


def clean_env():
    return {k: v for k, v in os.environ.items() if k not in INHERITED_CLAUDE_ENV + SESSION_ENV}


def detach(argv):
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, env=clean_env(), stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def processes():
    """Every process: {pid: (ppid, comm, cpu ticks)}, from /proc."""
    out = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            stat = Path(f"/proc/{d}/stat").read_text()
        except OSError:
            continue
        # comm is in parentheses and may hold anything, spaces and parentheses too.
        fields = stat[stat.rfind(")") + 2:].split()
        out[int(d)] = (int(fields[1]), stat[stat.find("(") + 1:stat.rfind(")")], int(fields[11]) + int(fields[12]))
    return out


def descendants(pid, procs):
    """A process's children, grandchildren... nearest first."""
    children = {}
    for p, (ppid, *_) in procs.items():
        children.setdefault(ppid, []).append(p)
    out, todo = [], [pid]
    while todo:
        kids = sorted(children.get(todo.pop(0), []))
        out += kids
        todo += kids
    return out


def cmdline(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace").split("\0")
    except OSError:
        return []


def slug(text):
    return re.sub(r"[^a-z0-9-]+", "-", text.strip().lower()).strip("-")[:40]


def repos():
    if not WORK.is_dir():
        return []
    return sorted(p.name for p in WORK.iterdir()
                  if not p.name.startswith(".") and (p / ".git").exists())


def fail(msg):
    print(f"amarchy: {msg}", file=sys.stderr)
    return 1


# ------------------------------------------------------------------ projects

def github_slug(url):
    """owner/repo (lowercased) for a GitHub remote URL, else None."""
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$", url or "")
    return m.group(1).lower() if m else None


def projects():
    """Your projects: the git repos in AMARCHY_WORK, with their session counts."""
    counts = {}
    for s in sessions():
        counts[s["repo"]] = counts.get(s["repo"], 0) + 1
    out = []
    for name in repos():
        remote = sh("git", "remote", "get-url", "origin", cwd=WORK / name).stdout.strip()
        out.append({"name": name, "path": str(WORK / name), "remote": remote,
                    "sessions": counts.get(name, 0)})
    return out


# Your projects come in the order you put them in (`amarchy projects order`,
# or moved one at a time from any list): the list's project groups, the
# pickers. One you haven't placed goes after the ones you have, by name, so
# a project you add shows up last until you move it.

def project_order():
    """The projects you put in order, first first (names; one may be gone)."""
    try:
        names = PROJECT_ORDER.read_text().split("\n")
    except OSError:
        return []
    out = []
    for n in (n.strip() for n in names):
        if n and n not in out:
            out.append(n)
    return out


def project_rank(order):
    """A sort key for a project's name: placed ones in their place, the rest after, by name."""
    at = {n: i for i, n in enumerate(order)}
    return lambda name: (at.get(name, len(at)), name.lower(), name)


def ordered_projects(ps, order=None):
    """Projects (dicts with a name) in your order."""
    rank = project_rank(project_order() if order is None else order)
    return sorted(ps, key=lambda p: rank(p["name"]))


def project_names():
    """Every project there is, in your order: yours, and any a session is in."""
    names = {p["name"] for p in projects()} | {s["repo"] for s in sessions()}
    return sorted(names, key=project_rank(project_order()))


def set_project_order(names, rest=True):
    """Put these projects first, in this order; the ones you had placed
    before keep their order after them (rest=False: they're unplaced, back
    after them by name). None, or what's wrong with it."""
    if not isinstance(names, list) or not all(isinstance(n, str) and n.strip() and "\n" not in n for n in names):
        return "projects: a list of project names"
    names = [n.strip() for n in names]
    if len(set(names)) < len(names):
        return "projects: each one once"
    order = names + ([n for n in project_order() if n not in names] if rest else [])
    if order != project_order():
        write_file(PROJECT_ORDER, "".join(n + "\n" for n in order))
    return None


PROJECT_MOVES = ("up", "down", "top", "bottom", "before", "after")


def move_project(name, where, other=None):
    """Move a project up or down one, to the top or bottom, or right before or
    after another one. None, or what's wrong."""
    names = project_names()
    if name not in names:
        return f"no project {name!r}"
    if where not in PROJECT_MOVES:
        return f"move it {', '.join(PROJECT_MOVES[:-1])} or {PROJECT_MOVES[-1]}"
    if where in ("before", "after"):
        if other not in names:
            return f"no project {other!r}" if other else f"{where} which project?"
        if other == name:
            return None
    at = names.index(name)
    names.remove(name)
    if where == "up":
        names.insert(max(at - 1, 0), name)
    elif where == "down":
        names.insert(min(at + 1, len(names)), name)
    elif where == "top":
        names.insert(0, name)
    elif where == "bottom":
        names.append(name)
    else:
        names.insert(names.index(other) + (where == "after"), name)
    return set_project_order(names)


def github_repos():
    """Your GitHub repos (owned, collaborator, org), most recently pushed first.

    None when gh is missing or not logged in."""
    if not shutil.which("gh"):
        return None
    r = sh("gh", "api", "user/repos?affiliation=owner,collaborator,organization_member&sort=pushed&per_page=100",
           "--jq", "[.[] | {name: .full_name, private, pushed: .pushed_at, description}]")
    if r.returncode != 0:
        return None
    added = {github_slug(p["remote"]) for p in projects()}
    rs = json.loads(r.stdout or "[]")
    for repo in rs:
        repo["added"] = repo["name"].lower() in added
    return rs


def add_project(source):
    """Clone owner/repo, a GitHub URL or any git URL into AMARCHY_WORK.

    Returns (name, error). Adding a project that's already there is not an error."""
    source = source.strip()
    url = f"https://github.com/{source}.git" if re.fullmatch(r"[\w.-]+/[\w.-]+", source) else source
    name = re.sub(r"\.git$", "", re.split(r"[/:]", url.rstrip("/"))[-1])
    if not name:
        return None, f"can't tell the project name from {source!r}"
    gh_slug = github_slug(url)
    for p in projects():
        if p["name"] == name and (not gh_slug or github_slug(p["remote"]) == gh_slug):
            return name, None
    dest = WORK / name
    if dest.exists():
        return None, f"{dest} already exists and isn't {source}"
    WORK.mkdir(parents=True, exist_ok=True)
    # Not captured: git's progress shows when run from a terminal.
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}  # fail instead of hanging on a password prompt
    if subprocess.run(["git", "clone", url, str(dest)], env=env).returncode != 0:
        return None, f"git clone {url} failed"
    return name, None


def new_project(name, github=False):
    """An empty git repo with one commit (worktrees need a base), optionally
    pushed to a new private GitHub repo. Returns (name, error)."""
    name = slug(name)
    if not name:
        return None, "the project needs a name"
    dest = WORK / name
    if dest.exists():
        return None, f"{dest} already exists"
    dest.mkdir(parents=True)
    sh("git", "init", "--quiet", "-b", "main", cwd=dest)
    sh("git", "commit", "--quiet", "--allow-empty", "-m", "Initial commit", cwd=dest)
    if github:
        r = sh("gh", "repo", "create", name, "--private", "--source", str(dest), "--push")
        if r.returncode != 0:
            return name, f"created {dest}, but gh repo create failed: {r.stderr.strip()[:200]}"
    return name, None


def cmd_add(args):
    if not args:
        print(usage("add"), file=sys.stderr)
        return 1
    if args[0] == "--new":
        names = [a for a in args[1:] if not a.startswith("--")]
        if not names:
            return fail("usage: amarchy add --new <name> [--github]")
        name, err = new_project(names[0], github="--github" in args)
    else:
        name, err = add_project(args[0])
    if err:
        return fail(err)
    print(WORK / name)
    return 0


def cmd_projects(args):
    if "--github" in args:
        rs = github_repos()
        if rs is None:
            return fail("gh isn't installed or logged in (gh auth login)")
        if "--json" in args:
            print(json.dumps(rs, indent=2))
        else:
            for r in rs:
                print(f"{'✓' if r['added'] else ' '} {r['name']}{'  (private)' if r['private'] else ''}")
        return 0
    if args[:1] == ["order"]:
        if len(args) > 1:
            names, known = args[1:], set(project_names())
            missing = [n for n in names if n not in known]
            why = f"no project {missing[0]!r}" if missing else set_project_order(names)
            if why:
                return fail(why)
        print("\n".join(project_names()))
        return 0
    if args[:1] == ["move"]:
        if len(args) not in (3, 4) or args[2] not in PROJECT_MOVES or (len(args) == 4) != (args[2] in ("before", "after")):
            return fail("usage: amarchy projects move <project> up|down|top|bottom | before|after <other>")
        why = move_project(args[1], args[2], args[3] if len(args) == 4 else None)
        if why:
            return fail(why)
        print("\n".join(project_names()))
        return 0
    if args:
        unknown = [a for a in args if a not in ("--json",)]
        if unknown:
            return fail("usage: amarchy projects [--json] | --github [--json] | order [project...] | move ...")
    ps = ordered_projects(projects())
    if "--json" in args:
        print(json.dumps(ps, indent=2))
    else:
        for p in ps:
            n = p["sessions"]
            print(f"{p['name']:<30} {n} session{'s' if n != 1 else ''}  {p['remote']}")
    return 0


# ------------------------------------------------------------------ sessions

def sessions():
    out = []
    for f in sorted(SESSIONS.glob("*.json")):
        try:
            s = json.loads(f.read_text())
            st = STATUS / s["id"]
        except (ValueError, KeyError, TypeError):
            continue
        s["status"] = st.read_text().strip() if st.exists() else "idle"
        out.append(s)
    return out


def session(sid):
    try:
        return json.loads((SESSIONS / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None


def save_session(s):
    """Write a session's file in one go: the list (and every other amarchy
    reading it meanwhile) never sees half of it."""
    SESSIONS.mkdir(parents=True, exist_ok=True)
    keep = {k: v for k, v in s.items() if k not in VIEW_FIELDS}
    tmp = SESSIONS / f".{s['id']}.json.{os.getpid()}"
    tmp.write_text(json.dumps(keep))
    os.replace(tmp, SESSIONS / f"{s['id']}.json")


# What session_view() adds for the UIs, never saved.
VIEW_FIELDS = ("status", "awake", "sleeping", "waking", "task", "claude_title", "age", "background", "agent",
               "unseen", "assistant", "assistant_name", "said", "picture")


def own_session_id():
    """The session a command is about when none is named: the one it runs in
    (from its Claude or its terminal, $AMARCHY_SESSION), or None."""
    sid = os.environ.get("AMARCHY_SESSION", "")
    return sid if session(sid) else None


# ------------------------------------------------------------------ sound

# amarchy's own chimes (sounds/, where sounds/CREDITS says where each is from),
# in the order the app offers them; the first is the default. The app plays
# the one picked when a session needs you or is done.
CHIMES = ("kalimba", "vibraphone", "tine", "fairy", "ocean", "elementary", "herald")
ASSISTANT_CHIME = "herald"      # your assistant's, until you pick another (amarchy sound --assistant)
USER_SOUNDS = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy/sounds"
AUDIO = (".wav", ".oga", ".ogg", ".opus", ".flac", ".mp3")   # what a sound of yours can be


def sounds():
    """Every sound to pick from, {name: file}: amarchy's, then the files in
    ~/.config/amarchy/sounds, named after the file. One of yours with the
    name of one of amarchy's replaces it."""
    found = {name: SOUNDS / f"{name}.oga" if (SOUNDS / f"{name}.oga").exists() else SOUNDS / f"{name}.wav"
             for name in CHIMES}
    mine = sorted(f for f in USER_SOUNDS.glob("*") if f.suffix.lower() in AUDIO and f.is_file()) \
        if USER_SOUNDS.is_dir() else []
    for f in mine:
        found.pop(f.stem.lower(), None)
        found[f.stem] = f
    return found


def sound_label(name):
    """How a sound is called in the app: amarchy's capitalized, yours as you named the file."""
    return name.capitalize() if name in CHIMES else name


def sound_key(name, found=None):
    """The name of a sound as sounds() has it, whatever its case; None if there's none."""
    found = sounds() if found is None else found
    return next((n for n in found if n.lower() == name.strip().lower()), None)


def sound_name():
    """The sound picked: its name, "off", or the default when nothing (or a
    file since removed) was picked."""
    picked = SOUND_FILE.read_text().strip() if SOUND_FILE.exists() else ""
    if picked == "off":
        return picked
    return (sound_key(picked) if picked else None) or CHIMES[0]


def assistant_sound_name():
    """Your assistant's chime: its name, "off", or herald."""
    try:
        picked = ASSISTANT_SOUND_FILE.read_text().strip()
    except OSError:
        picked = ""
    if picked == "off":
        return picked
    return (sound_key(picked) if picked else None) or ASSISTANT_CHIME


def sound_file(name):
    found = sounds()
    key = sound_key(name, found) if name != "off" else None
    return found[key] if key else None


def set_sound(name):
    STATE.mkdir(parents=True, exist_ok=True)
    SOUND_FILE.write_text(name + "\n")


def cmd_sound(args):
    """`amarchy sound`: the chime the app plays, printed (or --show). With a
    name, set it; --assistant [name] your assistant's; --list [--json] every
    sound (yours added in the app, or put in ~/.config/amarchy/sounds)."""
    if not args or args[0] == "--show":
        print(sound_name())
        return 0
    if args and args[0] == "--assistant":
        name = " ".join(args[1:])
        if name:
            key = "off" if name.lower() == "off" else sound_key(name)
            if not key:
                return fail(f"no sound {name!r} (see amarchy sound --list)")
            write_file(ASSISTANT_SOUND_FILE, key + "\n")
        print(assistant_sound_name())
        return 0
    if args and args[0] == "--list":
        found = sounds()
        if "--json" in args:
            print(json.dumps({"current": sound_name(), "sounds": [
                {"name": name, "label": sound_label(name), "path": str(path)} for name, path in found.items()]}))
        else:
            for name, path in found.items():
                print(f"{name}\t{path}")
        return 0
    name = " ".join(args)
    if name.lower() == "off":
        set_sound("off")
    else:
        key = sound_key(name)
        if not key:
            return fail(f"no sound {name!r} (see amarchy sound --list)")
        set_sound(key)
    print(sound_name())
    return 0


# ------------------------------------------------------------------ run

def guess_run(path):
    """A project's usual "start the app" command, from what's in the repo."""
    path = Path(path)
    if (path / "bin/dev").exists():
        return "bin/dev"
    if (path / "package.json").exists():
        try:
            scripts = json.loads((path / "package.json").read_text()).get("scripts", {})
        except ValueError:
            scripts = {}
        pm = next((pm for lock, pm in (("bun.lock", "bun"), ("bun.lockb", "bun"), ("pnpm-lock.yaml", "pnpm"),
                                       ("yarn.lock", "yarn")) if (path / lock).exists()), "npm")
        for script in ("dev", "start"):
            if script in scripts:
                return f"{pm} run {script}"
    if (path / "Cargo.toml").exists():
        return "cargo run"
    if (path / "go.mod").exists():
        return "go run ."
    if (path / "manage.py").exists():
        return "python manage.py runserver"
    if (path / "Makefile").exists() and re.search(r"^run:", (path / "Makefile").read_text(errors="ignore"), re.M):
        return "make run"
    return ""


def run_command(s):
    saved = RUN / s["repo"]
    return saved.read_text().strip() if saved.exists() else guess_run(s["path"])


def set_run_command(repo, command):
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / repo).write_text(command.strip() + "\n")


def run_env(s):
    """What a run command can refer to, as $AMARCHY_PATH and so on. One command
    is saved per project, these make it fit each of its sessions."""
    return {"AMARCHY_PATH": s["path"], "AMARCHY_NAME": s["name"], "AMARCHY_REPO": s["repo"],
            "AMARCHY_BRANCH": s["branch"], "AMARCHY_ROOT": str(WORK / s["repo"])}


def session_env(s):
    """The environment of a session's Claude and its terminal: AMARCHY=1 says
    it's amarchy, AMARCHY_SESSION which session (what `amarchy run`, `rename`
    and `close` act on from there), plus what a run command can refer to."""
    return {"AMARCHY": "1", "AMARCHY_SESSION": s["id"], **run_env(s)}


def saved_commands(repo):
    """The project's other saved commands, {name: command}."""
    try:
        return json.loads((RUN / f"{repo}.json").read_text())
    except (OSError, ValueError):
        return {}


def save_command(repo, name, command):
    """Save a named command, or drop it when command is empty."""
    commands = saved_commands(repo)
    if command:
        commands[name] = command.strip()
    else:
        commands.pop(name, None)
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / f"{repo}.json").write_text(json.dumps(commands, indent=2) + "\n")


RUN_DEFAULT = "run"


def cmd_run(args):
    """Run the project in the session's terminal: the command shows, runs, and
    leaves you in a shell when it ends. Running again restarts it. A name runs
    one of the project's other saved commands instead."""
    sid = own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail("Not in a session: run it from a session's Claude or terminal")
    if s.get("setup") and (not args or not args[0].startswith("--")):
        return fail(f"{s['name']} is still being set up: run it once Claude has started")
    flag = args[0] if args else ""
    if flag == "--set":
        command = " ".join(args[1:]).strip()
        if not command:
            return fail("Usage: amarchy run --set <command>")
        set_run_command(s["repo"], command)
        return 0
    if flag == "--save":
        command = " ".join(args[2:]).strip()
        if len(args) < 2 or args[1] == RUN_DEFAULT or not command:
            return fail("Usage: amarchy run --save <name> <command> (the run command itself: amarchy run --set)")
        save_command(s["repo"], args[1], command)
        return 0
    if flag == "--forget":
        if len(args) < 2 or args[1] not in saved_commands(s["repo"]):
            return fail(f"No saved command {' '.join(args[1:])!r} for {s['repo']}")
        save_command(s["repo"], args[1], "")
        return 0
    command = run_command(s)
    if flag == "--list":
        for name, saved in {RUN_DEFAULT: command, **saved_commands(s["repo"])}.items():
            if saved:
                print(f"{name}\t{saved}")
        return 0
    if flag == "--show":
        print(command)
        return 0 if command else 1
    if flag:
        command = saved_commands(s["repo"]).get(flag)
        if not command:
            return fail(f"No saved command {flag!r} for {s['repo']}. Save it: amarchy run --save {flag} <command>")
        return host_run(s, command)
    if not command:
        return fail(f"No run command for {s['repo']} yet: amarchy run --set <command>")
    return host_run(s, command)


# ------------------------------------------------------------------ new / close

def has_origin(repo_dir):
    return "origin" in sh("git", "remote", cwd=repo_dir).stdout.split()


def default_base(repo_dir):
    """What a new session branches off: origin's default branch, else the
    local main or master. From what's already fetched, so it's instant."""
    if has_origin(repo_dir):
        head = sh("git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=repo_dir).stdout.strip()
        if head:
            return head
        for b in ("origin/main", "origin/master"):
            if sh("git", "rev-parse", "--verify", "--quiet", b, cwd=repo_dir).returncode == 0:
                return b
    for b in ("main", "master"):
        if sh("git", "rev-parse", "--verify", "--quiet", b, cwd=repo_dir).returncode == 0:
            return b
    return "HEAD"


FETCH_TIMEOUT = 30


def fetch_base(repo_dir, base):
    """Bring base up to date from origin, and return it (it can change when
    origin's branches were never fetched). Only that branch when base is on
    origin, which is much quicker than fetching everything in a big repo.
    The error, if any, comes second: without the network the session still
    starts, from what was fetched last."""
    if not has_origin(repo_dir):
        return base, None
    branch = base.removeprefix("origin/") if base.startswith("origin/") else None
    try:
        r = subprocess.run(["git", "fetch", "--quiet", "origin", *([branch] if branch else [])], cwd=repo_dir,
                           capture_output=True, text=True, timeout=FETCH_TIMEOUT, stdin=subprocess.DEVNULL,
                           env={**os.environ, "GIT_TERMINAL_PROMPT": "0", "GIT_SSH_COMMAND": os.environ.get(
                               "GIT_SSH_COMMAND", "ssh -o BatchMode=yes")})
        error = r.stderr.strip() if r.returncode else None
    except subprocess.TimeoutExpired:
        error = f"no answer from origin in {FETCH_TIMEOUT}s"
    return (base if branch else default_base(repo_dir)), error


def set_trust(path, trusted):
    """Pre-accept (or forget) Claude Code's per-folder trust prompt for a worktree.

    Written atomically; ~/.claude.json is shared with running Claude processes."""
    cfg = HOME / ".claude.json"
    try:
        data = json.loads(cfg.read_text())
    except (OSError, ValueError):
        return
    projects = data.setdefault("projects", {})
    if trusted:
        projects.setdefault(str(path), {})["hasTrustDialogAccepted"] = True
    else:
        projects.pop(str(path), None)
    tmp = cfg.with_name(".claude.json.amarchy-tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, cfg)


def hook_settings(sid):
    def h(state):
        return [{"hooks": [{"type": "command", "command": f"{shlex.quote(ENTRY)} hook {sid} {state}"}]}]
    settings = {"hooks": {
        "SessionStart": h("start"),
        "UserPromptSubmit": h("working"),
        "PreToolUse": h("working"),
        "Notification": h("waiting"),
        "Stop": h("idle"),
    }}
    if CLAUDE_THEME.exists():       # the app's theme (see look_claude)
        settings["theme"] = "custom:amarchy"
    return json.dumps(settings)


# Session names: a silly adjective and a famous anarchist, e.g. "wobbly-bakunin".
ADJECTIVES = ("bewildered", "caffeinated", "chaotic", "cranky", "crunchy", "disgruntled", "feral",
              "fluffy", "giddy", "grumpy", "jittery", "mischievous", "rowdy", "sassy", "sleepy",
              "smug", "sneaky", "soggy", "spicy", "squeaky", "stubborn", "suspicious", "unbothered",
              "unruly", "wobbly", "wonky", "zesty", "dramatic", "fancy", "rebellious")
ANARCHISTS = ("bakunin", "berkman", "bookchin", "decleyre", "diogenes", "durruti", "godwin",
              "goldman", "graeber", "kotoku", "kropotkin", "landauer", "magon", "makhno",
              "malatesta", "michel", "parsons", "proudhon", "reclus", "rocker", "sacco", "stirner",
              "tolstoy", "vanzetti", "ward", "ferrer", "steimer", "lum", "fabbri", "ito")


def auto_name(repo):
    """A free branch name like "wobbly-bakunin", so a session needs no naming up front."""
    taken = set(sh("git", "branch", "--format=%(refname:short)", cwd=WORK / repo).stdout.split())
    taken |= {s["name"] for s in sessions() if s["repo"] == repo}
    for _ in range(100):
        name = f"{random.choice(ADJECTIVES)}-{random.choice(ANARCHISTS)}"
        if name not in taken:
            return name
    return f"session-{int(time.time())}"


def create(repo, name, prompt=None):
    """Start a session: its row in the list right away, and its Claude in
    tmux, which makes the worktree first (setup_session) and is then Claude,
    asked prompt first if given. Returns the session id, or None, having
    said why not."""
    repo_dir = WORK / repo
    name = slug(name)
    if not (repo_dir / ".git").exists():
        fail(f"no project {repo!r} (amarchy projects lists them)")
        return None
    if not name:
        fail(f"not a session name: {name!r}")
        return None
    sid = f"{repo}-{name}"
    if session(sid):
        if prompt is not None:
            # Its Claude is already running: a first prompt can't reach it.
            fail(f"{sid} already exists: message its Claude instead (amarchy list has its agent name)")
            return None
        return sid
    if sh("git", "rev-parse", "--verify", "--quiet", "HEAD", cwd=repo_dir).returncode != 0:
        fail(f"{repo} has no commits yet. Commit something to branch off first.")
        return None

    SESSIONS.mkdir(parents=True, exist_ok=True)
    STATUS.mkdir(parents=True, exist_ok=True)
    (STATE / "failed" / sid).unlink(missing_ok=True)
    # "setup" until the worktree is there. Working meanwhile, so the list
    # spins on it; Claude's SessionStart hook settles it.
    s = {"id": sid, "repo": repo, "name": name, "branch": name, "base": default_base(repo_dir),
         "path": str(WORKTREES / repo / name), "created": int(time.time()), "setup": True}
    if prompt is not None:
        s["prompt"] = prompt      # taken (once) by `amarchy claude` when Claude starts
    save_session(s)
    (STATUS / sid).write_text("working")
    host_start(s)       # its tmux sets it up and becomes Claude
    return sid


def make_worktree(s):
    """Fetch the session's base and add its worktree, saying how it goes.
    Returns an error message, or None once the worktree is there (and the
    session no longer being set up)."""
    repo_dir, path, name = WORK / s["repo"], Path(s["path"]), s["branch"]
    base = s["base"]
    # Already there when its tmux went before Claude started.
    if not (path / ".git").exists():
        with step(f"Fetching the latest {base}") as st:
            base, error = fetch_base(repo_dir, base)
            if error:
                st.warn(f"Couldn't fetch, so from what was fetched last: {gist(error)}")
        with step(f"Making the worktree, branch {name} off {base}") as st:
            path.parent.mkdir(parents=True, exist_ok=True)
            r = sh("git", "worktree", "add", "-b", name, str(path), base, cwd=repo_dir)
            if r.returncode != 0 and sh("git", "rev-parse", "--verify", "--quiet", f"refs/heads/{name}",
                                        cwd=repo_dir).returncode == 0:
                # The branch is already there (e.g. a kept, unmerged one): pick it back up.
                st.note(f"Branch {name} was already there: picked it back up")
                sh("git", "worktree", "prune", cwd=repo_dir)
                r = sh("git", "worktree", "add", str(path), name, cwd=repo_dir)
            if r.returncode != 0:
                st.fail()
                return r.stderr.strip() or "git worktree add failed"
    if (CLOSING / f"{s['id']}.json").exists():
        return "closed"           # meanwhile: leave it gone
    s = session(s["id"]) or s     # as it is now: it may have been renamed meanwhile
    s.pop("setup", None)
    s["base"] = base
    save_session(s)
    return None


def gist(error):
    """The line of git's error that says what went wrong."""
    lines = [l.strip() for l in error.splitlines() if l.strip()]
    return next((l for l in lines if l.lower().startswith(("fatal:", "error:"))), lines[0] if lines else "")[:200]


class step:
    """One line of a new session's setup: a spinner while it runs, then ✓ (or ✗)."""
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, text):
        self.text, self.mark, self.notes = text, "\033[32m✓\033[0m", []

    def __enter__(self):
        self.started, self.done = time.time(), False

        def spin():
            i = 0
            while not self.done and sys.stdout.isatty():
                print(f"\r\033[K  {self.FRAMES[i % len(self.FRAMES)]} {self.text}…", end="", flush=True)
                i += 1
                time.sleep(0.08)
        self.thread = threading.Thread(target=spin, daemon=True)
        self.thread.start()
        return self

    def warn(self, text):
        self.mark = "\033[33m!\033[0m"
        self.notes.append(text)

    def note(self, text):
        self.notes.append(text)

    def fail(self):
        self.mark = "\033[31m✗\033[0m"

    def __exit__(self, *exc):
        self.done = True
        self.thread.join()
        took = time.time() - self.started
        print(f"\r\033[K  {self.mark} {self.text} \033[2m{took:.1f}s\033[0m", flush=True)
        for n in self.notes:
            print(f"    \033[2m{n}\033[0m", flush=True)


def setup_session(sid):
    """The first thing in a new session's Claude pane: make its worktree, then
    start the terminal beside it. On failure, say why, drop the session, and
    return the error."""
    s = session(sid)
    if not s:
        fail(f"No session {sid!r}")
        return f"no session {sid!r}"
    print(f"\n  \033[1m{s['repo']} · {s['name']}\033[0m\n", flush=True)
    error = make_worktree(s)
    if error and (CLOSING / f"{sid}.json").exists():
        return error        # closed meanwhile: its reap is cleaning up
    if error:
        print(f"\n  \033[31m{error}\033[0m\n", flush=True)
        (SESSIONS / f"{sid}.json").unlink(missing_ok=True)
        (STATUS / sid).unlink(missing_ok=True)
        mark_seen(sid)
        # Nobody may be watching: a terminal attaching later says so (cmd_attach).
        write_file(STATE / "failed" / sid, gist(error) or error)
        time.sleep(3)
        return error
    s = session(sid)
    if not s:
        return "closed"     # while it was being set up
    set_trust(Path(s["path"]), True)
    host_start(s)       # the terminal beside it, now that the worktree is there
    print("  \033[32m✓\033[0m Starting Claude Code", flush=True)
    return None


def projects_dir(path):
    """Where Claude Code keeps the conversations of a folder."""
    return HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", str(path))


def has_conversation(path):
    """Whether Claude Code has a saved conversation for this folder."""
    return any(projects_dir(path).glob("*.jsonl"))


def claude_dir(sid):
    """What amarchy keeps about a session's Claude: its conversation, and
    while it sleeps, that it does and the prompt it had."""
    return CLAUDE_STATE / sid


def conversation_id(sid):
    try:
        return (claude_dir(sid) / "conversation").read_text().strip()
    except OSError:
        return ""


def set_conversation_id(sid, conversation):
    """Record which conversation the session's Claude is in (it changes with
    /clear), to resume exactly that one."""
    if not re.fullmatch(r"[0-9a-f-]{36}", conversation or "") or conversation == conversation_id(sid):
        return
    write_file(claude_dir(sid) / "conversation", conversation)


def write_file(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}")
    tmp.write_bytes(text) if isinstance(text, bytes) else tmp.write_text(text)
    os.replace(tmp, path)


def transcript(s):
    """The file of the conversation the session is in, if there is one yet."""
    conversation = conversation_id(s["id"])
    f = projects_dir(s["path"]) / f"{conversation}.jsonl" if conversation else None
    return f if f and f.exists() else None


def claude_argv(s, prefill="", prompt=None):
    """Claude Code for a session, picking its conversation back up: the one it
    was in, else the latest in its folder (sessions from before amarchy kept
    track), with prefill already typed in the prompt, or asked prompt first
    (after --, so it may start with a dash)."""
    first = ["--", prompt] if prompt is not None else []
    return ["claude", *CLAUDE_ARGS, *claude_resume(s), *(["--prefill", prefill] if prefill and prompt is None else []),
            "--settings", hook_settings(s["id"]), *first]


def pane_loop(pane, procs):
    """The pid of the loop in a session's Claude pane (HOST_LOOP, the pane's
    own process), or None for a pane from before sessions could sleep."""
    pid = pane["pid"]
    return pid if pid in procs and '"$0" asleep "$1"' in " ".join(cmdline(pid)) else None


def pane_claude(pane, procs):
    """The pid of the Claude Code running in a session's pane, if it is."""
    return next((p for p in descendants(pane["pid"], procs) if procs[p][1] == "claude"), None)


def your_editor():
    """The editor you set for Claude Code's Ctrl+G, as a command line."""
    visual = os.environ.get("VISUAL", "")
    if visual.startswith(str(STATE / "editor")):    # ours, from a Claude it started
        visual = ""
    return os.environ.get("AMARCHY_VISUAL") or visual or os.environ.get("EDITOR") or "vi"


def editor_shim(editor):
    """What Claude runs as $VISUAL (Ctrl+G, "edit the prompt in your editor"):
    bin/amarchy-editor, which hands the prompt to amarchy when it's putting
    the session to sleep, and opens your editor any other time. Claude takes
    $VISUAL as one command, without arguments, and names it in a hint ("ctrl+g
    to edit in Nvim"), so it's a link named after your editor."""
    name = Path(shlex.split(editor)[0] if editor.strip() else "vi").name
    link = STATE / "editor" / name
    target = Path(SELF).parent / "amarchy-editor"
    try:
        if not link.is_symlink() or os.readlink(link) != str(target):
            link.parent.mkdir(parents=True, exist_ok=True)
            tmp = link.with_name(f".{name}.{os.getpid()}")
            tmp.unlink(missing_ok=True)
            tmp.symlink_to(target)
            os.replace(tmp, link)
    except OSError:
        return None
    return link


def take(f):
    """A file's text, removing the file (a prompt meant for Claude once)."""
    try:
        text = f.read_text()
    except OSError:
        return None
    f.unlink(missing_ok=True)
    return text


def cmd_claude(sid):
    """The pane loop's first step: set a new session up, then become Claude
    Code: with the message you sent while it slept, or what you had typed in
    its prompt. Asleep, it does nothing: the loop shows the session."""
    s = session(sid)
    if not s:
        return fail(f"No session {sid!r}")
    if s.get("setup"):
        if setup_session(sid):
            return 1
        s = session(sid)
    if asleep_since(sid) is not None:
        return 0
    if engine(s) == "chat" and agent_allowed(s):
        return Agent(s).run()       # amarchy agent: see "the chat engine"
    # The first prompt (amarchy new --prompt) goes to Claude once: if Claude
    # starts again later, it picks the conversation up instead.
    prompt = s.pop("prompt", None)
    if prompt is not None:
        save_session(s)
    sent = take(claude_dir(sid) / "send")
    prompt = sent if sent is not None and prompt is None else prompt
    prefill = take(claude_dir(sid) / "draft") or ""
    path = Path(s["path"])
    os.chdir(path)
    os.environ["PWD"] = str(path)
    editor = your_editor()
    shim = editor_shim(editor)
    if shim:
        os.environ["AMARCHY_VISUAL"] = editor
        os.environ["VISUAL"] = str(shim)
    # Ctrl+V pastes what you pasted in the app (see "clipboard"), and voice
    # mode records the phone's or the browser's microphone (amarchy rec).
    os.environ["PATH"] = paste_path()
    argv = claude_argv(s, prefill.strip("\n"), prompt)
    try:
        os.execvp(argv[0], argv)
    except OSError as e:
        print(f"\n  \033[31mCouldn't start Claude Code: {e}\033[0m\n", flush=True)
        return 1


def cmd_new(args):
    """amarchy new <project> [name] [--prompt <text>|-]: the new session's id
    on stdout. --prompt is the first thing its Claude is asked (- reads it
    from stdin). --no-jump, from when a desktop showed the new session, is
    still taken, and changes nothing: nothing opens anywhere."""
    prompt, rest = None, []
    it = iter(args)
    for a in it:
        if a == "--no-jump":
            pass
        elif a == "--prompt":
            prompt = next(it, None)
            if prompt is None:
                return fail("--prompt needs the text, or - to read it from stdin")
        elif a.startswith("--prompt="):
            prompt = a.split("=", 1)[1]
        elif a.startswith("--"):
            return fail(f"amarchy new doesn't know {a} (it takes --prompt)")
        else:
            rest.append(a)
    if not rest or len(rest) > 2:
        print(usage("new"), file=sys.stderr)
        return 1
    if prompt == "-":
        prompt = sys.stdin.read()
    if prompt is not None and not prompt.strip():
        return fail("--prompt is empty")
    repo = rest[0]
    sid = create(repo, rest[1] if len(rest) > 1 else auto_name(repo), prompt)
    if not sid:
        return 1
    print(sid)
    return 0


# ------------------------------------------------------------------ sleep
#
# A session you're not using sleeps, with only a badge on its Claude's screen
# saying so (sleep_badge): its Claude Code exits, so it holds no memory, and
# everything else stays as it was. Claude is stopped outright (SIGKILL), so it
# never gets to put the terminal back: its last screen stays in its tmux pane,
# the conversation, its prompt and the cursor in it. Type there (in Claude's
# terminal in a browser) and a stand-in for that prompt (woke) shows what you type
# right where Claude would; send it (Enter) and Claude comes back with it
# (`claude --resume <conversation> -- <message>`), its first screen replacing
# the old one in a single repaint. Anything the stand-in doesn't do (arrows,
# Ctrl keys, a new line, scrolling, a line too long) brings Claude back at
# once, with what you typed already in its prompt (--prefill). Whatever was
# typed in the prompt and not sent yet comes back too: before Claude exits,
# amarchy asks it for the prompt with Ctrl+G (Claude's "edit the prompt in your
# editor"), with amarchy-editor as the editor.
#
# A session whose tmux is gone (after a reboot) comes back asleep as well:
# there's no screen of Claude's to keep then, so amarchy draws the
# conversation and a prompt like Claude's, and the stand-in works the same.
# Sending it something from the phone or `amarchy send` wakes it with that
# as Claude's first message.
#
# What would be lost with Claude's process keeps a session awake: a turn in
# progress, a question waiting for you, commands running in the background,
# background agents still working, a /loop or a scheduled task, Remote Control.
# The timer (`amarchy sleep --idle`, every 30s from a systemd user timer) puts
# sessions to sleep once they've been idle, and open on no phone or browser,
# for `sleep --after` minutes.

SLEEP_AFTER_DEFAULT = 1         # minutes
QUIET = 30                      # seconds the conversation has to have been still
BUSY_CPU = 0.05                 # share of a core above which an idle-looking Claude is still doing something
HANDOVER_TIMEOUT = 3            # seconds Claude has to hand its prompt over
HANDOVER_STALE = 15             # seconds a request for the prompt counts
REPAINT = 0.3                   # seconds Claude gets to draw its prompt again after handing it over


def sleep_after():
    """Minutes a session waits, idle and open nowhere, before it sleeps (None: never)."""
    try:
        value = SLEEP_AFTER.read_text().strip()
    except OSError:
        return SLEEP_AFTER_DEFAULT
    if value == "off":
        return None
    try:
        return max(float(value), 0)
    except ValueError:
        return SLEEP_AFTER_DEFAULT


def asleep_since(sid):
    """When the session went to sleep, or None while it's awake."""
    try:
        return (claude_dir(sid) / "asleep").stat().st_mtime
    except OSError:
        return None


# How a sleeping session's pane looks: Claude's own last screen, still there
# ("frozen"), or one amarchy draws (a pane that started with Claude asleep).
FROZEN, DRAWN = "frozen", "drawn"


def mark_asleep(sid, look=DRAWN):
    write_file(claude_dir(sid) / "asleep", f"{time.strftime('%Y-%m-%d %H:%M:%S')}\n{look}\n")


def asleep_look(sid):
    try:
        lines = (claude_dir(sid) / "asleep").read_text().split("\n")
    except OSError:
        return None
    return lines[1] if len(lines) > 1 and lines[1] in (FROZEN, DRAWN) else DRAWN


def clear_asleep(sid):
    (claude_dir(sid) / "asleep").unlink(missing_ok=True)


WAKING = 60     # seconds a session counts as waking until its Claude says it's up


def woken(sid):
    """The session isn't asleep any more, and its Claude is on its way: it's
    waking until Claude's SessionStart hook says it's up (or for WAKING)."""
    write_file(claude_dir(sid) / "waking", "")
    clear_asleep(sid)


def waking_now(sid):
    """Whether the session's Claude was woken and isn't up yet."""
    try:
        return time.time() - (claude_dir(sid) / "waking").stat().st_mtime < WAKING
    except OSError:
        return False


def clear_waking(sid):
    (claude_dir(sid) / "waking").unlink(missing_ok=True)


def all_background_sessions():
    """Every Claude Code background session (/bg, `claude --bg`) still
    running, as Claude Code lists them in ~/.claude/sessions."""
    out = []
    for f in (HOME / ".claude/sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if d.get("kind") == "bg" and d.get("pid") and Path(f"/proc/{d['pid']}").exists():
            out.append(d)
    return out


def background_sessions(s, every=None):
    """The background sessions started in this session's worktree (of every,
    if they were already read)."""
    return [d for d in (all_background_sessions() if every is None else every)
            if (d.get("cwd") or "") == s["path"] or (d.get("cwd") or "").startswith(s["path"] + "/")]


def stop_background(s, only_idle=True):
    """Stop the session's background sessions (all of them, or those with
    nothing to do). Claude Code keeps their conversations: `claude attach`
    brings one back. Returns how many it stopped."""
    stopped = 0
    for d in background_sessions(s):
        if only_idle and d.get("status") != "idle":
            continue
        try:
            exe = os.readlink(f"/proc/{d['pid']}/exe").removesuffix(" (deleted)")
        except OSError:
            exe = ""
        exe = exe if exe and os.path.exists(exe) else shutil.which("claude")
        job = d.get("jobId") or d.get("sessionId", "")[:8]
        if not exe or not job:
            continue
        try:
            r = subprocess.run([exe, "stop", job], capture_output=True, text=True, timeout=20,
                               stdin=subprocess.DEVNULL, env=clean_env())
        except subprocess.TimeoutExpired:
            continue
        stopped += r.returncode == 0
    return stopped


def claude_key(name):
    """The key Claude Code has for one of its actions (keybindings.json), as
    tmux send-keys names it: "C-g"."""
    key = {"chat:externalEditor": "ctrl+g"}.get(name, "")
    try:
        data = json.loads((HOME / ".claude/keybindings.json").read_text())
    except (OSError, ValueError):
        data = {}

    def walk(node):
        if isinstance(node, dict):
            for k, v in node.items():
                if v == name and "+" in k and " " not in k:
                    yield k
                else:
                    yield from walk(v)
        elif isinstance(node, list):
            for v in node:
                yield from walk(v)
    key = next(walk(data), key)
    *mods, last = key.lower().split("+")
    prefix = "".join({"ctrl": "C-", "control": "C-", "alt": "M-", "meta": "M-", "option": "M-",
                      "shift": "S-"}.get(m, "") for m in mods)
    return prefix + (last if len(last) == 1 else last.capitalize())


def hand_over_prompt(s):
    """Ask the session's Claude for what's typed in its prompt, and keep it
    for when it wakes (in its draft). False when Claude didn't hand it over
    (a menu or a dialog open, say), so the session had better stay awake."""
    d = claude_dir(s["id"])
    (d / "draft").unlink(missing_ok=True)
    write_file(d / "handover", str(time.time()))
    tmux("send-keys", "-t", f"={tmux_name(s['id'])}:", claude_key("chat:externalEditor"))
    end = time.time() + HANDOVER_TIMEOUT
    while time.time() < end and (d / "handover").exists():
        time.sleep(0.05)
    handed = not (d / "handover").exists()
    (d / "handover").unlink(missing_ok=True)
    # Claude reads its prompt back from the file it gave the editor, deletes
    # the file, then draws its prompt again where it said "Save and close
    # editor to continue": that last screen is the one that stays.
    try:
        given = Path((d / "handover-file").read_text())
    except OSError:
        given = None
    while handed and given and given.exists() and time.time() < end:
        time.sleep(0.03)
    (d / "handover-file").unlink(missing_ok=True)
    if handed:
        time.sleep(REPAINT)
    return handed


def cmd_editor(args):
    """amarchy-editor, Claude's $VISUAL in a session: while amarchy is putting
    the session to sleep it keeps the prompt Claude hands it (and gives it
    back untouched); any other time it's just your editor."""
    sid = os.environ.get("AMARCHY_SESSION", "")
    files = [a for a in args if not a.startswith("-")]
    request = claude_dir(sid) / "handover" if sid else None
    if request and files and request.exists() and time.time() - request.stat().st_mtime < HANDOVER_STALE:
        try:
            text = Path(files[-1]).read_text(errors="replace")
        except OSError:
            text = ""
        write_file(claude_dir(sid) / "draft", text if text.strip() else "")
        write_file(claude_dir(sid) / "handover-file", files[-1])
        request.unlink(missing_ok=True)
        return 0
    editor = shlex.split(your_editor())
    try:
        os.execvp(editor[0], [*editor, *args])
    except OSError as e:
        return fail(f"can't run your editor {editor[0]}: {e}")


def conversation_records(f, tail=None):
    """The records of a conversation file, the last `tail` bytes of it only if given."""
    try:
        with open(f, "rb") as fh:
            if tail:
                fh.seek(max(fh.seek(0, 2) - tail, 0))
                fh.readline()       # most likely cut in half
            data = fh.read()
    except OSError:
        return []
    out = []
    for line in data.splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def tool_uses(records):
    for r in records:
        if r.get("type") == "assistant":
            for block in r.get("message", {}).get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    yield r, block


def timestamp(record):
    try:
        return calendar.timegm(time.strptime(record["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
    except (KeyError, ValueError, TypeError):
        return 0


def sleep_blockers(s, pane, procs, auto):
    """Why the session's Claude had better not exit now, if anything: what
    it would lose. Empty when it can sleep."""
    reasons = []
    sid = s["id"]
    pid = pane_claude(pane, procs)
    status = (STATUS / sid).read_text().strip() if (STATUS / sid).exists() else "idle"
    if status == "working":
        reasons.append("it's working")
    elif status == "waiting":
        reasons.append("it's waiting for your answer")
    if not pid:
        return reasons + ["Claude isn't running in its pane"]
    if engine(s) == "chat":
        live = agent_live(sid)
        if live.get("pending") and status != "waiting":
            reasons.append("it's waiting for your answer")
        if live.get("tasks"):
            reasons.append(f"a task is running in the background ({live['tasks'][0].get('description') or ''})")
        if live.get("queue"):
            reasons.append("a message is waiting to go in")
    shells = [p for p in descendants(pid, procs) if "/shell-snapshots/" in " ".join(cmdline(p))]
    if shells:
        command = " ".join(cmdline(shells[0]))
        command = re.sub(r"^.*?&& eval '?|'? < /dev/null.*$|' && pwd -P.*$", "", command)[:60]
        reasons.append(f"a command is running in the background ({command})" if command else
                       "a command is running in the background")
    f = transcript(s)
    if f:
        subagents = f.with_suffix("") / "subagents"
        files = [f, *(subagents.glob("*.jsonl") if subagents.is_dir() else [])]
        latest = max((x.stat().st_mtime for x in files if x.exists()), default=0)
        if time.time() - latest < QUIET:
            reasons.append("its conversation is still moving")
        if (f.with_suffix("") / "bridge-pointer.json").exists():
            reasons.append("Remote Control is on")
        records = conversation_records(f, tail=4_000_000)
        wakes, crons = None, 0
        for r, use in tool_uses(records):
            given = use.get("input") or {}
            if use.get("name") == "ScheduleWakeup":
                wakes = None if given.get("stop") else timestamp(r) + float(given.get("delaySeconds") or 0)
            elif use.get("name") == "CronCreate" and time.time() - timestamp(r) < 7 * 86400:
                crons += 1
            elif use.get("name") == "CronDelete":
                crons = max(crons - 1, 0)
        if wakes and wakes + 120 > time.time():
            reasons.append(f"a /loop wakes it again at {time.strftime('%H:%M', time.localtime(wakes))}")
        if crons:
            reasons.append("it has scheduled tasks")
    if auto:
        # Busy without a sign of it anywhere else (a background agent thinking, say).
        sample = claude_dir(sid) / "cpu"
        try:
            was_pid, was_ticks, was_at = json.loads(sample.read_text())
        except (OSError, ValueError):
            was_pid, was_ticks, was_at = None, 0, 0
        ticks, now = procs[pid][2], time.time()
        write_file(sample, json.dumps([pid, ticks, now]))
        if was_pid != pid or now - was_at > 600:
            reasons.append("amarchy is still getting a sense of how busy it is")
        elif (ticks - was_ticks) / os.sysconf("SC_CLK_TCK") / max(now - was_at, 1) > BUSY_CPU:
            reasons.append("it's busy")
    return reasons


def put_to_sleep(s, auto=False, force=False):
    """Stop a session's Claude Code, keeping the session as it was. Returns
    None once it sleeps, else why it didn't."""
    sid = s["id"]
    if s.get("setup"):
        return "it's still being set up"
    pane = host_pane(s)
    if not pane:
        if asleep_since(sid) is None:
            mark_asleep(sid)
        return None
    if asleep_since(sid) is not None:
        return None
    procs = processes()
    reasons = sleep_blockers(s, pane, procs, auto)
    if reasons and not force:
        return "; ".join(reasons)
    pid = pane_claude(pane, procs)
    loop = pane_loop(pane, procs)
    # Claude hands its prompt over with or without the loop (its editor is
    # amarchy's either way). The chat engine has no prompt to hand over.
    if pid and engine(s) == "terminal" and not hand_over_prompt(s) and not force:
        return "Claude didn't hand over its prompt (a menu or a dialog open?)"
    if auto and sid in on_screen()[0]:
        (claude_dir(sid) / "draft").unlink(missing_ok=True)    # it's still in Claude's prompt
        return "you came back to it"
    try:
        set_conversation_id(sid, json.loads((HOME / f".claude/sessions/{pid}.json").read_text()).get("sessionId", ""))
    except (OSError, ValueError, TypeError):
        pass
    mark_asleep(sid, FROZEN if loop else DRAWN)
    clear_waking(sid)
    try:
        stop_background(s)
        if pid:
            freeze_claude(pid, procs)
    except BaseException:
        clear_asleep(sid)       # it isn't asleep: say so, for whoever tries next
        raise
    if not loop:
        host_respawn(s)         # on the loop that sleeps, showing the conversation as amarchy draws it
    return None


def freeze_claude(pid, procs):
    """Stop a Claude Code at once, before it can put the terminal back (its
    last screen stays), then what it ran (MCP servers) and what it leaves in
    ~/.claude/sessions. It's idle: its conversation is all written already."""
    children = descendants(pid, procs)
    try:
        info = json.loads((HOME / f".claude/sessions/{pid}.json").read_text())
    except (OSError, ValueError):
        info = {}
    try:
        os.kill(pid, 9)
    except ProcessLookupError:
        pass
    end = time.time() + 3
    while time.time() < end and Path(f"/proc/{pid}").exists():
        time.sleep(0.05)
    for p in children:
        try:
            os.kill(p, 15)
        except ProcessLookupError:
            pass
    if info.get("pid") == pid:
        (HOME / f".claude/sessions/{pid}.json").unlink(missing_ok=True)
        for key in (HOME / ".claude/sessions").glob(f"{pid}.*.key"):
            key.unlink(missing_ok=True)
        if info.get("messagingSocketPath"):
            Path(info["messagingSocketPath"]).unlink(missing_ok=True)


def wake(s):
    """Start a sleeping session's Claude again, in its tmux pane (starting
    its tmux if it's gone)."""
    sid = s["id"]
    if asleep_since(sid) is None:
        return
    woken(sid)
    pane = host_pane(s)
    if not pane:
        host_start(s, wake=True)
    else:
        # The pane's loop waits for a key: stop waiting, as if one came.
        end = time.time() + 3
        while time.time() < end:
            procs = processes()
            loop = pane_loop(pane, procs)
            readers = [p for p in descendants(loop, procs) if procs[p][1] == "dd"] if loop else []
            for p in readers:
                os.kill(p, 15)
            if readers:
                break
            if not loop:        # a pane from before sessions slept, at "Press Enter"
                tmux("send-keys", "-t", f"={tmux_name(sid)}:", "Enter")
                break
            time.sleep(0.1)


def sleep_lock(wait):
    """One sleeper at a time, the timer or you: the held lock. The timer
    doesn't wait (None: it's running already); you wait for it."""
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "sleep.lock", "a")
    end = time.time() + (30 if wait else 0)
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except OSError:
            if time.time() >= end:
                lock.close()
                return None
            time.sleep(0.2)


def sleep_all(force=False):
    """Every session that can sleep and is open nowhere goes to sleep now:
    (the ids that did, [(id, why not)] for the ones kept awake). Called with
    the sleep lock held."""
    shown, slept, kept = on_screen()[0], [], []
    for s in session_view():
        if s["awake"] and not s["sleeping"] and s["id"] not in shown and s["status"] in ("idle", "waiting"):
            err = put_to_sleep(session(s["id"]), force=force)
            if err:
                kept.append((s["id"], err))
            else:
                slept.append(s["id"])
    return slept, kept


def cmd_sleep(args):
    """`amarchy sleep [id] [--force]`, `--all`, `--idle` (the timer),
    `--after [minutes|off]`."""
    force = "--force" in args
    rest = [a for a in args if a != "--force"]
    if rest[:1] == ["--after"]:
        if len(rest) == 1:
            after = sleep_after()
            print("off" if after is None else f"{after:g}")
            return 0
        value = rest[1].lower()
        try:
            if value != "off" and float(value) < 0:
                raise ValueError
        except ValueError:
            return fail("usage: amarchy sleep --after <minutes>|off")
        write_file(SLEEP_AFTER, value + "\n")
        return 0
    idle = rest[:1] == ["--idle"]
    lock = sleep_lock(wait=not idle)
    if not lock:
        return 0 if idle else fail("another amarchy is putting sessions to sleep")
    with lock:
        if idle:
            return sleep_idle()
        if rest[:1] == ["--all"]:
            slept, kept = sleep_all(force)
            for sid, err in kept:
                print(f"{sid}: awake, {err}")
            print(f"{len(slept)} session{'s' if len(slept) != 1 else ''} asleep"
                  + (f", {len(kept)} kept awake" if kept else ""))
            return 0
        sid = rest[0] if rest else own_session_id()
        s = session(sid) if sid else None
        if not s:
            return fail(f"No session {sid!r}" if sid else "Not in a session (name one: amarchy sleep <id>)")
        err = put_to_sleep(s, force=force)
        if err:
            print(f"{s['repo']} · {s['name']} stays awake: {err}"
                  + ("" if force else ". amarchy sleep --force puts it to sleep anyway."))
            return 1
        return 0


def sleep_idle():
    """What the timer does: every session that has been idle and open on no
    phone or browser (on_screen) for long enough goes to sleep, if nothing
    would be lost. The time counts from when it was last open on one, if
    that's later."""
    after = sleep_after()
    if after is None:
        return 0
    shown, last = on_screen()
    for s in session_view():
        if not s["awake"] or s["sleeping"] or s["id"] in shown or s["status"] not in ("idle", "waiting"):
            continue
        try:
            since = (STATUS / s["id"]).stat().st_mtime
        except OSError:
            since = 0
        if time.time() - max(since, last.get(s["id"], 0)) >= after * 60:
            put_to_sleep(session(s["id"]), auto=True)
    return 0


def on_screen():
    """The sessions open on a device now (their conversation on a phone,
    their terminals in a browser), as the app's server keeps them in
    APP_VIEWING, and when each was last open on one: (ids, {id: time})."""
    try:
        d = json.loads(APP_VIEWING.read_text())
    except (OSError, ValueError):
        d = {}
    d = d if isinstance(d, dict) else {}
    last = {k: v for k, v in (d.get("at") if isinstance(d.get("at"), dict) else {}).items()
            if isinstance(v, (int, float))}
    # A server that's gone (restarting, say) shows nothing anymore.
    up = isinstance(d.get("pid"), int) and Path(f"/proc/{d['pid']}").exists()
    shown = {x for x in d.get("open") or [] if isinstance(x, str)} if up else set()
    return shown | {k for k, v in last.items() if time.time() - v < APP_SEEN}, last


def cmd_wake(args):
    sid = args[0] if args else own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one: amarchy wake <id>)")
    wake(s)
    return 0


# The badge in the top right corner of a sleeping session's Claude: what you
# see instead of a status glyph (the list keeps showing the session as idle).
# It says the session is asleep, and the moment a key wakes it, that Claude
# is on its way, for the second or so until Claude's first screen covers it.
ASLEEP_BADGE = "Asleep, its memory freed · type to wake"
TYPING_BADGE = "Asleep · Enter wakes Claude with this"
WAKING_BADGE = "Waking Claude…"


def sleep_badge(text, loud=False):
    """Draw the badge, leaving the cursor where it was: dim while the session
    sleeps, in reverse video while it wakes."""
    try:
        width = os.get_terminal_size(1).columns
    except OSError:
        return
    label = f" 󰒲 {text} "
    if text_width(label) + 2 > width:
        label = " 󰒲 "
    col = max(width - text_width(label), 1)
    style = "\033[1;7m" if loud else "\033[2;7m"
    os.write(1, f"\0337\033[1;{col}H{style}{label}\033[0m\0338".encode())


# What a waking pane turns off for the second before Claude is back:
# mouse reports (the rest of a scroll would pile up and land in Claude as keys)
# and the alternate scroll mode a terminal falls back to without them (the
# wheel as arrow keys, which Claude's prompt takes for its history). Claude
# turns the mouse back on as it starts.
MOUSE_OFF = b"\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l\033[?1007l"


def cmd_asleep(sid):
    """The pane loop, once Claude has exited: 0 if the session sleeps (the
    pane keeps showing it), 1 if Claude was quit (the loop then offers to
    start it again: held)."""
    s = session(sid)
    if not s:
        return 1
    if asleep_since(sid) is None:
        # Woken as Claude was stopped, before this got here: on to the wait
        # for a key, which wake() ends (it looks for it a moment).
        return 0 if waking_now(sid) else 1
    out = sys.stdout
    if asleep_look(sid) == FROZEN:
        # Claude's screen stays as it was. Only what would now come in without
        # Claude to take it is turned off: mouse movement and focus changes.
        # The wheel and clicks still report, as they did to Claude: they wake it.
        out.write("\033[?1003l\033[?1002l\033[?1004l\033[?2004h")
        out.flush()
        sleep_badge(ASLEEP_BADGE)
        return 0
    sh("stty", "sane")
    try:
        width = os.get_terminal_size().columns
    except OSError:
        width = 100
    draft = (claude_dir(sid) / "draft").read_text() if (claude_dir(sid) / "draft").exists() else ""
    lines = draft.rstrip("\n").split("\n")
    rule = f"\033[2m{'─' * width}\033[0m"
    out.write("\033[H\033[2J\033[3J")
    out.write(f"\033]0;{session_task(s, '') or s['repo'] + ' · ' + s['name']}\007")
    out.write("".join(line + "\n" for line in conversation_lines(s, width)))
    out.write(f"\n{rule}\n\033[1m❯\033[0m {lines[0]}\n" + "".join(f"  {line}\n" for line in lines[1:]))
    out.write(f"{rule}\n\033[2m  ? for shortcuts\033[0m")
    # The cursor where Claude's would be, at the end of the prompt; keys come
    # in the way Claude asks for them (kitty's protocol, pastes bracketed).
    out.write(f"\033[2A\r\033[{2 + text_width(lines[-1])}C\033[>5u\033[?2004h")
    out.flush()
    sleep_badge(ASLEEP_BADGE)
    return 0


def text_width(text):
    """Columns a text takes in a terminal."""
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
               for c in text)


def next_key(buf):
    """The first key in what the terminal sent: (kind, bytes), and the rest.
    kind is None when the key isn't all there yet."""
    if not buf:
        return None, buf
    if buf.startswith(b"\x1b[200~"):
        end = buf.find(b"\x1b[201~")
        return (("paste", buf[6:end]), buf[end + 6:]) if end >= 0 else (None, buf)
    if buf.startswith(b"\x1b["):
        m = re.match(rb"\x1b\[[\x30-\x3f]*[\x20-\x2f]*[\x40-\x7e]", buf)
        return (("csi", m.group()), buf[m.end():]) if m else (None, buf)
    if buf.startswith(b"\x1b"):
        return (("esc", buf[:2]), buf[2:]) if len(buf) > 1 else (None, buf)
    size = 1 if buf[0] < 0xc0 else 2 if buf[0] < 0xe0 else 3 if buf[0] < 0xf0 else 4
    if len(buf) < size:
        return None, buf
    return ("char", buf[:size]), buf[size:]


TYPING_IDLE = 120       # seconds typing in a sleeping session can pause before it sleeps on


def waking(keep_typing=False):
    """A sleeping pane, the moment it starts waking: the badge says so, the
    mouse stops reporting until Claude is back, and what came in meanwhile
    is taken off the terminal so Claude doesn't get it as keys. What was typed
    there (the text, if keep_typing) is returned to go in Claude's prompt;
    a scroll or a click is dropped (Claude's own screen takes the next one)."""
    os.write(1, MOUSE_OFF)
    sleep_badge(WAKING_BADGE, loud=True)
    time.sleep(0.03)            # what was already on its way
    buf, typed = b"", ""
    while select.select([0], [], [], 0)[0]:
        more = os.read(0, 4096)
        if not more:
            break
        buf += more
    while buf:
        token, buf = next_key(buf)
        if token is None:
            break
        kind, raw = token
        if kind == "paste":
            typed += raw.decode(errors="ignore").replace("\r\n", "\n").replace("\r", "\n")
        elif kind == "char" and raw.decode(errors="ignore").isprintable():
            typed += raw.decode(errors="ignore")
    return typed if keep_typing else ""


def cmd_woke(sid, key):
    """The pane loop, once a key came in a sleeping session (or `amarchy
    wake`): a stand-in for Claude's prompt. What you type shows where Claude
    would show it, and Enter brings Claude back with it, sent. Anything else
    (arrows, Ctrl keys, a new line, the wheel, a line too long for the box)
    brings Claude back with what you typed in its prompt. Returns 0 to start
    Claude, 3 to go on sleeping (nothing typed, or a long pause)."""
    d = claude_dir(sid)
    if asleep_since(sid) is None:
        waking()                # woken from outside
        return 0
    buf = bytes.fromhex(key.replace(" ", "").strip()) if key.strip() else b""
    if not buf:
        return 3
    draft = (d / "draft").read_text() if (d / "draft").exists() else ""
    text = draft.rstrip("\n")

    def read(timeout):
        if not select.select([0], [], [], timeout)[0]:
            return None
        return os.read(0, 4096) or None

    # Where the cursor is (Claude leaves it at the end of its prompt): the
    # terminal's answer comes in among the keys.
    os.write(1, b"\033[6n")
    where, end = None, time.time() + 0.5
    while time.time() < end:
        m = re.search(rb"\x1b\[(\d+);(\d+)R", buf)
        if m:
            where, buf = int(m.group(2)), buf[:m.start()] + buf[m.end():]
            break
        more = read(0.05)
        if more:
            buf += more
    try:
        width = os.get_terminal_size(1).columns
    except OSError:
        width = 100
    # Typing goes on in place only where amarchy knows what's on the line:
    # the cursor right after the prompt's last line ("❯ " or "  " before it).
    in_place = where == 3 + text_width(text.split("\n")[-1])
    edited = False

    def wake(typed):
        typed += waking(keep_typing=True)
        if typed:
            write_file(d / "draft", typed)
        else:
            (d / "draft").unlink(missing_ok=True)
        woken(sid)
        return 0

    while True:
        token, buf = next_key(buf)
        if token is None:
            more = read(TYPING_IDLE if edited else 0.3)
            if more:
                buf += more
                continue
            if buf == b"\x1b":
                token, buf = ("esc", buf), b""
            else:
                # A pause: what's typed stays, as Claude's prompt, until it wakes.
                if edited:
                    write_file(d / "draft", text)
                return 3
        kind, raw = token
        if kind == "paste" or kind == "char" and (raw.decode(errors="ignore").isprintable() or raw == b"\r"):
            typed = raw.decode(errors="ignore").replace("\r\n", "\n").replace("\r", "\n" if kind == "paste" else "\r")
            if typed == "\r":
                if text.strip():
                    waking()
                    write_file(d / "send", text)
                    (d / "draft").unlink(missing_ok=True)
                    woken(sid)
                    return 0
                continue
            if not in_place or "\n" in typed or 3 + text_width(text.split("\n")[-1] + typed) >= width:
                return wake(text + typed)
            if not edited:
                os.write(1, b"\033[K")      # a suggestion Claude showed in the empty prompt
                sleep_badge(TYPING_BADGE)
                edited = True
            os.write(1, typed.encode())
            text += typed
        elif kind == "char" and raw in (b"\x7f", b"\x08"):
            line = text.split("\n")[-1]
            if not in_place or not line and "\n" in text:
                return wake(text)
            if line:
                cols = text_width(line[-1])
                os.write(1, b"\b" * cols + b" " * cols + b"\b" * cols)
                text, edited = text[:-1], True
        elif kind == "csi" and raw[-1:] in b"Mm" and raw.startswith(b"\x1b[<"):
            if int(raw[3:].split(b";")[0] or 0) & 64:
                return wake(text)       # the wheel: Claude scrolls its conversation
        elif kind == "csi" and raw in (b"\x1b[I", b"\x1b[O") or raw.endswith(b"R"):
            continue                    # focus, a late cursor report
        elif kind == "csi" and raw == b"\x1b[13u":
            buf = b"\r" + buf           # Enter, the kitty way
        elif kind == "csi" and re.fullmatch(rb"\x1b\[13;\d+u", raw):
            return wake(text + "\n")    # Shift+Enter and the like: a new line
        else:
            return wake(text)


ANSI = re.compile(r"\x1b\[[0-9;]*m")


def wrap(line, width, hang=""):
    """Wrap a line at spaces to width visible characters (color codes take
    none), the lines after the first indented by hang. Long words are cut."""
    out, current, size = [], "", 0
    for word in re.split(r"(?<=\S)(?= )|(?<= )(?=\S)", line):
        visible = len(ANSI.sub("", word))
        if size + visible > width and current.strip():
            out.append(current.rstrip())
            current, size = hang, len(hang)
            if not word.strip():
                continue
        while size + visible > width and len(word) > 1:
            cut = max(width - size, 1)
            out.append(current + word[:cut])
            word = word[cut:]
            current, size, visible = hang, len(hang), len(ANSI.sub("", word))
        current += word
        size += visible
    return [*out, current.rstrip()]


def conversation_lines(s, width):
    """The conversation as an asleep pane shows it: what you said, what
    Claude answered, a line for each tool it used. The latest part of it, as
    much as fits in the scrollback."""
    f = transcript(s)
    if not f:
        logs = sorted(projects_dir(s["path"]).glob("*.jsonl"), key=lambda x: x.stat().st_mtime)
        f = logs[-1] if logs else None
    if not f:
        return ["", "  \033[2mNo conversation yet.\033[0m"]
    records = conversation_records(f, tail=8_000_000)
    by_uuid = {r["uuid"]: r for r in records if r.get("uuid")}
    leaf = next((r for r in reversed(records) if r.get("type") in ("user", "assistant") and r.get("uuid")), None)
    chain, seen = [], set()
    while leaf and leaf["uuid"] not in seen:
        seen.add(leaf["uuid"])
        chain.append(leaf)
        leaf = by_uuid.get(leaf.get("parentUuid"))
    chain.reverse()
    out = []

    def markdown(line):
        """Claude's Markdown, lightly: headings and bold in bold, code in color."""
        if re.match(r"#{1,6} ", line):
            return f"\033[1m{line.lstrip('#').strip()}\033[22m"
        line = re.sub(r"\*\*(.+?)\*\*", "\033[1m\\1\033[22m", line)
        return re.sub(r"`([^`]+)`", "\033[36m\\1\033[39m", line)

    def para(text, first, rest, style="", md=False):
        fence = False
        for i, line in enumerate(text.rstrip().splitlines() or [""]):
            if line.lstrip().startswith("```"):
                fence = not fence
                continue
            # A list item's lines wrap under its text, not under its bullet.
            hang = " " * len(re.match(r"\s*(?:[-*+] |\d+[.)] )?", line).group())
            if md and not fence:
                line = markdown(line)
            elif fence:
                line = f"\033[36m{line}\033[39m"
            wrapped = wrap(line, max(width - len(rest) - 1, 20), hang)
            for j, w in enumerate(wrapped):
                prefix = first if i == 0 and j == 0 else rest
                out.append(f"{style}{prefix}{w}\033[0m" if style else f"{prefix}{w}\033[0m")

    for r in chain:
        if r.get("isMeta") or r.get("isSidechain"):
            continue
        content = r.get("message", {}).get("content")
        if r["type"] == "user":
            if r.get("isCompactSummary"):
                out += ["", "\033[2m  ··· earlier in the conversation (compacted) ···\033[0m"]
                continue
            blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
            for b in blocks:
                if not isinstance(b, dict) or b.get("type") != "text":
                    if isinstance(b, dict) and b.get("type") == "image":
                        out += ["", "\033[1m❯\033[0m [image]"]
                    continue
                text = b.get("text", "")
                command = re.search(r"<command-name>(.*?)</command-name>", text)
                if command:
                    args = re.search(r"<command-args>(.*?)</command-args>", text, re.S)
                    out += ["", f"\033[1m❯ {command.group(1)} {args.group(1).strip() if args else ''}\033[0m"]
                    continue
                if text.startswith(("<local-command", "<system-reminder")):
                    continue
                if text.startswith("<task-notification>"):
                    summary = re.search(r"<summary>(.*?)</summary>", text, re.S)
                    out += ["", f"\033[2m  ⏺ {(summary.group(1) if summary else 'a background task finished').strip()[:width - 6]}\033[0m"]
                    continue
                text = re.sub(r"<pasted_content[^>]*>.*?</pasted_content[^>]*>", "[pasted text]", text, flags=re.S)
                lines = text.strip().splitlines()
                if len(lines) > 30:
                    text = "\n".join(lines[:30] + [f"… {len(lines) - 30} more lines"])
                out.append("")
                para(text, "❯ ", "  ", "\033[1m")
        else:
            for b in content or []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text", "").strip():
                    out.append("")
                    para(b["text"], "● ", "  ", md=True)
                elif b.get("type") == "tool_use":
                    given = b.get("input") or {}
                    detail = next((str(given[k]) for k in ("description", "command", "file_path", "pattern",
                                                           "prompt", "url", "query", "skill") if given.get(k)), "")
                    detail = " ".join(detail.split())
                    line = f"  ⎿ {b.get('name', 'tool')}" + (f"({detail})" if detail else "")
                    out.append(f"\033[2m{line[:width - 1]}\033[0m")
    return out[-3000:]


# ------------------------------------------------------------------ close

def dirty(path):
    return bool(sh("git", "status", "--porcelain", cwd=path).stdout.strip())


def close(sid, force=False):
    """Close a session: its row goes at once; then, in the background, its
    Claude Code exits the way it would on its own, its tmux ends, the
    worktree is removed and the branch dropped if merged (reap).

    Returns an error string instead of closing when the worktree has
    uncommitted changes and force is False."""
    s = session(sid)
    if not s:
        return None
    path = Path(s["path"])
    if path.exists() and dirty(path) and not force:
        return "uncommitted changes"
    # Out of the list, and out of reach of everything that reads it (the
    # app, its Claude's hooks, the pane's loop, which then lets its tmux end).
    # The file waits in CLOSING until reap is done with it.
    CLOSING.mkdir(parents=True, exist_ok=True)
    keep = {k: v for k, v in s.items() if k not in VIEW_FIELDS}
    if force:
        keep["force"] = True
    write_file(CLOSING / f"{sid}.json", json.dumps(keep))
    (SESSIONS / f"{sid}.json").unlink(missing_ok=True)
    (STATUS / sid).unlink(missing_ok=True)
    mark_seen(sid)
    detach([ENTRY, "reap", sid])
    return None


def resume_closing():
    """Finish closing the sessions a reap was cut short on (a crash, a
    reboot): those in CLOSING that nothing is reaping."""
    for f in CLOSING.glob("*.json") if CLOSING.is_dir() else ():
        lock = reap_lock(f.stem)
        if lock:
            lock.close()
            detach([ENTRY, "reap", f.stem])


def installed_from(path):
    """Whether the installed amarchy (the CLI install.sh links) runs from the
    checkout at path."""
    try:
        return os.readlink(INSTALLED).startswith(str(path).rstrip("/") + "/")
    except OSError:
        return False


def last_line(result, fallback):
    """The last line a command wrote to stderr (or stdout): why it failed."""
    return ((result.stderr or result.stdout).strip().splitlines() or [fallback])[-1]


def reap_lock(sid):
    """The lock of a session's reap, held while it lasts: the open file, or
    None when another reap has it."""
    CLOSING.mkdir(parents=True, exist_ok=True)
    lock = open(CLOSING / f"{sid}.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return None
    return lock


def stop_claude(pane):
    """End the Claude Code in a session's pane as quitting it would (its
    SessionEnd hooks run, the conversation is saved): SIGTERM, and SIGKILL
    only if it's still there after a while."""
    procs = processes()
    pid = pane_claude(pane, procs)
    if not pid:
        return
    try:
        os.kill(pid, 15)
    except ProcessLookupError:
        return
    end = time.time() + 8
    while time.time() < end and Path(f"/proc/{pid}").exists():
        time.sleep(0.1)
    try:
        os.kill(pid, 9)
    except ProcessLookupError:
        pass


def stop_leftovers(path):
    """Stop what still runs from a worktree once its session's Claude and
    tmux are gone: whatever Claude started in the background (a
    `nohup pnpm dev &`) lives on outside them, holding its port and serving
    files that are about to go. A process counts if its working directory or
    its executable is in the worktree. Whole process groups get SIGTERM when
    all of them are in it, the rest one by one; SIGKILL for what's left after
    a few seconds. Never this process or what started it."""
    inside = str(path).rstrip("/") + "/"
    procs = processes()
    spared, pid = set(), os.getpid()
    while pid > 1 and pid not in spared:
        spared.add(pid)
        pid = procs.get(pid, (0,))[0]

    def in_worktree(p):
        for link in ("cwd", "exe"):
            try:
                target = os.readlink(f"/proc/{p}/{link}").removesuffix(" (deleted)")
            except OSError:       # gone, or not ours
                continue
            if (target + "/").startswith(inside):
                return True
        return False

    found = {p for p in procs if p not in spared and in_worktree(p)}
    if not found:
        return 0
    groups = {}
    for p in procs:
        try:
            groups.setdefault(os.getpgid(p), set()).add(p)
        except OSError:
            pass
    for p in found:
        try:
            g = os.getpgid(p)
        except OSError:
            continue
        if g > 1 and groups.get(g, set()) <= found:
            try:
                os.killpg(g, 15)
                continue
            except OSError:
                pass
        try:
            os.kill(p, 15)
        except OSError:
            pass
    def running(p):
        try:
            stat = Path(f"/proc/{p}/stat").read_text()
        except OSError:
            return False
        return stat[stat.rfind(")") + 2] != "Z"   # a zombie only waits for its parent

    end = time.time() + 5
    while time.time() < end and any(running(p) for p in found):
        time.sleep(0.1)
    for p in found:
        if running(p) and in_worktree(p):     # not a new process that got its pid
            try:
                os.kill(p, 9)
            except OSError:
                pass
    return len(found)


def cmd_reap(sid):
    """The rest of close, detached from whatever asked for it (the app, a
    session's Claude closing another): the session's Claude Code and its
    background sessions stop, its tmux ends, whatever still runs from the
    worktree is stopped, then the worktree goes."""
    f = CLOSING / f"{sid}.json"
    lock = reap_lock(sid) if f.exists() else None
    if not lock or not f.exists():     # another reap has it, or had it and is done
        return 0
    try:
        s = json.loads(f.read_text())
    except (OSError, ValueError):
        return 0
    force = bool(s.pop("force", False))
    path = Path(s["path"])
    # Its background sessions (/bg) would go on working in a worktree that's gone.
    stop_background(s, only_idle=False)
    host_stop(s)
    repo_dir = WORK / s["repo"]

    def keep_open():
        # Back in the list rather than lost.
        save_session(s)
        f.unlink(missing_ok=True)
        (CLOSING / f"{sid}.lock").unlink(missing_ok=True)
        return 1

    # The installed amarchy runs from this worktree (it was being tried live):
    # put it back on the main checkout first, or the CLI and the app would go
    # with the worktree. Its install.sh restarts the app.
    if installed_from(path) and (repo_dir / "install.sh").exists():
        put = sh(str(repo_dir / "install.sh"), "--force", cwd=repo_dir)
        if put.returncode != 0:
            print(f"amarchy: couldn't close {sid}: amarchy runs from it, and putting it back on {repo_dir} "
                  f"failed ({last_line(put, 'install.sh failed')})", file=sys.stderr)
            return keep_open()
    # What its Claude started in the background (a dev server) outlives its
    # tmux, and would go on running from a worktree that's gone.
    stop_leftovers(path)
    removed = sh("git", "worktree", "remove", *(["--force"] if force else []), str(path), cwd=repo_dir)
    sh("git", "worktree", "prune", cwd=repo_dir)
    if path.exists() and removed.returncode != 0:
        # Changed after close looked (something still running wrote to it).
        print(f"amarchy: couldn't close {sid}: {last_line(removed, 'git worktree remove failed')}", file=sys.stderr)
        return keep_open()
    had_branch = sh("git", "rev-parse", "--verify", "--quiet", f"refs/heads/{s['branch']}",
                    cwd=repo_dir).returncode == 0
    if had_branch:
        sh("git", "branch", "-d", s["branch"], cwd=repo_dir)    # kept when it isn't merged
    shutil.rmtree(claude_dir(sid), ignore_errors=True)
    set_trust(path, False)
    f.unlink(missing_ok=True)
    (CLOSING / f"{sid}.lock").unlink(missing_ok=True)
    return 0


def cmd_close(args):
    sid = args[0] if args and not args[0].startswith("-") else own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one: amarchy close <id>)")
    err = close(sid, force="--force" in args)
    if err:
        return fail(f"{sid}: {err} (amarchy close {sid} --force discards them)")
    return 0


def cmd_rename(args):
    """Give a session a name of your own, shown in every list instead of the
    one made from Claude's title. The branch and worktree keep theirs."""
    args = list(args)
    sid = None
    if "--id" in args:
        i = args.index("--id")
        if i + 1 >= len(args):
            return fail("Usage: amarchy rename --id <id> <title>|--reset")
        sid = args[i + 1]
        del args[i:i + 2]
    reset = "--reset" in args
    title = " ".join(a for a in args if a != "--reset").strip()
    sid = sid or own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one with --id <id>)")
    if not reset and not title:
        print(usage("rename"), file=sys.stderr)
        return 1
    if reset:
        s.pop("title", None)
    else:
        s["title"] = title
    save_session(s)
    return 0


def agent_context(s):
    """What Claude is told when its session starts (and again after a /clear or a
    compaction): that it runs in amarchy, which session it is, and where the rest
    is (the amarchy skill, installed with amarchy, has the details)."""
    name, bind = host_network()
    text = (f"This Claude Code session runs inside amarchy: the user's parallel Claude Code sessions on a "
            f"server, {name}, that they reach from their phone and their computer's browser through the "
            f"amarchy app (it shows your conversation, your questions as buttons, and your terminal). You are "
            f"session {s['name']}: a git worktree of {s['repo']} at {s['path']}, on branch {s['branch']} "
            f"(made from {s['base']}). The project's main checkout is {WORK / s['repo']}; other sessions work "
            f"in worktrees of their own. This session also has a terminal of its own, where the project runs; "
            f"on a computer the app shows it beside you. The `amarchy` CLI drives all of it and acts on this "
            f"session (AMARCHY_SESSION={s['id']} in your environment). The other sessions are Claude Code too: "
            f"you can message them (ListAgents, SendMessage), and start one with a task of its own "
            f"(amarchy new <project> --prompt). Use the amarchy skill before running it, or when the work "
            f"involves other sessions, worktrees, that terminal or merging back into main. The user's browser "
            f"isn't on this machine, and nothing you open here (a browser, a GUI app) reaches their screen: "
            f"tell them what to open instead. ")
    if bind:
        text += (f"For them to open something you serve (a dev server, a preview), listen on {bind} "
                 f"(reachable only from their private network), and give them http://{name}:<port>. ")
    else:
        text += (f"What you serve here is reachable only on this machine: listen on localhost, and to open "
                 f"it they forward the port (ssh -L <port>:localhost:<port> {name}) and use "
                 f"http://localhost:<port>. ")
    return text + "Other sessions share this machine, so a port may be taken: pick a free one."


# The notifications of Claude Code that mean it's blocked on you. Others aren't
# a question: "idle_prompt" comes a minute after it finished, if you haven't
# answered, and would ring a session that's done a second time, as needing you.
NEEDS_YOU = ("permission_prompt", "elicitation_dialog", "elicitation_url_dialog", "agent_needs_input")


def hook_claude():
    """The Claude Code process a hook runs for (the nearest claude above it)
    and what Claude Code says about it in ~/.claude/sessions."""
    pid = os.getppid()
    for _ in range(6):
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            return {}
        if stat[stat.find("(") + 1:stat.rfind(")")] == "claude":
            try:
                return json.loads((HOME / f".claude/sessions/{pid}.json").read_text())
            except (OSError, ValueError):
                return {"pid": pid}
        pid = int(stat[stat.rfind(")") + 2:].split()[1])
    return {}


def cmd_hook(sid, state):
    # Claude Code passes the event as JSON on stdin.
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except Exception:
        event = {}
    s = session(sid)
    if not s:
        return
    kind = event.get("notification_type") if isinstance(event, dict) else None
    if state == "waiting" and kind and kind not in NEEDS_YOU:
        return
    if state == "start":
        # SessionStart: Claude is ready (idle), and learns where it is.
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                                 "additionalContext": agent_context(s)}}))
        state = "idle"
    # A background session forked from this one (/bg) carries its hooks, but
    # it isn't the session's own Claude: it says nothing about the session.
    if hook_claude().get("kind") == "bg":
        return
    set_conversation_id(sid, event.get("session_id", ""))
    clear_waking(sid)       # it's up
    if asleep_since(sid) is not None and state != "idle":
        clear_asleep(sid)   # it's running after all (woken some other way)
    prev = (STATUS / sid).read_text().strip() if (STATUS / sid).exists() else ""
    if state == prev == "idle":
        return      # Claude coming back from sleep: idle all along, since when it was
    (STATUS / sid).write_text(state)
    # Done: its row says so until you open it (see mark_seen); a phone or a
    # browser looking at it says it did, within a second. The app's server
    # notifies the phones (app_moments).
    if state == "idle" and prev == "working":
        mark_unseen(sid)


def unseen(sid):
    """Whether the session finished a turn you haven't looked at yet."""
    return (UNSEEN / sid).exists()


def mark_unseen(sid):
    write_file(UNSEEN / sid, "")


def mark_seen(sid):
    (UNSEEN / sid).unlink(missing_ok=True)


def cmd_seen(sid):
    if not session(sid):
        return fail(f"no session {sid!r}")
    mark_seen(sid)
    return 0


# ------------------------------------------------------------------ mission control

def task_title(pane_title):
    """What a session is about, from the title Claude Code gives its terminal
    (a short slug like "fix-login-redirect", after a status glyph)."""
    title = re.sub(r"^[^\w]+", "", pane_title or "").strip()
    if not title or title.startswith("amarchy:") or title == "Claude Code":
        return ""
    if " " not in title:
        title = title.replace("-", " ").replace("_", " ")
    return title[:1].upper() + title[1:]

# States, most urgent first, for the list grouped by status.
ORDER = {state: i for i, state in enumerate(("waiting", "working", "idle", "asleep"))}
# ...where one that finished and you haven't opened yet ("Done") comes
# before the idle ones you have.
STATUS_GROUPS = {state: i for i, state in enumerate(("waiting", "working", "done", "idle", "asleep"))}


def status_group(s):
    return "done" if s.get("unseen") and s["status"] == "idle" else s["status"]
# How much a session matters to you, most first (`amarchy priority`). New
# sessions are normal; the list always puts the higher ones first.
PRIORITIES = ("high", "normal", "low")
RANK = {p: i for i, p in enumerate(PRIORITIES)}
# How the list can be grouped: any of them, on its own or together, nested in
# whatever order you pick (`amarchy group priority project`).
GROUPS = ("project", "priority", "status")
# How it's sorted inside its groups (or all of it, ungrouped); priority is the default.
SORTS = ("priority", "newest", "oldest")


def list_groups():
    """How every list of sessions is grouped: by project, priority and/or
    status, outermost first, or none of them."""
    try:
        groups = []
        for g in GROUP_FILE.read_text().split():
            if g in GROUPS and g not in groups:
                groups.append(g)
        return groups
    except OSError:
        pass
    # `amarchy order activity`, from before there was more than one grouping.
    try:
        return ["status"] if ORDER_FILE.read_text().strip() == "activity" else []
    except OSError:
        return []


def priority(s):
    p = s.get("priority")
    return p if p in RANK else "normal"


def list_sort():
    """How the list is sorted inside its groups: by priority (higher first,
    then the order you opened them in), newest first or oldest first."""
    try:
        how = SORT_FILE.read_text().strip()
    except OSError:
        return "priority"
    return how if how in SORTS else "priority"


def session_order(s, groups=None, how=None, projects_in=None):
    """Grouped first (outermost first, in the order the groupings nest; the
    projects in yours, see project_order), then sorted inside each group: by
    priority, higher first, or by when it was opened. Ties keep the order you
    opened them in, so each one keeps its place."""
    groups = list_groups() if groups is None else groups
    how = list_sort() if how is None else how
    projects_in = project_rank(project_order()) if projects_in is None else projects_in
    rank = RANK[priority(s)]
    created = s.get("created", 0)
    by = {"project": projects_in(s["repo"]), "priority": rank,
          "status": STATUS_GROUPS.get(status_group(s), len(STATUS_GROUPS))}
    # Your assistant's section first, above the groups: it, then the other
    # sessions of its project.
    return ({"main": 0, "near": 1}.get(s.get("assistant"), 2), *(by[g] for g in groups),
            rank if how == "priority" else 0,
            -created if how == "newest" else created, s["id"])


def set_groups(groups):
    STATE.mkdir(parents=True, exist_ok=True)
    GROUP_FILE.write_text(" ".join(groups) + "\n")
    ORDER_FILE.unlink(missing_ok=True)


def cmd_group(args):
    """Group the list by project, priority and/or status: `group project`
    switches one, `group project on|off` sets it, `group none` drops them all,
    `group priority project` sets them all, nested in that order. One turned
    on goes inside the ones already on; one already on keeps its place.
    Prints what the list is grouped by now, outermost first."""
    groups = list_groups()
    usage = "usage: amarchy group [project|priority|status [on|off] | <grouping> <grouping>... | none]"
    if args == ["none"]:
        groups = []
    elif len(args) > 1 and all(a in GROUPS for a in args):
        if len(set(args)) < len(args):
            return fail(usage)
        groups = list(args)
    elif args:
        what, *how = args
        if what not in GROUPS or len(how) > 1 or how and how[0] not in ("on", "off"):
            return fail(usage)
        on = how[0] == "on" if how else what not in groups
        if not on:
            groups = [g for g in groups if g != what]
        elif what not in groups:
            groups = groups + [what]
    if args:
        set_groups(groups)
    print(" ".join(groups) or "none")
    return 0


def set_list(data):
    """Group and sort the list as {"group": [...], "sort": ..., "projects":
    [...]} says (from the app); without "projects" (a page from before
    there was an order), their order stays as it is. What's
    already so is left alone, so it keeps its time. None, or what's wrong with it."""
    groups, how = data.get("group") if isinstance(data, dict) else None, (data or {}).get("sort")
    if not isinstance(groups, list) or not all(g in GROUPS for g in groups) or len(set(groups)) < len(groups):
        return "group: project, priority and/or status, each once"
    if how not in SORTS:
        return "sort: priority, newest or oldest"
    if "projects" in data:
        # Theirs, all of it: one it hasn't placed isn't placed here either.
        why = set_project_order(data["projects"], rest=False)
        if why:
            return why
    if groups != list_groups():
        set_groups(groups)
    if how != list_sort():
        STATE.mkdir(parents=True, exist_ok=True)
        SORT_FILE.write_text(how + "\n")
    return None


def cmd_sort(args):
    """`amarchy sort priority|newest|oldest`: how the list is sorted inside its
    groups. Prints how it's sorted now."""
    if len(args) > 1 or args and args[0] not in SORTS:
        return fail("usage: amarchy sort [priority|newest|oldest]")
    if args:
        STATE.mkdir(parents=True, exist_ok=True)
        SORT_FILE.write_text(args[0] + "\n")
    print(list_sort())
    return 0


def cmd_order(args):
    """`amarchy order opened|activity`, from before `amarchy group`: activity
    is grouped by status. Grouping by project is left as it is."""
    groups = list_groups()
    order = args[0] if args else ("opened" if "status" in groups else "activity")
    if order not in ("opened", "activity"):
        return fail(f"unknown order {order!r} (opened or activity)")
    return cmd_group(["status", "on" if order == "activity" else "off"])


def cmd_priority(args):
    """`amarchy priority high|normal|low|up|down [--id <id>]`: how much a
    session matters, for the order of the list. Without a level, prints it."""
    sid = None
    if "--id" in args:
        i = args.index("--id")
        if i + 1 >= len(args):
            return fail("usage: amarchy priority [high|normal|low|up|down] [--id <id>]")
        sid = args[i + 1]
        args = args[:i] + args[i + 2:]
    sid = sid or own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one with --id <id>)")
    now = priority(s)
    if not args:
        print(now)
        return 0
    level = args[0]
    if level in ("up", "down"):
        level = PRIORITIES[max(0, min(len(PRIORITIES) - 1, RANK[now] + (-1 if level == "up" else 1)))]
    if len(args) > 1 or level not in RANK:
        return fail("usage: amarchy priority [high|normal|low|up|down] [--id <id>]")
    if level == "normal":
        s.pop("priority", None)
    else:
        s["priority"] = level
    save_session(s)
    print(level)
    return 0


def age(sid):
    """How long a session has been in its current state, e.g. "3m"."""
    try:
        return since_age((STATUS / sid).stat().st_mtime)
    except OSError:
        return ""


def since_age(since):
    secs = time.time() - since
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return "now"


TITLES = STATE / "titles.json"  # what saved_title() read last, so it only reads what's new


def saved_title(s):
    """The title Claude Code gave the session's conversation (for sessions
    whose Claude isn't running): the one it's in, else the latest in its
    folder. Conversations only grow, so only what's new since last time is read."""
    f = transcript(s)
    if not f:
        logs = sorted(projects_dir(s["path"]).glob("*.jsonl"), key=lambda x: x.stat().st_mtime, reverse=True)
        f = logs[0] if logs else None
    if not f:
        return ""
    try:
        cache = json.loads(TITLES.read_text())
    except (OSError, ValueError):
        cache = {}
    try:
        size = f.stat().st_size
    except OSError:
        return ""
    seen, title = cache.get(str(f), [0, ""])
    if seen == size:
        return task_title(title)
    try:
        with open(f, "rb") as fh:
            fh.seek(seen if seen < size else 0)
            for row in fh:
                if b'"ai-title"' in row or b'"custom-title"' in row:
                    try:
                        d = json.loads(row)
                    except ValueError:
                        continue
                    title = d.get("customTitle") or d.get("aiTitle") or title
            size = fh.tell()
    except OSError:
        return task_title(title)
    cache[str(f)] = [size, title]
    # Only the conversations of sessions still around.
    keep = {str(projects_dir(x["path"])) for x in sessions()}
    try:
        write_file(TITLES, json.dumps({k: v for k, v in cache.items() if str(Path(k).parent) in keep}))
    except OSError:
        pass
    return task_title(title)


def session_task(s, pane_title):
    """What a session is about: your own name for it (amarchy rename), else
    Claude's, from its tmux pane or its latest conversation, cut down to
    "Keyword: a few words" (short_title) once that's ready."""
    if s.get("setup"):
        return s.get("title") or "Setting up the worktree"
    if s.get("title"):
        return s["title"]
    title = claude_title(s, pane_title)
    return short_title(s["repo"], title) or title


def claude_title(s, pane_title):
    """The title Claude Code gave the session, whole: from its pane, else its latest conversation."""
    return task_title(pane_title) or saved_title(s)


SHORT_NAMES = os.environ.get("AMARCHY_SHORT_NAMES", "on").lower() not in ("0", "off", "no", "false")
SHORT = STATE / "short.json"         # Claude's title (with its project) → the short name for it
SHORTENING = STATE / "shortening"    # one file per title being cut down right now
SHORT_RETRY = 600                    # how long a title that couldn't be cut down waits to try again
SHORT_PROMPT = """Name a coding session for a narrow sidebar list, so it can be told apart from the others at a glance.

Format: Keyword: a few words
- Keyword: one word, two at most: the thing being worked on, the word you'd look for in the list. Capitalized.
- After the colon: one to three lowercase words on what about it. Only what the title says; don't invent.
- 26 characters at most in all. In English, whatever the title's language.
- Leave out the project's name ({repo}) and filler like session, setup, analysis, implementation.
- Reply with the name only: no quotes, no period, nothing else.

Examples:
Fix login redirect loop after OAuth callback -> Login: redirect loop
Add dark mode toggle to settings page -> Dark mode: toggle
Investigate flaky CI tests in payments module -> CI: flaky payment tests
Configurar notificaciones push en Android -> Push: Android

Session title: {title}"""


def short_key(repo, title):
    return f"{repo}\t{title}"


def short_title(repo, title):
    """Claude's title for a session cut down to "Keyword: a few words", the
    keyword first so a list of them reads at a glance. Claude Code's titles
    are a sentence each; Haiku cuts each one down once, in the background
    (amarchy shorten), and until then (or without claude) there's none."""
    if not SHORT_NAMES or not title:
        return ""
    try:
        short = json.loads(SHORT.read_text()).get(short_key(repo, title))
    except (OSError, ValueError):
        short = None
    if short is not None:
        return short
    marker = SHORTENING / hashlib.sha1(short_key(repo, title).encode()).hexdigest()
    try:
        if time.time() - marker.stat().st_mtime < SHORT_RETRY:
            return ""     # on its way, or it failed a moment ago
    except OSError:
        pass
    if shutil.which("claude"):
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.touch()
        detach([ENTRY, "shorten", repo, title])
    return ""


def shorten(repo, title):
    """Ask Haiku for the short name of a title: one line, Keyword: words, short
    enough for the list. None if it couldn't give one."""
    for _ in range(2):
        try:
            r = subprocess.run(
                ["claude", "-p", "--model", "haiku", "--no-session-persistence", "--setting-sources", "",
                 "--tools", "", "--strict-mcp-config", SHORT_PROMPT.format(repo=repo, title=title)],
                capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL,
                env=clean_env(), cwd=STATE)
        except (OSError, subprocess.TimeoutExpired):
            return None
        lines = [l.strip() for l in r.stdout.strip().splitlines() if l.strip()]
        name = lines[0].strip("\"'`*. ") if len(lines) == 1 else ""
        m = re.fullmatch(r"([^:]{1,20}):\s*([^:]{1,26})", name)
        if r.returncode == 0 and m and len(name) <= 34:
            return f"{m.group(1).strip()}: {m.group(2).strip()}"
    return None


def cmd_shorten(repo, title):
    """amarchy shorten <repo> <title>: cut a Claude title down (short_title
    starts it), keep it, and redraw the list with it."""
    key = short_key(repo, title)
    marker = SHORTENING / hashlib.sha1(key.encode()).hexdigest()
    name = shorten(repo, title)
    if not name:
        return 1          # the marker stays, so it's tried again in a while
    with open(STATE / "short.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cache = json.loads(SHORT.read_text())
        except (OSError, ValueError):
            cache = {}
        cache[key] = name
        # Only the titles of sessions still around, and the one just made.
        titles = host_titles()
        keep = {short_key(s["repo"], claude_title(s, titles.get(s["id"], ""))) for s in sessions()}
        write_file(SHORT, json.dumps({k: v for k, v in cache.items() if k in keep or k == key}))
    marker.unlink(missing_ok=True)
    return 0


def claude_agents():
    """The name each running Claude Code goes by for ListAgents and SendMessage
    (what other Claude sessions message it as), by its folder. Claude Code keeps
    one ~/.claude/sessions/<pid>.json per running instance; an interactive one
    wins over a background job in the same folder, unless it has handed its
    conversation over to that job (parked: ListAgents then shows only the job)."""
    agents = {}
    for f in (HOME / ".claude/sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
            os.kill(int(d["pid"]), 0)
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if not d.get("name") or not d.get("cwd") or d.get("parkedJobId"):
            continue
        rank = (d.get("kind") == "interactive", d.get("startedAt") or 0)
        if d["cwd"] not in agents or rank > agents[d["cwd"]][0]:
            agents[d["cwd"]] = (rank, d["name"])
    return {cwd: name for cwd, (_, name) in agents.items()}


def session_view():
    """Sessions as every list shows them (the app's, amarchy list): in list
    order, with what each one is about and how long it has been in its state."""
    resume_closing()
    titles = host_titles()
    agents = claude_agents()
    ss = sessions()
    background = all_background_sessions()
    # Your assistant's picture ("" for amarchy's own): its hash, for the
    # phone's and the browser's lists.
    sig = picture_sig(PICTURE)
    for s in ss:
        # Sleeping (its Claude stopped until you type in it) looks just as it
        # did, idle. So does a session whose tmux is gone (after a reboot):
        # it starts again asleep, and looks the same.
        s["awake"] = s["id"] in titles
        s["sleeping"] = asleep_since(s["id"]) is not None or not s["awake"]
        # Woken, and its Claude isn't up yet.
        s["waking"] = not s["sleeping"] and waking_now(s["id"])
        s["agent"] = agents.get(s["path"], "") if not s["sleeping"] else ""
        s.pop("prompt", None)
        if s["sleeping"] and not s.get("setup"):
            s["status"] = "idle"    # only an idle session sleeps (or one left from before)
        s["task"] = session_task(s, titles.get(s["id"], ""))
        # Claude's whole title, so a search finds a session by any word of it.
        s["claude_title"] = "" if s.get("setup") else claude_title(s, titles.get(s["id"], ""))
        s["age"] = age(s["id"]) if s["awake"] else ""
        # Claude Code background sessions (/bg) still running in its worktree.
        s["background"] = len(background_sessions(s, background))
        s["priority"] = priority(s)
        # Done, and you haven't opened it since.
        s["unseen"] = s["status"] == "idle" and not s.get("setup") and unseen(s["id"])
    mine = assistant()
    for s in ss:
        s["assistant"] = assistant_role(s, mine)
        s["assistant_name"] = mine["name"] if s["assistant"] else ""
        s["picture"] = sig if s["assistant"] else ""
        if s["assistant"]:
            # What it last wrote: its notifications' body, and the list's
            # preview while you haven't read it.
            s["said"] = last_said(s)
    groups, how, projects_in = list_groups(), list_sort(), project_rank(project_order())
    ss.sort(key=lambda s: session_order(s, groups, how, projects_in))
    return ss


# ------------------------------------------------------------------ your assistant
#
# One session can be your assistant (`amarchy assistant <id>`): a Claude that
# keeps your day rather than writing code. Every list (the phone's, the
# browser's) shows it at the top, above the groups,
# bigger and with its picture (app/assistant.svg); the other sessions of its
# project sit under it there. What it says reaches you apart from the coding
# sessions: under its name and picture, with a chime of its own, always,
# whatever `amarchy alerts` lets through of the others.

ASSISTANT_FILE = STATE / "assistant"        # {"id": its session, "name": what it's called}
ALERTS_FILE = STATE / "alerts"
# What the other sessions tell you about (your assistant always does): all =
# when they need you and when they're done; needs-you = only when one asks you
# something (a question, a permission), a finished one just marked done in the
# list; assistant = nothing but your assistant.
ALERTS = ("all", "needs-you", "assistant")
ALERTS_DEFAULT = "needs-you"


def assistant():
    """Your assistant here: {"id", "name"}, or None. Its name is what you
    called it, else its project's ("Jaken" for jaken)."""
    try:
        d = json.loads(ASSISTANT_FILE.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(d, dict) or not isinstance(d.get("id"), str):
        return None
    try:
        s = json.loads((SESSIONS / f"{d['id']}.json").read_text())
    except (OSError, ValueError):
        return None     # closed
    name = d.get("name") if isinstance(d.get("name"), str) else ""
    return {"id": d["id"], "name": name.strip() or s.get("repo", "").capitalize() or "Assistant",
            "repo": s.get("repo", "")}


def assistant_role(s, mine=None):
    """"main" for your assistant, "near" for another session of its project,
    "" for the rest (mine: assistant(), if it was read already)."""
    mine = assistant() if mine is None else mine
    if not mine:
        return ""
    return "main" if s["id"] == mine["id"] else "near" if s.get("repo") == mine["repo"] else ""


# Its picture: amarchy's own (app/assistant.svg) unless you gave it one of
# yours (`amarchy assistant --picture <file>`), cut square and round and kept
# in ~/.config/amarchy (assistant.png, and assistant-192.png for the phones'
# notifications). The lists and the notifications name it by its hash, so a
# new one shows everywhere at once (no cache keeps the old one).
PICTURE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy/assistant.png"
PICTURE_SMALL = PICTURE.with_name("assistant-192.png")
PICTURE_SIZES = (512, 192)
_picture_sigs = {}


def picture_sig(f):
    """The hash a picture goes by (12 hex digits), or "" without one."""
    try:
        st = f.stat()
        key = (str(f), st.st_mtime_ns, st.st_size)
        if key not in _picture_sigs:
            _picture_sigs[key] = hashlib.sha1(f.read_bytes()).hexdigest()[:12]
    except OSError:
        return ""
    return _picture_sigs[key]


def assistant_icon():
    """The picture by your assistant's notifications on the phones (a path
    of the app's)."""
    sig = picture_sig(PICTURE)
    return f"/picture/{sig}-192.png" if sig and PICTURE_SMALL.is_file() else "/assistant-192.png"


def picture_cut(raw, crop=None):
    """A picture cut for your assistant's: a square of it (crop: its x, y and
    size in the picture's pixels, else the middle of it as big as it goes),
    round, at each of PICTURE_SIZES, as PNGs. Raises ValueError saying why
    not. With ffmpeg, else ImageMagick."""
    if not image_kind(raw):
        raise ValueError("that isn't a picture amarchy takes (a PNG, JPEG or WebP)")
    ffmpeg, magick = shutil.which("ffmpeg"), shutil.which("magick")
    if not ffmpeg and not magick:
        raise ValueError("cutting it to size takes ffmpeg or ImageMagick: install one (pacman -S ffmpeg)")
    out = {}
    with tempfile.TemporaryDirectory() as tmp:
        src = Path(tmp) / "picture"
        src.write_bytes(raw)
        if crop:
            # Neither cuts outside the picture: they'd quietly cut less.
            r = sh(shutil.which("ffprobe") or "ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                   "stream=width,height", "-of", "csv=p=0:s=x", str(src)) if ffmpeg else \
                sh(magick, "identify", "-format", "%wx%h", f"{src}[0]")
            m = re.fullmatch(r"(\d+)x(\d+)", r.stdout.strip())
            if not m:
                raise ValueError(gist(r.stderr) or "its size couldn't be read")
            w, h = int(m[1]), int(m[2])
            if crop[0] + crop[2] > w or crop[1] + crop[2] > h:
                raise ValueError(f"--crop {crop[0]},{crop[1]},{crop[2]} goes past the picture's edge "
                                 f"(it's {w}×{h}: x + size at most {w}, y + size at most {h})")
        for n in PICTURE_SIZES:
            dst = Path(tmp) / f"{n}.png"
            if ffmpeg:
                square = "crop=%d:%d:%d:%d" % (crop[2], crop[2], crop[0], crop[1]) if crop \
                    else "crop='min(iw,ih)':'min(iw,ih)'"
                # Round: what's outside the circle see-through, its edge smoothed over a pixel.
                c = n / 2
                ring = f"255*clip({c}-hypot(X+0.5-{c},Y+0.5-{c})+0.5,0,1)"
                r = sh(ffmpeg, "-v", "error", "-y", "-i", str(src), "-frames:v", "1", "-vf",
                       f"{square},scale={n}:{n}:flags=lanczos,format=rgba,"
                       f"geq=r='r(X,Y)':g='g(X,Y)':b='b(X,Y)':a='{ring}'", str(dst))
            else:
                square = ["-crop", "%dx%d+%d+%d" % (crop[2], crop[2], crop[0], crop[1]), "+repage",
                          "-resize", f"{n}x{n}"] if crop else \
                    ["-resize", f"{n}x{n}^", "-gravity", "center", "-extent", f"{n}x{n}"]
                r = sh(magick, f"{src}[0]", *square, "-alpha", "set",
                       "(", "-size", f"{n}x{n}", "xc:black", "-fill", "white",
                       "-draw", f"circle {n / 2},{n / 2} {n / 2},0", ")",
                       "-compose", "CopyOpacity", "-composite", "-strip", f"PNG32:{dst}")
            try:
                out[n] = dst.read_bytes() if r.returncode == 0 else b""
            except OSError:
                out[n] = b""
            if image_kind(out[n]) != "png":
                raise ValueError(gist(r.stderr) or "it couldn't be cut to size")
    return out


def picture_crop(value):
    """--crop x,y,size: three whole numbers, the size above 0. None if not."""
    m = re.fullmatch(r"\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*", value or "")
    return (int(m[1]), int(m[2]), int(m[3])) if m and int(m[3]) > 0 else None


def set_picture(source, crop=None):
    """Your assistant's picture from source (a file, - for stdin: the
    picture or it in base64), or amarchy's own again ("off")."""
    if source == "off":
        for f in (PICTURE, PICTURE_SMALL):
            f.unlink(missing_ok=True)
        print("amarchy's own")
        return 0
    try:
        raw = sys.stdin.buffer.read(APP_WALLPAPER_MAX * 4) if source == "-" else Path(source).expanduser().read_bytes()
    except OSError as e:
        return fail(f"can't read {source}: {e.strerror or e}")
    if source == "-" and not image_kind(raw):
        try:
            raw = base64.b64decode(raw.strip(), validate=True)
        except ValueError:
            pass
    try:
        cut = picture_cut(raw, crop)
    except ValueError as e:
        return fail(str(e))
    write_file(PICTURE_SMALL, cut[192])
    write_file(PICTURE, cut[512])       # last: its hash names both
    print(PICTURE)
    return 0


def cmd_assistant(args):
    """amarchy assistant [<id>] [--name <name>] | off | --picture <file>|off
    [--crop x,y,size]: which session is your assistant (prints it as
    id<TAB>name, or none), and its picture."""
    name, picture, crop, rest = None, None, None, []
    it = iter(args)
    for a in it:
        if a == "--name":
            name = next(it, None)
            if name is None or not name.strip() or len(name) > 40:
                return fail("--name takes what to call it (40 characters at most)")
            name = name.strip()
        elif a == "--picture":
            picture = next(it, None)
            if not picture:
                return fail("--picture takes a picture (a PNG, JPEG or WebP), or off for amarchy's own")
        elif a == "--crop":
            crop = picture_crop(next(it, None))
            if not crop:
                return fail("--crop takes x,y,size: the square of the picture to show, in its pixels")
        else:
            rest.append(a)
    if picture is not None or crop:
        if picture is None or rest or name is not None or (crop and picture == "off"):
            print(usage("assistant"), file=sys.stderr)
            return 1
        return set_picture(picture, crop)
    current = next((s for s in session_view() if s.get("assistant") == "main"), None)
    if not rest and name is None:
        print(f"{current['id']}\t{current['assistant_name']}" if current else "none")
        return 0
    if rest == ["off"] and name is None:
        ASSISTANT_FILE.unlink(missing_ok=True)
        print("none")
        return 0
    if len(rest) > 1:
        print(usage("assistant"), file=sys.stderr)
        return 1
    sid = rest[0] if rest else (current or {}).get("id")
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "no assistant yet: name its session (amarchy assistant <id>)")
    mine = assistant()
    if name is None and mine and mine["id"] == sid:
        try:
            name = json.loads(ASSISTANT_FILE.read_text()).get("name") or ""
        except (OSError, ValueError, AttributeError):
            name = ""
    write_file(ASSISTANT_FILE, json.dumps({"id": sid, "name": name or ""}))
    print(f"{sid}\t{assistant()['name']}")
    return 0


def alerts():
    """What the other sessions tell you about on your phones (see ALERTS)."""
    try:
        value = ALERTS_FILE.read_text().strip()
    except OSError:
        value = ""
    return value if value in ALERTS else ALERTS_DEFAULT


def cmd_alerts(args):
    """amarchy alerts [all|needs-you|assistant]: prints it, or sets it."""
    if len(args) > 1 or args and args[0] not in ALERTS:
        print(usage("alerts"), file=sys.stderr)
        return 1
    if args:
        write_file(ALERTS_FILE, args[0] + "\n")
    print(alerts())
    return 0


def alert_kind(s, state, prev):
    """Whether a session that went on to need you (waiting) or finished (idle
    after working) tells you so: "assistant" for your assistant, which always
    does, "session" for another one when amarchy alerts lets it, else None."""
    if not (state == "waiting" or (state == "idle" and prev == "working")):
        return None
    if assistant_role(s) == "main":
        return "assistant"
    level = alerts()
    return "session" if level == "all" or (level == "needs-you" and state == "waiting") else None


_said = {}


def last_said(s, limit=240):
    """The last thing the session's Claude wrote, in a line (a brief's first
    words, for its notification), or "". Read again only when its
    conversation has moved."""
    f = transcript(s)
    if not f:
        return ""
    try:
        stamp = f.stat().st_mtime_ns
    except OSError:
        return ""
    if _said.get(str(f), (None,))[0] == stamp:
        return _said[str(f)][1]
    said = ""
    for r in reversed(conversation_records(f, tail=400_000)):
        message = r.get("message") if isinstance(r, dict) and r.get("type") == "assistant" else None
        content = message.get("content") if isinstance(message, dict) else None
        text = " ".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text") \
            if isinstance(content, list) else content if isinstance(content, str) else ""
        text = " ".join(re.sub(r"[*_`#>]+", "", text).split())
        if text:
            said = text if len(text) <= limit else text[:limit - 1].rstrip() + "…"
            break
    _said[str(f)] = (stamp, said)
    return said


# ------------------------------------------------------------------ update

def self_update():
    """Bring amarchy here up to origin's main (`amarchy update`, which a
    timer runs every few minutes). Only when amarchy runs from a checkout of
    main with nothing uncommitted (not a session's worktree, not work in
    progress): pull it and run its install.sh, as you would. Says what it
    did, or why it didn't; "not updated: ..." when it couldn't."""
    repo = Path(SELF).parent.parent
    env = {**clean_env(), "GIT_TERMINAL_PROMPT": "0"}

    def git(*args):
        return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, env=env,
                              stdin=subprocess.DEVNULL, timeout=120)
    head = git("rev-parse", "HEAD").stdout.strip()
    if git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip() != "main":
        return f"not updated: {repo} isn't on main"
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        return f"not updated: {repo} has uncommitted changes"
    if git("fetch", "--quiet", "origin", "main").returncode:
        return "not updated: couldn't fetch origin"
    if head == git("rev-parse", "origin/main").stdout.strip():
        return "up to date"
    if git("merge-base", "--is-ancestor", "HEAD", "origin/main").returncode:
        return "not updated: main here has commits origin doesn't"
    before = git("rev-parse", "--short", "HEAD").stdout.strip()
    if git("merge", "--ff-only", "--quiet", "origin/main").returncode:
        return "not updated: couldn't fast-forward main"
    r = subprocess.run([str(repo / "install.sh")], capture_output=True,
                       text=True, env=env, stdin=subprocess.DEVNULL, timeout=300)
    if r.returncode:
        return f"not updated: main is at origin's, but install.sh failed: {(r.stderr or r.stdout).strip().splitlines()[-1:]}"
    after = git("rev-parse", "--short", "HEAD").stdout.strip()
    return f"updated {before} → {after}"


def cmd_update(args):
    """`amarchy update`: to the latest amarchy on GitHub (origin's main).
    --auto: as the timer install.sh sets up runs it, every few minutes: one at a time, quiet when there's nothing new, and not at all
    with AUTO_UPDATE=off in ~/.config/amarchy/host."""
    auto = "--auto" in args
    if auto and (host_setting("AUTO_UPDATE") or "").lower() in ("off", "no", "0", "false"):
        return 0
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "update.lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0 if auto else fail("already updating")
        said = self_update()
    if not (auto and said == "up to date"):
        print(f"amarchy: {said}", file=sys.stderr if said.startswith("not updated") else sys.stdout)
    return 1 if said.startswith("not updated") else 0


# ------------------------------------------------------------------ clipboard
#
# Pasting an image into a session's Claude (Ctrl+V): Claude Code reads the
# clipboard by running wl-paste (or xclip) where it runs, and a server has no
# clipboard. So a session's Claude finds amarchy's own wl-paste first on its
# PATH (bin/amarchy-paste, as `amarchy paste`; see paste_path), and install.sh
# links it into ~/.local/bin too (for the terminal, and a Claude already
# running) when the machine has no wl-paste of its own.
#
# The clipboard it reads is the app's: what you last pasted into a session
# from a browser or the phone (an image, or text), or copied in one of its
# terminals there, which the app keeps in <state>/clipboard/web.clip (the web
# clipboard, yours only) until something else replaces it. Only reading: the
# options that list or print what's copied, nothing else (wl-paste --watch
# runs a command).

CLIP_DIR = STATE / "clipboard"          # the web clipboard (web.clip), yours only
PASTE_BIN = STATE / "paste"             # wl-paste and rec for a session's Claude (links to bin/amarchy-paste, -rec)
WEB_CLIP = CLIP_DIR / "web.clip"        # what a browser or phone last handed the app (see web_clip)
PASTE_FLAGS = {"-l": "--list-types", "--list-types": "--list-types", "-n": "--no-newline",
               "--no-newline": "--no-newline", "-p": "--primary", "--primary": "--primary"}
MIME = re.compile(r"(?!-)[\w.+-]+(/[\w.+-]+)?(; ?[\w.+-]+=[\w.+-]+)*")


def paste_args(args):
    """wl-paste's options as amarchy passes them on (its long ones), or None
    for one it doesn't (anything but listing or printing what's copied)."""
    out, it = [], iter(args)
    for a in it:
        if a in PASTE_FLAGS:
            out.append(PASTE_FLAGS[a])
        elif a in ("-t", "--type") or a.startswith("--type="):
            value = a.partition("=")[2] if "=" in a else next(it, "")
            if not (len(value) <= 120 and MIME.fullmatch(value)):
                return None
            out += ["--type", value]
        elif re.fullmatch(r"-[lnp]{2,3}", a):
            out += [PASTE_FLAGS[f"-{c}"] for c in a[1:]]
        else:
            return None
    return out


def web_clip_save(items):
    """The web clipboard is now these [(type, bytes)], the first the one a
    plain wl-paste prints: a JSON line of their types and sizes, then each."""
    head = {"time": time.time(), "types": [[kind, len(data)] for kind, data in items]}
    CLIP_DIR.mkdir(parents=True, exist_ok=True)
    CLIP_DIR.chmod(0o700)
    tmp = WEB_CLIP.with_name(f".{WEB_CLIP.name}.{os.getpid()}.{threading.get_ident()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(json.dumps(head).encode() + b"\n")
        for _, data in items:
            f.write(data)
    os.replace(tmp, WEB_CLIP)


def web_clip():
    """What the web clipboard holds: [(type, bytes)], or [] when nothing."""
    try:
        with open(WEB_CLIP, "rb") as f:
            head = json.loads(f.readline())
            items = [(str(kind), f.read(int(n))) for kind, n in head["types"]]
    except (OSError, ValueError, KeyError, TypeError):
        return []
    return [(kind, data) for kind, data in items if MIME.fullmatch(kind)]


def web_clip_answer(args):
    """wl-paste's answer from the web clipboard, for its options as
    paste_args gives them: (exit code, error, what it prints)."""
    items = web_clip()
    if not items or "--primary" in args:
        return 1, "Nothing is copied", b""
    if "--list-types" in args:
        kinds = [kind for kind, _ in items]
        if any(k.startswith("text/plain") for k in kinds):
            kinds += [k for k in ("TEXT", "STRING", "UTF8_STRING") if k not in kinds]
        return 0, "", "".join(f"{k}\n" for k in kinds).encode()
    want = (args[args.index("--type") + 1] if "--type" in args else items[0][0]).split(";")[0].strip().lower()
    text = want in ("text", "string", "utf8_string") or want.startswith("text/")
    item = next((d for k, d in items if k.split(";")[0].lower() == want), None)
    if item is None:
        item = next((d for k, d in items if (want in ("image", "image/*") and k.startswith("image/"))
                     or (text and k.startswith("text/plain"))), None)
    if item is None:
        return 1, "No suitable type of content copied", b""
    # wl-paste ends text with a newline unless told not to; images as they are.
    textual = text or (want == items[0][0].split(";")[0].lower() and want.startswith("text/"))
    if textual and "--no-newline" not in args and not item.endswith(b"\n"):
        item += b"\n"
    return 0, "", item


def cmd_paste(args):
    """wl-paste for a session's Claude: what you last pasted (or copied) in
    the app, on the phone or in a browser (see "clipboard")."""
    passed = paste_args(args)
    if passed is None:
        print(f"wl-paste (amarchy): only -l, -t <type>, -n and -p, not {' '.join(args)}", file=sys.stderr)
        return 2
    code, err, data = web_clip_answer(passed)
    if code == 0:
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
    elif err:
        print(err, file=sys.stderr)
    return code


def paste_path():
    """The PATH a session's Claude gets: amarchy's wl-paste first
    (see "clipboard"), and its rec (see "dictation from the phone").
    Unchanged when the links can't be made."""
    path = os.environ.get("PATH", "")
    for name, target in (("wl-paste", "amarchy-paste"), ("rec", "amarchy-rec")):
        link, target = PASTE_BIN / name, Path(SELF).parent / target
        try:
            if not link.is_symlink() or os.readlink(link) != str(target):
                PASTE_BIN.mkdir(parents=True, exist_ok=True)
                tmp = link.with_name(f".{name}.{os.getpid()}")
                tmp.unlink(missing_ok=True)
                tmp.symlink_to(target)
                os.replace(tmp, link)
        except OSError:
            return path
    return os.pathsep.join([str(PASTE_BIN), *[d for d in path.split(os.pathsep) if d and d != str(PASTE_BIN)]])


# ------------------------------------------------------------------ tmux
#
# A session's Claude runs in tmux session <id> and its terminal in <id>~term,
# on a tmux server of amarchy's own (tmux -L amarchy), so your own tmux is
# left alone. The app's terminals in a browser are clients of them (amarchy
# attach), as is a terminal you ssh in from. Its settings make tmux
# disappear: no status bar, no prefix key, your terminal's keys, colors,
# titles and clipboard passed through, and the mouse scrolls back through
# what Claude printed.

TMUX_CONF = """# Written by amarchy: the tmux that keeps its sessions.
set -g prefix None
unbind C-b
set -g status off
set -g escape-time 0
set -g history-limit 100000
set -g mouse on
set -g default-terminal tmux-256color
set -s terminal-features[90] '*:RGB:clipboard:extkeys:hyperlinks:usstyle:strikethrough:overline'
set -g extended-keys always
set -g extended-keys-format csi-u
set -g set-clipboard on
set -g allow-passthrough on
set -g focus-events on
set -g set-titles on
set -g set-titles-string '#{pane_title}'
set -g window-size latest
set -g aggressive-resize on
set -g destroy-unattached off
"""

# A session's Claude in tmux: Claude; while the session sleeps, its last
# screen and a wait for the first key (see "sleep"); and when
# you quit Claude, a key to start it again.
HOST_LOOP = ('while :; do "$0" claude "$1"; if "$0" asleep "$1"; then '
             '"$0" woke "$1" "$(stty -icanon -echo -isig -ixon -icrnl min 1 time 0; dd bs=1 count=1 2>/dev/null | od -An -tx1)"; '
             'else "$0" held "$1" || exit; fi; done')


def host_loop(sid):
    """HOST_LOOP for a session, with your login shell's PATH and tools, in sh:
    bash proper would print "Killed" over Claude's last screen as it sleeps."""
    return login_shell('exec sh -c "$0" "$@"', HOST_LOOP, ENTRY, sid)


HOST_CONFIG = HOME / ".config/amarchy/host"     # NAME= and BIND= lines, for the network below


def host_setting(key):
    """AMARCHY_HOST_<key>, from the environment or ~/.config/amarchy/host."""
    value = os.environ.get(f"AMARCHY_HOST_{key}")
    if value is None:
        try:
            for line in HOST_CONFIG.read_text().splitlines():
                k, _, v = line.partition("=")
                if k.strip() == key:
                    value = v.strip()
        except OSError:
            pass
    return value or None


_network = None


def host_network():
    """How your devices reach what a session serves here: (name, address to
    listen on). Set in ~/.config/amarchy/host (NAME=, BIND=); else, on
    Tailscale, this machine's Tailscale name and address, so it's only
    reachable from your tailnet; else nothing but localhost (an ssh tunnel)."""
    global _network
    if _network:
        return _network
    name, bind = host_setting("NAME"), host_setting("BIND")
    if (not name or not bind) and shutil.which("tailscale"):
        try:
            me = json.loads(sh("tailscale", "status", "--json").stdout or "{}").get("Self") or {}
        except ValueError:
            me = {}
        ips = [ip for ip in me.get("TailscaleIPs") or [] if "." in ip]
        if ips and me.get("Online", True):
            name = name or (me.get("DNSName") or "").split(".")[0] or None
            bind = bind or ips[0]
    _network = (name or socket.gethostname(), bind)
    return _network


def host_name():
    return host_network()[0]


def login_shell(script, *args):
    """A sh script run by the user's login shell (when it speaks sh), so it
    has the PATH and tools they set up (mise, nvm, cargo), as their own
    terminal would."""
    shell = os.environ.get("SHELL") or ""
    if Path(shell).name in ("bash", "zsh", "sh", "dash", "ksh"):
        return [shell, "-lc", script, *args]
    return ["sh", "-c", script, *args]


def tmux(*args):
    conf = STATE / "tmux.conf"
    try:
        fresh = conf.read_text() != TMUX_CONF
    except OSError:
        fresh = True
    if fresh:
        write_file(conf, TMUX_CONF)
    run = lambda *a: subprocess.run(["tmux", "-u", "-L", "amarchy", "-f", str(conf), *a], capture_output=True,
                                    text=True, stdin=subprocess.DEVNULL, env=clean_env())
    try:
        if fresh:
            run("source-file", str(conf))     # a server already up takes the new settings
        # The server starts with the first session, in whatever started that:
        # in its own systemd scope instead, so it outlives it (a unit's
        # processes all end with it, amarchy send from a timer's say).
        if args[:1] == ("new-session",) and shutil.which("systemd-run"):
            down = run("list-sessions")
            if down.returncode != 0 and re.search(r"no server|error connecting", down.stderr):
                scoped = subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "--collect",
                                         f"--unit=amarchy-tmux-{os.getpid()}-{time.time_ns()}",
                                         "tmux", "-u", "-L", "amarchy", "-f", str(conf), *args],
                                        capture_output=True, text=True, stdin=subprocess.DEVNULL, env=clean_env())
                if scoped.returncode == 0 or run("list-sessions").returncode == 0:
                    return scoped
        return run(*args)
    except FileNotFoundError:
        return subprocess.CompletedProcess(args, 127, "", "tmux isn't installed")


def tmux_name(sid, which="claude"):
    """A session's tmux session name: its id, without what tmux reads in a
    target ("." splits off the pane, ":" the window)."""
    return re.sub(r"[.:]", "_", sid) + ("~term" if which == "term" else "")


def tmux_has(name):
    return tmux("has-session", "-t", f"={name}").returncode == 0


def tmux_env(s):
    return [x for k, v in session_env(s).items() for x in ("-e", f"{k}={v}")]


def host_start(s, wake=False):
    """Start whatever of a session's tmux isn't running: Claude (setting the
    worktree up first, for a new one) and, once the worktree is there, the
    terminal. After a reboot, attaching brings them back like this, Claude
    asleep (the conversation, and a key to wake it), so opening your sessions
    doesn't start a Claude in each; wake starts it right away instead."""
    sid, path = s["id"], Path(s["path"])
    claude, term = tmux_name(sid), tmux_name(sid, "term")
    if not tmux_has(claude):
        if not s.get("setup") and path.is_dir() and not wake:
            # Asleep from before, it has no screen of Claude's to keep now.
            if asleep_since(sid) is None or asleep_look(sid) == FROZEN:
                mark_asleep(sid)
        cwd = path if path.is_dir() else WORK / s["repo"]
        tmux("new-session", "-d", "-s", claude, "-x", "200", "-y", "50", "-c", str(cwd), *tmux_env(s),
             *host_loop(sid))
        tmux("select-pane", "-t", f"={claude}:", "-T", f"amarchy:{sid}")
    if not s.get("setup") and path.is_dir() and not tmux_has(term):
        tmux("new-session", "-d", "-s", term, "-x", "100", "-y", "50", "-c", str(path), *tmux_env(s))


def host_pane(s):
    """A session's Claude pane in tmux, as sleep handles it: {"pid": the
    pane's process} (the loop, HOST_LOOP), or None while it has none."""
    pid = tmux("display-message", "-p", "-t", f"={tmux_name(s['id'])}:", "#{pane_pid}").stdout.strip()
    return {"pid": int(pid)} if pid.isdigit() else None


def host_respawn(s):
    """Restart a session's Claude pane on HOST_LOOP: a pane from before
    sessions could sleep on a host, its Claude stopped, sleeps from then on."""
    tmux("respawn-pane", "-k", "-t", f"={tmux_name(s['id'])}:", "-c", s["path"], *tmux_env(s), *host_loop(s["id"]))


def host_stop(s):
    """End a session's tmux: Claude first, the way quitting it would."""
    sid = s["id"]
    pid = tmux("display-message", "-p", "-t", f"={tmux_name(sid)}:", "#{pane_pid}").stdout.strip()
    if pid.isdigit():
        stop_claude({"pid": int(pid)})
    for name in (tmux_name(sid), tmux_name(sid, "term")):
        tmux("kill-session", "-t", f"={name}")


def host_run(s, command):
    """Restart the session's terminal on command: it shows the command, runs
    it, and leaves you in a shell when it ends."""
    host_start(s)
    shell = os.environ.get("SHELL") or "bash"
    script = (f"printf '\\033[2m$ %s\\033[0m\\n' {shlex.quote(command)}; "
              f"{command}; exec {shlex.quote(shell)}")
    r = tmux("respawn-pane", "-k", "-t", f"={tmux_name(s['id'], 'term')}:", "-c", s["path"], *tmux_env(s),
             shell, "-ic", script)
    return 0 if r.returncode == 0 else fail(f"couldn't run it: {r.stderr.strip()}")


def host_titles():
    """The title Claude gave each session (its tmux pane's), by session id,
    for the sessions whose tmux is running."""
    panes = {}
    for line in tmux("list-panes", "-a", "-F", "#{session_name}\t#{pane_title}").stdout.splitlines():
        name, _, title = line.partition("\t")
        panes[name] = title
    return {s["id"]: panes[tmux_name(s["id"])] for s in sessions() if tmux_name(s["id"]) in panes}


def cmd_attach(args):
    """Show a session's Claude (or with term, its terminal) in this terminal
    (the app's terminals run this, or you over ssh), starting it if needed.
    Exits 3 when there's no such session."""
    sid, which = args[0], (args[1] if len(args) > 1 else "claude")
    s = session(sid)
    if not s or (CLOSING / f"{sid}.json").exists():
        try:
            why = f": {(STATE / 'failed' / sid).read_text().strip()}"
        except OSError:
            why = ""
        print(f"\r\n  {sid} {'could not start' if why else 'was closed'}{why}\r\n", flush=True)
        if why:
            time.sleep(5)
        return 3
    name = tmux_name(sid, which)
    end, said = time.time() + 600, False
    while True:
        host_start(s)
        if tmux_has(name):
            break
        if not s.get("setup") and not Path(s["path"]).is_dir():
            print(f"\r\n  {sid}'s worktree is gone ({s['path']}). Close the session.\r\n", flush=True)
            time.sleep(5)
            return 3
        if which == "term" and s.get("setup") and time.time() < end:
            if not said:
                print("\r\n  \033[2mWaiting for the worktree…\033[0m", flush=True)
                said = True
            time.sleep(0.5)
            s = session(sid)
            if not s:
                return 3
            continue
        return fail(f"couldn't start {name} in tmux")
    # On a pty of the app's server (a browser's terminal), make it tmux's
    # own terminal, so it hears when the browser resizes it.
    if os.isatty(0):
        try:
            fcntl.ioctl(0, termios.TIOCSCTTY, 0)
        except OSError:
            pass
    env = clean_env()
    # Your terminal's own TERM, if this machine knows it; else close enough.
    if not env.get("TERM") or sh("infocmp", env["TERM"]).returncode != 0:
        env["TERM"] = "xterm-256color"
    os.execvpe("tmux", ["tmux", "-u", "-L", "amarchy", "-f", str(STATE / "tmux.conf"),
                        "attach-session", "-t", f"={name}"], env)


def cmd_held(sid):
    """After the session's Claude has exited (quit, not asleep): start it again on
    Enter. Fails (ending its tmux) when the session is gone."""
    if not session(sid) or (CLOSING / f"{sid}.json").exists():
        return 1
    sh("stty", "sane")      # a Claude that was stopped (put to sleep) left the terminal raw: Enter is \r
    print("\n  \033[2mClaude Code exited. Press Enter to start it again.\033[0m", flush=True)
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        time.sleep(1)
    return 0 if session(sid) and not (CLOSING / f"{sid}.json").exists() else 1


# ------------------------------------------------------------------ the app
#
# `amarchy app`: your sessions on your phone, a web app (app/) you add to the
# home screen, and in a computer's browser (its wide layout, see "the app in
# a browser on your computer"). The list as amarchy shows it, each session's
# conversation from its transcript, what you type pasted into its Claude in
# tmux, its questions as buttons, and a notification when one needs you or is
# done (Web Push, with the chime amarchy sound picks in a browser).
#
# It's reachable from your tailnet only: the server listens on localhost, and
# `tailscale serve` puts it on https://<this machine>.<tailnet>.ts.net, where
# Tailscale says who's asking (the Tailscale-User-Login header). Only you (the
# machine's owner on Tailscale, or APP_USERS= in ~/.config/amarchy/host) get
# in, and only pages of its own can change anything (Origin), so a website
# open on your phone can't drive your sessions.
#
# Web Push needs a key pair (VAPID) and each notification encrypted for the
# phone (RFC 8291): openssl does the elliptic curve parts, Python the rest.

APP = STATE / "app"                         # its key (vapid.pem) and the phones it notifies (push.json)
APP_PAGES = Path(SELF).parent.parent / "app"
APP_UNIT = "amarchy-app.service"
APP_PORT = 7397                             # on localhost; APP_PORT= in ~/.config/amarchy/host
APP_HTTPS = 443                             # on the tailnet; APP_HTTPS= (443, 8443 or 10000)
# Who a push service should write to about this sender (Apple requires one).
APP_CONTACT = "https://github.com/ja-818/amarchy"
APP_TYPES = {".html": "text/html; charset=utf-8", ".css": "text/css; charset=utf-8",
             ".js": "text/javascript; charset=utf-8", ".webmanifest": "application/manifest+json",
             ".svg": "image/svg+xml", ".png": "image/png"}
APP_CSP = ("default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; "
           "connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; "
           "base-uri 'none'; form-action 'none'")
APP_CHUNK = 1_500_000           # bytes of a transcript read at a time (the latest first, earlier on request)
APP_KEYS = {"Enter", "Escape", "Up", "Down", "Left", "Right", "Tab", "BTab", "Space", "BSpace",
            *"0123456789"}
APP_SEEN = 15                   # seconds a session you're looking at on the phone counts as seen
APP_VIEWING = APP / "viewing.json"      # which sessions are open on a phone or in a browser (see on_screen)
KEEPALIVE = 15                  # seconds between a stream's "still here" when nothing changes
P256_SPKI = bytes.fromhex("3059301306072a8648ce3d020106082a8648ce3d030107034200")
UNITS = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "systemd/user"


def b64u(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def unb64u(text):
    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))


def openssl(*args, input=None):
    r = subprocess.run(["openssl", *args], input=input, capture_output=True)
    if r.returncode != 0:
        raise OSError(f"openssl {args[0]}: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def ec_new(path):
    """A new P-256 private key, readable by you only."""
    old = os.umask(0o077)
    try:
        openssl("ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", str(path))
    finally:
        os.umask(old)


def ec_public(path):
    """The public key of a private key file, as the 65 bytes of its point."""
    return openssl("ec", "-in", str(path), "-pubout", "-outform", "DER")[-65:]


def es256(path, data):
    """data signed with the key (ECDSA, SHA-256) as JWT wants it: r and s, 32 bytes each."""
    der = openssl("dgst", "-sha256", "-sign", str(path), input=data)
    i, ints = 2, []
    while i < len(der):
        n = der[i + 1]
        ints.append(int.from_bytes(der[i + 2:i + 2 + n], "big"))
        i += 2 + n
    return b"".join(v.to_bytes(32, "big") for v in ints)


def ecdh(path, peer):
    """The secret the key shares with a public key (65 bytes of its point)."""
    with tempfile.NamedTemporaryFile(suffix=".der") as f:
        f.write(P256_SPKI + peer)
        f.flush()
        return openssl("pkeyutl", "-derive", "-inkey", str(path), "-peerkey", f.name, "-peerform", "DER")


def gf_mult(x, y):
    """Multiplication in GCM's field (NIST SP 800-38D)."""
    z = 0
    for i in range(127, -1, -1):
        if (x >> i) & 1:
            z ^= y
        y = (y >> 1) ^ (0xE1 << 120) if y & 1 else y >> 1
    return z


def aes128gcm(key, nonce, data):
    """AES-128-GCM, ciphertext and tag. openssl's command line has no GCM, so
    it only runs AES on the counter blocks; the mode is done here."""
    n = -(-len(data) // 16)
    blocks = bytes(16) + nonce + b"\0\0\0\1" + b"".join(nonce + (i + 2).to_bytes(4, "big") for i in range(n))
    out = openssl("enc", "-aes-128-ecb", "-K", key.hex(), "-nopad", input=blocks)
    h, mask, stream = int.from_bytes(out[:16], "big"), out[16:32], out[32:]
    ct = bytes(a ^ b for a, b in zip(data, stream))
    x = 0
    for i in range(0, len(ct), 16):
        x = gf_mult(x ^ int.from_bytes(ct[i:i + 16].ljust(16, b"\0"), "big"), h)
    x = gf_mult(x ^ (len(ct) * 8), h)
    return ct + bytes(a ^ b for a, b in zip(x.to_bytes(16, "big"), mask))


def hkdf(salt, ikm, info, n):
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    return hmac.new(prk, info + b"\1", hashlib.sha256).digest()[:n]


def push_encrypt(keys, payload):
    """A notification's payload as only that phone can read it (RFC 8291, aes128gcm)."""
    ua_public, auth = unb64u(keys["p256dh"]), unb64u(keys["auth"])
    with tempfile.TemporaryDirectory() as d:
        key = Path(d) / "key.pem"
        ec_new(key)
        as_public, secret = ec_public(key), ecdh(key, ua_public)
    ikm = hkdf(auth, secret, b"WebPush: info\0" + ua_public + as_public, 32)
    salt = os.urandom(16)
    cek = hkdf(salt, ikm, b"Content-Encoding: aes128gcm\0", 16)
    nonce = hkdf(salt, ikm, b"Content-Encoding: nonce\0", 12)
    return salt + (4096).to_bytes(4, "big") + bytes([65]) + as_public + aes128gcm(cek, nonce, payload + b"\2")


def app_key():
    """The app's own key, made the first time: phones subscribe to it, and
    push services check it signed what it sends."""
    key = APP / "vapid.pem"
    if not key.exists():
        APP.mkdir(parents=True, exist_ok=True)
        APP.chmod(0o700)
        ec_new(key)
    return key


_app_public = {}


def app_public():
    """The app's public key, as phones subscribe with it (base64url)."""
    key = app_key()
    stamp = key.stat().st_mtime_ns
    if _app_public.get("stamp") != stamp:
        _app_public.update(stamp=stamp, key=b64u(ec_public(key)))
    return _app_public["key"]


def app_subscriptions():
    try:
        subs = json.loads((APP / "push.json").read_text())
    except (OSError, ValueError):
        return []
    return [s for s in subs if isinstance(s, dict) and isinstance(s.get("endpoint"), str)]


_push_lock = threading.Lock()


def app_save_subscriptions(change):
    """Change the list of phones to notify (change(list) -> list), in one go."""
    with _push_lock:
        subs = change(app_subscriptions())
        APP.mkdir(parents=True, exist_ok=True)
        old = os.umask(0o077)
        try:
            write_file(APP / "push.json", json.dumps(subs))
        finally:
            os.umask(old)


def push_send(sub, payload):
    """Send one notification: True if the push service took it, False if
    that phone is gone for good (its subscription ended), None on any other
    failure (it may work next time)."""
    import urllib.error
    import urllib.request
    endpoint = sub["endpoint"]
    u = urllib.parse.urlsplit(endpoint)
    claims = {"aud": f"{u.scheme}://{u.netloc}", "exp": int(time.time()) + 12 * 3600, "sub": APP_CONTACT}
    head = b64u(b'{"typ":"JWT","alg":"ES256"}') + "." + b64u(json.dumps(claims).encode())
    key = app_key()
    jwt = head + "." + b64u(es256(key, head.encode()))
    body = push_encrypt(sub["keys"], json.dumps(payload).encode())
    req = urllib.request.Request(endpoint, data=body, method="POST", headers={
        "TTL": "86400", "Urgency": "high", "Content-Encoding": "aes128gcm",
        "Content-Type": "application/octet-stream",
        "Authorization": f"vapid t={jwt}, k={app_public()}"})
    try:
        with urllib.request.urlopen(req, timeout=20):
            return True
    except urllib.error.HTTPError as e:
        if e.code in (404, 410):
            return False
        print(f"amarchy app: push to {u.netloc} failed: {e.code} {e.read()[:200]!r}", file=sys.stderr)
    except (OSError, ValueError) as e:
        print(f"amarchy app: push to {u.netloc} failed: {e}", file=sys.stderr)
    return None


def push_all(payload):
    """Send a notification to every phone, dropping the ones that are gone.
    The number that took it."""
    sent, gone = 0, set()
    for sub in app_subscriptions():
        try:
            ok = push_send(sub, payload)
        except (OSError, KeyError, ValueError) as e:
            print(f"amarchy app: couldn't send a notification: {e}", file=sys.stderr)
            ok = None
        sent += ok is True
        if ok is False:
            gone.add(sub["endpoint"])
    if gone:
        app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] not in gone])
    return sent


# The app's look: the theme, font and wallpaper picked in the app (Settings,
# Look) or with `amarchy theme`, which every phone and browser wears (see
# look_worn, below, which turns a theme's colors into the app's design tokens
# with app_look_vars; docs/design-tokens.md has them all).

APP_WALLPAPER_MAX = 8_000_000   # bytes of a wallpaper, a phone-sized copy
APP_LOOK_TYPES = {"ttf": "font/ttf", "otf": "font/otf", "woff": "font/woff", "woff2": "font/woff2",
                  "jpg": "image/jpeg", "png": "image/png", "webp": "image/webp"}


def image_kind(raw):
    """jpg, png or webp, by what the file starts with; None for anything else."""
    if raw[:3] == b"\xff\xd8\xff":
        return "jpg"
    if raw[:8] == b"\x89PNG\r\n\x1a\n":
        return "png"
    if raw[:4] == b"RIFF" and raw[8:12] == b"WEBP":
        return "webp"
    return None


def parse_color(value):
    """A color the way Omarchy and Hyprland write one (#rrggbb[aa],
    rgb[a](rrggbb[aa]), rgb[a](r,g,b[,a]), 0xaarrggbb) as (r, g, b, alpha),
    or None."""
    v = str(value).strip()
    m = re.fullmatch(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?", v) or \
        re.fullmatch(r"(?i)rgba?\(([0-9a-f]{6})([0-9a-f]{2})?\)", v)
    if m:
        hx, alpha = m.group(1), m.group(2)
        return (int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16), int(alpha, 16) / 255 if alpha else 1.0)
    m = re.fullmatch(r"(?i)rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)", v)
    if m:
        return (*(min(int(x), 255) for x in m.groups()[:3]), min(float(m.group(4) or 1), 1.0))
    m = re.fullmatch(r"0x([0-9a-fA-F]{2})([0-9a-fA-F]{6})", v)
    if m:
        hx = m.group(2)
        return (int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16), int(m.group(1), 16) / 255)
    return None


def css_rgba(c, alpha=1.0):
    r, g, b, a = c
    a = round(a * alpha, 3)
    return f"#{r:02x}{g:02x}{b:02x}" if a >= 1 else f"rgb({r} {g} {b} / {a})"


def qt_darker(c, factor):
    """Qt's darker(): the same hue and saturation, its HSV value divided by
    factor (what the shell dims text with)."""
    import colorsys
    h, s, v = colorsys.rgb_to_hsv(*(x / 255 for x in c[:3]))
    return (*(round(x * 255) for x in colorsys.hsv_to_rgb(h, s, v / factor)), c[3])


def app_look_vars(colors, shell, rounding):
    """The app's base design tokens (app.css, docs/design-tokens.md) from a
    theme's colors.toml and shell.toml (as dicts): a terminal palette mapped
    onto them with the same choices the Omarchy shell makes for its menus,
    popups and controls, so the app reads like them. The role tokens follow
    from these in app.css."""
    def section(name):
        v = shell.get(name)
        return v if isinstance(v, dict) else {}

    def number(name, key, default):
        v = section(name).get(key, default)
        return min(max(float(v), 0.0), 1.0) if isinstance(v, (int, float)) else default

    def colors_of(spec):
        """A shell value's colors and angle: a color, a Hyprland gradient
        ("c1 c2 45deg"), or a reference to one ("hyprland.active-border")."""
        if isinstance(spec, str) and re.fullmatch(r"[\w-]+\.[\w-]+", spec.strip()):
            ref, key = spec.strip().split(".")
            spec = section(ref).get(key)
        if not isinstance(spec, str):
            return [], None
        angle = next((float(p[:-3]) for p in spec.split() if re.fullmatch(r"-?\d+(\.\d+)?deg", p)), None)
        return [c for c in (parse_color(p) for p in spec.split() if not p.endswith("deg")) if c], angle

    def color(name, key, fallback):
        found = colors_of(section(name).get(key))[0]
        return found[0] if found else fallback

    def base(key, fallback):
        return parse_color(colors.get(key, "")) or parse_color(fallback)

    bg = color("menu", "background", base("background", "#1a1b26"))
    fg = color("menu", "text", base("foreground", "#a9b1d6"))
    accent = base("accent", "#7aa2f7")
    border, angle = colors_of(section("popups").get("border", "hyprland.active-border"))
    border = border or [accent]
    # Hyprland's 0deg runs left to right, CSS's bottom to top.
    gradient = (f"linear-gradient({round(90 - (angle or 0), 2)}deg, {', '.join(css_rgba(c) for c in border)})"
                if len(border) > 1 else css_rgba(border[0]))
    controls = section("controls")
    light = colors.get("mode") == "light" if colors.get("mode") in ("light", "dark") \
        else sum(bg[:3]) / 3 > 140
    out = {
        "surface": css_rgba(bg),
        "surface-sunken": css_rgba(base("dark_background", "#13141c")),
        "surface-raised": css_rgba(base("lighter_background", "#24283b")),
        "scrim": css_rgba(color("menu", "scrim", bg), number("menu", "scrim-alpha", 0.5)),
        "text": css_rgba(fg),
        "text-muted": css_rgba(qt_darker(fg, 1.4)),
        "text-selection": css_rgba(base("selection", "#292e42")),
        "accent": css_rgba(accent),
        "border-faint": css_rgba(fg, 0.12),
        "border": css_rgba(fg, 0.2),
        "border-menu": css_rgba(color("menu", "border", fg), number("menu", "border-alpha", 1.0)),
        "border-popup": gradient,
        "border-popup-solid": css_rgba(border[0]),
        "selected-bg": css_rgba(color("menu", "selected-background", fg), number("menu", "selected-background-alpha", 0.08)),
        "selected-text": css_rgba(color("menu", "selected-text", accent)),
        "selected-border": css_rgba(color("menu", "selected-border", fg), number("menu", "selected-border-alpha", 0.25)),
        "control-bg": css_rgba(fg, number("controls", "normal-fill-alpha", 0.04)),
        "control-border": css_rgba(color("controls", "normal-border", fg), number("controls", "normal-border-alpha", 0.4)),
        "control-hover": css_rgba(fg, number("controls", "hover-cursor-fill-alpha", 0.08)),
        "control-selected": css_rgba(color("controls", "selected-color", fg),
                                     number("controls", "selected-fill-alpha", 0.18)),
        "control-pressed": css_rgba(fg, number("controls", "pressed-fill-alpha", 0.22)),
        "radius": f"{rounding}px",
    }
    # Its hues, by name.
    for key, fallback in (("red", "#f7768e"), ("yellow", "#e0af68"), ("green", "#9ece6a"), ("blue", "#7aa2f7"),
                          ("magenta", "#ad8ee6"), ("cyan", "#449dab"), ("orange", "#eb927b")):
        out[key] = css_rgba(base(key, fallback))
    # The terminals' own colors (the 16 ANSI ones, the cursor, the
    # selection), for the app's real terminals: Claude's and the session's.
    for key, fallback in (("foreground", "#a9b1d6"), ("background", "#1a1b26"), ("cursor", "#c0caf5"),
                          ("selection_foreground", "#c0caf5"), ("selection_background", "#7aa2f7"),
                          *((f"color{i}", c) for i, c in enumerate(TERM_COLORS))):
        out["term-" + key.replace("color", "").replace("_", "-")] = css_rgba(base(key, fallback))
    return out, "light" if light else "dark"


# The tokens' names before docs/design-tokens.md, which a theme of your own
# kept from then (the look a desktop sent the app) still has: worn as the
# tokens they became.
LOOK_TOKENS_BEFORE = {
    "bg": "surface", "dark-background": "surface-sunken", "lighter-background": "surface-raised",
    "fg": "text", "dim": "text-muted", "selection": "text-selection",
    "line": "border-faint", "rule": "border", "menu-border": "border-menu",
    "popup-border": "border-popup", "popup-border-solid": "border-popup-solid",
    "sel-bg": "selected-bg", "sel-text": "selected-text", "sel-border": "selected-border",
    "control-fill": "control-bg"}


def look_tokens(variables):
    """A theme's variables as today's tokens (see LOOK_TOKENS_BEFORE): a name
    from before gives way to the token it became, unless that's set too."""
    out = {k: v for k, v in variables.items() if k not in LOOK_TOKENS_BEFORE}
    for k, v in variables.items():
        if k in LOOK_TOKENS_BEFORE:
            out.setdefault(LOOK_TOKENS_BEFORE[k], v)
    return out


# Tokyo Night's terminal colors (color0..color15), for a theme without its own.
TERM_COLORS = ("#32344a", "#f7768e", "#9ece6a", "#e0af68", "#7aa2f7", "#ad8ee6", "#449dab", "#787c99",
               "#444b6a", "#ff7a93", "#b9f27c", "#ff9e64", "#7da6ff", "#bb9af7", "#0db9d7", "#acb0d0")


# The look is picked in the app (Settings, Look) or with `amarchy theme` here,
# and every phone and browser wears it: one of amarchy's themes (themes/:
# Omarchy's palettes, with wallpapers drawn for them), a font (fonts/) and a
# wallpaper (the theme's, your own picture, or none). Until one is picked,
# Tokyo Night, Omarchy's own.
#
# Besides amarchy's, a theme of your own (custom_themes): a look kept whole on
# the host in app/custom/<key>, its colors as the app's variables, with its
# terminals' size and opacity, its wallpaper and maybe a font of its own. The
# look an Omarchy desktop sent the app is kept as one (amarchy migrate), so
# the app wears it as it did.

THEMES = Path(SELF).parent.parent / "themes"
FONTS = Path(SELF).parent.parent / "fonts"
APP_PICK = APP / "theme"                    # choice.json (what's picked) and your own wallpaper
CUSTOM = APP / "custom"                     # your own themes: <key>/theme.json and its files
CUSTOM_FILE = re.compile(r"(wallpaper|wallpaper-wide|regular|bold)\.(jpg|png|webp|ttf|otf|woff2?)")
LOOK_DEFAULT = "tokyo-night"
# The fonts: key -> (its name here, its family). Nerd Fonts builds, so the
# list's icons are in them; System is the device's own (SF Mono on Apple's).
LOOK_FONTS = {"jetbrains-mono": ("JetBrains Mono", "JetBrainsMono Nerd Font"),
              "caskaydia-mono": ("Caskaydia Mono", "CaskaydiaMono Nerd Font"),
              "fira-code": ("Fira Code", "FiraCode Nerd Font"),
              "system": ("System", "")}
LOOK_FONT = "jetbrains-mono"                # Omarchy's
LOOK_WALLPAPERS = {"theme": "The theme's", "own": "Your own", "none": "None"}
LOOK_TERMINAL = {"size": 12.0, "alpha": 0.92}   # the terminals' points and opacity (a theme may say its own)
LOOK_PHONE = "1290x2796"    # an iPhone's screen in pixels, upright: your own wallpaper is cut to it
LOOK_WIDE = "2880x1800"     # a laptop's screen in pixels: and at most this, for a computer's browser
OWN_WALLPAPER = re.compile(r"own-([0-9a-f]{12})-(phone|wide)\.(jpg|png|webp)")


def theme_colors(text):
    """A colors.toml's palette with Omarchy's fallbacks filled in, as
    omarchy-theme-color resolves it (the legacy colorN names, the shades it
    derives, the mode); {} when it doesn't read."""
    import tomllib
    try:
        raw = tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        return {}
    c = {k: v.strip() for k, v in raw.items() if isinstance(v, str) and v.strip()}

    def hexmix(a, b, t):
        a, b = parse_color(a or ""), parse_color(b)
        return css_rgba((*(round(x + (y - x) * t) for x, y in zip(a[:3], b[:3])), 1)) if a and b else None

    def alias(key, other):
        if not c.get(key) and c.get(other):
            c[key] = c[other]

    for key in ("background", "dark_background", "darker_background", "lighter_background",
                "foreground", "dark_foreground", "light_foreground", "bright_foreground"):
        alias(key, key.replace("background", "bg").replace("foreground", "fg"))
    alias("background", "color0")
    alias("foreground", "color7")
    c.setdefault("background", "#1a1b26")
    c.setdefault("foreground", "#a9b1d6")
    c["color0"], c["color7"] = c["background"], c["foreground"]
    for i, key in enumerate(("red", "green", "yellow", "blue", "magenta", "cyan"), 1):
        alias(key, f"color{i}")
        alias(f"bright_{key}", f"color{i + 8}")
    alias("magenta", "purple")
    alias("bright_magenta", "bright_purple")
    alias("light_foreground", "color7")
    alias("bright_foreground", "color15")
    alias("bright_foreground", "foreground")
    c["cursor"] = c["bright_foreground"]
    alias("lighter_background", "color0")
    alias("dark_foreground", "color8")
    alias("dark_foreground", "foreground")
    alias("muted", "color8")
    alias("muted", "dark_foreground")
    for other in ("selection_background", "color8", "color0", "background"):
        alias("selection", other)
    alias("selection_background", "selection")
    alias("selection_foreground", "bright_foreground")
    alias("orange", "yellow")
    for key, (base, toward, amount) in {"brown": ("orange", "#000000", 0.5),
                                        "dark_background": ("background", "#000000", 0.25),
                                        "darker_background": ("background", "#000000", 0.5)}.items():
        if not c.get(key) and hexmix(c.get(base), toward, amount):
            c[key] = hexmix(c.get(base), toward, amount)
    for key in ("red", "yellow", "green", "cyan", "blue", "magenta"):
        if not c.get(f"bright_{key}") and hexmix(c.get(key), "#ffffff", 0.2):
            c[f"bright_{key}"] = hexmix(c.get(key), "#ffffff", 0.2)
    for i, key in enumerate(("background", "red", "green", "yellow", "blue", "magenta", "cyan", "foreground", "muted",
                             "bright_red", "bright_green", "bright_yellow", "bright_blue", "bright_magenta",
                             "bright_cyan", "bright_foreground")):
        alias(f"color{i}", key)
    mode = c.get("mode") or c.get("theme_type")
    if mode not in ("light", "dark"):
        bg = parse_color(c["background"])
        mode = "light" if bg and sum(bg[:3]) > 382 else "dark"
    c["mode"] = mode
    return c


_themes = {}


def look_themes():
    """amarchy's themes, by key: name, mode, palette, and what Omarchy's
    hyprland.lua does for it (theme.toml), in the order of their names. Read
    again when a file in themes/ changes (a pull)."""
    import tomllib
    try:
        stamp = tuple(sorted((f.parent.name, f.name, f.stat().st_mtime_ns) for f in THEMES.glob("*/*.toml")))
    except OSError:
        stamp = ()
    if _themes.get("stamp") == stamp:
        return _themes["found"]
    found = {}
    for d in THEMES.iterdir() if THEMES.is_dir() else ():
        try:
            meta = tomllib.loads((d / "theme.toml").read_text())
            colors = theme_colors((d / "colors.toml").read_text())
        except (OSError, tomllib.TOMLDecodeError):
            continue
        if colors:
            found[d.name] = {"name": str(meta.get("name") or d.name.replace("-", " ").title()), "meta": meta,
                             "colors": colors, "mode": colors["mode"]}
    _themes.update(stamp=stamp, found=dict(sorted(found.items(), key=lambda kv: kv[1]["name"].lower())))
    return _themes["found"]


def look_choice():
    try:
        choice = json.loads((APP_PICK / "choice.json").read_text())
    except (OSError, ValueError):
        return {}
    return choice if isinstance(choice, dict) else {}


_file_sigs = {}


def file_sig(path):
    """A short hash of a file, for its address: a new one when it changes."""
    try:
        st = os.stat(path)
        known = _file_sigs.get(path)
        if known and known[0] == (st.st_mtime_ns, st.st_size):
            return known[1]
        sig = hashlib.sha1(Path(path).read_bytes()).hexdigest()[:12]
    except OSError:
        return ""
    _file_sigs[path] = ((st.st_mtime_ns, st.st_size), sig)
    return sig


def look_own():
    """Your own wallpaper: {"phone": url, "wide": url}, the picture you
    chose, or None."""
    own = look_choice().get("own")
    if isinstance(own, dict) and all(isinstance(own.get(k), str) and OWN_WALLPAPER.fullmatch(own[k])
                                     and (APP_PICK / own[k]).is_file() for k in ("phone", "wide")):
        return {k: f"/own/{own[k]}" for k in ("phone", "wide")}
    return None


def look_shell(colors, meta):
    """The shell.toml the theme would get from Omarchy's template, as far as
    the app reads one: its border (hyprland_active_border, or theme.toml's
    border) on popups and menus."""
    border = str(meta.get("border") or colors.get("hyprland_active_border") or "")
    return {"hyprland": {"active-border": border or colors.get("accent", "#7aa2f7"),
                         "active-border-foreground": border or colors["foreground"]},
            "menu": {"border": "hyprland.active-border-foreground", "selected-border": "hyprland.active-border-foreground"}}


def custom_themes():
    """Your own themes, by key (see above): {"name", "mode", "vars",
    "terminal": {"size", "alpha"}, "wallpaper": {"phone", "wide"} (its files)
    or None, "font": {"family", "nerd", "files": {"regular", "bold"}} or
    None}. One that doesn't read, or names a file it doesn't have, is left out
    (or its wallpaper or font)."""
    out = {}
    for d in sorted(CUSTOM.iterdir()) if CUSTOM.is_dir() else ():
        try:
            t = json.loads((d / "theme.json").read_text())
        except (OSError, ValueError):
            continue
        if not re.fullmatch(r"[\w-]+", d.name) or d.name in look_themes() or not isinstance(t, dict):
            continue
        variables = t.get("vars") if isinstance(t.get("vars"), dict) else {}
        variables = look_tokens({k: v for k, v in variables.items() if isinstance(k, str) and isinstance(v, str)})
        if not variables:
            continue

        def have(f):
            return isinstance(f, str) and CUSTOM_FILE.fullmatch(f) and (d / f).is_file()
        term = t.get("terminal") if isinstance(t.get("terminal"), dict) else {}
        wall = t.get("wallpaper") if isinstance(t.get("wallpaper"), dict) else {}
        font = t.get("font") if isinstance(t.get("font"), dict) else {}
        files = font.get("files") if isinstance(font.get("files"), dict) else {}
        files = {w: f for w, f in files.items() if w in ("regular", "bold") and have(f)}
        out[d.name] = {
            "name": str(t.get("name") or d.name)[:60], "mode": "light" if t.get("mode") == "light" else "dark",
            "vars": variables,
            "terminal": {k: min(max(float(term[k]), lo), hi) for k, lo, hi in (("size", 5.0, 40.0), ("alpha", 0.0, 1.0))
                         if isinstance(term.get(k), (int, float)) and not isinstance(term.get(k), bool)},
            "wallpaper": {w: wall[w] for w in ("phone", "wide")} if all(have(wall.get(w)) for w in ("phone", "wide")) else None,
            "font": {"family": re.sub(r"[^\w .-]", "", str(font.get("family") or ""))[:64] or f"{t.get('name') or d.name}'s",
                     "nerd": bool(font.get("nerd")), "files": files} if "regular" in files else None}
    return out


def custom_url(key, f):
    return f"/custom/{key}/{f}?v={file_sig(CUSTOM / key / f)}"


def look_fonts(custom=None):
    """Every font to pick, by key: {"name", "nerd", "files": {weight: url}}:
    amarchy's (fonts/), then those of your own themes ("custom-<theme>")."""
    out = {}
    for key, (name, family) in LOOK_FONTS.items():
        files = {w: f"/fonts/{key}/{w}.woff2?v={file_sig(FONTS / key / f'{w}.woff2')}"
                 for w in ("regular", "bold") if (FONTS / key / f"{w}.woff2").is_file()}
        out[key] = {"name": name, "nerd": bool(family) and bool(files), "files": files}
    for key, t in (custom_themes() if custom is None else custom).items():
        if t["font"]:
            out[f"custom-{key}"] = {"name": t["font"]["family"], "nerd": t["font"]["nerd"],
                                    "files": {w: custom_url(key, f) for w, f in t["font"]["files"].items()}}
    return out


def look_worn():
    """The look the app wears now: the theme picked (else Tokyo Night), its
    font and its wallpaper. "sig" changes with any of it."""
    choice, themes, custom = look_choice(), look_themes(), custom_themes()
    key = choice.get("theme") if choice.get("theme") in themes or choice.get("theme") in custom else LOOK_DEFAULT
    terminal = dict(LOOK_TERMINAL)
    t = themes.get(key)
    if key in custom:
        c = custom[key]
        look = {"name": c["name"], "mode": c["mode"], "vars": c["vars"], "claude": None}
        terminal.update(c["terminal"])
        wallpaper = {w: custom_url(key, f) for w, f in c["wallpaper"].items()} if c["wallpaper"] else None
    elif not t:     # no themes/ (an amarchy from before them): app.css's own Tokyo Night
        return {"theme": key, "name": "Tokyo Night", "mode": "dark", "vars": {}, "claude": None, "terminal": terminal,
                "font": {"key": "system", "name": "System", "nerd": False, "files": {}}, "wallpaper": None, "sig": ""}
    else:
        rounding = t["meta"].get("rounding", 0)
        variables, mode = app_look_vars(t["colors"], look_shell(t["colors"], t["meta"]),
                                        min(max(int(rounding), 0), 40) if isinstance(rounding, (int, float)) else 0)
        look = {"name": t["name"], "mode": mode, "vars": variables, "claude": t["colors"]}
        alpha = t["meta"].get("terminal-alpha")
        if isinstance(alpha, (int, float)):
            terminal["alpha"] = min(max(float(alpha), 0.0), 1.0)
        wallpaper = {w: f"/themes/{key}/{f}?v={file_sig(THEMES / key / f)}"
                     for w, f in (("phone", "wallpaper.svg"), ("wide", "wallpaper-wide.svg"))}
    fonts = look_fonts(custom)
    font_key = choice.get("font") if choice.get("font") in fonts else LOOK_FONT
    font = {"key": font_key, **fonts[font_key]}
    walls = choice.get("wallpaper") if choice.get("wallpaper") in LOOK_WALLPAPERS else "theme"
    if walls == "own":
        wallpaper = look_own()
    elif walls == "none":
        wallpaper = None
    look.update(theme=key, terminal=terminal, font=font, wallpaper=wallpaper, wallpapers=walls)
    look["sig"] = hashlib.sha1(json.dumps(look, sort_keys=True).encode()).hexdigest()
    return look


def look_stamp(look=None):
    """Which look the app wears, for its list: the page takes theme.css
    again when it changes."""
    look = look or look_worn()
    return {"look": look["sig"], "font": look["font"]["key"], "theme": look["theme"], "name": look["name"]}


def app_theme_css():
    """/theme.css: the look over app.css's own (Tokyo Night), and the font."""
    look = look_worn()
    out = [f"/* {look['name']}, as picked in the app (amarchy theme). */", ":root {"]
    out += [f"  --{k}: {v};" for k, v in look["vars"].items() if re.fullmatch(r"[\w-]+", k)
            and re.fullmatch(r"[\w#().,/% -]+", str(v))]
    out.append(f"  color-scheme: {'light' if look.get('mode') == 'light' else 'dark'};")
    term = look["terminal"]
    if isinstance(term.get("size"), (int, float)):      # points, as a terminal has them: 96 dpi
        out.append(f"  --term-size: {round(term['size'] * 4 / 3, 2)}px;")
    if isinstance(term.get("alpha"), (int, float)):
        out.append(f"  --term-alpha: {term['alpha']};")
    if look["wallpaper"]:
        out.append(f'  --wallpaper: url("{look["wallpaper"]["phone"]}");')
        out.append(f'  --wallpaper-wide: url("{look["wallpaper"]["wide"]}");')
    files = look["font"]["files"]
    # Named after the font: another one is another family, which the terminals measure afresh.
    family = f"amarchy-{look['font']['key']}"
    out.append(f'  --font: "{family}", ui-monospace, Menlo, monospace;' if files
               else '  --font: ui-monospace, Menlo, "SF Mono", monospace;')
    out.append("}")
    for weight, url in files.items():
        kind = url.partition("?")[0].rsplit(".", 1)[-1]
        fmt = {"ttf": "truetype", "otf": "opentype"}.get(kind, kind)
        out.append(f'@font-face {{ font-family: "{family}"; src: url("{url}") format("{fmt}"); '
                   f'font-weight: {700 if weight == "bold" else 400}; font-display: swap; }}')
    if "regular" in files and "bold" not in files:      # one file: the browser makes the bold
        out[-1] = out[-1].replace("font-weight: 400", "font-weight: 100 900")
    return "\n".join(out) + "\n"


# Claude Code in the theme's colors (Omarchy's claude.json template): the
# sessions start in it ("custom:amarchy", see hook_settings), and a session
# that has it takes a new one as soon as the file changes.
CLAUDE_LOOK = {
    "claude": ("accent",), "claudeShimmer": ("accent", "foreground", 35), "text": ("foreground",),
    "inverseText": ("background",), "inactive": ("foreground", "background", 40),
    "inactiveShimmer": ("foreground", "background", 25), "subtle": ("muted",), "suggestion": ("cyan",),
    "permission": ("blue",), "permissionShimmer": ("blue", "foreground", 35), "remember": ("yellow",),
    "success": ("green",), "error": ("red",), "warning": ("yellow",), "warningShimmer": ("yellow", "foreground", 35),
    "merged": ("magenta",), "promptBorder": ("accent",), "promptBorderShimmer": ("accent", "foreground", 35),
    "planMode": ("cyan",), "autoAccept": ("yellow",), "bashBorder": ("bright_yellow",), "ide": ("bright_cyan",),
    "diffAdded": ("background", "green", 15), "diffRemoved": ("background", "red", 15),
    "diffAddedDimmed": ("background", "green", 8), "diffRemovedDimmed": ("background", "red", 8),
    "diffAddedWord": ("background", "green", 32), "diffRemovedWord": ("background", "red", 32),
    "userMessageBackground": ("background", "foreground", 6),
    "userMessageBackgroundHover": ("background", "foreground", 10),
    "bashMessageBackgroundColor": ("background", "foreground", 6),
    "memoryBackgroundColor": ("background", "foreground", 6), "selectionBg": ("selection_background",),
    "rate_limit_fill": ("accent",), "rate_limit_empty": ("background", "foreground", 20),
    "briefLabelYou": ("yellow",), "briefLabelClaude": ("accent",),
}


def look_claude(colors):
    """Claude Code wears the theme picked (none: Claude Code's own again)."""
    if not colors:
        CLAUDE_THEME.unlink(missing_ok=True)
        return
    overrides = {}
    for key, (a, *mix) in CLAUDE_LOOK.items():
        c = parse_color(colors.get(a, ""))
        if c and mix:
            d = parse_color(colors.get(mix[0], ""))
            c = (*(round(x + (y - x) * mix[1] / 100) for x, y in zip(c[:3], d[:3])), 1) if d else c
        if c:
            overrides[key] = css_rgba((*c[:3], 1))
    write_file(CLAUDE_THEME, json.dumps({"name": "Amarchy", "base": colors["mode"], "overrides": overrides}, indent=2))


def look_set(theme=None, font=None, wallpaper=None, own=None, claude=True):
    """Pick a theme (a key of look_themes() or custom_themes()), a font (a
    key of look_fonts()) and/or a wallpaper ("theme", "own" or "none"); own:
    your own picture, (phone, wide) as image bytes. Claude Code takes a new
    theme too, unless not claude. The look worn after, or an error."""
    if theme is not None and theme not in look_themes() and theme not in custom_themes():
        return f"no theme called {theme!r} (see amarchy theme --list)"
    fonts = look_fonts()
    if font is not None and font not in fonts:
        return f"no font called {font!r} ({', '.join(fonts)})"
    if wallpaper is not None and wallpaper not in LOOK_WALLPAPERS:
        return "the wallpaper is theme, own or none"
    choice = look_choice()
    if own:
        names = {}
        for which, raw in zip(("phone", "wide"), own):
            kind = image_kind(raw or b"")
            if not kind or len(raw) > APP_WALLPAPER_MAX:
                return "that isn't a picture (a JPEG, PNG or WebP of at most 8 MB)"
            names[which] = (which, raw, kind)
        sig = hashlib.sha1(own[0] + own[1]).hexdigest()[:12]
        for which, raw, kind in names.values():
            write_file(APP_PICK / f"own-{sig}-{which}.{kind}", raw)
        choice["own"] = {which: f"own-{sig}-{which}.{kind}" for which, _, kind in names.values()}
        wallpaper = wallpaper or "own"
    if wallpaper == "own" and not own and not look_own():
        return "you have no wallpaper of your own yet: choose a picture first"
    for k, v in (("theme", theme), ("font", font), ("wallpaper", wallpaper)):
        if v is not None:
            choice[k] = v
    choice.setdefault("theme", LOOK_DEFAULT)
    write_file(APP_PICK / "choice.json", json.dumps(choice, indent=1))
    keep = set((choice.get("own") or {}).values()) | {"choice.json"}
    for f in APP_PICK.iterdir():
        if f.name not in keep and not f.name.startswith("."):
            f.unlink(missing_ok=True)
    look = look_worn()
    if theme is not None and claude:
        look_claude(look["claude"])
    return look


def look_info():
    """Everything the app's picker shows: the themes (with their colors and
    wallpaper), the fonts, the wallpapers, and what's worn."""
    look, custom = look_worn(), custom_themes()
    # Your own first, then amarchy's.
    themes = [{"key": k, "name": t["name"], "mode": t["mode"], "custom": True,
               "colors": [t["vars"].get(c, "") for c in ("surface", "text", "accent", "red", "yellow", "green", "blue",
                                                         "magenta")],
               "wallpaper": custom_url(k, t["wallpaper"]["wide"]) if t["wallpaper"] else ""}
              for k, t in custom.items()]
    themes += [{"key": k, "name": t["name"], "mode": t["mode"],
                "colors": [t["colors"].get(c, "") for c in ("background", "foreground", "accent", "red", "yellow",
                                                            "green", "blue", "magenta")],
                "wallpaper": f"/themes/{k}/wallpaper-wide.svg?v={file_sig(THEMES / k / 'wallpaper-wide.svg')}"}
               for k, t in look_themes().items()]
    own = look_own()
    return {"theme": look["theme"], "font": look["font"]["key"], "wallpaper": look["wallpapers"], "look": look_stamp(look),
            "nerd": look["font"]["nerd"], "themes": themes,
            "fonts": [{"key": k, "name": f["name"], "nerd": f["nerd"]} for k, f in look_fonts(custom).items()],
            "own": own["phone"] if own else ""}


def wallpaper_cut(path, wide=False):
    """A picture as the app shows it: cut to a phone's screen (its middle),
    or the whole of it at most a laptop's screen in size (wide), as a JPEG.
    With ImageMagick, else ffmpeg; without either, the picture as it is if
    it isn't too big. None if it can't be read."""
    cut = ["-resize", LOOK_WIDE + ">"] if wide else \
        ["-resize", LOOK_PHONE + "^", "-gravity", "center", "-extent", LOOK_PHONE]
    pw, ph = LOOK_PHONE.split("x")
    dw, dh = LOOK_WIDE.split("x")
    scale = (f"scale='min({dw},iw)':'min({dh},ih)':force_original_aspect_ratio=decrease" if wide else
             f"scale={pw}:{ph}:force_original_aspect_ratio=increase,crop={pw}:{ph}")
    with tempfile.TemporaryDirectory() as tmp:
        out = Path(tmp) / "wallpaper.jpg"
        if shutil.which("magick"):
            r = sh("magick", f"{path}[0]", *cut, "-quality", "82", "-strip", str(out))
        elif shutil.which("ffmpeg"):
            r = sh("ffmpeg", "-loglevel", "error", "-y", "-i", str(path), "-frames:v", "1", "-vf", scale,
                   "-q:v", "3", str(out))
        else:
            try:
                raw = Path(path).read_bytes() if os.path.getsize(path) <= APP_WALLPAPER_MAX else b""
            except OSError:
                raw = b""
            return raw if image_kind(raw) else None
        try:
            return out.read_bytes() if r.returncode == 0 else None
        except OSError:
            return None


def look_find(name, table):
    """A theme or font by its key or its name, however it's written."""
    want = re.sub(r"[^a-z0-9]", "", name.lower())
    for key, label in table.items():
        if want in (re.sub(r"[^a-z0-9]", "", key), re.sub(r"[^a-z0-9]", "", label.lower())):
            return key
    return None


def cmd_theme(args):
    """`amarchy theme`: the app's theme, font and wallpaper."""
    theme = font = wallpaper = None
    own, listing, as_json = None, False, False
    it = iter(args)
    for a in it:
        if a in ("--font", "--wallpaper"):
            v = next(it, None)
            if v is None:
                return fail(f"theme {a}: which?")
            if a == "--font":
                fonts = {k: f["name"] for k, f in look_fonts().items()}
                font = look_find(v, fonts)
                if not font:
                    return fail(f"no font called {v!r} ({', '.join(fonts.values())})")
            elif v in LOOK_WALLPAPERS:
                wallpaper = v
            else:
                if not Path(v).is_file():
                    return fail(f"theme --wallpaper: theme, own, none or a picture ({v} isn't a file)")
                own = (wallpaper_cut(v), wallpaper_cut(v, wide=True))
                if not all(own):
                    return fail(f"couldn't read {v} as a picture")
        elif a == "--list":
            listing = True
        elif a == "--json":
            as_json = True
        elif a == "--show":
            pass
        elif a.startswith("-"):
            return fail(f"theme: unknown option {a}")
        else:
            theme = look_find(a, {**{k: t["name"] for k, t in custom_themes().items()},
                                  **{k: t["name"] for k, t in look_themes().items()}})
            if not theme:
                return fail(f"no theme called {a!r} (see amarchy theme --list)")
    if listing:
        info = look_info()
        if as_json:
            print(json.dumps({k: info[k] for k in ("theme", "font", "wallpaper", "themes", "fonts")}, indent=1))
            return 0
        for t in info["themes"]:
            mark = "*" if t["key"] == info["theme"] else " "
            print(f"{mark} {t['key']:<18} {t['name']}{' (light)' if t['mode'] == 'light' else ''}"
                  f"{' (your own)' if t.get('custom') else ''}")
        print("fonts: " + ", ".join(f"{f['key']}{'*' if f['key'] == info['font'] else ''}" for f in info["fonts"]))
        print("wallpapers: " + ", ".join(f"{k}{'*' if k == info['wallpaper'] else ''}" for k in LOOK_WALLPAPERS))
        return 0
    if any(v is not None for v in (theme, font, wallpaper, own)):
        look = look_set(theme, font, wallpaper, own)
        if isinstance(look, str):
            return fail(look)
    look = look_worn()
    walls = {"theme": "the theme's wallpaper", "own": "your own wallpaper", "none": "no wallpaper"}[look["wallpapers"]]
    print(f"{look['name']} · {look['font']['name']} · {walls}")
    return 0


def tailscale_status():
    try:
        return json.loads(sh("tailscale", "status", "--json").stdout or "{}")
    except ValueError:
        return {}


def app_address(status=None):
    """This machine's name on the tailnet (amarchy.tail1234.ts.net), the one
    its HTTPS certificate is for, or None."""
    status = status if status is not None else tailscale_status()
    name = ((status.get("Self") or {}).get("DNSName") or "").rstrip(".")
    return name or None


def app_users(status=None):
    """The Tailscale logins let in: APP_USERS= (comma separated), else the
    owner of this machine."""
    users = host_setting("APP_USERS")
    if users:
        return {u.strip() for u in users.split(",") if u.strip()}
    status = status if status is not None else tailscale_status()
    me = status.get("Self") or {}
    login = ((status.get("User") or {}).get(str(me.get("UserID"))) or {}).get("LoginName", "")
    return {login} if login and "@" in login else set()


def app_port():
    try:
        return int(host_setting("APP_PORT") or APP_PORT)
    except ValueError:
        return APP_PORT


def app_https():
    try:
        return int(host_setting("APP_HTTPS") or APP_HTTPS)
    except ValueError:
        return APP_HTTPS


def app_url(address):
    https = app_https()
    return f"https://{address}" + ("" if https == 443 else f":{https}") + "/"


# ---- what the app shows of a session

def app_where(s):
    return f"{s['repo']} · {s.get('branch') or s['name']}"


def short_path(path, s):
    """A file path as the worktree sees it."""
    root = s["path"].rstrip("/") + "/"
    return path[len(root):] if isinstance(path, str) and path.startswith(root) else path


def tool_summary(name, args, s):
    """A tool call in a line: the command it runs, the file it reads, what it searches."""
    if not isinstance(args, dict):
        return ""
    if name == "TodoWrite" and isinstance(args.get("todos"), list):
        return f"{len(args['todos'])} to-dos"
    if name == "AskUserQuestion" and isinstance(args.get("questions"), list) and args["questions"]:
        q = args["questions"][0]
        return q.get("question", "") if isinstance(q, dict) else ""
    for key in ("command", "file_path", "notebook_path", "pattern", "url", "query", "description", "prompt",
                "skill", "message", "path"):
        value = args.get(key)
        if isinstance(value, str) and value.strip():
            return short_path(value, s) if key in ("file_path", "notebook_path", "path") else value
    for value in args.values():
        if isinstance(value, str) and value.strip():
            return value
    return ""


def result_text(content):
    if isinstance(content, str):
        return content
    out = []
    for b in content if isinstance(content, list) else []:
        if isinstance(b, dict):
            out.append(b.get("text", "") if b.get("type") == "text" else f"[{b.get('type', '')}]")
    return "\n".join(out)


def tag_text(text, tag):
    m = re.search(rf"<{tag}>(.*?)</{tag}>", text, re.S)
    return m.group(1).strip() if m else None


def user_item(text):
    """What you said, as the conversation shows it: Claude Code wraps slash
    commands, ! commands and their output in tags, and adds reminders for Claude."""
    text = re.sub(r"<system-reminder>.*?</system-reminder>", "", text, flags=re.S).strip()
    if not text or text.startswith("<local-command-caveat>"):
        return None
    name = tag_text(text, "command-name")
    if name is not None:
        args = tag_text(text, "command-args") or ""
        return {"kind": "command", "text": f"{name} {args}".strip()}
    for tag, kind in (("bash-input", "command"), ("local-command-stdout", "note"), ("bash-stdout", "note"),
                      ("bash-stderr", "note")):
        inner = tag_text(text, tag)
        if inner is not None:
            if kind == "command":
                return {"kind": "command", "text": f"! {inner}"}
            return {"kind": "note", "text": inner} if inner else None
    if text.startswith("[Request interrupted"):
        return {"kind": "note", "text": "Interrupted"}
    return {"kind": "user", "text": text}


def app_items(records, s):
    """A conversation's records as the app shows them: what you said, what
    Claude said, its tool calls (each result follows as "result", for the
    call it answers) and notes. Thinking and Claude Code's bookkeeping are left out."""
    out = []
    for r in records:
        if not isinstance(r, dict) or r.get("isSidechain") or r.get("isMeta"):
            continue
        kind, rid, at = r.get("type"), r.get("uuid") or "", r.get("timestamp") or ""
        message = r.get("message") if isinstance(r.get("message"), dict) else {}
        content = message.get("content")
        blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
        found = []
        if kind == "user":
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text":
                    found.append(user_item(b.get("text") or ""))
                elif b.get("type") == "image":
                    found.append({"kind": "user", "text": "[image]"})
                elif b.get("type") == "tool_result":
                    text = result_text(b.get("content"))
                    found.append({"kind": "result", "tool": b.get("tool_use_id", ""), "error": bool(b.get("is_error")),
                                  "text": text[:4000] + ("\n…" if len(text) > 4000 else "")})
        elif kind == "assistant":
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and (b.get("text") or "").strip():
                    found.append({"kind": "claude", "text": b["text"].strip()})
                elif b.get("type") == "tool_use":
                    found.append({"kind": "tool", "id": b.get("id", ""), "name": b.get("name", ""),
                                  "summary": tool_summary(b.get("name"), b.get("input"), s)[:600]})
        elif kind == "system":
            sub = r.get("subtype")
            if sub == "away_summary" and r.get("content"):
                found.append({"kind": "note", "text": re.sub(r"\s*\(disable recaps.*?\)$", "", str(r["content"]))})
            elif sub == "compact_boundary":
                found.append({"kind": "note", "text": "Conversation compacted"})
            elif sub == "local_command" and isinstance(r.get("content"), str):
                found.append(user_item(r["content"]))
        for i, item in enumerate(x for x in found if x):
            out.append({**item, "key": f"{rid}:{i}", "at": at})
    return out


def line_start(fh, pos):
    """The start of the line pos is in (0, or just after a newline)."""
    if pos <= 0:
        return 0
    fh.seek(pos - 1)
    fh.readline()
    return fh.tell()


def read_records(f, start, end):
    """The records of a transcript between two offsets (at line starts)."""
    with open(f, "rb") as fh:
        fh.seek(start)
        data = fh.read(max(end - start, 0))
    out = []
    for line in data.splitlines():
        if b'"type":"api-request' in line[:40] or not line.strip():
            continue        # copies of what went to the API: big, and nothing to show
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


class AppConversation:
    """Follows the conversation a session is in (it changes with /clear): the
    latest of it first, then what's added."""

    def __init__(self, s):
        self.s, self.file, self.start, self.offset = s, None, 0, 0

    def poll(self):
        """(items, reset): what's new, or with reset, all there is to show from scratch."""
        f = transcript(self.s)
        if f != self.file:
            self.file = f
            if not f:
                self.start = self.offset = 0
                return [], True
            with open(f, "rb") as fh:
                end = fh.seek(0, 2)
                self.start = line_start(fh, end - APP_CHUNK)
            self.offset = self.start
            return self.read(), True
        return (self.read(), False) if f else ([], False)

    def read(self):
        try:
            with open(self.file, "rb") as fh:
                fh.seek(self.offset)
                data = fh.read()
        except OSError:
            return []
        done = data.rfind(b"\n") + 1        # a line still being written waits for the next time
        records = read_records(self.file, self.offset, self.offset + done) if done else []
        self.offset += done
        return app_items(records, self.s)


def app_closing(s):
    """What closing a session would cost, for the phone to ask first (as
    confirm_close does): its uncommitted files, and whether amarchy runs
    from its worktree."""
    path = Path(s["path"])
    changes = len(sh("git", "status", "--porcelain", cwd=path).stdout.splitlines()) if path.is_dir() else 0
    return {"changes": changes, "amarchy": installed_from(path)}


def app_earlier(s, before):
    """The part of the conversation before an offset: (items, its start)."""
    f = transcript(s)
    if not f or before <= 0:
        return [], 0
    with open(f, "rb") as fh:
        start = line_start(fh, before - APP_CHUNK)
    return app_items(read_records(f, start, before), s), start


OPTION = re.compile(r"^(\s{0,8})(❯\s*)?(\d{1,2})\.\s+(\S.*)$")
RULE = re.compile(r"^\s*[─━]{8,}\s*$")
DASHES = re.compile(r"^\s*[╌┄-]{8,}\s*$")
# The line under each of Claude Code's dialogs, saying how to answer it.
DIALOG_HINT = re.compile(r"Esc to (cancel|exit|go back)|Enter to (select|confirm|continue|submit)|to navigate")


def claude_dialog(lines):
    """A question Claude Code shows (a permission prompt, AskUserQuestion, a
    menu), read off its screen: {id, question, options: [{label, detail,
    keys}], hint}, or None. Each option's keys pick it: its number, or the
    arrows to it and Enter in a menu without numbers."""
    width = max((len(l) for l in lines), default=0)
    hint = next((i for i in range(len(lines) - 1, max(len(lines) - 7, -1), -1)
                 if DIALOG_HINT.search(lines[i])), None)
    if hint is None:
        return None
    found, expect = [], None
    for j in range(hint - 1, max(hint - 60, -1), -1):
        m = OPTION.match(lines[j])
        if not m:
            continue
        n = int(m.group(3))
        if expect is not None and n != expect:
            break
        found.insert(0, (j, m))
        expect = n - 1
        if n == 1:
            break
    options = []
    if found and expect == 0:
        top = found[0][0]
        for k, (j, m) in enumerate(found):
            label, detail = m.group(4).strip(), []
            stop = found[k + 1][0] if k + 1 < len(found) else hint
            # A label too long for the line goes on below it, cut at a space
            # or, where the line is full to the edge, inside a word.
            prev = lines[j]
            for line in lines[j + 1:stop]:
                if not line.strip() or RULE.match(line) or DASHES.match(line):
                    prev = ""
                    continue
                if len(prev) >= width - 3:
                    label += ("" if len(prev) == width else " ") + line.strip()
                    prev = line
                else:
                    detail.append(line.strip())
                    prev = ""
            n = int(m.group(3))
            options.append({"label": label, "detail": " ".join(detail), "selected": bool(m.group(2)),
                            "keys": [str(n)] if n <= 9 else ["Down"] * (n - 1) + ["Enter"]})
    else:
        # A menu without numbers: the line with ❯ and the ones beside it, lined up with it.
        mark = next((j for j in range(hint - 1, max(hint - 30, -1), -1)
                     if re.match(r"^\s+❯\s+\S", lines[j])), None)
        if mark is None:
            return None
        col = re.match(r"^(\s+❯\s+)", lines[mark]).end()
        def sibling(line):
            return len(line) > col and line[:col].strip() in ("", "❯") and line[col] != " "
        top = mark
        while top > 0 and sibling(lines[top - 1]):
            top -= 1
        bottom = mark
        while bottom + 1 < hint and sibling(lines[bottom + 1]):
            bottom += 1
        for j in range(top, bottom + 1):
            d = j - mark
            options.append({"label": lines[j][col:].strip(), "detail": "", "selected": j == mark,
                            "keys": ["Up"] * -d + ["Down"] * d + ["Enter"]})
    rule = next((j for j in range(top - 1, -1, -1) if RULE.match(lines[j])), -1)
    # (A question's tab in AskUserQuestion has a box before it, ☐ or ☒ once answered.)
    question = [re.sub(r"^[☐☒✔]\s*", "", l.strip()) for l in lines[rule + 1:top] if l.strip() and not DASHES.match(l)]
    if not options:
        return None
    question = "\n".join(question[-14:])
    sig = json.dumps([question, [o["label"] for o in options]])
    return {"id": hashlib.sha1(sig.encode()).hexdigest()[:12], "question": question, "options": options,
            "hint": lines[hint].strip()}


EXITED = "Claude Code exited. Press Enter"


def app_screen(s):
    """What the session's Claude shows now: its screen as text, the question
    on it if any, and whether Claude is there at all (exited: it's waiting
    for Enter to start again; asleep: its last screen stays, Claude gone
    until something wakes it; waking: on its way back)."""
    asleep, waking = asleep_since(s["id"]) is not None, waking_now(s["id"])
    r = tmux("capture-pane", "-p", "-t", f"={tmux_name(s['id'])}:")
    if r.returncode != 0:
        return {"live": False, "text": "", "dialog": None, "exited": False, "asleep": asleep, "waking": False}
    lines = [l.rstrip() for l in r.stdout.splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    exited = not asleep and any(EXITED in l for l in lines[-4:])
    return {"live": True, "text": "\n".join(lines), "exited": exited, "asleep": asleep, "waking": waking,
            "dialog": None if exited or asleep or waking else claude_dialog(lines)}


def app_type(s, text):
    """Send a message to the session's Claude, as if typed and sent: pasted
    (so new lines stay in it) and Enter."""
    pane = f"={tmux_name(s['id'])}:"
    buffer = f"amarchy-app-{os.getpid()}-{threading.get_ident()}"
    r = tmux("set-buffer", "-b", buffer, "--", text)
    if r.returncode == 0:
        r = tmux("paste-buffer", "-p", "-r", "-d", "-b", buffer, "-t", pane)
    if r.returncode != 0:
        return r.stderr.strip() or "tmux failed"
    time.sleep(0.25)      # Claude takes the paste in before Enter sends it
    r = tmux("send-keys", "-t", pane, "Enter")
    return None if r.returncode == 0 else (r.stderr.strip() or "tmux failed")


def valid_keys(keys):
    return isinstance(keys, list) and 0 < len(keys) <= 20 and all(isinstance(k, str) and k in APP_KEYS for k in keys)


def app_keys(s, keys):
    pane = f"={tmux_name(s['id'])}:"
    for i, key in enumerate(keys):
        if i:
            time.sleep(0.06)
        r = tmux("send-keys", "-t", pane, key)
        if r.returncode != 0:
            return r.stderr.strip() or "tmux failed"
    return None


# ---- dictation from the phone
#
# Claude Code's voice mode (/voice) records with SoX's rec, whichever its PATH
# finds, and listens for its key held down: a space again and again, as a key
# repeats, starts it (five of them, under 120 ms apart), and none for 200 ms
# ends it, the transcript going into its prompt. A session's Claude finds
# amarchy's rec first (bin/amarchy-rec, linked as rec: see paste_path and
# install.sh). While the phone holds its mic button on that session, that
# rec is the phone's microphone, which the app's server hands it on a socket
# (mic_socket); the server holds the space down meanwhile. A browser showing
# Claude's terminal is its microphone the same way (DeskMic). Otherwise it's
# the real rec.

APP_MIC = APP / "mic"
MIC_FORMAT = ["-t", "raw", "-r", "16000", "-e", "signed", "-b", "16", "-c", "1"]   # what the phone sends
MIC_REPEAT = 0.04       # seconds between the spaces of the held key, as a key repeats
MIC_MAX = 300           # seconds a dictation lasts at most
MIC_QUIET = 3           # seconds without a word from the phone before it counts as let go
MIC_CAUGHT_UP = 1.5     # seconds without a new word from Claude, writing down what was said ahead of it
MIC_TAIL = 0.6          # seconds the key stays held after the last of the audio, rec hearing silence
MIC_HUSH = bytes(640)   # 20 ms of silence, as the phone sends it
MIC_LET_GO = 1.5        # seconds rec may go on hearing silence once the key is up
MIC_METER = "▁▂▃▄▅▆▇█"  # what Claude draws after the words while it listens (how loud)
SGR = re.compile(r"\x1b\[([0-9;:]*)m")
ANSI = re.compile(r"\x1b\[[0-9;:?]*[A-Za-z]")


def mic_socket(sid, state=None):
    """Where a session's dictation is read from: a short name (a socket's
    path can't be long), in amarchy's state, or your runtime directory when
    even that is too long."""
    state = state or STATE
    name = hashlib.sha1(f"{state}\0{sid}".encode()).hexdigest()[:20] + ".sock"
    path = state / APP_MIC.relative_to(STATE) / name
    if len(str(path)) < 100:
        return path
    run = Path(f"/run/user/{os.getuid()}")      # the same for the server and Claude, whatever their environments
    return (run if run.is_dir() else Path(f"/tmp/amarchy-{os.getuid()}")) / "amarchy-mic" / name


def claude_voice():
    """Claude Code's voice mode as its settings have it: on or not, and held
    ("hold", the default) or tapped ("tap")."""
    try:
        d = json.loads((Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude") / "settings.json").read_text())
    except (OSError, ValueError):
        d = {}
    d = d if isinstance(d, dict) else {}
    v = d.get("voice") if isinstance(d.get("voice"), dict) else {}
    return {"enabled": bool(v["enabled"] if "enabled" in v else d.get("voiceEnabled")),
            "mode": "tap" if v.get("mode") == "tap" else "hold"}


def undimmed(line):
    """A line of the screen (with its colors) without its dim text: Claude's
    grey placeholder and suggestions aren't what's typed."""
    out, dim, at = [], False, 0
    for m in SGR.finditer(line):
        if not dim:
            out.append(line[at:m.start()])
        at = m.end()
        ps = m.group(1).replace(":", ";").split(";")
        i = 0
        while i < len(ps):
            p = ps[i]
            if p in ("38", "48", "58"):        # a color: its own numbers aren't attributes
                i += 3 if ps[i + 1:i + 2] == ["5"] else 5
                continue
            if p in ("", "0", "22"):
                dim = False
            elif p == "2":
                dim = True
            i += 1
    if not dim:
        out.append(line[at:])
    return ANSI.sub("", "".join(out))


def claude_prompt(s):
    """What's typed in the session's Claude's prompt, as one line ("" for
    nothing), or None when its prompt isn't on screen (asleep or waking, the
    prompt there is Claude's last screen, not Claude)."""
    if asleep_since(s["id"]) is not None or waking_now(s["id"]):
        return None
    r = tmux("capture-pane", "-p", "-e", "-t", f"={tmux_name(s['id'])}:")
    if r.returncode != 0:
        return None
    raw = r.stdout.splitlines()
    plain = [ANSI.sub("", l).rstrip() for l in raw]
    rule = lambda l: len(l) > 10 and set(l.strip()) == {"─"}
    for i in range(len(plain) - 1, 0, -1):
        if not (plain[i].startswith("❯") and rule(plain[i - 1])):
            continue
        end = next((j for j in range(i + 1, len(plain)) if rule(plain[j])), None)
        if end is None:
            return None
        parts = [undimmed(raw[i]).split("❯", 1)[-1], *(undimmed(l) for l in raw[i + 1:end])]
        return " ".join(" ".join(p.replace("\xa0", " ").split()) for p in parts).strip()
    return None


def clear_claude_prompt(s):
    """Empty the session's Claude's prompt (Ctrl+U, line by line). Whether it is."""
    pane = f"={tmux_name(s['id'])}:"
    for _ in range(12):
        if not claude_prompt(s):
            break
        tmux("send-keys", "-t", pane, "C-u")
        time.sleep(0.12)
        if claude_prompt(s):        # a line above, of a prompt of several
            tmux("send-keys", "-t", pane, "BSpace")
            time.sleep(0.08)
    return claude_prompt(s) == ""


def desk_hide(s):
    """While the phone dictates, the other views of the session's Claude
    (its tmux clients: a browser's terminal, a terminal over ssh) go to a
    screen that says so: the words come up on the phone only. What desk_show
    needs to put it back, or None."""
    name = tmux_name(s["id"])
    r = tmux("list-clients", "-t", f"={name}", "-F", "#{client_name}")
    clients = r.stdout.split() if r.returncode == 0 else []
    if not clients:
        return None
    away = f"{name}-dictating"
    size = tmux("display-message", "-p", "-t", f"={name}:", "#{window_width} #{window_height}").stdout.split()
    # Back to Claude on its own too, should the server go before it says so.
    back = (f'sleep {MIC_MAX + 60}; for c in $(tmux -L amarchy list-clients -t "={away}" -F "#{{client_name}}"); '
            f'do tmux -L amarchy switch-client -c "$c" -t "={name}"; done')
    tmux("kill-session", "-t", f"={away}")
    tmux("new-session", "-d", "-s", away, *(["-x", size[0], "-y", size[1]] if len(size) == 2 else []),
         "printf '\\033[?25l\\n\\n   Dictating on your phone…\\n\\n   \\033[2mWhat you say goes to the phone; "
         "Claude is back here when you let go.\\033[0m\\n'; " + back)
    title = tmux("display-message", "-p", "-t", f"={name}:", "#{pane_title}").stdout.strip()
    if title:
        tmux("select-pane", "-t", f"={away}:", "-T", title)     # the window keeps its title
    for c in clients:
        tmux("switch-client", "-c", c, "-t", f"={away}")
    return away


def desk_show(s, away):
    """The other views back on the session's Claude (see desk_hide)."""
    if not away:
        return
    r = tmux("list-clients", "-t", f"={away}", "-F", "#{client_name}")
    for c in r.stdout.split() if r.returncode == 0 else []:
        tmux("switch-client", "-c", c, "-t", f"={tmux_name(s['id'])}")
    tmux("kill-session", "-t", f"={away}")


def close_listening(sock):
    """Close a socket that a thread waits on in accept(): shut down first, or
    Linux leaves it listening and that thread waiting, for good."""
    for stop in (lambda: sock.shutdown(socket.SHUT_RDWR), sock.close):
        try:
            stop()
        except OSError:
            pass


class AppMic:
    """One dictation from the phone: its audio as it comes, for the session's
    rec (amarchy rec) to read on a socket, from the start: what was said
    before Claude got its rec going too. Once the phone's audio ends, rec
    hears silence until Claude stops it (the key is up), as from a
    microphone: Claude writes down a last word only with some sound after
    it, and drops it when rec just ends."""

    def __init__(self, sid):
        self.path = mic_socket(sid)
        self.cond = threading.Condition()
        self.chunks, self.ended, self.stopped, self.readers, self.read = [], False, False, 0, False
        self.path.parent.mkdir(parents=True, exist_ok=True)
        os.chmod(self.path.parent, 0o700)
        self.path.unlink(missing_ok=True)
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.bind(str(self.path))
        self.sock.listen(2)
        threading.Thread(target=self.serve, daemon=True).start()

    def serve(self):
        while True:
            try:
                conn, _ = self.sock.accept()
            except OSError:         # closed: the dictation is over
                return
            with self.cond:
                self.readers += 1
                start = 0 if self.readers == 1 else len(self.chunks)    # a second rec: from now on
            threading.Thread(target=self.feed, args=(conn, start), daemon=True).start()

    def feed(self, conn, i):
        try:
            while True:
                with self.cond:
                    self.cond.wait_for(lambda: i < len(self.chunks) or self.ended or self.stopped)
                    new = self.chunks[i:]
                    i += len(new)
                    if not new and self.stopped:
                        break
                    if not new:         # all of it read: silence now, as it comes
                        self.read = True
                        self.cond.notify_all()
                if new:
                    conn.sendall(b"".join(new))
                else:
                    conn.sendall(MIC_HUSH)
                    time.sleep(len(MIC_HUSH) / 32000)
        except OSError:         # Claude stopped rec
            pass
        finally:
            conn.close()        # the end of its input: rec ends, having passed on all of it
            with self.cond:
                self.read = True
                self.cond.notify_all()

    def add(self, data):
        with self.cond:
            self.chunks.append(data)
            self.cond.notify_all()

    def end(self, wait=3.0):
        """No more audio; wait until a rec has read all of it (or none came).
        Whether one did."""
        with self.cond:
            self.ended = True
            self.cond.notify_all()
            self.cond.wait_for(lambda: self.read, timeout=wait)
            return self.readers > 0

    def stop(self):
        """Not even silence: a rec still reading ends."""
        with self.cond:
            self.ended = self.stopped = True
            self.cond.notify_all()

    def close(self):
        self.stop()
        close_listening(self.sock)
        self.path.unlink(missing_ok=True)


# ---- dictation on the host: speech to text, without Claude
#
# The app's mic button writes what you say into the box you're typing in (a
# session's, the new-session bar's) without Claude Code's voice mode, which
# only a session's terminal Claude has (see "dictation from the phone"). The
# phone's or the browser's microphone, 16 kHz 16-bit mono as for that
# (voice.js), is written down here, by NVIDIA's Parakeet TDT 0.6B v3 through
# whisper.cpp's libparakeet (Arch: the whisper-cpp package). It knows 25
# European languages, Spanish and English among them, and tells them apart
# by itself; on the CPU it writes ~10 seconds of speech in one. Free, and
# the audio never leaves this machine.
#
# The model (670 MB) is fetched once (amarchy dictation setup, or Settings in
# the app) into the state. A worker (amarchy dictation worker) keeps it loaded
# while dictations come, and exits DICTATE_KEEP after the last one. What's
# said is cut at its pauses as it comes, and each piece written down while
# the next is said: the words come up as you talk, and letting go leaves only
# the last piece to do.

DICTATE = STATE / "dictation"
DICTATE_MODEL = {
    "name": "Parakeet TDT 0.6B v3",
    "file": "parakeet-tdt-0.6b-v3-q8_0.bin",
    "url": "https://huggingface.co/ggml-org/parakeet-GGUF/resolve/main/ggml-parakeet-tdt-0.6b-v3-q8_0.bin",
    "size": 668757119,
    "sha256": "4d64e9e96c2792186d072fde0034df0ad670cf680a2f53069052ead827fd600e",
}
DICTATE_LIB = "libparakeet.so.1"            # whisper.cpp 1.9 or newer
DICTATE_SETUP = DICTATE / "setup.json"      # a download under way: how far, or why it stopped
DICTATE_LOG = DICTATE / "log.jsonl"         # the last dictations: how they went (amarchy dictation log)
DICTATE_LOG_KEEP = 500                      # lines of it kept
DICTATE_KEEP = 600          # seconds the model stays loaded after the last dictation
DICTATE_LOAD = 30           # seconds loading it may take
DICTATE_PIECE_TIME = 60     # seconds writing one piece down may take
DICTATE_RATE = 16000
DICTATE_FRAME = 640         # bytes: 20 ms
DICTATE_LOUD = 150          # RMS (of 32768) under which a frame is silence, whatever the room
DICTATE_PAUSE = 30          # frames of silence that end a piece: 0.6 s
DICTATE_SHORTEST = 75       # frames of a piece before a pause ends it: 1.5 s
DICTATE_PIECE_MOST = 300    # frames a piece is at most: 6 s
DICTATE_STRETCH = 1000      # frames of a long stretch before a pause ends it: 20 s
DICTATE_STRETCH_MOST = 1500 # frames a long stretch is at most: 30 s, cut at its quietest moment near the end
DICTATE_WORDS = 5           # frames of sound worth writing down: 0.1 s
DICTATE_BREAK = 50          # frames of silence that end a long stretch of 3 s or more too: 1 s, where
                            # you'd go on in another language (it writes one at a time down)


def dictate_mb():
    """The model's size, in MB as people round it."""
    return -(-DICTATE_MODEL["size"] // 10_000_000) * 10


def dictate_model_path():
    return DICTATE / DICTATE_MODEL["file"]


_dictate_lib = {"at": 0, "found": None}


def dictate_lib():
    """The library that writes speech down (libparakeet), or None. Looked
    for again a minute later (installed meanwhile)."""
    if time.time() - _dictate_lib["at"] > 60:
        import ctypes.util
        found = None
        for d in ("/usr/lib", "/usr/local/lib", "/usr/lib64", "/usr/lib/x86_64-linux-gnu", "/usr/lib/aarch64-linux-gnu"):
            if Path(d, DICTATE_LIB).exists():
                found = str(Path(d, DICTATE_LIB))
                break
        _dictate_lib.update(at=time.time(), found=found or ctypes.util.find_library("parakeet"))
    return _dictate_lib["found"]


def dictate_status():
    """Whether the host can write dictations down, and if not why: the
    library, the model, or the model's download under way."""
    lib, model = bool(dictate_lib()), dictate_model_path().is_file()
    setup = None
    try:
        setup = json.loads(DICTATE_SETUP.read_text())
        if not isinstance(setup, dict):
            setup = None
        elif setup.get("pid") and not setup.get("error") and not pid_alive(setup["pid"]):
            setup = {**setup, "error": "the download stopped"}
    except (OSError, ValueError):
        pass
    return {"ready": lib and model, "lib": lib, "model": model, "engine": DICTATE_MODEL["name"],
            "size": DICTATE_MODEL["size"], "setup": None if model else setup}


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def dictate_how():
    """What to do so the host can write dictations down, in a line."""
    if not dictate_lib():
        return ("install whisper.cpp 1.9 or newer, with its libparakeet (Arch: sudo pacman -S whisper-cpp), "
                "then amarchy dictation setup")
    return f"amarchy dictation setup (fetches {DICTATE_MODEL['name']}, {dictate_mb()} MB)"


def dictate_setup(quiet=False):
    """Fetch the model (again from where it stopped, if it did), check it,
    and put it in place. How far it got goes to DICTATE_SETUP for the app."""
    import urllib.request
    DICTATE.mkdir(parents=True, exist_ok=True)
    final, part = dictate_model_path(), DICTATE / (DICTATE_MODEL["file"] + ".part")
    size = DICTATE_MODEL["size"]

    def note(**kw):
        write_file(DICTATE_SETUP, json.dumps({"pid": os.getpid(), "size": size, **kw}) + "\n")

    if final.is_file():
        DICTATE_SETUP.unlink(missing_ok=True)
        return None
    # One download at a time (the app's button and a terminal, say).
    lock = open(DICTATE / "setup.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return "a download is already under way (amarchy dictation shows how far)"
    try:
        have = part.stat().st_size if part.exists() else 0
        if have > size:
            part.unlink()
            have = 0
        note(done=have)
        if have < size:
            req = urllib.request.Request(DICTATE_MODEL["url"], headers={"User-Agent": "amarchy",
                                                                        **({"Range": f"bytes={have}-"} if have else {})})
            with urllib.request.urlopen(req, timeout=60) as r:
                if have and r.status != 206:      # it can't go on from there: from the start
                    have = 0
                with open(part, "ab" if have else "wb") as f:
                    shown, last = -1, 0
                    while True:
                        chunk = r.read(1 << 20)
                        if not chunk:
                            break
                        f.write(chunk)
                        have += len(chunk)
                        if time.time() - last > 0.5:
                            last = time.time()
                            note(done=have)
                            pct = have * 100 // size
                            if not quiet and pct != shown and sys.stderr.isatty():
                                shown = pct
                                print(f"\r  {have // 1_000_000} of {size // 1_000_000} MB ({pct}%)", end="",
                                      file=sys.stderr, flush=True)
            if not quiet and sys.stderr.isatty():
                print(file=sys.stderr)
        note(done=have, checking=True)
        digest = hashlib.sha256()
        with open(part, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                digest.update(chunk)
        if have != size or digest.hexdigest() != DICTATE_MODEL["sha256"]:
            part.unlink(missing_ok=True)
            raise OSError("what came isn't the model (a broken download?): try again")
        part.rename(final)
        DICTATE_SETUP.unlink(missing_ok=True)
        (DICTATE / "setup.lock").unlink(missing_ok=True)
        return None
    except (OSError, ValueError) as e:
        why = str(getattr(e, "reason", None) or e)
        note(done=part.stat().st_size if part.exists() else 0, error=why)
        return why
    finally:
        lock.close()


def dictate_worker():
    """amarchy dictation worker: load the model and write down what comes on
    stdin, one piece at a time: its length (4 bytes, little-endian), then
    that much audio (16 kHz 16-bit mono). Each answer is a line of JSON on
    stdout ({"text"} or {"error"}), the first one once the model is loaded."""
    import array
    import ctypes as C
    out = sys.stdout

    def say(**d):
        out.write(json.dumps(d) + "\n")
        out.flush()

    lib_path, model = dictate_lib(), dictate_model_path()
    if not lib_path or not model.is_file():
        say(error=f"not set up: {dictate_how()}")
        return 1

    class ContextParams(C.Structure):
        _fields_ = [("use_gpu", C.c_bool), ("gpu_device", C.c_int)]

    class FullParams(C.Structure):      # parakeet_full_params (parakeet.h)
        _fields_ = [("strategy", C.c_int), ("n_threads", C.c_int), ("offset_ms", C.c_int), ("duration_ms", C.c_int),
                    ("no_context", C.c_bool), ("audio_ctx", C.c_int)] + \
                   [(n, C.c_void_p) for n in ("segment_cb", "segment_data", "token_cb", "token_data", "progress_cb",
                                              "progress_data", "encoder_cb", "encoder_data", "abort_cb", "abort_data")]

    started = time.time()
    try:
        # ggml finds its CPU code (the variant for this processor) only when asked to.
        ggml = C.CDLL(str(Path(lib_path).with_name("libggml.so")) if Path(lib_path).with_name("libggml.so").exists()
                      else "libggml.so", mode=C.RTLD_GLOBAL)
        ggml.ggml_backend_load_all()
        lib = C.CDLL(lib_path)
    except OSError as e:
        say(error=f"couldn't load whisper.cpp's libparakeet: {e}")
        return 1
    log = C.CFUNCTYPE(None, C.c_int, C.c_char_p, C.c_void_p)(lambda *a: None)     # its chatter, unsaid
    lib.parakeet_log_set(log, None)
    lib.parakeet_context_default_params.restype = ContextParams
    lib.parakeet_init_from_file_with_params.restype = C.c_void_p
    lib.parakeet_init_from_file_with_params.argtypes = [C.c_char_p, ContextParams]
    lib.parakeet_full_default_params.restype = FullParams
    lib.parakeet_full_default_params.argtypes = [C.c_int]
    lib.parakeet_full.argtypes = [C.c_void_p, FullParams, C.POINTER(C.c_float), C.c_int]
    lib.parakeet_full_n_segments.argtypes = [C.c_void_p]
    lib.parakeet_full_get_segment_text.argtypes = [C.c_void_p, C.c_int]
    lib.parakeet_full_get_segment_text.restype = C.c_char_p
    params = lib.parakeet_context_default_params()
    params.use_gpu = False
    ctx = lib.parakeet_init_from_file_with_params(str(model).encode(), params)
    if not ctx:
        say(error="the model didn't load (a broken download? amarchy dictation remove, then setup)")
        return 1
    threads = max(2, min(8, (os.cpu_count() or 4) // 2))
    say(ready=True, ms=int((time.time() - started) * 1000))
    stdin = sys.stdin.buffer
    while True:
        head = stdin.read(4)
        if len(head) < 4:
            return 0
        n = int.from_bytes(head, "little")
        data = stdin.read(n)
        if len(data) < n:
            return 0
        pcm = array.array("h")
        pcm.frombytes(data[:len(data) // 2 * 2])
        # At least a second (with silence after): a word alone is too short for it.
        pcm.extend([0] * max(0, DICTATE_RATE - len(pcm)))
        samples = (C.c_float * len(pcm)).from_buffer(array.array("f", (x / 32768 for x in pcm)))
        full = lib.parakeet_full_default_params(0)
        full.n_threads = threads
        t = time.time()
        if lib.parakeet_full(ctx, full, samples, len(pcm)) != 0:
            say(error="it couldn't write that down")
            continue
        text = "".join((lib.parakeet_full_get_segment_text(ctx, i) or b"").decode("utf-8", "replace")
                       for i in range(lib.parakeet_full_n_segments(ctx)))
        say(text=" ".join(text.split()), ms=int((time.time() - t) * 1000))


class Transcriber:
    """The worker (amarchy dictation worker), for the app's server: started
    when a dictation starts (the model loads while you speak), one piece at
    a time, and let go of DICTATE_KEEP after the last one."""

    def __init__(self):
        self.lock = threading.Lock()
        self.proc, self.used = None, 0.0
        threading.Thread(target=self.reap, daemon=True).start()

    def line(self, proc, timeout):
        """The worker's next answer, or None when it has none in time (or died)."""
        end = time.time() + timeout
        while time.time() < end:
            r, _, _ = select.select([proc.stdout], [], [], min(1.0, max(0.0, end - time.time())))
            if r:
                raw = proc.stdout.readline()
                if not raw:
                    return None
                try:
                    d = json.loads(raw)
                    return d if isinstance(d, dict) else None
                except ValueError:
                    continue
            if proc.poll() is not None:
                return None
        return None

    def start(self):
        """The worker, loaded (call with the lock held). Why not, else."""
        if self.proc and self.proc.poll() is None:
            return None
        try:
            self.proc = subprocess.Popen([sys.executable, SELF, "dictation", "worker"], stdin=subprocess.PIPE,
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=clean_env())
        except OSError as e:
            self.proc = None
            return str(e)
        d = self.line(self.proc, DICTATE_LOAD)
        if not d or not d.get("ready"):
            self.stop()
            return (d or {}).get("error") or "the model didn't load in time"
        self.used = time.time()
        return None

    def stop(self):
        proc, self.proc = self.proc, None
        if proc:
            try:
                proc.stdin.close()
                proc.wait(3)
            except (OSError, subprocess.TimeoutExpired):
                proc.kill()

    def warm(self):
        """Load the model now, in the background: a dictation is starting."""
        def load():
            with self.lock:
                self.start()
                self.used = time.time()
        threading.Thread(target=load, daemon=True).start()

    def write_down(self, pcm):
        """What a piece of audio says, or raises OSError with why not."""
        with self.lock:
            why = self.start()
            if why:
                raise OSError(why)
            try:
                self.proc.stdin.write(len(pcm).to_bytes(4, "little") + pcm)
                self.proc.stdin.flush()
            except OSError:
                self.stop()
                raise OSError("the dictation worker stopped")
            d = self.line(self.proc, DICTATE_PIECE_TIME)
            self.used = time.time()
            if d is None:       # hung or gone: the next piece starts it anew
                self.stop()
                raise OSError("writing it down took too long")
            if d.get("error"):
                raise OSError(d["error"])
            return d.get("text") or ""

    def reap(self):
        while True:
            time.sleep(15)
            gone = not dictate_model_path().is_file()       # amarchy dictation remove
            if self.proc and (gone or time.time() - self.used > DICTATE_KEEP) and self.lock.acquire(blocking=False):
                try:
                    self.stop()
                finally:
                    self.lock.release()


def frame_rms(frame):
    import array
    a = array.array("h")
    a.frombytes(frame)
    return (sum(x * x for x in a) / max(1, len(a))) ** 0.5


class Dictation:
    """One dictation: the audio as it comes, written down twice over. Short
    pieces, cut at every pause, show the words as you talk (heard(text) gets
    everything so far, each time there's more); what's kept is written from
    long stretches (20 to 30 s, cut at a pause, or at a longer pause after
    3 s, where a new language may start) with their context, as accurate as
    all of it at once: each long one written while
    the next is said, so letting go leaves at most one to do. heard None:
    no pieces, only what's kept."""

    def __init__(self, transcriber, heard):
        self.tr, self.heard = transcriber, heard
        self.audio, self.frames = bytearray(), 0
        self.voiced = []            # per frame: sound or silence
        self.levels = []            # the last 3 seconds' loudness, for the room's own noise
        self.piece, self.stretch = 0, 0     # where the piece and the long stretch under way start (frames)
        self.quiet = 0              # frames of silence at the end, so far
        self.kept = []              # (start, end, text) of the long stretches written down
        self.shown = {}             # start -> text of the pieces written down
        self.jobs, self.busy, self.errors = [], 0, []
        self.cond = threading.Condition()
        self.closed = False
        self.loud = False           # heard anything at all
        self.pieces = 0
        threading.Thread(target=self.work, daemon=True).start()

    def add(self, data):
        self.audio += data
        while (self.frames + 1) * DICTATE_FRAME <= len(self.audio):
            level = frame_rms(self.audio[self.frames * DICTATE_FRAME:(self.frames + 1) * DICTATE_FRAME])
            self.levels = (self.levels + [level])[-150:]
            floor = sorted(self.levels)[len(self.levels) // 10]
            loud = level > max(DICTATE_LOUD, floor * 2.5)
            self.loud = self.loud or loud
            self.voiced.append(loud)
            self.frames += 1
            self.quiet = 0 if loud else self.quiet + 1
            pause = self.quiet
            if (self.frames - self.stretch >= DICTATE_STRETCH and pause >= DICTATE_PAUSE
                    or self.frames - pause - self.stretch >= DICTATE_SHORTEST * 2 and pause >= DICTATE_BREAK):
                self.job("stretch", self.stretch, self.frames - pause // 2)
            elif self.frames - self.stretch >= DICTATE_STRETCH_MOST:
                # No pause for a long while: at the quietest moment of the last 3 s.
                lv = self.levels
                self.job("stretch", self.stretch, self.frames - len(lv) + lv.index(min(lv)) + 1)
            elif self.heard and pause >= DICTATE_PAUSE and self.frames - pause - self.piece >= DICTATE_SHORTEST:
                self.job("piece", self.piece, self.frames - pause + 10)        # keeping 0.2 s of the pause
            elif self.heard and self.frames - self.piece >= DICTATE_PIECE_MOST:
                # Talking on without a pause: the words so far all the same, cut at the
                # quietest moment of the last second (what's kept is written anew anyway).
                lv = self.levels[-50:]
                self.job("piece", self.piece, self.frames - len(lv) + lv.index(min(lv)) + 1)

    def job(self, kind, start, end):
        """Write audio from frame start to end down (if there's sound in it)."""
        end = max(start, min(end, self.frames))
        if kind == "stretch":
            self.stretch = self.piece = end
        else:
            self.piece = end
        if sum(self.voiced[start:end]) < DICTATE_WORDS:
            return
        audio = bytes(self.audio[start * DICTATE_FRAME:end * DICTATE_FRAME])
        with self.cond:
            if kind == "stretch":       # first: they're what's kept
                self.jobs.insert(sum(1 for j in self.jobs if j[0] == "stretch"), (kind, start, end, audio))
            else:
                self.pieces += 1
                self.jobs.append((kind, start, end, audio))
            self.cond.notify_all()

    def words(self):
        """All of it so far: the long stretches kept, then the pieces after them."""
        kept = sorted(self.kept)
        after = kept[-1][1] if kept else 0
        return " ".join([k[2] for k in kept] + [w for s, w in sorted(self.shown.items()) if s >= after and w])

    def work(self):
        while True:
            with self.cond:
                self.cond.wait_for(lambda: self.jobs or self.closed)
                if not self.jobs:
                    return
                kind, start, end, audio = self.jobs.pop(0)
                self.busy += 1
            try:
                text = self.tr.write_down(audio)
            except OSError as e:
                text = None
                self.errors.append(str(e))
            with self.cond:
                self.busy -= 1
                if text is not None:
                    if kind == "stretch":
                        self.kept.append((start, end, text))
                    else:
                        self.shown[start] = text
                words = None if self.closed else self.words()
                self.cond.notify_all()
            if words:
                try:
                    self.heard(words)
                except OSError:
                    pass

    def finish(self, timeout=120):
        """No more audio: the rest written down, and all of it. Raises
        OSError when nothing came of it because writing it down failed."""
        with self.cond:
            self.jobs = [j for j in self.jobs if j[0] == "stretch"]     # the pieces aren't needed now
        self.job("stretch", self.stretch, self.frames)
        with self.cond:
            self.closed = True      # after the last job is in: the worker stops once they're done
            self.cond.notify_all()
            self.cond.wait_for(lambda: not self.jobs and not self.busy, timeout=timeout)
            text = " ".join(k[2] for k in sorted(self.kept) if k[2])
        if not text and self.errors:
            raise OSError(self.errors[-1])
        return text

    def drop(self):
        with self.cond:
            self.jobs.clear()
            self.closed = True
            self.cond.notify_all()


def dictate_log(entry):
    """A dictation, how it went, at the end of DICTATE_LOG (its last
    DICTATE_LOG_KEEP lines kept)."""
    try:
        DICTATE.mkdir(parents=True, exist_ok=True)
        lines = DICTATE_LOG.read_text().splitlines() if DICTATE_LOG.exists() else []
        lines = (lines + [json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **entry}, ensure_ascii=False)])
        write_file(DICTATE_LOG, "\n".join(lines[-DICTATE_LOG_KEEP:]) + "\n")
    except OSError:
        pass


def device_name(ua, standalone=False):
    """The device and browser a User-Agent is, in a few words."""
    ua = ua or ""
    dev = ("iPhone" if "iPhone" in ua else "iPad" if "iPad" in ua else "Android" if "Android" in ua
           else "Mac" if "Macintosh" in ua else "Windows" if "Windows" in ua else "Linux" if "Linux" in ua else "?")
    app = ("Chrome" if re.search(r"Chrome/|CriOS/", ua) and "Edg" not in ua else "Edge" if "Edg" in ua
           else "Firefox" if re.search(r"Firefox/|FxiOS/", ua) else "Safari" if "Safari/" in ua or "AppleWebKit" in ua
           else "?")
    return f"{dev} {'home-screen app' if standalone else app}"


def cmd_dictation(args):
    """amarchy dictation [--status] | setup | remove | log [--json] | transcribe <file> | worker"""
    what = args[0] if args and not args[0].startswith("--") else ""
    if what == "worker":
        return dictate_worker()
    if what == "setup":
        if not dictate_lib():
            return fail(f"whisper.cpp isn't installed: {dictate_how()}")
        if dictate_model_path().is_file():
            print(f"Dictation is set up: {DICTATE_MODEL['name']}, in {dictate_model_path()}.")
            return 0
        print(f"Fetching {DICTATE_MODEL['name']} ({dictate_mb()} MB) into {DICTATE}…",
              file=sys.stderr)
        why = dictate_setup()
        if why:
            return fail(f"dictation isn't set up: {why}")
        print("Dictation is set up: hold the mic in the app and speak (English, Spanish and 23 more).")
        return 0
    if what == "remove":
        for f in (dictate_model_path(), DICTATE / (DICTATE_MODEL["file"] + ".part"), DICTATE_SETUP):
            f.unlink(missing_ok=True)
        print("Removed the dictation model (amarchy dictation setup fetches it again).")
        return 0
    if what == "log":
        try:
            lines = DICTATE_LOG.read_text().splitlines()
        except OSError:
            lines = []
        entries = []
        for line in lines:
            try:
                entries.append(json.loads(line))
            except ValueError:
                pass
        if "--json" in args:
            print(json.dumps(entries, indent=2, ensure_ascii=False))
            return 0
        if not entries:
            print("No dictations yet.")
        for e in entries:
            took = f"{e['wait_ms'] / 1000:.1f}s after letting go" if isinstance(e.get("wait_ms"), (int, float)) else ""
            said = f"{e['said_s']:.0f}s said" if isinstance(e.get("said_s"), (int, float)) else ""
            head = " · ".join(x for x in (e.get("at", "")[:16].replace("T", " "), e.get("engine", ""), e.get("device", ""),
                                          e.get("lang", ""), said, took) if x)
            print(f"{head}\n  {e['error'] if e.get('error') else e.get('text', '')}")
        return 0
    if what == "transcribe":
        if len(args) != 2:
            print(usage("dictation"), file=sys.stderr)
            return 1
        if not dictate_status()["ready"]:
            return fail(f"dictation isn't set up: {dictate_how()}")
        r = subprocess.run(["ffmpeg", "-loglevel", "error", "-i", args[1], "-f", "s16le", "-ac", "1",
                            "-ar", str(DICTATE_RATE), "-"], capture_output=True)
        if r.returncode != 0:
            return fail(r.stderr.decode(errors="replace").strip() or "ffmpeg couldn't read it")
        tr = Transcriber()
        d = Dictation(tr, None)        # no words as they come: only what's kept
        started = time.time()
        for i in range(0, len(r.stdout), DICTATE_FRAME):
            d.add(r.stdout[i:i + DICTATE_FRAME])
        try:
            text = d.finish()
        except OSError as e:
            return fail(str(e))
        finally:
            tr.stop()
        print(text)
        print(f"({len(r.stdout) / 2 / DICTATE_RATE:.1f} s of audio, "
              f"{time.time() - started:.1f} s with loading the model)", file=sys.stderr)
        return 0
    if what:
        print(usage("dictation"), file=sys.stderr)
        return 1
    s = dictate_status()
    if s["ready"]:
        print(f"Dictation is set up: {s['engine']}, on this machine (the app's mic button).")
    elif s["setup"] and not s["setup"].get("error"):
        print(f"Fetching {s['engine']}: {s['setup'].get('done', 0) // 1_000_000} of {s['size'] // 1_000_000} MB.")
    else:
        why = f" ({s['setup']['error']})" if s["setup"] else ""
        print(f"Dictation isn't set up{why}: {dictate_how()}")
        print("Until it is, the app's mic uses the browser's own speech recognition where it has it, "
              "else Claude Code's voice mode.")
    return 0


# ---- the app in a browser on your computer (its wide layout, desk.js)
#
# On a wide screen the app is the list, and beside it the session's real
# terminals, Claude's and the one it runs the project in. Each is xterm.js in
# the page, on a WebSocket to the app's server (Handler.tty), which runs
# `amarchy attach` on a pty of its own: a tmux client of the session's tmux,
# so the phone and every browser show the same session at once.
#
# Two things a server doesn't have come from the browser instead. A pasted
# image: the page hands the app what was pasted in it (the web clipboard, see
# "clipboard") before it sends Ctrl+V, and Claude's wl-paste (amarchy paste)
# reads it there. And the microphone: Claude's voice mode records with rec
# (amarchy rec), which, while the page shows that session's Claude with the
# keyboard in it, is the browser's microphone (DeskMic), as dictating from
# the phone is.


CLIP_MAX = 25_000_000                           # bytes of one pasted image or text (as base64 in its JSON)
CLIP_TYPES = re.compile(r"image/(png|jpeg|gif|webp)")
TTY_PING = 25                                   # seconds between pings on a terminal's WebSocket
MIC_EARLY = 96_000                              # bytes of audio kept from before rec is there: 3 seconds
DESK_MIC_QUIET = 20                             # seconds a page's microphone may say nothing before it counts as gone


class DeskMic:
    """The microphone of a browser showing a session's Claude, for Claude's
    voice mode: while the page has the keyboard, the session's rec is this.
    When Claude starts recording, the page is told to turn its microphone on
    (tell(True)), and its audio goes to rec as it comes, after what it heard
    just before (the page opens it as soon as the key is held); when Claude
    is done with rec, the page turns it off (tell(False))."""

    def __init__(self, sid, tell):
        self.sid, self.tell = sid, tell
        self.path = mic_socket(sid)
        self.lock = threading.Lock()
        self.recs, self.sock, self.early = [], None, []
        self.wanted = True      # the page has the keyboard in Claude
        self.resume()

    def resume(self):
        """Be the session's rec (again)."""
        with self.lock:
            if self.sock:
                return
            self.path.parent.mkdir(parents=True, exist_ok=True)
            os.chmod(self.path.parent, 0o700)
            self.path.unlink(missing_ok=True)
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                sock.bind(str(self.path))
                sock.listen(4)
            except OSError as e:
                sock.close()
                print(f"amarchy app: no microphone for {self.sid}: {e}", file=sys.stderr)
                return
            self.sock = sock
        threading.Thread(target=self.serve, args=(sock,), daemon=True).start()

    def suspend(self):
        """Stop being it: the page lost the keyboard, a phone dictates, or it's gone."""
        with self.lock:
            sock, self.sock = self.sock, None
            recs, self.recs, self.early = self.recs, [], []
        if sock:
            close_listening(sock)
            self.path.unlink(missing_ok=True)
        for c in recs:
            c.close()
        if recs:
            self.tell(False)

    def serve(self, sock):
        while True:
            try:
                conn, _ = sock.accept()
            except OSError:         # suspended
                return
            with self.lock:
                if self.sock is not sock:
                    conn.close()
                    return
                first, early, self.early = not self.recs, self.early, []
                self.recs.append(conn)
            try:
                conn.sendall(b"".join(early))
            except OSError:
                pass
            if first:
                self.tell(True)
            threading.Thread(target=self.watch, args=(conn,), daemon=True).start()

    def watch(self, conn):
        """Until that rec is done with it (it only reads)."""
        try:
            while conn.recv(4096):
                pass
        except OSError:
            pass
        with self.lock:
            mine = conn in self.recs
            if mine:
                self.recs.remove(conn)
            last = mine and not self.recs
        conn.close()
        if last:
            self.tell(False)

    def feed(self, data):
        """Audio from the page: to rec, or kept until rec comes (the start of what's said)."""
        with self.lock:
            recs = list(self.recs)
            if not recs:
                self.early.append(data)
                while sum(map(len, self.early)) > MIC_EARLY:
                    self.early.pop(0)
        for c in recs:
            try:
                c.sendall(data)
            except OSError:
                pass

    def forget(self):
        """What was heard while no rec came: not for the next one."""
        with self.lock:
            self.early = []


def peer_uid(sock):
    """Who's at the other end of a connection to the app's server on
    localhost: the uid owning that socket (from /proc/net/tcp), or None."""
    try:
        port = sock.getpeername()[1]
        mine = sock.getsockname()[1]
        for table in ("/proc/net/tcp", "/proc/net/tcp6"):
            try:
                lines = Path(table).read_text().splitlines()[1:]
            except OSError:
                continue
            for line in lines:
                f = line.split()
                if int(f[1].rsplit(":", 1)[1], 16) == port and int(f[2].rsplit(":", 1)[1], 16) == mine:
                    return int(f[7])
    except (OSError, ValueError, IndexError):
        pass
    return None


def tailscale_uids():
    """Whom the app takes connections from: tailscaled (tailscale serve
    is it), which runs as root, or as whoever runs it; and you."""
    uids = {0, os.getuid()}
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                if (d / "comm").read_text().strip() == "tailscaled":
                    uids.add(d.stat().st_uid)
            except OSError:
                pass
    return uids


def app_commands(s):
    """The project's saved commands, the run command first (as amarchy run --list)."""
    saved = {RUN_DEFAULT: run_command(s), **saved_commands(s["repo"])}
    return [{"name": k, "command": v} for k, v in saved.items() if v]


APP_SOUNDS = APP / "sounds"         # the sounds a browser can't play as they are (Ogg), as WAV
APP_SOUND_TYPES = {".wav": "audio/wav", ".mp3": "audio/mpeg", ".flac": "audio/flac"}
APP_SOUND_MAX = 5_000_000           # bytes of a sound of yours added from the app


def app_sound_file(name):
    """A sound as a browser plays it (Safari has no Ogg): (file, type), the
    Ogg ones made WAV once (kept by their hash), or None."""
    f = sound_file(name) if name != "off" else None
    if not f or not f.is_file():
        return None
    kind = APP_SOUND_TYPES.get(f.suffix.lower())
    if kind:
        return f, kind
    try:
        sig = hashlib.sha1(f.read_bytes()).hexdigest()[:16]
    except OSError:
        return None
    out = APP_SOUNDS / f"{sig}.wav"
    if not out.is_file():
        APP_SOUNDS.mkdir(parents=True, exist_ok=True)
        tmp = out.with_name(f".{out.name}.{os.getpid()}.{threading.get_ident()}")
        for argv in (["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", str(f), "-f", "wav", str(tmp)],
                     ["sox", str(f), "-t", "wav", str(tmp)]):
            if not shutil.which(argv[0]):
                continue
            try:
                if subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, timeout=30).returncode == 0:
                    os.replace(tmp, out)
                    break
            except (OSError, subprocess.TimeoutExpired):
                pass
        tmp.unlink(missing_ok=True)
    return (out, "audio/wav") if out.is_file() else None


def app_sounds():
    """Every sound to pick from in the app, and the two picked."""
    return {"sounds": [{"name": name, "label": sound_label(name), "mine": name not in CHIMES} for name in sounds()],
            "sound": sound_name(), "assistant_sound": assistant_sound_name()}


def app_add_sound(name, raw):
    """A sound of yours, from the app, into ~/.config/amarchy/sounds (as
    amarchy sound --add has you put it): its name, or (None, why not)."""
    name = re.sub(r"[^\w .()-]", "", name).strip(" .")[:60]
    ext = Path(name).suffix.lower()
    stem = Path(name).stem.strip() if ext in AUDIO else ""
    if not stem:
        return None, "a sound file: WAV, Ogg, Opus, FLAC or MP3"
    if not raw or len(raw) > APP_SOUND_MAX:
        return None, "a sound of 5 MB at most"
    USER_SOUNDS.mkdir(parents=True, exist_ok=True)
    for old in USER_SOUNDS.glob("*"):       # one file per name: a new one replaces it
        if old.stem.lower() == stem.lower() and old.suffix.lower() in AUDIO:
            old.unlink(missing_ok=True)
    write_file(USER_SOUNDS / f"{stem}{ext}", raw)
    return sound_key(stem), ""


def cmd_rec(args):
    """rec (SoX) for a session's Claude on a host: the phone's microphone while
    it holds its button on this session (see "dictation from the phone"),
    else the real rec. The phone's audio goes through sox, so it comes out as
    rec was asked for, effects and all."""
    sid, state = rec_session()
    if re.fullmatch(r"[\w][\w.-]{0,119}", sid) and "--version" not in args:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            conn.connect(str(mic_socket(sid, state)))
        except OSError:
            conn.close()
        else:
            return mic_record(conn, args)
    # Not one of amarchy's (another checkout's would hand it back).
    real = next((str(p) for d in os.environ.get("PATH", "").split(os.pathsep) if d.startswith("/")
                 for p in [Path(d) / "rec"] if p.is_file() and os.access(p, os.X_OK)
                 and p.resolve().name != "amarchy-rec"), None)
    if not real:
        print("rec (amarchy): SoX's rec isn't installed", file=sys.stderr)
        return 127
    os.execv(real, [real, *args])


def rec_session():
    """Which session's Claude runs this rec, and that session's amarchy state:
    from Claude's own environment, the process above, since Claude Code gives
    the programs it runs for itself (rec among them) none of its own."""
    pid = os.getpid()
    for _ in range(6):
        try:
            env = dict(v.split("=", 1) for v in Path(f"/proc/{pid}/environ").read_text(errors="replace").split("\0")
                       if "=" in v)
            pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
        if env.get("AMARCHY_SESSION"):
            home = env.get("XDG_STATE_HOME")
            return env["AMARCHY_SESSION"], Path(home) / "amarchy" if home else HOME / ".local/state/amarchy"
        if pid <= 1:
            break
    return "", STATE


def mic_record(conn, args):
    """rec's output from the phone's audio on conn: sox reads it where rec
    would read the microphone (rec's options first, then its output)."""
    import signal
    first, rest = [], list(args)
    while rest and (rest[0] in ("-q", "-S", "--no-show-progress", "--show-progress") or re.fullmatch(r"-V\d?", rest[0])
                    or rest[0] in ("--buffer", "--input-buffer") and len(rest) > 1):
        n = 2 if rest[0] in ("--buffer", "--input-buffer") else 1
        first, rest = first + rest[:n], rest[n:]
    try:
        sox = subprocess.Popen(["sox", *first, *MIC_FORMAT, "-", *rest], stdin=subprocess.PIPE, bufsize=0)
    except OSError as e:
        print(f"rec (amarchy): {e}", file=sys.stderr)
        return 127

    def stop(*_):           # Claude's done with it
        sox.terminate()
        os._exit(0)
    signal.signal(signal.SIGTERM, stop)
    try:
        while data := conn.recv(65536):
            sox.stdin.write(data)
    except OSError:
        pass
    try:
        sox.stdin.close()
    except OSError:
        pass
    return sox.wait()


# ---- the server

def app_build():
    """Which app pages this server has (a hash of its files): open pages
    that loaded others offer to reload once amarchy was updated."""
    h = hashlib.sha1()
    for f in sorted(APP_PAGES.rglob("*")):
        if f.is_file():
            h.update(f.relative_to(APP_PAGES).as_posix().encode() + b"\0")
            try:
                h.update(f.read_bytes())
            except OSError:
                pass
    return h.hexdigest()[:12]


class AppState:
    """What every connection shares: the list as last read, the moments it
    changed, and which sessions you're looking at on the phone."""

    def __init__(self):
        self.changed = threading.Condition()
        self.view, self.version, self.statuses = {}, 0, None
        self.seen = {}          # session id -> when the phone last said it's on screen
        self.mics = {}          # session id -> its dictation from the phone, while there is one (AppMic)
        self.desk_mics = {}     # session id -> the browser's microphone for its Claude (DeskMic)
        self.lock = threading.Lock()
        self.build = app_build()
        # Which sessions are open on a device (a phone's conversation, a
        # browser's terminals: id -> how many), and when each last was, for
        # the sleep timer (on_screen). What the last server knew of when stays.
        self.open, self.viewed, self.viewing_lock = {}, on_screen()[1], threading.Lock()
        self.save_viewing()

    def row(self, sid):
        return next((s for s in self.view.get("sessions", []) if s["id"] == sid), None)

    def looking(self, sid, on=None):
        """A device opened a session (on), left it (off), or says it's still
        looking at it (None)."""
        with self.viewing_lock:
            if on is not None:
                n = self.open.get(sid, 0) + (1 if on else -1)
                if n > 0:
                    self.open[sid] = n
                else:
                    self.open.pop(sid, None)
            self.viewed[sid] = time.time()
            self.save_viewing()

    def save_viewing(self):
        live = {s.get("id") for s in sessions()}
        self.viewed = {k: v for k, v in self.viewed.items() if k in live}
        try:
            write_file(APP_VIEWING, json.dumps({"pid": os.getpid(), "open": sorted(self.open), "at": self.viewed}))
        except OSError as e:
            print(f"amarchy app: couldn't write {APP_VIEWING}: {e}", file=sys.stderr)


def app_watch(st):
    """Read the list every second; on a change wake the streams, and tell the
    phones about a session that went on to need you or be done."""
    ps, projects_at = [], 0
    while True:
        try:
            if time.time() - projects_at > 10:
                ps, projects_at = [{"name": p["name"], "sessions": p.get("sessions", 0)} for p in projects()], time.time()
            ps = ordered_projects(ps)     # in your order, now: you may just have moved one
            ss = session_view()
            look = look_worn()
            # One finished while it was on your phone's screen: you've seen it.
            for s in ss:
                if s["unseen"] and time.time() - st.seen.get(s["id"], 0) < APP_SEEN:
                    mark_seen(s["id"])
                    s["unseen"] = False
            view = {"hostname": host_name(), "sessions": ss, "projects": ps, "group": list_groups(),
                    "sort": list_sort(), "look": look_stamp(look), "nerd": look["font"]["nerd"],
                    "voice": claude_voice()["enabled"], "voice_mode": claude_voice()["mode"], "sound": sound_name(),
                    "assistant_sound": assistant_sound_name(), "alerts": alerts(), "build": st.build,
                    "sleep_after": "off" if sleep_after() is None else sleep_after(),
                    "dictation": dictate_status()}
        except Exception as e:      # a half-written file, say: the next second will do
            print(f"amarchy app: couldn't read the sessions: {e}", file=sys.stderr)
            time.sleep(1)
            continue
        with st.changed:
            if view != st.view:
                st.view = view
                st.version += 1
                st.changed.notify_all()
        app_moments(st, ss)
        time.sleep(1)


def app_moments(st, ss):
    """Notify about each session that went on to need you or finished, as the
    hook marks it (cmd_hook): unless it's the one on your phone's screen."""
    now = {s["id"]: s["status"] for s in ss}
    was, st.statuses = st.statuses, now
    if was is None:
        return
    waiting = sum(1 for s in ss if s["status"] == "waiting")
    for s in ss:
        state, prev = s["status"], was.get(s["id"])
        kind = alert_kind(s, state, prev) if state != prev else None
        if not kind:
            continue
        if time.time() - st.seen.get(s["id"], 0) < APP_SEEN:
            continue
        where = app_where(s)
        body = "Needs you" if state == "waiting" else "Done"
        if state == "waiting":
            time.sleep(0.3)         # the question is on screen by now
            dialog = app_screen(s).get("dialog")
            if dialog and dialog["question"]:
                body += ": " + " · ".join(dialog["question"].splitlines()[-3:])[:300]
        if kind == "assistant":
            # Under its name and picture, what it said (a brief's first words).
            said = s.get("said") or last_said(s) if state == "idle" else ""
            payload = {"title": s.get("assistant_name") or "Your assistant", "body": said or body,
                       "tag": f"assistant-{s['id']}", "url": f"/#/s/{s['id']}", "waiting": waiting,
                       "icon": assistant_icon()}
        else:
            payload = {"title": s.get("task") or where, "body": f"{body}\n{where}" if s.get("task") else body,
                       "tag": s["id"], "url": f"/#/s/{s['id']}", "waiting": waiting}
        threading.Thread(target=push_all, args=(payload,), daemon=True).start()


def app_handler(st, users, address):
    import http.server
    trusted = tailscale_uids()

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "amarchy"
        sys_version = ""

        def log_message(self, fmt, *args):
            pass

        def log_error(self, fmt, *args):
            print("amarchy app: " + fmt % args, file=sys.stderr)

        def head(self, code, ctype, extra=(), cache="no-cache", nonce=None):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            # The dictation's and the terminals' WebSockets, to this host (not
            # every browser counts wss: as 'self').
            host = self.headers.get("Host", "")
            csp = APP_CSP.replace("connect-src 'self'", f"connect-src 'self' wss://{host}") \
                if re.fullmatch(r"[\w.-]+(:\d+)?", host) else APP_CSP
            # The terminals (xterm.js) style themselves: <style> elements the
            # page made (its nonce), and style attributes.
            if nonce:
                csp = csp.replace("style-src 'self'", f"style-src 'self' 'nonce-{nonce}'; style-src-attr 'unsafe-inline'")
            for k, v in (("Content-Security-Policy", csp), ("X-Content-Type-Options", "nosniff"),
                         ("Referrer-Policy", "no-referrer"), ("X-Frame-Options", "DENY"),
                         ("Cache-Control", cache), *extra):
                self.send_header(k, v)

        def send(self, code, body, ctype="application/json"):
            data = json.dumps(body).encode() if ctype == "application/json" else body
            self.head(code, ctype, [("Content-Length", str(len(data)))])
            self.end_headers()
            self.wfile.write(data)

        def error(self, code, why):
            self.send(code, {"error": why})

        def allowed(self, write=False):
            """Only you, through tailscale serve, at this machine's address;
            changes only from the app's own pages."""
            host = self.headers.get("Host", "")
            if self.headers.get("Tailscale-User-Login", "") not in users or host.split(":")[0] != address:
                self.error(403, "not yours")
                return False
            # Through tailscale serve: that header is Tailscale's, not another
            # user's on this machine who can reach localhost too.
            uid = peer_uid(self.connection)
            if uid not in trusted:
                trusted.update(tailscale_uids())        # tailscaled restarted as someone else?
            if uid not in trusted:
                self.error(403, "not through Tailscale")
                return False
            if write:
                site = self.headers.get("Sec-Fetch-Site")
                if (self.headers.get("Origin") != f"https://{host}" or (site and site != "same-origin")
                        or not self.headers.get("Content-Type", "").startswith("application/json")):
                    self.error(403, "only from the app")
                    return False
            return True

        def body(self, limit=200_000):
            try:
                n = int(self.headers.get("Content-Length") or 0)
                data = json.loads(self.rfile.read(n) if 0 < n <= limit else b"{}")
            except ValueError:
                data = None
            return data if isinstance(data, dict) else {}

        def session(self, sid):
            s = session(sid) if re.fullmatch(r"[\w][\w.-]{0,119}", sid) else None
            if not s or (CLOSING / f"{sid}.json").exists():
                self.error(404, "no such session")
                return None
            return s

        def voice(self, s):
            """Dictation from the phone into the session's Claude (see
            "dictation from the phone"): a WebSocket, the phone's audio in it
            (16 kHz, 16-bit, mono) while the button is held and "end" when it's
            let go. Back come {"state": "listening"}, then {"state":
            "transcribing"}, and the transcript ({"text"}, taken out of Claude's
            prompt for the phone's box) or why there's none ({"error"})."""
            sid = s["id"]
            voice = claude_voice()
            if not voice["enabled"]:
                return self.error(409, "Claude's voice mode is off: turn it on with /voice")
            # "wait": not yet (Claude is starting, or asking something), so
            # the phone asks again, what was said waiting for it.
            screen = app_screen(s)
            if screen["asleep"]:
                wake(s)
                return self.send(409, {"error": "Claude is waking up", "wait": True})
            if screen["waking"]:
                return self.send(409, {"error": "Claude is waking up", "wait": True})
            if screen["exited"]:
                return self.error(409, "Claude Code exited: start it again first")
            if not screen["live"]:
                return self.send(409, {"error": "Claude isn't running", "wait": True})
            if screen["dialog"]:
                return self.send(409, {"error": "Claude is asking you something: answer that first", "wait": True})
            if sid in st.mics:
                return self.error(409, "It's already listening")
            before = claude_prompt(s)
            if before is None:
                return self.send(409, {"error": "Claude's prompt isn't on screen", "wait": True})
            # Without the WebSocket, just whether it would listen (so the
            # phone can say why it didn't).
            if self.headers.get("Upgrade", "").lower() != "websocket":
                return self.send(200, {"ready": True})
            if not self.ws_check():
                return
            # A browser's microphone for this Claude (its wide layout) steps
            # aside meanwhile: what Claude records now is the phone.
            desk = st.desk_mics.get(sid)
            if desk:
                desk.suspend()
            mic = st.mics[sid] = AppMic(sid)
            pane = f"={tmux_name(sid)}:"
            started, said, loud, outcome = time.time(), 0, False, "cut off"
            holding, holder = threading.Event(), None
            away, watching, sending = None, threading.Event(), threading.Lock()
            self.ws_lock = sending

            wrote = [None]      # when Claude last wrote a word down

            def watch():        # the words as Claude writes them down, to the phone as they come
                last = before
                while watching.is_set():
                    now = claude_prompt(s)
                    now = now.rstrip(MIC_METER).rstrip() if now is not None else None
                    if now is not None and now != last:
                        last = now
                        wrote[0] = time.time()
                        try:
                            self.ws_send({"interim": now})
                        except OSError:
                            return
                    time.sleep(0.15)

            def hold():         # the space, held: as the key repeats
                end = time.time() + MIC_MAX
                while holding.is_set() and time.time() < end:
                    tmux("send-keys", "-t", pane, "Space")
                    time.sleep(MIC_REPEAT)
            try:
                self.ws_handshake()
                self.connection.settimeout(MIC_QUIET)      # a phone gone quiet has let go
                away = desk_hide(s)
                watching.set()
                threading.Thread(target=watch, daemon=True).start()
                if voice["mode"] == "tap":
                    tmux("send-keys", "-t", pane, "Space")
                else:
                    holding.set()
                    holder = threading.Thread(target=hold, daemon=True)
                    holder.start()
                self.ws_send({"state": "listening"})
                started = time.time()
                while time.time() - started < MIC_MAX:
                    try:
                        op, data = self.ws_recv()
                    except (OSError, ValueError):
                        break
                    if op in (None, 8) or op == 1 and data == b"end":
                        break
                    if op in (0, 2):
                        mic.add(data)
                        said += len(data)
                        loud = loud or bool(data.strip(b"\0"))
                    elif op == 9:
                        self.ws_send(data, op=10)
                # Let go: Claude gets all of it before it's told the key is up.
                # Said before Claude was up, it all came at once, and a key let
                # go at once is no dictation to Claude: held then until Claude
                # has caught up (no new words for a moment), or for as long as
                # what was said lasts.
                ahead = started + said / 32000
                while time.time() < ahead and not (wrote[0] and time.time() - wrote[0] > MIC_CAUGHT_UP):
                    time.sleep(0.1)
                came = mic.end()
                # Held a moment more once rec has all of it, rec hearing
                # silence: Claude writes down the last words before it's told
                # the key is up, and then stops rec itself.
                time.sleep(MIC_TAIL)
                holding.clear()
                if voice["mode"] == "tap":
                    tmux("send-keys", "-t", pane, "Space")
                elif holder:
                    holder.join()
                threading.Timer(MIC_LET_GO, mic.stop).start()
                if not came:
                    watching.clear()
                    # Claude never recorded (its voice mode is off after all):
                    # the spaces went into its prompt. As it was, then.
                    time.sleep(0.3)
                    clear_claude_prompt(s)
                    if before:
                        tmux("set-buffer", "-b", f"amarchy-mic-{sid}", "--", before)
                        tmux("paste-buffer", "-p", "-r", "-d", "-b", f"amarchy-mic-{sid}", "-t", pane)
                    outcome = "Claude didn't record"
                    self.ws_send({"error": "Claude didn't record: turn its voice mode on with /voice"})
                    return
                self.ws_send({"state": "transcribing"})
                text, quiet = None, None
                end = time.time() + 20
                while time.time() < end:
                    time.sleep(0.25)
                    r = tmux("capture-pane", "-p", "-t", pane)
                    busy = "processing…" in r.stdout or "listening…" in r.stdout
                    now = claude_prompt(s)
                    now = now.rstrip(MIC_METER).rstrip() if now is not None else None
                    if not busy and now is not None and now != before:
                        text = now
                        break
                    if busy:
                        quiet = None
                    elif quiet is None:
                        quiet = time.time()
                    elif time.time() - quiet > 2.5:     # done, and nothing came of it
                        break
                watching.clear()
                if not text:
                    # Nothing but 0 is a microphone that's dead, not a quiet room.
                    outcome = ("no words heard" if loud else "only silence from the phone" if said
                               else "no sound from the phone")
                    self.ws_send({"error": "No words heard" if loud else
                                  "The phone's microphone sent only silence: try again" if said else
                                  "No sound came from the phone"})
                    return
                outcome = f"{len(text)} characters"
                # Into the phone's box, to send from there; out of Claude's
                # once the phone says it has it (else it stays where it is).
                self.ws_send({"text": text})
                got = time.time() + MIC_QUIET
                while time.time() < got:
                    try:
                        op, data = self.ws_recv()
                    except (OSError, ValueError):
                        break
                    if op in (None, 8):
                        break
                    if op == 1 and data == b"got":
                        clear_claude_prompt(s)
                        break
            except OSError:
                pass
            finally:
                holding.clear()
                watching.clear()
                desk_show(s, away)
                mic.close()
                # In the journal, for when dictation goes wrong.
                print(f"amarchy app: dictation in {sid}: {said / 32000:.1f}s of audio"
                      f"{'' if loud or not said else ', all silent'}, read by {mic.readers} rec, {outcome}",
                      file=sys.stderr, flush=True)
                st.mics.pop(sid, None)
                if desk and desk.wanted:
                    desk.resume()
                try:
                    self.ws_send(b"", op=8)
                except OSError:
                    pass

        def ws_check(self):
            """Whether this is a WebSocket from one of the app's own pages (a
            page elsewhere can open one to it too: its Origin says whose it is).
            Else it says why not."""
            host = self.headers.get("Host", "")
            site = self.headers.get("Sec-Fetch-Site")
            if self.headers.get("Upgrade", "").lower() != "websocket":
                self.error(400, "a WebSocket")
                return False
            if self.headers.get("Origin") != f"https://{host}" or (site and site != "same-origin"):
                self.error(403, "only from the app")
                return False
            if self.headers.get("Sec-WebSocket-Version") != "13" or not self.headers.get("Sec-WebSocket-Key"):
                self.error(400, "a WebSocket")
                return False
            return True

        def ws_handshake(self):
            key = base64.b64encode(hashlib.sha1((self.headers["Sec-WebSocket-Key"]
                                                 + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
            self.protocol_version = "HTTP/1.1"     # a WebSocket's answer is HTTP/1.1, whatever the server's
            self.send_response(101)
            for k, v in (("Upgrade", "websocket"), ("Connection", "Upgrade"), ("Sec-WebSocket-Accept", key)):
                self.send_header(k, v)
            self.end_headers()
            self.wfile.flush()
            self.close_connection = True
            if not hasattr(self, "ws_lock"):
                self.ws_lock = threading.Lock()

        def tty(self, s, which, args):
            """A session's real terminal, Claude's or its own (which), for
            xterm.js in a browser: a WebSocket whose binary messages are what
            it shows (the pty's output) one way and the keys (its input) the
            other; text ones are JSON: {"resize": [cols, rows]} and {"mic":
            true|false} (whether the page has the keyboard, and so the
            microphone) from the page, {"mic": true|false} (turn it on or
            off) and {"exit": code} to it. On the pty, `amarchy attach`: it
            starts what isn't running, waits for a new worktree, says so when
            the session is gone, and is then tmux."""
            if not self.ws_check():
                return
            try:
                cols = min(max(int((args.get("cols") or ["80"])[0]), 2), 1000)
                rows = min(max(int((args.get("rows") or ["24"])[0]), 2), 500)
            except ValueError:
                return self.error(400, "its size")
            sid = s["id"]
            master, slave = os.openpty()
            fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
            env = {**clean_env(), "TERM": "xterm-256color", "COLORTERM": "truecolor"}
            env.pop("TMUX", None)
            try:
                proc = subprocess.Popen([sys.executable, SELF, "attach", sid, which], stdin=slave, stdout=slave,
                                        stderr=slave, env=env, cwd=HOME, start_new_session=True)
            except OSError as e:
                os.close(master)
                os.close(slave)
                return self.error(500, f"couldn't attach: {e}")
            os.close(slave)
            st.looking(sid, True)
            done, mic = threading.Event(), None

            def tell(on):
                try:
                    self.ws_send({"mic": on})
                except OSError:
                    pass

            def out():          # the terminal, as it draws, to the page
                try:
                    while True:
                        try:
                            data = os.read(master, 65536)
                        except OSError:         # attach has ended
                            break
                        if not data:
                            break
                        self.ws_send(data, op=2)
                    code = proc.wait()
                    self.ws_send({"exit": code})
                    self.ws_send(b"", op=8)
                except OSError:
                    pass
                finally:
                    done.set()
                    try:
                        self.connection.shutdown(socket.SHUT_RDWR)
                    except OSError:
                        pass

            def ping():         # a quiet terminal's connection stays open through the proxy
                while not done.wait(TTY_PING):
                    try:
                        self.ws_send(b"", op=9)
                    except OSError:
                        return
            try:
                self.ws_handshake()
                if which == "claude" and (args.get("mic") or [""])[0] == "1":
                    mic = DeskMic(sid, tell)
                    with st.lock:
                        old, st.desk_mics[sid] = st.desk_mics.get(sid), mic
                    if old:
                        old.suspend()
                    mic.wanted = (args.get("focus") or [""])[0] == "1"
                    if not mic.wanted or sid in st.mics:
                        mic.suspend()
                threading.Thread(target=out, daemon=True).start()
                threading.Thread(target=ping, daemon=True).start()
                while not done.is_set():
                    try:
                        op, data = self.ws_recv()
                    except (OSError, ValueError):
                        break
                    if op in (None, 8):
                        break
                    if op in (0, 2):
                        while data:
                            data = data[os.write(master, data):]
                    elif op == 1:
                        try:
                            msg = json.loads(data)
                        except ValueError:
                            continue
                        if not isinstance(msg, dict):
                            continue
                        size = msg.get("resize")
                        if isinstance(size, list) and len(size) == 2 and all(isinstance(n, int) for n in size):
                            fcntl.ioctl(master, termios.TIOCSWINSZ,
                                        struct.pack("HHHH", min(max(size[1], 2), 500), min(max(size[0], 2), 1000), 0, 0))
                        if mic and isinstance(msg.get("mic"), bool):
                            mic.wanted = msg["mic"]
                            if mic.wanted and sid not in st.mics:
                                mic.resume()
                            elif not mic.wanted:
                                mic.suspend()
                    elif op == 9:
                        self.ws_send(data, op=10)
            except OSError:
                pass
            finally:
                done.set()
                st.looking(sid, False)
                if mic:
                    mic.suspend()
                    with st.lock:
                        if st.desk_mics.get(sid) is mic:
                            del st.desk_mics[sid]
                try:
                    os.close(master)
                except OSError:
                    pass
                try:
                    proc.terminate()
                    proc.wait(3)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
                except OSError:
                    pass

        # ---- dictation on the host (see "dictation on the host")

        def dictate(self, args):
            """Dictation written down here, for any box in the app: a
            WebSocket, the audio in it (16 kHz, 16-bit, mono) while the mic is
            on and "end" when it's let go. Back come {"state": "listening"},
            {"interim"} (all of it written down so far) as you talk,
            {"state": "transcribing"} and then {"text"}, or {"error"}. Without
            the WebSocket: whether it's set up (dictate_status)."""
            status = dictate_status()
            if self.headers.get("Upgrade", "").lower() != "websocket":
                return self.send(200, {**status, "how": None if status["ready"] else dictate_how()})
            if not status["ready"]:
                return self.error(409, f"Dictation isn't set up on the host: {dictate_how()}")
            if not self.ws_check():
                return
            device = device_name(self.headers.get("User-Agent"), args.get("standalone", [""])[0] == "1")
            self.ws_lock = threading.Lock()     # the words as they come go out from another thread
            said, outcome, text, let_go = 0, "cut off", "", None
            st.transcriber.warm()       # the model loads while you speak

            def heard(words):
                self.ws_send({"interim": words})

            d = Dictation(st.transcriber, heard)
            try:
                self.ws_handshake()
                self.connection.settimeout(MIC_QUIET)      # gone quiet: let go
                self.ws_send({"state": "listening"})
                started, ended = time.time(), False
                while time.time() - started < MIC_MAX:
                    try:
                        op, data = self.ws_recv()
                    except (OSError, ValueError):
                        break
                    if op in (None, 8):
                        break
                    if op == 1 and data == b"end":
                        ended = True
                        break
                    if op in (0, 2):
                        d.add(data)
                        said += len(data)
                    elif op == 9:
                        self.ws_send(data, op=10)
                if not ended and not said:
                    return
                let_go = time.time()
                self.ws_send({"state": "transcribing"})
                try:
                    text = d.finish()
                except OSError as e:
                    outcome = str(e)
                    self.ws_send({"error": f"It couldn't be written down: {e}"})
                    return
                if text:
                    outcome = None
                    self.ws_send({"text": text})
                else:
                    outcome = "no words heard" if d.loud else "only silence from the microphone" if said else "no audio"
                    self.ws_send({"error": "No words heard" if d.loud else
                                  "The microphone gave only silence" if said else "No sound came from the microphone"})
            except OSError:
                pass
            finally:
                d.drop()
                dictate_log({"engine": "host", "device": device, "said_s": round(said / 32000, 1),
                             "wait_ms": int((time.time() - let_go) * 1000) if let_go else None,
                             "pieces": d.pieces, "text": text, **({"error": outcome} if outcome else {})})

        def dictate_logged(self, data):
            """How a dictation the browser wrote down itself (its own speech
            recognition) went, for amarchy dictation log."""
            def num(k, most):
                v = data.get(k)
                return round(min(float(v), most), 1) if isinstance(v, (int, float)) and v >= 0 else None
            lang = str(data.get("lang") or "")[:20]
            dictate_log({"engine": "device", "device": device_name(self.headers.get("User-Agent"), bool(data.get("standalone"))),
                         "lang": lang, "said_s": num("said_s", 3600), "wait_ms": num("wait_ms", 600000),
                         "text": str(data.get("text") or "")[:5000],
                         **({"error": str(data["error"])[:300]} if data.get("error") else {})})
            return self.send(200, {})

        def dictate_fetch(self):
            """Settings' "Set up dictation": the model's download, in the
            background (amarchy dictation setup); the list says how far."""
            status = dictate_status()
            if not status["lib"]:
                return self.error(409, f"whisper.cpp isn't installed on the host: {dictate_how()}")
            if not status["model"] and not (status["setup"] and not status["setup"].get("error")):
                try:
                    detach([sys.executable, SELF, "dictation", "setup"])
                except OSError as e:
                    return self.error(500, str(e))
            return self.send(200, {})

        def desk_mic(self, s):
            """The browser's microphone while Claude records from it (see
            DeskMic): a WebSocket of its audio, 16 kHz 16-bit mono, as the
            phone's dictation sends it."""
            if not self.ws_check():
                return
            sid = s["id"]
            if sid not in st.desk_mics:
                return self.error(409, "Claude's terminal isn't open in this browser")
            try:
                self.ws_handshake()
                # A page whose microphone takes a while to start sends nothing
                # at first; a page gone (it says "end" otherwise) is quiet for good.
                self.connection.settimeout(DESK_MIC_QUIET)
                while True:
                    op, data = self.ws_recv()
                    if op in (None, 8) or op == 1 and data == b"end":
                        break
                    mic = st.desk_mics.get(sid)
                    if op in (0, 2) and mic:
                        mic.feed(data)
                    elif op == 9:
                        self.ws_send(data, op=10)
            except (OSError, ValueError):
                pass
            finally:
                mic = st.desk_mics.get(sid)
                if mic:
                    mic.forget()
                try:
                    self.ws_send(b"", op=8)
                except OSError:
                    pass

        def ws_recv(self):
            """A WebSocket frame from the phone: (opcode, payload), or (None,
            b"") when it's gone. Frames from a browser are masked."""
            head = self.rfile.read(2)
            if len(head) < 2:
                return None, b""
            n = head[1] & 0x7F
            if n == 126:
                n = int.from_bytes(self.rfile.read(2), "big")
            elif n == 127:
                n = int.from_bytes(self.rfile.read(8), "big")
            if not head[1] & 0x80 or n > 1 << 20:
                raise ValueError("not a frame from a browser")
            mask = self.rfile.read(4)
            data = self.rfile.read(n)
            if len(data) < n:
                return None, b""
            if n:
                data = (int.from_bytes(data, "big") ^ int.from_bytes((mask * (n // 4 + 1))[:n], "big")).to_bytes(n, "big")
            return head[0] & 0x0F, data

        def ws_send(self, body, op=1):
            data = json.dumps(body).encode() if isinstance(body, dict) else body
            n = len(data)
            size = (bytes([n]) if n < 126 else bytes([126]) + n.to_bytes(2, "big") if n < 1 << 16
                    else bytes([127]) + n.to_bytes(8, "big"))
            with self.ws_lock:      # the words as they come go out from another thread
                self.wfile.write(bytes([0x80 | op]) + size + data)

        def do_GET(self):
            if not self.allowed():
                return
            path, _, query = self.path.partition("?")
            args = urllib.parse.parse_qs(query)
            if path == "/api/state":
                with st.changed:
                    view = dict(st.view)
                return self.send(200, {**view, "key": app_public(),
                                       "user": self.headers.get("Tailscale-User-Login")})
            if path == "/api/events":
                return self.list_stream()
            if path == "/api/github":       # your repos, for a new project
                r = run_amarchy("projects", "--github", "--json")
                try:
                    repos = json.loads(r.stdout) if r.returncode == 0 else None
                except ValueError:
                    repos = None
                if not isinstance(repos, list):
                    return self.error(500, gist(r.stderr) or "gh isn't installed or logged in on the host")
                return self.send(200, {"repos": [{"name": x.get("name"), "private": bool(x.get("private")),
                                                  "added": bool(x.get("added"))} for x in repos if isinstance(x, dict)]})
            if path == "/api/dictate":      # dictation written down here (see "dictation on the host")
                return self.dictate(args)
            m = re.fullmatch(r"/api/session/([^/]+)/(stream|earlier|closing|voice|tty/claude|tty/term|mic|commands)", path)
            if m:
                s = self.session(m.group(1))
                if not s:
                    return
                if m.group(2) == "voice":
                    return self.voice(s)
                if m.group(2).startswith("tty/"):
                    return self.tty(s, m.group(2)[4:], args)
                if m.group(2) == "mic":
                    return self.desk_mic(s)
                if m.group(2) == "commands":
                    return self.send(200, {"commands": app_commands(s)})
                if m.group(2) == "stream":
                    return self.session_stream(s)
                if m.group(2) == "closing":
                    return self.send(200, app_closing(s))
                try:
                    items, start = app_earlier(s, int(args.get("before", ["0"])[0]))
                except (ValueError, OSError):
                    return self.error(400, "bad offset")
                return self.send(200, {"items": items, "start": start})
            if path == "/api/sounds":       # what amarchy sound offers, and the two picked
                return self.send(200, app_sounds())
            m = re.fullmatch(r"/sound/([^/]{1,200})", path)
            if m:
                found = app_sound_file(urllib.parse.unquote(m.group(1)))
                if not found:
                    return self.error(404, "not found")
                data = found[0].read_bytes()
                self.head(200, found[1], [("Content-Length", str(len(data)))], cache="no-cache")
                self.end_headers()
                self.wfile.write(data)
                return
            if path == "/theme.css":
                return self.send(200, app_theme_css().encode(), "text/css; charset=utf-8")
            # Your assistant's picture (amarchy assistant --picture), by its hash.
            m = re.fullmatch(r"/picture/([0-9a-f]{12})-(512|192)\.png", path)
            if m:
                f = PICTURE if m.group(2) == "512" else PICTURE_SMALL
                try:
                    data = f.read_bytes() if picture_sig(PICTURE) == m.group(1) else b""
                except OSError:
                    data = b""
                if not data:
                    return self.error(404, "not found")
                self.head(200, "image/png", [("Content-Length", str(len(data)))], cache="max-age=31536000, immutable")
                self.end_headers()
                self.wfile.write(data)
                return
            if path == "/api/look":       # the themes, fonts and wallpapers to pick from
                return self.send(200, look_info())
            # The look's own files: a theme's wallpapers, a font, your own wallpaper.
            m = re.fullmatch(r"/themes/([\w-]+)/(wallpaper|wallpaper-wide)\.svg", path) or \
                re.fullmatch(r"/fonts/([\w-]+)/(regular|bold)\.woff2", path) or \
                re.fullmatch(r"/own/(own-[0-9a-f]{12}-(?:phone|wide)\.(jpg|png|webp))", path) or \
                re.fullmatch(r"/custom/([\w-]+)/((?:wallpaper|wallpaper-wide|regular|bold)\.(?:jpg|png|webp|ttf|otf|woff2?))", path)
            if m:
                f = (APP_PICK / m.group(1) if path.startswith("/own/") else CUSTOM / m.group(1) / m.group(2)
                     if path.startswith("/custom/") else
                     (THEMES if path.startswith("/themes/") else FONTS) / m.group(1) / path.rsplit("/", 1)[1])
                if not f.is_file():
                    return self.error(404, "not found")
                data = f.read_bytes()
                kind = {".svg": "image/svg+xml", ".woff2": "font/woff2"}.get(f.suffix) or APP_LOOK_TYPES[f.suffix[1:]]
                # Asked for with ?v=<its hash>, or named after it (your own): the same address is the same file.
                self.head(200, kind, [("Content-Length", str(len(data)))], cache="max-age=31536000, immutable")
                self.end_headers()
                self.wfile.write(data)
                return
            return self.page(path)

        def page(self, path):
            name = "index.html" if path == "/" else path.lstrip("/")
            # The libraries it uses (vendor/), named with their versions: the
            # same name is always the same file.
            folder, _, name = name.rpartition("/") if name.startswith("vendor/") else ("", "", name)
            f = APP_PAGES / folder / name
            if not re.fullmatch(r"[\w-]+(\.[\w-]+)+", name) or Path(name).suffix not in APP_TYPES or not f.is_file():
                return self.error(404, "not found")
            extra = [("Service-Worker-Allowed", "/")] if name == "sw.js" else []
            data, nonce = f.read_bytes(), None
            if name == "index.html":
                nonce = b64u(os.urandom(16))
                data = data.replace(b"{{nonce}}", nonce.encode())
            self.head(200, APP_TYPES[Path(name).suffix], [("Content-Length", str(len(data))), *extra],
                      cache="max-age=31536000, immutable" if folder else "no-cache", nonce=nonce)
            self.end_headers()
            self.wfile.write(data)

        def stream_start(self):
            self.head(200, "text/event-stream", [("X-Accel-Buffering", "no")])
            self.end_headers()
            self.close_connection = True

        def event(self, name, data):
            self.wfile.write(f"event: {name}\ndata: {json.dumps(data)}\n\n".encode())
            self.wfile.flush()

        def list_stream(self):
            """The list, and again on every change."""
            self.stream_start()
            version = -1
            try:
                while True:
                    with st.changed:
                        if st.version == version or not st.view:
                            st.changed.wait(KEEPALIVE)
                        if not st.view:
                            continue
                        view, changed, version = st.view, st.version != version, st.version
                    if changed:
                        self.event("list", view)
                    else:
                        self.wfile.write(b": still here\n\n")
                        self.wfile.flush()
            except OSError:
                pass

        def session_stream(self, s):
            """A session as it goes on: its row in the list, its conversation
            (the latest of it first), and its screen with any question on it."""
            if not s.get("setup") and Path(s["path"]).is_dir() and not tmux_has(tmux_name(s["id"])):
                host_start(s)       # after a reboot, before anyone attached: asleep, until you send it something
            self.stream_start()
            conv, screen, row, beat = AppConversation(s), None, None, time.time()
            st.looking(s["id"], True)
            try:
                while True:
                    now = st.row(s["id"])
                    if now is None and (not session(s["id"]) or (CLOSING / f"{s['id']}.json").exists()):
                        self.event("gone", {})
                        return
                    if now is not None and now != row:
                        row = now
                        self.event("session", row)
                    items, reset = conv.poll()
                    if reset:
                        self.event("conversation", {"reset": True, "items": items, "start": conv.start})
                    elif items:
                        self.event("conversation", {"items": items})
                    seen = app_screen(s)
                    if seen != screen:
                        screen = seen
                        self.event("screen", screen)
                    if time.time() - beat > KEEPALIVE:
                        self.wfile.write(b": still here\n\n")
                        self.wfile.flush()
                        beat = time.time()
                    time.sleep(0.5)
            except OSError:
                pass
            finally:
                st.looking(s["id"], False)

        def do_POST(self):
            if not self.allowed(write=True):
                return
            big = self.path in ("/api/clip", "/api/assistant/picture", "/api/sound/add", "/api/look/wallpaper")
            data = self.body(CLIP_MAX if big else 200_000)
            if self.path == "/api/clip":
                return self.clip(data)
            if self.path in ("/api/sound", "/api/sound/add"):
                return self.sound(data)
            if self.path in ("/api/assistant", "/api/assistant/picture"):
                return self.assistant(None, data)
            if self.path == "/api/dictate/log":
                return self.dictate_logged(data)
            if self.path == "/api/dictate/setup":
                return self.dictate_fetch()
            if self.path == "/api/new":
                return self.new(data)
            if self.path == "/api/add":
                return self.add(data)
            if self.path in ("/api/push", "/api/push/remove", "/api/push/test"):
                return self.push(data)
            if self.path == "/api/alerts":    # what the other sessions tell you about (amarchy alerts)
                if data.get("alerts") not in ALERTS:
                    return self.error(400, "all, needs-you or assistant")
                write_file(ALERTS_FILE, data["alerts"] + "\n")
                return self.send(200, {})
            if self.path in ("/api/look", "/api/look/wallpaper"):     # the theme, font, wallpaper (amarchy theme)
                own = None
                if self.path == "/api/look/wallpaper":
                    try:
                        own = tuple(base64.b64decode(str(data.get(k) or ""), validate=True) for k in ("phone", "wide"))
                    except ValueError:
                        own = None
                    if not own or not all(own):
                        return self.error(400, "no picture came (at most 8 MB)")
                pick = {k: data.get(k) for k in ("theme", "font", "wallpaper")}
                if any(v is not None and not isinstance(v, str) for v in pick.values()):
                    return self.error(400, "theme, font and wallpaper are names")
                look = look_set(**pick, own=own)
                return self.error(400, look) if isinstance(look, str) else self.send(200, look_info())
            if self.path == "/api/projects/move":     # a project up, down... in your order (amarchy projects move)
                name, where, other = data.get("name"), data.get("where"), data.get("other")
                why = move_project(name, where, other) if isinstance(name, str) else "which project?"
                return self.error(400, why) if why else self.send(200, {"projects": project_names()})
            if self.path == "/api/list":      # group and sort the list (amarchy group, sort, projects order)
                why = set_list(data)
                return self.error(400, why) if why else self.send(200, {})
            if self.path == "/api/sleep":     # when idle sessions sleep (amarchy sleep --after), or all of them now
                return self.sleep(data)
            m = re.fullmatch(r"/api/session/([^/]+)/(send|keys|priority|seen|close|rename|run|commands|assistant|wake|sleep)", self.path)
            s = self.session(m.group(1)) if m else self.error(404, "not found")
            if not s:
                return
            what = m.group(2)
            if what in ("rename", "run", "commands"):
                return self.desk_action(s, what, data)
            if what == "assistant":
                return self.assistant(s, data)
            if what == "seen":
                st.seen[s["id"]] = time.time()
                st.looking(s["id"])
                mark_seen(s["id"])
                return self.send(200, {})
            if what == "wake":
                if asleep_since(s["id"]) is not None:
                    wake(s)
                else:
                    host_start(s, wake=True)    # not started since a reboot
                return self.send(200, {})
            if what == "sleep":
                lock = sleep_lock(wait=True)
                if not lock:
                    return self.error(409, "Amarchy is putting sessions to sleep already: try again in a moment")
                with lock:
                    why = put_to_sleep(s)
                return self.error(409, f"It stays awake: {why}") if why else self.send(200, {})
            if what == "close":
                # Uncommitted work goes only when the phone said so, having
                # been told about it (app_closing); else it asks again.
                closing = app_closing(s)
                if closing["changes"] and data.get("discard") is not True:
                    return self.send(409, {"error": "It has uncommitted changes", **closing})
                r = run_amarchy("close", s["id"], *(["--force"] if closing["changes"] else []))
                return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            if what == "priority":
                level = data.get("level")
                if level not in PRIORITIES:
                    return self.error(400, "high, normal or low")
                r = run_amarchy("priority", level, "--id", s["id"])
                return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            st.looking(s["id"])
            screen = app_screen(s)
            if screen["waking"]:
                # On its way back: what's sent waits for its prompt.
                end = time.time() + 30
                while screen["waking"] and time.time() < end:
                    time.sleep(0.3)
                    screen = app_screen(s)
                if screen["waking"]:
                    return self.error(409, "Claude is still waking up: try again in a moment")
                time.sleep(0.5)     # its first screen drawn
                screen = app_screen(s)
            if what == "send":
                text = data.get("text")
                if not isinstance(text, str) or not text.strip() or len(text) > 60_000:
                    return self.error(400, "nothing to send")
                if screen["asleep"] or not screen["live"] and not s.get("setup"):
                    # Asleep (or not started since a reboot): it wakes with this
                    # as its first message, what was typed in its prompt kept.
                    if starting(s["id"]):
                        return self.error(409, "Claude is starting with another message: try again in a moment")
                    threading.Thread(target=send_start, args=(s, text.replace("\r\n", "\n").replace("\r", "\n")),
                                     daemon=True).start()
                    return self.send(200, {"waking": True})
                if not screen["live"]:
                    return self.error(409, "Claude isn't running yet: try again in a moment")
                if screen["exited"]:
                    return self.error(409, "Claude Code exited: start it again first")
                # An answer in your own words to a question ("Type something."):
                # that option's keys first, then the text.
                answer = data.get("answer") if isinstance(data.get("answer"), dict) else None
                if screen["dialog"] and not answer:
                    return self.error(409, "Claude is asking you something: answer that first")
                if answer:
                    keys = answer.get("keys")
                    if (screen["dialog"] or {}).get("id") != answer.get("dialog"):
                        return self.error(409, "The question changed: look again")
                    if not valid_keys(keys):
                        return self.error(400, "keys it doesn't send")
                    why = app_keys(s, keys)
                    if why:
                        return self.error(500, why)
                    time.sleep(0.2)
                why = app_type(s, text.replace("\r\n", "\n").replace("\r", "\n"))
            else:
                keys = data.get("keys")
                if not valid_keys(keys):
                    return self.error(400, "keys it doesn't send")
                if screen["asleep"]:
                    wake(s)
                    return self.error(409, "It was asleep: Claude is waking up, try again in a moment")
                expect = data.get("dialog")
                if expect is not None and (screen["dialog"] or {}).get("id") != expect:
                    return self.error(409, "The question changed: look again")
                why = app_keys(s, keys)
            st.seen[s["id"]] = time.time()
            return self.send(200, {}) if why is None else self.error(500, why)

        def sleep(self, data):
            """{"after": minutes|"off"}: how long a session idle and open
            nowhere waits before it sleeps. {"all": true}: every idle one
            open nowhere sleeps now (amarchy sleep --all)."""
            if data.get("all") is True:
                lock = sleep_lock(wait=True)
                if not lock:
                    return self.error(409, "Amarchy is putting sessions to sleep already: try again in a moment")
                with lock:
                    slept, kept = sleep_all()
                return self.send(200, {"slept": len(slept), "kept": len(kept)})
            after = data.get("after")
            if after != "off" and (isinstance(after, bool) or not isinstance(after, (int, float)) or not 0 <= after <= 1440):
                return self.error(400, "minutes (0 to 1440) or off")
            write_file(SLEEP_AFTER, f"{'off' if after == 'off' else f'{after:g}'}\n")
            return self.send(200, {})

        def clip(self, data):
            """What you pasted (or copied) in a browser or on the phone: the web
            clipboard now, for wl-paste in your sessions (see "clipboard").
            {type, data (base64)} for an image, {text} for text; with
            {session, paste: true}, Claude in that session pastes it (Ctrl+V)."""
            kind, text = data.get("type"), data.get("text")
            if isinstance(text, str):
                if not text or len(text) > 1_000_000:
                    return self.error(400, "no text")
                items = [("text/plain;charset=utf-8", text.encode())]
            else:
                if not isinstance(kind, str) or not CLIP_TYPES.fullmatch(kind):
                    return self.error(400, "only an image (PNG, JPEG, GIF or WebP)")
                try:
                    raw = base64.b64decode(data.get("data") or "", validate=True)
                except (ValueError, TypeError):
                    raw = b""
                if not raw:
                    return self.error(400, "no image")
                items = [(kind, raw)]
            s = None
            if data.get("paste") is True:
                s = self.session(data.get("session")) if isinstance(data.get("session"), str) else self.error(400, "which session")
                if not s:
                    return
                screen = app_screen(s)
                if not screen["live"] or screen["exited"]:
                    return self.error(409, "Claude isn't running: start it first")
                if screen["dialog"]:
                    return self.error(409, "Claude is asking you something: answer that first")
            try:
                web_clip_save(items)
            except OSError as e:
                return self.error(500, f"couldn't keep it: {e}")
            if s:
                r = tmux("send-keys", "-t", f"={tmux_name(s['id'])}:", "C-v")
                if r.returncode != 0:
                    return self.error(500, r.stderr.strip() or "tmux failed")
                st.seen[s["id"]] = time.time()
            return self.send(200, {})

        def desk_action(self, s, what, data):
            """What the wide layout's keys do to a session: name it
            (Ctrl+Alt+E), run its command or another one in its terminal
            (Ctrl+Alt+R, Ctrl+Alt+C), save one."""
            if what == "rename":
                title = data.get("title")
                if data.get("reset") is True:
                    r = run_amarchy("rename", "--id", s["id"], "--reset")
                elif isinstance(title, str) and title.strip() and len(title) <= 200:
                    r = run_amarchy("rename", "--id", s["id"], title.strip())
                else:
                    return self.error(400, "what to call it")
                return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            env = {"AMARCHY_SESSION": s["id"]}
            if what == "commands" and data.get("forget") is True:     # drop one: {name, forget}
                name = data.get("name")
                if not isinstance(name, str) or not re.fullmatch(r"[\w.-]{1,40}", name) or name == RUN_DEFAULT:
                    return self.error(400, "which command (the run command itself stays: change it instead)")
                r = run_amarchy("run", "--forget", name, env=env)
                return self.send(200, {"commands": app_commands(s)}) if r.returncode == 0 \
                    else self.error(500, gist(r.stderr or r.stdout))
            if what == "commands":       # save one: {name, command}; the run command itself is "run"
                name, command = data.get("name"), data.get("command")
                if not isinstance(name, str) or not re.fullmatch(r"[\w.-]{1,40}", name) or \
                        not isinstance(command, str) or not command.strip() or len(command) > 4000:
                    return self.error(400, "a name and a command")
                r = run_amarchy("run", *(["--set", command] if name == RUN_DEFAULT else ["--save", name, command]), env=env)
                return self.send(200, {"commands": app_commands(s)}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            name = data.get("name")
            if name is not None and (not isinstance(name, str) or not re.fullmatch(r"[\w.-]{1,40}", name)):
                return self.error(400, "no such command")
            if s.get("setup"):
                return self.error(409, "It's still being set up: run it once Claude has started")
            if name in (None, RUN_DEFAULT) and not run_command(s):
                return self.send(409, {"error": "No run command for this project yet", "ask": True})
            r = run_amarchy("run", *([name] if name and name != RUN_DEFAULT else []), env=env)
            return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr or r.stdout))

        def sound(self, data):
            """The chime (amarchy sound): {name} sets it ("off" for none),
            {name, assistant: true} your assistant's; /api/sound/add takes one
            of yours, {name (its file name), data (base64)}."""
            if self.path == "/api/sound/add":
                try:
                    raw = base64.b64decode(data.get("data") or "", validate=True)
                except (ValueError, TypeError):
                    raw = b""
                name, why = app_add_sound(data.get("name") if isinstance(data.get("name"), str) else "", raw)
                return self.send(200, {"name": name, **app_sounds()}) if name else self.error(400, why)
            name = data.get("name")
            if not isinstance(name, str) or not (name == "off" or sound_key(name)):
                return self.error(400, "no such sound")
            r = run_amarchy("sound", *(["--assistant"] if data.get("assistant") is True else []), name)
            return self.send(200, app_sounds()) if r.returncode == 0 else self.error(500, gist(r.stderr))

        def assistant(self, s, data):
            """Your assistant (amarchy assistant): /api/session/<id>/assistant
            makes that session it ({name} optional), or not ({off: true});
            /api/assistant {name} renames the one you have; /api/assistant/
            picture takes its picture ({data (base64), crop: [x, y, size]}) or
            amarchy's own again ({off: true})."""
            name = data.get("name")
            if name is not None and (not isinstance(name, str) or not name.strip() or len(name.strip()) > 40):
                return self.error(400, "a name of 40 characters at most")
            if self.path == "/api/assistant/picture":
                if data.get("off") is True:
                    r = run_amarchy("assistant", "--picture", "off")
                else:
                    crop = data.get("crop")
                    if crop is not None and not (isinstance(crop, list) and len(crop) == 3
                                                 and all(isinstance(n, int) and n >= 0 for n in crop) and crop[2] > 0):
                        return self.error(400, "crop: x, y and size, in the picture's pixels")
                    pic = data.get("data")
                    if not isinstance(pic, str) or not pic:
                        return self.error(400, "no picture")
                    r = run_amarchy("assistant", "--picture", "-", *(["--crop", "%d,%d,%d" % tuple(crop)] if crop else []),
                                    input=pic, timeout=120)
            elif s is None:
                if name is None:
                    return self.error(400, "what to call it")
                r = run_amarchy("assistant", "--name", name.strip())
            elif data.get("off") is True:
                mine = assistant()
                if not mine or mine["id"] != s["id"]:
                    return self.error(409, "It isn't your assistant")
                r = run_amarchy("assistant", "off")
            else:
                r = run_amarchy("assistant", s["id"], *(["--name", name.strip()] if name else []))
            return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr or r.stdout))

        def add(self, data):
            """A new project (Ctrl+Alt+P): a repo (owner/repo or a git URL),
            or an empty one ({new, github})."""
            repo, new = data.get("repo"), data.get("new")
            if isinstance(new, str) and re.fullmatch(r"[\w.-]{1,100}", new) and not new.startswith("-"):
                r = run_amarchy("add", "--new", new, *(["--github"] if data.get("github") is True else []), timeout=900)
            elif isinstance(repo, str) and re.fullmatch(r"[\w.@:/~+-]{1,300}", repo) and not repo.startswith("-"):
                r = run_amarchy("add", repo, timeout=900)
            else:
                return self.error(400, "which repo")
            if r.returncode != 0:
                return self.error(500, gist(r.stderr or r.stdout) or "couldn't add it")
            return self.send(200, {"name": (r.stdout.strip().splitlines() or [""])[-1]})

        def new(self, data):
            repo, prompt = data.get("repo"), data.get("prompt")
            if not isinstance(repo, str) or repo not in {p["name"] for p in st.view.get("projects", [])} \
                    and repo not in {p["name"] for p in projects()}:      # one just added: not in the list yet
                return self.error(400, "no such project")
            # Without a prompt when it's to be dictated, once it's up.
            if prompt is None or isinstance(prompt, str) and not prompt.strip():
                r = run_amarchy("new", repo, timeout=300)
            elif not isinstance(prompt, str) or len(prompt) > 60_000:
                return self.error(400, "say what it's for")
            else:
                r = run_amarchy("new", repo, "--prompt", "-", input=prompt, timeout=300)
            sid = (r.stdout.strip().splitlines() or [""])[-1]
            if r.returncode != 0 or not sid:
                return self.error(500, gist(r.stderr) or "couldn't start it")
            # Once the list has it (app_watch reads it every second), so the
            # page that asked can go straight to it.
            until = time.time() + 5
            with st.changed:
                while st.row(sid) is None and time.time() < until:
                    st.changed.wait(until - time.time())
            return self.send(200, {"id": sid})

        def push(self, data):
            if self.path == "/api/push/test":
                n = push_all({"title": "Amarchy", "body": "Notifications work.", "tag": "amarchy-test", "url": "/"})
                return self.send(200, {"sent": n})
            endpoint = data.get("endpoint")
            if not isinstance(endpoint, str) or not endpoint.startswith("https://"):
                return self.error(400, "not a push subscription")
            if self.path == "/api/push/remove":
                app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] != endpoint])
                return self.send(200, {})
            keys = data.get("keys") if isinstance(data.get("keys"), dict) else {}
            try:
                if len(unb64u(keys["p256dh"])) != 65 or len(unb64u(keys["auth"])) != 16:
                    raise ValueError
            except (KeyError, ValueError, TypeError):
                return self.error(400, "not a push subscription")
            sub = {"endpoint": endpoint, "keys": {"p256dh": keys["p256dh"], "auth": keys["auth"]},
                   "added": int(time.time()), "device": str(self.headers.get("User-Agent", ""))[:200]}
            app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] != endpoint] + [sub])
            return self.send(200, {})

    return Handler


def run_amarchy(*args, input=None, timeout=60, env=None):
    try:
        return subprocess.run([sys.executable, SELF, *args], capture_output=True, text=True, input=input,
                              stdin=None if input is not None else subprocess.DEVNULL, timeout=timeout,
                              env={**clean_env(), **(env or {})})
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(args, 1, "", str(e))


def app_serve():
    """Run the app's server (what amarchy-app.service runs) until amarchy is
    updated, when systemd starts the new one."""
    import http.server
    status = tailscale_status()
    address, users = app_address(status), app_users(status)
    if not address:
        return fail("this machine isn't on Tailscale (or Tailscale isn't up): the app is served on your tailnet")
    if not users:
        return fail("couldn't tell who owns this machine on Tailscale: set APP_USERS=<your login> "
                    f"in {HOST_CONFIG}")
    app_key()
    migrate()
    st = AppState()
    st.transcriber = Transcriber()      # dictation on the host
    server = http.server.ThreadingHTTPServer(("127.0.0.1", app_port()), app_handler(st, users, address))
    server.daemon_threads = True
    threading.Thread(target=app_watch, args=(st,), daemon=True).start()
    version = os.stat(SELF).st_mtime_ns

    def updated():
        while True:
            time.sleep(2)
            try:
                if os.stat(SELF).st_mtime_ns != version:
                    break
            except OSError:
                pass
        server.shutdown()

    threading.Thread(target=updated, daemon=True).start()
    print(f"amarchy app: {app_url(address)} for {', '.join(sorted(users))} "
          f"(on 127.0.0.1:{app_port()})", file=sys.stderr, flush=True)
    server.serve_forever()
    return 0


def app_unit():
    return f"""[Unit]
Description=amarchy app: your sessions on your phone and in your browser, on your tailnet
After=network-online.target tailscaled.service

[Service]
ExecStart={ENTRY} app serve
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
"""


def serve_config():
    """What tailscale serve proxies the app's HTTPS port to, or None."""
    try:
        conf = json.loads(sh("tailscale", "serve", "status", "--json").stdout or "{}")
    except ValueError:
        return None
    for hostport, web in (conf.get("Web") or {}).items():
        if hostport.endswith(f":{app_https()}"):
            return ((web.get("Handlers") or {}).get("/") or {}).get("Proxy")
    return None


def app_on():
    status = tailscale_status()
    address = app_address(status)
    if not shutil.which("tailscale") or not address:
        return fail("the app is served on your tailnet: install Tailscale and run `sudo tailscale up` first")
    if not status.get("CertDomains"):
        return fail("Tailscale has no HTTPS certificates for your tailnet yet: turn them on at "
                    "https://login.tailscale.com/admin/dns (HTTPS Certificates), then run this again")
    if not app_users(status):
        return fail(f"couldn't tell who owns this machine on Tailscale: set APP_USERS=<your login> in {HOST_CONFIG}")
    target = f"http://127.0.0.1:{app_port()}"
    taken = serve_config()
    if taken and taken != target:
        return fail(f"tailscale serve already sends port {app_https()} to {taken}: set APP_HTTPS=8443 "
                    f"in {HOST_CONFIG} to put the app on another port")
    app_key()
    UNITS.mkdir(parents=True, exist_ok=True)
    unit = UNITS / APP_UNIT
    if not unit.exists() or unit.read_text() != app_unit():
        write_file(unit, app_unit())
        sh("systemctl", "--user", "daemon-reload")
    r = sh("systemctl", "--user", "enable", "--now", APP_UNIT)
    if r.returncode != 0:
        return fail(f"couldn't start {APP_UNIT}: {gist(r.stderr)}")
    sh("systemctl", "--user", "restart", APP_UNIT)
    if taken != target:
        r = sh("tailscale", "serve", "--bg", f"--https={app_https()}", target)
        if r.returncode != 0:
            why = gist(r.stderr or r.stdout)
            if "access denied" in (r.stderr + r.stdout).lower():
                why = "Tailscale won't let you change it: run `sudo tailscale set --operator=$USER` once"
            return fail(f"couldn't serve it on your tailnet: {why}")
    if sh("loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger").stdout.strip() == "Linger=no":
        print("  Note: it stops when you log out of this machine. `sudo loginctl enable-linger $USER` keeps it running.")
    print(f"{app_url(address)}\n"
          f"  On your phone (on your tailnet): open it in Safari, then Share → Add to Home Screen.\n"
          f"  Open it from the home screen and turn on notifications there.")
    return 0


def app_off():
    if serve_config() == f"http://127.0.0.1:{app_port()}":
        sh("tailscale", "serve", f"--https={app_https()}", "off")
    sh("systemctl", "--user", "disable", "--now", APP_UNIT)
    (UNITS / APP_UNIT).unlink(missing_ok=True)
    sh("systemctl", "--user", "daemon-reload")
    print("off: the app is no longer served (your phones keep it, and it works again with `amarchy app on`)")
    return 0


def app_status():
    running = sh("systemctl", "--user", "is-active", APP_UNIT).stdout.strip() == "active"
    served = serve_config() == f"http://127.0.0.1:{app_port()}"
    address = app_address()
    phones = len(app_subscriptions())
    if not running and not served:
        print("off (amarchy app on starts it)")
        return 1
    where = app_url(address) if address and served else "not on your tailnet (amarchy app on)"
    print(f"{'on' if running else 'stopped'}: {where}, {phones} phone{'' if phones == 1 else 's'} notified")
    return 0 if running and served else 1


def cmd_app(args):
    """amarchy app [on|off|--status|--test|serve]."""
    what = args[0] if args else "--status"
    if what == "serve":
        return app_serve()
    if what == "on":
        return app_on()
    if what == "off":
        return app_off()
    if what == "--test":
        if not app_subscriptions():
            return fail("no phone has turned on notifications yet (in the app: the gear, then Turn on notifications)")
        n = push_all({"title": "Amarchy", "body": "Notifications work.", "tag": "amarchy-test", "url": "/"})
        print(f"sent to {n} of {len(app_subscriptions())}")
        return 0 if n else 1
    if what == "--status":
        return app_status()
    return fail("usage: amarchy app [on|off|--status|--test]")


# ------------------------------------------------------------------ send and notify
#
# What a script or another agent does as you would from the phone: a message
# for a session's Claude (a timer waking an assistant for a check-in), a
# notification on your phones.
#
# A message waits its turn in the session's queue (a file each, oldest first),
# so two senders never type into one prompt at once and messages arrive in
# the order they were sent. It's typed, as the phone types one, once Claude is
# free: up, at its prompt, not in the middle of a turn (Claude Code would hand
# it to the turn under way, between two of its steps) and not asking you
# anything (it would answer the question). Something you're typing in its
# prompt goes first if it sits still, and is back in the prompt after. A
# Claude asleep or exited starts again with it as its first message, the way
# Enter does in its asleep terminal.

SEND_TIMEOUT = 60       # minutes a message waits for Claude to be free, unless told otherwise
SEND_TAKEN = 15         # seconds Claude has to take a message once it's typed
SEND_START = 180        # seconds a Claude asleep or exited has to come back and take one
SEND_SETTLE = 1.5       # seconds Claude has to look free before a message is typed
SEND_TYPING = 15        # seconds what's typed in Claude's prompt sits still before a message goes ahead of it


def send_queue(sid):
    return claude_dir(sid) / "queue"


def send_entry(f):
    try:
        d = json.loads(f.read_text())
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) and isinstance(d.get("text"), str) else None


def send_turn(f):
    """Whether it's this message's turn: the oldest in its queue, once the
    ones whose sender is gone are dropped. None when it's gone itself."""
    for g in sorted(f.parent.glob("[0-9]*")):
        if g == f:
            return True
        pid = (send_entry(g) or {}).get("pid")
        if not isinstance(pid, int) or not Path(f"/proc/{pid}").exists():
            g.unlink(missing_ok=True)
            continue
        return False
    return None


def claude_busy(s, screen):
    """Whether the session's Claude is in the middle of a turn: it says so
    under its prompt, or it said it started one (an interrupted turn never
    says it ended) and its conversation is still moving."""
    if any("esc to interrupt" in l for l in screen["text"].splitlines()[-6:]):
        return True
    try:
        status = (STATUS / s["id"]).read_text().strip()
    except OSError:
        status = ""
    f = transcript(s)
    return status == "working" and bool(f) and time.time() - f.stat().st_mtime < QUIET


def send_taken(sid, since):
    """Whether the session's Claude took a message typed at `since`: it
    started a turn on it."""
    try:
        f = STATUS / sid
        return f.stat().st_mtime >= since - 0.5 and f.read_text().strip() == "working"
    except OSError:
        return False


def starting(sid):
    """Whether the session's Claude is starting with a message: one left for
    it to take, lately. One that's sat there longer is gone: Claude, up by
    now, never took it."""
    f = claude_dir(sid) / "send"
    try:
        if time.time() - f.stat().st_mtime < SEND_START:
            return True
    except OSError:
        return False
    if claude_prompt(session(sid) or {"id": sid}) is not None:
        f.unlink(missing_ok=True)
    return False


def send_start(s, text):
    """Start the session's Claude (asleep, exited or not running) with text
    as its first message. None once it took it, else why not."""
    sid = s["id"]
    d = claude_dir(sid)
    since = time.time()
    # What was typed in its prompt when it went to sleep goes back there once
    # Claude has the message.
    draft = take(d / "draft") if asleep_since(sid) is not None else None
    write_file(d / "send", text)
    if asleep_since(sid) is not None:
        wake(s)
    elif tmux_has(tmux_name(sid)):
        woken(sid)
        tmux("send-keys", "-t", f"={tmux_name(sid)}:", "Enter")     # it exited: Enter starts it again
    else:
        woken(sid)
        host_start(s, wake=True)
    why = send_started(sid, text, since)
    if draft and draft.strip():
        if why:
            write_file(d / "draft", draft)      # for when it does start
        else:
            end = time.time() + 30
            while claude_prompt(s) is None and time.time() < end:
                time.sleep(0.3)
            time.sleep(0.5)     # Claude's turn draws its prompt again
            buffer = f"amarchy-send-{os.getpid()}"
            if tmux("set-buffer", "-b", buffer, "--", draft.rstrip("\n")).returncode == 0:
                tmux("paste-buffer", "-p", "-r", "-d", "-b", buffer, "-t", f"={tmux_name(sid)}:")
    return why


def send_started(sid, text, since):
    """Wait for a Claude started with text (send_start) to take it. None once
    it did, else why not."""
    d = claude_dir(sid)
    # Taken once its Claude starts on it: the next message waits for that
    # turn instead of landing in a Claude still starting up.
    end = time.time() + SEND_START
    while time.time() < end:
        if send_taken(sid, since):
            return None
        time.sleep(0.3)
    try:
        if (d / "send").read_text() == text:
            (d / "send").unlink()
            return "its Claude didn't start"
    except OSError:
        pass
    return None     # it started with it, and hasn't said it's working on it (a /command)


def send_type(s, text):
    """Type a message into the session's Claude, free and at its prompt: what
    was typed there first handed over (Ctrl+G) and put back after. None once
    Claude took it, False to try again in a moment, else why not."""
    sid = s["id"]
    pane = f"={tmux_name(sid)}:"
    draft = ""
    if claude_prompt(s):
        if not hand_over_prompt(s):
            return False
        draft = take(claude_dir(sid) / "draft") or ""
        if not clear_claude_prompt(s):
            return False
    since = time.time()
    why = app_type(s, text)
    end = time.time() + SEND_TAKEN
    taken = False
    while not why and time.time() < end:
        time.sleep(0.3)
        # Its prompt empty again: taken, even without a turn (a /command).
        if send_taken(sid, since) or (time.time() - since > 1 and claude_prompt(s) == ""):
            taken = True
            break
    if draft.strip():
        time.sleep(0.5)     # Claude's turn draws its prompt again
        buffer = f"amarchy-send-{os.getpid()}"
        if tmux("set-buffer", "-b", buffer, "--", draft.rstrip("\n")).returncode == 0:
            tmux("paste-buffer", "-p", "-r", "-d", "-b", buffer, "-t", pane)
    if why:
        return why
    return None if taken else "it's typed in Claude's prompt, but Claude didn't take it (a menu open there?)"


def send_deliver(sid, text, deadline):
    """Deliver a message to the session's Claude once it's free (see above).
    None once Claude has it, else why not."""
    wait, typed, typed_at, free_since = "", None, 0, None
    while True:
        s = session(sid)
        if not s or (CLOSING / f"{sid}.json").exists():
            return "the session was closed"
        if time.time() > deadline:
            return f"its Claude wasn't free in time ({wait})"
        free, free_since = free_since, None     # set again below while Claude stays free
        if s.get("setup"):
            wait = "it's being set up"
        elif engine(s) == "chat" and agent_up(sid) and asleep_since(sid) is None:
            try:
                answer = agent_call(sid, {"op": "send", "content": text})
            except OSError as e:
                answer = {"ok": False, "error": str(e)}
            if answer.get("ok"):
                return None     # the broker has it, and gives it to Claude once it's free
            wait = answer.get("error") or "its broker didn't take it"
        elif starting(sid):
            wait = "its Claude is starting with another message"
        else:
            screen = app_screen(s)
            if screen["waking"]:
                wait = "its Claude is waking up"
                time.sleep(0.5)
                continue
            if asleep_since(sid) is not None or not screen["live"] or screen["exited"]:
                return send_start(s, text)
            prompt = claude_prompt(s)
            if prompt != typed:
                typed, typed_at = prompt, time.time()
            if prompt is None:
                wait = "its prompt isn't on screen"
            elif screen["dialog"]:
                wait = "it's asking something"
            elif claude_busy(s, screen):
                wait = "it's working"
            elif prompt and time.time() - typed_at < SEND_TYPING:
                wait = "someone is typing in it"
            elif not free or time.time() - free < SEND_SETTLE:
                free_since = free or time.time()        # free for a moment, not just between two steps
                wait = "it's settling"
            else:
                why = send_type(s, text)
                if why is not False:
                    return why
                wait = "it didn't hand over what's typed in its prompt"
        time.sleep(0.5)


def send_run(sid, f, deadline):
    """Deliver the message in queue file f, in its turn, and drop it."""
    try:
        text = send_entry(f)["text"]
        while True:
            turn = send_turn(f)
            if turn is None:
                return fail(f"{sid}: the message left the queue unsent")
            if turn:
                break
            if time.time() > deadline:
                return fail(f"{sid}: not sent: messages sent before it were still waiting")
            time.sleep(0.5)
        why = send_deliver(sid, text, deadline)
    finally:
        f.unlink(missing_ok=True)
    if why:
        return fail(f"{sid}: not sent: {why}")
    print(f"sent to {sid}")
    return 0


def send_later(sid, f):
    """Deliver queue file f from a process of its own, which outlives this
    one (and the unit it may run in: amarchy send --no-wait from a timer)."""
    argv = [sys.executable, SELF, "send", sid, "--queued", str(f)]
    started = False
    if shutil.which("systemd-run"):
        keep = ("PATH", "XDG_STATE_HOME", "XDG_CONFIG_HOME", "XDG_RUNTIME_DIR", "AMARCHY_WORK",
                "AMARCHY_WORKTREES")
        r = sh("systemd-run", "--user", "--quiet", "--collect", f"--unit=amarchy-send-{time.time_ns()}",
               f"--description=amarchy send {sid}",
               *(f"--setenv={k}={os.environ[k]}" for k in keep if k in os.environ), *argv)
        started = r.returncode == 0
    if not started:
        detach(argv)
    # It's ours until that process takes it: a queue drops a message whose sender is gone.
    end = time.time() + 15
    while time.time() < end:
        if (send_entry(f) or {}).get("pid") != os.getpid():
            return True
        time.sleep(0.1)
    f.unlink(missing_ok=True)
    return False


def cmd_send(args):
    """amarchy send <id> <text|-> [--no-wait] [--timeout <minutes>]. --queued
    <file> is the process --no-wait leaves to deliver it."""
    wait, minutes, queued, rest = True, SEND_TIMEOUT, None, []
    it = iter(args)
    for a in it:
        if a == "--no-wait":
            wait = False
        elif a == "--timeout":
            try:
                minutes = float(next(it, ""))
                if minutes <= 0:
                    raise ValueError
            except ValueError:
                return fail("--timeout takes the minutes a message may wait, e.g. --timeout 30")
        elif a == "--queued":
            queued = Path(next(it, ""))
        else:
            rest.append(a)
    if queued:
        entry = send_entry(queued)
        if not entry or len(rest) != 1:
            return fail("send --queued: no such message")
        entry["pid"] = os.getpid()
        write_file(queued, json.dumps(entry))
        return send_run(rest[0], queued, entry.get("deadline") or time.time() + SEND_TIMEOUT * 60)
    if len(rest) != 2:
        print(usage("send"), file=sys.stderr)
        return 1
    sid, text = rest
    if text == "-":
        text = sys.stdin.read()
    text = text.replace("\r\n", "\n").replace("\r", "\n").strip("\n")
    if not text.strip():
        return fail("nothing to send")
    if not session(sid):
        return fail(f"No session {sid!r}")
    # From the session's own Claude, waiting would wait on itself: its turn
    # is the one running.
    if wait and sid == os.environ.get("AMARCHY_SESSION"):
        wait = False
    deadline = time.time() + minutes * 60
    f = send_queue(sid) / f"{time.time_ns()}-{os.getpid()}"
    write_file(f, json.dumps({"pid": os.getpid(), "text": text, "deadline": deadline}))
    if wait:
        return send_run(sid, f, deadline)
    if not send_later(sid, f):
        return fail(f"{sid}: couldn't start what delivers it")
    print(f"queued for {sid}: its Claude gets it once it's free")
    return 0


def cmd_notify(args):
    """amarchy notify <title> <body> [--session <id>] [--urgent]: a
    notification on every phone (and browser) with the app's notifications
    on, as the app's own are sent."""
    urgent, sid, rest = False, None, []
    it = iter(args)
    for a in it:
        if a == "--urgent":
            urgent = True
        elif a == "--session":
            sid = next(it, None)
            if not sid:
                return fail("--session takes a session's id")
        else:
            rest.append(a)
    if len(rest) not in (1, 2) or not rest[0].strip():
        print(usage("notify"), file=sys.stderr)
        return 1
    title, body = rest[0], rest[1] if len(rest) > 1 else ""
    if len(title) > 200 or len(body) > 2000:
        return fail("too long for a notification (a title of 200 characters, a body of 2000)")
    if sid and not session(sid):
        return fail(f"No session {sid!r}")
    # From your assistant (or another session of its project): under its
    # name and picture, and a tap opens it unless it says where.
    me = session(os.environ.get("AMARCHY_SESSION", ""))
    mine = assistant() if me and assistant_role(me) else None
    if mine:
        sid = sid or me["id"]
        if not title.lower().startswith(mine["name"].lower()):
            title = f"{mine['name']}: {title}"
    if not app_subscriptions():
        return fail("no phone or browser has turned on notifications yet "
                    "(in the app: the gear, then Turn on notifications)")
    # A tag of its own: it doesn't replace the one before it (the app's own
    # replace each other per session).
    payload = {"title": title, "body": body, "tag": f"amarchy-notify-{time.time_ns()}",
               "url": f"/#/s/{sid}" if sid else "/"}
    if urgent:
        payload["urgent"] = True
    if mine:
        payload["icon"] = assistant_icon()
    n = push_all(payload)
    print(f"sent to {n} of {len(app_subscriptions())}")
    return 0 if n else 1


# ------------------------------------------------------------------ from before
#
# amarchy ran on an Omarchy desktop too, once: Hyprland windows, a shell
# plugin, desktops showing a host's sessions over ssh. What that left in the
# state goes, once (the app's server runs this as it starts, install.sh as it
# installs): the look the last desktop sent the app is kept whole as a theme
# of your own, and picked, so the app looks exactly as it did; its chimes
# become the ones picked here; and the desktop's own files are dropped.

MIGRATED = STATE / "migrated"       # the last of MIGRATIONS done
# 1: the desktop's look as amarchy's theme of the same name (its colors
# weren't quite the desktop's); 2: as a theme of your own.
MIGRATIONS = 2
DESKTOP_STATE = ("zen", "layout.lua", "last", "keys.lua", "keys.bound", "remote", "remote.json",
                 "remote-assistant.png", "preview", "watch.lock", "theme.log", "clipboard.sock", "host",
                 "theme", "notes")


def migrate():
    """Bring the state from before up to date, once (see above). Says what it did."""
    try:
        if int(MIGRATED.read_text().strip() or 0) >= MIGRATIONS:
            return
    except (OSError, ValueError):
        pass
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "migrate.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if int(MIGRATED.read_text().strip() or 0) >= MIGRATIONS:
                return      # another amarchy did it meanwhile
        except (OSError, ValueError):
            pass
        migrate_look()
        for name in DESKTOP_STATE:
            f = STATE / name
            if f.is_dir() and not f.is_symlink():
                shutil.rmtree(f, ignore_errors=True)
            else:
                f.unlink(missing_ok=True)
        for f in [*STATE.glob("ssh-*"), *CLIP_DIR.glob("*.sock"), *CLIP_DIR.glob("*.addr")]:
            f.unlink(missing_ok=True)
        # What a session's file said about its windows.
        for f in SESSIONS.glob("*.json"):
            try:
                s = json.loads(f.read_text())
            except (OSError, ValueError):
                continue
            if isinstance(s, dict) and {"prefix", "workspace", "no_jump"} & s.keys():
                for k in ("prefix", "workspace", "no_jump"):
                    s.pop(k, None)
                save_session(s)
        write_file(MIGRATED, f"{MIGRATIONS}\n")


def migrate_look():
    """The look a desktop last sent the app (app/look/look.json) as a theme
    of your own (custom_themes), "<its name> (yours)": its colors exactly as
    the app wore them, its terminals' size and opacity, its wallpaper, and
    its font when that isn't one of amarchy's. Picked, with its font, unless
    you had picked a theme of amarchy's in the app; its chimes too, unless
    you had picked those. Claude Code's colors stay as they were (the
    desktop's look never had them here)."""
    old = APP / "look"
    try:
        desk = json.loads((old / "look.json").read_text())
    except (OSError, ValueError):
        desk = None
    variables = desk.get("vars") if isinstance(desk, dict) and isinstance(desk.get("vars"), dict) else None
    if variables:
        name = re.sub(r"[^\w .'+-]", "", str(desk.get("name") or "")).strip()[:40] or "Your desktop's"
        key = (slug(name) or "desktop") + "-yours"
        files = desk.get("files") if isinstance(desk.get("files"), dict) else {}
        d = CUSTOM / key
        shutil.rmtree(d, ignore_errors=True)
        d.mkdir(parents=True)

        def keep(what, as_name):
            """A file of the old look, kept under the theme as as_name (its
            own extension): the name it got, or None."""
            src = old / Path(str(files.get(what) or "")).name if files.get(what) else None
            m = re.search(r"\.(jpg|png|webp|ttf|otf|woff2?)$", src.name) if src else None
            if not m or not src.is_file():
                return None
            shutil.copyfile(src, d / f"{as_name}.{m.group(1)}")
            return f"{as_name}.{m.group(1)}"
        phone = keep("wallpaper", "wallpaper")
        wide = keep("wallpaper-wide", "wallpaper-wide") or (keep("wallpaper", "wallpaper-wide") if phone else None)
        family = str(desk.get("family") or "")
        ours = next((k for k, (_, f) in LOOK_FONTS.items() if f and f == family), None)
        fonts = {w: f for w in ("regular", "bold") for f in [None if ours else keep(w, w)] if f}
        term = desk.get("terminal") if isinstance(desk.get("terminal"), dict) else {}
        write_file(d / "theme.json", json.dumps({
            "name": f"{name} (yours)", "mode": desk.get("mode") if desk.get("mode") in ("light", "dark") else "dark",
            "vars": look_tokens(variables),
            "terminal": {k: term[k] for k in ("size", "alpha") if isinstance(term.get(k), (int, float))},
            "wallpaper": {"phone": phone, "wide": wide} if phone else None,
            "font": {"family": family, "nerd": bool(desk.get("nerd")), "files": fonts} if fonts else None,
            "from": "the look your Omarchy desktop sent the app"}, indent=1))
        choice = look_choice()
        theme = font = own = None
        # What showed was the desktop's look until a theme of amarchy's was picked.
        if choice.get("theme") in (None, "desktop"):
            theme = key
            if "font" not in choice:
                font = ours or (f"custom-{key}" if fonts else LOOK_FONT)
        # Your own wallpaper was the desktop's, until you chose a picture.
        if choice.get("wallpaper") == "own" and not look_own() and phone:
            own = ((d / phone).read_bytes(), (d / wide).read_bytes())
        look = look_set(theme, font, own=own, claude=False)
        if isinstance(look, str):
            print(f"amarchy: couldn't keep the desktop's look: {look}", file=sys.stderr)
        for f, k in ((SOUND_FILE, "sound"), (ASSISTANT_SOUND_FILE, "assistant_sound")):
            sound = desk.get(k)
            if not f.exists() and isinstance(sound, str) and (sound == "off" or sound in CHIMES):
                write_file(f, sound + "\n")
    shutil.rmtree(old, ignore_errors=True)


# ------------------------------------------------------------------ the chat engine (amarchy agent)
#
# Phase A1 of docs/plan-chat-app.md, experimental and for test sessions only
# (a session named test-...). A session's engine is "terminal" (Claude Code's
# TUI, as every session runs today) or "chat": then its Claude pane runs
# `amarchy agent <id>`, a broker around `claude -p` with stream-json in and
# out (the control protocol the Agent SDKs speak; docs/agent-protocol.md has
# what it does, checked by bin/amarchy-protocol-test). The broker:
#
# - keeps Claude's conversation where the TUI keeps it (the same transcript,
#   --resume both ways), with amarchy's hooks, so the list, the app's chat,
#   sleep and send see a session as they always have;
# - writes live.json beside it: what the transcript can't have yet (state,
#   the questions and permissions waiting, the text being written, the tool
#   under way, background tasks, usage limits, model and mode, the messages
#   queued for Claude);
# - listens on a unix socket for messages, answers, Stop and the rest
#   (agent_call), one JSON line each way;
# - draws the conversation as it goes in its tmux pane, and takes what's
#   typed or pasted there (the app's composer, amarchy send) as a message, or
#   as the answer to what Claude asks.
#
# Claude runs with the subscription login: ANTHROPIC_API_KEY and
# ANTHROPIC_AUTH_TOKEN never reach it (with one, -p bills that API account).

AGENT_ARGS = ("-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
              "--include-partial-messages", "--include-hook-events", "--replay-user-messages",
              "--permission-prompt-tool", "stdio")
API_CREDENTIALS = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")
AGENT_LIVE_EVERY = 0.15     # seconds between two writes of live.json while text streams in
AGENT_STREAM_MAX = 20_000_000   # bytes of stream.jsonl (Claude's raw output) kept, the older half dropped
AGENT_MODES = ("default", "acceptEdits", "plan", "auto", "dontAsk", "bypassPermissions")


def engine(s):
    """How a session's Claude runs: "terminal" (the TUI) or "chat" (amarchy agent)."""
    return "chat" if s.get("engine") == "chat" else "terminal"


def agent_allowed(s):
    """Whether a session may run on the chat engine yet: only test sessions."""
    return s["name"].startswith("test-")


def agent_live_file(sid):
    return claude_dir(sid) / "live.json"


def agent_socket(sid):
    """The broker's socket: beside its state, unless that path is too long for
    a unix socket (108 bytes), then in the runtime folder."""
    p = claude_dir(sid) / "agent.sock"
    if len(str(p).encode()) < 100:
        return p
    run = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
    return run / f"amarchy-agent-{hashlib.sha1(sid.encode()).hexdigest()[:16]}.sock"


def agent_live(sid):
    try:
        return json.loads(agent_live_file(sid).read_text())
    except (OSError, ValueError):
        return {}


def agent_up(sid):
    """Whether the session's broker is running (its live state says its pid, and that's it)."""
    live = agent_live(sid)
    pid = live.get("pid")
    return bool(isinstance(pid, int) and live.get("state") != "exited" and Path(f"/proc/{pid}").exists()
                and sid in cmdline(pid))


def agent_call(sid, request, timeout=40):
    """Ask the session's broker something: the answer (a dict, "ok" true or
    false with "error"). Raises OSError when it isn't there."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
        c.settimeout(timeout)
        c.connect(str(agent_socket(sid)))
        c.sendall((json.dumps(request) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = c.recv(65536)
            if not chunk:
                break
            data += chunk
    try:
        return json.loads(data)
    except ValueError:
        return {"ok": False, "error": "no answer from the broker"}


def claude_resume(s):
    """How a session's Claude picks its conversation back up: the one it was
    in, else the latest in its folder (sessions from before amarchy kept
    track), else none."""
    if transcript(s):
        return ["--resume", conversation_id(s["id"])]
    return ["--continue"] if has_conversation(s["path"]) else []


def agent_argv(s):
    """claude -p for the session's broker: the protocol, the user's own
    claude arguments, its conversation, amarchy's hooks; messages from other
    sessions accepted whatever permission mode they run in (else a -p
    Claude holds them, and drops them unseen: docs/agent-protocol.md)."""
    settings = json.loads(hook_settings(s["id"]))
    settings["crossSessionInbound"] = "accept"
    return ["claude", *AGENT_ARGS, *CLAUDE_ARGS, *claude_resume(s), "--settings", json.dumps(settings)]


def agent_env():
    env = {k: v for k, v in os.environ.items() if k not in INHERITED_CLAUDE_ENV + API_CREDENTIALS}
    env["PATH"] = paste_path()
    return env


def agent_status(sid, state):
    """The session's status, as its hooks set it (cmd_hook), for what Claude's
    hooks don't say under -p: that it waits for an answer, and that it's
    working again once it has one."""
    try:
        prev = (STATUS / sid).read_text().strip()
    except OSError:
        prev = ""
    if prev != state and session(sid):
        (STATUS / sid).write_text(state)


def tool_line(name, given):
    """A tool call in a few words, for the pane: what Claude says it does, or
    the gist of its input."""
    given = given if isinstance(given, dict) else {}
    what = (given.get("description") or given.get("file_path") or given.get("to") or given.get("path") or given.get("pattern")
            or given.get("query") or given.get("url") or given.get("command") or given.get("prompt") or "")
    what = " ".join(str(what).split())
    return f"{name}: {what}" if what else name


class Agent:
    """The broker of one session: its claude -p, live state, socket and pane."""

    def __init__(self, s):
        self.s, self.sid = s, s["id"]
        self.lock = threading.RLock()
        self.write_lock = threading.Lock()
        self.live_lock = threading.Lock()
        self.dir = claude_dir(self.sid)
        self.sock_path = agent_socket(self.sid)
        self.live = {"pid": os.getpid(), "claude_pid": None, "state": "starting", "since": time.time(),
                     "conversation": conversation_id(self.sid) or None, "model": None, "permission_mode": None,
                     "pending": [], "partial": "", "thinking": False, "activity": None, "tasks": [],
                     "queue": [], "rate_limits": {}, "turns": 0, "cost_usd": 0.0, "last_result": None,
                     "account": None, "version": None, "socket": str(self.sock_path), "error": None}
        self.waiting = {}           # our control requests: request_id -> [threading.Event, response]
        self.watchers = []
        self.busy = False           # Claude is in a turn (ours, or one it took on its own)
        self.dirty = threading.Event()
        self.done = threading.Event()
        self.at_line_start = True
        self.typed = []             # a paste arriving in the pane, line by line
        self.pasting = False
        self.answers = {}           # AskUserQuestion answered in the pane so far: request_id -> {question: answer}

    # ---- output to the pane

    def out(self, text, dim=False, newline=True):
        with self.write_lock:
            if not self.at_line_start and newline:
                sys.stdout.write("\n")
            sys.stdout.write(f"\033[2m{text}\033[0m" if dim else text)
            if newline:
                sys.stdout.write("\n")
            self.at_line_start = newline or text.endswith("\n")
            sys.stdout.flush()

    # ---- live state

    def changed(self, now=False):
        self.dirty.set()
        if now:
            self.flush_live()

    def flush_live(self):
        with self.live_lock:
            with self.lock:
                self.live["updated"] = time.time()
                data = json.dumps(self.live)
            write_file(agent_live_file(self.sid), data)

    def live_writer(self):
        while not self.done.is_set():
            if self.dirty.wait(0.5):
                self.dirty.clear()
                self.flush_live()
                time.sleep(AGENT_LIVE_EVERY)

    def set_state(self):
        """state from what's known: waiting (something asked), working, idle."""
        with self.lock:
            if self.live["state"] in ("starting", "exited"):
                return
            state = "waiting" if self.live["pending"] else "working" if self.busy else "idle"
            if state == self.live["state"]:
                return
            self.live["state"] = state
        if state == "waiting":
            agent_status(self.sid, "waiting")
        elif state == "working":
            agent_status(self.sid, "working")
        self.changed(True)

    # ---- talking to claude

    def write(self, o):
        line = json.dumps(o) + "\n"
        with self.write_lock:
            self.claude.stdin.write(line)
            self.claude.stdin.flush()
        self.log({"_sent": o})

    def control(self, request, timeout=30):
        """A control request to Claude, and its response (a dict with
        subtype success or error)."""
        rid = str(uuid.uuid4())
        slot = [threading.Event(), None]
        with self.lock:
            self.waiting[rid] = slot
        self.write({"type": "control_request", "request_id": rid, "request": request})
        if not slot[0].wait(timeout):
            with self.lock:
                self.waiting.pop(rid, None)
            return {"subtype": "error", "error": f"Claude didn't answer {request.get('subtype')} in {timeout}s"}
        return slot[1]

    def send(self, content, when="idle", uid=None):
        """A message for Claude: queued here until Claude is free (when
        "idle"), or handed to Claude now, taken into the turn under way
        ("next") or ending it ("now")."""
        uid = uid or str(uuid.uuid4())
        if isinstance(content, str):
            content = content.replace("\r\n", "\n").strip("\n")
        message = {"uuid": uid, "content": content, "at": time.time()}
        with self.lock:
            if when == "idle" and (self.busy or self.live["pending"] or self.live["queue"]
                                   or self.live["state"] == "starting"):
                self.live["queue"].append(message)
                self.changed(True)
                return {"ok": True, "uuid": uid, "queued": True}
        self.deliver(message, None if when == "idle" else when)
        return {"ok": True, "uuid": uid, "queued": False}

    def deliver(self, message, priority=None):
        with self.lock:
            self.busy = True
        self.write({"type": "user", "message": {"role": "user", "content": message["content"]},
                    "parent_tool_use_id": None, "session_id": "", "uuid": message["uuid"],
                    **({"priority": priority} if priority else {})})
        self.set_state()

    def next_queued(self):
        """Claude is free: the oldest queued message goes in."""
        with self.lock:
            if self.busy or self.live["pending"] or not self.live["queue"] or self.live["state"] == "starting":
                return
            message = self.live["queue"].pop(0)
        self.deliver(message)
        self.changed()

    def answer(self, request_id, response):
        """Settle one of Claude's requests (a permission, a question, a plan)."""
        with self.lock:
            pending = next((p for p in self.live["pending"] if p["request_id"] == request_id), None)
            if not pending:
                return {"ok": False, "error": f"nothing waits for an answer as {request_id}"}
            self.live["pending"].remove(pending)
        self.write({"type": "control_response", "response": {"subtype": "success", "request_id": request_id,
                                                             "response": response}})
        verdict = response.get("behavior", "?")
        self.out(f"  ↳ {'allowed' if verdict == 'allow' else 'not allowed'}"
                 f"{': ' + response['message'] if response.get('message') else ''}", dim=True)
        self.set_state()
        self.changed(True)
        return {"ok": True}

    # ---- what claude says

    def log(self, o):
        try:
            f = self.dir / "stream.jsonl"
            if f.exists() and f.stat().st_size > AGENT_STREAM_MAX:
                data = f.read_bytes()
                f.write_bytes(data[len(data) // 2:].split(b"\n", 1)[-1])
            with open(f, "a") as fh:
                fh.write(json.dumps(o) + "\n")
        except OSError:
            pass

    def read_claude(self):
        for line in self.claude.stdout:
            try:
                o = json.loads(line)
            except ValueError:
                self.out(line.rstrip(), dim=True)
                continue
            self.log(o)
            try:
                self.handle(o)
            except Exception as e:      # one odd message mustn't end the session
                self.out(f"  (amarchy agent: couldn't handle a {o.get('type')} message: {e})", dim=True)
            self.broadcast(o)

    def read_claude_err(self):
        for line in self.claude.stderr:
            if line.strip():
                self.out(f"  {line.rstrip()}", dim=True)

    def handle(self, o):
        kind, sub = o.get("type"), o.get("subtype")
        live = self.live
        if kind == "control_response":
            r = o.get("response") or {}
            with self.lock:
                slot = self.waiting.pop(r.get("request_id"), None)
            if slot:
                slot[1] = r
                slot[0].set()
        elif kind == "control_request":
            self.on_request(o)
        elif kind == "control_cancel_request":
            with self.lock:
                live["pending"] = [p for p in live["pending"] if p["request_id"] != o.get("request_id")]
            self.out("  ↳ Claude withdrew its question", dim=True)
            self.set_state()
        elif kind == "system" and sub == "init":
            with self.lock:
                live.update(conversation=o.get("session_id"), model=o.get("model"),
                            permission_mode=o.get("permissionMode"), version=o.get("claude_code_version"))
            set_conversation_id(self.sid, o.get("session_id") or "")
            self.changed()
        elif kind == "system" and sub == "status":
            with self.lock:
                if "permissionMode" in o:
                    live["permission_mode"] = o["permissionMode"]
                if o.get("status") == "requesting":
                    self.busy = True
            self.set_state()
            self.changed()
        elif kind == "system" and sub == "background_tasks_changed":
            with self.lock:
                live["tasks"] = o.get("tasks") or []
            self.changed(True)
        elif kind == "system" and sub == "task_notification":
            self.out(f"  ⏺ background task {o.get('status', 'done')}: {o.get('summary') or o.get('task_id')}", dim=True)
        elif kind == "system" and sub == "compact_boundary":
            self.out("  · conversation compacted", dim=True)
        elif kind == "system" and sub == "peer_message_hold":
            self.out(f"  · a message from {o.get('from_name') or o.get('from')} was {o.get('state')}", dim=True)
        elif kind == "command_lifecycle" and o.get("state") == "started":
            with self.lock:
                self.busy = True
            self.set_state()
        elif kind == "stream_event":
            self.on_stream(o.get("event") or {})
        elif kind == "assistant":
            self.on_assistant(o)
        elif kind == "user":
            self.on_user(o)
        elif kind == "rate_limit_event":
            info = o.get("rate_limit_info") or {}
            with self.lock:
                live["rate_limits"] = info
            self.changed()
        elif kind == "result":
            self.on_result(o)

    def on_request(self, o):
        req = o.get("request") or {}
        if req.get("subtype") != "can_use_tool":
            # Nothing else was declared in initialize (hooks, MCP servers,
            # dialogs): say so, so Claude doesn't wait on it.
            self.write({"type": "control_response", "response": {
                "subtype": "error", "request_id": o.get("request_id"),
                "error": f"amarchy agent doesn't handle {req.get('subtype')}"}})
            return
        pending = {"request_id": o["request_id"], "tool": req.get("tool_name"), "input": req.get("input") or {},
                   "description": req.get("description") or req.get("display_name"),
                   "suggestions": req.get("permission_suggestions") or [], "reason": req.get("decision_reason"),
                   "tool_use_id": req.get("tool_use_id"), "at": time.time()}
        with self.lock:
            self.live["pending"].append(pending)
        self.draw_request(pending)
        self.set_state()
        self.changed(True)

    def draw_request(self, p):
        tool, given = p["tool"], p["input"]
        if tool == "AskUserQuestion":
            for q in given.get("questions") or []:
                self.out(f"\n  \033[1m? {q.get('question')}\033[0m" + ("  (several: 1,3)" if q.get("multiSelect") else ""))
                for i, opt in enumerate(q.get("options") or [], 1):
                    self.out(f"    {i}. {opt.get('label')}" + (f" \033[2m{opt.get('description')}\033[0m"
                                                              if opt.get("description") else ""))
            self.out("  Type the number of your answer (one question at a time), or your own words.", dim=True)
        elif tool == "ExitPlanMode":
            self.out("\n  \033[1m? Claude's plan:\033[0m")
            for line in str(given.get("plan") or "").splitlines():
                self.out(f"    {line}")
            self.out("  y: approve and start · n <what to change>: keep planning", dim=True)
        else:
            self.out(f"\n  \033[1m? Claude wants to use {tool_line(tool, given)}\033[0m")
            if p["reason"]:
                self.out(f"    {p['reason']}", dim=True)
            self.out("  y: allow · a: always allow · n [why]: don't allow", dim=True)

    def on_stream(self, ev):
        t = ev.get("type")
        if t == "message_start":
            with self.lock:
                self.busy = True
                self.live["partial"] = ""
            self.set_state()
        elif t == "content_block_start":
            block = ev.get("content_block") or {}
            with self.lock:
                self.live["thinking"] = block.get("type") == "thinking"
                if block.get("type") == "text":
                    self.live["partial"] = ""
            if block.get("type") == "text" and not self.at_line_start:
                self.out("")
            self.changed()
        elif t == "content_block_delta":
            delta = ev.get("delta") or {}
            if delta.get("type") == "text_delta":
                text = delta.get("text") or ""
                with self.lock:
                    self.live["partial"] += text
                self.out(text, newline=False)
                self.changed()
        elif t == "content_block_stop":
            with self.lock:
                self.live["thinking"] = False
            self.changed()

    def on_assistant(self, o):
        if o.get("parent_tool_use_id"):
            return      # a subagent's: its Agent call says what it's about
        for block in o["message"].get("content") or []:
            if block.get("type") == "text":
                with self.lock:
                    self.live["partial"] = ""
                self.changed()
            elif block.get("type") == "tool_use":
                with self.lock:
                    self.live["activity"] = {"tool": block.get("name"), "input": block.get("input"),
                                             "id": block.get("id"), "since": time.time()}
                if block.get("name") not in ("ToolSearch",):
                    self.out(f"  ⏺ {tool_line(block.get('name'), block.get('input'))}"[:400], dim=True)
                self.changed()
        if not self.at_line_start:
            self.out("", newline=True)

    def on_user(self, o):
        content = o["message"].get("content")
        if o.get("isReplay") or isinstance(content, str):
            # What went in to Claude: ours, or a message from another session.
            text = content if isinstance(content, str) else " ".join(
                b.get("text", "") if b.get("type") == "text" else f"[{b.get('type')}]" for b in content or [])
            m = re.fullmatch(r"\s*<local-command-std(?:out|err)>(.*)</local-command-std(?:out|err)>\s*", text, re.S)
            if m:
                self.out(f"  · {m.group(1).strip()}", dim=True)
            elif text.strip():
                self.out(f"\n\033[1m› {text.strip()}\033[0m\n")
            return
        for block in content if isinstance(content, list) else []:
            if block.get("type") == "tool_result":
                with self.lock:
                    act = self.live["activity"]
                    if act and act.get("id") == block.get("tool_use_id"):
                        self.live["activity"] = None
                if block.get("is_error") and not o.get("parent_tool_use_id"):
                    first = json.dumps(block.get("content"))[:160] if not isinstance(block.get("content"), str) \
                        else block["content"].splitlines()[0][:160] if block["content"] else ""
                    self.out(f"    ✗ {first}", dim=True)
                self.changed()

    def on_result(self, o):
        with self.lock:
            self.busy = False
            self.live["turns"] += 1
            self.live["activity"] = None
            self.live["partial"] = ""
            self.live["cost_usd"] = round(self.live["cost_usd"] + float(o.get("total_cost_usd") or 0), 6)
            self.live["last_result"] = {k: o.get(k) for k in ("subtype", "is_error", "duration_ms", "num_turns",
                                                               "total_cost_usd", "stop_reason", "session_id")}
            if o.get("session_id"):
                self.live["conversation"] = o["session_id"]
        set_conversation_id(self.sid, o.get("session_id") or "")
        took = (o.get("duration_ms") or 0) / 1000
        note = "interrupted" if o.get("subtype") == "error_during_execution" else (
            "error: " + str(o.get("result") or o.get("subtype")) if o.get("is_error") else "done")
        self.out(f"  · {note} · {took:.1f}s", dim=True)
        self.set_state()
        self.changed(True)
        self.next_queued()

    # ---- watchers on the socket

    def broadcast(self, o):
        if not self.watchers:
            return
        line = (json.dumps(o) + "\n").encode()
        with self.lock:
            watchers = list(self.watchers)
        for w in watchers:
            try:
                w.sendall(line)
            except OSError:
                with self.lock:
                    if w in self.watchers:
                        self.watchers.remove(w)

    # ---- the socket

    def serve(self):
        self.sock_path.unlink(missing_ok=True)
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(str(self.sock_path))
        os.chmod(self.sock_path, 0o600)
        self.server.listen(16)
        while not self.done.is_set():
            try:
                conn, _ = self.server.accept()
            except OSError:
                break
            threading.Thread(target=self.client, args=(conn,), daemon=True).start()

    def client(self, conn):
        keep = False
        try:
            data = b""
            while not data.endswith(b"\n") and len(data) < 32_000_000:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
            try:
                request = json.loads(data)
                if not isinstance(request, dict):
                    raise ValueError
            except ValueError:
                request = {}
            if request.get("op") == "watch":
                conn.sendall((json.dumps({"ok": True, "live": self.live}) + "\n").encode())
                with self.lock:
                    self.watchers.append(conn)
                keep = True
                return
            try:
                answer = self.op(request)
            except Exception as e:
                answer = {"ok": False, "error": f"{type(e).__name__}: {e}"}
            conn.sendall((json.dumps(answer) + "\n").encode())
        except OSError:
            pass
        finally:
            if not keep:
                conn.close()

    def op(self, r):
        """One request on the socket: its answer."""
        op = r.get("op")
        if op == "state":
            with self.lock:
                return {"ok": True, "live": dict(self.live)}
        if self.live["state"] == "exited":
            return {"ok": False, "error": "Claude isn't running"}
        if op == "send":
            content = r.get("content")
            if not (isinstance(content, str) and content.strip()) and not (isinstance(content, list) and content):
                return {"ok": False, "error": "nothing to send"}
            when = r.get("when") or "idle"
            if when not in ("idle", "next", "now", "later"):
                return {"ok": False, "error": f"when is idle, next, now or later, not {when!r}"}
            return self.send(content, "idle" if when == "idle" else when, r.get("uuid"))
        if op == "unqueue":
            with self.lock:
                before = len(self.live["queue"])
                self.live["queue"] = [m for m in self.live["queue"] if m["uuid"] != r.get("uuid")]
                gone = before != len(self.live["queue"])
            self.changed(True)
            return {"ok": gone, **({} if gone else {"error": "no such message waiting"})}
        if op == "answer":
            response = r.get("response")
            if not isinstance(response, dict) or response.get("behavior") not in ("allow", "deny"):
                return {"ok": False, "error": "response is {behavior: allow|deny, ...}"}
            with self.lock:
                p = next((p for p in self.live["pending"] if p["request_id"] == r.get("request_id")), None)
            if p and response["behavior"] == "allow" and "updatedInput" not in response:
                response = {**response, "updatedInput": p["input"]}
            if response["behavior"] == "deny" and not response.get("message"):
                response = {**response, "message": "The user doesn't want to proceed with this tool use."}
            return self.answer(r.get("request_id"), response)
        if op == "interrupt":
            res = self.control({"subtype": "interrupt", **({"cancel_queued": True} if r.get("everything") else {})})
            if r.get("everything"):
                with self.lock:
                    self.live["queue"] = []
                self.changed(True)
            return {"ok": res.get("subtype") == "success", "response": res.get("response"), "error": res.get("error")}
        if op == "control":
            request = r.get("request")
            if not isinstance(request, dict) or not request.get("subtype"):
                return {"ok": False, "error": "request is {subtype: ..., ...}"}
            res = self.control(request, timeout=float(r.get("timeout") or 30))
            ok = res.get("subtype") == "success"
            if ok and request["subtype"] == "set_permission_mode":
                with self.lock:
                    self.live["permission_mode"] = request.get("mode")
                self.changed(True)
            if ok and request["subtype"] == "set_model":
                with self.lock:
                    self.live["model"] = (res.get("response") or {}).get("model") or request.get("model")
                self.changed(True)
            return {"ok": ok, "response": res.get("response"), "error": res.get("error")}
        if op == "stop":
            threading.Thread(target=self.stop, daemon=True).start()
            return {"ok": True}
        return {"ok": False, "error": f"unknown op {op!r}"}

    # ---- the pane's keyboard

    def read_tty(self):
        """What's typed in the pane: a message for Claude, or the answer to
        what it asks. A paste (the app's composer, amarchy send) arrives
        bracketed, so its lines stay one message."""
        for line in sys.stdin:
            line = line.rstrip("\n")
            if "\033[200~" in line:
                self.pasting = True
                line = line.replace("\033[200~", "")
            if "\033[201~" in line:
                self.pasting = False
                line = line.replace("\033[201~", "")
            self.typed.append(line)
            if self.pasting:
                continue
            text, self.typed = "\n".join(self.typed).strip("\n"), []
            if text.strip():
                try:
                    self.typed_text(text)
                except OSError:
                    break

    def typed_text(self, text):
        with self.lock:
            p = self.live["pending"][0] if self.live["pending"] else None
        if not p:
            self.send(text)
            return
        word, _, rest = text.strip().partition(" ")
        word = word.lower()
        if p["tool"] == "AskUserQuestion":
            # One question at a time, in order; the last answer sends them all.
            questions = p["input"].get("questions") or []
            got = self.answers.setdefault(p["request_id"], {})
            q = next((q for q in questions if q.get("question") not in got), None)
            if q:
                opts = q.get("options") or []
                picks = [x.strip() for x in text.split(",")]
                chosen = [opts[int(x) - 1]["label"] for x in picks if x.isdigit() and 0 < int(x) <= len(opts)]
                got[q.get("question")] = ", ".join(chosen) if chosen and len(chosen) == len(picks) else text.strip()
            left = [q for q in questions if q.get("question") not in got]
            if left:
                self.out(f"  next: {left[0].get('question')}", dim=True)
                return
            self.answers.pop(p["request_id"], None)
            self.answer(p["request_id"], {"behavior": "allow", "updatedInput": {**p["input"], "answers": got}})
        elif word in ("y", "yes"):
            self.answer(p["request_id"], {"behavior": "allow", "updatedInput": p["input"]})
        elif word in ("a", "always"):
            rules = [x for x in p["suggestions"] if x.get("type") == "addRules"] or p["suggestions"]
            self.answer(p["request_id"], {"behavior": "allow", "updatedInput": p["input"], "updatedPermissions": rules})
        elif word in ("n", "no"):
            self.answer(p["request_id"], {"behavior": "deny", "message": rest.strip() or
                                          "The user doesn't want to proceed with this tool use."})
        else:
            self.out("  y, a or n (with why, if you like)", dim=True)

    # ---- the whole of it

    def stop(self):
        """End Claude as quitting it would; run() then returns."""
        try:
            self.claude.stdin.close()
        except (OSError, AttributeError):
            pass
        try:
            self.claude.terminate()
            self.claude.wait(8)
        except subprocess.TimeoutExpired:
            self.claude.kill()
        except AttributeError:
            pass

    def run(self):
        s = self.s
        self.dir.mkdir(parents=True, exist_ok=True)
        # One broker per session: one going (its pane restarted) has a few
        # seconds to let its Claude go.
        lock = open(self.dir / "agent.lock", "a")
        end = time.time() + 15
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.time() > end:
                    print(f"\n  amarchy agent: another broker runs {self.sid} already\n", flush=True)
                    return 1
                time.sleep(0.2)
        path = Path(s["path"])
        os.chdir(path)
        os.environ["PWD"] = str(path)
        prompt = s.pop("prompt", None)
        if prompt is not None:
            save_session(s)
        sent = take(self.dir / "send")
        first = [m for m in (prompt, sent) if m is not None and m.strip()]
        if sys.stdin.isatty():
            sh("stty", "sane", "-echoctl")      # raw from the sleep loop's wait for a key; a paste's end unseen
            print("\033[H\033[2J\033[3J", end="")
        print(f"\033]0;{s['repo']} · {s['name']}\007", end="")
        self.out(f"\n  \033[1m{s['repo']} · {s['name']}\033[0m \033[2m· Claude Code on amarchy's chat engine "
                 f"(experimental)\033[0m\n")
        argv = agent_argv(s)
        try:
            self.claude = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                           text=True, bufsize=1, env=agent_env(), cwd=path,
                                           start_new_session=True)    # the pane's Ctrl+C is ours (Stop), not its
        except OSError as e:
            self.out(f"  \033[31mCouldn't start Claude Code: {e}\033[0m")
            return 1
        self.live["claude_pid"] = self.claude.pid
        self.flush_live()
        for target in (self.read_claude, self.read_claude_err, self.serve, self.live_writer):
            threading.Thread(target=target, daemon=True).start()
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, lambda *_: threading.Thread(target=self.stop, daemon=True).start())
        # Ctrl+C in the pane stops the turn, as Esc does in the TUI.
        signal.signal(signal.SIGINT, lambda *_: threading.Thread(
            target=lambda: self.busy and self.control({"subtype": "interrupt"}), daemon=True).start())
        info = self.control({"subtype": "initialize"}, timeout=60)
        if info.get("subtype") == "success":
            r = info.get("response") or {}
            write_file(self.dir / "agent.json", json.dumps({k: r.get(k) for k in (
                "commands", "models", "agents", "account", "output_style", "claude_code_version")}))
            with self.lock:
                self.live.update(account=r.get("account"), version=r.get("claude_code_version"),
                                 permission_mode=r.get("current_permission_mode"), state="idle")
            agent_status(self.sid, "idle")
        else:
            with self.lock:
                self.live.update(state="idle", error=info.get("error"))
            self.out(f"  {info.get('error')}", dim=True)
        self.changed(True)
        for text in first:
            self.send(text)
        self.next_queued()
        if sys.stdin.isatty():
            sys.stdout.write("\033[?2004h")     # pastes come bracketed (read_tty)
            sys.stdout.flush()
            threading.Thread(target=self.read_tty, daemon=True).start()
        code = self.claude.wait()
        self.done.set()
        with self.lock:
            self.live.update(state="exited", pending=[], partial="", activity=None, exit_code=code)
            queued = self.live["queue"]
        if queued:
            # Not sent yet: the next Claude of this session starts with them.
            write_file(self.dir / "send", "\n\n".join(m["content"] for m in queued if isinstance(m["content"], str)))
        self.flush_live()
        try:
            self.server.close()
        except AttributeError:
            pass
        self.sock_path.unlink(missing_ok=True)
        self.out(f"  · Claude Code exited ({code})", dim=True)
        return 0


def cmd_agent(args):
    """amarchy agent <id> (the broker, in a session's Claude pane), or one of
    its commands for a session on the chat engine (see usage)."""
    if not args:
        print(usage("agent"), file=sys.stderr)
        return 1
    commands = ("engine", "state", "send", "answer", "interrupt", "mode", "model", "watch", "control")
    if args[0] not in commands:
        if len(args) != 1:
            print(usage("agent"), file=sys.stderr)
            return 1
        s = session(args[0])
        if not s:
            return fail(f"no session {args[0]!r}")
        if not agent_allowed(s):
            return fail(f"{s['id']}: the chat engine is for test sessions only (named test-...) for now")
        return Agent(s).run()
    cmd, rest = args[0], args[1:]
    if not rest:
        print(usage("agent"), file=sys.stderr)
        return 1
    s = session(rest[0])
    if not s:
        return fail(f"no session {rest[0]!r}")
    sid, rest = s["id"], rest[1:]
    if cmd == "engine":
        if not rest:
            print(engine(s))
            return 0
        want = rest[0]
        if want not in ("chat", "terminal") or len(rest) > 1:
            return fail("amarchy agent engine <id> [chat|terminal]")
        if want == "chat" and not agent_allowed(s):
            return fail(f"{sid}: the chat engine is for test sessions only (named test-...) for now")
        if engine(s) == want:
            print(want)
            return 0
        try:
            status = (STATUS / sid).read_text().strip()
        except OSError:
            status = "idle"
        if status in ("working", "waiting") and "--force" not in rest:
            return fail(f"{sid} is {status}: switch when it's idle")
        s["engine"] = want
        if want == "terminal":
            s.pop("engine")
        save_session(s)
        # Its Claude pane starts again on the other engine, with the same conversation.
        pane = host_pane(s)
        if pane and asleep_since(sid) is None and not s.get("setup"):
            stop_claude(pane)
            if want == "terminal" and agent_up(sid):
                try:
                    agent_call(sid, {"op": "stop"}, timeout=5)
                except OSError:
                    pass
            host_respawn(s)
        print(want)
        return 0
    if engine(s) != "chat":
        return fail(f"{sid} runs on the terminal engine (amarchy agent engine {sid} chat, for a test session)")
    if cmd == "state":
        print(json.dumps(agent_live(sid), indent=1))
        return 0
    if not agent_up(sid):
        return fail(f"{sid}: its broker isn't running (asleep? amarchy wake {sid})")
    if cmd == "watch":
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.connect(str(agent_socket(sid)))
            c.sendall(b'{"op": "watch"}\n')
            try:
                for line in c.makefile():
                    print(line, end="", flush=True)
            except KeyboardInterrupt:
                pass
        return 0
    if cmd == "send":
        when = "idle"
        for flag in ("--now", "--next", "--later"):
            if flag in rest:
                rest.remove(flag)
                when = flag[2:]
        if len(rest) != 1:
            return fail("amarchy agent send <id> <text|-> [--next|--now|--later]")
        text = sys.stdin.read() if rest[0] == "-" else rest[0]
        request = {"op": "send", "content": text, "when": when}
    elif cmd == "answer":
        if len(rest) < 2:
            return fail("amarchy agent answer <id> <request id> allow|always|deny [why] | --json <response>")
        rid, verdict = rest[0], rest[1]
        if verdict == "--json":
            try:
                response = json.loads(rest[2])
            except (IndexError, ValueError):
                return fail("--json takes the response, e.g. '{\"behavior\": \"allow\"}'")
        elif verdict in ("allow", "always"):
            response = {"behavior": "allow"}
            if verdict == "always":
                p = next((p for p in agent_live(sid).get("pending") or [] if p["request_id"] == rid), None)
                rules = [x for x in (p or {}).get("suggestions") or [] if x.get("type") == "addRules"]
                response["updatedPermissions"] = rules
        elif verdict == "deny":
            response = {"behavior": "deny", "message": " ".join(rest[2:])}
        else:
            return fail(f"allow, always or deny, not {verdict!r}")
        request = {"op": "answer", "request_id": rid, "response": response}
    elif cmd == "interrupt":
        request = {"op": "interrupt", "everything": "--all" in rest}
    elif cmd == "mode":
        if len(rest) != 1 or rest[0] not in AGENT_MODES:
            return fail(f"amarchy agent mode <id> {'|'.join(AGENT_MODES)}")
        request = {"op": "control", "request": {"subtype": "set_permission_mode", "mode": rest[0]}}
    elif cmd == "model":
        if len(rest) != 1:
            return fail("amarchy agent model <id> <model>")
        request = {"op": "control", "request": {"subtype": "set_model", "model": rest[0]}}
    else:   # control
        try:
            request = {"op": "control", "request": json.loads(rest[0])}
        except (IndexError, ValueError):
            return fail("amarchy agent control <id> '<control request as JSON>'")
    try:
        answer = agent_call(sid, request)
    except OSError as e:
        return fail(f"{sid}: no answer from its broker: {e}")
    print(json.dumps(answer))
    return 0 if answer.get("ok") else 1


# ------------------------------------------------------------------ main

# What each command takes, for `amarchy <command> --help` and for catching an
# option it doesn't know before it acts on it: `close --help` would otherwise
# close the session, `new --help` start one named --help. Flags are the
# options it knows; values, those that take the next word (skipped when
# checking); text, those after which the rest is free text (a command, a
# prompt), left alone. Commands with None are plumbing whose arguments come
# from amarchy itself or from Claude Code: only a first --help is theirs (none for editor).
OPTIONS = {
    "new": ({"--prompt", "--no-jump"}, {"--prompt"}, set()),
    "add": ({"--new", "--github"}, set(), set()),
    "projects": ({"--github", "--json"}, set(), set()),
    "list": ({"--compact"}, set(), set()),
    "close": ({"--force"}, set(), set()),
    "rename": ({"--id", "--reset"}, {"--id"}, set()),
    "run": ({"--show", "--set", "--save", "--forget", "--list"}, {"--forget"}, {"--set", "--save"}),
    "priority": ({"--id"}, {"--id"}, set()),
    "group": (set(), set(), set()),
    "sort": (set(), set(), set()),
    "order": (set(), set(), set()),
    "sleep": ({"--force", "--all", "--after", "--idle"}, {"--after"}, set()),
    "wake": (set(), set(), set()),
    "theme": ({"--show", "--list", "--json", "--font", "--wallpaper"}, {"--font", "--wallpaper"}, set()),
    "sound": ({"--show", "--list", "--json", "--assistant"}, set(), set()),
    "app": ({"--status", "--test"}, set(), set()),
    "send": ({"--no-wait", "--timeout", "--queued"}, {"--timeout", "--queued"}, set()),
    "notify": ({"--session", "--urgent"}, {"--session"}, set()),
    "assistant": ({"--name", "--picture", "--crop"}, {"--name", "--picture", "--crop"}, set()),
    "alerts": (set(), set(), set()),
    "update": ({"--auto"}, set(), set()),
    "migrate": (set(), set(), set()),
    "dictation": ({"--status", "--json"}, set(), set()),
    "claude": None, "asleep": None, "woke": None, "hook": None, "seen": None,
    "reap": None, "shorten": None, "editor": None, "attach": None, "held": None,
    "paste": None, "rec": None, "agent": None,
}
HELP = ("-h", "--help")
OLD_USAGE = {"order": "  amarchy order [opened|activity]       from before `amarchy group`: activity is "
                      "`group status on`, opened `group status off`"}


def usage(cmd):
    """The lines of this file's docstring for one command (with the ones
    continuing them), or None for a command it doesn't know."""
    lines, found, keep = __doc__.splitlines(), [], False
    for line in lines:
        words = line.split()
        if line.startswith("  amarchy ") and len(words) > 1:
            names, i = [words[1]], 2
            while i + 1 < len(words) and words[i] == "|" and re.fullmatch(r"[a-z]+", words[i + 1]):
                names.append(words[i + 1])
                i += 2
            keep = cmd in names
            if keep:
                found.append(line)
        elif keep and line.startswith(" " * 40) and line.strip():
            found.append(line)
        else:
            keep = False
    if not found and cmd in OLD_USAGE:
        found = [OLD_USAGE[cmd]]
    return "usage:\n" + "\n".join(found) if found else None


def check_args(cmd, args):
    """`--help` or `-h` for a command: its usage (0). An option it doesn't know:
    the usage on stderr (1). Otherwise None, and the command runs."""
    spec = OPTIONS.get(cmd)
    if spec is None:
        if cmd != "editor" and args[:1] and args[0] in HELP:
            print(usage(cmd))
            return 0
        return None
    flags, values, text = spec
    it = iter(args)
    for a in it:
        if a in HELP:
            print(usage(cmd))
            return 0
        name = "--prompt" if cmd == "new" and a.startswith("--prompt=") else a     # new's only --option=value
        if name in text:
            break
        if name in values and name == a:
            next(it, None)
        elif re.fullmatch(r"--[A-Za-z][\w-]*(=.*)?", a) and name not in flags:
            print(f"amarchy {cmd}: unknown option {name}\n{usage(cmd)}", file=sys.stderr)
            return 1
    return None


def cmd_help(args):
    """`amarchy help [command]`: everything, or one command's usage."""
    if not args:
        print(__doc__)
        return 0
    cmd = args[0]
    text = usage(cmd) if cmd in OPTIONS else None
    if not text:
        return fail(f"unknown command {args[0]!r} (amarchy help lists them)")
    print(text)
    return 0


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("help", [])
    if cmd in ("help", *HELP):
        return cmd_help(args)
    if cmd not in OPTIONS:
        return fail(f"unknown command {cmd!r} (amarchy help lists them)")
    checked = check_args(cmd, args)
    if checked is not None:
        return checked
    if cmd == "new":
        return cmd_new(args)
    elif cmd == "add":
        return cmd_add(args)
    elif cmd == "projects":
        return cmd_projects(args)
    elif cmd == "close":
        return cmd_close(args)
    elif cmd == "rename":
        return cmd_rename(args)
    elif cmd == "priority":
        return cmd_priority(args)
    elif cmd == "list":
        print(json.dumps(session_view(), indent=None if "--compact" in args else 2))
    elif cmd == "run":
        return cmd_run(args)
    elif cmd == "theme":
        return cmd_theme(args)
    elif cmd == "sound":
        return cmd_sound(args)
    elif cmd == "group":
        return cmd_group(args)
    elif cmd == "sort":
        return cmd_sort(args)
    elif cmd == "order":
        return cmd_order(args)
    elif cmd == "hook" and len(args) == 2:
        cmd_hook(*args)
    elif cmd == "seen" and len(args) == 1:
        return cmd_seen(args[0])
    elif cmd == "sleep":
        return cmd_sleep(args)
    elif cmd == "wake":
        return cmd_wake(args)
    elif cmd == "reap" and len(args) == 1:
        return cmd_reap(args[0])
    elif cmd == "claude" and len(args) == 1:
        return cmd_claude(args[0])
    elif cmd == "shorten" and len(args) == 2:
        return cmd_shorten(*args)
    elif cmd == "asleep" and len(args) == 1:
        return cmd_asleep(args[0])
    elif cmd == "woke" and len(args) in (1, 2):
        return cmd_woke(args[0], args[1] if len(args) > 1 else "")
    elif cmd == "editor":
        return cmd_editor(args)
    elif cmd == "attach" and args:
        return cmd_attach(args)
    elif cmd == "held" and len(args) == 1:
        return cmd_held(args[0])
    elif cmd == "paste":
        return cmd_paste(args)
    elif cmd == "rec":
        return cmd_rec(args)
    elif cmd == "agent":
        return cmd_agent(args)
    elif cmd == "app":
        return cmd_app(args)
    elif cmd == "send":
        return cmd_send(args)
    elif cmd == "notify":
        return cmd_notify(args)
    elif cmd == "assistant":
        return cmd_assistant(args)
    elif cmd == "alerts":
        return cmd_alerts(args)
    elif cmd == "update" and not [a for a in args if a != "--auto"]:
        return cmd_update(args)
    elif cmd == "migrate" and not args:
        migrate()
    elif cmd == "dictation":
        return cmd_dictation(args)
    else:   # a command it knows, with the wrong number of arguments
        print(usage(cmd), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
