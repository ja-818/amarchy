def mission_goal():
    try:
        return max(0, min(50, int(MISSION_GOAL.read_text().strip())))
    except (OSError, ValueError):
        return MISSION_GOAL_DEFAULT


def mission_badges_kept():
    try:
        d = json.loads(MISSION_BADGES.read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def mission_badge(key):
    """A badge earned outside the log (five at once): kept, when first."""
    kept = mission_badges_kept()
    if key not in kept:
        kept[key] = int(time.time())
        try:
            write_file(MISSION_BADGES, json.dumps(kept))
        except OSError:
            pass


def mission_days_in_a_row(days, today):
    """How many days in a row have one (today's, or up to yesterday's while today has none)."""
    n, d = 0, today if days.get(today) else today - datetime.timedelta(days=1)
    while days.get(d):
        n, d = n + 1, d - datetime.timedelta(days=1)
    return n


def missions_lines():
    """Every machine's records (MISSIONS, and the others' learned: see "your
    stuff on every machine"), each once, from the last reset on, in the
    order they happened (a pull request's merge is written down when it's
    seen, after its time). A chat another machine names: <machine>:<id>."""
    me, since, seen, out = machine_name(), missions_reset_at(), set(), []
    for r in mission_records_own() + mission_records_learned():
        try:
            r["at"] = int(r["at"])
        except (ValueError, KeyError, TypeError):
            continue
        if r["rid"] in seen:
            continue
        seen.add(r["rid"])
        origin = rid_parts(r["rid"])[0]
        if origin and origin != me and isinstance(r.get("id"), str) and r["id"] and ":" not in r["id"] \
                and not r["id"].startswith("task:"):
            r["id"] = f"{origin}:{r['id']}"
        if r["at"] >= since:
            out.append(r)
    out.sort(key=lambda r: r["at"])
    return out


def missions_view():
    """Your score, for the app (the same on the phone and the computer): only
    merges count (merge_scan writes them down). Today's merges (chat id,
    when, its title, how long after the chat opened, a pull request's
    link), the streak (days in a row with a merge, today's or up to
    yesterday's while today has none yet), the best day before today, the
    last seven days, all of them; your daily goal; your replies today (how
    many, how many fast, the fast ones in a row); the badges (each, when
    earned or null). Read again when a file or the day changes."""
    today = datetime.date.today()
    stamp = [today]
    for f in (MISSIONS, MISSION_GOAL, MISSION_BADGES, MISSIONS_RESET, SYNC_LEARNED):
        try:
            st = f.stat()
            stamp.append((st.st_mtime_ns, st.st_size))
        except OSError:
            stamp.append(None)
    for f in sorted(SYNC_LEARNED.glob("*.jsonl")) if SYNC_LEARNED.is_dir() else []:
        try:
            st = f.stat()
            stamp.append((st.st_mtime_ns, st.st_size))
        except OSError:
            pass
    stamp = tuple(stamp)
    if _missions.get("stamp") == stamp:
        return _missions["view"]
    goal = mission_goal()
    days, clears, goals, mine, ats, earned = {}, {}, {}, [], [], dict(mission_badges_kept())
    day_repos, repos, per_chat = {}, set(), {}
    replies = {"n": 0, "fast": 0, "streak": 0, "best": 0}
    run = prs = 0
    one = datetime.timedelta(days=1)

    def earn(key, at):
        earned.setdefault(key, at)

    for r in missions_lines():
        at = r["at"]
        d = datetime.date.fromtimestamp(at)
        kind = r.get("kind") or "chat"
        if kind == "clear":
            clears[d] = True
            if mission_days_in_a_row(clears, d) >= 5:
                earn("clean", at)
            continue
        if kind == "reply":
            fast = isinstance(r.get("wait"), (int, float)) and r["wait"] <= MISSION_FAST
            run = run + 1 if fast else 0
            replies["best"] = max(replies["best"], run)
            if run >= 10:
                earn("quick", at)
            if d == today:
                replies["n"] += 1
                replies["fast"] += fast
            continue
        if kind != "merge":         # a chat completed, a task done: kept, not counted
            continue
        before = max(days, default=None)
        days[d] = days.get(d, 0) + 1
        n = days[d]
        repo = r.get("repo") or ""
        day_repos.setdefault(d, set()).add(repo)
        repos.add(repo)
        sid = r.get("id") or ""
        per_chat[sid] = per_chat.get(sid, 0) + 1
        ats.append(at)
        total = len(ats)
        took = at - int(r["created"]) if isinstance(r.get("created"), (int, float)) else None
        took = took if took and took > 0 else None
        hour = datetime.datetime.fromtimestamp(at).hour
        # Milestones
        earn("first", at)
        for k, x in (("merges10", 10), ("merges50", 50), ("century", 100), ("merges250", 250), ("merges500", 500)):
            if total >= x:
                earn(k, at)
        if r.get("via") == "pr":
            prs += 1
            earn("pr1", at)
            if prs >= 25:
                earn("pr25", at)
        if len(repos) >= 5:
            earn("polyglot", at)
        # Big days
        for k, x in (("hat", 3), ("high5", 5), ("ten", 10), ("twenty", 20)):
            if n >= x:
                earn(k, at)
        if goal and n >= goal:
            earn("goal", at)
            goals[d] = True
            if mission_days_in_a_row(goals, d) >= 5:
                earn("goalweek", at)
        if goal and n >= 2 * goal:
            earn("goal2", at)
        if len(day_repos[d]) >= 2:
            earn("repos2", at)
        if len(day_repos[d]) >= 3:
            earn("repos3", at)
        # Streaks
        streak = mission_days_in_a_row(days, d)
        for k, x in (("streak3", 3), ("streak7", 7), ("streak14", 14), ("streak30", 30)):
            if streak >= x:
                earn(k, at)
        monday = d - datetime.timedelta(days=d.weekday())
        if all(days.get(monday + datetime.timedelta(days=i)) for i in range(7)):
            earn("fullweek", at)
        if (d.weekday() == 5 and days.get(d + one)) or (d.weekday() == 6 and days.get(d - one)):
            earn("weekend", at)
        if before and before < d and (d - before).days >= 4:
            earn("comeback", at)
        # Time of day
        if hour < 5:
            earn("night", at)
        if 5 <= hour < 7:
            earn("dawn", at)
        if hour < 9:
            earn("early", at)
        if hour == 12:
            earn("lunch", at)
        if hour >= 22:
            earn("lastcall", at)
        # Speed and combos
        if took and took <= 600:
            earn("speedrun", at)
        if took and took <= 3600:
            earn("quickfix", at)
        if took and took > 86400:
            earn("marathon", at)
        k = 1
        while k < len(ats) and ats[-k] - ats[-k - 1] <= MISSION_COMBO:
            k += 1
        for key, x in (("combo3", 3), ("combo5", 5), ("combo10", 10)):
            if k >= x:
                earn(key, at)
        if per_chat[sid] >= 3:
            earn("iterate", at)
        if d == today:
            mine.append({"id": sid, "at": at, "task": r.get("task", ""), "repo": repo, "took": took,
                         "kind": "merge", "via": r.get("via") or "local", "url": r.get("url") or ""})
    replies["streak"] = run
    view = {"today": mine[-200:], "streak": mission_days_in_a_row(days, today),
            "best": max((n for k, n in days.items() if k != today), default=0),
            "week": [days.get(today - datetime.timedelta(days=i), 0) for i in range(6, -1, -1)],
            "total": sum(days.values()), "combo": MISSION_COMBO, "goal": goal,
            "clear_streak": mission_days_in_a_row(clears, today), "replies": replies, "fast": MISSION_FAST,
            "since": missions_since(),
            "badges": [{"key": k, "name": n, "about": a, "at": earned.get(k)} for k, n, a in BADGES]}
    _missions.update(stamp=stamp, view=view)
    return view


def missions_last_week(today=None):
    """Monday to Sunday before this week: {n merges, best: (day, n), replies fast}."""
    today = today or datetime.date.today()
    start = today - datetime.timedelta(days=today.weekday() + 7)
    days, fast = {}, 0
    for r in missions_lines():
        d = datetime.date.fromtimestamp(r["at"])
        if not start <= d < start + datetime.timedelta(days=7):
            continue
        kind = r.get("kind") or "chat"
        if kind == "merge":
            days[d] = days.get(d, 0) + 1
        elif kind == "reply" and isinstance(r.get("wait"), (int, float)) and r["wait"] <= MISSION_FAST:
            fast += 1
    best = max(days.items(), key=lambda x: x[1], default=None)
    return {"n": sum(days.values()), "best": best, "fast": fast}


def missions_nudge(now=None):
    """What to tell your phones now about your missions, once a day each, or
    None: at 8pm, a streak at risk (none completed today yet); on Monday from
    9, your assistant's recap of last week. Marked sent (MISSION_TOLD)."""
    now = now or datetime.datetime.now()
    today = now.date()
    try:
        told = json.loads(MISSION_TOLD.read_text())
    except (OSError, ValueError):
        told = {}
    told = told if isinstance(told, dict) else {}
    payload, which = None, None
    v = missions_view()
    if 20 <= now.hour < 23 and told.get("reminder") != today.isoformat() and v["streak"] and not v["today"]:
        which = "reminder"
        payload = {"title": f"Your {v['streak']}-day streak", "body": "Merge one today to keep it going.",
                   "tag": "amarchy-streak", "url": "/"}
    elif now.weekday() == 0 and 9 <= now.hour < 21 and told.get("recap") != today.isoformat():
        week = missions_last_week(today)
        which = "recap"
        if week["n"]:
            mine = assistant()
            day, n = week["best"]
            body = f"{week['n']} merge{'s' if week['n'] != 1 else ''} last week · best day {day.strftime('%A')}, {n}"
            if week["fast"]:
                body += f" · {week['fast']} fast repl{'ies' if week['fast'] != 1 else 'y'}"
            if v["streak"]:
                body += f" · a {v['streak']}-day streak going"
            payload = {"title": f"{mine['name']}: your week" if mine else "Your week", "body": body,
                       "tag": "amarchy-recap", "url": "/"}
            if mine:
                payload["icon"] = assistant_icon()
    if which:
        told[which] = today.isoformat()
        try:
            write_file(MISSION_TOLD, json.dumps(told))
        except OSError:
            pass
    return payload


def app_missions(st, ss):
    """Each second, beside the notifications: a question or permission
    answered (how long it waited: fast ones count), five chats at work at
    once (a badge), and the streak's reminder or the week's recap."""
    now = time.time()
    since = st.waiting_since
    live = {s["id"]: s for s in ss}
    # Waiting already when this server started: since when isn't known (None), not timed.
    first, st.missions_seen = not st.missions_seen, True
    for s in ss:
        if s.get("status") == "waiting":
            since.setdefault(s["id"], None if first else now)
    for sid in [k for k in since if (live.get(k) or {}).get("status") != "waiting"]:
        began = since.pop(sid)
        if began and sid in live:       # answered; closed, it wasn't
            mission_log({"kind": "reply", "id": sid, "wait": int(now - began)})
    if sum(1 for s in ss if s.get("status") in ("working", "running")) >= 5:
        mission_badge("five")
    if now - st.nudged_at > 60:
        st.nudged_at = now
        payload = missions_nudge()
        if payload:
            threading.Thread(target=push_all, args=(payload,), daemon=True).start()


def resume_closing():
    """Finish closing the sessions a reap was cut short on (a crash, a
    reboot): those in CLOSING that nothing is reaping."""
    for f in CLOSING.glob("*.json") if CLOSING.is_dir() else ():
        lock = reap_lock(f.stem)
        if lock:
            lock.close()
            detach([ENTRY, "reap", f.stem])


def installed_from(path):
    """Whether the installed amarchy (the CLI install.sh links) runs from the
    checkout at path."""
    try:
        return os.readlink(INSTALLED).startswith(str(path).rstrip("/") + "/")
    except OSError:
        return False


def last_line(result, fallback):
    """The last line a command wrote to stderr (or stdout): why it failed."""
    return ((result.stderr or result.stdout).strip().splitlines() or [fallback])[-1]


def reap_lock(sid):
    """The lock of a session's reap, held while it lasts: the open file, or
    None when another reap has it."""
    CLOSING.mkdir(parents=True, exist_ok=True)
    lock = open(CLOSING / f"{sid}.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return None
    return lock


def stop_claude(pane):
    """End the Claude Code in a session's pane as quitting it would (its
    SessionEnd hooks run, the conversation is saved): SIGTERM, and SIGKILL
    only if it's still there after a while."""
    procs = processes()
    pid = pane_claude(pane, procs)
    if not pid:
        return
    try:
        os.kill(pid, 15)
    except ProcessLookupError:
        return
    end = time.time() + 8
    while time.time() < end and Path(f"/proc/{pid}").exists():
        time.sleep(0.1)
    try:
        os.kill(pid, 9)
    except ProcessLookupError:
        pass


def stop_leftovers(path, scopes=()):
    """Stop what still runs from a worktree once its session's Claude and
    tmux are gone: whatever Claude started in the background (a
    `nohup pnpm dev &`) lives on outside them, holding its port and serving
    files that are about to go. A process counts if its working directory or
    its executable is in the worktree, or it's still in one of the session's
    panes' scopes (a headless browser started from /tmp). SIGKILL for what's
    left after a few seconds (stop_processes). Never this process or what
    started it."""
    found = in_tree(path, processes())
    for scope in scopes:
        found |= {p for p in scope_pids(scope) if not amarchy_own(p)}
    return stop_processes(found) if found else 0


def cmd_reap(sid):
    """The rest of close, detached from whatever asked for it (the app, a
    session's Claude closing another): the session's Claude Code and its
    background sessions stop, its tmux ends, whatever still runs from the
    worktree is stopped, then the worktree goes."""
    f = CLOSING / f"{sid}.json"
    lock = reap_lock(sid) if f.exists() else None
    if not lock or not f.exists():     # another reap has it, or had it and is done
        return 0
    try:
        s = json.loads(f.read_text())
    except (OSError, ValueError):
        return 0
    force = bool(s.pop("force", False))
    path = Path(s["path"])
    # Its background sessions (/bg) would go on working in a worktree that's gone.
    stop_background(s, only_idle=False)
    pane, term = host_pane(s), term_pane(s)
    scopes = [x for x in (pane_scope(pane["pid"]) if pane else None, pane_scope(term) if term else None) if x]
    host_stop(s)
    repo_dir = WORK / s["repo"]

    def keep_open():
        # Back in the list rather than lost.
        save_session(s)
        f.unlink(missing_ok=True)
        (CLOSING / f"{sid}.lock").unlink(missing_ok=True)
        return 1

    # The installed amarchy runs from this worktree (it was being tried live):
    # put it back on the main checkout first, or the CLI and the app would go
    # with the worktree. Its install.sh restarts the app.
    if installed_from(path) and (repo_dir / "install.sh").exists():
        put = sh(str(repo_dir / "install.sh"), "--force", cwd=repo_dir)
        if put.returncode != 0:
            print(f"amarchy: couldn't close {sid}: amarchy runs from it, and putting it back on {repo_dir} "
                  f"failed ({last_line(put, 'install.sh failed')})", file=sys.stderr)
            return keep_open()
    # What its Claude started in the background (a dev server) outlives its
    # tmux, and would go on running from a worktree that's gone.
    stop_leftovers(path, scopes)
    # One more look at its merges, GitHub's too (a pull request merged a
    # moment before you completed it), while its worktree is still there.
    if not s.get("setup") and not is_agent(s):
        try:
            merge_scan([{**s, "task": session_task(s, "")}], fresh=True)
        except Exception as e:
            print(f"amarchy: couldn't look at {sid}'s merges: {e}", file=sys.stderr)
    removed = sh("git", "worktree", "remove", *(["--force"] if force else []), str(path), cwd=repo_dir)
    sh("git", "worktree", "prune", cwd=repo_dir)
    if path.exists() and removed.returncode != 0:
        # Changed after close looked (something still running wrote to it).
        print(f"amarchy: couldn't close {sid}: {last_line(removed, 'git worktree remove failed')}", file=sys.stderr)
        return keep_open()
    had_branch = sh("git", "rev-parse", "--verify", "--quiet", f"refs/heads/{s['branch']}",
                    cwd=repo_dir).returncode == 0
    if had_branch:
        sh("git", "branch", "-d", s["branch"], cwd=repo_dir)    # kept when it isn't merged
    shutil.rmtree(claude_dir(sid), ignore_errors=True)
    for x in (PREVIEWS / f"{sid}.json", PREVIEWS / f"{sid}.log", MOVES / f"{sid}.gate"):
        x.unlink(missing_ok=True)
    set_trust(path, False)
    f.unlink(missing_ok=True)
    (CLOSING / f"{sid}.lock").unlink(missing_ok=True)
    return 0


def cmd_close(args):
    sid = args[0] if args and not args[0].startswith("-") else own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one: amarchy close <id>)")
    err = close(sid, force="--force" in args)
    if err and err.startswith(PREVIEW_LEFT):
        return fail(f"{sid}: {err}. Stop that (amarchy preview stop, or what started it), then close it again; "
                    f"if it isn't this chat's, amarchy preview --clear forgets its previews")
    if err:
        return fail(f"{sid}: {err} (amarchy close {sid} --force discards them)")
    return 0


def cmd_rename(args):
    """Give a session a name of your own, shown in every list instead of the
    one made from Claude's title. The branch and worktree keep theirs."""
    args = list(args)
    sid = None
    if "--id" in args:
        i = args.index("--id")
        if i + 1 >= len(args):
            return fail("Usage: amarchy rename --id <id> <title>|--reset")
        sid = args[i + 1]
        del args[i:i + 2]
    reset = "--reset" in args
    title = " ".join(a for a in args if a != "--reset").strip()
    sid = sid or own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one with --id <id>)")
    if not reset and not title:
        print(usage("rename"), file=sys.stderr)
        return 1
    if reset:
        s.pop("title", None)
    else:
        s["title"] = title
    save_session(s)
    return 0


def agent_context(s):
    """What Claude is told when its session starts (and again after a /clear or a
    compaction): that it runs in amarchy, which session it is, and where the rest
    is (the amarchy skill, installed with amarchy, has the details)."""
    name, bind = host_network()
    text = (f"This Claude Code session runs inside amarchy: the user's parallel chats with Claude Code, on a "
            f"server, {name}, that they reach from their phone and their computer's browser through the "
            f"amarchy app (it shows each chat as a conversation, your questions and permissions as buttons, and "
            f"the chat's terminal). You are "
            f"session {s['name']}: a git worktree of {s['repo']} at {s['path']}, on branch {s['branch']} "
            f"(made from {s['base']}). The project's main checkout is {WORK / s['repo']}; other sessions work "
            f"in worktrees of their own. This session also has a terminal of its own, where the project runs (the "
            f"user can open it in the app). The `amarchy` CLI drives all of it and acts on this "
            f"session (AMARCHY_SESSION={s['id']} in your environment). The other chats are Claude Code sessions too: "
            f"you can message them (ListAgents, SendMessage), and start one with a task of its own "
            f"(amarchy new <project> --prompt). Use the amarchy skill before running it, or when the work "
            f"involves other sessions, worktrees, that terminal or merging back into main. The user's browser "
            f"isn't on this machine, and nothing you open here (a browser, a GUI app) reaches their screen: "
            f"tell them what to open instead. Never ask them to paste an API key, password or token into the "
            f"chat (the transcript keeps it): run `amarchy secret ask NAME --why \"...\"` (the amarchy skill's "
            f"\"Secrets\"), and your commands get it as $NAME. ")
    if engine(s) == "chat":
        text += ("You're on amarchy's chat engine: there's no prompt box or keyboard in front of the user, "
                 "they type to you in the app's composer, and a message they send while you work waits for your "
                 "turn unless they send it now. Their answers to your questions and their permissions come back "
                 "as the choices you offered. ")
    tls = preview_tls() if bind else None
    if tls:
        text += (f"For them to open something you serve (a dev server, a preview), listen on 127.0.0.1 and "
                 f"register it as this chat's preview: `amarchy preview --run '<command>' https://{tls}:<port>` "
                 f"(plus `--port <n>` for each other port it takes, like an HMR port, and `--stop '<command>'` if "
                 f"it starts something elsewhere, like containers). amarchy serves each of those ports to them "
                 f"over HTTPS on their private network, at the same number (HTTP/2: a dev server's page loads "
                 f"fast on their phone), so it must listen on 127.0.0.1 only, not 0.0.0.0 or {bind}: its live "
                 f"reload too (best on its main port). amarchy runs it as a service of the chat's own, so it "
                 f"outlives your sleep, puts it "
                 f"on the Preview button (which starts it again when it isn't running), and stops it when the chat "
                 f"is completed. Two or more to look at (an app and its admin, a storybook): give each a name, "
                 f"`--name <what it is>`, and the button is Previews, a list to pick from. "
                 f"Don't leave a dev server in your background shells: it stops when the chat sleeps. ")
    elif bind:
        text += (f"For them to open something you serve (a dev server, a preview), listen on {bind} "
                 f"(reachable only from their private network) and register it as this chat's preview: "
                 f"`amarchy preview --run '<command>' http://{name}:<port>` (plus `--port <n>` for each other port "
                 f"it takes, like an HMR port, and `--stop '<command>'` if it starts something elsewhere, like "
                 f"containers). amarchy runs it as a service of the chat's own, so it outlives your sleep, puts it "
                 f"on the Preview button (which starts it again when it isn't running), and stops it when the chat "
                 f"is completed. Two or more to look at (an app and its admin, a storybook): give each a name, "
                 f"`--name <what it is>`, and the button is Previews, a list to pick from. "
                 f"Don't leave a dev server in your background shells: it stops when the chat sleeps. ")
    else:
        text += (f"What you serve here is reachable only on this machine: listen on localhost, and to open "
                 f"it they forward the port (ssh -L <port>:localhost:<port> {name}) and use "
                 f"http://localhost:<port> (`amarchy preview <url>` puts it on its Preview button). ")
    return text + "Other sessions share this machine, so a port may be taken: pick a free one."


# The notifications of Claude Code that mean it's blocked on you. Others aren't
# a question: "idle_prompt" comes a minute after it finished, if you haven't
# answered, and would ring a session that's done a second time, as needing you.
NEEDS_YOU = ("permission_prompt", "elicitation_dialog", "elicitation_url_dialog", "agent_needs_input")


def hook_claude():
    """The Claude Code process a hook runs for (the nearest claude above it)
    and what Claude Code says about it in ~/.claude/sessions."""
    pid = os.getppid()
    for _ in range(6):
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            return {}
        if stat[stat.find("(") + 1:stat.rfind(")")] == "claude":
            try:
                return json.loads((HOME / f".claude/sessions/{pid}.json").read_text())
            except (OSError, ValueError):
                return {"pid": pid}
        pid = int(stat[stat.rfind(")") + 2:].split()[1])
    return {}


def cmd_hook(sid, state):
    # Claude Code passes the event as JSON on stdin.
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except Exception:
        event = {}
    s = session(sid)
    if not s:
        return
    kind = event.get("notification_type") if isinstance(event, dict) else None
    if state == "waiting" and kind and kind not in NEEDS_YOU:
        return
    started = state == "start"
    if started:
        # SessionStart: Claude is ready (idle), and learns where it is. Its
        # Bash commands source the project's secrets, as they are at each one.
        env_file = os.environ.get("CLAUDE_ENV_FILE")
        if env_file:
            try:
                with open(env_file, "a") as f:
                    f.write(secrets_sh(s["repo"]) + "\n")
            except OSError:
                pass
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                                 "additionalContext": agent_context(s)}}))
        state = "idle"
    if state == "working" and event.get("hook_event_name") == "PreToolUse":
        refused = secret_guard(event) or board_guard(event)
        if refused:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                     "permissionDecisionReason": refused}}))
        elif serve_reminder(event):
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                                     "additionalContext": serve_reminder(event)}}))
    # A background session forked from this one (/bg) carries its hooks, but
    # it isn't the session's own Claude: it says nothing about the session.
    if hook_claude().get("kind") == "bg":
        return
    set_conversation_id(sid, event.get("session_id", ""))
    clear_waking(sid)       # it's up
    if asleep_since(sid) is not None and state != "idle":
        clear_asleep(sid)   # it's running after all (woken some other way)
    # On the chat engine, a tool starting while another one's request waits
    # (several at once) is still Claude waiting on you: the broker says when
    # it isn't.
    if state == "working" and engine(s) == "chat":
        live = agent_live(sid)
        if live.get("pending") and live.get("state") not in ("exited", None):
            return
    # A turn a timer, a script or another chat started, that ended with
    # nothing for you to see (NO_REPLY): idle, and nothing new, nothing told,
    # the turn hidden from the app (quiet_stop). NO_REPLY to what you wrote
    # is sent back, to be answered (once).
    quiet = quiet_stop(s, event) if state == "idle" and event.get("hook_event_name") == "Stop" else None
    if quiet is True:
        set_status(sid, "idle", done=False)
        if claude_format_version() != format_version(s):
            detach([ENTRY, "claude-reload", sid])
        return
    if quiet and not event.get("stop_hook_active"):
        print(json.dumps({"decision": "block", "reason": quiet}))
        return
    # A turn ended with a reply whose blocks can't be drawn, a long one that
    # isn't in sections with its brief, or one without its goal block: sent
    # back to Claude to fix (reply_fix), once (the second
    # stop is stop_hook_active), and the session stays working meanwhile.
    # Only a Claude that has the current format: it knows what's asked.
    if state == "idle" and event.get("hook_event_name") == "Stop" and not event.get("stop_hook_active") \
            and claude_format_version() == format_version(s) and not quiet:
        ask = reply_fix(event, chat=is_agent(s))
        if ask:
            print(json.dumps({"decision": "block", "reason": ask}))
            return
    # A turn ended on a Claude started with an older reply format (or none):
    # it's started again once idle (claude_reload), the same conversation, with
    # the format amarchy gives now. (A tool's description would be kept in the
    # conversation; the format is given at start, so a new Claude has it.)
    if state == "idle" and event.get("hook_event_name") == "Stop" and claude_format_version() != format_version(s):
        detach([ENTRY, "claude-reload", sid])

    if started:
        return session_started(s, event)
    set_status(sid, state)


def session_started(s, event):
    """Claude started (SessionStart): it's ready, idle, and hasn't finished a
    turn, so nothing is done or new to see: a new chat, working while it was
    set up, isn't "done" before its first message. Unless that's on its way:
    it stays working (the chat engine's broker says how it stands itself:
    Agent.run; the classic terminal's Claude starts with it: cmd_claude). Nor
    when the conversation was only compacted, mid-turn: it works on."""
    sid = s["id"]
    if isinstance(event, dict) and event.get("source") == "compact":
        return
    if engine(s) == "chat":
        return
    if take(claude_dir(sid) / "first") is not None:
        set_status(sid, "working")
    else:
        set_status(sid, "idle", done=False)


def set_status(sid, state, done=True):
    """The session's status as the list shows it: working, waiting or idle.
    Idle after working, it's done: its row says so until you open it (see
    mark_seen; a phone or a browser looking at it says it did, within a
    second), unless not done (you stopped it yourself). The app's server
    notifies the phones (app_moments). The state it was in before."""
    prev = (STATUS / sid).read_text().strip() if (STATUS / sid).exists() else ""
    if state == prev == "idle":
        return prev     # idle all along (Claude coming back from sleep): since when it was
    (STATUS / sid).write_text(state)    # (working again: its time says when, for send_taken)
    if state == "idle" and prev == "working" and done:
        mark_unseen(sid)
    return prev


def unseen(sid):
    """Whether the session finished a turn you haven't looked at yet."""
    return (UNSEEN / sid).exists()


def finished_now(sid):
    """Whether the session's last change of status was a turn finishing (idle
    and done: set_status marks it unseen then), and you haven't seen it.
    Not a Claude that only started, a turn you stopped, or one that failed."""
    try:
        return (UNSEEN / sid).stat().st_mtime >= (STATUS / sid).stat().st_mtime
    except OSError:
        return False


def mark_unseen(sid):
    write_file(UNSEEN / sid, "")


def mark_seen(sid):
    (UNSEEN / sid).unlink(missing_ok=True)
    try:
        SEEN.mkdir(parents=True, exist_ok=True)
        (SEEN / sid).touch()
    except OSError:
        pass


def seen_at(sid):
    """When you last looked at a session (mark_seen), or None for never
    since amarchy kept that."""
    try:
        return (SEEN / sid).stat().st_mtime
    except OSError:
        return None


def unread(s, words):
    """How many of the messages its Claude wrote last (words: last_words's
    stamps, their times) you haven't seen: those after you last looked.
    Never looked since amarchy kept that: those since your last message
    while its last turn is unseen, else none (you opened it since)."""
    stamps = words.get("stamps") or []
    if not stamps:
        return 0
    at = seen_at(s["id"])
    if at is None:
        return words.get("after_you", 0) if unseen(s["id"]) else 0
    return sum(1 for t in stamps if t > at)


def cmd_seen(sid):
    if not session(sid):
        return fail(f"no session {sid!r}")
    mark_seen(sid)
    return 0


# ------------------------------------------------------------------ mission control

def task_title(pane_title):
    """What a session is about, from the title Claude Code gives its terminal
    (a short slug like "fix-login-redirect", after a status glyph)."""
    title = re.sub(r"^[^\w]+", "", pane_title or "").strip()
    if not title or title.startswith("amarchy:") or title == "Claude Code":
        return ""
    if " " not in title:
        title = title.replace("-", " ").replace("_", " ")
    return title[:1].upper() + title[1:]

# How much a session matters to you, most first (`amarchy priority`). New
# sessions are normal; the list always puts the higher ones first.
PRIORITIES = ("high", "normal", "low")
RANK = {p: i for i, p in enumerate(PRIORITIES)}
def priority(s):
    p = s.get("priority")
    return p if p in RANK else "normal"


def last_you(s):
    """When you last wrote to a chat, else when it opened: what orders Now and
    For later. Only you change it, so a card never moves on its own."""
    return chat_reply(s)["you_at"] or s.get("created", 0)


def session_order(s, ranks=None):
    """In the order the board shows them: your assistant, your agents (in
    the order you made them: ranks, {id: n}), what you pinned, Now, For
    later; the one you last wrote to first in each."""
    role = s.get("assistant")
    if role in AGENT_ROLES:
        return (0, (ranks or {}).get(s["id"], 0), 0, 0, s["id"])
    return (1, 0, RANK[priority(s)], -last_you(s), s["id"])


def cmd_priority(args):
    """`amarchy priority high|normal|low|up|down [--id <id>]`: how much a
    session matters, for the order of the list. Without a level, prints it."""
    sid = None
    if "--id" in args:
        i = args.index("--id")
        if i + 1 >= len(args):
            return fail("usage: amarchy priority [high|normal|low|up|down] [--id <id>]")
        sid = args[i + 1]
        args = args[:i] + args[i + 2:]
    sid = sid or own_session_id()
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "Not in a session (name one with --id <id>)")
    now = priority(s)
    if not args:
        print(now)
        return 0
    level = args[0]
    if level in ("up", "down"):
        level = PRIORITIES[max(0, min(len(PRIORITIES) - 1, RANK[now] + (-1 if level == "up" else 1)))]
    if len(args) > 1 or level not in RANK:
        return fail("usage: amarchy priority [high|normal|low|up|down] [--id <id>]")
    if level == "normal":
        s.pop("priority", None)
    else:
        s["priority"] = level
    save_session(s)
    print(level)
    return 0


def age(sid):
    """How long a session has been in its current state, e.g. "3m"."""
    try:
        return since_age((STATUS / sid).stat().st_mtime)
    except OSError:
        return ""


def since_age(since):
    secs = time.time() - since
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return "now"


TITLES = STATE / "titles.json"  # what saved_title() read last, so it only reads what's new


def saved_title(s):
    """The title Claude Code gave the session's conversation (for sessions
    whose Claude isn't running): the one it's in, else the latest of its own
    in its folder. Conversations only grow, so only what's new since last time is read."""
    f = transcript(s) or latest_conversation(s)
    if not f:
        return ""
    try:
        cache = json.loads(TITLES.read_text())
    except (OSError, ValueError):
        cache = {}
    try:
        size = f.stat().st_size
    except OSError:
        return ""
    seen, title = cache.get(str(f), [0, ""])
    if seen == size:
        return task_title(title or our_title(s["id"], f))
    try:
        with open(f, "rb") as fh:
            fh.seek(seen if seen < size else 0)
            for row in fh:
                if b'"ai-title"' in row or b'"custom-title"' in row:
                    try:
                        d = json.loads(row)
                    except ValueError:
                        continue
                    title = d.get("customTitle") or d.get("aiTitle") or title
            size = fh.tell()
    except OSError:
        return task_title(title)
    cache[str(f)] = [size, title]
    title = title or our_title(s["id"], f)
    # Only the conversations of sessions still around.
    keep = {str(projects_dir(x["path"])) for x in sessions()}
    try:
        write_file(TITLES, json.dumps({k: v for k, v in cache.items() if str(Path(k).parent) in keep}))
    except OSError:
        pass
    return task_title(title)


def session_task(s, pane_title):
    """What a session is about: your own name for it (amarchy rename), else
    Claude's, from its tmux pane or its latest conversation, cut down to
    "Keyword: a few words" (short_title) once that's ready."""
    if s.get("setup"):
        return s.get("title") or "Setting up the worktree"
    if s.get("title"):
        return s["title"]
    title = claude_title(s, pane_title)
    return short_title(s["repo"], title) or title


def claude_title(s, pane_title):
    """The title Claude Code gave the session, whole: from its pane, else its latest conversation."""
    return task_title(pane_title) or saved_title(s)


SHORT_NAMES = os.environ.get("AMARCHY_SHORT_NAMES", "on").lower() not in ("0", "off", "no", "false")
SHORT = STATE / "short.json"         # Claude's title (with its project) → the short name for it
SHORTENING = STATE / "shortening"    # one file per title being cut down right now
SHORT_RETRY = 600                    # how long a title that couldn't be cut down waits to try again
SHORT_PROMPT = """Name a coding session for a narrow sidebar list, so it can be told apart from the others at a glance.

Format: Keyword: a few words
- Keyword: one word, two at most: the thing being worked on, the word you'd look for in the list. Capitalized.
- After the colon: one to three lowercase words on what about it. Only what the title says; don't invent.
- 26 characters at most in all. In English, whatever the title's language.
- Leave out the project's name ({repo}) and filler like session, setup, analysis, implementation.
- Reply with the name only: no quotes, no period, nothing else.

Examples:
Fix login redirect loop after OAuth callback -> Login: redirect loop
Add dark mode toggle to settings page -> Dark mode: toggle
Investigate flaky CI tests in payments module -> CI: flaky payment tests
Configurar notificaciones push en Android -> Push: Android

Session title: {title}"""


def short_key(repo, title):
    return f"{repo}\t{title}"


def short_title(repo, title):
    """Claude's title for a session cut down to "Keyword: a few words", the
    keyword first so a list of them reads at a glance. Claude Code's titles
    are a sentence each; Haiku cuts each one down once, in the background
    (amarchy shorten), and until then (or without claude) there's none."""
    if not SHORT_NAMES or not title:
        return ""
    try:
        short = json.loads(SHORT.read_text()).get(short_key(repo, title))
    except (OSError, ValueError):
        short = None
    if short is not None:
        return short
    marker = SHORTENING / hashlib.sha1(short_key(repo, title).encode()).hexdigest()
    try:
        if time.time() - marker.stat().st_mtime < SHORT_RETRY:
            return ""     # on its way, or it failed a moment ago
    except OSError:
        pass
    if shutil.which("claude"):
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.touch()
        detach([ENTRY, "shorten", repo, title])
    return ""


def shorten(repo, title):
    """Ask Haiku for the short name of a title: one line, Keyword: words, short
    enough for the list. None if it couldn't give one."""
    for _ in range(2):
        try:
            r = subprocess.run(
                ["claude", "-p", "--model", "haiku", "--no-session-persistence", "--setting-sources", "",
                 "--tools", "", "--strict-mcp-config", SHORT_PROMPT.format(repo=repo, title=title)],
                capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL,
                env=clean_env(), cwd=STATE)
        except (OSError, subprocess.TimeoutExpired):
            return None
        lines = [l.strip() for l in r.stdout.strip().splitlines() if l.strip()]
        name = lines[0].strip("\"'`*. ") if len(lines) == 1 else ""
        m = re.fullmatch(r"([^:]{1,20}):\s*([^:]{1,26})", name)
        if r.returncode == 0 and m and len(name) <= 34:
            return f"{m.group(1).strip()}: {m.group(2).strip()}"
    return None


def cmd_shorten(repo, title):
    """amarchy shorten <repo> <title>: cut a Claude title down (short_title
    starts it), keep it, and redraw the list with it."""
    key = short_key(repo, title)
    marker = SHORTENING / hashlib.sha1(key.encode()).hexdigest()
    name = shorten(repo, title)
    if not name:
        return 1          # the marker stays, so it's tried again in a while
    with open(STATE / "short.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cache = json.loads(SHORT.read_text())
        except (OSError, ValueError):
            cache = {}
        cache[key] = name
        # Only the titles of sessions still around, and the one just made.
        titles = host_titles()
        keep = {short_key(s["repo"], claude_title(s, titles.get(s["id"], ""))) for s in sessions()}
        write_file(SHORT, json.dumps({k: v for k, v in cache.items() if k in keep or k == key}))
    marker.unlink(missing_ok=True)
    return 0


def claude_agents():
    """The name each running Claude Code goes by for ListAgents and SendMessage
    (what other Claude sessions message it as), by its folder. Claude Code keeps
    one ~/.claude/sessions/<pid>.json per running instance; an interactive one
    wins over a background job in the same folder, unless it has handed its
    conversation over to that job (parked: ListAgents then shows only the job)."""
    agents = {}
    for f in (HOME / ".claude/sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
            os.kill(int(d["pid"]), 0)
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if not d.get("name") or not d.get("cwd") or d.get("parkedJobId"):
            continue
        rank = (d.get("kind") == "interactive", d.get("startedAt") or 0)
        if d["cwd"] not in agents or rank > agents[d["cwd"]][0]:
            agents[d["cwd"]] = (rank, d["name"])
    return {cwd: name for cwd, (_, name) in agents.items()}


def session_view():
    """Sessions as every list shows them (the app's, amarchy list): in list
    order, with what each one is about and how long it has been in its state."""
    resume_closing()
    titles = host_titles()
    agents = claude_agents()
    ss = sessions()
    background = all_background_sessions()
    merges = merges_read()
    # Your assistant's picture ("" for amarchy's own): its hash, for the
    # phone's and the browser's lists.
    sig = picture_sig(PICTURE)
    for s in ss:
        # Sleeping (its Claude stopped until you type in it) looks just as it
        # did, idle. So does a session whose tmux is gone (after a reboot):
        # it starts again asleep, and looks the same.
        s["awake"] = s["id"] in titles
        s["sleeping"] = asleep_since(s["id"]) is not None or not s["awake"]
        # Woken, and its Claude isn't up yet.
        s["waking"] = not s["sleeping"] and waking_now(s["id"])
        # What you sent it is on its way: its Claude wakes (or starts again)
        # with it. It's at work from the moment you sent it, not once its
        # Claude is up and says so: a card that stays put looks broken.
        sent = not s.get("setup") and starting(s["id"])
        if sent and s["sleeping"]:
            s["sleeping"], s["waking"] = False, True
        s["agent"] = agents.get(s["path"], "") if not s["sleeping"] else ""
        s["engine"] = engine(s)     # how its Claude runs: terminal (the TUI) or chat (amarchy agent)
        s.pop("prompt", None)
        if s["sleeping"] and not s.get("setup"):
            s["status"] = "idle"    # only an idle session sleeps (or one left from before)
        if sent and s["status"] == "idle":
            s["status"] = "working"
        s["task"] = session_task(s, titles.get(s["id"], ""))
        # Claude's whole title, so a search finds a session by any word of it.
        s["claude_title"] = "" if s.get("setup") else claude_title(s, titles.get(s["id"], ""))
        s["age"] = age(s["id"]) if s["awake"] else ""
        # Claude Code background sessions (/bg) still running in its worktree, and on the
        # chat engine the background tasks its Claude runs (live.json's tasks).
        bgs = background_sessions(s, background)
        live = agent_live(s["id"]) if engine(s) == "chat" else {}
        tasks = live_tasks(live) if s["awake"] else []
        s["background"] = len(bgs) + len(tasks)
        # Its turn ended, but something it started still runs to an end (a test
        # run, a helper): it's at work, "running", not done; Claude Code wakes
        # it when that ends, and it goes on (working, then idle). What only
        # serves (a dev server) doesn't count: it never ends.
        runs, serves = background_runs(tasks, bgs)
        s["running"], s["serving"] = (runs or [""])[0], (serves or [""])[0]
        if s["status"] == "idle" and runs and not s["sleeping"] and not s.get("setup"):
            s["status"] = "running"
        # At work on what a timer, a script or another chat sent it, with
        # nothing to show of it yet (turn_hold; quiet_waking, while its Claude
        # starts with it): the app shows it as it was (app_row) until it has
        # something to say, and nothing at all if it ends quiet (NO_REPLY).
        # So is one whose quiet turn left something running (a background job:
        # "running"), until that ends and it says what it found, or nothing.
        s["quiet"] = bool(not s.get("setup") and s["engine"] == "chat" and (
            s["status"] == "working" and (turn_hold(s, live) is not None if live.get("turn") else quiet_waking(s["id"]))
            or s["status"] == "running" and quiet_last(s["id"])))
        s["priority"] = priority(s)
        # Its previews, each with where it stands (its button; a dropdown of them, with several).
        s["previews"] = preview_shown(s)
        s.pop("preview", None)
        # Its last turn was cut off (the machine ran out of memory, Claude
        # crashed), or what it ran in the background to go on from (a CI
        # watch, a test run) stopped with its Claude before it ended
        # (live_cut: it would wait for it forever): idle, but not done.
        # Asleep or not, it says so, and what was cut.
        cut = live_cut(live) if not s.get("setup") else []
        s["cut"] = task_words(cut[0]) if cut else ""
        s["interrupted"] = (bool(cut) and s["status"] == "idle") or interrupted(s)
        # Done, and you haven't opened it since.
        s["unseen"] = s["status"] == "idle" and not s.get("setup") and not s["interrupted"] and unseen(s["id"])
        # The secrets its Claude asks you for (amarchy secret ask): a card each.
        s["secret_asks"] = secret_asks(s["id"])
        # Its work merged (merge_scan): when last, how many times, what's new since.
        s["merged"] = chat_merged(s["id"], merges)
        # Moving to another machine (see "moving a chat"), or what stopped it.
        s["moving"], s["move_error"] = move_shown(s["id"])
    crew = team()
    for s in ss:
        # Yours (your assistant, an agent) or of one's project: under its
        # name and picture, and one of yours with its chime.
        s["assistant"], who = team_of(s, crew)
        s["assistant_name"] = who["name"] if who else ""
        s["picture"] = (sig if who["role"] == "main" else picture_sig(agent_picture(who["id"]))) if who else ""
        s["chime"] = who["sound"] if s["assistant"] in AGENT_ROLES else ""
        if s["assistant"]:
            # What it last wrote: its notifications' body, and the list's
            # preview while you haven't read it.
            words = last_words(s, deep=s["assistant"] in AGENT_ROLES)
            s["said"] = words["said"]
            if s["assistant"] in AGENT_ROLES:
                # As a messaging app's list has it: when it last wrote, and
                # how many of its messages you haven't seen (app_watch: none
                # while it's on a screen of yours).
                s["said_at"] = words["said_at"]
                s["unread"] = unread(s, words)
    ranks = {a["id"]: i for i, a in enumerate(crew)}
    ss.sort(key=lambda s: session_order(s, ranks))
    return ss


# ------------------------------------------------------------------ your assistant
#
# One session can be your assistant (`amarchy assistant <id>`): a Claude that
# keeps your day rather than writing code. Every list (the phone's, the
# browser's) shows it at the top, above the groups,
# bigger and with its picture (app/assistant.svg); the other sessions of its
# project sit under it there. What it says reaches you apart from the coding
# sessions: under its name and picture, with a chime of its own, always,
# whatever `amarchy alerts` lets through of the others.

ASSISTANT_FILE = STATE / "assistant"        # {"id": its session, "name": what it's called}
ALERTS_FILE = STATE / "alerts"
# What the other sessions tell you about (your assistant always does): all =
# when they need you and when they're done; needs-you = only when one asks you
# something (a question, a permission), a finished one just marked done in the
# list; assistant = nothing but your assistant.
ALERTS = ("all", "needs-you", "assistant")
ALERTS_DEFAULT = "needs-you"


def assistant():
    """Your assistant here: {"id", "name"}, or None. Its name is what you
    called it, else its project's ("Jaken" for jaken)."""
    try:
        d = json.loads(ASSISTANT_FILE.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(d, dict) or not isinstance(d.get("id"), str):
        return None
    try:
        s = json.loads((SESSIONS / f"{d['id']}.json").read_text())
    except (OSError, ValueError):
        return None     # closed
    name = d.get("name") if isinstance(d.get("name"), str) else ""
    return {"id": d["id"], "name": name.strip() or project_name(s.get("repo", "")) or "Assistant",
            "repo": s.get("repo", "")}


def assistant_role(s, mine=None):
    """"main" for your assistant, "agent" for another agent of yours,
    "near" for another session of one's project, "" for the rest."""
    return team_of(s)[0]


# Its picture: amarchy's own (app/assistant.svg) unless you gave it one of
# yours (`amarchy assistant --picture <file>`), cut square and round and kept
# in ~/.config/amarchy (assistant.png, and assistant-192.png for the phones'
# notifications). The lists and the notifications name it by its hash, so a
# new one shows everywhere at once (no cache keeps the old one).
PICTURE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy/assistant.png"
PICTURE_SMALL = PICTURE.with_name("assistant-192.png")
PICTURE_SIZES = (512, 192)
_picture_sigs = {}


def picture_sig(f):
    """The hash a picture goes by (12 hex digits), or "" without one."""
    try:
        st = f.stat()
        key = (str(f), st.st_mtime_ns, st.st_size)
        if key not in _picture_sigs:
            _picture_sigs[key] = hashlib.sha1(f.read_bytes()).hexdigest()[:12]
    except OSError:
        return ""
    return _picture_sigs[key]


def assistant_icon():
    """The picture by your assistant's notifications on the phones (a path
    of the app's)."""
    sig = picture_sig(PICTURE)
    return f"/picture/{sig}-192.png" if sig and PICTURE_SMALL.is_file() else "/assistant-192.png"


def picture_cut(raw, crop=None):
    """A picture cut for your assistant's: a square of it (crop: its x, y and
    size in the picture's pixels, else the middle of it as big as it goes),
    round, at each of PICTURE_SIZES, as PNGs. Raises ValueError saying why
    not. With ffmpeg, else ImageMagick."""
    if not image_kind(raw):
        raise ValueError("that isn't a picture amarchy takes (a PNG, JPEG or WebP)")
    ffmpeg, magick = shutil.which("ffmpeg"), shutil.which("magick")
    if not ffmpeg and not magick:
        raise ValueError("cutting it to size takes ffmpeg or ImageMagick: install one (pacman -S ffmpeg)")
    out = {}
    with tempfile.TemporaryDirectory() as tmp:
        src = Path(tmp) / "picture"
        src.write_bytes(raw)
        if crop:
            # Neither cuts outside the picture: they'd quietly cut less.
            r = sh(shutil.which("ffprobe") or "ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                   "stream=width,height", "-of", "csv=p=0:s=x", str(src)) if ffmpeg else \
                sh(magick, "identify", "-format", "%wx%h", f"{src}[0]")
            m = re.fullmatch(r"(\d+)x(\d+)", r.stdout.strip())
            if not m:
                raise ValueError(gist(r.stderr) or "its size couldn't be read")
            w, h = int(m[1]), int(m[2])
            if crop[0] + crop[2] > w or crop[1] + crop[2] > h:
                raise ValueError(f"--crop {crop[0]},{crop[1]},{crop[2]} goes past the picture's edge "
                                 f"(it's {w}×{h}: x + size at most {w}, y + size at most {h})")
        for n in PICTURE_SIZES:
            dst = Path(tmp) / f"{n}.png"
            if ffmpeg:
                square = "crop=%d:%d:%d:%d" % (crop[2], crop[2], crop[0], crop[1]) if crop \
                    else "crop='min(iw,ih)':'min(iw,ih)'"
                # Round: what's outside the circle see-through, its edge smoothed over a pixel.
                c = n / 2
                ring = f"255*clip({c}-hypot(X+0.5-{c},Y+0.5-{c})+0.5,0,1)"
                r = sh(ffmpeg, "-v", "error", "-y", "-i", str(src), "-frames:v", "1", "-vf",
                       f"{square},scale={n}:{n}:flags=lanczos,format=rgba,"
                       f"geq=r='r(X,Y)':g='g(X,Y)':b='b(X,Y)':a='{ring}'", str(dst))
            else:
                square = ["-crop", "%dx%d+%d+%d" % (crop[2], crop[2], crop[0], crop[1]), "+repage",
                          "-resize", f"{n}x{n}"] if crop else \
                    ["-resize", f"{n}x{n}^", "-gravity", "center", "-extent", f"{n}x{n}"]
                r = sh(magick, f"{src}[0]", *square, "-alpha", "set",
                       "(", "-size", f"{n}x{n}", "xc:black", "-fill", "white",
                       "-draw", f"circle {n / 2},{n / 2} {n / 2},0", ")",
                       "-compose", "CopyOpacity", "-composite", "-strip", f"PNG32:{dst}")
            try:
                out[n] = dst.read_bytes() if r.returncode == 0 else b""
            except OSError:
                out[n] = b""
            if image_kind(out[n]) != "png":
                raise ValueError(gist(r.stderr) or "it couldn't be cut to size")
    return out


def picture_crop(value):
    """--crop x,y,size: three whole numbers, the size above 0. None if not."""
    m = re.fullmatch(r"\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*", value or "")
    return (int(m[1]), int(m[2]), int(m[3])) if m and int(m[3]) > 0 else None


def set_picture(source, crop=None, big=PICTURE, small=PICTURE_SMALL, quiet=False):
    """Your assistant's picture (or an agent's: big and small, its files)
    from source (a file, - for stdin: the picture or it in base64), or
    amarchy's own again ("off"; an agent's initial)."""
    if source == "off":
        for f in (big, small):
            f.unlink(missing_ok=True)
        if not quiet:
            print("amarchy's own" if big == PICTURE else "its initial")
        return 0
    try:
        raw = sys.stdin.buffer.read(APP_WALLPAPER_MAX * 4) if source == "-" else Path(source).expanduser().read_bytes()
    except OSError as e:
        return fail(f"can't read {source}: {e.strerror or e}")
    if source == "-" and not image_kind(raw):
        try:
            raw = base64.b64decode(raw.strip(), validate=True)
        except ValueError:
            pass
    try:
        cut = picture_cut(raw, crop)
    except ValueError as e:
        return fail(str(e))
    write_file(small, cut[192])
    write_file(big, cut[512])       # last: its hash names both
    if not quiet:
        print(big)
    return 0


def cmd_assistant(args):
    """amarchy assistant [<id>] [--name <name>] | off | --picture <file>|off
    [--crop x,y,size]: which session is your assistant (prints it as
    id<TAB>name, or none), and its picture."""
    name, picture, crop, rest = None, None, None, []
    it = iter(args)
    for a in it:
        if a == "--name":
            name = next(it, None)
            if name is None or not name.strip() or len(name) > 40:
                return fail("--name takes what to call it (40 characters at most)")
            name = name.strip()
        elif a == "--picture":
            picture = next(it, None)
            if not picture:
                return fail("--picture takes a picture (a PNG, JPEG or WebP), or off for amarchy's own")
        elif a == "--crop":
            crop = picture_crop(next(it, None))
            if not crop:
                return fail("--crop takes x,y,size: the square of the picture to show, in its pixels")
        else:
            rest.append(a)
    if picture is not None or crop:
        if picture is None or rest or name is not None or (crop and picture == "off"):
            print(usage("assistant"), file=sys.stderr)
            return 1
        return set_picture(picture, crop)
    current = next((s for s in session_view() if s.get("assistant") == "main"), None)
    if not rest and name is None:
        print(f"{current['id']}\t{current['assistant_name']}" if current else "none")
        return 0
    if rest == ["off"] and name is None:
        ASSISTANT_FILE.unlink(missing_ok=True)
        if current:
            format_changed(current["id"])
        print("none")
        return 0
    if len(rest) > 1:
        print(usage("assistant"), file=sys.stderr)
        return 1
    sid = rest[0] if rest else (current or {}).get("id")
    s = session(sid) if sid else None
    if not s:
        return fail(f"No session {sid!r}" if sid else "no assistant yet: name its session (amarchy assistant <id>)")
    mine = assistant()
    if name is None and mine and mine["id"] == sid:
        try:
            name = json.loads(ASSISTANT_FILE.read_text()).get("name") or ""
        except (OSError, ValueError, AttributeError):
            name = ""
    # One of your agents made your assistant: it is that now, by the name it had.
    was = next((a for a in agents_saved() if a["id"] == sid), None)
    if was:
        name = name if name is not None else was.get("name") or ""
        agents_drop(sid)
    write_file(ASSISTANT_FILE, json.dumps({"id": sid, "name": name or ""}))
    # Its Claude writes as someone you text now (CHAT_FORMAT), and the one it
    # replaces as a working chat again.
    format_changed(*[x for x in (sid if not was and not (mine and mine["id"] == sid) else None,
                                 mine["id"] if mine and mine["id"] != sid else None) if x])
    print(f"{sid}\t{assistant()['name']}")
    return 0


def format_changed(*sids):
    """These sessions' Claudes were given another format to write in (they
    became your assistant or an agent, or stopped being one: reply_format):
    each one started again once idle, the same conversation, with it
    (claude_reload). Asleep, it wakes with it anyway."""
    for sid in sids:
        s = session(sid)
        if s and asleep_since(sid) is None and host_pane(s):
            detach([ENTRY, "claude-reload", sid])


# ------------------------------------------------------------------ your agents
#
# Besides your assistant, other chats can be your agents (`amarchy agents
# <id>`): Claudes that live on rather than finish, each with a job of its own
# (one that keeps your social media, say). An agent has what your assistant
# has but your loops (Today's loops, their Ask and Done, the week's recap:
# your assistant's alone; tasks of its own it has: amarchy task, cmd_task): a
# place on top of every list, next to your assistant,
# in the order you made them; its own name, picture and chime; what it says
# always reaches you, under its name and picture, whatever `amarchy alerts`
# lets through; and nothing treats it as a chat to finish: no Complete, no
# Stalled, no mission, its merges not on your score. Your assistant and your
# agents are your team (team()).

AGENTS_FILE = STATE / "agents"      # [{"id", "name", "sound"}], in the order you made them
AGENT_PICTURES = PICTURE.parent / "agents"      # <id>.png and <id>-192.png, cut as your assistant's
AGENT_ROLES = ("main", "agent")     # a session's role (session_view "assistant") when it's one of your team
# An agent's chime, until you pick one: the first of these nothing else rings
# with (the chats, your assistant, your other agents), picked as it's made.
AGENT_CHIMES = ("elementary", "fairy", "ocean", "vibraphone", "tine", "kalimba", "herald")


def agents_saved():
    """The agents as written down: [{"id", "name", "sound"}], closed ones too."""
    try:
        d = json.loads(AGENTS_FILE.read_text())
    except (OSError, ValueError):
        return []
    return [a for a in d if isinstance(a, dict) and isinstance(a.get("id"), str)] if isinstance(d, list) else []


def agents_write(rows):
    write_file(AGENTS_FILE, json.dumps([{k: a.get(k) or "" for k in ("id", "name", "sound")} for a in rows]))


def agents_drop(sid):
    """sid no longer one of your agents (its pictures deleted)."""
    agents_write([a for a in agents_saved() if a["id"] != sid])
    for f in (agent_picture(sid), agent_picture(sid, small=True)):
        f.unlink(missing_ok=True)


def agent_picture(sid, small=False):
    """An agent's picture file (there or not): the big one, or the phones' (192)."""
    return AGENT_PICTURES / f"{sid}{'-192' if small else ''}.png"


def agent_sound_name(a):
    """An agent's chime: its name, "off", or (picked when it was made, the
    file edited by hand since) your assistant's."""
    picked = a.get("sound") if isinstance(a.get("sound"), str) else ""
    if picked == "off":
        return picked
    return (sound_key(picked) if picked else None) or ASSISTANT_CHIME


def agent_free_chime(but=None):
    """The chime for a new agent: the first of AGENT_CHIMES nothing else
    rings with (but: an agent left out, the one being made)."""
    taken = {sound_name(), assistant_sound_name()} | {agent_sound_name(a) for a in agents_saved() if a["id"] != but}
    return next((c for c in AGENT_CHIMES if c not in taken), AGENT_CHIMES[0])


def agents(mine=None):
    """Your agents here, but your assistant: [{"id", "name", "repo", "sound"}]
    in the order you made them; closed ones left out (mine: assistant(),
    read already)."""
    mine = mine or assistant()
    out, seen = [], set()
    for a in agents_saved():
        if a["id"] in seen or (mine and a["id"] == mine["id"]):
            continue
        seen.add(a["id"])
        s = session(a["id"])
        if not s:
            continue        # closed (made again under its id, it's an agent again, as your assistant is)
        name = a.get("name") if isinstance(a.get("name"), str) else ""
        out.append({"id": a["id"], "name": name.strip() or project_name(s.get("repo", "")) or "Agent",
                    "repo": s.get("repo", ""), "sound": agent_sound_name(a)})
    return out


def team():
    """Your assistant and your agents, your assistant first: each {"id",
    "name", "repo", "sound", "role": "main" or "agent"}."""
    mine = assistant()
    crew = [{**mine, "sound": assistant_sound_name(), "role": "main"}] if mine else []
    return crew + [{**a, "role": "agent"} for a in agents(mine)]


def team_of(s, crew=None):
    """(role, who): "main" for your assistant, "agent" for another of your
    agents, "near" for another chat of one's project (your assistant's
    before an agent's), and who that is; else ("", None)."""
    crew = team() if crew is None else crew
    for a in crew:
        if a["id"] == s["id"]:
            return a["role"], a
    for a in crew:
        if a["repo"] and s.get("repo") == a["repo"]:
            return "near", a
    return "", None


def is_agent(s, crew=None):
    """Whether a session is your assistant or one of your agents: one that
    lives on, never a mission to complete."""
    return team_of(s, crew)[0] in AGENT_ROLES


def team_icon(who):
    """The picture by one of your team's notifications on the phones (a path of the app's)."""
    if not who or who["role"] == "main":
        return assistant_icon()
    sig = picture_sig(agent_picture(who["id"]))
    return f"/picture/{sig}-192.png" if sig and agent_picture(who["id"], small=True).is_file() else "/assistant-192.png"


def picture_by_sig(sig, small):
    """The picture of your team's that goes by sig (picture_sig), or None."""
    pairs = [(PICTURE, PICTURE_SMALL)] + [(agent_picture(a["id"]), agent_picture(a["id"], small=True)) for a in agents_saved()]
    return next(((sm if small else big) for big, sm in pairs if picture_sig(big) == sig), None)


def cmd_agents(args):
    """amarchy agents [--json] | <id> [--name <name>] [--picture <file>|off
    [--crop x,y,size]] [--sound <name>|off] | <id> off: your agents (your
    assistant first), one made, changed, or a chat again."""
    name, picture, crop, sound, as_json, rest = None, None, None, None, False, []
    it = iter(args)
    for a in it:
        if a == "--name":
            name = next(it, None)
            if name is None or not name.strip() or len(name.strip()) > 40:
                return fail("--name takes what to call it (40 characters at most)")
            name = name.strip()
        elif a == "--picture":
            picture = next(it, None)
            if not picture:
                return fail("--picture takes a picture (a PNG, JPEG or WebP), or off for none")
        elif a == "--crop":
            crop = picture_crop(next(it, None))
            if not crop:
                return fail("--crop takes x,y,size: the square of the picture to show, in its pixels")
        elif a == "--sound":
            sound = (next(it, None) or "").strip()
            if not sound:
                return fail("--sound takes a chime (amarchy sound --list), or off")
        elif a == "--json":
            as_json = True
        else:
            rest.append(a)
    if not rest:
        if name is not None or picture is not None or crop or sound is not None:
            print(usage("agents"), file=sys.stderr)
            return 1
        crew = team()
        if as_json:
            print(json.dumps([{"id": a["id"], "name": a["name"], "role": a["role"], "repo": a["repo"], "sound": a["sound"],
                               "picture": str(PICTURE if a["role"] == "main" else agent_picture(a["id"]))
                               if (PICTURE if a["role"] == "main" else agent_picture(a["id"])).is_file() else ""}
                              for a in crew]))
        else:
            for a in crew:
                print(f"{a['id']}\t{a['name']}" + ("\t(your assistant)" if a["role"] == "main" else ""))
            if not crew:
                print("none")
        return 0
    if len(rest) > 2 or (len(rest) == 2 and rest[1] != "off") or as_json or (crop and picture in (None, "off")):
        print(usage("agents"), file=sys.stderr)
        return 1
    sid, off = rest[0], rest[1:] == ["off"]
    s = session(sid)
    if not s:
        return fail(f"No session {sid!r}")
    mine = assistant()
    if off:
        if name is not None or picture is not None or sound is not None:
            print(usage("agents"), file=sys.stderr)
            return 1
        if mine and mine["id"] == sid:
            return fail(f"{sid} is your assistant: amarchy assistant off makes it a chat like the others again")
        if not any(a["id"] == sid for a in agents_saved()):
            return fail(f"{sid} isn't one of your agents")
        agents_drop(sid)
        format_changed(sid)
        print(f"{sid}\ta chat like the others again")
        return 0
    if sound is not None:
        key = "off" if sound.lower() == "off" else sound_key(sound)
        if not key:
            return fail(f"no sound {sound!r} (see amarchy sound --list)")
        sound = key
    if mine and mine["id"] == sid:
        # Your assistant: what amarchy assistant and amarchy sound --assistant set.
        if picture is not None and set_picture(picture, crop, quiet=True):
            return 1
        if name is not None:
            write_file(ASSISTANT_FILE, json.dumps({"id": sid, "name": name}))
        if sound is not None:
            write_file(ASSISTANT_SOUND_FILE, sound + "\n")
        print(f"{sid}\t{assistant()['name']}\t(your assistant)")
        return 0
    if picture is not None and set_picture(picture, crop, agent_picture(sid), agent_picture(sid, small=True), quiet=True):
        return 1
    rows = agents_saved()
    a = next((a for a in rows if a["id"] == sid), None)
    made = not a
    if not a:
        a = {"id": sid, "name": "", "sound": ""}
        rows.append(a)
        a["sound"] = sound or agent_free_chime(but=sid)
    if name is not None:
        a["name"] = name
    if sound is not None:
        a["sound"] = sound
    agents_write(rows)
    if made:
        format_changed(sid)     # it writes as someone you text now (CHAT_FORMAT)
    made = next(x for x in agents() if x["id"] == sid)
    print(f"{sid}\t{made['name']}")
    return 0


def alerts():
    """What the other sessions tell you about on your phones (see ALERTS)."""
    try:
        value = ALERTS_FILE.read_text().strip()
    except OSError:
        value = ""
    return value if value in ALERTS else ALERTS_DEFAULT


def missions_reset(today=None):
    """Your score from 0: MISSIONS, the badges and what was told kept in
    missions-backup-<date>/ (never deleted; a second one the same day gets
    -2, -3...), then emptied, and merges counting from now. Your goal stays.
    Returns the backup's folder."""
    day = (today or datetime.date.today()).isoformat()
    to, n = STATE / f"missions-backup-{day}", 1
    while to.exists():
        n += 1
        to = STATE / f"missions-backup-{day}-{n}"
    to.mkdir(parents=True)
    for f in (MISSIONS, MISSION_BADGES, MISSION_GOAL, MISSION_TOLD, MISSIONS_SINCE, MISSIONS_RESET, MERGES):
        if f.exists():
            shutil.copy2(f, to / f.name)
    write_file(MISSIONS, "")
    write_file(MISSION_BADGES, "{}")
    write_file(MISSIONS_SINCE, f"{int(time.time())}\n")
    write_file(MISSIONS_RESET, f"{int(time.time())}\n")     # every machine's from then on (see "your stuff on every machine")
    _missions.clear()
    return to


def cmd_missions(args):
    """amarchy missions [--goal <n>] [--reset]: your score, as the app shows it;
    your daily goal set; or your score back to 0 (kept in a backup first)."""
    if "--reset" in args:
        to = missions_reset()
        print(f"Your score starts from 0 now; what you had is kept in {to}")
    if "--goal" in args:
        i = args.index("--goal")
        try:
            g = int(args[i + 1])
        except (IndexError, ValueError):
            return fail("--goal takes a number (0: none)")
        if not 0 <= g <= 50:
            return fail("a goal from 0 to 50")
        write_file(MISSION_GOAL, f"{g}\n")
    v = missions_view()
    n = len(v["today"])
    print(f"merged today {n}" + (f" of {v['goal']}" if v["goal"] else ""))
    print(f"streak       {v['streak']} day{'s' if v['streak'] != 1 else ''}" + (" (merge one today to keep it)" if v["streak"] and not n else ""))
    print(f"best day     {v['best']}")
    print(f"all time     {v['total']}  (counting since {time.strftime('%Y-%m-%d %H:%M', time.localtime(v['since']))})")
    print(f"this week    {' '.join(str(x) for x in v['week'])}")
    r = v["replies"]
    print(f"replies      {r['n']} today, {r['fast']} fast; {r['streak']} fast in a row (best {r['best']})")
    got = [b["name"] for b in v["badges"] if b["at"]]
    print(f"badges       {len(got)}/{len(v['badges'])}: {', '.join(got) if got else 'none yet'}")
    for m in v["today"]:
        print(f"  {time.strftime('%H:%M', time.localtime(m['at']))}  {m['task'] or m['id']}" + (f"  {m['url']}" if m.get("url") else ""))
    return 0


def cmd_alerts(args):
    """amarchy alerts [all|needs-you|assistant]: prints it, or sets it."""
    if len(args) > 1 or args and args[0] not in ALERTS:
        print(usage("alerts"), file=sys.stderr)
        return 1
    if args:
        write_file(ALERTS_FILE, args[0] + "\n")
    print(alerts())
    return 0


def alert_kind(s, state, prev):
    """Whether a session that went on to need you (waiting) or finished (idle
    after working, its turn done: not one that only started, or that you
    stopped) tells you so: "assistant" for your assistant or one of your
    agents, which always do, "session" for another one when amarchy alerts
    lets it, else None."""
    if not (state == "waiting" or (state == "idle" and prev == "working" and finished_now(s["id"]))):
        return None
    if (s["assistant"] if "assistant" in s else assistant_role(s)) in AGENT_ROLES:
        return "assistant"
    level = alerts()
    return "session" if level == "all" or (level == "needs-you" and state == "waiting") else None


_said = {}

# What of a step's input the list needs to say it in words (app.js's
# stepWords): never a file's content or an edit's text.
STEP_KEYS = ("file_path", "notebook_path", "path", "description", "pattern", "query", "url",
             "skill", "to", "run_in_background")


def step_input(given):
    """What of a step's input says it in words (STEP_KEYS), and for a
    question or a plan what ask_words needs: the questions, the plan's title."""
    given = given if isinstance(given, dict) else {}
    out = {k: (v[:200] if isinstance(v, str) else v) for k, v in given.items()
           if k in STEP_KEYS and isinstance(v, (str, bool))}
    if isinstance(given.get("questions"), list):
        out["questions"] = [{"question": str(q.get("question") or "")[:200]}
                            for q in given["questions"][:8] if isinstance(q, dict)]
    if isinstance(given.get("plan"), str):
        out["plan"] = next((l for l in given["plan"].splitlines() if l.startswith("#")), "")[:200]
    return out


UNREAD_MAX = 99         # messages counted unread, at most (the badge says 99 past it)


def last_words(s, limit=240, deep=False):
    """From the end of the session's conversation: the last thing its Claude
    wrote, in a line (said: the list's preview), when (said_at), the times
    of the messages it wrote last (stamps, the newest last, at most
    UNREAD_MAX: what may be unread) and how many of those came after your
    last message (after_you), and the step it's on, if its last tool call
    has no result yet (step: {tool, input}, or None). deep: reading further
    back for the messages since your last one (your assistant's and your
    agents', whose unread ones are counted). Read again only when the
    conversation has moved."""
    f = transcript(s)
    none = {"said": "", "said_at": 0, "stamps": [], "after_you": 0, "step": None}
    if not f:
        return none
    try:
        size = f.stat().st_size
        hidden = turns_hidden(s)        # (the quiet turns and the one held: not words you'd read)
        stamp = (f.stat().st_mtime_ns, len(hidden[0]), hidden[0][-1:], hidden[1])
    except OSError:
        return none
    key = f"{f}|{int(deep)}"
    if _said.get(key, (None,))[0] == stamp:
        return _said[key][1]
    words = none
    # The last 64 KB has it nearly always; a long tool result can push it further back.
    for tail in (64_000, 400_000):
        said, said_at, stamps, after_you, step, done, looking, counting, fixed = "", 0, [], 0, None, set(), True, True, False
        for r in reversed(conversation_records(f, tail=tail)):
            if not isinstance(r, dict) or r.get("isSidechain") or record_hidden(r, hidden):
                continue
            message = r.get("message") if isinstance(r.get("message"), dict) else {}
            content = message.get("content")
            if r.get("type") == "user":
                if isinstance(content, list):
                    done.update(b.get("tool_use_id") for b in content if isinstance(b, dict) and b.get("type") == "tool_result")
                # A message of yours (or sent in your name): what came before it, you'd read.
                if counting and human_record(r):
                    counting = False
                # A reply sent back to be written again (reply_fix): the words
                # just before it were replaced by the ones after it.
                fixed = fix_feedback(r)
                continue
            if r.get("type") != "assistant":
                continue
            if looking and isinstance(content, list):
                uses = [b for b in content if isinstance(b, dict) and b.get("type") == "tool_use"]
                if uses:
                    looking = False
                    if uses[-1].get("id") not in done:
                        step = {"tool": uses[-1].get("name") or "", "input": step_input(uses[-1].get("input"))}
            texts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"] \
                if isinstance(content, list) else [content] if isinstance(content, str) else []
            texts = [t for t in (without_goal(t).strip() for t in texts) if t]      # (its goal: Today's, not words)
            if deep:
                texts = [m for t in texts for m in chat_messages(t)]       # several messages, a bubble each
            if not texts or fixed:
                continue
            if len(stamps) < UNREAD_MAX:
                n = min(len(texts), UNREAD_MAX - len(stamps))
                stamps[:0] = [gh_time(r.get("timestamp") or "") or 0] * n
                if counting:
                    after_you += n
            if said:
                continue
            text = texts[-1] if deep else " ".join(texts)       # (your team's: its last message)
            text = re.sub(r"(?m)^ {0,3}```.*$", "", text)       # a block's fences: its words stay
            # Markdown's marks and list bullets out: words, in a line.
            # (Only emphasis marks: TEST_KEY keeps its underscore.)
            text = re.sub(r"(?m)^\s*(?:[-*+•]|\d+[.)]|#+|>)\s+", "", text)
            text = re.sub(r"\*\*|__|`|(?<!\w)[*_](?=\S)|(?<=\S)[*_](?!\w)", "", text)
            text = " ".join(text.split())
            if text:
                said = text if len(text) <= limit else text[:limit - 1].rstrip() + "…"
                said_at = gh_time(r.get("timestamp") or "")
        words = {"said": said, "said_at": said_at, "stamps": stamps, "after_you": after_you, "step": step}
        if size <= tail or (said and not (deep and counting and len(stamps) < UNREAD_MAX)):
            break
    _said[key] = (stamp, words)
    if len(_said) > 500:        # sessions long closed
        _said.clear()
    return words


def last_said(s, limit=240):
    """The last thing the session's Claude wrote, in a line, or "" (last_words)."""
    return last_words(s, limit)["said"]


# ------------------------------------------------------------------ update

# ---- a packaged amarchy
#
# amarchy runs from a git checkout (what install.sh links), or from a package
# (packaging/arch: /usr/share/amarchy, read only, no .git, its commit in
# .version, /usr/bin/amarchy). A package updates with your packages (pacman,
# yay), never by itself: `amarchy update` says so, and the timer only checks
# Claude Code. `amarchy setup` is install.sh there (your own part: the timers,
# the skill, Omarchy's pieces), run as you.

def packaged():
    """The package amarchy is installed by ("amarchy-git"), or None when it
    runs from a git checkout."""
    root = Path(SELF).parent.parent
    if (root / ".git").exists():
        return None
    if shutil.which("pacman"):
        r = sh("pacman", "-Qqo", SELF)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip().splitlines()[0]
    return "a package"


def cmd_setup(args):
    """`amarchy setup [install.sh's options]`: install.sh of the amarchy
    that runs, as you (on a package, the part that's yours)."""
    script = Path(SELF).parent.parent / "install.sh"
    if not script.is_file():
        return fail(f"no install.sh beside this amarchy ({script})")
    if os.geteuid() == 0:
        return fail("run amarchy setup as yourself, not root: it sets amarchy up for your user")
    os.execv(str(script), [str(script), *args])


def self_update():
    """Bring amarchy here up to origin's main (`amarchy update`, which a
    timer runs every few minutes). Only when amarchy runs from a checkout of
    main with nothing uncommitted (not a session's worktree, not work in
    progress): pull it and run its install.sh, as you would. Says what it
    did, or why it didn't; "not updated: ..." when it couldn't. A package
    isn't: it updates with your packages."""
    repo = Path(SELF).parent.parent
    pkg = packaged()
    if pkg:
        # Your packages brought a new one: your part of it set up again (the
        # timers, the skill, Omarchy's pieces, the node's service), as an
        # update from git does.
        try:
            now, was = (repo / ".version").read_text().strip(), (STATE / "setup-version").read_text().strip()
        except OSError:
            now, was = None, None
        if now and was and now != was:
            r = subprocess.run([str(repo / "install.sh")], capture_output=True, text=True, env=clean_env(),
                               stdin=subprocess.DEVNULL, timeout=600)
            if r.returncode:
                return f"not updated: {pkg} is new ({now}), but setting it up again failed: " \
                       f"{(r.stderr or r.stdout).strip().splitlines()[-1:]}"
            return f"set up again for {pkg} {now} (was {was})"
        return f"installed by {pkg}: it updates with your packages (pacman -Syu, or your AUR helper)"
    env = {**clean_env(), "GIT_TERMINAL_PROMPT": "0"}

    def git(*args):
        return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, env=env,
                              stdin=subprocess.DEVNULL, timeout=120)
    head = git("rev-parse", "HEAD").stdout.strip()
    if git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip() != "main":
        return f"not updated: {repo} isn't on main"
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        return f"not updated: {repo} has uncommitted changes"
    if git("fetch", "--quiet", "origin", "main").returncode:
        return "not updated: couldn't fetch origin"
    if head == git("rev-parse", "origin/main").stdout.strip():
        return "up to date"
    if git("merge-base", "--is-ancestor", "HEAD", "origin/main").returncode:
        return "not updated: main here has commits origin doesn't"
    before = git("rev-parse", "--short", "HEAD").stdout.strip()
    if git("merge", "--ff-only", "--quiet", "origin/main").returncode:
        return "not updated: couldn't fast-forward main"
    r = subprocess.run([str(repo / "install.sh")], capture_output=True,
                       text=True, env=env, stdin=subprocess.DEVNULL, timeout=300)
    if r.returncode:
        return f"not updated: main is at origin's, but install.sh failed: {(r.stderr or r.stdout).strip().splitlines()[-1:]}"
    after = git("rev-parse", "--short", "HEAD").stdout.strip()
    return f"updated {before} → {after}"


# ---- the chat engine's protocol test: what new sessions default to depends on it

PROTOCOL_TEST = Path(SELF).parent / "amarchy-protocol-test"
PROTOCOL_LOCK = STATE / "protocol-check.lock"    # held while the test runs


def claude_version():
    """Claude Code's version as `claude --version` says it ("2.1.309"), or None."""
    try:
        out = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=30,
                             env=clean_env()).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r"\d+\.\d+\.\d+", out)
    return m.group(0) if m else None


def protocol_check_due():
    """Whether the protocol test should run: nothing recorded yet, or the
    Claude Code installed now isn't the one it last ran on (its version changed)."""
    version = claude_version()
    if not version:
        return False
    try:
        check = json.loads(ENGINE_CHECK_FILE.read_text())
    except (OSError, ValueError):
        return True
    return not isinstance(check, dict) or check.get("claude_code") != version


def protocol_check_busy():
    """Whether a protocol test is running now (it holds PROTOCOL_LOCK)."""
    PROTOCOL_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(PROTOCOL_LOCK, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
    return False


def cmd_protocol_check(args):
    """amarchy protocol-check [--broker]: runs the chat engine's protocol test
    (bin/amarchy-protocol-test: a few cheap haiku turns on your login, about 3
    minutes; --broker also runs a test session) for the Claude Code installed,
    and records the result. A failure keeps new sessions on the terminal engine
    and says why (amarchy engine). amarchy update starts it when Claude Code has
    changed since it last ran."""
    if args not in ([], ["--broker"]):
        print(usage("protocol-check"), file=sys.stderr)
        return 1
    if protocol_check_busy():
        return fail("the protocol test is already running")
    with open(PROTOCOL_LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        version = claude_version()
        if not version:
            return fail("no claude on PATH: the protocol test can't run")
        print(f"Running the chat engine's protocol test on Claude Code {version} (about 3 minutes)…", flush=True)
        why, report = None, None
        try:
            r = subprocess.run([str(PROTOCOL_TEST), "--json", *args], capture_output=True, text=True,
                               timeout=1800, env=clean_env())
            report = json.loads(r.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired) as e:
            why = f"the test didn't finish ({gist(str(e))})"
        checks = report.get("checks", []) if isinstance(report, dict) else []
        failed = [c for c in checks if c.get("status") == "fail"]
        if report is not None and (failed or report.get("ok") is not True):
            first = failed[0] if failed else {}
            why = f"{first.get('name', 'the test')} failed: {gist(first.get('error') or 'see amarchy protocol-check')}"
        ok = why is None
        check = {"ok": ok, "claude_code": version, "at": time.strftime("%Y-%m-%dT%H:%M:%S"),
                 "failed": [c.get("name") for c in failed], "checks": len(checks), "why": why}
        write_file(ENGINE_CHECK_FILE, json.dumps(check, indent=2) + "\n")
    if ok:
        print(f"The chat engine passes on Claude Code {version}.")
        return 0
    print(f"The chat engine fails on Claude Code {version}: {why}. New sessions start on the terminal engine.")
    return 1


def cmd_update(args):
    """`amarchy update`: to the latest amarchy on GitHub (origin's main).
    --auto: as the timer install.sh sets up runs it, every few minutes: one at a time, quiet when there's nothing new, and not at all
    with AUTO_UPDATE=off in ~/.config/amarchy/host."""
    auto = "--auto" in args
    # Claude Code changed since the chat engine's protocol test last ran: run it
    # again, in the background, whatever the auto-update setting (see protocol-check).
    if protocol_check_due() and not protocol_check_busy():
        detach([ENTRY, "protocol-check"])
    if auto and (host_setting("AUTO_UPDATE") or "").lower() in ("off", "no", "0", "false"):
        return 0
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "update.lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0 if auto else fail("already updating")
        said = self_update()
    if not (auto and (said == "up to date" or said.startswith("installed by"))):
        print(f"amarchy: {said}", file=sys.stderr if said.startswith("not updated") else sys.stdout)
    return 1 if said.startswith("not updated") else 0


# ------------------------------------------------------------------ clipboard
#
# Pasting an image into a session's Claude (Ctrl+V): Claude Code reads the
# clipboard by running wl-paste (or xclip) where it runs, and a server has no
# clipboard. So a session's Claude finds amarchy's own wl-paste first on its
# PATH (bin/amarchy-paste, as `amarchy paste`; see paste_path), and install.sh
# links it into ~/.local/bin too (for the terminal, and a Claude already
# running) when the machine has no wl-paste of its own.
#
# The clipboard it reads is the app's: what you last pasted into a session
# from a browser or the phone (an image, or text), or copied in one of its
# terminals there, which the app keeps in <state>/clipboard/web.clip (the web
# clipboard, yours only) until something else replaces it. Only reading: the
# options that list or print what's copied, nothing else (wl-paste --watch
# runs a command).

CLIP_DIR = STATE / "clipboard"          # the web clipboard (web.clip), yours only
PASTE_BIN = STATE / "paste"             # wl-paste for a session's Claude (a link to bin/amarchy-paste)
WEB_CLIP = CLIP_DIR / "web.clip"        # what a browser or phone last handed the app (see web_clip)
PASTE_FLAGS = {"-l": "--list-types", "--list-types": "--list-types", "-n": "--no-newline",
               "--no-newline": "--no-newline", "-p": "--primary", "--primary": "--primary"}
MIME = re.compile(r"(?!-)[\w.+-]+(/[\w.+-]+)?(; ?[\w.+-]+=[\w.+-]+)*")


def paste_args(args):
    """wl-paste's options as amarchy passes them on (its long ones), or None
    for one it doesn't (anything but listing or printing what's copied)."""
    out, it = [], iter(args)
    for a in it:
        if a in PASTE_FLAGS:
            out.append(PASTE_FLAGS[a])
        elif a in ("-t", "--type") or a.startswith("--type="):
            value = a.partition("=")[2] if "=" in a else next(it, "")
            if not (len(value) <= 120 and MIME.fullmatch(value)):
                return None
            out += ["--type", value]
        elif re.fullmatch(r"-[lnp]{2,3}", a):
            out += [PASTE_FLAGS[f"-{c}"] for c in a[1:]]
        else:
            return None
    return out


def web_clip_save(items):
    """The web clipboard is now these [(type, bytes)], the first the one a
    plain wl-paste prints: a JSON line of their types and sizes, then each."""
    head = {"time": time.time(), "types": [[kind, len(data)] for kind, data in items]}
    CLIP_DIR.mkdir(parents=True, exist_ok=True)
    CLIP_DIR.chmod(0o700)
    tmp = WEB_CLIP.with_name(f".{WEB_CLIP.name}.{os.getpid()}.{threading.get_ident()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(json.dumps(head).encode() + b"\n")
        for _, data in items:
            f.write(data)
    os.replace(tmp, WEB_CLIP)


def web_clip():
    """What the web clipboard holds: [(type, bytes)], or [] when nothing."""
    try:
        with open(WEB_CLIP, "rb") as f:
            head = json.loads(f.readline())
            items = [(str(kind), f.read(int(n))) for kind, n in head["types"]]
    except (OSError, ValueError, KeyError, TypeError):
        return []
    return [(kind, data) for kind, data in items if MIME.fullmatch(kind)]


def web_clip_answer(args):
    """wl-paste's answer from the web clipboard, for its options as
    paste_args gives them: (exit code, error, what it prints)."""
    items = web_clip()
    if not items or "--primary" in args:
        return 1, "Nothing is copied", b""
    if "--list-types" in args:
        kinds = [kind for kind, _ in items]
        if any(k.startswith("text/plain") for k in kinds):
            kinds += [k for k in ("TEXT", "STRING", "UTF8_STRING") if k not in kinds]
        return 0, "", "".join(f"{k}\n" for k in kinds).encode()
    want = (args[args.index("--type") + 1] if "--type" in args else items[0][0]).split(";")[0].strip().lower()
    text = want in ("text", "string", "utf8_string") or want.startswith("text/")
    item = next((d for k, d in items if k.split(";")[0].lower() == want), None)
    if item is None:
        item = next((d for k, d in items if (want in ("image", "image/*") and k.startswith("image/"))
                     or (text and k.startswith("text/plain"))), None)
    if item is None:
        return 1, "No suitable type of content copied", b""
    # wl-paste ends text with a newline unless told not to; images as they are.
    textual = text or (want == items[0][0].split(";")[0].lower() and want.startswith("text/"))
    if textual and "--no-newline" not in args and not item.endswith(b"\n"):
        item += b"\n"
    return 0, "", item


def cmd_paste(args):
    """wl-paste for a session's Claude: what you last pasted (or copied) in
    the app, on the phone or in a browser (see "clipboard")."""
    passed = paste_args(args)
    if passed is None:
        print(f"wl-paste (amarchy): only -l, -t <type>, -n and -p, not {' '.join(args)}", file=sys.stderr)
        return 2
    code, err, data = web_clip_answer(passed)
    if code == 0:
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
    elif err:
        print(err, file=sys.stderr)
    return code


def paste_path():
    """The PATH a session's Claude gets: amarchy's wl-paste first (see
    "clipboard"). Unchanged when the link can't be made."""
    path = os.environ.get("PATH", "")
    link, target = PASTE_BIN / "wl-paste", Path(SELF).parent / "amarchy-paste"
    try:
        if not link.is_symlink() or os.readlink(link) != str(target):
            PASTE_BIN.mkdir(parents=True, exist_ok=True)
            tmp = link.with_name(f".wl-paste.{os.getpid()}")
            tmp.unlink(missing_ok=True)
            tmp.symlink_to(target)
            os.replace(tmp, link)
        (PASTE_BIN / "rec").unlink(missing_ok=True)     # a link from when Claude's voice mode had amarchy's rec
    except OSError:
        return path
    return os.pathsep.join([str(PASTE_BIN), *[d for d in path.split(os.pathsep) if d and d != str(PASTE_BIN)]])


# ------------------------------------------------------------------ tmux
#
# A session's Claude runs in tmux session <id> and its terminal in <id>~term,
# on a tmux server of amarchy's own (tmux -L amarchy), so your own tmux is
# left alone. The app's terminals in a browser are clients of them (amarchy
# attach), as is a terminal you ssh in from. Its settings make tmux
# disappear: no status bar, no prefix key, your terminal's keys, colors,
# titles and clipboard passed through, and the mouse scrolls back through
# what Claude printed.

TMUX_CONF = """# Written by amarchy: the tmux that keeps its sessions.
set -g prefix None
unbind C-b
set -g status off
set -g escape-time 0
set -g history-limit 100000
set -g mouse on
set -g default-terminal tmux-256color
set -s terminal-features[90] '*:RGB:clipboard:extkeys:hyperlinks:usstyle:strikethrough:overline'
set -g extended-keys always
set -g extended-keys-format csi-u
set -g set-clipboard on
set -g allow-passthrough on
set -g focus-events on
set -g set-titles on
set -g set-titles-string '#{pane_title}'
set -g window-size latest
set -g aggressive-resize on
set -g destroy-unattached off
"""

# A session's Claude in tmux: Claude; while the session sleeps, its last
# screen and a wait for the first key (see "sleep"); and when
# you quit Claude, a key to start it again.
HOST_LOOP = ('while :; do "$0" claude "$1"; if "$0" asleep "$1"; then '
             '"$0" woke "$1" "$(stty -icanon -echo -isig -ixon -icrnl min 1 time 0; dd bs=1 count=1 2>/dev/null | od -An -tx1)"; '
             'else "$0" held "$1" || exit; fi; done')


def host_loop(sid):
    """HOST_LOOP for a session, with your login shell's PATH and tools, in sh:
    bash proper would print "Killed" over Claude's last screen as it sleeps."""
    return login_shell('exec sh -c "$0" "$@"', HOST_LOOP, ENTRY, sid)


HOST_CONFIG = HOME / ".config/amarchy/host"     # NAME= and BIND= lines, for the network below
# The tmux server's socket name (tmux -L): amarchy's own. Another only for a
# second amarchy on the same machine (the tests' servers), never the live one's.
TMUX_SOCKET = os.environ.get("AMARCHY_TMUX") or "amarchy"


def host_setting(key):
    """AMARCHY_HOST_<key>, from the environment or ~/.config/amarchy/host."""
    value = os.environ.get(f"AMARCHY_HOST_{key}")
    if value is None:
        try:
            for line in HOST_CONFIG.read_text().splitlines():
                k, _, v = line.partition("=")
                if k.strip() == key:
                    value = v.strip()
        except OSError:
            pass
    return value or None


_network = None


def host_network():
    """How your devices reach what a session serves here: (name, address to
    listen on). Set in ~/.config/amarchy/host (NAME=, BIND=); else, on
    Tailscale, this machine's Tailscale name and address, so it's only
    reachable from your tailnet; else nothing but localhost (an ssh tunnel)."""
    global _network
    if _network:
        return _network
    name, bind = host_setting("NAME"), host_setting("BIND")
    if (not name or not bind) and tailscale_here():
        try:
            me = json.loads(sh("tailscale", "status", "--json").stdout or "{}").get("Self") or {}
        except ValueError:
            me = {}
        ips = [ip for ip in me.get("TailscaleIPs") or [] if "." in ip]
        if ips and me.get("Online", True):
            name = name or (me.get("DNSName") or "").split(".")[0] or None
            # amarchy's own node's address isn't this computer's to listen
            # on (its previews go through what it serves): localhost.
            if not tailnet_own():
                bind = bind or ips[0]
    _network = (name or socket.gethostname(), bind)
    return _network


def host_name():
    return host_network()[0]


def login_shell(script, *args):
    """A sh script run by the user's login shell (when it speaks sh), so it
    has the PATH and tools they set up (mise, nvm, cargo), as their own
    terminal would."""
    shell = os.environ.get("SHELL") or ""
    if Path(shell).name in ("bash", "zsh", "sh", "dash", "ksh"):
        return [shell, "-lc", script, *args]
    return ["sh", "-c", script, *args]


def tmux(*args):
    conf = STATE / "tmux.conf"
    try:
        fresh = conf.read_text() != TMUX_CONF
    except OSError:
        fresh = True
    if fresh:
        write_file(conf, TMUX_CONF)
    run = lambda *a: subprocess.run(["tmux", "-u", "-L", TMUX_SOCKET, "-f", str(conf), *a], capture_output=True,
                                    text=True, stdin=subprocess.DEVNULL, env=clean_env())
    try:
        if fresh:
            run("source-file", str(conf))     # a server already up takes the new settings
        # The server starts with the first session, in whatever started that:
        # in its own systemd scope instead, so it outlives it (a unit's
        # processes all end with it, amarchy send from a timer's say).
        if args[:1] == ("new-session",) and shutil.which("systemd-run"):
            down = run("list-sessions")
            if down.returncode != 0 and re.search(r"no server|error connecting", down.stderr):
                scoped = subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "--collect",
                                         f"--unit=amarchy-tmux-{os.getpid()}-{time.time_ns()}",
                                         "tmux", "-u", "-L", TMUX_SOCKET, "-f", str(conf), *args],
                                        capture_output=True, text=True, stdin=subprocess.DEVNULL, env=clean_env())
                if scoped.returncode == 0 or run("list-sessions").returncode == 0:
                    return scoped
        return run(*args)
    except FileNotFoundError:
        return subprocess.CompletedProcess(args, 127, "", "tmux isn't installed")


def tmux_name(sid, which="claude"):
    """A session's tmux session name: its id, without what tmux reads in a
    target ("." splits off the pane, ":" the window)."""
    return re.sub(r"[.:]", "_", sid) + ("~term" if which == "term" else "")


def tmux_has(name):
    return tmux("has-session", "-t", f"={name}").returncode == 0


TTY_TEXT_LINES = 3000       # how far back a terminal's text goes (Select text in the app)


def tty_text(sid, which):
    """What a session's terminal (which: claude or term) printed and shows
    now, as text, for the app's Select text: its last TTY_TEXT_LINES lines,
    each as it was printed (the lines tmux wrapped to the width joined
    again, so a long address or command is whole), without the blank ones
    at its end. None when it isn't running."""
    r = tmux("capture-pane", "-p", "-J", "-S", f"-{TTY_TEXT_LINES}", "-t", f"={tmux_name(sid, which)}:")
    if r.returncode != 0:
        return None
    lines = [l.rstrip() for l in r.stdout.splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    return "\n".join(lines)


def tty_bottom(sid, which):
    """A session's terminal back at its bottom, live: out of tmux's copy
    mode, where scrolling back (the wheel, a finger) leaves it. What the
    app types from its message line or pastes then lands at the prompt,
    not in copy mode's keys. Nothing when it isn't in that mode."""
    target = f"={tmux_name(sid, which)}:"
    r = tmux("display-message", "-p", "-t", target, "#{pane_in_mode}")
    if r.returncode == 0 and r.stdout.strip() not in ("", "0"):
        tmux("send-keys", "-t", target, "-X", "cancel")


def tmux_env(s):
    return [x for k, v in session_env(s).items() for x in ("-e", f"{k}={v}")]


def host_start(s, wake=False):
    """Start whatever of a session's tmux isn't running: Claude (setting the
    worktree up first, for a new one) and, once the worktree is there, the
    terminal. After a reboot, attaching brings them back like this, Claude
    asleep (the conversation, and a key to wake it), so opening your sessions
    doesn't start a Claude in each; wake starts it right away instead."""
    sid, path = s["id"], Path(s["path"])
    claude, term = tmux_name(sid), tmux_name(sid, "term")
    if not tmux_has(claude):
        if not s.get("setup") and path.is_dir() and not wake:
            # Asleep from before, it has no screen of Claude's to keep now.
            if asleep_since(sid) is None or asleep_look(sid) == FROZEN:
                mark_asleep(sid)
        cwd = path if path.is_dir() else WORK / s["repo"]
        tmux("new-session", "-d", "-s", claude, "-x", "200", "-y", "50", "-c", str(cwd), *tmux_env(s),
             *host_loop(sid))
        tmux("select-pane", "-t", f"={claude}:", "-T", f"amarchy:{sid}")
    if not s.get("setup") and path.is_dir() and not tmux_has(term):
        tmux("new-session", "-d", "-s", term, "-x", "100", "-y", "50", "-c", str(path), *tmux_env(s),
             ENTRY, "shell", sid)       # the shell, with the project's secrets (cmd_shell)


def host_pane(s):
    """A session's Claude pane in tmux, as sleep handles it: {"pid": the
    pane's process} (the loop, HOST_LOOP), or None while it has none."""
    pid = tmux("display-message", "-p", "-t", f"={tmux_name(s['id'])}:", "#{pane_pid}").stdout.strip()
    return {"pid": int(pid)} if pid.isdigit() else None


def host_respawn(s):
    """Restart a session's Claude pane on HOST_LOOP: a pane from before
    sessions could sleep on a host, its Claude stopped, sleeps from then on."""
    tmux("respawn-pane", "-k", "-t", f"={tmux_name(s['id'])}:", "-c", s["path"], *tmux_env(s), *host_loop(s["id"]))


def host_stop(s):
    """End a session's tmux: Claude first, the way quitting it would."""
    sid = s["id"]
    pid = tmux("display-message", "-p", "-t", f"={tmux_name(sid)}:", "#{pane_pid}").stdout.strip()
    if pid.isdigit():
        stop_claude({"pid": int(pid)})
    for name in (tmux_name(sid), tmux_name(sid, "term")):
        tmux("kill-session", "-t", f"={name}")


def host_run(s, command):
    """Restart the session's terminal on command: it shows the command, runs
    it, and leaves you in a shell when it ends."""
    host_start(s)
    script = f"printf '\\033[2m$ %s\\033[0m\\n' {shlex.quote(command)}; {command}"
    r = tmux("respawn-pane", "-k", "-t", f"={tmux_name(s['id'], 'term')}:", "-c", s["path"], *tmux_env(s),
             ENTRY, "shell", s["id"], script)     # then the shell; the project's secrets in both (cmd_shell)
    return 0 if r.returncode == 0 else fail(f"couldn't run it: {r.stderr.strip()}")


def host_titles():
    """The title Claude gave each session (its tmux pane's), by session id,
    for the sessions whose tmux is running."""
    panes = {}
    for line in tmux("list-panes", "-a", "-F", "#{session_name}\t#{pane_title}").stdout.splitlines():
        name, _, title = line.partition("\t")
        panes[name] = title
    return {s["id"]: panes[tmux_name(s["id"])] for s in sessions() if tmux_name(s["id"]) in panes}


def cmd_attach(args):
    """Show a session's Claude (or with term, its terminal) in this terminal
    (the app's terminals run this, or you over ssh), starting it if needed.
    Exits 3 when there's no such session."""
    sid, which = args[0], (args[1] if len(args) > 1 else "claude")
    s = session(sid)
    if not s or (CLOSING / f"{sid}.json").exists():
        try:
            why = f": {(STATE / 'failed' / sid).read_text().strip()}"
        except OSError:
            why = ""
        print(f"\r\n  {sid} {'could not start' if why else 'was closed'}{why}\r\n", flush=True)
        if why:
            time.sleep(5)
        return 3
    name = tmux_name(sid, which)
    end, said = time.time() + 600, False
    while True:
        host_start(s)
        if tmux_has(name):
            break
        if not s.get("setup") and not Path(s["path"]).is_dir():
            print(f"\r\n  {sid}'s worktree is gone ({s['path']}). Close the session.\r\n", flush=True)
            time.sleep(5)
            return 3
        if which == "term" and s.get("setup") and time.time() < end:
            if not said:
                print("\r\n  \033[2mWaiting for the worktree…\033[0m", flush=True)
                said = True
            time.sleep(0.5)
            s = session(sid)
            if not s:
                return 3
            continue
        return fail(f"couldn't start {name} in tmux")
    # On a pty of the app's server (a browser's terminal), make it tmux's
    # own terminal, so it hears when the browser resizes it.
    if os.isatty(0):
        try:
            fcntl.ioctl(0, termios.TIOCSCTTY, 0)
        except OSError:
            pass
    env = clean_env()
    # Your terminal's own TERM, if this machine knows it; else close enough.
    if not env.get("TERM") or sh("infocmp", env["TERM"]).returncode != 0:
        env["TERM"] = "xterm-256color"
    os.execvpe("tmux", ["tmux", "-u", "-L", TMUX_SOCKET, "-f", str(STATE / "tmux.conf"),
                        "attach-session", "-t", f"={name}"], env)


def cmd_held(sid):
    """After the session's Claude has exited (quit, not asleep): start it again on
    Enter. Fails (ending its tmux) when the session is gone."""
    if not session(sid) or (CLOSING / f"{sid}.json").exists():
        return 1
    sh("stty", "sane")      # a Claude that was stopped (put to sleep) left the terminal raw: Enter is \r
    print("\n  \033[2mClaude Code exited. Press Enter to start it again.\033[0m", flush=True)
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        time.sleep(1)
    return 0 if session(sid) and not (CLOSING / f"{sid}.json").exists() else 1


# ------------------------------------------------------------------ automations
#
# What runs for you by itself: every systemd user timer on this machine (the
# jobs your projects set up, amarchy's own), each with what it does in plain
# words, when it runs, how its last runs went and its log, and Run now, Pause
# and Resume (amarchy automations, the app's Automations).
#
# It's generic: nothing here knows a project's jobs. A unit says what it is
# with its Description= (the name), and, if it likes, keys systemd itself
# ignores (any X- key), in the timer or its service:
#
#   X-Amarchy-Name=Heartbeat                  the name, short (else Description=)
#   X-Amarchy-About=What it does and why.     the plain explanation
#   X-Amarchy-When=Every 15 minutes, 7–22     the schedule in words (else made from OnCalendar=)
#   X-Amarchy-Owner=Jaken                     whose it is (else the project its file is in)
#   X-Amarchy-Children=meet-*.timer           the timers it makes (systemd-run): shown under it
#
# Pausing never removes a unit or a link to one (systemctl disable would take a
# linked unit's file away with it): the timer is stopped, and a drop-in of its
# own (AUTOMATION_PAUSE) keeps it from starting again, at login and when
# anything enables it, until Resume takes the drop-in away and starts it.

USER_UNITS = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "systemd/user"
AUTOMATION_PAUSE = "zz-amarchy-paused.conf"
VENDOR_UNITS = ("/usr/", "/lib/", "/etc/")      # where the system's units are, not yours
AUTOMATION_RUNS = 10        # the runs each one shows, latest first
AUTOMATION_LOG = 60         # lines of its log
AUTOMATION_UNIT = r"[A-Za-z0-9:_.@\\-]+\.timer"
_automations_cache = {"at": 0, "list": None}
AUTOMATIONS_FRESH = 15      # s a list is good for (the app's dot asks every few minutes)

WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
WEEKDAY_NAMES = ["Mondays", "Tuesdays", "Wednesdays", "Thursdays", "Fridays", "Saturdays", "Sundays"]


def systemctl_user(*args):
    return sh("systemctl", "--user", *args)


def unit_props(units, props):
    """systemctl show for several units at once: {Id: {prop: value}}, times
    as unix seconds (0: never)."""
    if not units:
        return {}
    r = systemctl_user("show", "--timestamp=unix", "-p", ",".join(["Id"] + props), "--", *units)
    out = {}
    for block in r.stdout.split("\n\n"):
        d = {}
        for line in block.splitlines():
            k, _, v = line.partition("=")
            if k == "TimersCalendar" or k == "TimersMonotonic":
                d.setdefault(k, []).append(v)
            else:
                d[k] = v
        if d.get("Id"):
            out[d["Id"]] = d
    return out


def unix_time(v):
    """A systemctl show --timestamp=unix value ("@1792977464") in seconds, or None."""
    m = re.fullmatch(r"@(\d+(?:\.\d+)?)", (v or "").strip())
    return float(m.group(1)) if m and float(m.group(1)) > 0 else None


def unit_keys(*files):
    """The X-Amarchy-* keys in a unit's files (its own, then its drop-ins,
    later ones winning): {"name": ..., "about": ...}."""
    keys = {}
    for f in files:
        try:
            text = Path(f).read_text(errors="replace")
        except OSError:
            continue
        text = re.sub(r"\\\n[ \t]*", " ", text)        # a line continued on the next
        for line in text.splitlines():
            m = re.match(r"\s*X-Amarchy-([A-Za-z]+)\s*=\s*(.*?)\s*$", line)
            if m:
                keys[m.group(1).lower()] = m.group(2)
    return keys


def timespan_s(text):
    """A systemd timespan ("1min 30s", "5min", "2h") in seconds, or None."""
    units = {"us": 1e-6, "ms": 1e-3, "s": 1, "sec": 1, "m": 60, "min": 60, "h": 3600, "hr": 3600,
             "d": 86400, "w": 604800}
    total, found = 0, False
    for n, u in re.findall(r"(\d+(?:\.\d+)?)\s*([a-z]*)", text or ""):
        if u not in units and u != "":
            return None
        total += float(n) * units.get(u or "s", 1)
        found = True
    return total if found else None


def span_words(s):
    """Seconds, as said: 30 seconds, 5 minutes, 2 hours, 1 day."""
    for size, one in ((86400, "day"), (3600, "hour"), (60, "minute"), (1, "second")):
        if s >= size and s % size == 0 or size == 1:
            n = round(s / size)
            return f"{n} {one}" if n == 1 else f"{n} {one}s"
    return f"{s:g} seconds"


def every_words(s):
    return f"Every {span_words(s)}" if span_words(s).split()[0] != "1" else f"Every {span_words(s).split()[1]}"


def calendar_part(text, top):
    """One field of an OnCalendar= time ("*", "7", "07..21", "00/15",
    "1,3"): the values it takes in 0..top-1, and its step if it's one."""
    values, step = set(), None
    for piece in text.split(","):
        m = re.fullmatch(r"(\*|\d+)(?:\.\.(\d+))?(?:/(\d+))?", piece)
        if not m:
            return None, None
        a = 0 if m.group(1) == "*" else int(m.group(1))
        b = int(m.group(2)) if m.group(2) else (top - 1 if m.group(1) == "*" or m.group(3) else a)
        step = int(m.group(3)) if m.group(3) else step
        values.update(range(a, b + 1, int(m.group(3) or 1)))
    return sorted(v for v in values if v < top), step


def weekday_words(text):
    """An OnCalendar= weekday part ("Mon..Fri", "Fri", "Sat,Sun") in words."""
    days = set()
    for piece in text.split(","):
        m = re.fullmatch(r"([A-Za-z]{3})[a-z]*(?:\.\.([A-Za-z]{3})[a-z]*)?", piece)
        if not m or m.group(1).title() not in WEEKDAYS or (m.group(2) and m.group(2).title() not in WEEKDAYS):
            return text
        a = WEEKDAYS.index(m.group(1).title())
        b = WEEKDAYS.index(m.group(2).title()) if m.group(2) else a
        days.update(range(a, b + 1))
    days = sorted(days)
    if days == list(range(5)):
        return "Weekdays"
    if days == [5, 6]:
        return "Weekends"
    if len(days) == 7:
        return "Every day"
    if len(days) == 1:
        return WEEKDAY_NAMES[days[0]]
    return ", ".join(WEEKDAYS[d] for d in days)


def calendar_words(expr):
    """An OnCalendar= expression as systemd normalizes it ("Mon..Fri
    *-*-* 18:00:00", "*-*-* 07..21:00/15:00") in words ("Weekdays at
    18:00", "Every 15 minutes, 7:00–21:45"), or the expression itself."""
    parts = expr.split()
    if parts and not re.match(r"[\d*]", parts[-1].split(":")[0][:1] or "x"):
        parts = parts[:-1]          # a timezone (UTC): the times given are its
    dow = parts.pop(0) if parts and re.match(r"[A-Za-z]", parts[0]) else None
    if len(parts) != 2 or parts[1].count(":") != 2:
        return expr
    date, clock = parts
    if not re.fullmatch(r"\*-\*-\*", date):
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", date):
            return "Once"
        return expr
    hours, hstep = calendar_part(clock.split(":")[0], 24)
    mins, mstep = calendar_part(clock.split(":")[1], 60)
    if hours is None or mins is None or not hours or not mins:
        return expr
    days = weekday_words(dow) if dow else "Every day"
    if mstep and len(mins) > 1:
        often = f"every {mstep} minutes"
        if len(hours) == 24:
            text = often
        elif hours == list(range(hours[0], hours[-1] + 1)):
            text = f"{often}, {hours[0]}:{mins[0]:02d}–{hours[-1]}:{mins[-1]:02d}"
        else:
            return expr
    elif len(hours) == 24 and len(mins) == 1:
        text = "every hour" + (f", at :{mins[0]:02d}" if mins[0] else "")
    elif hstep and len(hours) > 1 and len(mins) == 1:
        text = f"every {hstep} hours" + (f", at :{mins[0]:02d}" if mins[0] else "")
    elif len(hours) * len(mins) <= 4:
        times = [f"{h}:{m:02d}" for h in hours for m in mins]
        text = "at " + (" and ".join(times) if len(times) <= 2 else ", ".join(times[:-1]) + " and " + times[-1])
        return f"{days} {text}"
    else:
        return expr
    return f"{text[0].upper()}{text[1:]}" if days == "Every day" else f"{days}, {text}"


def schedule_words(calendars, monotonic):
    """When a timer runs, in words, from systemctl show's TimersCalendar and
    TimersMonotonic."""
    said = []
    for c in calendars or []:
        m = re.search(r"OnCalendar=([^;]+?)\s*;", c)
        if m:
            said.append(calendar_words(m.group(1).strip()))
    mono = {}
    for c in monotonic or []:
        m = re.search(r"\{\s*(\w+)=([^;]+?)\s*;", c)
        if m:
            mono[m.group(1)] = timespan_s(m.group(2))
    every = mono.get("OnUnitActiveUSec") or mono.get("OnUnitInactiveUSec")
    if every:
        said.append(every_words(every))
    elif not said:
        for k, after in (("OnBootUSec", "after the computer starts"), ("OnStartupUSec", "after you log in"),
                         ("OnActiveUSec", "after it's started")):
            if mono.get(k):
                said.append(f"Once, {span_words(mono[k])} {after}")
                break
    return "; ".join(dict.fromkeys(said)) or "When something starts it"


def automation_runs(service):
    """Its last runs, from the journal, latest first: [{"at", "ok", "result"}]."""
    r = sh("journalctl", "--user", f"USER_UNIT={service}", "JOB_TYPE=start", "-n", str(AUTOMATION_RUNS * 3),
           "-o", "json", "--output-fields=JOB_RESULT,__REALTIME_TIMESTAMP", "--no-pager", "-q")
    runs = []
    for line in reversed(r.stdout.splitlines()):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        res = e.get("JOB_RESULT")
        if not res or res == "skipped":      # "Starting…", or a condition said no
            continue
        runs.append({"at": int(e.get("__REALTIME_TIMESTAMP", 0)) / 1e6, "ok": res == "done", "result": res})
        if len(runs) >= AUTOMATION_RUNS:
            break
    return runs


def result_words(result, status):
    return {"exit-code": f"exited with {status}" if status else "failed", "timeout": "took too long",
            "signal": "was killed", "core-dump": "crashed", "watchdog": "stopped answering",
            "start-limit-hit": "failed too often in a row", "resources": "couldn't start",
            "failed": "failed", "dependency": "something it needs failed"}.get(result, result or "failed")


def automation_owner(keys, service_file, exec_path, tid, text):
    """Whose a job is: X-Amarchy-Owner, amarchy's own, else the project its
    file (or its program) is in, else this computer's."""
    if keys.get("owner"):
        return keys["owner"]
    if tid.startswith("amarchy-") and "Installed by amarchy" in text:
        return "Amarchy"
    for p in (service_file, exec_path):
        if not p or not os.path.isabs(p):
            continue
        try:
            rel = Path(os.path.realpath(p)).relative_to(WORK)
        except ValueError:
            continue
        if rel.parts and not rel.parts[0].startswith("."):
            return project_name(rel.parts[0])
        if len(rel.parts) > 2 and rel.parts[0] == ".worktrees":
            return project_name(rel.parts[1])
    return "This computer"


def automation_list(fresh=False):
    """Every timer of yours, as the app shows it: grouped (children under the
    one that makes them), latest first within nothing (the app orders them)."""
    if not fresh and _automations_cache["list"] is not None and time.time() - _automations_cache["at"] < AUTOMATIONS_FRESH:
        return _automations_cache["list"]
    ids, nexts = set(), {}
    r = systemctl_user("list-timers", "--all", "--output=json", "--no-pager")      # next, monotonic ones' too
    try:
        for u in json.loads(r.stdout or "[]"):
            ids.add(u["unit"])
            if isinstance(u.get("next"), (int, float)) and u["next"] > 0:
                nexts[u["unit"]] = u["next"] / 1e6
    except (ValueError, KeyError, TypeError):
        pass
    r = systemctl_user("list-unit-files", "--type=timer", "--output=json", "--no-pager")
    try:
        ids.update(u["unit_file"] for u in json.loads(r.stdout or "[]")
                   if "@." not in u["unit_file"] and u.get("state") not in ("masked", "transient"))
    except (ValueError, KeyError, TypeError):
        pass
    ids = sorted(i for i in ids if i.endswith(".timer") and "@." not in i)
    timers = unit_props(ids, ["Description", "Unit", "LastTriggerUSec", "NextElapseUSecRealtime", "TimersCalendar",
                              "TimersMonotonic", "ActiveState", "LoadState", "UnitFileState", "FragmentPath",
                              "DropInPaths", "Transient"])
    services = unit_props(sorted({t.get("Unit") for t in timers.values() if t.get("Unit")}),
                          ["Description", "ActiveState", "SubState", "Result", "ExecMainStatus", "FragmentPath",
                           "DropInPaths", "InactiveExitTimestamp", "InactiveEnterTimestamp", "ExecStart", "LoadState"])
    runs = {}
    threads = [threading.Thread(target=lambda s=s: runs.__setitem__(s, automation_runs(s)), daemon=True)
               for s in services]
    for t in threads:
        t.start()
    for t in threads:
        t.join(10)
    out = []
    for tid, t in timers.items():
        if t.get("LoadState") != "loaded":
            continue
        tfiles = [f for f in [t.get("FragmentPath"), *(t.get("DropInPaths") or "").split()] if f]
        if t.get("FragmentPath", "").startswith(VENDOR_UNITS) and not unit_keys(*tfiles):
            continue        # the system's own housekeeping (systemd-tmpfiles-clean), not a job of yours
        sid = t.get("Unit") or tid[:-len(".timer")] + ".service"
        s = services.get(sid, {})
        sfiles = [f for f in [s.get("FragmentPath"), *(s.get("DropInPaths") or "").split()] if f]
        keys = {**unit_keys(*sfiles), **unit_keys(*tfiles)}       # the timer's own win
        text = ""
        try:
            text = Path(t.get("FragmentPath") or "").read_text(errors="replace") if t.get("FragmentPath") else ""
        except OSError:
            pass
        exec_path = (re.search(r"path=([^ ;]+)", s.get("ExecStart") or "") or [None, None])[1]
        transient = t.get("Transient") == "yes"
        name = keys.get("name") or t.get("Description") or s.get("Description") or tid
        if name.startswith("[systemd-run]"):        # made without a description: what it runs, then
            name = s.get("Description") or name
            argv = re.search(r"argv\[\]=([^;]+)", s.get("ExecStart") or "")
            words = argv.group(1).split() if argv else []
            said = " ".join(w for w in words[1:] if not w.startswith("-"))
            name = f"{Path(words[0]).name}{': ' if said else ''}{said[:60]}{'…' if len(said) > 60 else ''}" if words else tid
        owner = automation_owner(keys, s.get("FragmentPath"), exec_path, tid, text)
        if not keys.get("name") and name.lower().startswith(owner.lower() + ":"):
            name = name[len(owner) + 1:].strip()
            name = name[:1].upper() + name[1:]
        paused = any(Path(p).name == AUTOMATION_PAUSE for p in (t.get("DropInPaths") or "").split()) \
            or (USER_UNITS / f"{tid}.d" / AUTOMATION_PAUSE).exists()
        running = s.get("ActiveState") in ("activating", "active", "reloading") and s.get("SubState") not in ("exited",)
        state = "running" if running else "paused" if paused else "waiting" if t.get("ActiveState") == "active" else "stopped"
        hist = runs.get(sid) or []
        started, ended = unix_time(s.get("InactiveExitTimestamp")), unix_time(s.get("InactiveEnterTimestamp"))
        last = {"at": None, "ok": None, "why": None, "took_s": None}
        if hist:
            last.update(at=hist[0]["at"], ok=hist[0]["ok"])
        if started and (not hist or started >= hist[0]["at"] - 5):
            last["at"] = started
            if ended and ended >= started:
                last["ok"] = s.get("Result") == "success"
                last["took_s"] = round(ended - started, 1)
        if last["ok"] is False:
            last["why"] = result_words(s.get("Result") if s.get("Result") != "success" else (hist[0]["result"] if hist else None),
                                       s.get("ExecMainStatus") if s.get("ExecMainStatus") not in ("0", "") else None)
        out.append({
            "id": tid, "service": sid, "name": name, "about": keys.get("about") or "",
            "description": t.get("Description") if t.get("Description") != name else s.get("Description") or "",
            "owner": owner, "when": keys.get("when") or schedule_words(t.get("TimersCalendar"), t.get("TimersMonotonic")),
            "next": None if paused or state == "stopped" else nexts.get(tid) or unix_time(t.get("NextElapseUSecRealtime")),
            "last_trigger": unix_time(t.get("LastTriggerUSec")), "last": last,
            "runs": [{"at": x["at"], "ok": x["ok"]} for x in hist], "state": state, "transient": transient,
            "children_glob": keys.get("children", "").split(), "children": [],
            "can_pause": not transient, "parent": None,
        })
    # The ones a job makes go under it; one-offs nobody claims stay on their own.
    by_id = {a["id"]: a for a in out}
    for a in out:
        for g in a["children_glob"]:
            for c in out:
                if c is not a and c["parent"] is None and fnmatch_glob(c["id"], g):
                    c["parent"] = a["id"]
                    a["children"].append(c["id"])
    for a in out:
        a.pop("children_glob")
        a["children"].sort(key=lambda c: by_id[c]["next"] or 1e18)
    _automations_cache.update(at=time.time(), list=out)
    return out


def fnmatch_glob(name, pattern):
    return fnmatch.fnmatchcase(name, pattern) or fnmatch.fnmatchcase(name, pattern + ".timer")


def automation_find(name):
    """A timer by its name, with or without .timer, or None."""
    name = (name or "").strip()
    if not name:
        return None
    tid = name if name.endswith(".timer") else f"{name}.timer"
    if not re.fullmatch(AUTOMATION_UNIT, tid):
        return None
    return next((a for a in automation_list(fresh=True) if a["id"] == tid), None)


def automation_log(a, lines=AUTOMATION_LOG):
    """Its last lines in the journal, the program's and systemd's about it:
    [{"at", "text", "error", "from"}], oldest first."""
    r = sh("journalctl", "--user", "-u", a["service"], "-n", str(lines), "-o", "json", "--no-pager", "-q",
           "--output-fields=MESSAGE,PRIORITY,SYSLOG_IDENTIFIER,__REALTIME_TIMESTAMP")
    out = []
    for line in r.stdout.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE")
        if isinstance(msg, list):        # not text: bytes
            msg = bytes(x for x in msg if isinstance(x, int) and 0 <= x < 256).decode(errors="replace")
        if not isinstance(msg, str):
            continue
        try:
            prio = int(e.get("PRIORITY", 6))
        except ValueError:
            prio = 6
        out.append({"at": int(e.get("__REALTIME_TIMESTAMP", 0)) / 1e6, "text": msg[:2000], "error": prio <= 3,
                    "from": e.get("SYSLOG_IDENTIFIER") or ""})
    return out


def automation_act(a, action):
    """Run now, pause or resume one: None, or why not."""
    _automations_cache["list"] = None
    if action == "run":
        if a["state"] == "running":
            return f"{a['name']} is running already"
        r = systemctl_user("start", "--no-block", "--", a["service"])
        return None if r.returncode == 0 else (r.stderr.strip() or f"{a['service']} didn't start")
    if action not in ("pause", "resume"):
        return "run, pause or resume"
    if a["transient"]:
        return "a one-off: it runs once, at its time, and can't be paused"
    drop = USER_UNITS / f"{a['id']}.d" / AUTOMATION_PAUSE
    if action == "pause":
        write_file(drop, "# Paused in amarchy (Automations): this timer doesn't start, not even at login, until it's\n"
                         "# resumed there (amarchy automations resume), or this file is deleted (then:\n"
                         f"# systemctl --user daemon-reload && systemctl --user start {a['id']}).\n"
                         "[Unit]\n"
                         f"ConditionPathExists=!{drop}\n")
        systemctl_user("daemon-reload")
        r = systemctl_user("stop", "--", a["id"])
        return None if r.returncode == 0 else (r.stderr.strip() or "it didn't stop")
    try:
        drop.unlink()
    except FileNotFoundError:
        pass
    try:
        drop.parent.rmdir()          # only if nothing else is in it
    except OSError:
        pass
    systemctl_user("daemon-reload")
    r = systemctl_user("start", "--", a["id"])
    return None if r.returncode == 0 else (r.stderr.strip() or "it didn't start")


def ago_words(t, now=None):
    """A time as `amarchy automations` says it: 12:45, or Mon 07:30 further away."""
    if not t:
        return "-"
    lt = time.localtime(t)
    return time.strftime("%H:%M" if time.strftime("%F", lt) == time.strftime("%F") else "%a %d %b %H:%M", lt)


def cmd_automations(args):
    what = args[0] if args and not args[0].startswith("-") else "list"
    rest = [a for a in args[1:] if not a.startswith("-")] if args and not args[0].startswith("-") else []
    if what == "list":
        items = automation_list(fresh=True)
        if "--json" in args:
            print(json.dumps(items, indent=1))
            return 0
        if not items:
            print("No automations: no systemd user timers on this machine.")
            return 0
        by_id = {a["id"]: a for a in items}
        for owner in sorted({a["owner"] for a in items}, key=lambda o: (o == "Amarchy", o == "This computer", o)):
            print(owner)
            for a in sorted((a for a in items if a["owner"] == owner and not a["parent"]), key=lambda a: a["name"].lower()):
                last = a["last"]
                said = "never" if not last["at"] else f"{ago_words(last['at'])} " + (
                    "ok" if last["ok"] else "running" if last["ok"] is None else f"FAILED ({last['why']})")
                print(f"  {a['name']}  [{a['id']}]{'  PAUSED' if a['state'] == 'paused' else ''}")
                if a["about"]:
                    print(f"    {a['about']}")
                print(f"    {a['when']} · next {ago_words(a['next'])} · last {said}")
                for c in a["children"]:
                    c = by_id[c]
                    print(f"      {ago_words(c['next'])}  {c['name']}")
        return 0
    if what in ("log", "run", "pause", "resume"):
        if len(rest) != 1:
            print(usage("automations"), file=sys.stderr)
            return 1
        a = automation_find(rest[0])
        if not a:
            return fail(f"no automation {rest[0]} (amarchy automations lists them)")
        if what == "log":
            for line in automation_log(a):
                print(f"{time.strftime('%F %T', time.localtime(line['at']))} {line['from']}: {line['text']}")
            return 0
        why = automation_act(a, what)
        if why:
            return fail(why)
        print({"run": f"{a['name']} started", "pause": f"{a['name']} paused: it won't run until you resume it",
               "resume": f"{a['name']} resumed"}[what])
        return 0
    print(usage("automations"), file=sys.stderr)
    return 1


# ------------------------------------------------------------------ the app
#
# `amarchy app`: your sessions on your phone, a web app (app/) you add to the
# home screen, and in a computer's browser (its wide layout, see "the app in
# a browser on your computer"). The list as amarchy shows it, each session's
# conversation from its transcript, what you type pasted into its Claude in
# tmux, its questions as buttons, and a notification when one needs you or is
# done (Web Push, with the chime amarchy sound picks in a browser).
#
# It's reachable from your tailnet only: the server listens on localhost, and
# `tailscale serve` puts it on https://<this machine>.<tailnet>.ts.net, where
# Tailscale says who's asking (the Tailscale-User-Login header). Only you (the
# machine's owner on Tailscale, and APP_USERS= in ~/.config/amarchy/host) get
# in, and only pages of its own can change anything (Origin), so a website
# open on your phone can't drive your sessions.
#
# Web Push needs a key pair (VAPID) and each notification encrypted for the
# phone (RFC 8291): openssl does the elliptic curve parts, Python the rest.

APP = STATE / "app"                         # its key (vapid.pem) and the phones it notifies (push.json)
APP_PAGES = Path(SELF).parent.parent / "app"
APP_UNIT = "amarchy-app.service"
APP_PORT = 7397                             # on localhost; APP_PORT= in ~/.config/amarchy/host
APP_HTTPS = 443                             # on the tailnet; APP_HTTPS= (443, 8443 or 10000)
# Who a push service should write to about this sender (Apple requires one).
APP_CONTACT = "https://github.com/ja-818/amarchy"
APP_TYPES = {".html": "text/html; charset=utf-8", ".css": "text/css; charset=utf-8",
             ".js": "text/javascript; charset=utf-8", ".webmanifest": "application/manifest+json",
             ".svg": "image/svg+xml", ".png": "image/png"}
APP_CSP = ("default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; "
           "connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; "
           "base-uri 'none'; form-action 'none'")
APP_CHUNK = 1_500_000           # bytes of a transcript read at a time (the latest first, earlier on request)
APP_KEYS = {"Enter", "Escape", "Up", "Down", "Left", "Right", "Tab", "BTab", "Space", "BSpace",
            *"0123456789"}
APP_SEEN = 15                   # seconds a session you're looking at on the phone counts as seen
APP_VIEWING = APP / "viewing.json"      # which sessions are open on a phone or in a browser (see on_screen)
KEEPALIVE = 15                  # seconds between a stream's "still here" when nothing changes
P256_SPKI = bytes.fromhex("3059301306072a8648ce3d020106082a8648ce3d030107034200")
UNITS = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "systemd/user"


def b64u(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def unb64u(text):
    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))


def openssl(*args, input=None):
    r = subprocess.run(["openssl", *args], input=input, capture_output=True)
    if r.returncode != 0:
        raise OSError(f"openssl {args[0]}: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def ec_new(path):
    """A new P-256 private key, readable by you only."""
    old = os.umask(0o077)
    try:
        openssl("ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", str(path))
    finally:
        os.umask(old)


def ec_public(path):
    """The public key of a private key file, as the 65 bytes of its point."""
    return openssl("ec", "-in", str(path), "-pubout", "-outform", "DER")[-65:]


def es256(path, data):
    """data signed with the key (ECDSA, SHA-256) as JWT wants it: r and s, 32 bytes each."""
    der = openssl("dgst", "-sha256", "-sign", str(path), input=data)
    i, ints = 2, []
    while i < len(der):
        n = der[i + 1]
        ints.append(int.from_bytes(der[i + 2:i + 2 + n], "big"))
        i += 2 + n
    return b"".join(v.to_bytes(32, "big") for v in ints)


def ecdh(path, peer):
    """The secret the key shares with a public key (65 bytes of its point)."""
    with tempfile.NamedTemporaryFile(suffix=".der") as f:
        f.write(P256_SPKI + peer)
        f.flush()
        return openssl("pkeyutl", "-derive", "-inkey", str(path), "-peerkey", f.name, "-peerform", "DER")


def gf_mult(x, y):
    """Multiplication in GCM's field (NIST SP 800-38D)."""
    z = 0
    for i in range(127, -1, -1):
        if (x >> i) & 1:
            z ^= y
        y = (y >> 1) ^ (0xE1 << 120) if y & 1 else y >> 1
    return z


def aes128gcm(key, nonce, data):
    """AES-128-GCM, ciphertext and tag. openssl's command line has no GCM, so
    it only runs AES on the counter blocks; the mode is done here."""
    n = -(-len(data) // 16)
    blocks = bytes(16) + nonce + b"\0\0\0\1" + b"".join(nonce + (i + 2).to_bytes(4, "big") for i in range(n))
    out = openssl("enc", "-aes-128-ecb", "-K", key.hex(), "-nopad", input=blocks)
    h, mask, stream = int.from_bytes(out[:16], "big"), out[16:32], out[32:]
    ct = bytes(a ^ b for a, b in zip(data, stream))
    x = 0
    for i in range(0, len(ct), 16):
        x = gf_mult(x ^ int.from_bytes(ct[i:i + 16].ljust(16, b"\0"), "big"), h)
    x = gf_mult(x ^ (len(ct) * 8), h)
    return ct + bytes(a ^ b for a, b in zip(x.to_bytes(16, "big"), mask))


def hkdf(salt, ikm, info, n):
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    return hmac.new(prk, info + b"\1", hashlib.sha256).digest()[:n]


def push_encrypt(keys, payload):
    """A notification's payload as only that phone can read it (RFC 8291, aes128gcm)."""
    ua_public, auth = unb64u(keys["p256dh"]), unb64u(keys["auth"])
    with tempfile.TemporaryDirectory() as d:
        key = Path(d) / "key.pem"
        ec_new(key)
        as_public, secret = ec_public(key), ecdh(key, ua_public)
    ikm = hkdf(auth, secret, b"WebPush: info\0" + ua_public + as_public, 32)
    salt = os.urandom(16)
    cek = hkdf(salt, ikm, b"Content-Encoding: aes128gcm\0", 16)
    nonce = hkdf(salt, ikm, b"Content-Encoding: nonce\0", 12)
    return salt + (4096).to_bytes(4, "big") + bytes([65]) + as_public + aes128gcm(cek, nonce, payload + b"\2")


def app_key():
    """The app's own key, made the first time: phones subscribe to it, and
    push services check it signed what it sends."""
    key = APP / "vapid.pem"
    if not key.exists():
        APP.mkdir(parents=True, exist_ok=True)
        APP.chmod(0o700)
        ec_new(key)
    return key


_app_public = {}


def app_public():
    """The app's public key, as phones subscribe with it (base64url)."""
    key = app_key()
    stamp = key.stat().st_mtime_ns
    if _app_public.get("stamp") != stamp:
        _app_public.update(stamp=stamp, key=b64u(ec_public(key)))
    return _app_public["key"]


def app_subscriptions():
    try:
        subs = json.loads((APP / "push.json").read_text())
    except (OSError, ValueError):
        return []
    return [s for s in subs if isinstance(s, dict) and isinstance(s.get("endpoint"), str)]


_push_lock = threading.Lock()


def app_save_subscriptions(change):
    """Change the list of phones to notify (change(list) -> list), in one go."""
    with _push_lock:
        subs = change(app_subscriptions())
        APP.mkdir(parents=True, exist_ok=True)
        old = os.umask(0o077)
        try:
            write_file(APP / "push.json", json.dumps(subs))
        finally:
            os.umask(old)


PUSH_GONE = 200                 # ended subscriptions remembered, so a device that still holds one makes a new one


def push_device(sub):
    """A device in a log line: what it is (its browser's name for itself, cut
    short) and whose push service it's on."""
    if isinstance(sub.get("app"), dict):      # a phone app (see "the phone apps")
        host = urllib.parse.urlsplit(str(sub.get("endpoint") or "")).netloc
        return f"{'iPhone' if sub['app'].get('platform') == 'ios' else 'Android'} app ({host})"
    ua = str(sub.get("device") or "")
    system = next((name for mark, name in (("iPhone", "iPhone"), ("iPad", "iPad"), ("Android", "Android"),
                                           ("Macintosh", "Mac"), ("Windows", "Windows"), ("Linux", "Linux"))
                   if mark in ua), "a device")
    browser = next((name for mark, name in (("Edg/", "Edge"), ("Firefox/", "Firefox"), ("Chrome/", "Chrome"),
                                            ("Safari/", "Safari")) if mark in ua), "")
    host = urllib.parse.urlsplit(str(sub.get("endpoint") or "")).netloc
    return f"{system}{' ' + browser if browser else ''} ({host})"


def push_log(what, sub, why=""):
    """Says in the app's log (journalctl --user -u amarchy-app) that a device
    was added to or taken off the ones notified, and why: when notifications
    stop, this is where to look."""
    print(f"amarchy app: notifications {what}: {push_device(sub)}{', ' + why if why else ''}", file=sys.stderr, flush=True)


def push_gone():
    """The endpoints whose push service said they ended (404, 410): never
    notified again, and a device that still sends one is told to make a new
    subscription (app.js's pushRefresh)."""
    try:
        gone = json.loads((APP / "push-gone.json").read_text())
    except (OSError, ValueError):
        return []
    return [e for e in gone if isinstance(e, str)] if isinstance(gone, list) else []


def push_send(sub, payload, topic=None):
    """Send one notification: True if the push service took it, False if
    that phone is gone for good (its subscription ended), None on any other
    failure (it may work next time). topic: RFC 8030's Topic (a newer one
    with the same replaces it on the way)."""
    import urllib.error
    import urllib.request
    endpoint = sub["endpoint"]
    u = urllib.parse.urlsplit(endpoint)
    claims = {"aud": f"{u.scheme}://{u.netloc}", "exp": int(time.time()) + 12 * 3600, "sub": APP_CONTACT}
    head = b64u(b'{"typ":"JWT","alg":"ES256"}') + "." + b64u(json.dumps(claims).encode())
    key = app_key()
    jwt = head + "." + b64u(es256(key, head.encode()))
    data = payload if isinstance(payload, bytes) else json.dumps(payload).encode()
    body = push_encrypt(sub["keys"], data)
    headers = {"TTL": "86400", "Urgency": "high", "Content-Encoding": "aes128gcm",
               "Content-Type": "application/octet-stream",
               "Authorization": f"vapid t={jwt}, k={app_public()}"}
    if topic:
        headers["Topic"] = topic
    req = urllib.request.Request(endpoint, data=body, method="POST", headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=20):
            return True
    except urllib.error.HTTPError as e:
        if e.code in (404, 410):
            return False
        print(f"amarchy app: push to {u.netloc} failed: {e.code} {e.read()[:200]!r}", file=sys.stderr)
    except (OSError, ValueError) as e:
        print(f"amarchy app: push to {u.netloc} failed: {e}", file=sys.stderr)
    return None


def push_all(payload, desktop=None):
    """Send a notification to every phone, dropping the ones that are gone,
    and keep it for the desktop apps (notice_put; desktop: what only they
    use, its buttons and its chime). The number of devices that took it
    (the desktop apps listening count)."""
    try:
        notice_put(payload, desktop)
    except OSError as e:
        print(f"amarchy app: couldn't keep a notice for the desktop apps: {e}", file=sys.stderr)
    payload = json.loads(mask_secrets(json.dumps(payload)))
    extra = json.loads(mask_secrets(json.dumps(desktop))) if desktop else None
    sent, gone = 0, set()
    for sub in app_subscriptions():
        try:
            if isinstance(sub.get("app"), dict):     # a phone app's: more, through the relay (see "the phone apps")
                ok = push_send(sub, phone_payload(payload, extra, sub), topic=push_topic(payload.get("tag")))
            else:
                ok = push_send(sub, payload)
        except (OSError, KeyError, ValueError) as e:
            print(f"amarchy app: couldn't send a notification: {e}", file=sys.stderr)
            ok = None
        sent += ok is True
        if ok is False:
            gone.add(sub["endpoint"])
            push_log("off", sub, "its push service says the subscription ended (the browser dropped it, or the app "
                                 "was removed): it's on again once that device opens Amarchy, or with Turn on there")
    if gone:
        app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] not in gone])
        with _push_lock:
            old = os.umask(0o077)
            try:
                write_file(APP / "push-gone.json", json.dumps((push_gone() + sorted(gone))[-PUSH_GONE:]))
            finally:
                os.umask(old)
    return sent + desktops_listening()


# ---- the phone apps (track G; docs/plan-omarchy-and-machines.md, "The phone
# apps and the push relay"; phone/). A phone app is a subscription as a
# browser's, whose push service is amarchy's relay (relay/): it forwards the
# encrypted notification to Apple's or Google's push, and only the phone can
# read it. The app's page sends it with "app" (what the phone app is), kept
# with the address it was sent to ("server"). Its notifications carry what
# the desktop app's notices do (the chat, its chime, its buttons) and where
# the buttons go, cut to what Apple's and Google's push take, with a Topic
# so a newer one for a chat replaces the older on the way.

PHONE_MAX = 2700            # bytes of a phone app's notification as JSON (the relay takes 2,900, encrypted)
PHONE_PLATFORMS = ("ios", "android")
PHONE_KEEP = ("session", "sound", "actions")    # what of a desktop notice a phone app's notification carries too


def phone_app(data):
    """What /api/push's "app" says of a phone app, checked:
    {platform, version, device}, or None (not a phone app's, or not one)."""
    if not isinstance(data, dict) or data.get("platform") not in PHONE_PLATFORMS:
        return None
    clean = lambda v, n: re.sub(r"[\x00-\x1f\x7f]", "", v)[:n] if isinstance(v, str) else ""
    return {"platform": data["platform"], "version": clean(data.get("version"), 40), "device": clean(data.get("device"), 80)}


def push_topic(tag):
    """RFC 8030's Topic for a notification's tag (its chat): the first 16
    bytes of its SHA-256, base64url (22 of the 32 characters a Topic may
    have). Nothing of the chat's name in it: the relay sees topics."""
    return b64u(hashlib.sha256(tag.encode()).digest()[:16]) if isinstance(tag, str) and tag else None


def phone_payload(payload, extra, sub):
    """A phone app's notification, as JSON bytes of PHONE_MAX at most: the
    browser's, plus the desktop notice's chat, chime and buttons (extra) and
    the address its buttons go to. Too long: its body cut first (at a word,
    with "…"), then its buttons and its picture go, then its title is cut."""
    out = {**payload, **{k: v for k, v in (extra or {}).items() if k in PHONE_KEEP and v not in (None, [])},
           "server": sub.get("server") or ""}
    enc = lambda p: json.dumps(p, ensure_ascii=False, separators=(",", ":")).encode()
    if len(enc(out)) <= PHONE_MAX:
        return enc(out)

    def cut(field):
        text = str(out.get(field) or "")
        lo, hi = 0, len(text)           # the longest cut of it that fits
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if len(enc({**out, field: text[:mid].rstrip() + "…"})) <= PHONE_MAX:
                lo = mid
            else:
                hi = mid - 1
        short = text[:lo]
        if " " in short[-40:] and lo < len(text):
            short = short[:short.rstrip().rfind(" ")]
        out[field] = short.rstrip() + "…" if lo < len(text) else text
    cut("body")
    for field in ("actions", "icon", "sound"):
        if len(enc(out)) > PHONE_MAX:
            out.pop(field, None)
    if len(enc(out)) > PHONE_MAX:
        cut("title")
    if len(enc(out)) > PHONE_MAX:       # (only an address or a tag that long: the essentials alone)
        out = {k: out[k] for k in ("title", "tag", "url", "server") if k in out}
        out["title"] = str(out.get("title") or "")[:200]
    return enc(out)


# ---- the desktop app's notices (track B; docs/plan-omarchy-and-machines.md,
# the contract's "Its notifications"). Every notification push_all sends the
# phones is kept here too, the last NOTICES_KEEP of them, and GET
# /api/notices streams each new one to the desktop apps listening, with the
# chime it rings and its buttons (notice_actions). A file, so what the CLI
# sends (amarchy notify, a task's --notify) reaches them as the server's does.

NOTICES = APP / "notices.jsonl"
NOTICES_KEEP = 200
NOTICES_RESUME = 600                    # seconds back a desktop app that reconnects picks up from (?after=)
DESKTOPS = APP / "desktops.json"        # the desktop apps listening now: {stream: when last seen}
DESKTOP_GONE = 3 * KEEPALIVE            # seconds without a word from one: it's gone
_desktops_lock = threading.Lock()


def notice_put(payload, desktop=None):
    """Keep a notification for the desktop apps (secrets masked, as for the
    phones): its id."""
    rec = {**payload, **(desktop or {}), "id": time.time_ns(), "at": int(time.time())}
    line = mask_secrets(json.dumps(rec))
    APP.mkdir(parents=True, exist_ok=True)
    with open(APP / "notices.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            lines = NOTICES.read_text().splitlines()
        except OSError:
            lines = []
        old = os.umask(0o077)
        try:
            write_file(NOTICES, "\n".join((lines + [line])[-NOTICES_KEEP:]) + "\n")
        finally:
            os.umask(old)
    return rec["id"]


def notices_after(after):
    """The notices kept since the one with id after, oldest first."""
    try:
        lines = NOTICES.read_text().splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            n = json.loads(line)
        except ValueError:
            continue
        if isinstance(n, dict) and isinstance(n.get("id"), int) and n["id"] > after:
            out.append(n)
    return out


def desktop_seen(key, gone=False):
    """A desktop app's stream (key) is still there, or has gone."""
    with _desktops_lock:
        try:
            seen = json.loads(DESKTOPS.read_text())
        except (OSError, ValueError):
            seen = {}
        now = time.time()
        seen = {k: t for k, t in (seen if isinstance(seen, dict) else {}).items()
                if isinstance(t, (int, float)) and now - t < DESKTOP_GONE}
        if gone:
            seen.pop(key, None)
        else:
            seen[key] = now
        write_file(DESKTOPS, json.dumps(seen))


def desktops_listening():
    """How many desktop apps listen for notices now."""
    try:
        seen = json.loads(DESKTOPS.read_text())
    except (OSError, ValueError):
        return 0
    now = time.time()
    return sum(1 for t in seen.values() if isinstance(t, (int, float)) and now - t < DESKTOP_GONE) \
        if isinstance(seen, dict) else 0


def notified_anywhere():
    """Whether a notification sent now reaches a device: a phone or browser
    with notifications on, or a desktop app listening."""
    return bool(app_subscriptions()) or desktops_listening() > 0


def notice_actions(s, pending=None, prefix=""):
    """A notice's buttons for a chat (its row; pending: what its Claude asks,
    when this machine runs it), at most three, as Today's card offers them:
    a permission's Allow and Deny, a plan's Approve, a question's options (one
    question, one answer), a done reply's choices (one question). prefix:
    another machine's chat, through its pass-through (/api/m/<machine>)."""
    sid = urllib.parse.quote(s["id"], safe="")
    answer, send = f"{prefix}/api/session/{sid}/answer", f"{prefix}/api/session/{sid}/send"

    def yes_no(rid):
        return [{"label": "Allow", "path": answer, "body": {"request_id": rid, "choice": "allow"}},
                {"label": "Deny", "path": answer, "body": {"request_id": rid, "choice": "deny"}}]
    if s.get("status") == "waiting":
        if any(a.get("waiting") for a in s.get("secret_asks") or [] if isinstance(a, dict)):
            return []       # a secret: only in the app, never on a notification
        first = (pending or [None])[0]
        if isinstance(first, dict) and first.get("request_id"):
            rid, tool = first["request_id"], first.get("tool")
            if tool == "AskUserQuestion":
                qs = [q for q in ((first.get("input") or {}).get("questions") or []) if isinstance(q, dict) and q.get("question")]
                opts = [o.get("label") for o in (qs[0].get("options") or []) if isinstance(o, dict) and o.get("label")] \
                    if len(qs) == 1 and not qs[0].get("multiSelect") else []
                return [{"label": o, "path": answer, "body": {"request_id": rid, "choice": "allow",
                                                               "answers": {qs[0]["question"]: o}}}
                        for o in opts] if 1 <= len(opts) <= 3 else []
            if tool == "ExitPlanMode":
                return [{"label": "Approve", "path": answer, "body": {"request_id": rid, "choice": "allow"}}]
            return yes_no(rid)
        p = s.get("permission")     # another machine's chat: what its row says
        return yes_no(p["request_id"]) if isinstance(p, dict) and p.get("request_id") else []
    asks = (s.get("today") or {}).get("asks") or []
    if len(asks) == 1:
        opts = [o for o in asks[0].get("options") or [] if isinstance(o, dict) and o.get("label") and o.get("send")]
        if 1 <= len(opts) <= 3:
            return [{"label": o["label"], "path": send, "body": {"text": o["send"]}} for o in opts]
    return []


def notice_chime(s, mine):
    """The chime a notice about a chat rings with: your assistant's or an
    agent's own, else the one picked; None when it's off."""
    if mine:
        sound = s.get("chime") or (assistant_sound_name() if s.get("assistant") == "main" else "") or ASSISTANT_CHIME
    else:
        sound = sound_name()
    return None if sound == "off" else sound


# The app's look: the theme, font and wallpaper picked in the app (Settings,
# Look) or with `amarchy theme`, which every phone and browser wears (see
# look_worn, below, which turns a theme's colors into the app's design tokens
# with app_look_vars; docs/design-tokens.md has them all).

APP_WALLPAPER_MAX = 8_000_000   # bytes of a wallpaper, a phone-sized copy
APP_LOOK_TYPES = {"ttf": "font/ttf", "otf": "font/otf", "woff": "font/woff", "woff2": "font/woff2",
                  "jpg": "image/jpeg", "png": "image/png", "webp": "image/webp"}


def image_kind(raw):
    """jpg, png or webp, by what the file starts with; None for anything else."""
    if raw[:3] == b"\xff\xd8\xff":
        return "jpg"
    if raw[:8] == b"\x89PNG\r\n\x1a\n":
        return "png"
    if raw[:4] == b"RIFF" and raw[8:12] == b"WEBP":
        return "webp"
    return None


def parse_color(value):
    """A color the way Omarchy and Hyprland write one (#rrggbb[aa],
    rgb[a](rrggbb[aa]), rgb[a](r,g,b[,a]), 0xaarrggbb) as (r, g, b, alpha),
    or None."""
    v = str(value).strip()
    m = re.fullmatch(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?", v) or \
        re.fullmatch(r"(?i)rgba?\(([0-9a-f]{6})([0-9a-f]{2})?\)", v)
    if m:
        hx, alpha = m.group(1), m.group(2)
        return (int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16), int(alpha, 16) / 255 if alpha else 1.0)
    m = re.fullmatch(r"(?i)rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)", v)
    if m:
        return (*(min(int(x), 255) for x in m.groups()[:3]), min(float(m.group(4) or 1), 1.0))
    m = re.fullmatch(r"0x([0-9a-fA-F]{2})([0-9a-fA-F]{6})", v)
    if m:
        hx = m.group(2)
        return (int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16), int(m.group(1), 16) / 255)
    return None


def css_rgba(c, alpha=1.0):
    r, g, b, a = c
    a = round(a * alpha, 3)
    return f"#{r:02x}{g:02x}{b:02x}" if a >= 1 else f"rgb({r} {g} {b} / {a})"


def qt_darker(c, factor):
    """Qt's darker(): the same hue and saturation, its HSV value divided by
    factor (what the shell dims text with)."""
    import colorsys
    h, s, v = colorsys.rgb_to_hsv(*(x / 255 for x in c[:3]))
    return (*(round(x * 255) for x in colorsys.hsv_to_rgb(h, s, v / factor)), c[3])


def wcag_contrast(a, b):
    """The WCAG contrast ratio of two colors (their red, green and blue)."""
    def lum(c):
        def channel(v):
            v /= 255
            return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
        return 0.2126 * channel(c[0]) + 0.7152 * channel(c[1]) + 0.0722 * channel(c[2])
    hi, lo = sorted((lum(a), lum(b)), reverse=True)
    return (hi + 0.05) / (lo + 0.05)


def readable(c, surfaces, fg, target=4.5):
    """A color the app uses as text too, eased toward the text color in tenths
    until it has the target contrast on every surface it sits on (the surface,
    the raised and the sunken one, and the glass over a wallpaper that lightens
    or darkens them); itself when it has it already."""
    def ok(x):
        return min(wcag_contrast(x, b) for b in surfaces) >= target
    if ok(c):
        return c
    for tenth in range(1, 11):
        t = tenth / 10
        m = (*(round(c[i] * (1 - t) + fg[i] * t) for i in range(3)), c[3])
        if ok(m):
            return m
    return fg


def app_look_vars(colors, shell, rounding):
    """The app's base design tokens (app.css, docs/design-tokens.md) from a
    theme's colors.toml and shell.toml (as dicts): a terminal palette mapped
    onto them with the same choices the Omarchy shell makes for its menus,
    popups and controls, so the app reads like them. The role tokens follow
    from these in app.css."""
    def section(name):
        v = shell.get(name)
        return v if isinstance(v, dict) else {}

    def number(name, key, default):
        v = section(name).get(key, default)
        return min(max(float(v), 0.0), 1.0) if isinstance(v, (int, float)) else default

    def colors_of(spec):
        """A shell value's colors and angle: a color, a Hyprland gradient
        ("c1 c2 45deg"), or a reference to one ("hyprland.active-border")."""
        if isinstance(spec, str) and re.fullmatch(r"[\w-]+\.[\w-]+", spec.strip()):
            ref, key = spec.strip().split(".")
            spec = section(ref).get(key)
        if not isinstance(spec, str):
            return [], None
        angle = next((float(p[:-3]) for p in spec.split() if re.fullmatch(r"-?\d+(\.\d+)?deg", p)), None)
        return [c for c in (parse_color(p) for p in spec.split() if not p.endswith("deg")) if c], angle

    def color(name, key, fallback):
        found = colors_of(section(name).get(key))[0]
        return found[0] if found else fallback

    def base(key, fallback):
        return parse_color(colors.get(key, "")) or parse_color(fallback)

    bg = color("menu", "background", base("background", "#1a1b26"))
    fg = color("menu", "text", base("foreground", "#a9b1d6"))
    # The surfaces the text sits on: the surface, and the raised and the sunken one.
    surfaces = [bg, base("lighter_background", "#24283b"), base("dark_background", "#13141c")]
    accent = readable(base("accent", "#7aa2f7"), surfaces, fg)     # a title, a status word: text on the surface too
    border, angle = colors_of(section("popups").get("border", "hyprland.active-border"))
    border = border or [accent]
    # Hyprland's 0deg runs left to right, CSS's bottom to top.
    gradient = (f"linear-gradient({round(90 - (angle or 0), 2)}deg, {', '.join(css_rgba(c) for c in border)})"
                if len(border) > 1 else css_rgba(border[0]))
    controls = section("controls")
    light = colors.get("mode") == "light" if colors.get("mode") in ("light", "dark") \
        else sum(bg[:3]) / 3 > 140
    out = {
        "surface": css_rgba(bg),
        "surface-sunken": css_rgba(base("dark_background", "#13141c")),
        "surface-raised": css_rgba(base("lighter_background", "#24283b")),
        "scrim": css_rgba(color("menu", "scrim", bg), number("menu", "scrim-alpha", 0.5)),
        "text": css_rgba(fg),
        # The shell dims its text by Qt's darker(140); dimmed that far it can fall below 4.5:1 on a dark
        # surface (WCAG AA for small text), so the dimming eases off until it has 5:1 (a margin for the
        # glass over a wallpaper, which lightens what's behind the text a little).
        "text-muted": css_rgba(next((c for c in (qt_darker(fg, f) for f in (1.4, 1.3, 1.2, 1.1, 1.0))
                                     if min(wcag_contrast(c, b) for b in surfaces) >= 5.0), fg)),
        "text-selection": css_rgba(base("selection", "#292e42")),
        "accent": css_rgba(accent),
        "border-faint": css_rgba(fg, 0.12),
        "border": css_rgba(fg, 0.2),
        "border-menu": css_rgba(color("menu", "border", fg), number("menu", "border-alpha", 1.0)),
        "border-popup": gradient,
        "border-popup-solid": css_rgba(border[0]),
        "selected-bg": css_rgba(color("menu", "selected-background", fg), number("menu", "selected-background-alpha", 0.08)),
        "selected-text": css_rgba(color("menu", "selected-text", accent)),
        "selected-border": css_rgba(color("menu", "selected-border", fg), number("menu", "selected-border-alpha", 0.25)),
        "control-bg": css_rgba(fg, number("controls", "normal-fill-alpha", 0.04)),
        "control-border": css_rgba(color("controls", "normal-border", fg), number("controls", "normal-border-alpha", 0.4)),
        "control-hover": css_rgba(fg, number("controls", "hover-cursor-fill-alpha", 0.08)),
        "control-selected": css_rgba(color("controls", "selected-color", fg),
                                     number("controls", "selected-fill-alpha", 0.18)),
        "control-pressed": css_rgba(fg, number("controls", "pressed-fill-alpha", 0.22)),
        "radius": f"{rounding}px",
    }
    # Its hues, by name.
    for key, fallback in (("red", "#f7768e"), ("yellow", "#e0af68"), ("green", "#9ece6a"), ("blue", "#7aa2f7"),
                          ("magenta", "#ad8ee6"), ("cyan", "#449dab"), ("orange", "#eb927b")):
        out[key] = css_rgba(readable(base(key, fallback), surfaces, fg))
    # The terminals' own colors (the 16 ANSI ones, the cursor, the
    # selection), for the app's real terminals: Claude's and the session's.
    for key, fallback in (("foreground", "#a9b1d6"), ("background", "#1a1b26"), ("cursor", "#c0caf5"),
                          ("selection_foreground", "#c0caf5"), ("selection_background", "#7aa2f7"),
                          *((f"color{i}", c) for i, c in enumerate(TERM_COLORS))):
        out["term-" + key.replace("color", "").replace("_", "-")] = css_rgba(base(key, fallback))
    return out, "light" if light else "dark"


# The tokens' names before docs/design-tokens.md, which a theme of your own
# kept from then (the look a desktop sent the app) still has: worn as the
# tokens they became.
LOOK_TOKENS_BEFORE = {
    "bg": "surface", "dark-background": "surface-sunken", "lighter-background": "surface-raised",
    "fg": "text", "dim": "text-muted", "selection": "text-selection",
    "line": "border-faint", "rule": "border", "menu-border": "border-menu",
    "popup-border": "border-popup", "popup-border-solid": "border-popup-solid",
    "sel-bg": "selected-bg", "sel-text": "selected-text", "sel-border": "selected-border",
    "control-fill": "control-bg"}


def look_tokens(variables):
    """A theme's variables as today's tokens (see LOOK_TOKENS_BEFORE): a name
    from before gives way to the token it became, unless that's set too."""
    out = {k: v for k, v in variables.items() if k not in LOOK_TOKENS_BEFORE}
    for k, v in variables.items():
        if k in LOOK_TOKENS_BEFORE:
            out.setdefault(LOOK_TOKENS_BEFORE[k], v)
    return out


# Tokyo Night's terminal colors (color0..color15), for a theme without its own.
TERM_COLORS = ("#32344a", "#f7768e", "#9ece6a", "#e0af68", "#7aa2f7", "#ad8ee6", "#449dab", "#787c99",
               "#444b6a", "#ff7a93", "#b9f27c", "#ff9e64", "#7da6ff", "#bb9af7", "#0db9d7", "#acb0d0")


# The look is picked in the app (Settings, Look) or with `amarchy theme` here,
# and every phone and browser wears it: one of amarchy's themes (themes/:
# Omarchy's palettes), a font (fonts/) and a wallpaper (the theme's: one of
# Omarchy's own, see omarchy_backgrounds; your own picture; or none). Until one is picked,
# Tokyo Night, Omarchy's own.
#
# Besides amarchy's, a theme of your own (custom_themes): a look kept whole on
# the host in app/custom/<key>, its colors as the app's variables, with its
# terminals' size and opacity, its wallpaper and maybe a font of its own. The
# look an Omarchy desktop sent the app is kept as one (amarchy migrate), so
# the app wears it as it did.

THEMES = Path(SELF).parent.parent / "themes"
FONTS = Path(SELF).parent.parent / "fonts"
APP_PICK = APP / "theme"                    # choice.json (what's picked) and your own wallpaper
CUSTOM = APP / "custom"                     # your own themes: <key>/theme.json and its files
CUSTOM_FILE = re.compile(r"(wallpaper|wallpaper-wide|regular|bold)\.(jpg|png|webp|ttf|otf|woff2?)")
LOOK_DEFAULT = "tokyo-night"
# The fonts: key -> (its name here, its family). Nerd Fonts builds, so the
# list's icons are in them; System is the device's own (SF Mono on Apple's).
LOOK_FONTS = {"jetbrains-mono": ("JetBrains Mono", "JetBrainsMono Nerd Font"),
              "caskaydia-mono": ("Caskaydia Mono", "CaskaydiaMono Nerd Font"),
              "fira-code": ("Fira Code", "FiraCode Nerd Font"),
              "system": ("System", "")}
LOOK_FONT = "jetbrains-mono"                # Omarchy's
LOOK_WALLPAPERS = {"theme": "The theme's", "own": "Your own", "none": "None"}
LOOK_TERMINAL = {"size": 12.0, "alpha": 0.92}   # the terminals' points and opacity (a theme may say its own)
# A phone's screen at 2x, upright (the biggest iPhone's 430x932 points): the
# wallpapers are cut to it. At 3x (the screen's own pixels) it was three
# times the bytes, behind the glass for no difference you see.
LOOK_PHONE = "860x1864"
LOOK_WIDE = "2880x1800"     # a laptop's screen in pixels: and at most this, for a computer's browser
LOOK_QUALITY = "60"         # a wallpaper's WebP quality (a thumbnail's: 78)
OWN_WALLPAPER = re.compile(r"own-([0-9a-f]{12})-(phone|wide)\.(jpg|png|webp)")


def theme_colors(text):
    """A colors.toml's palette with Omarchy's fallbacks filled in, as
    omarchy-theme-color resolves it (the legacy colorN names, the shades it
    derives, the mode); {} when it doesn't read."""
    import tomllib
    try:
        raw = tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        return {}
    c = {k: v.strip() for k, v in raw.items() if isinstance(v, str) and v.strip()}

    def hexmix(a, b, t):
        a, b = parse_color(a or ""), parse_color(b)
        return css_rgba((*(round(x + (y - x) * t) for x, y in zip(a[:3], b[:3])), 1)) if a and b else None

    def alias(key, other):
        if not c.get(key) and c.get(other):
            c[key] = c[other]

    for key in ("background", "dark_background", "darker_background", "lighter_background",
                "foreground", "dark_foreground", "light_foreground", "bright_foreground"):
        alias(key, key.replace("background", "bg").replace("foreground", "fg"))
    alias("background", "color0")
    alias("foreground", "color7")
    c.setdefault("background", "#1a1b26")
    c.setdefault("foreground", "#a9b1d6")
    c["color0"], c["color7"] = c["background"], c["foreground"]
    for i, key in enumerate(("red", "green", "yellow", "blue", "magenta", "cyan"), 1):
        alias(key, f"color{i}")
        alias(f"bright_{key}", f"color{i + 8}")
    alias("magenta", "purple")
    alias("bright_magenta", "bright_purple")
    alias("light_foreground", "color7")
    alias("bright_foreground", "color15")
    alias("bright_foreground", "foreground")
    c["cursor"] = c["bright_foreground"]
    alias("lighter_background", "color0")
    alias("dark_foreground", "color8")
    alias("dark_foreground", "foreground")
    alias("muted", "color8")
    alias("muted", "dark_foreground")
    for other in ("selection_background", "color8", "color0", "background"):
        alias("selection", other)
    alias("selection_background", "selection")
    alias("selection_foreground", "bright_foreground")
    alias("orange", "yellow")
    for key, (base, toward, amount) in {"brown": ("orange", "#000000", 0.5),
                                        "dark_background": ("background", "#000000", 0.25),
                                        "darker_background": ("background", "#000000", 0.5)}.items():
        if not c.get(key) and hexmix(c.get(base), toward, amount):
            c[key] = hexmix(c.get(base), toward, amount)
    for key in ("red", "yellow", "green", "cyan", "blue", "magenta"):
        if not c.get(f"bright_{key}") and hexmix(c.get(key), "#ffffff", 0.2):
            c[f"bright_{key}"] = hexmix(c.get(key), "#ffffff", 0.2)
    for i, key in enumerate(("background", "red", "green", "yellow", "blue", "magenta", "cyan", "foreground", "muted",
                             "bright_red", "bright_green", "bright_yellow", "bright_blue", "bright_magenta",
                             "bright_cyan", "bright_foreground")):
        alias(f"color{i}", key)
    mode = c.get("mode") or c.get("theme_type")
    if mode not in ("light", "dark"):
        bg = parse_color(c["background"])
        mode = "light" if bg and sum(bg[:3]) > 382 else "dark"
    c["mode"] = mode
    return c


_themes = {}


def look_themes():
    """amarchy's themes, by key: name, mode, palette, and what Omarchy's
    hyprland.lua does for it (theme.toml), in the order of their names. Read
    again when a file in themes/ changes (a pull)."""
    import tomllib
    try:
        stamp = tuple(sorted((f.parent.name, f.name, f.stat().st_mtime_ns) for f in THEMES.glob("*/*.toml")))
    except OSError:
        stamp = ()
    if _themes.get("stamp") == stamp:
        return _themes["found"]
    found = {}
    for d in THEMES.iterdir() if THEMES.is_dir() else ():
        try:
            meta = tomllib.loads((d / "theme.toml").read_text())
            colors = theme_colors((d / "colors.toml").read_text())
        except (OSError, tomllib.TOMLDecodeError):
            continue
        if colors:
            found[d.name] = {"name": str(meta.get("name") or d.name.replace("-", " ").title()), "meta": meta,
                             "colors": colors, "mode": colors["mode"]}
    _themes.update(stamp=stamp, found=dict(sorted(found.items(), key=lambda kv: kv[1]["name"].lower())))
    return _themes["found"]


def look_choice():
    try:
        choice = json.loads((APP_PICK / "choice.json").read_text())
    except (OSError, ValueError):
        return {}
    return choice if isinstance(choice, dict) else {}


_file_sigs = {}


def file_sig(path):
    """A short hash of a file, for its address: a new one when it changes."""
    try:
        st = os.stat(path)
        known = _file_sigs.get(path)
        if known and known[0] == (st.st_mtime_ns, st.st_size):
            return known[1]
        sig = hashlib.sha1(Path(path).read_bytes()).hexdigest()[:12]
    except OSError:
        return ""
    _file_sigs[path] = ((st.st_mtime_ns, st.st_size), sig)
    return sig


def look_own():
    """Your own wallpaper: {"phone": url, "wide": url, "thumb": url}, the
    picture you chose (its cuts, once they're made: look_cut), or None."""
    own = own_files()
    if not own:
        return None
    urls = {k: cut_url(f, k) or f"/own/{f.name}" for k, f in own.items()}
    return {**urls, "thumb": cut_url(own["wide"], "thumb") or urls["phone"]}


def look_shell(colors, meta):
    """The shell.toml the theme would get from Omarchy's template, as far as
    the app reads one: its border (hyprland_active_border, or theme.toml's
    border) on popups and menus."""
    border = str(meta.get("border") or colors.get("hyprland_active_border") or "")
    return {"hyprland": {"active-border": border or colors.get("accent", "#7aa2f7"),
                         "active-border-foreground": border or colors["foreground"]},
            "menu": {"border": "hyprland.active-border-foreground", "selected-border": "hyprland.active-border-foreground"}}


def custom_themes():
    """Your own themes, by key (see above): {"name", "mode", "vars",
    "terminal": {"size", "alpha"}, "wallpaper": {"phone", "wide"} (its files)
    or None, "font": {"family", "nerd", "files": {"regular", "bold"}} or
    None}. One that doesn't read, or names a file it doesn't have, is left out
    (or its wallpaper or font)."""
    out = {}
    for d in sorted(CUSTOM.iterdir()) if CUSTOM.is_dir() else ():
        try:
            t = json.loads((d / "theme.json").read_text())
        except (OSError, ValueError):
            continue
        if not re.fullmatch(r"[\w-]+", d.name) or d.name in look_themes() or not isinstance(t, dict):
            continue
        variables = t.get("vars") if isinstance(t.get("vars"), dict) else {}
        variables = look_tokens({k: v for k, v in variables.items() if isinstance(k, str) and isinstance(v, str)})
        if not variables:
            continue

        def have(f):
            return isinstance(f, str) and CUSTOM_FILE.fullmatch(f) and (d / f).is_file()
        term = t.get("terminal") if isinstance(t.get("terminal"), dict) else {}
        wall = t.get("wallpaper") if isinstance(t.get("wallpaper"), dict) else {}
        font = t.get("font") if isinstance(t.get("font"), dict) else {}
        files = font.get("files") if isinstance(font.get("files"), dict) else {}
        files = {w: f for w, f in files.items() if w in ("regular", "bold") and have(f)}
        out[d.name] = {
            "name": str(t.get("name") or d.name)[:60], "mode": "light" if t.get("mode") == "light" else "dark",
            "vars": variables,
            "terminal": {k: min(max(float(term[k]), lo), hi) for k, lo, hi in (("size", 5.0, 40.0), ("alpha", 0.0, 1.0))
                         if isinstance(term.get(k), (int, float)) and not isinstance(term.get(k), bool)},
            "wallpaper": {w: wall[w] for w in ("phone", "wide")} if all(have(wall.get(w)) for w in ("phone", "wide")) else None,
            "font": {"family": re.sub(r"[^\w .-]", "", str(font.get("family") or ""))[:64] or f"{t.get('name') or d.name}'s",
                     "nerd": bool(font.get("nerd")), "files": files} if "regular" in files else None}
    return out


def custom_url(key, f, which=None):
    """A file of a theme of yours; a wallpaper (which: "phone", "wide" or
    "thumb") as its cut once that's made."""
    return (which and cut_url(CUSTOM / key / f, which)) or f"/custom/{key}/{f}?v={file_sig(CUSTOM / key / f)}"


def look_fonts(custom=None):
    """Every font to pick, by key: {"name", "nerd", "files": {weight: url},
    "parts": {weight: {"text": url, "icons": url or None}} (those cut in two
    yet, see font_parts)}: amarchy's (fonts/), then those of your own themes
    ("custom-<theme>")."""
    out = {}
    for key, (name, family) in LOOK_FONTS.items():
        paths = {w: FONTS / key / f"{w}.woff2" for w in ("regular", "bold") if (FONTS / key / f"{w}.woff2").is_file()}
        files = {w: f"/fonts/{key}/{w}.woff2?v={file_sig(f)}" for w, f in paths.items()}
        out[key] = {"name": name, "nerd": bool(family) and bool(files), "files": files, "paths": paths}
    for key, t in (custom_themes() if custom is None else custom).items():
        if t["font"]:
            out[f"custom-{key}"] = {"name": t["font"]["family"], "nerd": t["font"]["nerd"],
                                    "files": {w: custom_url(key, f) for w, f in t["font"]["files"].items()},
                                    "paths": {w: CUSTOM / key / f for w, f in t["font"]["files"].items()}}
    for font in out.values():
        parts = {w: font_parts(f) for w, f in font.pop("paths").items()}
        font["parts"] = {w: p for w, p in parts.items() if p}
    return out


_worn = {}
LOOK_WORN_FOR = 10      # seconds look_worn's answer is kept while none of its folders changed


def look_worn():
    """The look the app wears now: the theme picked (else Tokyo Night), its
    font and its wallpaper ("wallpapers": the theme's, your own or none;
    "background": which of Omarchy's is the theme's). "sig" changes with any
    of it, a wallpaper of Omarchy's coming in too. The list reads it every
    pass: it's made again when a folder it's read from changes (a theme
    picked, one of your own, a wallpaper in, a cut made), else every LOOK_WORN_FOR."""
    choice = look_choice()
    stamp = []
    for f in (APP_PICK / "choice.json", APP_PICK, THEMES, CUSTOM, FONTS, CUTS,
              WALLS / str(choice.get("theme") or LOOK_DEFAULT), *(sorted(CUSTOM.iterdir()) if CUSTOM.is_dir() else ())):
        try:
            stamp.append((str(f), f.stat().st_mtime_ns))
        except OSError:
            stamp.append((str(f), None))
    if _worn.get("stamp") == stamp and time.time() - _worn["at"] < LOOK_WORN_FOR:
        return copy.deepcopy(_worn["look"])
    look = look_made(choice)
    _worn.update(stamp=stamp, at=time.time(), look=copy.deepcopy(look))
    return look


def look_made(choice):
    """look_worn's answer, made."""
    themes, custom = look_themes(), custom_themes()
    key = choice.get("theme") if choice.get("theme") in themes or choice.get("theme") in custom else LOOK_DEFAULT
    terminal = dict(LOOK_TERMINAL)
    t = themes.get(key)
    if key in custom:
        c = custom[key]
        look = {"name": c["name"], "mode": c["mode"], "vars": c["vars"], "claude": None}
        terminal.update(c["terminal"])
        wallpaper = {w: custom_url(key, f, w) for w, f in c["wallpaper"].items()} if c["wallpaper"] else None
        background = None
    elif not t:     # no themes/ (an amarchy from before them): app.css's own Tokyo Night
        return {"theme": key, "name": "Tokyo Night", "mode": "dark", "vars": {}, "claude": None, "terminal": terminal,
                "font": {"key": "system", "name": "System", "nerd": False, "files": {}}, "wallpaper": None,
                "wallpapers": "none", "background": None, "sig": ""}
    else:
        rounding = t["meta"].get("rounding", 0)
        variables, mode = app_look_vars(t["colors"], look_shell(t["colors"], t["meta"]),
                                        min(max(int(rounding), 0), 40) if isinstance(rounding, (int, float)) else 0)
        look = {"name": t["name"], "mode": mode, "vars": variables, "claude": t["colors"]}
        alpha = t["meta"].get("terminal-alpha")
        if isinstance(alpha, (int, float)):
            terminal["alpha"] = min(max(float(alpha), 0.0), 1.0)
        # Omarchy's wallpaper picked for it, once it's here; till then the one drawn for it.
        bg = wall_pick(key, choice)
        background = bg["key"] if bg else None
        wallpaper = wall_look(key, bg) or {w: f"/themes/{key}/{f}?v={file_sig(THEMES / key / f)}"
                                           for w, f in (("phone", "wallpaper.svg"), ("wide", "wallpaper-wide.svg"))}
    fonts = look_fonts(custom)
    font_key = choice.get("font") if choice.get("font") in fonts else LOOK_FONT
    font = {"key": font_key, **fonts[font_key]}
    walls = choice.get("wallpaper") if choice.get("wallpaper") in LOOK_WALLPAPERS else "theme"
    if walls == "own":
        wallpaper = look_own()
    elif walls == "none":
        wallpaper = None
    if wallpaper:
        wallpaper = {w: wallpaper[w] for w in ("phone", "wide")}
    look.update(theme=key, terminal=terminal, font=font, wallpaper=wallpaper, wallpapers=walls, background=background)
    look["sig"] = hashlib.sha1(json.dumps(look, sort_keys=True).encode()).hexdigest()
    return look


def look_stamp(look=None):
    """Which look the app wears, for its list: the page takes theme.css
    again when it changes."""
    look = look or look_worn()
    return {"look": look["sig"], "font": look["font"]["key"], "theme": look["theme"], "name": look["name"]}


CHART_LIGHT = ("#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948")
XPOST_LIGHT = {"bg": "#ffffff", "text": "#0f1419", "muted": "#536471", "border": "#cfd9de", "link": "#1d9bf0", "fill": "#cfd9de",
               "over": "rgba(244, 33, 46, 0.16)"}      # X's (ui.css --xpost-*: its dark)


def app_theme_css():
    """/theme.css: the look over app.css's own (Tokyo Night), and the font.
    Omarchy's wallpapers are fetched first thing, if they aren't here, and
    the look's files cut smaller (cuts_kick)."""
    walls_kick()
    cuts_kick()
    look = look_worn()
    out = [f"/* {look['name']}, as picked in the app (amarchy theme). */", ":root {"]
    out += [f"  --{k}: {v};" for k, v in look["vars"].items() if re.fullmatch(r"[\w-]+", k)
            and re.fullmatch(r"[\w#().,/% -]+", str(v))]
    out.append(f"  color-scheme: {'light' if look.get('mode') == 'light' else 'dark'};")
    if look.get("mode") == "light":     # a chart's series, stepped for a light ground (ui.css --chart-*)
        out.append("  " + " ".join(f"--chart-{i}: {c};" for i, c in enumerate(CHART_LIGHT, 1)))
        out.append("  " + " ".join(f"--xpost-{k}: {c};" for k, c in XPOST_LIGHT.items()))     # a post on X, in X's light look
    term = look["terminal"]
    if isinstance(term.get("size"), (int, float)):      # points, as a terminal has them: 96 dpi
        out.append(f"  --term-size: {round(term['size'] * 4 / 3, 2)}px;")
    if isinstance(term.get("alpha"), (int, float)):
        out.append(f"  --term-alpha: {term['alpha']};")
    if look["wallpaper"]:
        out.append(f'  --wallpaper: url("{look["wallpaper"]["phone"]}");')
        out.append(f'  --wallpaper-wide: url("{look["wallpaper"]["wide"]}");')
    files = look["font"]["files"]
    # Named after the font: another one is another family, which the terminals measure afresh.
    family = f"amarchy-{look['font']['key']}"
    out.append(f'  --font: "{family}", ui-monospace, Menlo, monospace;' if files
               else '  --font: ui-monospace, Menlo, "SF Mono", monospace;')
    out.append("}")
    if look["wallpaper"] and look["theme"] == OMARCHY_LIVE and look["wallpapers"] == "theme":
        # The Omarchy desktop's own wallpaper: the desktop app's window on an
        # Omarchy desktop (html.on-omarchy) is see-through, with it right
        # behind, so it paints none and nothing under it (app.css, body::before).
        out.append("html.on-omarchy { --wallpaper: none; --wallpaper-wide: none; --wallpaper-ground: transparent; }")
    # One file: the browser makes the bold.
    weights = {"regular": "100 900" if "bold" not in files else "400", "bold": "700"}
    text, icons = font_ranges()
    for weight, url in files.items():
        kind = url.partition("?")[0].rsplit(".", 1)[-1]
        fmt = {"ttf": "truetype", "otf": "opentype"}.get(kind, kind)
        face = f'font-family: "{family}"; font-weight: {weights[weight]}; font-display: swap;'
        parts = look["font"]["parts"].get(weight)
        if not parts:
            out.append(f'@font-face {{ {face} src: url("{url}") format("{fmt}"); }}')
            continue
        # Cut in two: the text, and the icons, which the browser fetches
        # only once it draws one (their ranges don't meet).
        out.append(f'@font-face {{ {face} src: url("{parts["text"]}") format("woff2"); unicode-range: {text}; }}')
        if parts["icons"]:
            out.append(f'@font-face {{ {face} src: url("{parts["icons"]}") format("woff2"); unicode-range: {icons}; }}')
    return "\n".join(out) + "\n"


# Claude Code in the theme's colors (Omarchy's claude.json template): the
# sessions start in it ("custom:amarchy", see hook_settings), and a session
# that has it takes a new one as soon as the file changes.
CLAUDE_LOOK = {
    "claude": ("accent",), "claudeShimmer": ("accent", "foreground", 35), "text": ("foreground",),
    "inverseText": ("background",), "inactive": ("foreground", "background", 40),
    "inactiveShimmer": ("foreground", "background", 25), "subtle": ("muted",), "suggestion": ("cyan",),
    "permission": ("blue",), "permissionShimmer": ("blue", "foreground", 35), "remember": ("yellow",),
    "success": ("green",), "error": ("red",), "warning": ("yellow",), "warningShimmer": ("yellow", "foreground", 35),
    "merged": ("magenta",), "promptBorder": ("accent",), "promptBorderShimmer": ("accent", "foreground", 35),
    "planMode": ("cyan",), "autoAccept": ("yellow",), "bashBorder": ("bright_yellow",), "ide": ("bright_cyan",),
    "diffAdded": ("background", "green", 15), "diffRemoved": ("background", "red", 15),
    "diffAddedDimmed": ("background", "green", 8), "diffRemovedDimmed": ("background", "red", 8),
    "diffAddedWord": ("background", "green", 32), "diffRemovedWord": ("background", "red", 32),
    "userMessageBackground": ("background", "foreground", 6),
    "userMessageBackgroundHover": ("background", "foreground", 10),
    "bashMessageBackgroundColor": ("background", "foreground", 6),
    "memoryBackgroundColor": ("background", "foreground", 6), "selectionBg": ("selection_background",),
    "rate_limit_fill": ("accent",), "rate_limit_empty": ("background", "foreground", 20),
    "briefLabelYou": ("yellow",), "briefLabelClaude": ("accent",),
}


def look_claude(colors):
    """Claude Code wears the theme picked (none: Claude Code's own again)."""
    if not colors:
        CLAUDE_THEME.unlink(missing_ok=True)
        return
    overrides = {}
    for key, (a, *mix) in CLAUDE_LOOK.items():
        c = parse_color(colors.get(a, ""))
        if c and mix:
            d = parse_color(colors.get(mix[0], ""))
            c = (*(round(x + (y - x) * mix[1] / 100) for x, y in zip(c[:3], d[:3])), 1) if d else c
        if c:
            overrides[key] = css_rgba((*c[:3], 1))
    write_file(CLAUDE_THEME, json.dumps({"name": "Amarchy", "base": colors["mode"], "overrides": overrides}, indent=2))


def look_set(theme=None, font=None, wallpaper=None, own=None, background=None, claude=True):
    """Pick a theme (a key of look_themes() or custom_themes()), a font (a
    key of look_fonts()) and/or a wallpaper ("theme", "own" or "none"); own:
    your own picture, (phone, wide) as image bytes; background: which of
    Omarchy's wallpapers is the theme's (its key, for the theme picked here
    or else the one worn), which wears it. Claude Code takes a new theme
    too, unless not claude. The look worn after, or an error."""
    if theme is not None and theme not in look_themes() and theme not in custom_themes():
        return f"no theme called {theme!r} (see amarchy theme --list)"
    fonts = look_fonts()
    if theme == OMARCHY_LIVE and font is None and f"custom-{OMARCHY_LIVE}" in fonts:
        font = f"custom-{OMARCHY_LIVE}"     # Omarchy's font comes with it, and follows it (see "the theme live")
    if font is not None and font not in fonts:
        return f"no font called {font!r} ({', '.join(fonts)})"
    if wallpaper is not None and wallpaper not in LOOK_WALLPAPERS:
        return "the wallpaper is theme, own or none"
    choice = look_choice()
    if background is not None:
        target = theme if theme is not None else look_worn()["theme"]
        bgs = omarchy_backgrounds().get(target) or []
        if not any(b["key"] == background for b in bgs):
            name = (look_themes().get(target) or custom_themes().get(target) or {}).get("name", target)
            return (f"{name} has no wallpaper called {background!r} (amarchy theme --list)" if bgs else
                    f"{name} has no wallpapers of Omarchy's")
        picked = choice.get("backgrounds") if isinstance(choice.get("backgrounds"), dict) else {}
        choice["backgrounds"] = {**picked, target: background}
        wallpaper = wallpaper or "theme"
    if own:
        names = {}
        for which, raw in zip(("phone", "wide"), own):
            kind = image_kind(raw or b"")
            if not kind or len(raw) > APP_WALLPAPER_MAX:
                return "that isn't a picture (a JPEG, PNG or WebP of at most 8 MB)"
            names[which] = (which, raw, kind)
        sig = hashlib.sha1(own[0] + own[1]).hexdigest()[:12]
        for which, raw, kind in names.values():
            write_file(APP_PICK / f"own-{sig}-{which}.{kind}", raw)
        choice["own"] = {which: f"own-{sig}-{which}.{kind}" for which, _, kind in names.values()}
        wallpaper = wallpaper or "own"
    if wallpaper == "own" and not own and not look_own():
        return "you have no wallpaper of your own yet: choose a picture first"
    for k, v in (("theme", theme), ("font", font), ("wallpaper", wallpaper)):
        if v is not None:
            choice[k] = v
    choice.setdefault("theme", LOOK_DEFAULT)
    write_file(APP_PICK / "choice.json", json.dumps(choice, indent=1))
    keep = set((choice.get("own") or {}).values()) | {"choice.json"}
    for f in APP_PICK.iterdir():
        if f.name not in keep and not f.name.startswith("."):
            f.unlink(missing_ok=True)
    look = look_worn()
    if theme is not None and claude:
        look_claude(look["claude"])
    return look


def look_info(kick=True):
    """Everything the app's picker shows: the themes (with their colors,
    their wallpaper and Omarchy's to pick from), the fonts, the wallpapers,
    how far Omarchy's are here ("fetch"), and what's worn. Starts fetching
    those that aren't here yet (unless not kick)."""
    if kick:
        walls_kick()
        cuts_kick()
    look, custom = look_worn(), custom_themes()
    fetch = walls_status()
    choice = look_choice()

    def wall_state(theme, bg):
        if wall_here(theme, bg):
            return "here"
        name = f"{theme}/{bg['file']}"
        return ("fetching" if fetch["current"] == name else "waiting" if fetch["running"] else
                "failed" if name in fetch["errors"] or fetch["error"] else "missing")

    def drawn(k):
        return f"/themes/{k}/wallpaper-wide.svg?v={file_sig(THEMES / k / 'wallpaper-wide.svg')}"

    def thumb(k, bg):
        f = wall_cut(k, bg, "thumb") or (WALLS / k / bg["file"] if wall_here(k, bg) else None)
        return wall_url(k, bg, f) if f else ""
    # Your own first, then amarchy's.
    themes = [{"key": k, "name": t["name"], "mode": t["mode"], "custom": True,
               "colors": [t["vars"].get(c, "") for c in ("surface", "text", "accent", "red", "yellow", "green", "blue",
                                                         "magenta")],
               "wallpaper": custom_url(k, t["wallpaper"]["wide"], "thumb") if t["wallpaper"] else ""}
              for k, t in custom.items()]
    for k, t in look_themes().items():
        bgs = omarchy_backgrounds().get(k) or []
        picked = wall_pick(k, choice)
        themes.append({"key": k, "name": t["name"], "mode": t["mode"],
                       "colors": [t["colors"].get(c, "") for c in ("background", "foreground", "accent", "red", "yellow",
                                                                   "green", "blue", "magenta")],
                       "wallpaper": (thumb(k, picked) if picked else "") or drawn(k), "drawn": drawn(k),
                       "background": picked["key"] if picked else None,
                       "backgrounds": [{"key": b["key"], "name": b["name"], "thumb": thumb(k, b),
                                        "state": wall_state(k, b)} for b in bgs]})
    own = look_own()
    repo, commit = walls_source()
    return {"theme": look["theme"], "font": look["font"]["key"], "wallpaper": look["wallpapers"], "look": look_stamp(look),
            "nerd": look["font"]["nerd"], "themes": themes,
            "fonts": [{"key": k, "name": f["name"], "nerd": f["nerd"]} for k, f in look_fonts(custom).items()],
            "own": own["thumb"] if own else "",
            # (Cutting those here again isn't downloading: not running, for the app.)
            "fetch": {**{k: fetch[k] for k in ("total", "have", "size", "got", "error")},
                      "running": fetch["running"] and fetch["have"] < fetch["total"],
                      "failed": len(fetch["errors"]), "why": next(iter(fetch["errors"].values()), None),
                      "source": f"{repo}@{commit[:7]}" if repo else ""}}


def wallpaper_cut(path, wide=False, thumb=False, webp=False):
    """A picture as the app shows it: cut to a phone's screen (its middle),
    or the whole of it at most a laptop's screen in size (wide), or a little
    one for the picker (thumb, its middle at WALL_THUMB), as a JPEG (or a
    WebP, smaller, if webp and it can: at LOOK_QUALITY). With ImageMagick,
    else ffmpeg; without either, the picture as it is if it isn't too big.
    None if it can't be read."""
    box = WALL_THUMB if thumb else LOOK_PHONE
    quality = "78" if thumb else LOOK_QUALITY
    cut = ["-resize", LOOK_WIDE + ">"] if wide else ["-resize", box + "^", "-gravity", "center", "-extent", box]
    pw, ph = box.split("x")
    dw, dh = LOOK_WIDE.split("x")
    scale = (f"scale='min({dw},iw)':'min({dh},ih)':force_original_aspect_ratio=decrease" if wide else
             f"scale={pw}:{ph}:force_original_aspect_ratio=increase,crop={pw}:{ph}")
    with tempfile.TemporaryDirectory() as tmp:
        for kind in ("webp", "jpg") if webp else ("jpg",):
            out = Path(tmp) / f"wallpaper.{kind}"
            if shutil.which("magick"):
                r = sh("magick", f"{path}[0]", *cut, "-quality", quality if kind == "webp" else "82", "-strip", str(out))
            elif shutil.which("ffmpeg"):
                r = sh("ffmpeg", "-loglevel", "error", "-y", "-i", str(path), "-frames:v", "1", "-vf", scale,
                       *(("-c:v", "libwebp", "-quality", quality) if kind == "webp" else ("-q:v", "3")), str(out))
            else:
                try:
                    raw = Path(path).read_bytes() if os.path.getsize(path) <= APP_WALLPAPER_MAX else b""
                except OSError:
                    raw = b""
                return raw if image_kind(raw) else None
            try:
                raw = out.read_bytes() if r.returncode == 0 else b""
            except OSError:
                raw = b""
            if image_kind(raw):
                return raw
        return None


def wallpaper_small(path, which):
    """A wallpaper cut for the app (which: "phone", "wide" or "thumb", see
    wallpaper_cut), a WebP if it can: or the picture itself, when the cut
    isn't smaller. None if it can't be read."""
    raw = wallpaper_cut(path, wide=which == "wide", thumb=which == "thumb", webp=True)
    try:
        if raw and os.path.getsize(path) <= len(raw):
            whole = Path(path).read_bytes()
            return whole if image_kind(whole) else raw
    except OSError:
        pass
    return raw


# The look's own files cut smaller for the app, in CUTS: your own wallpaper
# and your themes' (a phone's cut, a computer's and the picker's thumbnail,
# as Omarchy's get theirs in WALLS), and each font in two (font_parts): its
# text, a twentieth of it, and its Nerd Font icons, which the browser
# fetches only once it draws one. Each is named after its file's hash, so a
# new file is cut again. They're cut in the background (amarchy theme
# --cut: install.sh and the app start it), and until one is, the app is
# sent the file itself. The fonts are cut with fontTools: this Python's, or
# one uv makes (font_python); without either they're sent whole.

CUTS = STATE / "cuts"
CUTS_LOCK = CUTS / "cut.lock"               # held by the cutting under way; gone, it stops
CUTS_FAILED = CUTS / "failed.json"          # {cut: why} of those that couldn't be: not tried again
CUTS_UNIT = "amarchy-cuts"                  # the cutting, in the background (systemctl --user status ...)
CUTS_RETRY = 600            # seconds before the app starts again what didn't cut it all
FONT_CUTS = "1"             # how the fonts are cut: another number, and they're cut again
# The private use areas: a Nerd Font's icons there, its text the rest.
FONT_ICONS = ((0xE000, 0xF8FF), (0xF0000, 0x10FFFF))
CUT_NAME = re.compile(r"[0-9a-f]{12}\.(?:(?:phone|wide|thumb)\d+\.(?:webp|jpg|png)|[0-9a-f]{12}\.(?:text|icons)\.woff2)")

_app_icons = {}


def app_icons():
    """The Nerd Font icons the app draws (app.js's NERD), as code points: a
    font's text has them too, so the list never waits on its icons."""
    f = APP_PAGES / "app.js"
    try:
        stamp = f.stat().st_mtime_ns
        if _app_icons.get("stamp") != stamp:
            points = {int(c, 16) for c in re.findall(r"\\u\{([0-9A-Fa-f]{4,6})\}", f.read_text())}
            _app_icons.update(stamp=stamp, found=frozenset(c for c in points
                                                           if any(lo <= c <= hi for lo, hi in FONT_ICONS)))
    except OSError:
        return frozenset()
    return _app_icons["found"]


def font_ranges():
    """(text, icons): the unicode-range of a font's two parts, as CSS. They
    don't meet, so a character is the one part's or the other's: the icons
    are the private use areas, but for the app's own."""
    icons = []
    for lo, hi in FONT_ICONS:
        for c in sorted(c for c in app_icons() if lo <= c <= hi):
            if c > lo:
                icons.append((lo, c - 1))
            lo = c + 1
        if lo <= hi:
            icons.append((lo, hi))
    text, at = [], 0
    for lo, hi in icons:
        if lo > at:
            text.append((at, lo - 1))
        at = hi + 1
    if at <= 0x10FFFF:
        text.append((at, 0x10FFFF))
    return tuple(", ".join(f"U+{lo:X}" if lo == hi else f"U+{lo:X}-{hi:X}" for lo, hi in r) for r in (text, icons))


def cut_key(path, which):
    """What a file's cut is named after: its hash, and how it's cut (which:
    "phone", "wide", "thumb", or "font"). "" for a file that isn't here."""
    sig = file_sig(path)
    if not sig:
        return ""
    if which == "font":
        return f"{sig}.{hashlib.sha1(f'{FONT_CUTS} {sorted(app_icons())}'.encode()).hexdigest()[:12]}"
    return f"{sig}.{which}{WALL_CUTS}"


def cut_file(path, which):
    """A picture's cut (which: "phone", "wide", "thumb") if it's been made, else None."""
    key = cut_key(path, which)
    return next((f for f in (CUTS / f"{key}.{kind}" for kind in ("webp", "jpg", "png")) if key and f.is_file()), None)


def cut_url(path, which):
    f = cut_file(path, which)
    return f"/cuts/{f.name}" if f else None


def font_parts(path):
    """A font cut in two, if it's been: {"text": url, "icons": url, or None
    for a font without icons}; else None."""
    key = cut_key(path, "font")
    if not key or not (CUTS / f"{key}.text.woff2").is_file():
        return None
    return {"text": f"/cuts/{key}.text.woff2",
            "icons": f"/cuts/{key}.icons.woff2" if (CUTS / f"{key}.icons.woff2").is_file() else None}


def own_files():
    """Your own wallpaper's files: {"phone": path, "wide": path}, or None."""
    own = look_choice().get("own")
    if isinstance(own, dict) and all(isinstance(own.get(k), str) and OWN_WALLPAPER.fullmatch(own[k])
                                     and (APP_PICK / own[k]).is_file() for k in ("phone", "wide")):
        return {k: APP_PICK / own[k] for k in ("phone", "wide")}
    return None


_font_python = {}


def font_python():
    """How to run a Python with fontTools (and brotli, for WOFF2), which cuts
    the fonts: this one if it has them, else one uv makes; None without
    either."""
    import importlib.util
    if "found" not in _font_python:
        uv = shutil.which("uv") or next((str(f) for f in (HOME / ".local/bin/uv", HOME / ".cargo/bin/uv")
                                         if f.is_file()), None)
        _font_python["found"] = (
            [sys.executable] if all(importlib.util.find_spec(m) for m in ("fontTools", "brotli")) else
            [uv, "run", "--quiet", "--no-project", "--with", "fonttools", "--with", "brotli", "python3"] if uv else None)
    return _font_python["found"]


def cuts_wanted():
    """The look's files to cut: [(path, which)], which "phone", "wide",
    "thumb" (a picture) or "font", those of the look worn first."""
    choice, custom = look_choice(), custom_themes()
    fonts = {k: [FONTS / k / f"{w}.woff2" for w in ("regular", "bold")] for k in LOOK_FONTS}
    fonts.update({f"custom-{k}": [CUSTOM / k / f for f in t["font"]["files"].values()]
                  for k, t in custom.items() if t["font"]})
    worn = choice.get("font") if choice.get("font") in fonts else LOOK_FONT
    out = [(k == worn, f, "font") for k, files in fonts.items() for f in files if f.is_file()]
    walls = choice.get("wallpaper") if choice.get("wallpaper") in LOOK_WALLPAPERS else "theme"
    own = own_files()
    if own:
        out += [(walls == "own", own["phone"], "phone"), (walls == "own", own["wide"], "wide"),
                (False, own["wide"], "thumb")]
    for k, t in custom.items():
        if t["wallpaper"]:
            on = walls == "theme" and choice.get("theme") == k
            phone, wide = (CUSTOM / k / t["wallpaper"][w] for w in ("phone", "wide"))
            out += [(on, phone, "phone"), (on, wide, "wide"), (False, wide, "thumb")]
    return [(f, which) for on, f, which in sorted(out, key=lambda o: not o[0])]


def cuts_failed():
    try:
        failed = json.loads(CUTS_FAILED.read_text())
    except (OSError, ValueError):
        return {}
    return failed if isinstance(failed, dict) else {}


def cuts_todo(fonts=None):
    """What of cuts_wanted() isn't cut yet and can be (fonts: whether the
    fonts can be, font_python() by default), and hasn't failed."""
    failed = cuts_failed()
    pictures = bool(shutil.which("magick") or shutil.which("ffmpeg"))
    fonts = bool(font_python()) if fonts is None else fonts
    return [(f, which) for f, which in cuts_wanted()
            if (fonts if which == "font" else pictures) and cut_key(f, which)
            and cut_key(f, which) not in failed and not (font_parts(f) if which == "font" else cut_file(f, which))]


def font_cut(path):
    """A font in two, as WOFF2: (its text, its icons or None), with fontTools."""
    import io
    import logging
    from fontTools import subset
    from fontTools.ttLib import TTFont
    logging.getLogger("fontTools").setLevel(logging.ERROR)
    cmap = set(TTFont(str(path)).getBestCmap() or {})
    icons = {c for c in cmap if any(lo <= c <= hi for lo, hi in FONT_ICONS)} - app_icons()
    out = []
    for unicodes in (cmap - icons, icons):
        if not unicodes:
            out.append(None)
            continue
        # As it is but for the characters: its ligatures, names and hinting too.
        options = subset.Options(layout_features=["*"], name_IDs=["*"], name_languages=["*"], notdef_outline=True,
                                 flavor="woff2")
        font = subset.load_font(str(path), options)
        cutter = subset.Subsetter(options)
        cutter.populate(unicodes=unicodes)
        cutter.subset(font)
        buf = io.BytesIO()
        subset.save_font(font, buf, options)
        out.append(buf.getvalue())
    if not out[0]:
        raise ValueError("it has no text")
    return out[0], out[1]


def cuts_make(quiet=False):
    """Cut the look's files that aren't yet (amarchy theme --cut), then let
    go of those no longer wanted. The fonts, by a Python with fontTools
    (font_python) if this one hasn't it. None, or what went wrong."""
    import importlib.util
    CUTS.mkdir(parents=True, exist_ok=True)
    lock = open(CUTS_LOCK, "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return "the look's files are being cut already"
    fonts = all(importlib.util.find_spec(m) for m in ("fontTools", "brotli"))
    made = 0
    try:
        for f, which in cuts_todo(fonts=fonts):
            if not CUTS_LOCK.exists():      # gone (--uninstall, a test's home): stop
                break
            key, failed = cut_key(f, which), cuts_failed()
            try:
                if which == "font":
                    text, icons = font_cut(f)
                    if icons:
                        write_file(CUTS / f"{key}.icons.woff2", icons)
                    write_file(CUTS / f"{key}.text.woff2", text)      # the last: it says the cut's made
                else:
                    raw = wallpaper_small(f, which)
                    if not raw:
                        raise ValueError("it doesn't read as a picture")
                    write_file(CUTS / f"{key}.{image_kind(raw)}", raw)
                made += 1
            except Exception as e:      # a file fontTools or ffmpeg can't read, however it says so
                failed[key] = str(e) or type(e).__name__
                write_file(CUTS_FAILED, json.dumps(failed) + "\n")
        # What's no longer wanted (another picture of yours, a theme gone, an older cut) goes.
        keep = {cut_key(f, which) + "." for f, which in cuts_wanted()} - {"."}
        for c in CUTS.iterdir() if CUTS_LOCK.exists() else ():
            if CUT_NAME.fullmatch(c.name) and not c.name.startswith(tuple(keep)):
                c.unlink(missing_ok=True)
        failed = cuts_failed()
        if any(k + "." not in keep for k in failed):
            write_file(CUTS_FAILED, json.dumps({k: v for k, v in failed.items() if k + "." in keep}) + "\n")
    finally:
        lock.close()
    if not quiet and made:
        print(f"Cut {made} of the look's files for the app.", file=sys.stderr)
    # The fonts by a Python that has fontTools, once the pictures are cut.
    python = font_python()
    if not fonts and python and python[0] != sys.executable and not os.environ.get("AMARCHY_CUT_FONTS") \
            and CUTS_LOCK.exists() and cuts_todo(fonts=True):
        try:
            r = subprocess.run([*python, SELF, "theme", "--cut", *(["--quiet"] if quiet else [])], timeout=1800,
                               env={**clean_env(), "AMARCHY_CUT_FONTS": "1"}, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as e:
            return f"couldn't cut the fonts ({e})"
        if r.returncode:
            return "couldn't cut the fonts (uv couldn't give a Python with fontTools)"
    return None


_cuts_kicked = {"at": 0.0, "todo": set()}


def cuts_running():
    try:
        with open(CUTS_LOCK, "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return CUTS_LOCK.exists()
    return False


def cuts_kick(force=False):
    """Start cutting the look's files in the background, if some aren't and
    it isn't under way: by itself (not force) again only once CUTS_RETRY has
    gone by, or there's a new file to cut. True if it started."""
    todo = {cut_key(f, which) for f, which in cuts_todo()}
    if not todo or cuts_running() or (not force and todo <= _cuts_kicked["todo"]
                                      and time.time() - _cuts_kicked["at"] < CUTS_RETRY):
        return False
    _cuts_kicked.update(at=time.time(), todo=todo)
    if not apart(CUTS_UNIT, [sys.executable, SELF, "theme", "--cut", "--quiet"]):
        _cuts_kicked["at"] = 0.0
        return False
    return True


def own_home():
    """Whether amarchy runs in the account's own home, not one made up for a
    test (HOME elsewhere: the tests' app servers and CLIs)."""
    import pwd
    try:
        return os.path.realpath(os.path.expanduser("~")) == os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir)
    except (KeyError, OSError):
        return True


def apart(unit, argv):
    """Run a command in the background, in a unit of its own where there's
    systemd (so restarting the app, which started it, doesn't stop it).
    Whether it started. Never from a test's home: it would run on the
    account's systemd, outliving the test (a whole fetch of Omarchy's
    wallpapers, cut with ImageMagick, for each test's app server)."""
    if not own_home():
        return False
    if shutil.which("systemd-run"):
        env = [f"--setenv={k}={os.environ[k]}" for k in ("XDG_STATE_HOME", "PATH") if os.environ.get(k)]
        if sh("systemd-run", "--user", "--collect", "--quiet", f"--unit={unit}-{int(time.time())}",
              *env, *argv).returncode == 0:
            return True
    try:
        detach(argv)
    except OSError:
        return False
    return True


# Omarchy's own wallpapers for each theme, as themes/backgrounds.json lists
# them (themes/<name>/backgrounds/ in basecamp/omarchy, at one commit). They
# come without a word on who made them or under what license, so amarchy
# doesn't carry them: each host fetches them from Omarchy's repository itself
# (amarchy theme --refresh-wallpapers; install.sh starts it, and so does the
# app when one is missing), checks each against its git hash and keeps it in
# WALLS, with a phone's cut of it, a computer's (the whole of it, at most a
# laptop's screen) and a thumbnail for the picker. Until one is here, or if
# it can't be fetched, its theme wears the wallpaper drawn for it
# (themes/<name>/wallpaper*.svg).

BACKGROUNDS = THEMES / "backgrounds.json"
WALLS = STATE / "wallpapers"                # <theme>/<file> and its cuts, status.json (the last fetch)
WALLS_STATUS = WALLS / "status.json"
WALLS_LOCK = WALLS / "fetch.lock"           # held by the fetch under way; gone (--uninstall), it stops
WALLS_UNIT = "amarchy-wallpapers"           # the fetch, run in the background (systemctl --user status ...)
WALL_THUMB = "480x300"      # the picker's thumbnails, in pixels (16:10)
WALL_CUTS = "2"             # how they're cut: another number, and they're cut again
WALLS_RETRY = 600           # seconds after a fetch that failed before the app tries again by itself
WALL_FILE = re.compile(r"[\w-]+\.(?:jpe?g|png|webp)")

_backgrounds = {}


def wall_name(file):
    """A wallpaper's name as people read it: 2-dusk-guardian.webp is "Dusk
    guardian"."""
    words = re.sub(r"^\d+-", "", Path(file).stem).replace("-", " ").strip() or Path(file).stem
    return words[:1].upper() + words[1:]


def omarchy_backgrounds():
    """Omarchy's wallpapers by theme (backgrounds.json): [{"key" (its name
    without the extension), "file", "name", "sha" (git's), "size"}], in
    Omarchy's order (its first is the theme's own). Read again when it
    changes; {} without it. walls_source() says where they come from."""
    try:
        stamp = BACKGROUNDS.stat().st_mtime_ns
    except OSError:
        stamp = None
    if "found" in _backgrounds and _backgrounds.get("stamp") == stamp:
        return _backgrounds["found"]
    found, source = {}, ("", "")
    try:
        raw = json.loads(BACKGROUNDS.read_text())
        source = (str(raw["repo"]), str(raw["commit"]))
        if re.fullmatch(r"[\w.-]+/[\w.-]+", source[0]) and re.fullmatch(r"[0-9a-f]{40}", source[1]):
            for theme, files in raw["themes"].items():
                walls = [{"key": Path(f["file"]).stem, "file": f["file"], "name": wall_name(f["file"]),
                          "sha": f["sha"], "size": int(f["size"])}
                         for f in files if isinstance(f, dict) and WALL_FILE.fullmatch(str(f.get("file")))
                         and re.fullmatch(r"[0-9a-f]{40}", str(f.get("sha")))]
                if re.fullmatch(r"[\w-]+", theme) and walls:
                    found[theme] = walls
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        found = {}
    _backgrounds.update(stamp=stamp, found=found, source=source if found else ("", ""))
    return found


def walls_source():
    """(repo, commit) Omarchy's wallpapers come from."""
    omarchy_backgrounds()
    return _backgrounds["source"]


def wall_cut(theme, bg, which, older=True):
    """A wallpaper's cut ("phone", "wide" or "thumb") if it's been made; else
    (older) one cut before WALL_CUTS last changed, worn till it's cut again;
    else None."""
    for kind in ("webp", "jpg", "png"):
        f = WALLS / theme / f"{bg['key']}.{which}{WALL_CUTS}.{kind}"
        if f.is_file():
            return f
    if not older:
        return None
    cut = re.compile(re.escape(bg["key"]) + rf"\.{which}\d+\.(?:webp|jpg|png)")
    try:
        return max((f for f in (WALLS / theme).iterdir() if cut.fullmatch(f.name)), default=None)
    except OSError:
        return None


def wall_here(theme, bg):
    """Whether one of Omarchy's wallpapers is here, whole."""
    try:
        return (WALLS / theme / bg["file"]).stat().st_size == bg["size"]
    except OSError:
        return False


def wall_url(theme, bg, f):
    # Asked for with its hash: the same address is always the same picture.
    return f"/wallpapers/{theme}/{f.name}?v={bg['sha'][:12]}"


def wall_pick(theme, choice=None):
    """The wallpaper of Omarchy's picked for a theme (Omarchy's first until
    one is), or None for a theme without them."""
    bgs = omarchy_backgrounds().get(theme) or []
    picked = (choice if choice is not None else look_choice()).get("backgrounds")
    want = picked.get(theme) if isinstance(picked, dict) else None
    return next((b for b in bgs if b["key"] == want), bgs[0] if bgs else None)


def wall_look(theme, bg):
    """{"phone": url, "wide": url} of one of Omarchy's wallpapers, if it's
    here: its cuts (the original until they're made)."""
    if not bg or not wall_here(theme, bg):
        return None
    original = WALLS / theme / bg["file"]
    return {w: wall_url(theme, bg, wall_cut(theme, bg, w) or original) for w in ("phone", "wide")}


def wall_served(theme, name):
    """The file of WALLS that /wallpapers/<theme>/<name> is, if it's one of
    Omarchy's wallpapers or their cuts: else None."""
    for bg in omarchy_backgrounds().get(theme) or ():
        if name == bg["file"] or re.fullmatch(re.escape(bg["key"]) + r"\.(phone|wide|thumb)\d+\.(webp|jpg|png)", name):
            f = WALLS / theme / name
            return f if f.is_file() else None
    return None


def walls_status():
    """How far Omarchy's wallpapers are here: {"total", "have" (how many),
    "size", "got" (bytes), "running" (a fetch under way), "current" (what
    it's fetching: "<theme>/<file>"), "errors" ({"<theme>/<file>": why}, of
    the last fetch, for those still not here), "error" (why it stopped, if
    it did), "at" (when it last did anything)}."""
    bgs = omarchy_backgrounds()
    total = have = size = got = 0
    for theme, walls in bgs.items():
        for bg in walls:
            total, size = total + 1, size + bg["size"]
            if wall_here(theme, bg):
                have, got = have + 1, got + bg["size"]
    try:
        st = json.loads(WALLS_STATUS.read_text())
        st = st if isinstance(st, dict) else {}
    except (OSError, ValueError):
        st = {}
    running = bool(st.get("running")) and pid_alive(st.get("pid"))
    # Started from here a moment ago, and not under way yet: it will be.
    starting = time.time() - _walls_kicked["at"] < 30 and (st.get("at") or 0) < _walls_kicked["at"]
    if starting:
        st = {"running": True}
    running = running or starting
    errors = st.get("errors") if isinstance(st.get("errors"), dict) else {}
    errors = {k: str(v) for k, v in errors.items()
              if isinstance(k, str) and k.partition("/")[0] in bgs and not (WALLS / k).is_file()}
    partial = st.get("partial") if running and isinstance(st.get("partial"), int) else 0
    return {"total": total, "have": have, "size": size, "got": got + partial, "running": running,
            "current": st.get("current") if running else None, "errors": errors,
            "error": str(st.get("error") or "") or None, "at": st.get("at") or 0,
            "stopped": bool(st.get("running")) and not running}


_walls_kicked = {"at": 0.0}


def walls_fetch(quiet=False):
    """Fetch Omarchy's wallpapers that aren't here yet (amarchy theme
    --refresh-wallpapers): each checked against its git hash, then cut for a
    phone and the picker. Those no longer listed go. The theme worn (and
    each theme's own) come first, so the app has them soonest. How far it
    got goes to WALLS_STATUS for the app. None, or what went wrong."""
    import urllib.error
    import urllib.parse
    import urllib.request
    bgs = omarchy_backgrounds()
    repo, commit = walls_source()
    if not bgs:
        return f"no list of Omarchy's wallpapers ({BACKGROUNDS} doesn't read)"
    WALLS.mkdir(parents=True, exist_ok=True)
    lock = open(WALLS_LOCK, "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return "a fetch is already under way (amarchy theme --list shows how far)"
    cutter = bool(shutil.which("magick") or shutil.which("ffmpeg"))
    tty = not quiet and sys.stderr.isatty()
    st = {"pid": os.getpid(), "running": True, "commit": commit, "errors": {}, "at": time.time()}

    def note(**kw):
        st.update(kw, at=time.time())
        if WALLS_LOCK.exists():
            write_file(WALLS_STATUS, json.dumps(st) + "\n")

    def show(final=False):
        if tty:
            s = walls_status()
            print(f"\r  {s['have']} of {s['total']} of Omarchy's wallpapers ({s['got'] // 1_000_000} of "
                  f"{s['size'] // 1_000_000} MB)", end="\n" if final else "", file=sys.stderr, flush=True)

    def cut(theme, bg):
        for which in ("phone", "wide", "thumb"):
            if cutter and not wall_cut(theme, bg, which, older=False):
                raw = wallpaper_small(WALLS / theme / bg["file"], which)
                if raw:
                    name = f"{bg['key']}.{which}{WALL_CUTS}.{image_kind(raw)}"
                    write_file(WALLS / theme / name, raw)
                    # The one cut before goes, now that this one's here.
                    older = re.compile(re.escape(bg["key"]) + rf"\.{which}\d+\.(?:webp|jpg|png)")
                    for f in (WALLS / theme).iterdir():
                        if older.fullmatch(f.name) and f.name != name:
                            f.unlink(missing_ok=True)

    try:
        note()
        # What's no longer listed (a newer Omarchy, a theme gone) goes; an
        # older cut once it's cut again (worn till then).
        for d in WALLS.iterdir():
            if not d.is_dir():
                continue
            if d.name not in bgs:
                shutil.rmtree(d, ignore_errors=True)
                continue
            # One that isn't whole (not the size listed) is fetched again, and cut again.
            whole = [b for b in bgs[d.name] if wall_here(d.name, b)]
            keep = {b["file"] for b in whole}
            cuts = [re.compile(re.escape(b["key"]) + r"\.(?:phone|wide|thumb)\d+\.(?:webp|jpg|png)") for b in whole]
            for f in d.iterdir():
                if f.name not in keep and not any(c.fullmatch(f.name) for c in cuts):
                    f.unlink(missing_ok=True)
        # Those here already but not cut yet (no ffmpeg then, say, or cut
        # another way before): the one worn first.
        choice = look_choice()
        worn = choice.get("theme") if choice.get("theme") in bgs else LOOK_DEFAULT
        here = [(t, b) for t, walls in bgs.items() for b in walls if wall_here(t, b)]
        for theme, bg in sorted(here, key=lambda tb: (tb[0] != worn,
                                                      tb[1]["key"] != (wall_pick(tb[0], choice) or {}).get("key"))):
            cut(theme, bg)
        unreachable = 0
        while WALLS_LOCK.exists():
            choice = look_choice()
            worn = choice.get("theme") if choice.get("theme") in bgs else LOOK_DEFAULT
            todo = [(t, b) for t, walls in bgs.items() for b in walls
                    if not wall_here(t, b) and f"{t}/{b['file']}" not in st["errors"]]
            if not todo:
                break
            firsts = {(t, (wall_pick(t, choice) or {}).get("key")) for t in bgs}
            theme, bg = min(todo, key=lambda tb: (tb[0] != worn or tb[1]["key"] != (wall_pick(worn, choice) or {}).get("key"),
                                                  (tb[0], tb[1]["key"]) not in firsts, tb[0] != worn))
            name = f"{theme}/{bg['file']}"
            note(current=name, partial=0)
            show()
            url = (f"https://raw.githubusercontent.com/{repo}/{commit}/themes/{urllib.parse.quote(theme)}/backgrounds/"
                   f"{urllib.parse.quote(bg['file'])}")
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "amarchy"})
                data = bytearray()
                with urllib.request.urlopen(req, timeout=60) as r:
                    last = time.time()
                    while chunk := r.read(1 << 18):
                        data += chunk
                        if len(data) > bg["size"]:
                            break
                        if time.time() - last > 0.5:
                            last = time.time()
                            note(partial=len(data))
                            show()
                git = hashlib.sha1(b"blob %d\0" % len(data) + bytes(data)).hexdigest()
                if len(data) != bg["size"] or git != bg["sha"]:
                    raise ValueError(f"what came isn't the picture listed ({len(data)} bytes, git hash {git[:7]})")
                if not image_kind(bytes(data)):
                    raise ValueError("what came isn't a JPEG, PNG or WebP")
            except urllib.error.HTTPError as e:
                st["errors"][name] = f"GitHub said {e.code} {e.reason}"
            except (urllib.error.URLError, OSError) as e:
                why = str(getattr(e, "reason", None) or e)
                st["errors"][name] = f"couldn't reach GitHub: {why}"
                unreachable += 1
                if unreachable >= 3:        # offline: the rest would fail the same way
                    note(error=f"couldn't reach GitHub ({why})")
                    break
            except ValueError as e:
                st["errors"][name] = str(e)
            else:
                unreachable = 0
                try:
                    write_file(WALLS / theme / bg["file"], bytes(data))
                except OSError as e:        # the disk, not GitHub: the rest won't fit either
                    note(error=f"couldn't keep it here ({e.strerror or e})")
                    break
                note(partial=0)
                cut(theme, bg)
    finally:
        note(running=False, current=None, partial=0)
        show(final=True)
        lock.close()
    s = walls_status()
    if s["error"]:
        return f"{s['error']}: {s['have']} of {s['total']} of Omarchy's wallpapers here"
    if s["errors"]:
        name, why = next(iter(s["errors"].items()))
        more = len(s["errors"]) - 1
        return f"{name} wasn't fetched ({why}){f', nor {more} more' if more else ''}"
    return None


def walls_kick(force=False):
    """Start fetching Omarchy's wallpapers in the background, if some aren't
    here (or aren't cut as WALL_CUTS says yet, once a while after the last
    fetch) and none is under way: by itself (not force) only when the last
    fetch didn't fail a moment ago (WALLS_RETRY). True if it started one."""
    if not omarchy_backgrounds():
        return False
    s = walls_status()
    failed = (s["errors"] or s["error"]) and not s["stopped"]
    done = s["have"] == s["total"] and (time.time() - s["at"] < WALLS_RETRY or not walls_uncut())
    if s["running"] or (not force and (done or time.time() - _walls_kicked["at"] < 30
                                       or failed and time.time() - s["at"] < WALLS_RETRY)):
        return False
    _walls_kicked["at"] = time.time()
    if not apart(WALLS_UNIT, [sys.executable, SELF, "theme", "--refresh-wallpapers", "--quiet"]):
        _walls_kicked["at"] = 0.0
        return False
    return True


def walls_uncut():
    """Whether one of Omarchy's wallpapers here isn't cut as WALL_CUTS says
    yet, and could be."""
    if not (shutil.which("magick") or shutil.which("ffmpeg")):
        return False
    return any(wall_here(t, b) and not wall_cut(t, b, w, older=False)
               for t, walls in omarchy_backgrounds().items() for b in walls for w in ("phone", "wide", "thumb"))


def look_find(name, table):
    """A theme or font by its key or its name, however it's written."""
    want = re.sub(r"[^a-z0-9]", "", name.lower())
    for key, label in table.items():
        if want in (re.sub(r"[^a-z0-9]", "", key), re.sub(r"[^a-z0-9]", "", label.lower())):
            return key
    return None


def wall_find(theme, v):
    """One of Omarchy's wallpapers of a theme, by its key ("2-waves") or
    its name ("waves"), or None."""
    bgs = omarchy_backgrounds().get(theme) or []
    key = look_find(v, {b["key"]: b["name"] for b in bgs})
    return next((b for b in bgs if b["key"] == key), None)


def walls_said(fetch):
    """How far Omarchy's wallpapers are here, in a line."""
    if not fetch["total"]:
        return "Omarchy's wallpapers: no list of them here (themes/backgrounds.json)"
    head = f"Omarchy's wallpapers: {fetch['have']} of {fetch['total']} here"
    mb = f"{fetch['got'] // 1_000_000} of {fetch['size'] // 1_000_000} MB"
    if fetch["running"]:
        return f"{head} ({mb}), fetching the rest"
    if fetch["have"] == fetch["total"]:
        return head
    why = fetch["error"] or next(iter(fetch["errors"].values()), None) or "not fetched yet"
    return f"{head} ({mb}): {why}. amarchy theme --refresh-wallpapers fetches them"


def cmd_theme(args):
    """`amarchy theme`: the app's theme, font and wallpaper."""
    if "--omarchy" in args:     # "Omarchy (live)" made again (see "the theme live")
        return cmd_theme_omarchy(args)
    if "--force" in args:
        return fail("theme --force goes with --omarchy")
    theme = font = wallpaper = wall_arg = None
    own, listing, as_json, refresh, later, quiet, cut = None, False, False, False, False, False, False
    it = iter(args)
    for a in it:
        if a in ("--font", "--wallpaper"):
            v = next(it, None)
            if v is None:
                return fail(f"theme {a}: which?")
            if a == "--font":
                fonts = {k: f["name"] for k, f in look_fonts().items()}
                font = look_find(v, fonts)
                if not font:
                    return fail(f"no font called {v!r} ({', '.join(fonts.values())})")
            elif v in LOOK_WALLPAPERS:
                wallpaper = v
            else:
                wall_arg = v        # one of the theme's (once it's known which theme), or a picture
        elif a == "--list":
            listing = True
        elif a == "--json":
            as_json = True
        elif a == "--refresh-wallpapers":
            refresh = True
        elif a == "--cut":
            cut = True
        elif a == "--in-background":
            later = True
        elif a == "--quiet":
            quiet = True
        elif a == "--show":
            pass
        elif a.startswith("-"):
            return fail(f"theme: unknown option {a}")
        else:
            theme = look_find(a, {**{k: t["name"] for k, t in custom_themes().items()},
                                  **{k: t["name"] for k, t in look_themes().items()}})
            if not theme:
                return fail(f"no theme called {a!r} (see amarchy theme --list)")
    if refresh:
        if later:
            started = walls_kick(force=True)
            if not quiet:
                print(walls_said(walls_status()) if not started else
                      "Fetching Omarchy's wallpapers in the background (amarchy theme --list shows how far).")
            return 0
        why = walls_fetch(quiet=quiet)
        if why:
            return fail(why)
        if not quiet:
            print(walls_said(walls_status()))
        return 0
    if cut:
        if later:
            started = cuts_kick(force=True)
            if not quiet:
                print("Cutting the look's files for the app in the background." if started else
                      "The look's files are cut for the app (or being cut).")
            return 0
        why = cuts_make(quiet=quiet)
        return fail(why) if why else 0
    background = None
    if wall_arg is not None:
        target = theme if theme is not None else look_worn()["theme"]
        bg = wall_find(target, wall_arg)
        if bg:
            background = bg["key"]
        elif Path(wall_arg).expanduser().is_file():
            own = (wallpaper_cut(Path(wall_arg).expanduser()), wallpaper_cut(Path(wall_arg).expanduser(), wide=True))
            if not all(own):
                return fail(f"couldn't read {wall_arg} as a picture")
        else:
            names = ", ".join(b["key"] for b in omarchy_backgrounds().get(target) or [])
            return fail(f"theme --wallpaper: theme, own, none, {f'one of {names}, ' if names else ''}"
                        f"or a picture ({wall_arg} is none of them)")
    if listing:
        info = look_info(kick=False)
        if as_json:
            print(json.dumps({k: info[k] for k in ("theme", "font", "wallpaper", "themes", "fonts", "fetch")}, indent=1))
            return 0
        for t in info["themes"]:
            mark = "*" if t["key"] == info["theme"] else " "
            n = len(t.get("backgrounds") or [])
            print(f"{mark} {t['key']:<18} {t['name']}{' (light)' if t['mode'] == 'light' else ''}"
                  f"{' (your own)' if t.get('custom') else ''}{f' · {n} wallpaper' + 's' * (n != 1) if n else ''}")
        print("fonts: " + ", ".join(f"{f['key']}{'*' if f['key'] == info['font'] else ''}" for f in info["fonts"]))
        worn = next((t for t in info["themes"] if t["key"] == info["theme"]), {})
        walls = [f"{b['key']}{'*' if info['wallpaper'] == 'theme' and b['key'] == worn.get('background') else ''}"
                 f"{'' if b['state'] == 'here' else ' (not here yet)'}" for b in worn.get("backgrounds") or []]
        walls = walls or [f"theme{'*' if info['wallpaper'] == 'theme' else ''}"]
        print(f"wallpapers of {worn.get('name', info['theme'])}: " + ", ".join(walls)
              + "".join(f", {k}{'*' if k == info['wallpaper'] else ''}" for k in ("own", "none")))
        print(walls_said(walls_status()))
        return 0
    if any(v is not None for v in (theme, font, wallpaper, own, background)):
        look = look_set(theme, font, wallpaper, own, background)
        if isinstance(look, str):
            return fail(look)
    look = look_worn()
    if look["wallpapers"] == "theme" and look["background"]:
        bg = next(b for b in omarchy_backgrounds()[look["theme"]] if b["key"] == look["background"])
        walls = f"Omarchy's {bg['name']}" + ("" if wall_here(look["theme"], bg) else
                                            " (a drawn one until it's fetched: amarchy theme --list)")
    else:
        walls = {"theme": "the theme's wallpaper", "own": "your own wallpaper", "none": "no wallpaper"}[look["wallpapers"]]
    print(f"{look['name']} · {look['font']['name']} · {walls}")
    return 0


# ---- amarchy's own Tailscale node (track H; docs/plan-omarchy-and-machines.md,
# "Tailscale inside the apps"). On a computer without the system's Tailscale,
# amarchy-tailnet (tailnet/, a Go program on tsnet, the user service
# amarchy-tailnet.service) is this computer's node: it serves Tailscale's own
# LocalAPI on its socket and carries Tailscale's own CLI, so every `tailscale
# ...` below runs as `amarchy-tailnet cli ...` there, unchanged (sh), and does
# what `tailscale serve` sets. Its proxy (proxy.json) is how this computer
# reaches the tailnet: the calls to its peers (peer_open, tailnet_dial). The
# system's Tailscale, whenever it answers, is the one, and the node stays off.

TAILNET = STATE / "tailnet"                     # its state, socket and proxy (0700)
TAILNET_SOCKET = TAILNET / "tailscaled.sock"
TAILNET_PROXY = TAILNET / "proxy.json"          # {"url": "http://amarchy:<secret>@127.0.0.1:<port>"}
TAILNET_UNIT = "amarchy-tailnet.service"
_tailnet_own = {"at": 0.0, "own": False}


def tailnet_bin():
    """amarchy-tailnet, where install.sh puts it (or on the PATH)."""
    p = Path.home() / ".local/bin/amarchy-tailnet"
    return str(p) if p.is_file() and os.access(p, os.X_OK) else shutil.which("amarchy-tailnet")


def system_tailscale():
    """Whether the system's Tailscale answers (its daemon, signed in or not).
    TAILSCALE=own in the host settings sets it aside, for amarchy's own node
    (trying it on a computer that has both)."""
    if (host_setting("TAILSCALE") or "").lower() == "own" or not shutil.which("tailscale"):
        return False
    try:
        r = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=10,
                           stdin=subprocess.DEVNULL)
        return bool(json.loads(r.stdout or "{}").get("BackendState"))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False


def tailnet_own():
    """Whether amarchy's own node is this computer's Tailscale: its socket is
    there and the system's doesn't answer (looked at once every 10 s)."""
    if time.time() - _tailnet_own["at"] < 10:
        return _tailnet_own["own"]
    own = TAILNET_SOCKET.exists() and bool(tailnet_bin()) and not system_tailscale()
    _tailnet_own.update(at=time.time(), own=own)
    return own


def tailscale_here():
    """Whether this computer has a Tailscale amarchy can use: the system's
    (its CLI), or its own node."""
    return bool(shutil.which("tailscale")) or tailnet_own()


def tailscale_argv(args):
    """`tailscale <args>` on this computer: the system's, or its own node's."""
    if tailnet_own():
        return [tailnet_bin(), "cli", "--state", str(TAILNET), *args]
    return ["tailscale", *args]


def tailnet_proxy():
    """The own node's proxy, (host, port, its Proxy-Authorization), or None."""
    try:
        u = urllib.parse.urlsplit(json.loads(TAILNET_PROXY.read_text())["url"])
    except (OSError, ValueError, KeyError, TypeError):
        return None
    cred = base64.b64encode(f"{urllib.parse.unquote(u.username or '')}:{urllib.parse.unquote(u.password or '')}".encode()).decode()
    return u.hostname, u.port, f"Basic {cred}"


def on_tailnet(host):
    """Whether a host (a name or an address) is the tailnet's."""
    host = (host or "").strip("[]").rstrip(".").lower()
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        return host.endswith(".ts.net")
    return ip in ipaddress.ip_network("100.64.0.0/10") or ip in ipaddress.ip_network("fd7a:115c:a1e0::/48")


def tailnet_via(host):
    """The own node's proxy, when a tailnet host must be reached through it
    (this computer uses amarchy's own node), else None."""
    return tailnet_proxy() if on_tailnet(host) and tailnet_own() else None


def tailnet_dial(host, port, timeout):
    """A socket to host:port, straight or through the own node's proxy
    (CONNECT) when it's the tailnet and this computer uses that node."""
    via = tailnet_via(host)
    if not via:
        return socket.create_connection((host, port), timeout=timeout)
    s = socket.create_connection((via[0], via[1]), timeout=timeout)
    try:
        s.sendall(f"CONNECT {host}:{port} HTTP/1.1\r\nHost: {host}:{port}\r\nProxy-Authorization: {via[2]}\r\n\r\n"
                  .encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = s.recv(4096)
            if not chunk:
                raise ConnectionError("amarchy's Tailscale node closed the tunnel")
            head += chunk
            if len(head) > 16384:
                raise ConnectionError("amarchy's Tailscale node answered nonsense")
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if " 200 " not in status + " ":
            raise ConnectionError(f"amarchy's Tailscale node couldn't reach {host}: {status}")
        return s
    except BaseException:
        s.close()
        raise


def tailnet_status_words():
    """Where amarchy's own node stands (amarchy-tailnet status --json), or None
    when it isn't this computer's Tailscale."""
    b = tailnet_bin()
    if not b:
        return None
    try:
        r = subprocess.run([b, "status", "--json", "--state", str(TAILNET)], capture_output=True, text=True,
                           timeout=10, stdin=subprocess.DEVNULL)
        return json.loads(r.stdout or "{}")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


# ---- end of amarchy's own Tailscale node (track H)


def tailscale_status():
    try:
        return json.loads(sh("tailscale", "status", "--json").stdout or "{}")
    except ValueError:
        return {}


def app_address(status=None):
    """This machine's name on the tailnet (amarchy.tail1234.ts.net), the one
    its HTTPS certificate is for, or None."""
    status = status if status is not None else tailscale_status()
    name = ((status.get("Self") or {}).get("DNSName") or "").rstrip(".")
    return name or None


def app_users(status=None):
    """The Tailscale logins let in: the owner of this machine, and APP_USERS=
    (comma separated: your other logins, one person's on two tailnets, say)."""
    users = {u.strip() for u in (host_setting("APP_USERS") or "").split(",") if u.strip()}
    owner = app_owner(status if status is not None else tailscale_status())
    return users | ({owner} if owner else set())


def app_owner(status=None):
    """This machine's owner on Tailscale (its login), or None."""
    if status is None:
        return None
    me = status.get("Self") or {}
    login = ((status.get("User") or {}).get(str(me.get("UserID"))) or {}).get("LoginName", "")
    return login if login and "@" in login else None


def app_port():
    try:
        return int(host_setting("APP_PORT") or APP_PORT)
    except ValueError:
        return APP_PORT


def app_https():
    try:
        return int(host_setting("APP_HTTPS") or APP_HTTPS)
    except ValueError:
        return APP_HTTPS


def app_url(address):
    https = app_https()
    return f"https://{address}" + ("" if https == 443 else f":{https}") + "/"


# ---- what the app shows of a session

def project_name(repo):
    """A project as a person reads it: "houston-os" is "Houston Os" (app/app.js projectName)."""
    return " ".join(w[:1].upper() + w[1:] for w in re.split(r"[-_]+", repo or "") if w)


def short_path(path, s):
    """A file path as the worktree sees it."""
    root = s["path"].rstrip("/") + "/"
    return path[len(root):] if isinstance(path, str) and path.startswith(root) else path


def tool_summary(name, args, s):
    """A tool call in a line: the command it runs, the file it reads, what it searches."""
    if not isinstance(args, dict):
        return ""
    if name == "TodoWrite" and isinstance(args.get("todos"), list):
        return f"{len(args['todos'])} to-dos"
    if name == "AskUserQuestion" and isinstance(args.get("questions"), list) and args["questions"]:
        q = args["questions"][0]
        return q.get("question", "") if isinstance(q, dict) else ""
    for key in ("command", "file_path", "notebook_path", "pattern", "url", "query", "description", "prompt",
                "skill", "message", "path"):
        value = args.get(key)
        if isinstance(value, str) and value.strip():
            return short_path(value, s) if key in ("file_path", "notebook_path", "path") else value
    for value in args.values():
        if isinstance(value, str) and value.strip():
            return value
    return ""


APP_INPUT_KEYS = {        # what of a tool's input the chat shows (app/chat.js), by tool
    "Read": ("file_path", "offset", "limit"), "Edit": ("file_path", "old_string", "new_string", "replace_all"),
    "MultiEdit": ("file_path", "edits"), "Write": ("file_path", "content"), "NotebookEdit": ("notebook_path",),
    "Bash": ("command", "description", "run_in_background"), "Grep": ("pattern", "path", "glob", "type"),
    "Glob": ("pattern", "path"), "WebSearch": ("query",), "WebFetch": ("url",),
    "Agent": ("description", "subagent_type"), "Task": ("description", "subagent_type"), "Skill": ("skill",),
    "SendMessage": ("to", "summary"), "TodoWrite": ("todos",), "ExitPlanMode": ("plan",),
    "TaskCreate": ("subject", "activeForm"), "TaskUpdate": ("taskId", "status", "subject", "activeForm"),
    "AskUserQuestion": ("questions",), "Monitor": ("description",), "ScheduleWakeup": ("reason",),
}
APP_INPUT_TEXT = 20000      # characters of any one string of it (an edit's old and new text, a plan)


def tool_input_view(name, args, s):
    """What the chat needs of a tool call's input to draw it in words (an
    edit's diff, the checklist, a plan): a few keys, long text cut short,
    paths as the worktree sees them."""
    if not isinstance(args, dict):
        return {}
    keys = APP_INPUT_KEYS.get(name)
    if keys is None:
        keys = ("description", "file_path", "path", "url", "query", "command", "pattern")

    def cut(v, depth=0):
        if isinstance(v, str):
            return v if len(v) <= APP_INPUT_TEXT else v[:APP_INPUT_TEXT] + "\n…"
        if isinstance(v, list):
            return [cut(x, depth + 1) for x in v[:60]] if depth < 4 else []
        if isinstance(v, dict):
            return {k: cut(x, depth + 1) for k, x in list(v.items())[:30]} if depth < 4 else {}
        return v if isinstance(v, (int, float, bool)) or v is None else str(v)

    out = {k: cut(args[k]) for k in keys if k in args}
    if isinstance(out.get("content"), str) and len(out["content"]) > 6000:
        out["content"] = out["content"][:6000] + "\n…"     # its result has the diff: this is for before it
    for k in ("file_path", "notebook_path", "path"):
        if isinstance(out.get(k), str):
            out[k] = short_path(out[k], s)
    return out


APP_PATCH_LINES = 600       # lines of a result's diff the chat gets, all its files together


def result_view(r, s):
    """What a tool's result says beyond its text, from the record's
    toolUseResult: the diff it made (an edit's, a write's, a command's that
    changed files) and the answers to a question."""
    t = r.get("toolUseResult")
    if not isinstance(t, dict):
        return {}
    out, files = {}, []
    if isinstance(t.get("structuredPatch"), list) and t.get("filePath"):
        files.append({"path": t["filePath"], "hunks": t["structuredPatch"], "created": t.get("type") == "create"})
    diff = t.get("bashEditDiff")
    if isinstance(diff, dict) and isinstance(diff.get("files"), list):
        files += [{"path": f.get("filePath"), "hunks": f.get("hunks")} for f in diff["files"] if isinstance(f, dict)]
    left, shown = APP_PATCH_LINES, []
    for f in files:
        if not isinstance(f["path"], str) or not isinstance(f["hunks"], list):
            continue
        hunks, adds, dels = [], 0, 0
        for hk in f["hunks"]:
            if not isinstance(hk, dict) or not isinstance(hk.get("lines"), list):
                continue
            lines = [l for l in hk["lines"] if isinstance(l, str)]
            adds += sum(1 for l in lines if l.startswith("+"))
            dels += sum(1 for l in lines if l.startswith("-"))
            if left > 0:
                hunks.append({"old": hk.get("oldStart"), "new": hk.get("newStart"),
                              "lines": [l[:2000] for l in lines[:left]]})
                left -= len(hunks[-1]["lines"])
        if hunks:       # (a file written new has none: its input says what's in it)
            shown.append({"path": short_path(f["path"], s), "hunks": hunks, "add": adds, "del": dels,
                          "created": bool(f.get("created")), "cut": left <= 0})
    if shown:
        out["diff"] = shown
    if isinstance(t.get("answers"), dict):
        out["answers"] = {str(k)[:2000]: str(v)[:2000] for k, v in t["answers"].items()}
    if isinstance(t.get("annotations"), dict):      # your notes with them
        notes = {str(k)[:2000]: str(v.get("notes"))[:2000] for k, v in t["annotations"].items()
                 if isinstance(v, dict) and isinstance(v.get("notes"), str) and v["notes"].strip()}
        if notes:
            out["notes"] = notes
    return out


def result_text(content):
    if isinstance(content, str):
        return content
    out = []
    for b in content if isinstance(content, list) else []:
        if isinstance(b, dict):
            out.append(b.get("text", "") if b.get("type") == "text" else f"[{b.get('type', '')}]")
    return "\n".join(out)


def tag_text(text, tag):
    m = re.search(rf"<{tag}>(.*?)</{tag}>", text, re.S)
    return m.group(1).strip() if m else None


def user_item(text):
    """What you said, as the conversation shows it: Claude Code wraps slash
    commands, ! commands and their output in tags, and adds reminders for Claude."""
    text = re.sub(r"<system-reminder>.*?</system-reminder>", "", text, flags=re.S).strip()
    if not text or text.startswith("<local-command-caveat>"):
        return None
    name = tag_text(text, "command-name")
    if name is not None:
        args = tag_text(text, "command-args") or ""
        return {"kind": "command", "text": f"{name} {args}".strip()}
    for tag, kind in (("bash-input", "command"), ("local-command-stdout", "note"), ("bash-stdout", "note"),
                      ("bash-stderr", "note")):
        inner = tag_text(text, tag)
        if inner is not None:
            if kind == "command":
                return {"kind": "command", "text": f"! {inner}"}
            return {"kind": "note", "text": inner} if inner else None
    if text.startswith("[Request interrupted"):
        return {"kind": "note", "text": "Interrupted"}
    if text.startswith(HOOK_FEEDBACK):
        # amarchy's own (reply_fix): not shown; another hook's, a quiet line.
        return None if any(m in text for m in FIX_MARKS) or GOAL_MARK in text else {"kind": "note", "text": text}
    return {"kind": "user", "text": text}


def brief_text(b):
    """An old reply written with update_brief (its input), as the text it
    held, in the reply format: its title, its answer and explanation, its
    tables, what it made for you as blocks, its questions as choices, its
    caveats and sources, its goal. "" for nothing."""
    if not isinstance(b, dict):
        return ""
    def s(v):
        return v.strip() if isinstance(v, str) else ""
    def objs(v):
        return [x for x in v if isinstance(x, dict)] if isinstance(v, list) else []
    def cell(v):
        return str(v if v is not None else "").replace("|", "\\|").replace("\n", " ")
    def attrs(**kw):
        return "".join(f' {k}="{s(v).replace(chr(34), chr(39))}"' for k, v in kw.items() if s(v))
    out = []
    if s(b.get("title")) or s(b.get("headline")):
        out.append(s(b.get("title")) or s(b.get("headline")))
    if s(b.get("short")):
        out.append(s(b.get("short")))
    verdicts = [f"- **{s(v.get('option'))}** ({s(v.get('rating')) or 'neutral'})" + (f": {s(v.get('reason'))}" if s(v.get("reason")) else "")
                for v in objs(b.get("verdicts")) if s(v.get("option"))]
    if verdicts:
        out.append("\n".join(verdicts))
    points = []
    for x in (b.get("answer") if isinstance(b.get("answer"), list) else b.get("changed") if isinstance(b.get("changed"), list) else []):
        point, detail = (s(x), "") if isinstance(x, str) else (s(x.get("point")), s(x.get("detail"))) if isinstance(x, dict) else ("", "")
        if point:
            points.append(f"- {point}" + (f" {detail}" if detail else ""))
    if points:
        out.append("\n".join(points))
    if s(b.get("explanation")):
        out.append(s(b.get("explanation")))
    for t in objs(b.get("tables")):
        cols, rows = t.get("columns"), [r for r in (t.get("rows") or []) if isinstance(r, list)]
        if not isinstance(cols, list) or not cols or not rows:
            continue
        table = [f"| {' | '.join(cell(c) for c in cols)} |", f"|{'---|' * len(cols)}"] + [f"| {' | '.join(cell(c) for c in r)} |" for r in rows]
        out.append((f"**{s(t.get('title'))}**\n\n" if s(t.get("title")) else "") + "\n".join(table))
    plan = [f"- [{'x' if x.get('state') == 'done' else ' '}] {s(x.get('step'))}" for x in objs(b.get("plan")) if s(x.get("step"))]
    if plan:
        out.append(f"```todos title=\"Plan\"\n" + "\n".join(plan) + "\n```")
    for a in objs(b.get("artifacts")):
        kind = a.get("type")
        if kind == "message":
            ch = a.get("channel") if a.get("channel") in ("whatsapp", "email", "slack", "sms") else "email"
            out.append(f"```{ch}{attrs(to=a.get('to'), phone=a.get('phone'), subject=a.get('subject'))}\n{s(a.get('body'))}\n```")
        elif kind == "link" and s(a.get("url")):
            out.append(f"```link{attrs(label=a.get('title'), note=a.get('note'))}\n{s(a.get('url'))}\n```")
        elif kind == "command" and s(a.get("command")):
            out.append(f"```command{attrs(cwd=a.get('where'))}\n{s(a.get('command'))}\n```")
        elif kind == "event":
            out.append(f"```event{attrs(title=a.get('title'), when=a.get('when'), end=a.get('end'), where=a.get('where'))}\n{s(a.get('note'))}\n```")
        elif kind == "todos":
            items = [f"- [{'x' if x.get('done') else ' '}] {s(x.get('text'))}" + (f" ({s(x.get('due'))})" if s(x.get("due")) else "")
                     for x in objs(a.get("items")) if s(x.get("text"))]
            out.append(f"```todos{attrs(title=a.get('title'))}\n" + "\n".join(items) + "\n```")
        elif kind == "contact":
            out.append(f"```contact{attrs(name=a.get('name'), role=a.get('role'), phone=a.get('phone'), email=a.get('email'))}\n```")
        elif kind == "place":
            out.append(f"```place{attrs(name=a.get('name'), where=a.get('where'), hours=a.get('hours'))}\n```")
        elif kind == "session":
            out.append(f"```session{attrs(id=a.get('name'))}\n{s(a.get('body'))}\n```")
        elif kind == "code" and s(a.get("code")):
            out.append(f"```{s(a.get('language'))}\n{s(a.get('code'))}\n```")
        elif s(a.get("body")):
            out.append((f"**{s(a.get('title'))}**\n\n" if s(a.get("title")) else "") + s(a.get("body")))
    for q in objs(b.get("waiting")):
        opts = [f"- {s(o.get('label'))}" + (f" | {s(o.get('send'))}" if s(o.get("send")) else "")
                for o in objs(q.get("options")) if s(o.get("label"))]
        if s(q.get("question")) and opts:
            out.append(f"```choices{attrs(question=q.get('question'))}\n" + "\n".join(opts) + "\n```")
    notes = [f"- {s(x)}" for x in (b.get("notes") or []) if s(x)] if isinstance(b.get("notes"), list) else []
    if notes:
        out.append("\n".join(notes))
    sources = [f"- [{s(x.get('label')) or s(x.get('url'))}]({s(x.get('url'))})" for x in objs(b.get("sources")) if s(x.get("url"))]
    if sources:
        out.append("## Sources\n\n" + "\n".join(sources))
    if s(b.get("goal")):
        state = b.get("status") if b.get("status") in ("working", "waiting", "blocked", "done") else ""
        out.append(f"```goal{attrs(state=state)}\n{s(b.get('goal'))}\n```")
    return "\n\n".join(out)


def app_items(records, s, hidden=None):
    """A conversation's records as the app shows them: what you said, what
    Claude said, its tool calls (each result follows as "result", for the
    call it answers) and notes. Thinking and Claude Code's bookkeeping are left out.
    What Claude says after its brief (update_brief) until your next message is
    marked aside: it repeats what it said, and the app leaves it out; the
    brief itself is shown as the text it held (brief_text). The turns that
    aren't shown (hidden: turns_hidden's, read here if not given) are left
    out whole: the quiet ones, and the one held under way."""
    out, briefed = [], False
    # What a script, a timer or another chat sent it (amarchy send), each
    # matched once, by its words, to the message it became: "from".
    sent = [dict(e) for e in sent_by_read(s["id"])] if s and s.get("id") else []
    hidden = turns_hidden(s) if hidden is None and s and s.get("id") else hidden
    for r in records:
        if not isinstance(r, dict) or r.get("isSidechain"):
            continue
        if record_hidden(r, hidden):
            # Not shown, but what it was sent is matched still: the same words
            # sent again later are that later message's.
            if r.get("type") == "user" and human_record(r):
                item = user_item(message_text((r.get("message") or {}).get("content") or ""))
                if item and item["kind"] == "user":
                    sent_by_match(sent, item["text"], r.get("timestamp") or "")
            continue
        if r.get("type") == "user" and fix_feedback(r):
            # The reply sent back to be written again (reply_fix): its words
            # go, the one written again takes their place.
            for item in reversed(out):
                if item.get("kind") != "claude":
                    break
                item["aside"] = True
            continue
        if r.get("isMeta"):
            continue
        kind, rid, at = r.get("type"), r.get("uuid") or "", r.get("timestamp") or ""
        message = r.get("message") if isinstance(r.get("message"), dict) else {}
        content = message.get("content")
        blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
        found = []
        if kind == "user":
            results = [b for b in blocks if isinstance(b, dict) and b.get("type") == "tool_result"]
            if not results:
                briefed = False
            extra = result_view(r, s) if len(results) == 1 else {}
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text":
                    item = user_item(b.get("text") or "")
                    if item and item["kind"] == "user" and human_message(item["text"]):
                        item["turn"] = True     # yours: it starts a turn
                        origin = sent_by_match(sent, item["text"], at)
                        if origin is not None:
                            item["from"] = origin or "script"
                    found.append(item)
                elif b.get("type") == "image":       # shown at /api/session/<id>/image/<rec>/<n>
                    found.append({"kind": "user", "text": "[image]", "rec": rid, "turn": True,
                                  "image": sum(1 for x in found if x and x.get("image") is not None)})
                elif b.get("type") == "tool_result":
                    text = result_text(b.get("content"))
                    found.append({"kind": "result", "tool": b.get("tool_use_id", ""), "error": bool(b.get("is_error")),
                                  "text": text[:4000] + ("\n…" if len(text) > 4000 else ""), **extra})
        elif kind == "assistant":
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and (b.get("text") or "").strip():
                    found.append({"kind": "claude", "text": b["text"].strip(), **({"aside": True} if briefed else {})})
                elif b.get("type") == "tool_use" and b.get("name") == BRIEF_TOOL:
                    briefed = True
                    text = brief_text(b.get("input"))
                    if text:
                        found.append({"kind": "claude", "text": text})
                elif b.get("type") == "tool_use":
                    found.append({"kind": "tool", "id": b.get("id", ""), "name": b.get("name", ""),
                                  "summary": tool_summary(b.get("name"), b.get("input"), s)[:600],
                                  "input": tool_input_view(b.get("name"), b.get("input"), s)})
        elif kind == "system":
            sub = r.get("subtype")
            if sub == "away_summary" and r.get("content"):
                found.append({"kind": "note", "text": re.sub(r"\s*\(disable recaps.*?\)$", "", str(r["content"]))})
            elif sub == "compact_boundary":
                found.append({"kind": "note", "text": "Conversation compacted"})
            elif sub == "local_command" and isinstance(r.get("content"), str):
                found.append(user_item(r["content"]))
        for i, item in enumerate(x for x in found if x):
            out.append({**item, "key": f"{rid}:{i}", "at": at})
    return out


def sent_by_match(sent, text, at):
    """Who sent the message text that reached Claude at at (ISO), when amarchy
    send did (sent: sent_by_read's, each taken once): the session it ran in,
    or "" for a script or timer; None when it's yours."""
    if not sent:
        return None
    key, when = sent_hash(text), gh_time(at) or time.time()
    for e in sent:
        if not e.get("used") and e["hash"] == key and e["at"] <= when + 120 and when - e["at"] < 3 * 86400:
            e["used"] = True
            return e.get("from") or ""
    return None


def line_start(fh, pos):
    """The start of the line pos is in (0, or just after a newline)."""
    if pos <= 0:
        return 0
    fh.seek(pos - 1)
    fh.readline()
    return fh.tell()


def read_records(f, start, end):
    """The records of a transcript between two offsets (at line starts)."""
    with open(f, "rb") as fh:
        fh.seek(start)
        data = fh.read(max(end - start, 0))
    out = []
    for line in data.splitlines():
        if b'"type":"api-request' in line[:40] or not line.strip():
            continue        # copies of what went to the API: big, and nothing to show
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def human_record(r):
    """Whether a transcript record is a message of yours (what starts a turn:
    app_items marks it "turn")."""
    if not isinstance(r, dict) or r.get("type") != "user" or r.get("isMeta") or r.get("isSidechain"):
        return False
    content = (r.get("message") or {}).get("content") if isinstance(r.get("message"), dict) else None
    if isinstance(content, list):
        blocks = [b for b in content if isinstance(b, dict)]
        if any(b.get("type") == "tool_result" for b in blocks):
            return False
        if any(b.get("type") == "image" for b in blocks):
            return True
        content = message_text(content)
    if not isinstance(content, str):
        return False
    item = user_item(content)
    return bool(item) and item["kind"] == "user" and human_message(item["text"])


def turn_start(fh, pos, back=1, limit=16_000_000):
    """The start of the line of the message of yours (a turn's start) before
    pos, or back of them back: where the app's first page of a conversation
    starts, so its turns are whole (a long turn's own message isn't cut off,
    and its headline has it to go under). The file's start if there are fewer;
    pos if none is within limit bytes."""
    if pos <= 0:
        return 0
    lo = max(0, pos - limit)
    fh.seek(lo)
    data = fh.read(pos - lo)
    found, end = [], len(data)
    while end > 0 and len(found) < back:
        cut = data.rfind(b"\n", 0, end - 1) + 1     # the start of the line that ends at end
        line = data[cut:end]
        if b'"type":"user"' in line:
            try:
                if human_record(json.loads(line)):
                    found.append(lo + cut)
            except ValueError:
                pass
        end = cut
    if len(found) == back or lo == 0 and found:
        return found[-1] if len(found) == back else 0
    return 0 if lo == 0 else pos


class AppConversation:
    """Follows the conversation a session is in (it changes with /clear): the
    latest of it first, then what's added."""

    def __init__(self, s):
        self.s, self.file, self.start, self.offset = s, None, 0, 0

    def poll(self):
        """(items, reset): what's new, or with reset, all there is to show from scratch."""
        f = transcript(self.s)
        if f != self.file:
            self.file = f
            if not f:
                self.start = self.offset = 0
                return [], True
            with open(f, "rb") as fh:
                end = fh.seek(0, 2)
                # Whole turns: from the start of the one the chunk begins in, and
                # at least the turn before the last (its headline shows while the next goes).
                last = turn_start(fh, end)
                self.start = turn_start(fh, line_start(fh, end - APP_CHUNK))
                if self.start >= last > 0:
                    self.start = turn_start(fh, last)
            self.offset = self.start
            return self.read(), True
        return (self.read(), False) if f else ([], False)

    def read(self):
        try:
            with open(self.file, "rb") as fh:
                fh.seek(self.offset)
                data = fh.read()
        except OSError:
            return []
        done = data.rfind(b"\n") + 1        # a line still being written waits for the next time
        hidden = turns_hidden(self.s)
        records, pos = [], 0
        while pos < done:
            end = data.index(b"\n", pos) + 1
            line = data[pos:end]
            if line.strip() and b'"type":"api-request' not in line[:40]:      # (read_records's)
                try:
                    r = json.loads(line)
                except ValueError:
                    r = None
                # The turn held under way (turn_hold): read again next time,
                # shown once it ends (unless it ended quiet).
                if hidden[1] is not None and isinstance(r, dict) and record_at(r) >= hidden[1]:
                    done = pos
                    break
                if r is not None:
                    records.append(r)
            pos = end
        self.offset += done
        return app_items(records, self.s, hidden)


def app_closing(s):
    """What closing a session would cost, for the phone to ask first (as
    confirm_close does): its uncommitted files, whether amarchy runs from
    its worktree, and what it runs in the background that would stop
    halfway (a test run, a helper; not a dev server, which only serves)."""
    path = Path(s["path"])
    changes = len(sh("git", "status", "--porcelain", cwd=path).stdout.splitlines()) if path.is_dir() else 0
    tasks = live_tasks(agent_live(s["id"])) if engine(s) == "chat" else []
    runs, _ = background_runs(tasks, background_sessions(s))
    # Its previews stop too (and are checked gone: the close itself says if one isn't).
    running = [p["url"] for p in previews(s) if p.get("run") and preview_state(s, p) in ("up", "starting")]
    return {"changes": changes, "amarchy": installed_from(path), "running": runs, "previews": running}


# ---- the wide layout's side panel (desk.js): a session's Changes and Details

CHANGES_FILES = 300         # files shown in Changes, at most
CHANGES_LINES = 4000        # lines of one file's diff, at most (the rest: "cut")
CHANGES_TOTAL = 40000       # lines of the whole diff, at most
CHANGES_NEW = 256_000       # bytes of a new (untracked) file read to show it
DIFF_HUNK = re.compile(r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@")


def git_base(s):
    """What a session's branch is compared with: (the base it was made from,
    the commit where it left it). Without a common commit, its own HEAD."""
    path = s["path"]
    base = s.get("base") or default_base(path) or "HEAD"
    mb = sh("git", "merge-base", "HEAD", base, cwd=path).stdout.strip()
    return base, mb or sh("git", "rev-parse", "--verify", "--quiet", "HEAD", cwd=path).stdout.strip()


def parse_diff(text, total=0):
    """`git diff`'s unified output as files, the chat's diffs' shape: {path,
    old_path, status, binary, hunks: [{old, new, lines: ["+x", "-x", " x"]}],
    add, del, cut}. At most CHANGES_LINES lines a file and CHANGES_TOTAL in
    all (counting from total) are kept; the counts are whole."""
    files, f = [], None
    for line in text.split("\n"):
        if line.startswith("diff --git "):
            m = re.match(r"diff --git a/(.*) b/(.*)$", line)
            f = {"path": m.group(2) if m else line[11:], "old_path": None, "status": "modified",
                 "binary": False, "hunks": [], "add": 0, "del": 0, "cut": False}
            files.append(f)
            continue
        if f is None:
            continue
        m = DIFF_HUNK.match(line)
        if m:
            f["hunks"].append({"old": int(m.group(1)), "new": int(m.group(2)), "lines": []})
            continue
        if not f["hunks"]:       # the file's header
            if line.startswith("new file mode"):
                f["status"] = "added"
            elif line.startswith("deleted file mode"):
                f["status"] = "deleted"
            elif line.startswith("rename from "):
                f["old_path"], f["status"] = line[12:], "renamed"
            elif line.startswith("rename to "):
                f["path"] = line[10:]
            elif line.startswith("Binary files") or line == "GIT binary patch":
                f["binary"] = True
            continue
        if not line or line[0] not in "+- ":      # "\ No newline at end of file"
            continue
        if line[0] == "+":
            f["add"] += 1
        elif line[0] == "-":
            f["del"] += 1
        if sum(len(h["lines"]) for h in f["hunks"]) >= CHANGES_LINES or total >= CHANGES_TOTAL:
            f["cut"] = True
            continue
        f["hunks"][-1]["lines"].append(line)
        total += 1
    return files


CHANGES_SEEN = {}        # session id -> (changes_sig, app_changes's answer for it), the last one


def changes_sig(path, base, mb, new):
    """What app_changes's answer is made of, cheaply: where the branch left
    its base, HEAD, which files differ from it (git diff --raw: a file changed
    again since shows the same, so its size and time too), the new files'."""
    sig = hashlib.sha1(f"{base}\0{mb}\0".encode())
    sig.update(sh("git", "rev-parse", "HEAD", cwd=path).stdout.encode())
    raw = sh("git", "-c", "core.quotepath=off", "diff", "--raw", "-z", "--no-renames", mb, "--", cwd=path).stdout
    sig.update(raw.encode(errors="replace"))
    for name in [n for n in raw.split("\0") if n and not n.startswith(":")] + new:
        try:
            st_ = (path / name).stat()
            sig.update(f"{name}\0{st_.st_size}\0{st_.st_mtime_ns}\0".encode())
        except OSError:
            sig.update(f"{name}\0gone\0".encode())
    return sig.hexdigest()


def app_changes(s):
    """Everything a session changed, for the side panel's Changes: its
    worktree (committed or not, new files too) against where its branch left
    its base, file by file; and its own commits. The same answer as last
    time, while nothing it's made of changed (changes_sig), isn't made again:
    the side panel asks every few seconds while Claude works."""
    path = Path(s["path"])
    if not path.is_dir():
        return {"error": "Its worktree isn't there"}
    base, mb = git_base(s)
    if not mb:
        return {"base": base, "files": [], "commits": [], "add": 0, "del": 0, "sig": ""}
    # Files git doesn't know yet: new, shown whole (if text, and not huge).
    new = [n for n in sh("git", "-c", "core.quotepath=off", "ls-files", "--others", "--exclude-standard", "-z",
                         cwd=path).stdout.split("\0") if n]
    cheap = changes_sig(path, base, mb, new)
    seen = CHANGES_SEEN.get(s["id"])
    if seen and seen[0] == cheap:
        return seen[1]
    out = changes_made(path, base, mb, new)
    CHANGES_SEEN.pop(s["id"], None)
    CHANGES_SEEN[s["id"]] = (cheap, out)
    while len(CHANGES_SEEN) > 12:       # the chats looked at last: a big diff each is plenty
        CHANGES_SEEN.pop(next(iter(CHANGES_SEEN)))
    return out


def changes_made(path, base, mb, new):
    """app_changes's answer, made: the diff, the new files, the commits."""
    diff = sh("git", "-c", "core.quotepath=off", "diff", "--no-color", "--no-ext-diff", "-M", "-U3", mb, "--",
              cwd=path).stdout
    files = parse_diff(diff)
    total = sum(len(h["lines"]) for f in files for h in f["hunks"])
    sig = hashlib.sha1(diff.encode(errors="replace"))
    for name in new[:CHANGES_FILES]:
        p = path / name
        f = {"path": name, "old_path": None, "status": "untracked", "binary": False, "hunks": [],
             "add": 0, "del": 0, "cut": False}
        try:
            st_ = p.stat()
            sig.update(f"{name}\0{st_.st_size}\0{st_.st_mtime_ns}".encode())
            data = p.read_bytes()[:CHANGES_NEW] if p.is_file() else b""
        except OSError:
            continue
        if b"\0" in data[:8000]:
            f["binary"] = True
        else:
            text = data.decode(errors="replace")
            lines = text.split("\n")
            if lines and lines[-1] == "":
                lines.pop()
            f["add"] = len(lines)
            keep = max(0, min(len(lines), CHANGES_LINES, CHANGES_TOTAL - total))
            f["hunks"] = [{"old": 0, "new": 1, "lines": ["+" + l for l in lines[:keep]]}] if lines else []
            f["cut"] = keep < len(lines) or st_.st_size > CHANGES_NEW
            total += keep
        files.append(f)
    head = sh("git", "rev-parse", "HEAD", cwd=path).stdout.strip()
    sig.update(head.encode())
    log = sh("git", "log", "--format=%h%x00%s%x00%ct", f"{mb}..HEAD", "-n", "50", cwd=path).stdout
    commits = [dict(zip(("sha", "subject", "at"), c.split("\0"))) for c in log.splitlines() if c.count("\0") == 2]
    for c in commits:
        c["at"] = int(c["at"])
    files.sort(key=lambda f: f["path"])
    return {"base": base, "since": mb[:12], "files": files[:CHANGES_FILES], "more": max(0, len(files) - CHANGES_FILES),
            "commits": commits, "add": sum(f["add"] for f in files), "del": sum(f["del"] for f in files),
            "sig": sig.hexdigest()[:16]}


def transcript_settings(s):
    """The model and permission mode a session's Claude was last seen with,
    from its conversation (the TUI's): (model, mode), either ""."""
    f = transcript(s)
    model = mode = ""
    for r in reversed(conversation_records(f, tail=300_000) if f else []):
        if not isinstance(r, dict):
            continue
        if not model and r.get("type") == "assistant" and isinstance(r.get("message"), dict):
            m = r["message"].get("model") or ""
            model = "" if m.startswith("<") else m       # "<synthetic>": no model's words
        if not mode and isinstance(r.get("permissionMode"), str):
            mode = r["permissionMode"]
        if model and mode:
            break
    return model, mode


def app_details(s):
    """The side panel's Details: where the session works (branch, worktree,
    base), how its Claude runs (engine, model, mode, usage), and the
    background sessions in its worktree."""
    path = Path(s["path"])
    out = {"id": s["id"], "repo": s["repo"], "name": s.get("name"), "branch": s.get("branch"), "path": s["path"],
           "base": s.get("base"), "created": s.get("created"), "engine": engine(s), "conversation": conversation_id(s["id"])}
    if path.is_dir():
        base, mb = git_base(s)
        counts = sh("git", "rev-list", "--left-right", "--count", f"{base}...HEAD", cwd=path).stdout.split()
        if len(counts) == 2:
            out["behind"], out["ahead"] = int(counts[0]), int(counts[1])
        out["uncommitted"] = len(sh("git", "status", "--porcelain", cwd=path).stdout.splitlines())
        out["head"] = sh("git", "log", "-1", "--format=%h%x00%s%x00%ct", cwd=path).stdout.strip().split("\0")
    if engine(s) == "chat":
        live = agent_live(s["id"])
        out["model"], out["mode"] = live.get("model") or "", live.get("permission_mode") or ""
        out["effort"] = live.get("effort") or ""
        out["live"] = {k: live.get(k) for k in ("state", "tasks", "rate_limits", "cost_usd", "turns", "version")}
    else:
        out["model"], out["mode"] = transcript_settings(s)
    out["previews"] = [preview_info(s, p, lines=12) for p in previews(s)]
    out["background"] = [{"name": d.get("name") or d.get("jobId") or (d.get("sessionId") or "")[:8],
                          "status": d.get("status"), "started": (d.get("startedAt") or 0) / 1000,
                          "cwd": d.get("cwd")} for d in background_sessions(s)]
    return out


def app_earlier(s, before):
    """The part of the conversation before an offset: (items, its start)."""
    f = transcript(s)
    if not f or before <= 0:
        return [], 0
    with open(f, "rb") as fh:
        start = line_start(fh, before - APP_CHUNK)
    return app_items(read_records(f, start, before), s, turns_hidden(s)), start


EXITED = "Claude Code exited. Press Enter"


def app_screen(s):
    """What the session's Claude shows now: its screen as text, the question
    on it if any, and whether Claude is there at all (exited: it's waiting
    for Enter to start again; asleep: its last screen stays, Claude gone
    until something wakes it; waking: on its way back)."""
    asleep, waking = asleep_since(s["id"]) is not None, waking_now(s["id"])
    r = tmux("capture-pane", "-p", "-t", f"={tmux_name(s['id'])}:")
    if r.returncode != 0:
        return {"live": False, "text": "", "dialog": None, "exited": False, "asleep": asleep, "waking": False}
    lines = [l.rstrip() for l in r.stdout.splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    exited = not asleep and any(EXITED in l for l in lines[-4:])
    # What Claude asks comes as data (chat_dialog). A classic terminal's
    # question is only on its screen: the terminal shows it, nothing reads it.
    dialog = None if exited or asleep or waking or engine(s) != "chat" else chat_dialog(s)
    return {"live": True, "text": "\n".join(lines), "exited": exited, "asleep": asleep, "waking": waking,
            "dialog": dialog}


def chat_screen(s):
    """app_screen for a session on the chat engine whose broker is running,
    without reading its pane: Claude is there (live), it hasn't exited, and
    what it asks is live.json's. None when its broker isn't running."""
    live = agent_live(s["id"])
    if not agent_up(s["id"], live):
        return None
    asleep, waking = asleep_since(s["id"]) is not None, waking_now(s["id"])
    return {"live": True, "text": "", "exited": False, "asleep": asleep, "waking": waking,
            "dialog": None if asleep or waking else chat_dialog(s, live)}


# ---- what a session on the chat engine asks, as today's cards
#
# The broker has Claude's requests as data (live.json's pending): a
# permission, AskUserQuestion's questions, a plan to approve. The phone's
# card (app.js's ask) shows a dialog read off the TUI's screen, each option
# picked by its keys; chat_dialog gives it one in that shape, its options
# numbered (their keys, ["1"]...), each saying what it does (answer). The
# app's routes then do that instead of sending the keys (chat_pick). A
# multiple-choice question is answered one option at a time: each pick
# toggles it (CHAT_PICKS), "Done" sends them. The new chat (chat.js) reads
# live.json's pending itself and answers through /answer.

CHAT_PICKS = {}         # (session id, request id, question) -> the options picked so far, for multiSelect


def chat_tool_ask(p):
    """What a permission request asks, in words: its first line, the rest."""
    tool, given = p.get("tool") or "a tool", p.get("input") or {}
    path = given.get("file_path") or given.get("notebook_path") or given.get("path")
    head = {"Bash": "Claude wants to run a command", "WebFetch": "Claude wants to read a web page",
            "WebSearch": "Claude wants to search the web"}.get(tool)
    if not head and tool in ("Edit", "MultiEdit", "Write", "NotebookEdit"):
        head = f"Claude wants to {'create' if tool == 'Write' else 'edit'} {Path(str(path)).name if path else 'a file'}"
    head = head or f"Claude wants to use {tool}"
    rest = [p.get("description") if p.get("description") not in (None, tool) else None,
            given.get("command") or given.get("url") or given.get("query") or (str(path) if path else None),
            p.get("reason")]
    return head, [str(x) for x in rest if x]


def ask_words(p, root=None):
    """What one of Claude's requests (live["pending"]) asks, as a
    notification says it: "Asks: Which theme should be the default?",
    "Wants to run a command: Install the packages", "Has a plan for you"."""
    tool, given = p.get("tool") or "", p.get("input") or {}

    def short(text, n=160):
        t = " ".join(str(text or "").split())
        return t if len(t) <= n else t[:n - 1] + "…"

    def file(path):
        path = str(path or "")
        if root and path.startswith(root.rstrip("/") + "/"):
            path = path[len(root.rstrip("/")) + 1:]
        return path or "a file"
    if tool == "AskUserQuestion":
        questions = [q for q in given.get("questions") or [] if isinstance(q, dict)]
        left = [q for q in questions if q.get("question") not in (p.get("answered") or {})] or questions
        more = len(left) - 1
        return f"Asks: {short(left[0].get('question') if left else '')}" + \
            (f" (and {more} more question{'s' if more > 1 else ''})" if more > 0 else "")
    if tool == "ExitPlanMode":
        plan = str(given.get("plan") or "")
        head = next((l.lstrip("# ").strip() for l in plan.splitlines() if l.startswith("#")), "")
        head = re.sub(r"^plan:\s*", "", head, flags=re.I)
        return f"Has a plan for you to approve: {short(head, 120)}" if head else "Has a plan for you to approve"
    mcp = re.fullmatch(r"mcp__(.+?)__(.+)", tool)
    if mcp:
        server = re.sub(r"[_-]+", " ", re.sub(r"^claude_ai_", "", mcp.group(1))).strip()
        return f"Wants to use {server}: {re.sub(r'[_-]+', ' ', mcp.group(2)).lower()}"
    if tool == "Bash":
        return f"Wants to run a command: {short(given.get('description') or given.get('command'))}"
    if tool in ("Edit", "MultiEdit", "NotebookEdit"):
        return f"Wants to edit {file(given.get('file_path') or given.get('notebook_path'))}"
    if tool == "Write":
        return f"Wants to write {file(given.get('file_path'))}"
    if tool == "Read":
        return f"Wants to read {file(given.get('file_path'))}"
    if tool == "WebFetch":
        host = urllib.parse.urlparse(str(given.get("url") or "")).hostname or "the web"
        return f"Wants to read a page on {host.removeprefix('www.')}"
    if tool == "WebSearch":
        return f"Wants to search the web for “{short(given.get('query'), 100)}”"
    if tool in ("Agent", "Task"):
        return f"Wants to ask a helper: {short(given.get('description'))}"
    if tool == "SendMessage":
        return f"Wants to message session {given.get('to')}" if given.get("to") else "Wants to message another session"
    words = re.sub(r"([a-z])([A-Z])", r"\1 \2", tool).lower() or "a tool"
    return f"Wants to use {words}" + (f": {short(p.get('description'))}" if p.get("description") not in (None, "", tool) else "")


def chat_dialog(s, live=None):
    """The question Claude asks in a session on the chat engine, as a card:
    its text, its options (each with the keys that pick it), or None."""
    live = agent_live(s["id"]) if live is None else live
    pending = live.get("pending") if live.get("state") not in ("exited", None) else None
    if not pending:
        return None
    p = pending[0]
    rid, given = p.get("request_id"), p.get("input") or {}
    for key in [k for k in CHAT_PICKS if k[0] == s["id"] and k[1] not in {x.get("request_id") for x in pending}]:
        del CHAT_PICKS[key]
    options, hint = [], ""
    if p.get("tool") == "AskUserQuestion":
        questions = [q for q in given.get("questions") or [] if isinstance(q, dict)]
        answered = p.get("answered") or {}
        left = [q for q in questions if q.get("question") not in answered]
        if not left:
            return None
        q = left[0]
        text = q.get("question") or ""
        lines = [text]
        if len(questions) > 1:
            lines.append(f"Question {len(questions) - len(left) + 1} of {len(questions)}")
        picks = CHAT_PICKS.get((s["id"], rid, text), []) if q.get("multiSelect") else []
        for o in q.get("options") or []:
            label = str(o.get("label") or "")
            if q.get("multiSelect"):
                options.append({"label": f"{'☑' if label in picks else '☐'} {label}", "detail": o.get("description") or "",
                                "answer": {"question": text, "toggle": label}})
            else:
                options.append({"label": label, "detail": o.get("description") or "",
                                "answer": {"question": text, "answer": label}})
        if q.get("multiSelect"):
            options.append({"label": "Done" if picks else "Done (pick at least one)", "detail": ", ".join(picks),
                            "answer": {"question": text, "done": True}})
            hint = "Pick all that apply, then Done"
        options.append({"label": "Type something.", "detail": "", "answer": {"question": text, "own": True}})
    elif p.get("tool") == "ExitPlanMode":
        lines = ["Claude's plan: approve it?", str(given.get("plan") or "").strip()]
        options = [{"label": "Yes, and start", "detail": "", "answer": {"choice": "allow"}},
                   {"label": "Yes, and accept edits without asking", "detail": "",
                    "answer": {"choice": "allow", "mode": "acceptEdits"}},
                   {"label": "Type something.", "detail": "No, keep planning: say what to change",
                    "answer": {"choice": "deny", "own": True}},
                   {"label": "No, keep planning", "detail": "", "answer": {"choice": "deny"}}]
    else:
        head, rest = chat_tool_ask(p)
        lines = [head, *rest]
        options = [{"label": "Yes", "detail": "", "answer": {"choice": "allow"}}]
        rules = [r for x in p.get("suggestions") or [] if x.get("type") == "addRules" for r in x.get("rules") or []]
        if rules:
            said = ", ".join(f"{r.get('toolName')}({r['ruleContent']})" if r.get("ruleContent") else str(r.get("toolName"))
                             for r in rules)
            options.append({"label": "Yes, and don't ask again", "detail": f"for {said} in this project",
                            "answer": {"choice": "always"}})
        options += [{"label": "No", "detail": "", "answer": {"choice": "deny"}},
                    {"label": "Type something.", "detail": "No, and tell Claude what to do instead",
                     "answer": {"choice": "deny", "own": True}}]
    for i, o in enumerate(options):
        o["keys"] = [str(i + 1)] if i < 9 else ["Down"] * i + ["Enter"]
        o["selected"] = i == 0
    question = "\n".join(lines)
    sig = json.dumps([rid, question, [o["label"] for o in options]])
    return {"id": hashlib.sha1(sig.encode()).hexdigest()[:12], "question": question, "options": options,
            "hint": hint, "request": rid}


def chat_images(images):
    """The images of a message for the chat engine ([{type, data (base64)}]
    from the app) as Claude's image blocks, or why not (a str)."""
    if images is None:
        return []
    if not isinstance(images, list) or len(images) > 20:
        return "images: a list of {type, data}, 20 at most"
    blocks = []
    for im in images:
        kind, data = (im.get("type"), im.get("data")) if isinstance(im, dict) else (None, None)
        if not isinstance(kind, str) or not CLIP_TYPES.fullmatch(kind):
            return "only images (PNG, JPEG, GIF or WebP)"
        try:
            if not isinstance(data, str) or not base64.b64decode(data, validate=True):
                raise ValueError
        except ValueError:
            return "an image that isn't base64"
        blocks.append({"type": "image", "source": {"type": "base64", "media_type": kind, "data": data}})
    return blocks


def chat_attach_later(sid, blocks):
    """Images for the next message of a session whose broker isn't running:
    it takes them as it starts (Agent.load_attached)."""
    f = claude_dir(sid) / "attached.json"
    try:
        had = json.loads(f.read_text())
    except (OSError, ValueError):
        had = []
    write_file(f, json.dumps((had if isinstance(had, list) else []) + blocks))


def chat_attach(s, images):
    """Images pasted into a session on the chat engine (its terminal's
    Ctrl+V, the phone's image button): they go with its next message, as a
    pasted image does in the TUI. None once attached, else (code, why)."""
    blocks = chat_images(images)
    if isinstance(blocks, str):
        return 400, blocks
    end = time.time() + 20
    while not agent_up(s["id"]) and claude_driver(s["id"]) and time.time() < end:
        time.sleep(0.3)         # its broker is starting: it listens in a moment
    if not agent_up(s["id"]):
        chat_attach_later(s["id"], blocks)
        return None
    try:
        r = agent_call(s["id"], {"op": "attach", "images": images})
    except OSError as e:
        return 409, f"Claude's broker didn't answer: {e}"
    return None if r.get("ok") else (400, r.get("error") or "it wasn't attached")


def chat_live(live, s=None):
    """live.json as the app gets it (the stream's live event). A turn held
    (turn_hold: a timer's, a script's or another chat's, nothing shown of it
    until it ends) is idle to the app: no typing…, no words, no step. What
    such a one sent that waits for Claude to be free isn't yours to see."""
    if not live:
        return None
    out = {k: v for k, v in live.items() if k not in ("pid", "claude_pid", "socket", "updated", "turn")}
    # What still runs, and what stopped with its Claude before it ended (live_cut).
    out["tasks"], out["cut"] = live_tasks(live), live_cut(live)
    if isinstance(live.get("queue"), list):
        out["queue"] = [m for m in live["queue"] if isinstance(m, dict) and not m.get("elsewhere")]
    if s and turn_hold(s, live) is not None:
        out.update(state="idle", partial="", thinking=False, activity=None, working_since=None)
    return out


# ---- the composer (phase C2 of docs/plan-chat-app.md): the / menu, the
# model and mode pills, the images in what you said, files you hand Claude

UPLOAD_MAX = 70_000_000         # bytes of one uploaded file, as base64 in its JSON (about 50 MB)
UPLOADS = Path(".amarchy") / "uploads"      # in the worktree, git-ignored by .amarchy/.gitignore


def front_matter(f):
    """A skill's or command's markdown front matter ({key: value}, plain
    values only) and the first line of its text after it."""
    try:
        text = f.read_text(errors="replace")[:20_000]
    except OSError:
        return {}, ""
    meta, body = {}, text
    m = re.match(r"---\s*\n(.*?)\n---\s*(?:\n|$)", text, re.S)
    if m:
        body = text[m.end():]
        for line in m.group(1).splitlines():
            kv = re.match(r"([\w-]+):\s*(.*)$", line)
            if kv:
                meta[kv.group(1)] = kv.group(2).strip().strip("\"'")
    first = next((l.strip().lstrip("#").strip() for l in body.splitlines() if l.strip()), "")
    return meta, first


def skills_in(root, where):
    """The commands (.claude/commands/**.md) and skills
    (.claude/skills/<name>/SKILL.md) under a folder (a project, or ~), as
    initialize lists them: {name, description, argumentHint, where}."""
    out = []
    commands = Path(root) / ".claude" / "commands"
    for f in sorted(commands.rglob("*.md")) if commands.is_dir() else []:
        meta, first = front_matter(f)
        out.append({"name": ":".join(f.relative_to(commands).with_suffix("").parts),
                    "description": meta.get("description") or first, "argumentHint": meta.get("argument-hint") or "",
                    "where": where})
    skills = Path(root) / ".claude" / "skills"
    for f in sorted(skills.glob("*/SKILL.md")) if skills.is_dir() else []:
        meta, first = front_matter(f)
        out.append({"name": meta.get("name") or f.parent.name, "description": meta.get("description") or first,
                    "argumentHint": meta.get("argument-hint") or "", "where": where})
    return out


def composer_info(s):
    """What the composer offers for a session, whichever engine it's on:
    the commands and skills for its / menu (its project's own marked
    "project"), the models, and the model and permission mode it's in. A
    chat-engine Claude said what it has (agent.json, from initialize); for
    the classic terminal it's the newest any session's Claude said, without
    other projects' own, and this project's read off its folder."""
    sid, chat = s["id"], engine(s) == "chat"
    told, its = {}, chat and (claude_dir(sid) / "agent.json").exists()
    if its:
        f = claude_dir(sid) / "agent.json"
    else:
        others = [f for f in CLAUDE_STATE.glob("*/agent.json")] if CLAUDE_STATE.is_dir() else []
        f = max(others, key=lambda f: f.stat().st_mtime, default=None)
    try:
        told = json.loads(f.read_text()) if f else {}
    except (OSError, ValueError):
        told = {}
    told = told if isinstance(told, dict) else {}
    own = skills_in(s["path"], "project")
    mine = {c["name"] for c in own}
    commands = []
    for c in told.get("commands") or []:
        if not isinstance(c, dict) or not isinstance(c.get("name"), str):
            continue
        desc = str(c.get("description") or "")
        if not its and desc.rstrip().endswith("(project)") and c["name"] not in mine:
            continue        # another project's own
        commands.append({"name": c["name"], "description": desc, "argumentHint": c.get("argumentHint") or "",
                         "aliases": c.get("aliases") or [], "builtin": bool(c.get("builtin")),
                         "where": "project" if c["name"] in mine or desc.rstrip().endswith("(project)") else ""})
    known = {c["name"] for c in commands}
    if not told.get("commands"):
        own += [c for c in skills_in(Path.home(), "user") if c["name"] not in mine]
    commands += [c for c in own if c["name"] not in known]
    if chat:
        live = agent_live(sid)
        model, mode = live.get("model") or "", live.get("permission_mode") or ""
        effort = live.get("effort") or ""
        if not effort and agent_up(sid):
            effort = asked_effort(sid)      # a broker from before efforts: Claude says
        if not agent_up(sid):       # asleep: it wakes in what you chose last
            try:
                chosen = json.loads((claude_dir(sid) / "chosen.json").read_text())
            except (OSError, ValueError):
                chosen = {}
            model = chosen.get("model") or model if isinstance(chosen, dict) else model
            mode = chosen.get("mode") or mode if isinstance(chosen, dict) else mode
            picked = chosen.get("effort") if isinstance(chosen, dict) else None
            if picked in EFFORTS:
                effort = picked
            elif picked == "auto":      # the model's own: as last seen on it
                effort = default_efforts().get(live.get("model") or "") or effort
    else:
        (model, mode), effort = transcript_settings(s), ""
    models = models_of(told)
    return {"engine": "chat" if chat else "terminal", "commands": commands, "models": models,
            "model": model, "effort": effort, "mode": mode, "up": agent_up(sid) if chat else None}


def asked_effort(sid):
    """The effort a session's Claude thinks at, asked of it (get_settings),
    for a broker that doesn't keep it in live.json; "" if it doesn't say."""
    try:
        r = agent_call(sid, {"op": "control", "request": {"subtype": "get_settings"}, "timeout": 5}, timeout=8)
    except OSError:
        return ""
    e = ((r.get("response") or {}).get("applied") or {}).get("effort") if r.get("ok") else None
    return e if e in EFFORTS else ""


def upload_name(name):
    """A file's name as it's kept in the uploads folder: its own, without a
    path or anything a shell would trip on."""
    base = re.sub(r"[^\w.()+ -]+", "_", Path(str(name or "")).name).strip(" .")[:120]
    return base or "file"


def app_upload(s, data):
    """A file you gave Claude, kept in the session's worktree under
    .amarchy/uploads/ (git-ignored, so it's never committed): {name, data
    (base64)} -> {path (from the worktree's top), full (from /: what a
    terminal's message line types), size}, or (code, why).
    {remove: path}: one taken back before it was sent."""
    root = Path(s["path"])
    if not root.is_dir():
        return 409, "The session's folder isn't there"
    folder = root / UPLOADS
    if "remove" in data:
        f = root / str(data.get("remove") or "")
        if f.parent != folder or not f.is_file():
            return 400, "not an uploaded file"
        f.unlink()
        return {"removed": str(f.relative_to(root))}
    try:
        raw = base64.b64decode(data.get("data") or "", validate=True)
    except (ValueError, TypeError):
        return 400, "a file that isn't base64"
    if not raw and data.get("data"):
        return 400, "an empty file"
    try:
        folder.mkdir(parents=True, exist_ok=True)
        ignore = root / ".amarchy" / ".gitignore"
        if not ignore.exists():
            ignore.write_text("# amarchy's own (files you gave Claude): never committed\n*\n")
        name = upload_name(data.get("name"))
        stem, ext = Path(name).stem, Path(name).suffix
        f, n = folder / name, 2
        while f.exists():
            f, n = folder / f"{stem} ({n}){ext}", n + 1
        tmp = folder / f".{f.name}.part"
        tmp.write_bytes(raw)
        tmp.replace(f)
    except OSError as e:
        return 500, f"couldn't keep it: {e}"
    return {"path": str(f.relative_to(root)), "full": str(f), "size": len(raw)}


def transcript_image(s, rec, n):
    """The n-th image of a message in the session's conversation (rec: its
    uuid): (media type, bytes), or None."""
    f = transcript(s)
    if not f or not re.fullmatch(r"[\w-]{8,80}", rec):
        return None
    key = rec.encode()
    try:
        with open(f, "rb") as fh:
            for line in fh:
                if key not in line or b'"image"' not in line:
                    continue
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if r.get("uuid") != rec:
                    continue
                content = (r.get("message") or {}).get("content")
                images = [b for b in content if isinstance(b, dict) and b.get("type") == "image"] \
                    if isinstance(content, list) else []
                src = images[n].get("source") or {} if 0 <= n < len(images) else {}
                kind = src.get("media_type") or ""
                if src.get("type") != "base64" or not CLIP_TYPES.fullmatch(kind):
                    return None
                return kind, base64.b64decode(src.get("data") or "")
    except (OSError, ValueError):
        return None
    return None


def chat_answer(s, request):
    """An answer to the session's broker ({request_id, ...}: Agent.op
    "answer"): None once it has it, else (code, why)."""
    if not agent_up(s["id"]):
        return 409, "Claude isn't running: wake it first"
    try:
        r = agent_call(s["id"], {"op": "answer", **request})
    except OSError as e:
        return 500, f"Claude's broker didn't answer: {e}"
    if not r.get("ok"):
        return (409 if r.get("gone") else 400), r.get("error") or "it wasn't taken"
    return None


def chat_pick(s, dialog, keys, text=None):
    """Do what the option of a chat_dialog with these keys does (with text,
    the one to answer in your own words): None once done, else (code, why)."""
    o = next((o for o in dialog["options"] if o["keys"] == keys), None)
    if not o:
        return 400, "no such answer"
    a, rid = o["answer"], dialog["request"]
    if a.get("own"):
        if not isinstance(text, str) or not text.strip():
            return 400, "your answer"
        if "question" in a:
            return chat_answer(s, {"request_id": rid, "question": a["question"], "answer": text.strip()})
        return chat_answer(s, {"request_id": rid, "choice": "deny", "message": text.strip()})
    if "toggle" in a:
        key = (s["id"], rid, a["question"])
        picks = CHAT_PICKS.setdefault(key, [])
        picks.remove(a["toggle"]) if a["toggle"] in picks else picks.append(a["toggle"])
        return None
    if a.get("done"):
        picks = CHAT_PICKS.get((s["id"], rid, a["question"])) or []
        if not picks:
            return 409, "Pick at least one first"
        why = chat_answer(s, {"request_id": rid, "question": a["question"], "answer": ", ".join(picks)})
        if not why:
            CHAT_PICKS.pop((s["id"], rid, a["question"]), None)
        return why
    if "question" in a:
        return chat_answer(s, {"request_id": rid, "question": a["question"], "answer": a["answer"]})
    return chat_answer(s, {"request_id": rid, **{k: v for k, v in a.items() if k in ("choice", "mode")}})


def valid_keys(keys):
    return isinstance(keys, list) and 0 < len(keys) <= 20 and all(isinstance(k, str) and k in APP_KEYS for k in keys)


def app_keys(s, keys):
    pane = f"={tmux_name(s['id'])}:"
    for i, key in enumerate(keys):
        if i:
            time.sleep(0.06)
        r = tmux("send-keys", "-t", pane, key)
        if r.returncode != 0:
            return r.stderr.strip() or "tmux failed"
    return None


SGR = re.compile(r"\x1b\[([0-9;:]*)m")
ANSI = re.compile(r"\x1b\[[0-9;:?]*[A-Za-z]")


def undimmed(line):
    """A line of the screen (with its colors) without its dim text: Claude's
    grey placeholder and suggestions aren't what's typed."""
    out, dim, at = [], False, 0
    for m in SGR.finditer(line):
        if not dim:
            out.append(line[at:m.start()])
        at = m.end()
        ps = m.group(1).replace(":", ";").split(";")
        i = 0
        while i < len(ps):
            p = ps[i]
            if p in ("38", "48", "58"):        # a color: its own numbers aren't attributes
                i += 3 if ps[i + 1:i + 2] == ["5"] else 5
                continue
            if p in ("", "0", "22"):
                dim = False
            elif p == "2":
                dim = True
            i += 1
    if not dim:
        out.append(line[at:])
    return ANSI.sub("", "".join(out))


def claude_prompt(s):
    """What's typed in the session's Claude's prompt, as one line ("" for
    nothing), or None when its prompt isn't on screen (asleep or waking, the
    prompt there is Claude's last screen, not Claude)."""
    if asleep_since(s["id"]) is not None or waking_now(s["id"]):
        return None
    r = tmux("capture-pane", "-p", "-e", "-t", f"={tmux_name(s['id'])}:")
    if r.returncode != 0:
        return None
    raw = r.stdout.splitlines()
    plain = [ANSI.sub("", l).rstrip() for l in raw]
    rule = lambda l: len(l) > 10 and set(l.strip()) == {"─"}
    for i in range(len(plain) - 1, 0, -1):
        if not (plain[i].startswith("❯") and rule(plain[i - 1])):
            continue
        end = next((j for j in range(i + 1, len(plain)) if rule(plain[j])), None)
        if end is None:
            return None
        parts = [undimmed(raw[i]).split("❯", 1)[-1], *(undimmed(l) for l in raw[i + 1:end])]
        return " ".join(" ".join(p.replace("\xa0", " ").split()) for p in parts).strip()
    return None


# ---- dictation on the host: speech to text, without Claude
#
# The app's mic button writes what you say into the box you're typing in (a
# session's, the new-session bar's) without Claude Code's voice mode, which
# only a session's terminal Claude has (see "dictation from the phone"). The
# phone's or the browser's microphone, 16 kHz 16-bit mono as for that
# (voice.js), is written down here, by NVIDIA's Parakeet TDT 0.6B v3 through
# transcribe.cpp (github.com/handy-computer/transcribe.cpp, MIT: the engine
# Hex and Handy write speech down with). It knows 25 European languages,
# Spanish and English among them, and tells them apart by itself; on the
# CPU it writes ~10 seconds of speech in one. Free, and the audio never
# leaves your machines.
#
# The engine comes with amarchy, on every processor it runs on (x86_64 and
# aarch64: DICTATE_ENGINE, a release of transcribe.cpp pinned by its hash):
# a package carries it (DICTATE_PACKAGED, packaging/arch), and a checkout
# fetches it when it's installed (install.sh), into the state. Never a
# distro's package, never a build here. Only its CPU code is kept (the
# Vulkan one is 42 MB of its 64, for a GPU a server hasn't). The model
# (740 MB) is fetched once, the first time it's wanted (amarchy dictation
# setup, Settings in the app), into the state. A worker (amarchy dictation
# worker) keeps it loaded while dictations come, and exits DICTATE_KEEP
# after the last one. What's said is cut at its pauses as it comes, and
# each piece written down while the next is said: the words come up as you
# talk, and letting go leaves only the last piece to do.
#
# A machine without the model (not set up yet, or a laptop that shouldn't
# hold it) sends a dictation to another machine of yours that has it (see
# "machines"): its /api/dictate is that machine's, passed on (dictate_helper),
# and the app's mic works there as here. Never further than one: the machine
# that's asked writes it down itself or says no.

DICTATE = STATE / "dictation"
DICTATE_MODEL = {
    "name": "Parakeet TDT 0.6B v3",
    "file": "parakeet-tdt-0.6b-v3-Q8_0.gguf",
    "url": "https://huggingface.co/handy-computer/parakeet-tdt-0.6b-v3-gguf/resolve/"
           "d8d8c32cb2017c57e5307767343e97870f8a7f53/parakeet-tdt-0.6b-v3-Q8_0.gguf",
    "size": 739508576,
    "sha256": "5859f77944efcd8eafa23a6350731960b2b55b2203df51f319665c807d802cc7",
}
DICTATE_ENGINE = {          # what writes it down: this release of transcribe.cpp, for each processor
    "name": "transcribe.cpp", "version": "0.4.2",
    "builds": {
        "x86_64": {"url": "https://github.com/handy-computer/transcribe.cpp/releases/download/v0.4.2/"
                          "transcribe-native-0.4.2-linux-x86_64-cpu-vulkan.tar.gz",
                   "size": 22562331, "sha256": "4fe87db8919ea34e461db7987713b580f54e6f3ed610457c5d8fb8eac1a15046"},
        "aarch64": {"url": "https://github.com/handy-computer/transcribe.cpp/releases/download/v0.4.2/"
                           "transcribe-native-0.4.2-linux-aarch64-cpu-vulkan.tar.gz",
                    "size": 18137774, "sha256": "5e9cc7b244949fc686d1272e796e965411e80cc768533f1704c3c53e4c7d695e"},
    },
}
DICTATE_ENGINE_LIB = "libtranscribe.so"
DICTATE_ENGINE_SKIP = {"libggml-vulkan.so"}         # not kept: the GPU's (42 MB), never used (CPU only)
DICTATE_PACKAGED = Path("/usr/lib/amarchy/transcribe.cpp")  # the package's (packaging/arch)
DICTATE_ENGINE_DIR = DICTATE / "transcribe.cpp"     # else fetched here (install.sh, setup)
# What amarchy wrote dictations down with before transcribe.cpp (whisper.cpp's
# libparakeet, its model, the whisper.cpp setup built where no package had
# it): deleted once the new model is in.
DICTATE_BEFORE = ("parakeet-tdt-0.6b-v3-q8_0.bin", "parakeet-tdt-0.6b-v3-q8_0.bin.part", "whisper.cpp", "build",
                  "whisper.cpp.new", "build.log")
DICTATE_SETUP = DICTATE / "setup.json"      # a setup under way: how far, or why it stopped
DICTATE_UNIT = "amarchy-dictation-setup"    # a setup run in the background (systemctl --user status ...)
DICTATE_LOG = DICTATE / "log.jsonl"         # the last dictations: how they went (amarchy dictation log)
DICTATE_LOG_KEEP = 500                      # lines of it kept
DICTATE_KEEP = 600          # seconds the model stays loaded after the last dictation
DICTATE_LOAD = 30           # seconds loading it may take
DICTATE_PIECE_TIME = 60     # seconds writing one piece down may take
DICTATE_RATE = 16000
DICTATE_FRAME = 640         # bytes: 20 ms
DICTATE_LOUD = 150          # RMS (of 32768) under which a frame is silence, whatever the room
DICTATE_PAUSE = 30          # frames of silence that end a piece: 0.6 s
DICTATE_SHORTEST = 75       # frames of a piece before a pause ends it: 1.5 s
DICTATE_PIECE_MOST = 300    # frames a piece is at most: 6 s
DICTATE_STRETCH = 1000      # frames of a long stretch before a pause ends it: 20 s
DICTATE_STRETCH_MOST = 1500 # frames a long stretch is at most: 30 s, cut at its quietest moment near the end
DICTATE_WORDS = 5           # frames of sound worth writing down: 0.1 s
DICTATE_BREAK = 50          # frames of silence that end a long stretch of 3 s or more too: 1 s, where
                            # you'd go on in another language (it writes one at a time down)
MIC_MAX = 300             # seconds a dictation on the host lasts at most
MIC_QUIET = 3             # seconds without a word from the phone before it counts as let go


def mb_of(size):
    """A size in MB as people round it."""
    return -(-size // 10_000_000) * 10


def dictate_mb():
    """The model's size, in MB as people round it."""
    return mb_of(DICTATE_MODEL["size"])


def dictate_model_path():
    return DICTATE / DICTATE_MODEL["file"]


def dictate_arch():
    """This machine's processor, as packages name it (x86_64, aarch64).
    (AMARCHY_DICTATE_ARCH: another, for the tests.)"""
    import platform
    return os.environ.get("AMARCHY_DICTATE_ARCH") or platform.machine() or "this processor"


def dictate_build():
    """The engine's build for this machine ({url, size, sha256}), or None
    where amarchy has none (another processor, or not Linux)."""
    return DICTATE_ENGINE["builds"].get(dictate_arch()) if sys.platform.startswith("linux") else None


def dictate_engine_version(d):
    """The transcribe.cpp release in folder d (its contract.json), or None."""
    try:
        v = json.loads((Path(d) / "contract.json").read_text()).get("version")
        return v if isinstance(v, str) else None
    except (OSError, ValueError, AttributeError):
        return None


_dictate_lib = {"at": 0, "found": None}


def dictate_lib():
    """The engine (transcribe.cpp's libtranscribe), or None: the one
    AMARCHY_DICTATE_ENGINE names (a folder: one built by hand, where amarchy
    has no build), else the package's, else the one fetched into the state.
    Only the release amarchy pins (the worker is written for its API).
    Looked for again a minute later, or a few seconds while there's none (a
    setup fetching it), and at once when it's gone (amarchy dictation remove).
    (AMARCHY_DICTATE_SYSTEM=off: as without the package, for the tests.)"""
    found = _dictate_lib["found"]
    if time.time() - _dictate_lib["at"] > (60 if found else 3) or (found and not os.path.isfile(found)):
        own = os.environ.get("AMARCHY_DICTATE_ENGINE")
        dirs = [Path(own).expanduser()] if own else \
            [*([DICTATE_PACKAGED] if os.environ.get("AMARCHY_DICTATE_SYSTEM") != "off" else []), DICTATE_ENGINE_DIR]
        found = next((str(d / DICTATE_ENGINE_LIB) for d in dirs if (d / DICTATE_ENGINE_LIB).is_file()
                      and (own or dictate_engine_version(d) == DICTATE_ENGINE["version"])), None)
        _dictate_lib.update(at=time.time(), found=found)
    return _dictate_lib["found"]


def dictate_ready():
    """Whether this machine writes dictations down itself: its engine and
    its model are here (what its hello says, and what another machine
    sends its dictations here for)."""
    return bool(dictate_lib()) and dictate_model_path().is_file()


def dictate_fetching():
    """What setup fetches here now: [(what, size)], the engine where it
    isn't here (and amarchy has it for this processor), then the model."""
    build = None if dictate_lib() else dictate_build()
    return ([(f"{DICTATE_ENGINE['name']} {DICTATE_ENGINE['version']}", build["size"])] if build else []) + \
        ([] if dictate_model_path().is_file() else [(DICTATE_MODEL["name"], DICTATE_MODEL["size"])])


def dictate_before():
    """Whether dictation was set up here before transcribe.cpp (whisper.cpp's model)."""
    return (DICTATE / DICTATE_BEFORE[0]).is_file()


def dictate_status():
    """Whether this machine can write dictations down, and if not why: the
    engine, the model, or the setup under way (fetching them); how to set it
    up (dictate_how, fix: its command), and whether setup can do it all by
    itself (auto: amarchy has the engine for this processor). size: what
    setup fetches (the model's once it's all here). buildable is always
    false: nothing is built here any more (the app reads it)."""
    lib, model = bool(dictate_lib()), dictate_model_path().is_file()
    setup = None
    try:
        setup = json.loads(DICTATE_SETUP.read_text())
        if not isinstance(setup, dict):
            setup = None
        elif setup.get("pid") and not setup.get("error") and not pid_alive(setup["pid"]):
            setup = {**setup, "error": "the download stopped"}
        elif not setup.get("pid") and not setup.get("error") and time.time() - (setup.get("at") or 0) > 60:
            setup = {**setup, "error": "the setup didn't start"}       # (asked for, never began: dictate_kick)
    except (OSError, ValueError):
        pass
    ready = lib and model
    how, fix = dictate_how(both=True) if not ready else (None, None)
    under_way = setup and not setup.get("error") and isinstance(setup.get("size"), int)
    size = setup["size"] if under_way else sum(n for _, n in dictate_fetching()) or DICTATE_MODEL["size"]
    return {"ready": ready, "lib": lib, "model": model, "engine": DICTATE_MODEL["name"], "size": size,
            "setup": None if ready else setup, "how": how, "fix": fix, "auto": lib or bool(dictate_build()),
            "buildable": False, "arch": dictate_arch()}


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def dictate_how(both=False):
    """What to do so this machine can write dictations down, in a line:
    setup, which fetches what's missing; or, on a processor amarchy has no
    engine for, an engine built by hand. both: (the line, the command to
    run, or None where there's none)."""
    if not dictate_lib() and not dictate_build():
        line = (f"amarchy has no speech engine for {dictate_arch()}: build transcribe.cpp {DICTATE_ENGINE['version']} "
                f"(github.com/handy-computer/transcribe.cpp), set AMARCHY_DICTATE_ENGINE to the folder with its "
                f"{DICTATE_ENGINE_LIB}, then amarchy dictation setup; or pair a machine of yours that has it")
        return (line, None) if both else line
    fetch = dictate_fetching()
    what = " and ".join(w for w, _ in fetch) or DICTATE_MODEL["name"]
    line = f"amarchy dictation setup (fetches {what}, {mb_of(sum(n for _, n in fetch) or DICTATE_MODEL['size'])} MB)"
    return (line, "amarchy dictation setup") if both else line


def dictate_download(url, part, size, sha256, progress, quiet=False):
    """url into part (again from where it stopped, if it did), checked by
    its size and hash. progress(have) as it comes. Raises OSError."""
    import urllib.request
    have = part.stat().st_size if part.exists() else 0
    if have > size:
        part.unlink()
        have = 0
    progress(have)
    if have < size:
        req = urllib.request.Request(url, headers={"User-Agent": "amarchy", **({"Range": f"bytes={have}-"} if have else {})})
        with urllib.request.urlopen(req, timeout=60) as r:
            if have and r.status != 206:      # it can't go on from there: from the start
                have = 0
            with open(part, "ab" if have else "wb") as f:
                last = 0
                while True:
                    chunk = r.read(1 << 20)
                    if not chunk:
                        break
                    f.write(chunk)
                    have += len(chunk)
                    if time.time() - last > 0.5:
                        last = time.time()
                        progress(have)
    progress(have)
    digest = hashlib.sha256()
    with open(part, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            digest.update(chunk)
    if have != size or digest.hexdigest() != sha256:
        part.unlink(missing_ok=True)
        raise OSError("what came isn't what it should be (a broken download?): try again")


def dictate_unpack(archive):
    """The engine's release (archive, checked already) into
    DICTATE_ENGINE_DIR: its libraries and licenses, without the GPU's, and
    only once it loads here (this processor runs it, the libraries find
    each other). Raises OSError."""
    import tarfile
    new = DICTATE / "transcribe.cpp.new"
    shutil.rmtree(new, ignore_errors=True)
    try:
        with tarfile.open(archive, "r:gz") as t:
            for m in t.getmembers():
                rel = PurePosixPath(m.name.partition("/")[2])       # inside its one folder
                if not rel.parts or rel.is_absolute() or ".." in rel.parts or rel.name in DICTATE_ENGINE_SKIP:
                    continue
                out = new.joinpath(*rel.parts)
                if m.isdir():
                    out.mkdir(parents=True, exist_ok=True)
                elif m.isfile():
                    out.parent.mkdir(parents=True, exist_ok=True)
                    with t.extractfile(m) as src, open(out, "wb") as dst:
                        shutil.copyfileobj(src, dst)
                    out.chmod(0o755 if m.mode & 0o111 else 0o644)
        if dictate_engine_version(new) != DICTATE_ENGINE["version"] or not (new / DICTATE_ENGINE_LIB).is_file():
            raise OSError(f"what came isn't {DICTATE_ENGINE['name']} {DICTATE_ENGINE['version']}")
        # (A crash in it leaves no core behind: on Omarchy one would show as "Process crashed".)
        import resource
        r = subprocess.run([sys.executable, "-I", "-c",
                            "import ctypes, sys; sys.exit(ctypes.CDLL(sys.argv[1]).transcribe_init_backends_default())",
                            str(new / DICTATE_ENGINE_LIB)], capture_output=True, text=True, timeout=60, env=clean_env(),
                           preexec_fn=lambda: resource.setrlimit(resource.RLIMIT_CORE, (1, 1)))
        if r.returncode != 0:
            said = (r.stderr.strip().splitlines() or [f"exit {r.returncode}"])[-1]
            raise OSError(f"{DICTATE_ENGINE['name']} doesn't run on this machine ({said[:200]})")
        shutil.rmtree(DICTATE_ENGINE_DIR, ignore_errors=True)
        new.rename(DICTATE_ENGINE_DIR)
        _dictate_lib["at"] = 0      # found at once
    except (tarfile.TarError, EOFError, subprocess.TimeoutExpired) as e:
        raise OSError(f"{DICTATE_ENGINE['name']} didn't unpack: {e}")
    finally:
        shutil.rmtree(new, ignore_errors=True)


def dictate_setup(quiet=False, engine=False):
    """Fetch what dictation needs here and isn't here: the engine (where no
    package has it), then the model (engine: only the engine, and the model
    where an older one was set up: what an install fetches). Each again from
    where it stopped, if it did, and checked. How far it got goes to
    DICTATE_SETUP for the app (done of size, both together). None once
    it's done, else why not."""
    DICTATE.mkdir(parents=True, exist_ok=True)
    # One setup at a time (the app's button and a terminal, say).
    lock = open(DICTATE / "setup.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return "a setup is already under way (amarchy dictation shows how far)"
    build = None if dictate_lib() else dictate_build()
    model = not dictate_model_path().is_file() and (not engine or dictate_before())
    size = (build["size"] if build else 0) + (DICTATE_MODEL["size"] if model else 0)
    done = [0, 0]       # what came before this download, and of this one

    def note(**kw):
        write_file(DICTATE_SETUP, json.dumps({"pid": os.getpid(), "size": size, "done": done[0] + done[1], **kw}) + "\n")

    def progress(have):
        done[1] = have
        note()
        if not quiet and sys.stderr.isatty() and size:
            print(f"\r  {(done[0] + have) // 1_000_000} of {size // 1_000_000} MB ({(done[0] + have) * 100 // size}%)",
                  end="", file=sys.stderr, flush=True)

    try:
        if not dictate_lib() and not build:
            raise OSError(dictate_how())
        if build:
            archive = DICTATE / f"transcribe.cpp-{DICTATE_ENGINE['version']}.tar.gz.part"
            dictate_download(build["url"], archive, build["size"], build["sha256"], progress, quiet)
            note(checking=True)
            try:
                dictate_unpack(archive)
            finally:
                archive.unlink(missing_ok=True)
            done[:] = [build["size"], 0]
        if model:
            part = DICTATE / (DICTATE_MODEL["file"] + ".part")
            dictate_download(DICTATE_MODEL["url"], part, DICTATE_MODEL["size"], DICTATE_MODEL["sha256"], progress, quiet)
            part.rename(dictate_model_path())
        if dictate_model_path().is_file():
            for old in DICTATE_BEFORE:          # what wrote it down before: not needed now
                p = DICTATE / old
                shutil.rmtree(p, ignore_errors=True) if p.is_dir() else p.unlink(missing_ok=True)
        DICTATE_SETUP.unlink(missing_ok=True)
        (DICTATE / "setup.lock").unlink(missing_ok=True)
        return None
    except (OSError, ValueError) as e:
        why = str(getattr(e, "reason", None) or e)
        note(error=why)
        return why
    finally:
        if not quiet and sys.stderr.isatty() and size:
            print(file=sys.stderr)
        lock.close()


def dictate_kick(engine=False):
    """amarchy dictation setup in the background, in a unit of its own where
    there's systemd (restarting the app, or an update's install, doesn't
    stop it; it would go on from where it stopped anyway). Whether it started."""
    argv = [sys.executable, SELF, "dictation", "setup", "--quiet", *(["--engine"] if engine else [])]
    # How far it is, from now on (the app, and an install's line, say Fetching at once).
    size = sum(n for w, n in dictate_fetching() if not engine or w != DICTATE_MODEL["name"] or dictate_before())
    if size:
        DICTATE.mkdir(parents=True, exist_ok=True)
        write_file(DICTATE_SETUP, json.dumps({"pid": None, "at": int(time.time()), "size": size, "done": 0}) + "\n")
    if apart(DICTATE_UNIT, argv):
        return True
    try:
        detach(argv)        # (a test's home: never on the account's systemd)
    except OSError:
        return False
    return True


def dictate_worker():
    """amarchy dictation worker: load the model and write down what comes on
    stdin, one piece at a time: its length (4 bytes, little-endian), then
    that much audio (16 kHz 16-bit mono). Each answer is a line of JSON on
    stdout ({"text"} or {"error"}), the first one once the model is loaded.
    Through transcribe.cpp's C API (transcribe.h, of the release pinned),
    on the CPU."""
    import array
    import ctypes as C
    out = sys.stdout

    def say(**d):
        out.write(json.dumps(d) + "\n")
        out.flush()

    lib_path, model = dictate_lib(), dictate_model_path()
    if not lib_path or not model.is_file():
        say(error=f"not set up: {dictate_how()}")
        return 1

    class BackendParams(C.Structure):       # transcribe_backend_init_params
        _fields_ = [("struct_size", C.c_uint64), ("artifact_dir", C.c_char_p), ("allowed_backends", C.c_uint32)]

    class SessionParams(C.Structure):       # transcribe_session_params
        _fields_ = [("struct_size", C.c_uint64), ("n_threads", C.c_int), ("kv_type", C.c_int), ("n_ctx", C.c_int32)]

    started = time.time()
    try:
        lib = C.CDLL(lib_path)
    except OSError as e:
        say(error=f"couldn't load {DICTATE_ENGINE['name']}: {e}")
        return 1
    log = C.CFUNCTYPE(None, C.c_int, C.c_char_p, C.c_void_p)(lambda *a: None)     # its chatter, unsaid
    lib.transcribe_log_set.argtypes = [C.c_void_p, C.c_void_p]
    lib.transcribe_log_set(C.cast(log, C.c_void_p), None)
    lib.transcribe_status_string.restype = C.c_char_p
    lib.transcribe_status_string.argtypes = [C.c_int]
    lib.transcribe_backend_init_params_init.argtypes = [C.POINTER(BackendParams)]
    lib.transcribe_init_backends_ex.argtypes = [C.POINTER(BackendParams)]
    lib.transcribe_model_load_file.argtypes = [C.c_char_p, C.c_void_p, C.POINTER(C.c_void_p)]
    lib.transcribe_session_params_init.argtypes = [C.POINTER(SessionParams)]
    lib.transcribe_session_init.argtypes = [C.c_void_p, C.POINTER(SessionParams), C.POINTER(C.c_void_p)]
    lib.transcribe_session_free.argtypes = [C.c_void_p]
    lib.transcribe_run.argtypes = [C.c_void_p, C.POINTER(C.c_float), C.c_int, C.c_void_p]
    lib.transcribe_full_text.argtypes = [C.c_void_p]
    lib.transcribe_full_text.restype = C.c_char_p

    def why(status):
        return (lib.transcribe_status_string(status) or b"").decode("utf-8", "replace") or f"status {status}"

    # The CPU's code only (the variant for this processor, beside the library): no GPU driver ever runs.
    bp = BackendParams()
    lib.transcribe_backend_init_params_init(C.byref(bp))
    bp.allowed_backends = 0x1       # TRANSCRIBE_BACKEND_MASK_CPU
    status = lib.transcribe_init_backends_ex(C.byref(bp))
    if status != 0:
        say(error=f"{DICTATE_ENGINE['name']} found no way to run here ({why(status)})")
        return 1
    mdl, sess = C.c_void_p(), C.c_void_p()
    status = lib.transcribe_model_load_file(str(model).encode(), None, C.byref(mdl))
    if status != 0:
        say(error=f"the model didn't load ({why(status)}: a broken download? amarchy dictation remove, then setup)")
        return 1
    def threads():
        """As many threads as the processor has free now, 2 to 8: on a busy
        machine (other chats' builds and tests) more only wait on each other
        (JFK's 11 s at a load of 25 on 16 cores: 2.9 s with 2, 10 s with 8)."""
        cpus = os.cpu_count() or 4
        try:
            busy = os.getloadavg()[0]
        except OSError:
            busy = 0
        return max(2, min(8, cpus // 2, int(cpus - busy)))

    def session(n):
        """A session with n threads (it costs nothing next to the model), or why not."""
        nonlocal sess
        if sess:
            lib.transcribe_session_free(sess)
            sess = C.c_void_p()
        sp = SessionParams()
        lib.transcribe_session_params_init(C.byref(sp))
        sp.n_threads = n
        status = lib.transcribe_session_init(mdl, C.byref(sp), C.byref(sess))
        return None if status == 0 else why(status)

    used = threads()
    problem = session(used)
    if problem:
        say(error=f"the model didn't start ({problem})")
        return 1
    say(ready=True, ms=int((time.time() - started) * 1000))
    stdin = sys.stdin.buffer
    while True:
        head = stdin.read(4)
        if len(head) < 4:
            return 0
        n = int.from_bytes(head, "little")
        data = stdin.read(n)
        if len(data) < n:
            return 0
        pcm = array.array("h")
        pcm.frombytes(data[:len(data) // 2 * 2])
        # At least a second (with silence after): a word alone is too short for it.
        pcm.extend([0] * max(0, DICTATE_RATE - len(pcm)))
        samples = (C.c_float * len(pcm)).from_buffer(array.array("f", (x / 32768 for x in pcm)))
        t = time.time()
        if threads() != used:
            used = threads()
            problem = session(used)
            if problem:
                say(error=f"it couldn't write that down ({problem})")
                continue
        status = lib.transcribe_run(sess, samples, len(pcm), None)
        if status != 0:
            say(error=f"it couldn't write that down ({why(status)})")
            continue
        text = (lib.transcribe_full_text(sess) or b"").decode("utf-8", "replace")
        say(text=" ".join(text.split()), ms=int((time.time() - t) * 1000))


class Transcriber:
    """The worker (amarchy dictation worker), for the app's server: started
    when a dictation starts (the model loads while you speak), one piece at
    a time, and let go of DICTATE_KEEP after the last one."""

    def __init__(self):
        self.lock = threading.Lock()
        self.proc, self.used = None, 0.0
        threading.Thread(target=self.reap, daemon=True).start()

    def line(self, proc, timeout):
        """The worker's next answer, or None when it has none in time (or died)."""
        end = time.time() + timeout
        while time.time() < end:
            r, _, _ = select.select([proc.stdout], [], [], min(1.0, max(0.0, end - time.time())))
            if r:
                raw = proc.stdout.readline()
                if not raw:
                    return None
                try:
                    d = json.loads(raw)
                    return d if isinstance(d, dict) else None
                except ValueError:
                    continue
            if proc.poll() is not None:
                return None
        return None

    def start(self):
        """The worker, loaded (call with the lock held). Why not, else."""
        if self.proc and self.proc.poll() is None:
            return None
        try:
            self.proc = subprocess.Popen([sys.executable, SELF, "dictation", "worker"], stdin=subprocess.PIPE,
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=clean_env())
        except OSError as e:
            self.proc = None
            return str(e)
        d = self.line(self.proc, DICTATE_LOAD)
        if not d or not d.get("ready"):
            self.stop()
            return (d or {}).get("error") or "the model didn't load in time"
        self.used = time.time()
        return None

    def stop(self):
        proc, self.proc = self.proc, None
        if proc:
            try:
                proc.stdin.close()
                proc.wait(3)
            except (OSError, subprocess.TimeoutExpired):
                proc.kill()

    def warm(self):
        """Load the model now, in the background: a dictation is starting."""
        def load():
            with self.lock:
                self.start()
                self.used = time.time()
        threading.Thread(target=load, daemon=True).start()

    def write_down(self, pcm):
        """What a piece of audio says, or raises OSError with why not."""
        with self.lock:
            why = self.start()
            if why:
                raise OSError(why)
            try:
                self.proc.stdin.write(len(pcm).to_bytes(4, "little") + pcm)
                self.proc.stdin.flush()
            except OSError:
                self.stop()
                raise OSError("the dictation worker stopped")
            d = self.line(self.proc, DICTATE_PIECE_TIME)
            self.used = time.time()
            if d is None:       # hung or gone: the next piece starts it anew
                self.stop()
                raise OSError("writing it down took too long")
            if d.get("error"):
                raise OSError(d["error"])
            return d.get("text") or ""

    def reap(self):
        while True:
            time.sleep(15)
            gone = not dictate_model_path().is_file()       # amarchy dictation remove
            if self.proc and (gone or time.time() - self.used > DICTATE_KEEP) and self.lock.acquire(blocking=False):
                try:
                    self.stop()
                finally:
                    self.lock.release()


def frame_rms(frame):
    import array
    a = array.array("h")
    a.frombytes(frame)
    return (sum(x * x for x in a) / max(1, len(a))) ** 0.5


class Dictation:
    """One dictation: the audio as it comes, written down twice over. Short
    pieces, cut at every pause, show the words as you talk (heard(text) gets
    everything so far, each time there's more); what's kept is written from
    long stretches (20 to 30 s, cut at a pause, or at a longer pause after
    3 s, where a new language may start) with their context, as accurate as
    all of it at once: each long one written while
    the next is said, so letting go leaves at most one to do. heard None:
    no pieces, only what's kept."""

    def __init__(self, transcriber, heard):
        self.tr, self.heard = transcriber, heard
        self.audio, self.frames = bytearray(), 0
        self.voiced = []            # per frame: sound or silence
        self.levels = []            # the last 3 seconds' loudness, for the room's own noise
        self.piece, self.stretch = 0, 0     # where the piece and the long stretch under way start (frames)
        self.quiet = 0              # frames of silence at the end, so far
        self.kept = []              # (start, end, text) of the long stretches written down
        self.shown = {}             # start -> text of the pieces written down
        self.jobs, self.busy, self.errors = [], 0, []
        self.cond = threading.Condition()
        self.closed = False
        self.loud = False           # heard anything at all
        self.pieces = 0
        threading.Thread(target=self.work, daemon=True).start()

    def add(self, data):
        self.audio += data
        while (self.frames + 1) * DICTATE_FRAME <= len(self.audio):
            level = frame_rms(self.audio[self.frames * DICTATE_FRAME:(self.frames + 1) * DICTATE_FRAME])
            self.levels = (self.levels + [level])[-150:]
            floor = sorted(self.levels)[len(self.levels) // 10]
            loud = level > max(DICTATE_LOUD, floor * 2.5)
            self.loud = self.loud or loud
            self.voiced.append(loud)
            self.frames += 1
            self.quiet = 0 if loud else self.quiet + 1
            pause = self.quiet
            if (self.frames - self.stretch >= DICTATE_STRETCH and pause >= DICTATE_PAUSE
                    or self.frames - pause - self.stretch >= DICTATE_SHORTEST * 2 and pause >= DICTATE_BREAK):
                self.job("stretch", self.stretch, self.frames - pause // 2)
            elif self.frames - self.stretch >= DICTATE_STRETCH_MOST:
                # No pause for a long while: at the quietest moment of the last 3 s.
                lv = self.levels
                self.job("stretch", self.stretch, self.frames - len(lv) + lv.index(min(lv)) + 1)
            elif self.heard and pause >= DICTATE_PAUSE and self.frames - pause - self.piece >= DICTATE_SHORTEST:
                self.job("piece", self.piece, self.frames - pause + 10)        # keeping 0.2 s of the pause
            elif self.heard and self.frames - self.piece >= DICTATE_PIECE_MOST:
                # Talking on without a pause: the words so far all the same, cut at the
                # quietest moment of the last second (what's kept is written anew anyway).
                lv = self.levels[-50:]
                self.job("piece", self.piece, self.frames - len(lv) + lv.index(min(lv)) + 1)

    def job(self, kind, start, end):
        """Write audio from frame start to end down (if there's sound in it)."""
        end = max(start, min(end, self.frames))
        if kind == "stretch":
            self.stretch = self.piece = end
        else:
            self.piece = end
        if sum(self.voiced[start:end]) < DICTATE_WORDS:
            return
        audio = bytes(self.audio[start * DICTATE_FRAME:end * DICTATE_FRAME])
        with self.cond:
            if kind == "stretch":       # first: they're what's kept
                self.jobs.insert(sum(1 for j in self.jobs if j[0] == "stretch"), (kind, start, end, audio))
            else:
                self.pieces += 1
                self.jobs.append((kind, start, end, audio))
            self.cond.notify_all()

    def words(self):
        """All of it so far: the long stretches kept, then the pieces after them."""
        kept = sorted(self.kept)
        after = kept[-1][1] if kept else 0
        return " ".join([k[2] for k in kept] + [w for s, w in sorted(self.shown.items()) if s >= after and w])

    def work(self):
        while True:
            with self.cond:
                self.cond.wait_for(lambda: self.jobs or self.closed)
                if not self.jobs:
                    return
                kind, start, end, audio = self.jobs.pop(0)
                self.busy += 1
            try:
                text = self.tr.write_down(audio)
            except OSError as e:
                text = None
                self.errors.append(str(e))
            with self.cond:
                self.busy -= 1
                if text is not None:
                    if kind == "stretch":
                        self.kept.append((start, end, text))
                    else:
                        self.shown[start] = text
                words = None if self.closed else self.words()
                self.cond.notify_all()
            if words:
                try:
                    self.heard(words)
                except OSError:
                    pass

    def finish(self, timeout=120):
        """No more audio: the rest written down, and all of it. Raises
        OSError when nothing came of it because writing it down failed."""
        with self.cond:
            self.jobs = [j for j in self.jobs if j[0] == "stretch"]     # the pieces aren't needed now
        self.job("stretch", self.stretch, self.frames)
        with self.cond:
            self.closed = True      # after the last job is in: the worker stops once they're done
            self.cond.notify_all()
            self.cond.wait_for(lambda: not self.jobs and not self.busy, timeout=timeout)
            text = " ".join(k[2] for k in sorted(self.kept) if k[2])
        if not text and self.errors:
            raise OSError(self.errors[-1])
        return text

    def drop(self):
        with self.cond:
            self.jobs.clear()
            self.closed = True
            self.cond.notify_all()


def dictate_log(entry):
    """A dictation, how it went, at the end of DICTATE_LOG (its last
    DICTATE_LOG_KEEP lines kept)."""
    try:
        DICTATE.mkdir(parents=True, exist_ok=True)
        lines = DICTATE_LOG.read_text().splitlines() if DICTATE_LOG.exists() else []
        lines = (lines + [json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **entry}, ensure_ascii=False)])
        write_file(DICTATE_LOG, "\n".join(lines[-DICTATE_LOG_KEEP:]) + "\n")
    except OSError:
        pass


# Which kind of machine is asked first to write another's dictations down:
# one that's always on.
DICTATE_HELPER_FIRST = ("server", "cloud", "desktop", "laptop")


def dictate_helper(st=None, name=None):
    """Another machine of yours that writes this one's dictations down when
    this one can't (no model here): a paired one that's on, has its own
    model, and speaks this protocol; a server first (it's always on), then
    as paired. name: that machine or none. Its machines.json row with its
    label and engine, or None. The app's server knows how each stands
    (st.peers); without it (the CLI), each is asked."""
    ms = [m for m in machines_read() if name in (None, m["name"])]
    if not ms:
        return None
    hellos = {}
    if st is not None:          # (never a request of its own: the app's server follows each machine)
        for n, p_ in (st.peers.snapshot() if getattr(st, "peers", None) else {}).items():
            if p_.get("on") and not p_.get("update"):
                hellos[n] = p_.get("hello") or {}
    else:
        def ask(m):
            try:
                code, h = peer_json(m, "GET", "/api/peer/hello", timeout=4)
            except PeerError:
                return
            if code == 200 and isinstance(h, dict) and h.get("protocol") == PROTOCOL:
                hellos[m["name"]] = h
        ts = [threading.Thread(target=ask, args=(m,), daemon=True) for m in ms]
        for t_ in ts:
            t_.start()
        for t_ in ts:
            t_.join(6)
    ready = [(m, h) for m in ms if isinstance((h := hellos.get(m["name"]) or {}).get("dictation"), dict)
             and h["dictation"].get("ready")]
    if not ready:
        return None
    ready.sort(key=lambda mh: DICTATE_HELPER_FIRST.index(mh[1].get("kind")) if mh[1].get("kind") in DICTATE_HELPER_FIRST
               else len(DICTATE_HELPER_FIRST))
    m, h = ready[0]
    return {**m, "label": str(h.get("label") or m["label"])[:LABEL_MAX],
            "engine": str(h["dictation"].get("engine") or DICTATE_MODEL["name"])[:80]}


def dictate_via(helper):
    """What the app is told of the machine that writes dictations down for this one."""
    return {"name": helper["name"], "label": helper["label"], "engine": helper["engine"]} if helper else None


def dictate_view(st, status):
    """Dictation as the app's board has it: this machine's (dictate_status),
    and, when it can't, the machine that writes them down for it (via)."""
    helper = None if status.get("ready") else dictate_helper(st)
    return {**status, "via": dictate_via(helper)}


def ws_frame(data, op=2):
    """A WebSocket frame from a client (masked, as a client's must be)."""
    mask, n = os.urandom(4), len(data)
    size = (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + n.to_bytes(2, "big") if n < 1 << 16
            else bytes([0x80 | 127]) + n.to_bytes(8, "big"))
    key = (mask * (n // 4 + 1))[:n]
    return bytes([0x80 | op]) + size + mask + (int.from_bytes(data, "big") ^ int.from_bytes(key, "big")).to_bytes(n, "big")


def dictate_remote(m, pcm, heard=None, timeout=300):
    """A recording (16 kHz 16-bit mono) written down on machine m, through
    its /api/dictate as the app's mic sends it: the text. Raises OSError
    with why not."""
    key = base64.b64encode(os.urandom(16)).decode()
    try:
        sock, code, head, early = peer_ws_open(m, "/api/dictate", key)
    except PeerError as e:
        raise OSError(str(e)) from None
    except OSError as e:
        raise OSError(f"{m['label']} is off: {peer_why(e)}") from None
    if code != 101:
        said = peer_ws_refusal(sock, head, early)
        raise OSError(said.get("error") or f"{m['label']} said no ({code})")
    buf, end = early, time.time() + timeout
    try:
        sock.settimeout(30)
        for i in range(0, len(pcm), 6400):      # 0.2 s at a time
            sock.sendall(ws_frame(pcm[i:i + 6400]))
        sock.sendall(ws_frame(b"end", op=1))
        while time.time() < end:
            while len(buf) >= 2:
                n, at = buf[1] & 0x7F, 2
                if n == 126:
                    n, at = (int.from_bytes(buf[2:4], "big"), 4) if len(buf) >= 4 else (None, 0)
                elif n == 127:
                    n, at = (int.from_bytes(buf[2:10], "big"), 10) if len(buf) >= 10 else (None, 0)
                if n is None or len(buf) < at + n:
                    break
                op, data, buf = buf[0] & 0x0F, buf[at:at + n], buf[at + n:]
                if op == 8:
                    raise OSError(f"{m['label']} hung up before it said what it heard")
                if op != 1:
                    continue
                try:
                    d = json.loads(data)
                except ValueError:
                    continue
                if not isinstance(d, dict):
                    continue
                if d.get("error"):
                    raise OSError(str(d["error"]))
                if isinstance(d.get("text"), str):
                    return d["text"]
                if heard and isinstance(d.get("interim"), str):
                    heard(d["interim"])
            sock.settimeout(max(1.0, end - time.time()))     # (writing it all down may take a while there)
            chunk = sock.recv(65536)
            if not chunk:
                raise OSError(f"{m['label']} hung up before it said what it heard")
            buf += chunk
        raise OSError(f"{m['label']} took too long")
    except socket.timeout:
        raise OSError(f"{m['label']} took too long") from None
    finally:
        sock.close()


def device_name(ua, standalone=False):
    """The device and browser a User-Agent is, in a few words."""
    ua = ua or ""
    dev = ("iPhone" if "iPhone" in ua else "iPad" if "iPad" in ua else "Android" if "Android" in ua
           else "Mac" if "Macintosh" in ua else "Windows" if "Windows" in ua else "Linux" if "Linux" in ua else "?")
    app = ("desktop app" if " Amarchy/" in ua       # (amarchy's own: desktop/src/platform.rs)
           else "Chrome" if re.search(r"Chrome/|CriOS/", ua) and "Edg" not in ua else "Edge" if "Edg" in ua
           else "Firefox" if re.search(r"Firefox/|FxiOS/", ua) else "Safari" if "Safari/" in ua or "AppleWebKit" in ua
           else "?")
    return f"{dev} {'home-screen app' if standalone else app}"


def cmd_dictation(args):
    """amarchy dictation [--status] | setup [--in-background] | remove | log [--json] | transcribe [--on <m>] <file> | worker"""
    what = args[0] if args and not args[0].startswith("--") else ""
    if what == "worker":
        return dictate_worker()
    if what == "setup":
        opts = set(args[1:])
        if opts - {"--engine", "--in-background", "--quiet"}:
            print(usage("dictation"), file=sys.stderr)
            return 1
        engine, later, quiet = "--engine" in opts, "--in-background" in opts, "--quiet" in opts
        st_ = dictate_status()
        if not st_["auto"]:
            if engine:          # (an install: nothing to fetch for this processor)
                return 0
            return fail(f"dictation can't be set up here by itself: {st_['how']}")
        fetch = [(w, n) for w, n in dictate_fetching()
                 if not engine or w != DICTATE_MODEL["name"] or dictate_before()]
        if not fetch:
            if not quiet:
                print(f"Dictation is set up: {DICTATE_MODEL['name']}, in {dictate_model_path()}." if st_["ready"] else
                      f"{DICTATE_ENGINE['name']} {DICTATE_ENGINE['version']} is here; the speech model comes "
                      f"the first time you dictate (or amarchy dictation setup).")
            return 0
        what_ = " and ".join(w for w, _ in fetch)
        mb = mb_of(sum(n for _, n in fetch))
        if later:
            if st_["setup"] and not st_["setup"].get("error"):
                return 0        # one under way already
            if not dictate_kick(engine=engine):
                return fail("couldn't start it in the background")
            if not quiet:
                print(f"Fetching {what_} ({mb} MB) in the background (amarchy dictation shows how far).")
            return 0
        if not quiet:
            print(f"Fetching {what_} ({mb} MB) into {DICTATE}…", file=sys.stderr)
        why = dictate_setup(quiet=quiet, engine=engine)
        if why:
            return fail(f"dictation isn't set up: {why}")
        if not quiet:
            print("Dictation is set up: hold the mic in the app and speak (English, Spanish and 23 more)."
                  if dictate_ready() else f"{DICTATE_ENGINE['name']} {DICTATE_ENGINE['version']} is here; the speech "
                  f"model comes the first time you dictate (or amarchy dictation setup).")
        return 0
    if what == "remove":
        if DICTATE_SETUP.exists():
            try:
                pid = json.loads(DICTATE_SETUP.read_text()).get("pid")
                if pid and pid_alive(pid) and pid != os.getpid():
                    os.kill(int(pid), signal.SIGTERM)       # a setup under way: it stops first
            except (OSError, ValueError, AttributeError):
                pass
        for name in (DICTATE_MODEL["file"], DICTATE_MODEL["file"] + ".part", DICTATE_SETUP.name, "setup.lock",
                     f"transcribe.cpp-{DICTATE_ENGINE['version']}.tar.gz.part", "transcribe.cpp.new",
                     DICTATE_ENGINE_DIR.name, *DICTATE_BEFORE):
            f = DICTATE / name
            shutil.rmtree(f, ignore_errors=True) if f.is_dir() else f.unlink(missing_ok=True)
        _dictate_lib["at"] = 0
        kept = f" ({DICTATE_ENGINE['name']} stays: it came with the package)" if dictate_lib() else ""
        print(f"Removed the dictation model and its engine{kept}: amarchy dictation setup fetches them again.")
        return 0
    if what == "log":
        try:
            lines = DICTATE_LOG.read_text().splitlines()
        except OSError:
            lines = []
        entries = []
        for line in lines:
            try:
                entries.append(json.loads(line))
            except ValueError:
                pass
        if "--json" in args:
            print(json.dumps(entries, indent=2, ensure_ascii=False))
            return 0
        if not entries:
            print("No dictations yet.")
        for e in entries:
            took = f"{e['wait_ms'] / 1000:.1f}s after letting go" if isinstance(e.get("wait_ms"), (int, float)) else ""
            said = f"{e['said_s']:.0f}s said" if isinstance(e.get("said_s"), (int, float)) else ""
            whose = f"for {e['for']}" if e.get("for") else f"sent to {e['sent_to']}" if e.get("sent_to") else ""
            head = " · ".join(x for x in (e.get("at", "")[:16].replace("T", " "), e.get("engine", ""), whose,
                                          e.get("device", ""), e.get("lang", ""), said, took) if x)
            print(f"{head}\n  {e['error'] if e.get('error') else e.get('text', '')}")
        helper = None if dictate_status()["ready"] else dictate_helper()
        if helper:
            print(f"(What {helper['label']} writes down for this machine is in its own log: amarchy dictation log, there.)")
        return 0
    if what == "transcribe":
        rest, on = list(args[1:]), None
        if "--on" in rest:
            i = rest.index("--on")
            on = rest[i + 1] if i + 1 < len(rest) else ""
            del rest[i:i + 2]
        if len(rest) != 1 or on == "":
            print(usage("dictation"), file=sys.stderr)
            return 1
        helper = None
        if on and on != machine_name():
            helper = dictate_helper(name=on)
            if not helper:
                known = machine_find(on)
                return fail(f"{known['label'] if known else on} can't write it down: "
                            f"{'it is off, or has no speech model' if known else 'no such machine is paired'}")
        elif not on and not dictate_status()["ready"]:
            helper = dictate_helper()
            if not helper:
                return fail(f"dictation isn't set up: {dictate_how()}")
        elif not dictate_status()["ready"]:
            return fail(f"dictation isn't set up here: {dictate_how()}")
        r = subprocess.run(["ffmpeg", "-loglevel", "error", "-i", rest[0], "-f", "s16le", "-ac", "1",
                            "-ar", str(DICTATE_RATE), "-"], capture_output=True)
        if r.returncode != 0:
            return fail(r.stderr.decode(errors="replace").strip() or "ffmpeg couldn't read it")
        started = time.time()
        if helper:
            try:
                text = dictate_remote(helper, r.stdout)
            except OSError as e:
                return fail(f"{helper['label']} didn't write it down: {e}")
            print(text)
            print(f"({len(r.stdout) / 2 / DICTATE_RATE:.1f} s of audio, written down on {helper['label']} "
                  f"in {time.time() - started:.1f} s)", file=sys.stderr)
            return 0
        tr = Transcriber()
        d = Dictation(tr, None)        # no words as they come: only what's kept
        for i in range(0, len(r.stdout), DICTATE_FRAME):
            d.add(r.stdout[i:i + DICTATE_FRAME])
        try:
            text = d.finish()
        except OSError as e:
            return fail(str(e))
        finally:
            tr.stop()
        print(text)
        print(f"({len(r.stdout) / 2 / DICTATE_RATE:.1f} s of audio, "
              f"{time.time() - started:.1f} s with loading the model)", file=sys.stderr)
        return 0
    if what:
        print(usage("dictation"), file=sys.stderr)
        return 1
    st_ = dictate_status()
    if st_["ready"]:
        print(f"Dictation is set up: {st_['engine']}, on this machine (the app's mic button), through "
              f"{DICTATE_ENGINE['name']} {DICTATE_ENGINE['version']}.")
        return 0
    setup = st_["setup"]
    if setup and not setup.get("error"):
        if setup.get("checking"):
            print(f"Setting dictation up: checking {DICTATE_ENGINE['name']} (then {st_['engine']}).")
        else:
            print(f"Fetching dictation's engine and model: {setup.get('done', 0) // 1_000_000} of "
                  f"{st_['size'] // 1_000_000} MB.")
        return 0
    helper = dictate_helper()
    why = f" ({setup['error']})" if setup else ""
    if helper:
        print(f"Dictation works through {helper['label']}: this machine has no speech model{why}, so the app's mic "
              f"sends what you say to {helper['label']}, which writes it down ({helper['engine']}).")
        print(f"To write it down on this machine itself: {st_['how']}.")
        return 0
    print(f"Dictation isn't set up{why}: {st_['how']}.")
    print("Until it is, the app's mic works only in a browser with speech recognition of its own (Chrome, Safari), "
          "not in the desktop app; or pair a machine of yours that has the model (amarchy machines add), "
          "and it writes it down for this one.")
    return 0


# ---- sharing into amarchy: a screenshot from the phone's share sheet, to a chat
#
# What you share waits here (SHARE) until a chat takes it: the app shows it
# on every screen ("Send it to a chat", app.js's shareSheet), where you send
# it to a chat as it is, or open a chat with it in the box to say more. It
# comes in at POST /api/share (Handler.share_in):
#
# - from an iPhone, through a Shortcut in its share sheet ("Amarchy"): a web
#   app can't be in an iPhone's share sheet itself (WebKit has no Web Share
#   Target). The Shortcut posts the picture as it is, at an address with the
#   share key in it (Settings shows it): a Shortcut sends no Origin, and the
#   key is what says it's yours and not a page elsewhere;
# - from Android's share sheet, the installed app's own (the manifest's
#   share_target): a form, from the app's own origin.
#
# Pictures shared moments apart are one share (a Shortcut posts several one
# by one); one nobody takes goes after a day.

SHARE = STATE / "share"             # meta.json and the pictures (0.png, 1.jpg...)
SHARE_KEY = APP / "share-key"       # in the Shortcut's address
SHARE_MAX = 20                      # pictures in one share (what one message takes)
SHARE_BODY_MAX = 60_000_000         # bytes of one POST /api/share
SHARE_JOIN = 90                     # seconds: what's shared within this of the last share joins it
SHARE_KEEP = 24 * 3600              # seconds a share nobody took waits
SHARE_LOCK = threading.Lock()


def share_key():
    """The key in the Shortcut's address (made the first time it's asked for)."""
    try:
        key = SHARE_KEY.read_text().strip()
    except OSError:
        key = ""
    if len(key) < 20:
        key = base64.urlsafe_b64encode(os.urandom(18)).decode()
        write_file(SHARE_KEY, key + "\n")
        os.chmod(SHARE_KEY, 0o600)
    return key


def share_type(data):
    """A picture's type and file extension, read off its first bytes, or None."""
    for magic, kind, ext in ((b"\x89PNG\r\n\x1a\n", "image/png", "png"), (b"\xff\xd8\xff", "image/jpeg", "jpg"),
                             (b"GIF87a", "image/gif", "gif"), (b"GIF89a", "image/gif", "gif")):
        if data.startswith(magic):
            return kind, ext
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "image/webp", "webp"
    if data[4:8] == b"ftyp" and data[8:12] in (b"heic", b"heix", b"heim", b"heis", b"hevc", b"mif1", b"msf1"):
        return "image/heic", "heic"     # a photo from an iPhone's library: the phone's browser reads it
    return None


def share_meta():
    try:
        meta = json.loads((SHARE / "meta.json").read_text())
    except (OSError, ValueError):
        return None
    ok = isinstance(meta, dict) and isinstance(meta.get("id"), str) and isinstance(meta.get("files"), list)
    return meta if ok else None


def share_state():
    """What's shared and no chat took yet, for the app: {id, pictures, text,
    at}, or None. One older than SHARE_KEEP goes now."""
    meta = share_meta()
    if not meta:
        return None
    if time.time() - (meta.get("last") or 0) > SHARE_KEEP:
        share_clear(meta["id"])
        return None
    return {"id": meta["id"], "pictures": len(meta["files"]), "text": str(meta.get("text") or ""), "at": meta.get("at")}


def share_add(images, text=""):
    """What was shared (images: [bytes], text) to what waits for a chat: with
    the share before it if that came moments ago, else as a new one. An
    error in words, or None."""
    kinds = [share_type(d) for d in images]
    if any(k is None for k in kinds):
        return "only pictures (PNG, JPEG, GIF, WebP or HEIC)"
    text = text.strip()
    if not images and not text:
        return "nothing came: share a picture or some text"
    with SHARE_LOCK:
        now, meta = time.time(), share_meta()
        if not meta or now - (meta.get("last") or 0) > SHARE_JOIN:
            shutil.rmtree(SHARE, ignore_errors=True)
            meta = {"id": os.urandom(6).hex(), "at": now, "files": [], "text": ""}
        if len(meta["files"]) + len(images) > SHARE_MAX:
            return f"{SHARE_MAX} pictures at most at once"
        for data, (kind, ext) in zip(images, kinds):
            name = f"{len(meta['files'])}.{ext}"
            write_file(SHARE / name, data)
            meta["files"].append({"name": name, "type": kind})
        if text and text not in meta["text"]:
            meta["text"] = f"{meta['text']}\n\n{text}".strip()
        meta["last"] = now
        write_file(SHARE / "meta.json", json.dumps(meta))
    return None


def share_picture(n, sid=None):
    """The nth picture of the share (sid: that share's, not one after it):
    (type, bytes), or None."""
    meta = share_meta()
    if not meta or sid and meta["id"] != sid or not 0 <= n < len(meta["files"]):
        return None
    f = meta["files"][n]
    try:
        return f["type"], (SHARE / Path(f["name"]).name).read_bytes()
    except (OSError, KeyError, TypeError):
        return None


def share_clear(sid):
    """A chat took the share (or you let it go): it goes, unless another came since."""
    with SHARE_LOCK:
        meta = share_meta()
        if meta and meta["id"] == sid:
            shutil.rmtree(SHARE, ignore_errors=True)


def share_parse(ctype, body):
    """What a POST /api/share brings: ([picture bytes], text). A form's
    (Android's share sheet: files, title, text, url), or the body as it is: a
    picture (the Shortcut's), or text."""
    images, words = [], []
    if ctype.lower().startswith("multipart/form-data"):
        from email.parser import BytesParser
        from email.policy import HTTP
        msg = BytesParser(policy=HTTP).parsebytes(b"Content-Type: " + ctype.encode("latin-1") + b"\r\n\r\n" + body)
        for part in msg.iter_parts() if msg.is_multipart() else []:
            data = part.get_payload(decode=True) or b""
            if part.get_filename() is not None or share_type(data):
                if data:        # (an empty file field: nothing picked)
                    images.append(data)
            elif part.get_param("name", header="content-disposition") in ("title", "text", "url"):
                words.append(data.decode("utf-8", "replace").strip())
    elif ctype.lower().startswith("text/") and not share_type(body):
        words.append(body.decode("utf-8", "replace").strip())
    elif body:
        images.append(body)     # not a picture: share_add says so
    return images, "\n".join(w for w in words if w)


# ---- the app in a browser on your computer (its wide layout, desk.js)
#
# On a wide screen the app is the list, and beside it the session's real
# terminals, Claude's and the one it runs the project in. Each is xterm.js in
# the page, on a WebSocket to the app's server (Handler.tty), which runs
# `amarchy attach` on a pty of its own: a tmux client of the session's tmux,
# so the phone and every browser show the same session at once.
#
# One thing a server doesn't have comes from the browser instead: a pasted
# image. The page hands the app what was pasted in it (the web clipboard, see
# "clipboard") before it sends Ctrl+V, and Claude's wl-paste (amarchy paste)
# reads it there.


CLIP_MAX = 25_000_000                           # bytes of one pasted image or text (as base64 in its JSON)
CLIP_TYPES = re.compile(r"image/(png|jpeg|gif|webp)")
PICTURE_TYPES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}     # a picture's file, by its name
TTY_PING = 25                                   # seconds between pings on a terminal's WebSocket


def peer_uid(sock):
    """Who's at the other end of a connection to the app's server on
    localhost: the uid owning that socket, or None. The kernel's asked for
    that one socket (sock_diag_uid); /proc/net/tcp, every socket there is
    (a few ms on each request), if it can't say."""
    try:
        return sock_diag_uid(sock)
    except (OSError, ValueError, struct.error):
        pass
    try:
        port = sock.getpeername()[1]
        mine = sock.getsockname()[1]
        for table in ("/proc/net/tcp", "/proc/net/tcp6"):
            try:
                lines = Path(table).read_text().splitlines()[1:]
            except OSError:
                continue
            for line in lines:
                f = line.split()
                if int(f[1].rsplit(":", 1)[1], 16) == port and int(f[2].rsplit(":", 1)[1], 16) == mine:
                    return int(f[7])
    except (OSError, ValueError, IndexError):
        pass
    return None


def sock_diag_uid(sock):
    """The uid owning the other end of a TCP connection on this machine, as
    the kernel's sock_diag says (netlink: one inet_diag_req_v2 for the peer's
    socket, by its addresses and ports). Raises ValueError if it doesn't say."""
    peer, mine = sock.getpeername(), sock.getsockname()
    family = sock.family
    if family == socket.AF_INET6 and peer[0].startswith("::ffff:") and mine[0].startswith("::ffff:"):
        family, peer, mine = socket.AF_INET, (peer[0][7:], peer[1]), (mine[0][7:], mine[1])     # IPv4, mapped

    def address(a):
        b = socket.inet_pton(family, a)
        return b + bytes(16 - len(b))
    # The peer's socket: its port and address first (big-endian ports), any state, no cookie.
    request = struct.pack("=BBBBI", family, socket.IPPROTO_TCP, 0, 0, 0xffffffff) + \
        struct.pack("!HH", peer[1], mine[1]) + address(peer[0]) + address(mine[0]) + \
        struct.pack("=III", 0, 0xffffffff, 0xffffffff)
    SOCK_DIAG_BY_FAMILY, NLM_F_REQUEST, NETLINK_SOCK_DIAG = 20, 1, 4
    with socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_SOCK_DIAG) as nl:
        nl.settimeout(0.5)
        nl.send(struct.pack("=IHHII", 16 + len(request), SOCK_DIAG_BY_FAMILY, NLM_F_REQUEST, 1, 0) + request)
        answer = nl.recv(65536)
    length, kind = struct.unpack_from("=IH", answer)
    # An inet_diag_msg: family, state, timer, retrans, its id (48 bytes), expires, rqueue, wqueue, uid.
    if kind != SOCK_DIAG_BY_FAMILY or length < 16 + 72 or struct.unpack_from("!HH", answer, 20) != (peer[1], mine[1]):
        raise ValueError("sock_diag didn't say")
    return struct.unpack_from("=I", answer, 16 + 64)[0]


def tailscale_uids():
    """Whom the app takes connections from: tailscaled (tailscale serve
    is it), which runs as root, or as whoever runs it; and you."""
    uids = {0, os.getuid()}
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                if (d / "comm").read_text().strip() == "tailscaled":
                    uids.add(d.stat().st_uid)
            except OSError:
                pass
    return uids


def app_commands(s):
    """The project's saved commands, the run command first (as amarchy run --list)."""
    saved = {RUN_DEFAULT: run_command(s), **saved_commands(s["repo"])}
    return [{"name": k, "command": v} for k, v in saved.items() if v]


APP_SOUNDS = APP / "sounds"         # the sounds a browser can't play as they are (Ogg), as WAV
APP_SOUND_TYPES = {".wav": "audio/wav", ".mp3": "audio/mpeg", ".flac": "audio/flac"}
APP_SOUND_MAX = 5_000_000           # bytes of a sound of yours added from the app


def app_sound_file(name):
    """A sound as a browser plays it (Safari has no Ogg): (file, type), the
    Ogg ones made WAV once (kept by their hash), or None."""
    # The mission fanfare (Today's Complete): amarchy's own, not a chime to pick.
    f = SOUNDS / "mission.wav" if name == "mission" else sound_file(name) if name != "off" else None
    if not f or not f.is_file():
        return None
    kind = APP_SOUND_TYPES.get(f.suffix.lower())
    if kind:
        return f, kind
    try:
        sig = hashlib.sha1(f.read_bytes()).hexdigest()[:16]
    except OSError:
        return None
    out = APP_SOUNDS / f"{sig}.wav"
    if not out.is_file():
        APP_SOUNDS.mkdir(parents=True, exist_ok=True)
        tmp = out.with_name(f".{out.name}.{os.getpid()}.{threading.get_ident()}")
        for argv in (["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", str(f), "-f", "wav", str(tmp)],
                     ["sox", str(f), "-t", "wav", str(tmp)]):
            if not shutil.which(argv[0]):
                continue
            try:
                if subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, timeout=30).returncode == 0:
                    os.replace(tmp, out)
                    break
            except (OSError, subprocess.TimeoutExpired):
                pass
        tmp.unlink(missing_ok=True)
    return (out, "audio/wav") if out.is_file() else None


def app_sounds():
    """Every sound to pick from in the app, and those picked: the chats',
    your assistant's, and each agent's (agent_sounds, {id: name})."""
    return {"sounds": [{"name": name, "label": sound_label(name), "mine": name not in CHIMES} for name in sounds()],
            "sound": sound_name(), "assistant_sound": assistant_sound_name(),
            "agent_sounds": {a["id"]: a["sound"] for a in agents()}}


def app_add_sound(name, raw):
    """A sound of yours, from the app, into ~/.config/amarchy/sounds (as
    amarchy sound --add has you put it): its name, or (None, why not)."""
    name = re.sub(r"[^\w .()-]", "", name).strip(" .")[:60]
    ext = Path(name).suffix.lower()
    stem = Path(name).stem.strip() if ext in AUDIO else ""
    if not stem:
        return None, "a sound file: WAV, Ogg, Opus, FLAC or MP3"
    if not raw or len(raw) > APP_SOUND_MAX:
        return None, "a sound of 5 MB at most"
    USER_SOUNDS.mkdir(parents=True, exist_ok=True)
    for old in USER_SOUNDS.glob("*"):       # one file per name: a new one replaces it
        if old.stem.lower() == stem.lower() and old.suffix.lower() in AUDIO:
            old.unlink(missing_ok=True)
    write_file(USER_SOUNDS / f"{stem}{ext}", raw)
    return sound_key(stem), ""


# ---- the server

APP_BUILD_MEMO = {"seen": None, "build": None}

def gzip_bytes(data):
    """data gzipped (as a browser takes it: Content-Encoding: gzip)."""
    z = zlib.compressobj(6, zlib.DEFLATED, 31)
    return z.compress(data) + z.flush()


APP_FILES = {}      # an app file's path -> (its stat, its bytes, gzipped)


def app_file(f, script=None):
    """An app file's bytes and the same gzipped, read and squeezed once for
    as long as it doesn't change (every page asks for them all). script: a
    JSON file, as a script that names it (const <script> = ...;)."""
    st = f.stat()
    sig = (st.st_mtime_ns, st.st_size)
    key = f"{f}|{script or ''}"
    kept = APP_FILES.get(key)
    if kept and kept[0] == sig:
        return kept[1], kept[2]
    data = f.read_bytes()
    if script:
        data = f"const {script} = ".encode() + data.strip() + b";\n"
    APP_FILES[key] = (sig, data, gzip_bytes(data))
    return data, APP_FILES[key][2]


def app_build():
    """The app's build: a hash of its files as they are on disk now, so an
    open page that loaded others reloads once they differ (app.js). It's read
    again only when a file's stat changed: the list asks every second."""
    seen = []
    for f in sorted(APP_PAGES.rglob("*")):
        try:
            if f.is_file():
                st = f.stat()
                seen.append((f.relative_to(APP_PAGES).as_posix(), st.st_mtime_ns, st.st_size))
        except OSError:
            pass
    if seen == APP_BUILD_MEMO["seen"]:
        return APP_BUILD_MEMO["build"]
    h = hashlib.sha1()
    for name, _, _ in seen:
        h.update(name.encode() + b"\0")
        try:
            h.update((APP_PAGES / name).read_bytes())
        except OSError:
            pass
    build = h.hexdigest()[:12]
    APP_BUILD_MEMO.update(seen=seen, build=build)
    return build


class AppState:
    """What every connection shares: the list as last read, the moments it
    changed, and which sessions you're looking at on the phone."""

    def __init__(self):
        self.changed = threading.Condition()
        self.view, self.version, self.statuses = {}, 0, None
        self.asked = {}         # session id -> the request it last told the phones about (chat engine)
        self.waiting_since = {}     # session id -> since when it waits on you (app_missions: how fast you answered)
        self.nudged_at = 0          # when app_missions last looked at the reminder and the recap
        self.missions_seen = False  # app_missions has seen the list once
        self.seen = {}          # session id -> when the phone last said it's on screen
        self.projects_stale = threading.Event()     # a project was added: the list of projects is read again now
        self.poke = threading.Event()   # something was done from a page: the list read again now, not in a second
        self.lock = threading.Lock()
        # Which sessions are open on a device (a phone's conversation, a
        # browser's terminals: id -> how many), and when each last was, for
        # the sleep timer (on_screen). What the last server knew of when stays.
        self.open, self.viewed, self.viewing_lock = {}, on_screen()[1], threading.Lock()
        self.save_viewing()
        # Every machine's chats (see "machines"): the paired ones followed
        # (app_serve starts them), and this one's own list's changes counted
        # apart (own_version: what the other machines follow).
        self.peers, self.own_version, self.board = None, 0, None

    def bump(self):
        """The board changed (another machine's chats): every list stream again."""
        with self.changed:
            self.version += 1
            self.changed.notify_all()

    def row(self, sid):
        return next((s for s in self.view.get("sessions", []) if s["id"] == sid), None)

    def looking(self, sid, on=None):
        """A device opened a session (on), left it (off), or says it's still
        looking at it (None)."""
        with self.viewing_lock:
            if on is not None:
                n = self.open.get(sid, 0) + (1 if on else -1)
                if n > 0:
                    self.open[sid] = n
                else:
                    self.open.pop(sid, None)
            self.viewed[sid] = time.time()
            self.save_viewing()

    def save_viewing(self):
        live = {s.get("id") for s in sessions()}
        self.viewed = {k: v for k, v in self.viewed.items() if k in live}
        try:
            write_file(APP_VIEWING, json.dumps({"pid": os.getpid(), "open": sorted(self.open), "at": self.viewed}))
        except OSError as e:
            print(f"amarchy app: couldn't write {APP_VIEWING}: {e}", file=sys.stderr)


def app_watch(st):
    """Read the list every second, and at once when a page did something
    (st.poke: what you did is on every screen in a moment, not a second); on
    a change wake the streams, and tell the phones about a session that went
    on to need you or be done."""
    ps, projects_at = [], 0
    while True:
        began = time.time()
        try:
            if st.projects_stale.is_set() or time.time() - projects_at > 10:     # a project added: now, not in ten seconds
                st.projects_stale.clear()
                ps = [{"name": p["name"], "sessions": p.get("sessions", 0), "github": project_github(p["name"])}
                      for p in projects(remotes=False)]
                projects_at = time.time()
            ps = ordered_projects(ps)     # in your order, now: you may just have moved one
            ss = session_view()
            awake_want(ss)      # idle sleep held off while a chat here works (see "keep-awake")
            app_words(st, ss)
            look = look_worn()
            # One finished while it was on your phone's screen: you've seen it.
            # So are the messages your assistant or an agent writes while it's
            # there: none unread.
            for s in ss:
                looked = time.time() - st.seen.get(s["id"], 0) < APP_SEEN
                if looked and (s["unseen"] or s.get("unread")):
                    mark_seen(s["id"])
                    s["unseen"] = False
                    s["unread"] = 0
            view = {"hostname": host_name(), "sessions": [app_row(s) for s in ss], "projects": ps, "machine": machine_name(), "label": machine_label(), "icon": machine_icon(), "machines_as": machines_as(),
                    "look": look_stamp(look), "nerd": look["font"]["nerd"],
                    "sound": sound_name(),
                    "assistant_sound": assistant_sound_name(), "alerts": alerts(), "build": app_build(),
                    "sleep_after": "off" if sleep_after() is None else sleep_after(),
                    "dictation": dictate_status(), "show_terminals": show_terminals(),
                    "new_model": new_model(), "new_effort": new_effort(),
                    "default_efforts": default_efforts(), "models": known_models(), "share": share_state(),
                    "engine_problem": protocol_problem(), "today": today_view(), "needs": needs_you(ss),
                    "missions": missions_view(), "ghostty": ghostty_here(), "moved": moved_shared()}
        except Exception as e:      # a half-written file, say: the next second will do
            print(f"amarchy app: couldn't read the sessions: {e}", file=sys.stderr)
            time.sleep(1)
            continue
        with st.changed:
            if view != st.view:
                st.view = view
                st.version += 1
                st.own_version += 1
                st.changed.notify_all()
        app_moments(st, ss)
        if st.peers:
            try:
                peer_moments(st, board_view(st))
            except Exception as e:      # another machine's chats never stop this one's
                print(f"amarchy app: machines: {e}", file=sys.stderr)
        try:
            app_missions(st, ss)
        except Exception as e:      # the score never stops the list
            print(f"amarchy app: missions: {e}", file=sys.stderr)
        st.poke.wait(1)
        st.poke.clear()
        time.sleep(max(0.0, began + 0.1 - time.time()))      # ten times a second at most, however much is done


def app_asking(s):
    """The requests a chat-engine session waits on (live["pending"]), the
    first one asked first, or []."""
    if s.get("engine") != "chat":
        return []
    live = agent_live(s["id"])
    return (live.get("pending") or []) if live.get("state") not in ("exited", None) else []


# What a secret's name is, in words, for the ones people mostly have (as
# app/secrets.js's SECRET_WORDS has them).
SECRET_WORDS = {
    "OPENAI_API_KEY": "OpenAI API key", "GEMINI_API_KEY": "Gemini API key", "GOOGLE_API_KEY": "Google API key",
    "STRIPE_SECRET_KEY": "Stripe secret key", "STRIPE_API_KEY": "Stripe API key", "GITHUB_TOKEN": "GitHub token",
    "GH_TOKEN": "GitHub token", "DATABASE_URL": "database address", "AWS_ACCESS_KEY_ID": "AWS access key",
    "AWS_SECRET_ACCESS_KEY": "AWS secret key", "SUPABASE_SERVICE_ROLE_KEY": "Supabase service key",
    "RESEND_API_KEY": "Resend API key", "HF_TOKEN": "Hugging Face token", "SENTRY_AUTH_TOKEN": "Sentry token",
    "CLOUDFLARE_API_TOKEN": "Cloudflare API token", "OPENROUTER_API_KEY": "OpenRouter API key",
    "MISTRAL_API_KEY": "Mistral API key", "GROQ_API_KEY": "Groq API key", "ELEVENLABS_API_KEY": "ElevenLabs API key",
}


def secret_words(name):
    return SECRET_WORDS.get(name) or name


def ask_line(s):
    """What a session waits on you for, in words a notification and the list
    say: the secret its Claude asks for first (as its card comes first), else
    the chat engine's request, else "Needs your answer". "" when it isn't
    waiting on you."""
    asks = [a for a in s.get("secret_asks") or [] if a.get("waiting")]
    if asks:
        why = str(asks[0].get("why") or "").strip().rstrip(".")
        return f"Needs your {secret_words(asks[0].get('name'))}" + (f": {why}" if why else "")
    if s.get("status") != "waiting":
        return ""
    pending = app_asking(s)
    if pending:
        more = len(pending) - 1
        return ask_words(pending[0], s.get("path")) + (f" (and {more} more)" if more > 0 else "")
    return "Needs your answer"      # a classic terminal's question is on its screen, which nothing reads


# ------------------------------------------------------------------ Today
#
# The app's home (app/today.js): what to do now, without reading a chat.
# Your move first (what a chat asks you, your commitments due), then the
# chats to finish (done ones to close, stale ones to close or nudge), then
# theirs (chats at work, the people you wait on). A chat says where it
# stands in the goal block each reply ends with (REPLY_FORMAT): its goal,
# and working, waiting, blocked or done. Your commitments are in your loops
# file (amarchy today --loops), which Today only reads: Done, Chase, Ask and
# New chat go to your assistant, which keeps it.

LOOPS_FILE = STATE / "loops"                # the loops file's path (amarchy today --loops)
LOOPS_SENT = STATE / "loops-sent.json"      # {key: {action, at}}: what Today told your assistant, until it's done
GOAL_STATES = ("working", "waiting", "blocked", "done")
GOAL_BLOCK = re.compile(r"(?ms)^```[ \t]*goal\b([^\n]*)\n(.*?)^```[ \t]*$\n?")
STALE_DAYS = 2      # a chat idle longer: close or nudge it


# ---- the blocks a reply holds (app/blocks.json, the catalog): read as the app
# reads them (chat.js replyParts, replyBlock), and checked when a turn ends.

BLOCKS_FILE = APP_PAGES / "blocks.json"
_block_catalog = {}
FENCE_OPEN = re.compile(r"^ {0,3}```\s*([A-Za-z]+)?(.*)$")
FENCE_CLOSE = re.compile(r"^ {0,3}```\s*$")
BLOCK_ATTR = re.compile(r'(\w+)\s*=\s*"([^"]*)"')
BLOCK_URL = re.compile(r"^(https?://\S+|mailto:\S+|tel:\S+|sms:\S+)$")
BLOCK_NUMBER = re.compile(r"^[^\d\-+.]{0,3}([-+]?(?:\d[\d,]*(?:\.\d+)?|\.\d+))\s*[%a-zA-Z/]*$")
BLOCK_FIELD = re.compile(r"^\s*(?:[-*]\s+)?([^:]{1,60}?)\s*:\s+(.+?)\s*$")
BLOCK_SERIES_MAX = 8
BLOCK_HANDLE = re.compile(r"^@?\w{1,15}$")         # an X handle (an xpost's), its @ or not
BLOCK_POST = re.compile(r"^https://(?:www\.|mobile\.)?(?:x|twitter)\.com/(?:\w{1,15}|i(?:/web)?)/status(?:es)?/\d{1,20}(?:[/?#]\S*)?$", re.I)


# ---- a block's pictures and videos (an xpost's avatar and media): a file on
# this machine, served to the app (/api/session/<id>/media?src=...), or a
# picture on the web, fetched here (the app's pages take pictures only from
# this server: APP_CSP).

MEDIA_TYPES = "PNG, JPEG, GIF, WebP, MP4, MOV or WebM"
MEDIA_FETCH_MAX = 20_000_000        # bytes of a picture fetched from the web (X takes 5 MB)
MEDIA_CACHE = STATE / "media"       # those fetched, by their address's hash
MEDIA_KEEP = 86400                  # seconds one is kept before it's fetched again (gone after a week)


def media_type(head):
    """A picture's or a video's media type, read off its first 16 bytes; None
    for anything else (a file's name says nothing)."""
    for magic, kind in ((b"\x89PNG\r\n\x1a\n", "image/png"), (b"\xff\xd8\xff", "image/jpeg"),
                        (b"GIF87a", "image/gif"), (b"GIF89a", "image/gif")):
        if head.startswith(magic):
            return kind
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return "image/webp"
    if head[4:8] == b"ftyp":
        brand = head[8:12]
        if brand in (b"heic", b"heix", b"heim", b"heis", b"hevc", b"mif1", b"msf1"):
            return "image/heic"
        if brand in (b"avif", b"avis"):
            return "image/avif"
        if brand.startswith((b"M4A", b"M4B", b"M4P")):
            return None     # sound only
        return "video/quicktime" if brand == b"qt  " else "video/mp4"
    if head[:4] == b"\x1a\x45\xdf\xa3":
        return "video/webm"
    return None


def media_list(value, many=None):
    """An attribute's pictures (media="a.png, b.png": up to many)."""
    v = (value or "").strip()
    return [x.strip() for x in v.split(",") if x.strip()] if many else [v] if v else []


def media_path(src, base=None):
    """A picture or video on this machine, as a block names it (~/..., a full
    path, or one in base, the chat's folder): (its file, its media type), or
    (None, why not, in words). Only in your home or /tmp, only a picture or a
    video, by what the file starts with."""
    v = (src or "").strip()
    if not v or re.match(r"^[a-z][a-z0-9+.-]*:", v, re.I):
        return None, "isn't a path on this machine"
    p = Path(v).expanduser()
    if not p.is_absolute():
        if not base:
            return None, "isn't a full path (~/... or /...)"
        p = Path(base) / p
    try:
        p = p.resolve(strict=True)
    except (OSError, RuntimeError):
        return None, "isn't a file here"
    if not any(p.is_relative_to(r) for r in {HOME.resolve(), Path("/tmp").resolve()}):
        return None, "isn't in your home folder or /tmp"
    if not p.is_file():
        return None, "isn't a file here"
    try:
        with open(p, "rb") as fh:
            kind = media_type(fh.read(16))
    except OSError:
        return None, "can't be read"
    return (p, kind) if kind else (None, f"isn't a picture or a video ({MEDIA_TYPES})")


def media_issue(src, base=None):
    """Why a block's picture or video can't be shown (a word for Claude to
    fix), or None: an https address (fetched only when it's shown), or a file
    here that is one."""
    if re.match(r"^https://\S+$", src, re.I):
        return None
    if re.match(r"^http://", src, re.I):
        return "isn't https: give its https address, or a path on this machine"
    found, why = media_path(src, base)
    return None if found else why


def public_host(host):
    """Whether every address a host name has is on the public internet (not
    this machine, its network or the tailnet), so a picture fetched from it
    can't reach anything private."""
    import ipaddress
    try:
        infos = socket.getaddrinfo(host, 443, proto=socket.IPPROTO_TCP)
    except (OSError, UnicodeError):
        return False
    try:
        return bool(infos) and all(ipaddress.ip_address(i[4][0].split("%")[0]).is_global for i in infos)
    except ValueError:
        return False


def media_fetch(url):
    """A picture on the web a block shows (an avatar, a post's picture):
    (its file, kept here a day, its media type), or (None, why not). Only
    https, only from a public address (each redirect too), only a picture,
    at most MEDIA_FETCH_MAX bytes."""
    import urllib.error
    import urllib.request
    f = MEDIA_CACHE / hashlib.sha1(url.encode()).hexdigest()
    kept = None         # the copy kept, if there's one: still shown when the site can't be reached
    try:
        with open(f, "rb") as fh:
            kind = media_type(fh.read(16))
        if kind and kind.startswith("image/"):
            kept = (f, kind)
            if time.time() - f.stat().st_mtime < MEDIA_KEEP:
                return kept
    except OSError:
        pass
    try:
        u = urllib.parse.urlsplit(url)
        host = u.hostname
    except ValueError:
        return None, "not an address"
    if u.scheme.lower() != "https" or not host:
        return None, "only https"
    if not public_host(host):
        return kept or (None, "not a public address")

    class Hop(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            try:
                to = urllib.parse.urlsplit(newurl)
                ok = to.scheme.lower() == "https" and to.hostname and public_host(to.hostname)
            except ValueError:
                ok = False
            if not ok:
                raise urllib.error.URLError("it sends elsewhere than a public https address")
            return super().redirect_request(req, fp, code, msg, headers, newurl)
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "amarchy", "Accept": "image/*"})
        with urllib.request.build_opener(Hop).open(req, timeout=15) as r:
            data = r.read(MEDIA_FETCH_MAX + 1)
    except urllib.error.HTTPError as e:
        return kept or (None, f"the site said {e.code}")
    except (urllib.error.URLError, OSError, ValueError) as e:
        return kept or (None, f"couldn't fetch it: {getattr(e, 'reason', None) or e}")
    kind = media_type(data[:16])
    if len(data) > MEDIA_FETCH_MAX:
        return None, "too big"
    if not kind or not kind.startswith("image/"):
        return None, "not a picture"
    try:
        MEDIA_CACHE.mkdir(parents=True, exist_ok=True)
        for old in MEDIA_CACHE.iterdir():       # a week unused: gone
            if time.time() - old.stat().st_mtime > MEDIA_KEEP * 7:
                old.unlink(missing_ok=True)
        tmp = f.with_name(f".{f.name}.{os.getpid()}.{threading.get_ident()}")
        tmp.write_bytes(data)
        os.replace(tmp, f)
    except OSError:
        return None, "couldn't keep it here"
    return f, kind


def block_catalog():
    """app/blocks.json: {blocks: [{kind, for, attrs, body, example, rule...}],
    common: the attributes every block takes}. Read again when it changes."""
    try:
        mtime = BLOCKS_FILE.stat().st_mtime_ns
    except OSError:
        return {"blocks": [], "common": {}}
    if _block_catalog.get("mtime") != mtime:
        try:
            _block_catalog.update(mtime=mtime, data=json.loads(BLOCKS_FILE.read_text()))
        except (OSError, ValueError):
            return {"blocks": [], "common": {}}
    return _block_catalog["data"]


def block_kinds():
    return {b["kind"]: b for b in block_catalog()["blocks"]}


def block_number(text):
    m = BLOCK_NUMBER.match((text or "").strip())
    if not m:
        return None
    try:
        return float(m.group(1).replace(",", ""))
    except ValueError:
        return None


def block_body(shape, body):
    """A block's body read by its shape: {items}, {options}, {fields},
    {series, points}, {url}, with the lines that don't fit it (bad)."""
    lines = [l for l in body.split("\n") if l.strip()]
    if shape == "todos":
        items, bad = [], []
        for l in lines:
            m = re.match(r"^\s*[-*]\s*(?:\[( |x|X)\]\s*)?(.+?)\s*$", l)
            if not m:
                bad.append(l)
                continue
            due = re.search(r"\s*\(([^)]{1,40})\)\s*$", m.group(2))
            items.append({"text": m.group(2)[:due.start()] if due else m.group(2), "due": due.group(1) if due else "",
                          "done": (m.group(1) or "").lower() == "x"})
        return {"items": items, "bad": bad}
    if shape == "options":
        options, bad = [], []
        for l in lines:
            m = re.match(r"^\s*[-*]\s*(.+?)\s*$", l)
            if not m:
                bad.append(l)
                continue
            label, *send = re.split(r"\s+\|\s+", m.group(1), maxsplit=1)
            options.append({"label": label.strip(), "send": (send[0] if send else label).strip()})
        return {"options": options, "bad": bad}
    if shape == "fields":
        fields, bad = [], []
        for l in lines:
            m = BLOCK_FIELD.match(l)
            if m:
                fields.append({"label": m.group(1).strip(), "value": m.group(2)})
            else:
                bad.append(l)
        return {"fields": fields, "bad": bad}
    if shape == "series":
        series, points, bad = [], [], []
        if lines and lines[0].lstrip().startswith("|"):
            cells = lambda l: [c.strip() for c in l.strip().strip("|").split("|")]
            head = cells(lines[0])
            series = head[1:]
            for l in lines[1:]:
                if re.match(r"^\s*\|?\s*:?-{2,}", l):
                    continue
                row = cells(l)
                values = [block_number(c) for c in row[1:]]
                if len(row) != len(head) or any(v is None for v in values):
                    bad.append(l)
                else:
                    points.append({"label": row[0], "values": values})
        else:
            series = [""]
            for l in lines:
                m = BLOCK_FIELD.match(l)
                v = block_number(m.group(2)) if m else None
                if v is None:
                    bad.append(l)
                else:
                    points.append({"label": m.group(1).strip(), "values": [v]})
        return {"series": series, "points": points, "bad": bad}
    if shape == "url":
        return {"url": lines[0].strip() if lines else ""}
    return {}


def reply_blocks(text):
    """The catalog's blocks in a reply, in order: [{kind, attrs (by their
    names, aliases read as them), unknown (attributes it doesn't take),
    rest (what's on the opening line besides key="value" pairs), body,
    closed, line}] and what block_body reads of the body. Any other fence
    (code) is skipped whole, as the app shows it as code."""
    kinds, common = block_kinds(), block_catalog().get("common", {})
    out = []
    lines = (text or "").replace("\r", "").split("\n")
    i = 0
    while i < len(lines):
        m = FENCE_OPEN.match(lines[i])
        if not m:
            i += 1
            continue
        kind, start, body = (m.group(1) or "").lower(), i, []
        i += 1
        while i < len(lines) and not FENCE_CLOSE.match(lines[i]):
            body.append(lines[i])
            i += 1
        closed = i < len(lines)
        i += 1
        d = kinds.get(kind)
        if not d:
            continue
        specs = {**common, **d.get("attrs", {})}
        names = {a: name for name, spec in specs.items() for a in [name, *spec.get("alias", [])]}
        raw = [(k.lower(), v) for k, v in BLOCK_ATTR.findall(m.group(2))]
        attrs = {}
        for k, v in raw:
            if k in names:
                attrs.setdefault(names[k], v)
        text_body = "\n".join(body).strip("\n").rstrip()
        out.append({"kind": kind, "attrs": attrs, "unknown": [k for k, _ in raw if k not in names],
                    "rest": BLOCK_ATTR.sub("", m.group(2)).strip(), "body": text_body, "closed": closed,
                    "line": start + 1, **block_body(d.get("body", {}).get("shape", "text"), text_body)})
    return out


def block_issues(b, chat_exists=None):
    """What's wrong with a block, so its buttons can't work, in words for
    Claude to fix: [] when nothing. chat_exists(id): whether a chat is there
    (a session block's), when it can be asked."""
    d = block_kinds()[b["kind"]]
    specs = {**block_catalog().get("common", {}), **d.get("attrs", {})}
    name = f"The {b['kind']} block"
    out = []
    if not b["closed"]:
        out.append(f"{name} isn't closed with ```.")
    if b["rest"]:
        out.append(f"{name}'s opening line has {b['rest']!r}, which isn't key=\"value\" (straight double quotes).")
    if b["unknown"]:
        out.append(f"{name} takes no {', '.join(repr(k) for k in b['unknown'])} (it takes: {', '.join(specs)}).")
    for key, spec in specs.items():
        v = b["attrs"].get(key, "").strip()
        if not v:
            if spec.get("need"):
                out.append(f"{name} needs {key}=\"...\".")
            continue
        kind = spec.get("type", "text")
        if kind == "phone" and len(re.sub(r"\D", "", v)) < 7:
            out.append(f"{name}'s {key} {v!r} isn't a phone number (with its country code: \"+57 300 111 2233\").")
        elif kind == "email" and not re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", v):
            out.append(f"{name}'s {key} {v!r} isn't an email address.")
        elif kind == "url" and not BLOCK_URL.match(v):
            out.append(f"{name}'s {key} {v!r} isn't a web address (https://...).")
        elif kind == "enum" and v.lower() not in spec.get("of", []):
            out.append(f"{name}'s {key} is {v!r}: it's one of {', '.join(spec.get('of', []))}.")
        elif kind == "datetime":
            try:
                if "T" not in v:
                    raise ValueError
                datetime.datetime.fromisoformat(v.replace("Z", "+00:00"))
            except ValueError:
                out.append(f"{name}'s {key} {v!r} isn't a date and time (ISO 8601 with its offset: \"2026-10-29T15:40:00-05:00\").")
        elif kind == "session" and chat_exists and not chat_exists(v):
            out.append(f"{name}'s {key} {v!r} isn't a chat's id (amarchy list --compact has them).")
        elif kind == "handle" and not BLOCK_HANDLE.match(v):
            out.append(f"{name}'s {key} {v!r} isn't an X handle (up to 15 letters, digits or _, as \"ja818_\").")
        elif kind == "post" and not BLOCK_POST.match(v):
            out.append(f"{name}'s {key} {v!r} isn't a post's address on X (https://x.com/<user>/status/<id>).")
        elif kind == "media":
            items, most = media_list(v, spec.get("many")), spec.get("many") or 1
            if len(items) > most:
                out.append(f"{name} has {len(items)} in {key}: at most {most}.")
            for x in items:
                why = media_issue(x, os.getcwd())
                if why:
                    out.append(f"{name}'s {key} {x!r} {why}.")
    if d.get("needAny") and not any((b["body"] if k == "body" else b["attrs"].get(k, "")).strip() for k in d["needAny"]):
        out.append(f"{name} needs {' or '.join('its text' if k == 'body' else k for k in d['needAny'])}.")
    if b["kind"] == "event" and b["attrs"].get("end") and b["attrs"].get("when"):
        try:
            when, end = (datetime.datetime.fromisoformat(b["attrs"][k].replace("Z", "+00:00")) for k in ("when", "end"))
            if (end.tzinfo is None) == (when.tzinfo is None) and end <= when:
                out.append(f"{name} ends before it starts.")
        except ValueError:
            pass
    shape, need = d.get("body", {}).get("shape", "text"), d.get("body", {}).get("need")
    if need and not b["body"].strip():
        out.append(f"{name} is empty.")
    elif shape == "url" and b["body"].strip() and not BLOCK_URL.match(b.get("url", "")):
        out.append(f"{name}'s address {b.get('url', '')!r} isn't one to open (https://, mailto:, tel:, sms:).")
    elif shape == "todos" and need and not b["items"]:
        out.append(f"{name} has no \"- [ ] ...\" lines.")
    elif shape == "options":
        if not b["options"]:
            out.append(f"{name} has no \"- Label | message\" options.")
        elif len(b["options"]) > 4:
            out.append(f"{name} has {len(b['options'])} options: at most 4 (one question per block).")
    elif shape == "fields":
        if b["bad"]:
            out.append(f"{name} has lines that aren't \"Label: value\": {b['bad'][0]!r}.")
        elif need and not b["fields"]:
            out.append(f"{name} has no \"Label: value\" lines.")
        elif d.get("labels"):
            labels = {k.lower(): k for k in d["labels"]}
            other = [f["label"] for f in b["fields"] if f["label"].lower() not in labels]
            if other:
                rows = ", ".join(k for k, spec in d["labels"].items() if not spec.get("old"))
                out.append(f"{name} takes no {', '.join(repr(k) for k in other)} row (its rows: {rows}).")
            have = [f["label"].lower() for f in b["fields"]]
            for k, spec in d["labels"].items():
                if spec.get("need") and k.lower() not in have:
                    out.append(f"{name} needs its \"{k}: ...\" row.")
            long = [f["label"] for f in b["fields"] if len(f["value"]) > BRIEF_ROW_MAX]
            if long:
                out.append(f"{name}'s {', '.join(long)} row is over {BRIEF_ROW_MAX} characters: one short line each (the detail goes in a section).")
    elif shape == "series":
        if b["bad"]:
            out.append(f"{name} has rows that aren't a label and numbers: {b['bad'][0]!r}.")
        elif len(b["points"]) < 2:
            out.append(f"{name} needs at least 2 values to chart.")
        if len(b["series"]) > BLOCK_SERIES_MAX:
            out.append(f"{name} has {len(b['series'])} series: at most {BLOCK_SERIES_MAX}.")
    return out


HOOK_FEEDBACK = "Stop hook feedback:"
FIX_MARK = "amarchy: your reply can't be shown as it is"
FIX_MARKS = (FIX_MARK, "amarchy: some blocks in your reply can't be drawn",      # (the second: what it said until 2026-11-10)
             "amarchy: NO_REPLY hides only a turn")      # (SILENT_ASK's)
GOAL_MARK = "amarchy: your reply doesn't end with its goal block"
FIX_ASK = (FIX_MARK + ":\n{issues}\nWrite your whole reply again with them fixed, "
           "as if for the first time (don't mention the fix): the person sees it in place of the one you wrote.")
GOAL_ASK = (GOAL_MARK + ". Send only that block now, nothing else: it's added to the reply you wrote.")

# A reply's shape (reply_shape, the reply format's own numbers): what makes it
# read at a glance instead of a wall of text.
REPLY_LONG = 80         # words of prose; over it, a reply has sections and a brief
REPLY_LEAD = 40         # words before the first heading, at most, in such a reply
SECTION_MAX = 120       # words under one heading, at most
HEADING_MAX = 70        # characters in a heading, at most
BRIEF_ROW_MAX = 200     # characters in a brief's row, at most
SECTION_HEAD = re.compile(r"^#{1,2}\s+(.+?)\s*#*\s*$")      # (the app's too: chat.js replyOutline)
# Your assistant's and your agents' (CHAT_FORMAT): several short messages,
# a line of --- between two, each a bubble (chat_messages; chat.js chatMessages).
CHAT_MESSAGE_MAX = 60   # words of prose in one message, at most
CHAT_SPLIT = re.compile(r"^ {0,3}-{3,}\s*$")


def reply_outline(text):
    """A reply's shape, as the app draws it (chat.js replyOutline): {lead:
    the words of prose before its first "# " or "## " heading, sections:
    [{title, words, line}], brief: the line its brief block starts on (or
    None), late: the brief, actions and choices blocks written after a
    heading}. Prose: what's read as running text, so not a block, code, a
    table or a heading."""
    out = {"lead": 0, "sections": [], "brief": None, "late": []}
    lines = without_goal(text or "").replace("\r", "").split("\n")
    i = 0
    while i < len(lines):
        l = lines[i]
        m = FENCE_OPEN.match(l)
        if m:
            kind = (m.group(1) or "").lower()
            if kind == "brief" and out["brief"] is None:
                out["brief"] = i + 1
            if kind in ("brief", "actions", "choices") and out["sections"] and kind not in out["late"]:
                out["late"].append(kind)
            i += 1
            while i < len(lines) and not FENCE_CLOSE.match(lines[i]):
                i += 1
            i += 1
            continue
        i += 1
        m = SECTION_HEAD.match(l)
        if m:
            out["sections"].append({"title": m.group(1), "words": 0, "line": i})
            continue
        if re.match(r"^\s*\|", l) or re.match(r"^#{3,6}\s", l):
            continue
        words = len(re.findall(r"\w[\w'’.-]*", l))
        if out["sections"]:
            out["sections"][-1]["words"] += words
        else:
            out["lead"] += words
    return out


def chat_messages(text):
    """What your assistant or an agent wrote, as the messages it sent
    (CHAT_FORMAT): split at the lines holding only --- (not in a code block
    or a block), the empty ones left out."""
    out, cur, fenced = [], [], False
    for line in (text or "").replace("\r", "").split("\n"):
        if fenced:
            fenced = not FENCE_CLOSE.match(line)
        elif FENCE_OPEN.match(line):
            fenced = True
        elif CHAT_SPLIT.match(line):
            out.append("\n".join(cur))
            cur = []
            continue
        cur.append(line)
    out.append("\n".join(cur))
    return [m.strip() for m in out if m.strip()]


def chat_shape(text):
    """What's wrong with a chat's messages (CHAT_FORMAT), in words for its
    Claude to fix ([] when nothing): one over CHAT_MESSAGE_MAX words of
    prose, a heading."""
    out = []
    for m in chat_messages(without_goal(text)):
        o = reply_outline(m)
        words = o["lead"] + sum(x["words"] for x in o["sections"])
        start = " ".join(re.sub(r"[*_`#>|]", "", m).split()[:6])
        if words > CHAT_MESSAGE_MAX:
            out.append(f"Your message starting \"{start}…\" is {words} words: at most {CHAT_MESSAGE_MAX}. Split it into short "
                       f"messages, a line holding only --- between two, or say less.")
        if o["sections"]:
            out.append(f"Your message starting \"{start}…\" has a heading: a chat has none. Make it a short message of its own, "
                       f"or **bold** its words.")
    return out


def reply_shape(text):
    """What's wrong with a reply's shape, in words for Claude to fix ([] when
    nothing): a long one (over REPLY_LONG words of prose) opens with its
    outcome and its brief, then what they need to do, then every idea under
    a heading; a section is short, its heading too; the brief, the action
    items and the questions come before the sections."""
    o = reply_outline(text)
    total = o["lead"] + sum(s["words"] for s in o["sections"])
    out = []
    if total > REPLY_LONG:
        if not o["sections"]:
            out.append(f"Your reply is {total} words in one piece. Open with the outcome in a sentence, then the brief block, then put "
                       f"every idea under its own \"## \" heading that states its point (the app folds each section under its heading).")
        elif o["lead"] > REPLY_LEAD:
            out.append(f"{o['lead']} words come before your first \"## \" heading: open with the outcome in a sentence "
                       f"(at most {REPLY_LEAD} words) and put the rest under headings.")
        elif not o["lead"]:
            out.append("Your reply has no opening sentence: say the outcome first, in one plain sentence, before the brief block.")
        if o["brief"] is None:
            out.append("Your reply has no brief block (right after your opening sentence: Checked, Open, Next, You).")
    for s in o["sections"]:
        if s["words"] > SECTION_MAX:
            out.append(f"The section \"{s['title'][:60]}\" is {s['words']} words: at most {SECTION_MAX}. Cut it, or split it into "
                       f"sections that each make one point.")
        if len(s["title"]) > HEADING_MAX:
            out.append(f"The heading \"{s['title'][:40]}...\" is {len(s['title'])} characters: at most {HEADING_MAX}, its point in a few words.")
    for kind in o["late"]:
        out.append(f"Your {kind} block comes after a \"## \" heading: the brief, then your choices and what they'll use, go before "
                   f"the sections, which the app shows folded.")
    return out


def fix_feedback(r):
    """Whether a conversation record is the Stop hook sending a reply back to
    be written again (FIX_ASK; Claude Code records it as its own, isMeta)."""
    content = (r.get("message") or {}).get("content") if isinstance(r.get("message"), dict) else None
    texts = [content] if isinstance(content, str) else [b.get("text") or "" for b in content or [] if isinstance(b, dict) and b.get("type") == "text"]
    return any(t.startswith(HOOK_FEEDBACK) and any(m in t for m in FIX_MARKS) for t in texts)


def turn_reply(path, tail=2_000_000):
    """The reply a turn ended with, from its conversation: the words Claude
    wrote after its last step, since your last message. "" for none."""
    texts = []
    for r in reversed(conversation_records(path, tail=tail) if path else []):
        if not isinstance(r, dict) or r.get("isSidechain"):
            continue
        content = (r.get("message") or {}).get("content") if isinstance(r.get("message"), dict) else None
        if r.get("type") == "user":
            break       # yours, a step's result, a hook's feedback: the reply is what came after
        if r.get("type") != "assistant" or not isinstance(content, list):
            continue
        for b in reversed(content):
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_use":
                return "\n\n".join(texts)
            if b.get("type") == "text" and (b.get("text") or "").strip():
                texts.insert(0, b["text"])
    return "\n\n".join(texts)


def reply_fix(event, chat=False):
    """What a turn's reply needs fixed, as the Stop hook asks Claude (FIX_ASK,
    GOAL_ASK), or None: its blocks the app can't draw and a shape that reads
    as a wall of text (reply_issues), else a missing goal block. Nothing for a turn that ended without words.
    chat: your assistant's or an agent's (CHAT_FORMAT): its blocks and its
    messages' size (chat_shape), and no goal."""
    text = event.get("last_assistant_message") if isinstance(event.get("last_assistant_message"), str) else None
    if not text:
        text = turn_reply(event.get("transcript_path"))
    if not text or not text.strip():
        return None
    issues, has_goal = reply_issues(text, lambda sid: session(sid) is not None, chat=chat)
    if issues:
        return FIX_ASK.format(issues="\n".join(f"- {i}" for i in issues[:12]))
    return None if has_goal or chat else GOAL_ASK


def reply_issues(text, chat_exists=None, chat=False):
    """A reply's blocks checked (block_issues) and its shape (reply_shape;
    a chat's messages, chat_shape), and whether it has its goal block: (issues, has_goal)."""
    blocks = reply_blocks(text)
    issues = [i for b in blocks for i in block_issues(b, chat_exists)] + (chat_shape(text) if chat else reply_shape(text))
    return issues, any(b["kind"] == "goal" for b in blocks)


def without_goal(text):
    """A reply without its goal block: what's shown of it as words."""
    return GOAL_BLOCK.sub("", text or "").rstrip()


def reply_goal(text):
    """The goal block a reply ends with: {"goal", "state"}, or None."""
    found = [b for b in reply_blocks(text) if b["kind"] == "goal"]
    if not found:
        return None
    state = found[-1]["attrs"].get("state", "").strip().lower()
    goal = " ".join(found[-1]["body"].split())[:200]
    return {"goal": goal, "state": state if state in GOAL_STATES else ""} if goal or state else None


def reply_choices(text):
    """The questions a reply asks with its choices blocks, as the app's
    Needs you form has them: [{question, options: [{label, send}]}],
    options at most 4."""
    return [{"question": b["attrs"].get("question", ""), "options": b["options"][:4]}
            for b in reply_blocks(text) if b["kind"] == "choices" and b["options"]][:3]


def reply_links(text):
    """Where to see what a reply made (its link blocks, else the links in its
    words, not its Sources): [{label, url}], at most 3. A done chat's Review."""
    out = []
    for b in reply_blocks(text):
        if b["kind"] == "link" and re.match(r"https?://", b["url"]):
            out.append({"label": b["attrs"].get("label", ""), "url": b["url"]})
    if not out:
        words = re.split(r"(?mi)^##\s+sources\b", without_goal(text or ""))[0]
        words = re.sub(r"(?ms)^```.*?^```", "", words)
        for m in re.finditer(r"\[([^\]]{1,80})\]\((https?://[^\s)]+)\)|(?<![(\[<\"])\b(https?://[^\s<>)\]\"'`*]+[^\s<>)\]\"'`*.,;:!?])", words):
            out.append({"label": m.group(1) or "", "url": m.group(2) or m.group(3)})
    seen, uniq = set(), []
    for l in out:
        if l["url"] not in seen:
            seen.add(l["url"])
            uniq.append(l)
    return uniq[:3]


def human_turn(r):
    """Whether a conversation record is something you said (not a tool's
    result, nor what Claude Code or amarchy put in your name)."""
    if r.get("type") != "user" or r.get("isMeta") or r.get("isSidechain"):
        return False
    content = (r.get("message") or {}).get("content") if isinstance(r.get("message"), dict) else None
    if isinstance(content, list):
        content = " ".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    text = (content or "").strip() if isinstance(content, str) else ""
    return bool(text) and not text.startswith(("<", "amarchy:", HOOK_FEEDBACK, "This session is being continued"))


_replies = {}
def chat_reply(s):
    """Where a chat stands, from its conversation: its goal and state (the
    newest goal block, and when it was written: goal_at), the questions its
    last reply asks that you haven't answered (asks), when you last wrote to
    it (you_at) and when anything last happened in it (at). Read again only
    when the conversation has moved."""
    empty = {"goal": "", "state": "", "goal_at": 0, "asks": [], "at": 0, "links": [], "you_at": 0}
    f = transcript(s) if s.get("id") else None
    if not f:
        return empty
    try:
        st = f.stat()
    except OSError:
        return empty
    # The quiet turns and the one held under way aren't where it stands
    # (turns_hidden): nothing of them is read, and they didn't move it (at).
    hidden = turns_hidden(s)
    stamp = (st.st_mtime_ns, len(hidden[0]), hidden[0][-1:], hidden[1])
    cached = _replies.get(str(f))
    if cached and cached[0] == stamp:
        return cached[2]
    # The file only grows: a goal read before is still its newest unless the
    # end has a newer one. A chat at work a long while pushes its last goal
    # block out of the end read; it keeps it (not a chat with no goal, then
    # its goal again, every other second), and the end is all that's read.
    before = cached[2] if cached and cached[1] <= st.st_size else None
    out = {**empty, "at": st.st_mtime}
    answered, reply_seen = False, False
    for tail in (200_000, 2_000_000):
        out.update(goal="", state="", goal_at=0, asks=[], links=[], you_at=0)
        answered, reply_seen, moved = False, False, None
        for r in reversed(conversation_records(f, tail=tail)):
            if not isinstance(r, dict) or r.get("isSidechain"):
                continue
            said = r.get("type") in ("user", "assistant")
            if record_hidden(r, hidden):
                if said and moved is None:
                    moved = False       # its last words are a hidden turn's
                continue
            if said and moved is False and record_at(r):
                moved = record_at(r)        # what moved it last, of what's shown
                out["at"] = min(st.st_mtime, moved)
            if human_turn(r):
                out["you_at"] = out["you_at"] or timestamp(r)
                answered = answered or not reply_seen
                if out["goal"]:
                    break
                continue
            if r.get("type") != "assistant":
                continue
            content = (r.get("message") or {}).get("content") if isinstance(r.get("message"), dict) else None
            text = "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text") \
                if isinstance(content, list) else content if isinstance(content, str) else ""
            if not text.strip():
                continue
            if not reply_seen and without_goal(text).strip():       # (only its goal block: added to the reply before it, reply_fix)
                reply_seen = True
                out["links"] = reply_links(text)       # where to see what it made: Review
                if not answered:
                    out["asks"] = reply_choices(text)
            goal = reply_goal(text) if not out["goal"] else None
            if goal:
                out.update(goal=goal["goal"], state=goal["state"], goal_at=timestamp(r) or 0)
                if out["you_at"]:
                    break
        if st.st_size <= tail or ((out["goal"] or (before and before["goal"])) and (out["you_at"] or (before and before["you_at"]))):
            break
    if not out["goal"] and before and before["goal"]:
        out.update(goal=before["goal"], state=before["state"], goal_at=before["goal_at"])
    if not out["you_at"] and before:
        out["you_at"] = before["you_at"]      # (further back than what's read)
    _replies[str(f)] = (stamp, st.st_size, out)
    if len(_replies) > 500:
        _replies.clear()
    return out


def needs_you(ss):
    """How many things wait on you: a chat asking (a permission, a question,
    a secret), or one whose last reply asks you something you haven't
    answered (asks_you, as the Ⓐ in Omarchy's bar counts them). Today's count."""
    return sum(1 for s in ss if asks_you(s))


def app_badge(ss):
    """The number on the app's icon: what needs you (needs_you), and the
    messages from your assistant and your agents you haven't read, as a
    messaging app counts them (manage.js markWaiting says the same)."""
    return needs_you(ss) + sum(s.get("unread") or 0 for s in ss if s.get("assistant") in AGENT_ROLES)


# ---- your loops

def loops_path():
    """Your loops file (amarchy today --loops), or None."""
    try:
        p = LOOPS_FILE.read_text().strip()
    except OSError:
        return None
    return Path(os.path.expanduser(p)) if p else None


def loop_date(word, today, past=False):
    """A loop's date: YYYY-MM-DD, or MM-DD in the year that puts it nearest
    today (past: the nearest not after today, for a since). As YYYY-MM-DD,
    or "" when it isn't one."""
    m = re.fullmatch(r"(\d{4})-(\d{1,2})-(\d{1,2})", word.strip())
    try:
        if m:
            return datetime.date(int(m.group(1)), int(m.group(2)), int(m.group(3))).isoformat()
        m = re.fullmatch(r"(\d{1,2})-(\d{1,2})", word.strip())
        if not m:
            return ""
        near = [datetime.date(today.year + dy, int(m.group(1)), int(m.group(2))) for dy in (-1, 0, 1)]
    except ValueError:
        return ""
    if past:
        near = [d for d in near if d <= today] or near
    return min(near, key=lambda d: abs((d - today).days)).isoformat()


def parse_loops(text, today=None):
    """The open loops in a loops file: each `- [ ] ...` line, its fields
    split on " · ". [{key, kind: due|waiting|someday|other, what, who, due,
    nudge, since, chase, ref, chat, line}]. chat: the chat (session) the
    line names for it, `(chat <id>)` or `(session <id>)`: one already at it.
    A loop's key is its line's hash: done (`- [x]`) or changed, it's another."""
    today = today or datetime.date.today()
    out = []
    for raw in (text or "").splitlines():
        m = re.match(r"^\s*[-*]\s+\[ \]\s+(.+?)\s*$", raw)
        if not m:
            continue
        line = m.group(1)
        parts = [p.strip() for p in re.split(r"\s+·\s+", line) if p.strip()]
        loop = {"key": hashlib.sha1(line.encode()).hexdigest()[:12], "kind": "other", "what": "", "who": "",
                "due": "", "nudge": "", "since": "", "chase": "", "ref": "", "chat": "", "line": line}
        named = re.findall(r"\((?:chat|session)\s+([A-Za-z0-9][\w.-]*)", line)
        if named:
            loop["chat"] = named[-1]
        rest = []
        for p in parts:
            low = p.lower()
            field = re.match(r"^(nudge|since|chase)\s+(\S+)$", low)
            if field and loop_date(field.group(2), today):
                loop[field.group(1)] = loop_date(field.group(2), today, past=field.group(1) == "since")
            elif p.startswith(("→", "->")):
                loop["ref"] = p.lstrip("→->").strip()
            else:
                rest.append(p)
        if rest and loop_date(rest[0], today):
            loop["kind"], loop["due"] = "due", loop_date(rest[0], today)
            rest = rest[1:]
        elif rest and rest[0].lower() == "waiting":
            loop["kind"] = "waiting"
            rest = rest[1:]
            if len(rest) > 1:
                loop["who"], rest = rest[0], rest[1:]
        elif rest and rest[0].lower() == "someday":
            loop["kind"] = "someday"
            rest = rest[1:]
        loop["what"] = " · ".join(rest) or line
        out.append(loop)
    return out


_loops = {"key": None, "loops": [], "error": ""}
def read_loops():
    """Your open loops, read again only when the file changed: (loops, the
    file or "", what's wrong or "")."""
    p = loops_path()
    if not p:
        return [], "", ""
    try:
        key = (str(p), p.stat().st_mtime_ns, datetime.date.today().isoformat())
    except OSError:
        return [], str(p), f"Can't read {p}"
    if _loops["key"] != key:
        try:
            _loops.update(key=key, loops=parse_loops(p.read_text(errors="replace")), error="")
        except OSError as e:
            _loops.update(key=key, loops=[], error=f"Can't read {p}: {e.strerror}")
    return _loops["loops"], str(p), _loops["error"]


def loops_sent(open_keys=None):
    """What Today told your assistant about, by loop: {key: {action, at}}.
    One that isn't open any more (it was ticked, or changed) goes, and so
    does one told about more than two days ago (told again, then)."""
    try:
        d = json.loads(LOOPS_SENT.read_text())
    except (OSError, ValueError):
        d = {}
    if not isinstance(d, dict):
        d = {}
    now = time.time()
    keep = {k: v for k, v in d.items() if isinstance(v, dict) and now - v.get("at", 0) < 2 * 86400
            and (open_keys is None or k in open_keys)}
    if keep != d and open_keys is not None:
        try:
            write_file(LOOPS_SENT, json.dumps(keep))
        except OSError:
            pass
    return keep


def today_view():
    """Today's part of the app's view, beside the sessions' (each has its
    own: today): your loops, where they're from, what your assistant was
    told, your assistant, its boards and yours (boards_view: Tasks), and
    your agents' tasks as an older machine reads them (tasks_view)."""
    loops, source, error = read_loops()
    crew = team()
    mine = next((a for a in crew if a["role"] == "main"), None)
    return {"loops": loops, "source": source, "error": error, "sent": loops_sent({l["key"] for l in loops}),
            "assistant": {"id": mine["id"], "name": mine["name"]} if mine else None, "boards": boards_view(crew),
            "tasks": tasks_view(crew)}


LOOP_ASKS = {
    "done": "Loop done: {said}. Tick it off in {source}.",
    "chase": "Chase {who} on: {what}{since}. Draft the message for me to send.",
    "ask": "About this loop: {said}\n\n{text}",
    "session": "Start a session for this loop: {said}{note}",
}


def loop_tell(key, action, text=""):
    """Today's Done, Follow up (chase), Ask (text: what you want done about
    it) or New chat (session; text: an optional note for its brief) on a
    loop: told to your assistant (as if you'd typed it), which keeps the file
    (and for a new chat, starts it and names it on the loop's line). None, or
    what's wrong."""
    if action not in LOOP_ASKS:
        return "done, chase, ask or session"
    text = text.strip() if isinstance(text, str) else ""
    if action == "ask" and not text:
        return "What should your assistant do about it?"
    loops, source, _ = read_loops()
    loop = next((l for l in loops if l["key"] == key), None)
    if not loop:
        return "That loop isn't open any more"
    mine = assistant()
    if not mine:
        return "You have no assistant to tell: make one of your chats your assistant first"
    if action == "chase" and loop["kind"] != "waiting":
        return "Only someone you're waiting on can be chased"
    said = loop["line"]
    since = f" (waiting since {loop['since']})" if loop["since"] else ""
    note = f"\n\n{text[:4000]}" if text else ""
    text = LOOP_ASKS[action].format(said=said, source=source, who=loop["who"] or "them", what=loop["what"], since=since, text=text[:4000], note=note)
    r = run_amarchy("send", mine["id"], text, "--no-wait", env={"AMARCHY_SENT_BY": "you"})      # (your tap: yours)
    if r.returncode != 0:
        return gist(r.stderr) or f"{mine['name']} didn't take it"
    if action == "done":
        mission_log({"kind": "task", "id": f"task:{key}", "task": loop["what"], "repo": ""})
    sent = loops_sent()
    sent[key] = {"action": action, "at": time.time()}
    try:
        write_file(LOOPS_SENT, json.dumps(sent))
    except OSError:
        pass
    return None


def cmd_today(args):
    if args and args[0] == "--loops":
        if len(args) == 1:
            p = loops_path()
            print(p if p else "none")
            return 0
        if args[1] == "off":
            LOOPS_FILE.unlink(missing_ok=True)
            print("No loops file: Today shows your chats only")
            return 0
        p = Path(os.path.expanduser(args[1])).resolve()
        if not p.is_file():
            print(f"amarchy: {p} isn't a file", file=sys.stderr)
            return 1
        write_file(LOOPS_FILE, str(p) + "\n")
        print(f"Today reads your loops from {p}")
        return 0
    ss = session_view()
    for s in ss:
        s["today"] = chat_reply(s)
    t = today_view()
    if "--json" in args:
        print(json.dumps({"needs": needs_you(ss), **t, "sessions": [
            {"id": s["id"], "task": s.get("task", ""), "status": s.get("status"), **s["today"]} for s in ss]}, indent=1))
        return 0
    today = datetime.date.today().isoformat()
    print(f"Needs you: {needs_you(ss)}")
    for s in ss:
        r = s["today"]
        if s.get("status") == "waiting" or (s.get("status") != "working" and r["asks"]):
            ask = r["asks"][0]["question"] if r["asks"] else ask_line(s)
            print(f"  {s.get('task') or s['id']}: {ask}")
    due = sorted((l for l in t["loops"] if l["kind"] == "due"), key=lambda l: l["due"])
    if due:
        print("Due:")
        for l in due:
            print(f"  {l['due']}{' (overdue)' if l['due'] < today else ''}  {l['what']}")
    waiting = [l for l in t["loops"] if l["kind"] == "waiting"]
    if waiting:
        print("Waiting on others:")
        for l in waiting:
            late = " (chase now)" if l["chase"] and l["chase"] <= today else ""
            chase = f" · chase {l['chase']}" if l["chase"] else ""
            print(f"  {l['who']}: {l['what']}{chase}{late}")
    yours = [x for x in t["boards"] if x["yours"]]
    if yours:
        print("On your boards:")
        for x in yours:
            print(f"  {x['title']}{'' if x['title'] == x['lead_name'] else ' (' + x['lead_name'] + ')'}: {x['yours']} for you  [{x['id']}]")
            for c in x["cards"]:
                until = f" (until {task_clock(c['until'])})" if c["until"] else ""
                print(f"    {c['title']}{until}  [{c['id']}]")
    print("Chats:")
    for s in ss:
        r = s["today"]
        state = "running" if s.get("status") == "running" else r["state"] or s.get("status") or ""
        running = f" (running: {s['running']})" if s.get("status") == "running" else ""
        print(f"  [{state}] {s.get('task') or s['id']}{': ' + r['goal'] if r['goal'] else ''}{running}")
    if t["error"]:
        print(t["error"], file=sys.stderr)
    return 0


# ---- Tasks: boards your agents keep, of what depends on you
#
# Tasks is boards (Julian, 2026-11-23: "everything I need in order to
# complete tasks and projects that depend on me and that all my agents can
# edit and that I can just write something and my agent helps me complete
# it"). A board is a project's or an agent's: its columns (the agent says
# which: "For review", "Ready to post", "Posted"...), its cards in them. A
# card: a title, a block the app draws (an xpost first, any of
# app/blocks.json's but a reply's own), a note, links, buttons, its thread.
#
# Your assistant and every agent of yours keep them (amarchy board): any of
# them can add and change cards on any board here, the board's lead (the one
# that made it) hears what you do on it. You, in the app:
#
# - Comment on a card: your words go to its agent as your own message
#   ("About “<card>” (board b, card k): ..."), and stay on the card, its
#   thread. The agent answers there (amarchy board comment), or by revising
#   the card (amarchy board card --key: a new text, a new picture).
# - Press a button: a column's (the same on every card in it) or the card's
#   own, each a message to the agent, a column to move it to, words it asks
#   you first (a reason), or nothing sent (--quiet).
# - Edit it in place (its block's text, its title), move it, take it down.
# - Write a task: a card of yours on a board, its agent told to help you get
#   it done.
#
# Approving is yours alone. A column can need your approval (--approval):
# a card gets into it only by your hand, never an agent's, and its approval
# says who (Tailscale's login), when, and the sha256 of exactly what was
# approved (the card's block: card_sha), signed with a key the agents can't
# read (BOARD_KEY, in the secrets' folder their tools are kept out of). Any
# change to it (yours, an agent's) drops the approval, and the card goes back
# where it was before. So an agent's script posts only what `amarchy board
# approved` says is still approved. The board's check (--check: a command of
# the agent's, a lint) runs on your edit and your approval first: it can
# refuse either, in its words. An agent's tools can't reach the app's board
# actions or the boards' files either (board_guard, hook_settings).
#
# Everything done on a board is in its log (amarchy board log), your edits
# with what was there before, a discard with its reason: what the agents
# learn from.
#
# An agent's own tasks (amarchy task add, from before boards) are cards on
# its own board (its id's, "For you" and "Done"): pressed, a task's button
# sends its message and the task is done.
#
# Kept in BOARDS, a file a board; the app's view has a summary of each and
# the cards of yours on it (today_view "boards"), the whole board when it's
# open (/api/boards/<id>); what you do comes back through /api/boards/*.

BOARDS = STATE / "boards"               # <id>.json: {id, title, lead, columns, check, at, updated, rev, cards}
BOARDS_LOCK = BOARDS / ".lock"
BOARDS_LOG = BOARDS / "log.jsonl"       # every action, a line each
BOARD_KEY = SECRETS / ".board-key"      # signs your approvals (hex); in the secrets' folder: no agent tool reads it
TASKS = STATE / "tasks.json"            # (an agent's tasks before boards: moved onto its board once)
TASK_GRACE = 15 * 60        # s one past its time is kept, out of sight: a button pressed just before it still goes
TASK_MAX = 30               # tasks an agent may have open at once (amarchy task add)
TASK_LINKS, TASK_BUTTONS = 3, 4
TASK_LABEL = 32             # characters in a link's or a button's label
TASK_TITLE, TASK_NOTE, TASK_SEND = 200, 2000, 4000
TASK_ID = re.compile(r"[0-9a-f]{6}")
BOARD_ID = re.compile(r"[a-z0-9][a-z0-9._-]{0,79}")
BOARD_TITLE = 80
BOARD_COLUMNS = 8           # columns a board has at most
BOARD_COLUMN = 32           # characters in a column's name
BOARD_COLUMN_BUTTONS = 4    # a column's buttons
BOARD_CARDS = 500           # cards on a board at most
BOARD_BODY = 25_000         # characters in a card's block
BOARD_COMMENT = 4000        # characters in a comment
BOARD_THREAD = 200          # what a card's thread keeps (the log keeps all)
BOARD_DONE_KEEP = 30 * 86400    # s a card in a done column stays (then only the log has it)
BOARD_LOG_MAX = 5_000_000   # bytes of the log, the older half dropped past it
BOARD_CHECK_TIME = 20       # s the board's check may take
BOARD_SHOW = 3              # cards of yours each board has in the app's view (Tasks; the board has all)
BOARD_NOT = {"brief", "actions", "choices", "goal"}     # a reply's own blocks, never a card's
BOARD_DEFAULT = [{"name": "To do", "yours": True}, {"name": "Doing"}, {"name": "Done", "done": True}]
TASK_BOARD = [{"name": "For you", "yours": True}, {"name": "Done", "done": True}]
_boards_memo = {}           # file -> ((mtime, size), board)


def board_file(bid):
    return BOARDS / f"{bid}.json"


def board_load(f):
    """A board as written (None if it isn't one), read again only when its file changed."""
    try:
        st = f.stat()
        key = (st.st_mtime_ns, st.st_size)
    except OSError:
        return None
    memo = _boards_memo.get(str(f))
    if memo and memo[0] == key:
        return copy.deepcopy(memo[1])
    try:
        b = json.loads(f.read_text())
    except (OSError, ValueError):
        return None
    if not (isinstance(b, dict) and isinstance(b.get("id"), str) and isinstance(b.get("lead"), str)
            and isinstance(b.get("columns"), list) and isinstance(b.get("cards"), list)):
        return None
    b["cards"] = [c for c in b["cards"] if isinstance(c, dict) and isinstance(c.get("id"), str)]
    _boards_memo[str(f)] = (key, b)
    return copy.deepcopy(b)


def boards_all():
    """Every board here, as written (boards_view says which are in sight)."""
    tasks_migrate()
    try:
        files = sorted(BOARDS.glob("*.json"))
    except OSError:
        return []
    return [b for b in (board_load(f) for f in files) if b]


def board_get(bid):
    tasks_migrate()
    return board_load(board_file(bid)) if isinstance(bid, str) and BOARD_ID.fullmatch(bid) else None


def boards_change(fn):
    """Change the boards in one go, under their lock: fn(boards), boards a
    dict id -> board, changes them in place (adds, deletes) and returns what
    this returns. What's long gone goes too (board_prune)."""
    BOARDS.mkdir(parents=True, exist_ok=True)
    with open(BOARDS_LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        tasks_migrate(locked=True)
        boards = {}
        for f in sorted(BOARDS.glob("*.json")):
            _boards_memo.pop(str(f), None)
            b = board_load(f)
            if b:
                boards[b["id"]] = b
        before = {k: json.dumps(v, sort_keys=True) for k, v in boards.items()}
        out = fn(boards)
        now = time.time()
        for bid in list(boards):
            b = boards[bid]
            board_prune(b, now)
            if b.get("task") and not b["cards"] and not session(b["lead"]):
                del boards[bid]         # a closed agent's own board, its tasks gone with it
        for bid, b in boards.items():
            text = json.dumps(b, sort_keys=True)
            if before.get(bid) != text:
                b["rev"] = int(b.get("rev") or 0) + 1
                b["updated"] = now
                write_file(board_file(bid), json.dumps(b, ensure_ascii=False))
        for bid in set(before) - set(boards):
            try:
                board_file(bid).unlink()
            except OSError:
                pass
        return out


def board_prune(b, now):
    """What goes by itself: a task past its time (and its grace), a card done
    a month ago, every card of a closed agent's own board."""
    done = {c["name"] for c in b["columns"] if c.get("done")}
    gone_agent = b.get("task") and not session(b["lead"])
    b["cards"] = [c for c in b["cards"] if not gone_agent
                  and not (c.get("until") and c["until"] + TASK_GRACE < now)
                  and not (c.get("column") in done and (c.get("done_at") or c.get("updated") or 0) + BOARD_DONE_KEEP < now)]


def tasks_migrate(locked=False):
    """An agent's tasks from before boards (TASKS): each a card on its own
    board, once. Then the file is kept aside (tasks.json.moved)."""
    if not TASKS.exists():
        return
    if not locked:
        boards_change(lambda boards: None)      # (it moves them, under the lock)
        return
    try:
        old = json.loads(TASKS.read_text())
    except (OSError, ValueError):
        old = []
    now = time.time()
    for t in old if isinstance(old, list) else []:
        if not (isinstance(t, dict) and isinstance(t.get("agent"), str) and isinstance(t.get("id"), str)):
            continue
        if t.get("until") and t["until"] + TASK_GRACE < now:
            continue
        f = board_file(t["agent"])
        b = board_load(f) or task_board_new(t["agent"])
        if not any(c["id"] == t["id"] for c in b["cards"]):
            b["cards"].append(card_new(t["agent"], t["agent"], id=t["id"], key=t.get("key") or "", title=t.get("title") or "",
                                       note=t.get("note") or "", links=t.get("links") or [], buttons=t.get("buttons") or [],
                                       until=t.get("until") or 0, at=t.get("at") or now, column=TASK_BOARD[0]["name"], task=True))
        write_file(f, json.dumps(b, ensure_ascii=False))
    try:
        os.replace(TASKS, TASKS.with_name("tasks.json.moved"))
    except OSError:
        pass


def task_board_new(agent):
    """An agent's own board, for its tasks: its name, "For you" and "Done"."""
    return {"id": agent, "title": "", "lead": agent, "columns": copy.deepcopy(TASK_BOARD), "check": "", "task": True,
            "at": time.time(), "updated": time.time(), "rev": 0, "cards": []}


def card_new(agent, by, **kw):
    now = time.time()
    c = {"id": "", "key": "", "title": "", "column": "", "block": None, "note": "", "links": [], "buttons": [],
         "agent": agent, "by": by, "at": now, "updated": now, "until": 0, "thread": [], "approval": None}
    c.update(kw)
    return c


def card_taken_ids(boards):
    return {c["id"] for b in boards.values() for c in b["cards"]}


def card_id(boards):
    taken = card_taken_ids(boards)
    return next(i for i in iter(lambda: os.urandom(3).hex(), None) if i not in taken)


def card_find(b, ref):
    """A card on a board by its key, else by its id."""
    if not ref:
        return None
    return next((c for c in b["cards"] if c.get("key") and c["key"] == ref), None) \
        or next((c for c in b["cards"] if c["id"] == ref), None)


def card_ref(c):
    """How an agent names a card: its key, else its id."""
    return c.get("key") or c["id"]


def board_column(b, name):
    return next((c for c in b["columns"] if c["name"] == name), None)


def board_column_named(b, name):
    """A column by its name as written, any case."""
    return next((c for c in b["columns"] if c["name"].lower() == (name or "").strip().lower()), None)


def board_first(b, *, approval=False):
    """Where a new card goes: the first column (not one that needs your approval)."""
    return next((c["name"] for c in b["columns"] if approval or not c.get("approval")), b["columns"][0]["name"])


def board_done_column(b):
    return next((c["name"] for c in b["columns"] if c.get("done")), None)


def card_open(b, c, now=None):
    """Not past its time."""
    return not c.get("until") or c["until"] > (now or time.time())


def card_content(c):
    """What a card's approval is of: its block (kind, attributes, text), else its note."""
    blk = c.get("block")
    if blk:
        return {"kind": blk.get("kind") or "", "attrs": blk.get("attrs") or {}, "body": blk.get("body") or ""}
    return {"note": c.get("note") or ""}


def card_sha(c):
    """The sha256 of a card's content (card_content), as JSON with its keys
    in order, no spaces, UTF-8: what an approval is of."""
    return hashlib.sha256(json.dumps(card_content(c), sort_keys=True, separators=(",", ":"), ensure_ascii=False)
                          .encode()).hexdigest()


def card_text(c):
    """A card's text: its block's, else its note."""
    blk = c.get("block")
    return (blk.get("body") or "") if blk else (c.get("note") or "")


_board_key = {}


def board_key():
    """The key your approvals are signed with: made once, 0600, in the
    secrets' folder (no agent's tool reads there)."""
    if _board_key.get("path") == str(BOARD_KEY):
        return _board_key["key"]
    k = board_key_read()
    _board_key.update(path=str(BOARD_KEY), key=k)
    return k


def board_key_read():
    try:
        k = BOARD_KEY.read_text().strip()
        if re.fullmatch(r"[0-9a-f]{64}", k):
            return bytes.fromhex(k)
    except OSError:
        pass
    BOARD_KEY.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(BOARD_KEY.parent, 0o700)
    k = os.urandom(32)
    tmp = BOARD_KEY.with_name(f".board-key.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(k.hex() + "\n")
    try:
        os.link(tmp, BOARD_KEY)      # (one made by another at the same moment wins)
    except FileExistsError:
        pass
    finally:
        tmp.unlink(missing_ok=True)
    return bytes.fromhex(BOARD_KEY.read_text().strip())


def approval_sig(bid, cid, sha, by, at):
    msg = f"amarchy-approval\n{bid}\n{cid}\n{sha}\n{by}\n{at:.3f}".encode()
    return hmac.new(board_key(), msg, hashlib.sha256).hexdigest()


def approval_of(bid, c):
    """A card's approval, when it's yours and still of what it has now:
    {by, at, sha256}; else None."""
    a = c.get("approval")
    if not isinstance(a, dict) or not isinstance(a.get("at"), (int, float)) or a.get("sha256") != card_sha(c):
        return None
    if not hmac.compare_digest(str(a.get("sig") or ""), approval_sig(bid, c["id"], a["sha256"], str(a.get("by") or ""), a["at"])):
        return None
    return {"by": a.get("by") or "", "at": a["at"], "sha256": a["sha256"]}


def card_unapprove(b, c, who, why):
    """The approval dropped (its content changed, it was moved back): the card
    back where it was before, if it's still in a column that needs it."""
    had = c.get("approval")
    c["approval"] = None
    col = board_column(b, c.get("column"))
    if col and col.get("approval"):
        back = (had or {}).get("from")
        to = back if back and board_column(b, back) and not board_column(b, back).get("approval") else board_first(b)
        thread_add(c, who, "move", text=why, column=to, was=c["column"])
        c["column"] = to
        c["moved"] = time.time()


def thread_add(c, who, kind, **kw):
    item = {"at": time.time(), "who": who, "kind": kind, **{k: v for k, v in kw.items() if v not in (None, "")}}
    c.setdefault("thread", []).append(item)
    del c["thread"][:-BOARD_THREAD]
    return item


def board_log(b, c, who, action, **kw):
    """One line of the board's log: what was done, by whom, to which card."""
    BOARDS.mkdir(parents=True, exist_ok=True)
    row = {"at": time.time(), "board": b["id"], "card": c["id"] if c else None, "key": (c or {}).get("key") or None,
           "title": (c or {}).get("title") or None, "who": who, "action": action,
           **{k: v for k, v in kw.items() if v not in (None, "")}}
    try:
        if BOARDS_LOG.exists() and BOARDS_LOG.stat().st_size > BOARD_LOG_MAX:
            lines = BOARDS_LOG.read_text().splitlines()
            write_file(BOARDS_LOG, "\n".join(lines[len(lines) // 2:]) + "\n")
        with open(BOARDS_LOG, "a") as fh:
            fh.write(json.dumps(row, ensure_ascii=False) + "\n")
    except OSError:
        pass


def board_lead_name(b, crew=None):
    who = next((a for a in (team() if crew is None else crew) if a["id"] == b["lead"]), None)
    return who["name"] if who else b["lead"]


def board_title(b, crew=None):
    """A board's name: its own, else an agent's own board its agent's, any
    other its id's words ("ideas": Ideas)."""
    if b.get("title"):
        return b["title"]
    return board_lead_name(b, crew) if b.get("task") else re.sub(r"[-_.]+", " ", b["id"]).strip().capitalize() or b["id"]


def card_agent(b, c, crew=None):
    """Who hears what you do on a card: its own agent, while it's on your
    team, else the board's lead."""
    ids = {a["id"] for a in (team() if crew is None else crew)}
    return c.get("agent") if c.get("agent") in ids else b["lead"]


def card_buttons(b, c):
    """A card's buttons: its column's, then its own (an agent's task with
    none has Done). Each {label, send, to, asks, own}."""
    col = board_column(b, c.get("column")) or {}
    out = [{**x, "own": False} for x in col.get("buttons") or []]
    if col.get("done"):
        return out          # done: its own buttons are done with (its column's, as Restore, stay)
    own = c.get("buttons") or []
    if not own and c.get("task"):
        own = [{"label": "Done", "send": f"Done: {c.get('title') or ''}"}]
    return out + [{**x, "own": True} for x in own]


def button_words(b, c, button, words):
    """What a button sends: its message, the card's name in it ({title},
    {key}, {board}, {column}), and what it asked you ({words}, else after
    it). "" sends nothing."""
    send = button.get("send")
    if send is None:
        send = f"{button['label']}: “{c.get('title') or ''}” (board {b['id']}, card {card_ref(c)})"
    if not send:
        return ""
    fills = {"title": c.get("title") or "", "key": card_ref(c), "board": b["id"], "column": c.get("column") or "",
             "words": words or ""}
    text = re.sub(r"\{(title|key|board|column|words)\}", lambda m: fills[m.group(1)], send)
    if words and "{words}" not in send:
        text = f"{text}: {words}"
    return text


def board_tell(agent, text):
    """Something you did on a board, to its agent, as your own message
    (amarchy send: waking it). None, or why it didn't go."""
    r = run_amarchy("send", agent, text, "--no-wait", env={"AMARCHY_SENT_BY": "you"})
    return None if r.returncode == 0 else gist(r.stderr) or "Its agent didn't take it"


def board_check(b, c, action, column, text):
    """The board's check on what you're about to save or approve: its
    command, with the text on its input. None, or what it said (refused)."""
    cmd = (b.get("check") or "").strip()
    if not cmd:
        return None
    lead = session(b["lead"])
    cwd = lead["path"] if lead and Path(lead.get("path") or "").is_dir() else str(HOME)
    env = {**clean_env(), "AMARCHY_BOARD": b["id"], "AMARCHY_CARD": c["id"], "AMARCHY_CARD_KEY": c.get("key") or "",
           "AMARCHY_CARD_TITLE": c.get("title") or "", "AMARCHY_CARD_COLUMN": column or "",
           "AMARCHY_CARD_ACTION": action, "AMARCHY_CARD_KIND": (c.get("block") or {}).get("kind") or ""}
    try:
        r = subprocess.run(["bash", "-c", cmd], input=text, capture_output=True, text=True, cwd=cwd, env=env,
                           timeout=BOARD_CHECK_TIME)
    except subprocess.TimeoutExpired:
        return f"The board's check took over {BOARD_CHECK_TIME} s"
    except OSError as e:
        return f"The board's check didn't run: {e}"
    if r.returncode == 0:
        return None
    said = " ".join((r.stdout + "\n" + r.stderr).split())
    return said[:600] or f"The board's check said no (exit {r.returncode})"


# ---- what the app shows

def card_view(b, c, crew, thread=None):
    """A card as the app draws it."""
    who = {a["id"]: a["name"] for a in crew}
    agent = card_agent(b, c, crew)
    items = c.get("thread") or []
    yours = [i for i, x in enumerate(items) if x.get("who") == "you" and x.get("kind") in ("comment", "edit", "press")]
    last = items[-1] if items else None
    # The agent answered since your last word: a reply, a revision.
    answered = bool(yours and last and last.get("who") != "you" and last.get("kind") in ("comment", "revise")
                    and len(items) - 1 > yours[-1])
    return {"id": c["id"], "key": c.get("key") or "", "title": c.get("title") or "", "column": c.get("column") or "",
            "block": c.get("block"), "note": c.get("note") or "", "links": c.get("links") or [],
            "buttons": [{"label": x["label"], "to": x.get("to") or "", "asks": x.get("asks") or "", "own": x["own"],
                         "send": button_words(b, c, x, "")} for x in card_buttons(b, c)],
            "agent": agent, "agent_name": who.get(agent, agent), "by": c.get("by") or "", "at": c.get("at") or 0,
            "updated": c.get("updated") or 0, "until": c.get("until") or 0, "task": bool(c.get("task")),
            "approved": approval_of(b["id"], c), "sha256": card_sha(c), "answered": answered,
            "edited": bool(c.get("edited")), "count": len(items),
            "thread": [{**x, "name": "You" if x.get("who") == "you" else who.get(x.get("who"), x.get("who"))}
                       for x in (items if thread is None else items[-thread:] if thread else [])]}


def card_order(b, c):
    """Cards in a column: the one going soonest first, then as they came."""
    return (not c.get("until"), c.get("until") or 0, c.get("moved") or c.get("at") or 0, c["id"])


def board_summary(b, crew, show=BOARD_SHOW):
    """A board as Tasks shows it: its name, lead, columns (with how many
    cards each), how many are yours (in a column that waits on you), and the
    first of those."""
    now = time.time()
    cards = sorted((c for c in b["cards"] if card_open(b, c, now)), key=lambda c: card_order(b, c))
    yours_cols = {c["name"] for c in b["columns"] if c.get("yours")}
    yours = [c for c in cards if c.get("column") in yours_cols]
    role = next((a["role"] for a in crew if a["id"] == b["lead"]), "")
    return {"id": b["id"], "title": board_title(b, crew), "lead": b["lead"], "lead_name": board_lead_name(b, crew), "role": role,
            "task": bool(b.get("task")), "check": bool(b.get("check")), "rev": b.get("rev") or 0,
            "updated": b.get("updated") or 0, "at": b.get("at") or 0,
            "columns": [{"name": x["name"], "yours": bool(x.get("yours")), "approval": bool(x.get("approval")),
                         "done": bool(x.get("done")), "count": sum(1 for c in cards if c.get("column") == x["name"])}
                        for x in b["columns"]],
            "yours": len(yours), "cards": [card_view(b, c, crew, thread=3) for c in yours[:show]]}


def boards_view(crew=None):
    """Every board in sight (its lead on your team), as Tasks shows them:
    your assistant's first, then your agents' in their order, each one's
    in the order they were made."""
    crew = team() if crew is None else crew
    order = {a["id"]: i for i, a in enumerate(crew)}
    bs = [b for b in boards_all() if b["lead"] in order and (not b.get("task") or b["cards"])]
    bs.sort(key=lambda b: (order[b["lead"]], not b.get("task"), b.get("at") or 0, b["id"]))
    return [board_summary(b, crew) for b in bs]


def board_whole(bid, crew=None):
    """One board, every card in sight: what the app's open board shows."""
    crew = team() if crew is None else crew
    b = board_get(bid)
    if not b or b["lead"] not in {a["id"] for a in crew}:
        return None
    now = time.time()
    cards = sorted((c for c in b["cards"] if card_open(b, c, now)), key=lambda c: card_order(b, c))
    return {**board_summary(b, crew, show=0), "cards": [card_view(b, c, crew, thread=60) for c in cards]}


def tasks_view(crew=None):
    """Your agents' tasks as they were before boards (an older machine's
    board reads them): the open cards of each agent's own board."""
    crew = team() if crew is None else crew
    who = {a["id"]: a for a in crew}
    now = time.time()
    out = []
    for b in boards_all():
        if not b.get("task") or b["lead"] not in who:
            continue
        done = board_done_column(b)
        for c in b["cards"]:
            if c.get("column") != done and card_open(b, c, now):
                out.append({"id": c["id"], "agent": b["lead"], "agent_name": who[b["lead"]]["name"], "title": c.get("title") or "",
                            "note": c.get("note") or "", "links": c.get("links") or [],
                            "buttons": [{"label": x["label"], "send": button_words(b, c, x, "")} for x in card_buttons(b, c) if x["own"]],
                            "until": c.get("until") or 0, "at": c.get("at") or 0})
    return sorted(out, key=lambda t: (not t["until"], t["until"] or t["at"], t["at"], t["id"]))


# ---- what you do, in the app (/api/boards/*)

def board_act(bid, cid, fn):
    """fn(board, card, boards) under the boards' lock, on that card: its
    answer, or (None, what's wrong)."""
    if not isinstance(bid, str) or not BOARD_ID.fullmatch(bid) or not isinstance(cid, str) or not TASK_ID.fullmatch(cid):
        return None, "which board (board) and which of its cards (card)"

    def act(boards):
        b = boards.get(bid)
        if not b or b["lead"] not in {a["id"] for a in team()}:
            return None, "That board is gone"
        c = next((x for x in b["cards"] if x["id"] == cid), None)
        if not c:       # (one past its time is still there a while: a button pressed just before it still goes)
            return None, "That card is gone: its agent took it down, or its time ran out"
        return fn(b, c, boards)
    return boards_change(act)


def board_approve(b, c, by, column):
    """You moved a card into a column that needs your approval: it's
    approved, of exactly what it has now, signed."""
    at = round(time.time(), 3)
    sha = card_sha(c)
    c["approval"] = {"by": by, "at": at, "sha256": sha, "sig": approval_sig(b["id"], c["id"], sha, by, at),
                     "from": c.get("column") if not (board_column(b, c.get("column")) or {}).get("approval") else None}
    board_log(b, c, "you", "approve", by=by, sha256=sha, column=column)


def board_move_to(b, c, to, who, by="", thread=True):
    """A card into another column (to, its name): an approval column's
    approval yours (board_approve, before it moves), leaving one drops it
    (not for a done column: posted as approved). thread: said on its thread
    (a button's press says it there itself)."""
    was = c.get("column")
    if to == was:
        return
    target = board_column(b, to)
    if target.get("approval"):
        board_approve(b, c, by, to)
    elif (board_column(b, was) or {}).get("approval") and not target.get("done"):
        c["approval"] = None
    c["column"] = to
    c["moved"] = time.time()
    c["done_at"] = time.time() if target.get("done") else None
    if thread:
        thread_add(c, who, "move", column=to, was=was, approved=True if target.get("approval") else None)
    board_log(b, c, who, "move", column=to, was=was)


def board_you_check(bid, cid, action, column=None, text=None):
    """The board's check, outside the lock (it may take a while): None, or
    why it refused."""
    b = board_get(bid)
    c = card_find(b, cid) if b else None
    if not b or not c:
        return None
    return board_check(b, c, action, column or c.get("column"), card_text(c) if text is None else text)


def board_press(bid, cid, n, words, by, base=None):
    """A button on a card, pressed in the app: its message to the agent,
    the card moved where it says (a card's own button without one, a task's:
    to the done column), what it asked of you on its thread. base: the
    sha256 of the card as you saw it (an approval is of what you saw: a
    change since refuses it). None, or what's wrong (then nothing happened)."""
    words = " ".join(str(words or "").split())[:BOARD_COMMENT]
    b0 = board_get(bid)
    c0 = next((x for x in (b0 or {}).get("cards", []) if x["id"] == cid), None)
    if b0 and c0 and isinstance(n, int) and 0 <= n < len(card_buttons(b0, c0)):
        button = card_buttons(b0, c0)[n]
        to = button.get("to") or (board_done_column(b0) if button["own"] else None)
        if to and (board_column(b0, to) or {}).get("approval"):
            why = board_check(b0, c0, "approve", to, card_text(c0))
            if why:
                return why
    sha0 = card_sha(c0) if c0 else None

    def press(b, c, boards):
        buttons = card_buttons(b, c)
        if not isinstance(n, int) or isinstance(n, bool) or not 0 <= n < len(buttons):
            return None, "That card has no such button"
        if card_sha(c) != sha0 or (base and card_sha(c) != base):
            return None, "That card changed since you looked: look at it again"
        button = buttons[n]
        if button.get("asks") and not words:
            return None, f"{button['label']} asks you first: {button['asks']}"
        to = button.get("to") or (board_done_column(b) if button["own"] else None)
        if to and not board_column(b, to):
            to = None
        text = button_words(b, c, button, words)
        if text:
            why = board_tell(card_agent(b, c), text)
            if why:
                return None, why
        thread_add(c, "you", "press", label=button["label"], text=words, column=to if to != c.get("column") else None,
                   approved=True if to and (board_column(b, to) or {}).get("approval") else None)
        board_log(b, c, "you", "press", label=button["label"], words=words, sent=text)
        if to:
            board_move_to(b, c, to, "you", by, thread=False)
        return {"ok": True}, None
    return board_act(bid, cid, press)[1]


def board_comment_you(bid, cid, text):
    """Your comment on a card: on its thread, and to its agent as your own
    message. None, or what's wrong."""
    text = str(text or "").strip()
    if not text:
        return "Write something first"
    if len(text) > BOARD_COMMENT:
        return f"A comment is {BOARD_COMMENT} characters at most"

    def comment(b, c, boards):
        why = board_tell(card_agent(b, c), f"About “{c.get('title') or 'a card'}” (board {b['id']}, card {card_ref(c)}): {text}")
        if why:
            return None, why
        thread_add(c, "you", "comment", text=text)
        board_log(b, c, "you", "comment", text=text)
        return {"ok": True}, None
    return board_act(bid, cid, comment)[1]


def board_move_you(bid, cid, column, by, base=None):
    """You moved a card (its menu's Move to): into a column that needs your
    approval, it's approved (after the board's check), of what you saw
    (base). None, or what's wrong."""
    b0 = board_get(bid)
    col = board_column(b0, column) if b0 else None
    if not col:
        return "That board has no such column"
    if col.get("approval"):
        why = board_you_check(bid, cid, "approve", column)
        if why:
            return why
    c0 = card_find(b0, cid)
    sha0 = card_sha(c0) if c0 else None

    def move(b, c, boards):
        if not board_column(b, column):
            return None, "That board has no such column"
        if card_sha(c) != sha0 or (base and card_sha(c) != base):
            return None, "That card changed since you looked: look at it again"
        board_move_to(b, c, column, "you", by)
        return {"ok": True}, None
    return board_act(bid, cid, move)[1]


def board_edit_you(bid, cid, title, body, base):
    """You edited a card in place: its title, its text (its block's, else its
    note). Its approval goes (the board's check first, on the new text);
    what was there before is on its thread and in the log. Nothing is sent:
    the agent finds it on the card. None, or what's wrong."""
    title = None if title is None else " ".join(str(title).split())
    if title is not None and not 0 < len(title) <= TASK_TITLE:
        return f"A card's title is 1 to {TASK_TITLE} characters"
    body = None if body is None else str(body).replace("\r\n", "\n").rstrip()
    if body is not None and len(body) > BOARD_BODY:
        return f"A card's text is {BOARD_BODY} characters at most"
    if body is not None and re.search(r"^\s*```", body, re.M):
        return "A card's text can't have a ``` line in it"
    b0 = board_get(bid)
    c0 = card_find(b0, cid) if b0 else None
    if c0 and body is not None and body != card_text(c0):
        why = board_check(b0, c0, "edit", c0.get("column"), body)
        if why:
            return why

    def edit(b, c, boards):
        if base and card_sha(c) != base:
            return None, "Its agent changed it while you were editing: look at it again"
        changed = False
        if title is not None and title != c.get("title"):
            thread_add(c, "you", "edit", what="title", before=c.get("title"), after=title)
            board_log(b, c, "you", "edit", what="title", before=c.get("title"), after=title)
            c["title"] = title
            changed = True
        if body is not None and body != card_text(c):
            before = card_text(c)
            if c.get("block"):
                if not body.strip() and (block_kinds().get(c["block"]["kind"]) or {}).get("body", {}).get("need"):
                    return None, "Its text can't be empty"
                c["block"]["body"] = body
            else:
                c["note"] = body
            c["edited"] = {"at": time.time(), "sha256": card_sha(c)}
            thread_add(c, "you", "edit", what="text", before=before, after=body)
            board_log(b, c, "you", "edit", what="text", before=before, after=body)
            if c.get("approval"):
                card_unapprove(b, c, "you", "Edited: not approved any more")
            changed = True
        if changed:
            c["updated"] = time.time()
        return {"ok": True, "sha256": card_sha(c)}, None
    return board_act(bid, cid, edit)[1]


def board_remove_you(bid, cid):
    """You took a card down (with Undo, in the app). Nothing is sent; the log
    has it, as it was."""
    def remove(b, c, boards):
        b["cards"].remove(c)
        board_log(b, c, "you", "remove", text=card_text(c), column=c.get("column"))
        return {"ok": True}, None
    return board_act(bid, cid, remove)[1]


def board_add_you(bid, text, column=None):
    """A task you wrote, on a board: a card of yours (its first line its
    title, the rest its note), in a column of yours there, and its lead
    told, to help you get it done. ({id}, None), or (None, what's wrong)."""
    text = str(text or "").replace("\r\n", "\n").strip()
    if not text:
        return None, "Write the task first"
    if len(text) > TASK_NOTE + TASK_TITLE:
        return None, f"A task is {TASK_NOTE} characters at most"
    first, _, rest = text.partition("\n")
    title = " ".join(first.split())
    if len(title) > TASK_TITLE:
        title, rest = cut_words(title, TASK_TITLE), text
    if not isinstance(bid, str) or not BOARD_ID.fullmatch(bid):
        return None, "Which board"

    def add(boards):
        b = boards.get(bid)
        if not b and bid in {a["id"] for a in team()}:
            b = boards[bid] = task_board_new(bid)        # an agent's own board, made for its first task
        if not b or b["lead"] not in {a["id"] for a in team()}:
            return None, "That board is gone"
        if len(b["cards"]) >= BOARD_CARDS:
            return None, f"That board has {BOARD_CARDS} cards: take some down first"
        col = board_column(b, column) if column else None
        to = col["name"] if col and not col.get("approval") else \
            next((x["name"] for x in b["columns"] if x.get("yours") and not x.get("approval")), board_first(b))
        c = card_new(b["lead"], "you", id=card_id(boards), title=title, note=rest.strip(), column=to, task=bool(b.get("task")))
        why = board_tell(b["lead"], f"{text}\n\n(A task of mine on {'your board' if b.get('task') else f'the board “{board_title(b)}”'}: "
                                    f"board {b['id']}, card {c['id']}. Help me get it done: answer me on the card, "
                                    f"amarchy board comment {b['id']} {c['id']} \"…\", and move it along.)")
        if why:
            return None, why
        b["cards"].append(c)
        board_log(b, c, "you", "add", text=text, column=to)
        return {"id": c["id"], "board": b["id"]}, None
    return boards_change(add)


def cut_words(text, n):
    return text if len(text) <= n else text[:n - 1].rsplit(" ", 1)[0].rstrip() + "…"


def board_notify(b, c, crew=None):
    """A card on your phones, under its agent's name and picture; a tap
    opens its board. None, or why it didn't go."""
    if not app_subscriptions():
        return "no phone or browser has turned on notifications yet (in the app: the gear, then Turn on notifications)"
    crew = team() if crew is None else crew
    who = next((a for a in crew if a["id"] == card_agent(b, c, crew)), None) or {"name": "Your agent", "role": "agent", "id": b["lead"]}
    title = c["title"] if c["title"].lower().startswith(who["name"].lower()) else f"{who['name']}: {c['title']}"
    n = push_all({"title": title[:200], "body": (c.get("note") or card_text(c))[:2000], "tag": f"amarchy-card-{c['id']}",
                  "url": f"/#/b/{urllib.parse.quote(b['id'])}", "icon": team_icon(who)})
    return None if n else "no phone took it"


# ---- the CLI: amarchy board (an agent's side) and amarchy task

def board_who(args_agent=None):
    """Who runs it: (one of your team, None), or (None, what's wrong)."""
    sid = args_agent or os.environ.get("AMARCHY_SESSION") or ""
    if not sid:
        return None, "who's asking: --agent <id> (from an agent's own chat, it's itself)"
    if not session(sid):
        return None, f"No session {sid!r}"
    who = next((a for a in team() if a["id"] == sid), None)
    if not who:
        return None, (f"{sid} isn't your assistant or one of your agents, and only they keep boards "
                      f"(amarchy agents {sid} makes it one)")
    return who, None


def board_parse_button(v, title=None):
    """--button <label>[=<message>]: {label, send}, or what's wrong. Without a
    message it sends "<label>: “<card>” (board, card)" (send None)."""
    label, eq, send = (v or "").partition("=")
    label, send = label.strip(), send.strip()
    if not label or len(label) > TASK_LABEL:
        return f"--button takes <label>[=<message>], the label 1 to {TASK_LABEL} characters (not {v!r})"
    if len(send) > TASK_SEND:
        return f"a button's message is {TASK_SEND} characters at most"
    return {"label": label, "send": send if eq and send else None}


def task_link(v):
    """--link [<label>=]<url>: {label, url}, or what's wrong."""
    v = (v or "").strip()
    label, url = ("Open", v) if re.match(r"https?://", v, re.I) else (x.strip() for x in v.partition("=")[::2])
    if not re.fullmatch(r"https?://\S+", url, re.I):
        return f"--link takes [<label>=]<url>, the url an http(s) one (not {v!r})"
    if not label or len(label) > TASK_LABEL:
        return f"a link's label is 1 to {TASK_LABEL} characters"
    return {"label": label, "url": url}


def task_clock(when):
    """A task's time, as said here: 10:12, or Thu 10:12 when it isn't today."""
    d = datetime.datetime.fromtimestamp(when)
    return d.strftime("%H:%M") if d.date() == datetime.date.today() else d.strftime("%a %H:%M")


def task_until(word, now=None):
    """--until: when a task is no use any more. A date and time
    (2026-11-19T10:12-05:00; this machine's zone without one), a time today
    (10:12), or how long from now (45m, 2h, 1h30m, 1d). (when, None), or
    (None, what's wrong)."""
    now = now or time.time()
    w = (word or "").strip()
    m = re.fullmatch(r"(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m(?:in)?)?", w.lower())
    if w and m and any(m.groups()):
        d, hh, mm = (int(x or 0) for x in m.groups())
        when = now + d * 86400 + hh * 3600 + mm * 60
    else:
        try:
            if re.fullmatch(r"\d{1,2}:\d{2}", w):
                hh, mm = map(int, w.split(":"))
                when = datetime.datetime.fromtimestamp(now).replace(hour=hh, minute=mm, second=0, microsecond=0).timestamp()
            else:
                when = datetime.datetime.fromisoformat(w).timestamp()
        except ValueError:
            return None, f"--until takes a time: 2026-11-19T10:12-05:00, 10:12 (today), or 45m, 2h, 1d from now (not {word!r})"
    if when <= now:
        return None, f"--until {word} is past already (it's {task_clock(now)} here)"
    if when - now > 31 * 86400:
        return None, "--until is a month away at most"
    return when, None


def board_parse_columns(specs):
    """--column groups into columns: [{name, yours, approval, done, buttons}],
    or what's wrong."""
    cols, names = [], set()
    for spec in specs:
        name = " ".join(spec["name"].split())
        if not name or len(name) > BOARD_COLUMN:
            return f"a column's name is 1 to {BOARD_COLUMN} characters (not {spec['name']!r})"
        if name.lower() in names:
            return f"two columns are called {name!r}"
        names.add(name.lower())
        if len(spec["buttons"]) > BOARD_COLUMN_BUTTONS:
            return f"a column has {BOARD_COLUMN_BUTTONS} buttons at most ({name!r} has {len(spec['buttons'])})"
        if spec.get("approval") and spec.get("done"):
            return f"{name!r} can't both need your approval and be done"
        cols.append({"name": name, **{k: True for k in ("yours", "approval", "done") if spec.get(k)},
                     "buttons": spec["buttons"]})
    if len(cols) > BOARD_COLUMNS:
        return f"a board has {BOARD_COLUMNS} columns at most"
    if cols and all(c.get("approval") for c in cols):
        return "a board needs a column that doesn't need your approval, for new cards"
    for c in cols:
        for x in c["buttons"]:
            if x.get("to") and x["to"].lower() not in names:
                return f"{c['name']!r}'s button {x['label']!r} moves to {x['to']!r}, which isn't one of its columns"
            if x.get("to"):
                x["to"] = next(y["name"] for y in cols if y["name"].lower() == x["to"].lower())
    return cols


def board_card_buttons_check(b, buttons):
    for x in buttons:
        if x.get("to"):
            col = board_column_named(b, x["to"])
            if not col:
                return f"the button {x['label']!r} moves to {x['to']!r}, which isn't one of {b['id']}'s columns"
            x["to"] = col["name"]
    return None


def board_args(args, card=False):
    """An agent's options for a board (set) or a card (card), in order:
    a --button after a --column is that column's, --to / --asks / --quiet
    are about the --button before them. (options, None) or (None, why)."""
    o = {"columns": None, "buttons": [], "links": [], "attrs": {}, "flags": set()}
    single = {"--title", "--lead", "--check", "--key", "--column", "--block", "--body", "--xpost", "--media", "--note",
              "--until", "--agent", "--base", "--handle", "--name", "--avatar"} if card else {"--title", "--lead", "--check", "--agent"}
    it = iter(args)
    last = None     # the button the modifiers are about
    for a in it:
        if a in ("--notify", "--over-edit", "--no-check", "--clear-buttons", "--clear-links", "--quiet", "--yours",
                 "--approval", "--done"):
            if a == "--quiet":
                if not last:
                    return None, "--quiet is about the --button before it"
                last["send"] = ""
            elif a in ("--yours", "--approval", "--done"):
                if card or not o["columns"]:
                    return None, f"{a} is about the --column before it (amarchy board set)"
                o["columns"][-1][a[2:]] = True
            else:
                o["flags"].add(a)
            continue
        if not a.startswith("--"):
            return None, f"what's {a!r}? (amarchy board --help)"
        v = next(it, None)
        if v is None:
            return None, f"{a} takes a value (amarchy board --help)"
        if a == "--column" and not card:
            o["columns"] = (o["columns"] or []) + [{"name": v, "buttons": []}]
            last = None
        elif a == "--button":
            x = board_parse_button(v)
            if isinstance(x, str):
                return None, x
            (o["columns"][-1]["buttons"] if not card and o["columns"] else o["buttons"]).append(x)
            if not card and not o["columns"]:
                return None, "a board's --button is a column's: put it after its --column"
            last = x
        elif a in ("--to", "--asks"):
            if not last:
                return None, f"{a} is about the --button before it"
            if a == "--asks" and not 0 < len(v.strip()) <= 120:
                return None, "--asks is what the button asks you first, 1 to 120 characters"
            last[a[2:]] = v.strip()
        elif a == "--link" and card:
            o["links"].append(v)
        elif a == "--attr" and card:
            k, eq, val = v.partition("=")
            if not eq or not re.fullmatch(r"\w{1,20}", k.strip()):
                return None, f"--attr takes <name>=<value> (not {v!r})"
            o["attrs"][k.strip().lower()] = val
        elif a in single:
            o[a[2:]] = v
        else:
            return None, f"{'amarchy board card' if card else 'amarchy board set'} takes no {a} (amarchy board --help)"
    return o, None


def stdin_or(v):
    return sys.stdin.read() if v == "-" else v


def board_block(o, base_block):
    """The block a card's options make (--block, --xpost, --body, --attr,
    --media...), over the one it has: (block or None, changed, None) or
    (None, False, what's wrong)."""
    kind = o.get("block")
    body = o.get("body")
    if o.get("xpost") is not None:
        if kind and kind != "xpost":
            return None, False, "--xpost is an xpost block's text: not with --block " + kind
        kind, body = "xpost", o["xpost"]
    attrs = dict(o["attrs"])
    for k in ("media", "handle", "name", "avatar"):
        if o.get(k) is not None:
            attrs[k] = o[k]
    if not kind and not body and not attrs:
        return base_block, False, None
    if not kind and not base_block:
        return None, False, "--body and --attr are a block's: say which with --block <kind> (or --xpost)"
    kind = (kind or base_block["kind"]).strip().lower()
    kinds = block_kinds()
    if kind not in kinds or kind in BOARD_NOT:
        return None, False, (f"--block takes one of the blocks the app draws: "
                             f"{', '.join(k for k in kinds if k not in BOARD_NOT)} (not {kind!r})")
    same = base_block and base_block["kind"] == kind
    blk = {"kind": kind, "attrs": {**(base_block["attrs"] if same else {}), **attrs},
           "body": stdin_or(body) if body is not None else (base_block["body"] if same else "")}
    blk["attrs"] = {k: v for k, v in blk["attrs"].items() if str(v).strip()}
    blk["body"] = str(blk["body"]).replace("\r\n", "\n").strip("\n").rstrip()
    if len(blk["body"]) > BOARD_BODY:
        return None, False, f"a card's block is {BOARD_BODY} characters at most"
    if re.search(r"^\s*```", blk["body"], re.M):
        return None, False, "a card's block can't have a ``` line in it"
    bad = next((k for k, v in blk["attrs"].items() if '"' in str(v) or "\n" in str(v)), None)
    if bad:
        return None, False, f"--attr {bad}'s value can't have a \" or a new line in it"
    # Its pictures and videos, each a path here made whole (~ and all, each
    # one: a shell expands only the first of "a.png,~/b.png"), there.
    spec = {**block_catalog().get("common", {}), **kinds[kind].get("attrs", {})}
    for k, v in list(blk["attrs"].items()):
        if (spec.get(k) or {}).get("type") == "media":
            items = [x if re.match(r"^https?://", x, re.I) else str(Path.cwd() / Path(x).expanduser())
                     for x in media_list(v, spec[k].get("many"))]
            for x in items:
                why = media_issue(x)
                if why:
                    return None, False, f"--{k if k in ('media', 'avatar') else 'attr ' + k} {x!r} {why}"
            blk["attrs"][k] = ", ".join(items)
    fence = f"```{kind} " + " ".join(f'{k}="{v}"' for k, v in blk["attrs"].items()) + f"\n{blk['body']}\n```"
    found = reply_blocks(fence)
    issues = block_issues(found[0]) if found else [f"The {kind} block didn't read"]
    if issues:
        return None, False, " ".join(issues)
    return blk, json.dumps(blk, sort_keys=True) != json.dumps(base_block, sort_keys=True), None


def cmd_board(args):
    """amarchy board [list] | set | card | move | comment | show | approved | log | rm | drop."""
    sub, rest = (args[0], args[1:]) if args and not args[0].startswith("-") else ("list", args)
    if sub in ("list", "ls"):
        if any(a not in ("--json",) for a in rest):
            print(usage("board"), file=sys.stderr)
            return 1
        rows = boards_view()
        if "--json" in rest:
            print(json.dumps([{k: v for k, v in r.items() if k != "cards"} for r in rows], ensure_ascii=False))
            return 0
        for r in rows:
            cols = " · ".join(f"{c['name']} {c['count']}" for c in r["columns"])
            print(f"{r['id']}\t{r['lead']}\t{r['title']}\t{cols}")
        if not rows:
            print("none")
        return 0
    if sub == "log":
        return board_log_cmd(rest)
    if not rest or rest[0].startswith("-"):
        print(usage("board"), file=sys.stderr)
        return 1
    bid, rest = rest[0].strip().lower(), rest[1:]
    if not BOARD_ID.fullmatch(bid):
        return fail(f"a board's id is a few letters, digits, . _ or - (not {bid!r})")
    if sub == "set":
        return board_set_cmd(bid, rest)
    if sub == "card":
        return board_card_cmd(bid, rest)
    if sub == "show":
        return board_show_cmd(bid, rest)
    if sub == "approved":
        return board_approved_cmd(bid, rest)
    if sub in ("move", "comment", "rm", "drop"):
        return board_small_cmd(sub, bid, rest)
    print(usage("board"), file=sys.stderr)
    return 1


def board_set_cmd(bid, args):
    o, why = board_args(args)
    if why:
        return fail(why)
    who, why = board_who(o.get("agent"))
    if why:
        return fail(why)
    cols = board_parse_columns(o["columns"]) if o["columns"] is not None else None
    if isinstance(cols, str):
        return fail(cols)
    title = " ".join((o.get("title") or "").split()) if o.get("title") is not None else None
    if title is not None and len(title) > BOARD_TITLE:
        return fail(f"--title is {BOARD_TITLE} characters at most")
    lead = None
    if o.get("lead"):
        lead = next((a for a in team() if a["id"] == o["lead"].strip()), None)
        if not lead:
            return fail(f"--lead {o['lead']!r} isn't your assistant or one of your agents (amarchy agents)")
    check = "" if "--no-check" in o["flags"] else o.get("check")
    moved = []

    def put(boards):
        b = boards.get(bid)
        if not b:
            if bid in {a["id"] for a in team()} and bid != who["id"]:
                return None, f"{bid} is {bid}'s own board (its tasks): only it makes it"
            b = boards[bid] = {"id": bid, "title": title or "", "lead": (lead or who)["id"], "columns": cols or copy.deepcopy(TASK_BOARD if bid == who["id"] else BOARD_DEFAULT),
                               "check": check or "", "at": time.time(), "updated": time.time(), "rev": 0, "cards": [],
                               **({"task": True} if bid == who["id"] else {})}
            board_log(b, None, who["id"], "board", title=title, columns=[c["name"] for c in b["columns"]])
            return "made", None
        if title is not None:
            b["title"] = title
        if lead:
            b["lead"] = lead["id"]
        if check is not None:
            b["check"] = check
        if cols is not None:
            names = {c["name"] for c in cols}
            first = next(c["name"] for c in cols if not c.get("approval"))
            for c in b["cards"]:
                if c.get("column") not in names:
                    moved.append((card_ref(c), c.get("column")))
                    if c.get("approval"):
                        c["approval"] = None
                    c["column"] = first
            b["columns"] = cols
        board_log(b, None, who["id"], "board", title=title, columns=[c["name"] for c in cols] if cols else None, check=check)
        return "changed", None
    done, why = boards_change(put)
    if why:
        return fail(why)
    for ref, col in moved:
        print(f"amarchy: {ref} was in {col!r}, which is gone: it's in the first column now", file=sys.stderr)
    print(f"{done}\t{bid}")
    return 0


def board_card_cmd(bid, args):
    """amarchy board card: a card added, or changed in place (--key): its id printed."""
    o, why = board_args(args, card=True)
    if why:
        return fail(why)
    who, why = board_who(o.get("agent"))
    if why:
        return fail(why)
    title = " ".join(o["title"].split()) if o.get("title") is not None else None
    if title is not None and not 0 < len(title) <= TASK_TITLE:
        return fail(f"--title is 1 to {TASK_TITLE} characters")
    note = stdin_or(o["note"]).strip() if o.get("note") is not None else None
    if note is not None and len(note) > BOARD_BODY:
        return fail(f"--note is {BOARD_BODY} characters at most")
    if len(o["links"]) > TASK_LINKS or len(o["buttons"]) > TASK_BUTTONS:
        return fail(f"a card has {TASK_LINKS} links and {TASK_BUTTONS} buttons of its own at most")
    links = [task_link(v) for v in o["links"]]
    bad = next((x for x in links if isinstance(x, str)), None)
    if bad:
        return fail(bad)
    key = o.get("key").strip() if o.get("key") is not None else None
    if key is not None and not 0 < len(key) <= 200:
        return fail("--key is 1 to 200 characters")
    until = None
    if o.get("until") is not None:
        until, why = task_until(o["until"])
        if why:
            return fail(why)
    b0 = board_get(bid)
    if not b0:
        return fail(f"No board {bid!r} (amarchy board set {bid} makes it)")
    c0 = card_find(b0, key)
    blk, changed, why = board_block(o, (c0 or {}).get("block"))
    if why:
        return fail(why)
    why = board_card_buttons_check(b0, o["buttons"])
    if why:
        return fail(why)
    over = "--over-edit" in o["flags"]
    out = {}

    def put(boards):
        b = boards.get(bid)
        if not b:
            return None, f"No board {bid!r}"
        c = card_find(b, key)
        col = board_column_named(b, o["column"]) if o.get("column") else None
        if o.get("column") and not col:
            return None, f"{bid} has no column {o['column']!r} (its columns: {', '.join(x['name'] for x in b['columns'])})"
        if col and col.get("approval") and (not c or c.get("column") != col["name"]):
            return None, (f"{col['name']!r} needs the user's approval: a card gets there only by their hand, in the app "
                          "(a button of the column before it, or their Move)")
        if o.get("base") and c and card_sha(c) != o["base"]:
            return None, f"{card_ref(c)} changed since that (its sha256 is {card_sha(c)}): amarchy board show {bid} --card {card_ref(c)}"
        if not c:
            if title is None:
                return None, "--title takes what the card is, in a line"
            if len(b["cards"]) >= BOARD_CARDS:
                return None, f"{bid} has {BOARD_CARDS} cards: take some down first (amarchy board rm)"
            if b.get("task"):
                mine = [x for x in b["cards"] if x.get("column") != board_done_column(b) and card_open(b, x)]
                if len(mine) >= TASK_MAX:
                    return None, f"{board_title(b)} has {TASK_MAX} tasks open already: take some down first (amarchy task done)"
            c = card_new(who["id"], who["id"], id=card_id(boards), key=key or "", title=title, column=col["name"] if col else board_first(b),
                         block=blk, note=note or "", links=links, buttons=o["buttons"], until=until or 0,
                         task=bool(b.get("task")))
            c["wrote"] = time.time()
            b["cards"].append(c)
            board_log(b, c, who["id"], "add", column=c["column"], text=card_text(c))
            out.update(id=c["id"], new=True)
            return c, None
        content_was = card_sha(c)
        text_was = card_text(c)
        changes = changed or (note is not None and not c.get("block") and note != c.get("note"))
        if changes and c.get("edited") and (c["edited"].get("at") or 0) > (c.get("wrote") or 0) and not over:
            return None, (f"The user edited {card_ref(c)} since you last wrote it. Its text now:\n{text_was}\n"
                          "Build on theirs; to replace it all the same, run this again with --over-edit")
        if title is not None:
            c["title"] = title
        if blk is not None:
            c["block"] = blk
        if note is not None:
            c["note"] = note
        if o["links"] or "--clear-links" in o["flags"]:
            c["links"] = links
        if o["buttons"] or "--clear-buttons" in o["flags"]:
            c["buttons"] = o["buttons"]
        if until is not None:
            c["until"] = until
        if card_sha(c) != content_was:
            c["wrote"] = time.time()
            thread_add(c, who["id"], "revise", before=text_was, after=card_text(c))
            board_log(b, c, who["id"], "revise", before=text_was, after=card_text(c))
            if c.get("approval"):
                card_unapprove(b, c, who["id"], "Revised: not approved any more")
                out["unapproved"] = True
        if col and col["name"] != c.get("column"):
            board_move_to(b, c, col["name"], who["id"])
        c["updated"] = time.time()
        out.update(id=c["id"], new=False)
        return c, None
    c, why = boards_change(put)
    if why:
        return fail(why)
    print(out["id"])
    if out.get("unapproved"):
        print(f"amarchy: {card_ref(c)} was approved; changed, it isn't any more (the user approves it again)", file=sys.stderr)
    if "--notify" in o["flags"]:
        why = board_notify(board_get(bid), c)
        if why:
            print(f"amarchy: the card is up, but not on your phones: {why}", file=sys.stderr)
    return 0


def board_small_cmd(sub, bid, args):
    """amarchy board move | comment | rm | drop."""
    who, why = board_who(next((args[i + 1] for i, a in enumerate(args[:-1]) if a == "--agent"), None))
    if why:
        return fail(why)
    args = [a for i, a in enumerate(args) if a != "--agent" and (i == 0 or args[i - 1] != "--agent")]
    if sub == "drop":
        if args:
            return fail("amarchy board drop <board> takes nothing more")

        def drop(boards):
            b = boards.pop(bid, None)
            if not b:
                return None, f"No board {bid!r}"
            board_log(b, None, who["id"], "drop", cards=len(b["cards"]))
            return len(b["cards"]), None
        n, why = boards_change(drop)
        if why:
            return fail(why)
        print(f"dropped\t{bid}\t{n} card{'s' if n != 1 else ''}")
        return 0
    if not args:
        print(usage("board"), file=sys.stderr)
        return 1
    if sub == "move" and len(args) != 2:
        return fail("amarchy board move <board> <card> <column>")
    if sub == "comment" and len(args) != 2:
        return fail("amarchy board comment <board> <card> <text|->")
    text = stdin_or(args[1]).strip() if sub == "comment" else ""
    if sub == "comment" and not 0 < len(text) <= BOARD_COMMENT:
        return fail(f"a comment is 1 to {BOARD_COMMENT} characters")
    refs = args if sub == "rm" else args[:1]

    def act(boards):
        b = boards.get(bid)
        if not b:
            return None, f"No board {bid!r}"
        cards = [card_find(b, r) for r in refs]
        missing = [r for r, c in zip(refs, cards) if not c]
        if missing:
            return None, f"{bid} has no card {missing[0]!r}"
        if sub == "rm":
            for c in cards:
                b["cards"].remove(c)
                board_log(b, c, who["id"], "remove", text=card_text(c), column=c.get("column"))
            return [c["id"] for c in cards], None
        c = cards[0]
        if sub == "comment":
            thread_add(c, who["id"], "comment", text=text)
            board_log(b, c, who["id"], "comment", text=text)
            c["updated"] = time.time()
            return [c["id"]], None
        col = board_column_named(b, args[1])
        if not col:
            return None, f"{bid} has no column {args[1]!r} (its columns: {', '.join(x['name'] for x in b['columns'])})"
        if col.get("approval") and c.get("column") != col["name"]:
            return None, f"{col['name']!r} needs the user's approval: only they move a card there, in the app"
        board_move_to(b, c, col["name"], who["id"])
        return [c["id"]], None
    ids, why = boards_change(act)
    if why:
        return fail(why)
    for i in ids:
        print(f"{'removed' if sub == 'rm' else sub + 'd' if sub == 'move' else 'commented'}\t{i}")
    return 0


def board_show_cmd(bid, args):
    """amarchy board show <board> [--card <card>] [--json]."""
    as_json, ref = "--json" in args, None
    rest = [a for a in args if a != "--json"]
    if rest[:1] == ["--card"] and len(rest) == 2:
        ref = rest[1]
    elif rest:
        print(usage("board"), file=sys.stderr)
        return 1
    b = board_get(bid)
    if not b:
        return fail(f"No board {bid!r} (amarchy board list)")
    crew = team()
    cards = [c for c in sorted(b["cards"], key=lambda c: card_order(b, c)) if card_open(b, c)]
    if ref:
        c = card_find(b, ref)
        if not c:
            return fail(f"{bid} has no card {ref!r}")
        cards = [c]

    def full(c):
        v = card_view(b, c, crew)
        a = c.get("approval")
        v["approval"] = v.pop("approved")
        if not v["approval"] and isinstance(a, dict):
            v["approval_dropped"] = "it changed since" if a.get("sha256") != card_sha(c) else "its signature doesn't check"
        v["text_sha256"] = hashlib.sha256(card_text(c).encode()).hexdigest()
        v.pop("count", None)
        return v
    if as_json:
        out = {**{k: v for k, v in board_summary(b, crew, show=0).items() if k != "cards"}, "check": b.get("check") or "",
               "column_buttons": {c["name"]: c.get("buttons") or [] for c in b["columns"]}, "cards": [full(c) for c in cards]}
        print(json.dumps(out if not ref else out["cards"][0], ensure_ascii=False))
        return 0
    print(f"{board_title(b, crew)} ({b['id']}, {board_lead_name(b, crew)}'s)")
    for col in b["columns"]:
        marks = [w for w, k in (("yours", "yours"), ("needs approval", "approval"), ("done", "done")) if col.get(k)]
        inside = [c for c in cards if c.get("column") == col["name"]]
        print(f"\n{col['name']}{' (' + ', '.join(marks) + ')' if marks else ''}: {len(inside)}")
        for c in inside:
            ok = " ✓ approved" if approval_of(b["id"], c) else ""
            last = (c.get("thread") or [{}])[-1]
            said = f"  · {last.get('who')}: {cut_words(' '.join(str(last.get('text') or last.get('kind')).split()), 60)}" if last else ""
            print(f"  {c['id']}  {c.get('key') or '-'}  {c.get('title') or ''}{ok}{said}")
    return 0


def board_approved_cmd(bid, args):
    """amarchy board approved <board> <card> [--text <file|->] [--json]:
    exit 0 only when the user approved exactly what the card has now (and,
    with --text, that's its text)."""
    rest = [a for a in args if a != "--json"]
    if not rest:
        print(usage("board"), file=sys.stderr)
        return 1
    ref, rest = rest[0], rest[1:]
    text = None
    if rest[:1] == ["--text"] and len(rest) == 2:
        text = sys.stdin.read() if rest[1] == "-" else Path(rest[1]).read_text()
    elif rest:
        print(usage("board"), file=sys.stderr)
        return 1
    b = board_get(bid)
    c = card_find(b, ref) if b else None
    if not c:
        return fail(f"No card {ref!r} on {bid!r}")
    a = approval_of(bid, c)
    if not a:
        had = c.get("approval")
        why = "changed since it was approved" if isinstance(had, dict) and had.get("sha256") != card_sha(c) \
            else "its approval doesn't check" if isinstance(had, dict) else "not approved"
        print(json.dumps({"approved": False, "why": why}) if "--json" in args else f"{card_ref(c)}: {why}")
        return 1
    if text is not None and text.rstrip() != card_text(c).rstrip():
        print(json.dumps({"approved": False, "why": "that isn't the text approved"}) if "--json" in args
              else f"{card_ref(c)}: that isn't the text approved")
        return 1
    if "--json" in args:
        print(json.dumps({"approved": True, **a, "text": card_text(c)}, ensure_ascii=False))
    else:
        print(f"{card_ref(c)}: approved by {a['by'] or 'you'} {datetime.datetime.fromtimestamp(a['at']).isoformat(timespec='minutes')}"
              f" · sha256 {a['sha256']}")
    return 0


def board_log_cmd(args):
    """amarchy board log [<board>] [--json] [--lines <n>]."""
    as_json, n, bid = False, 50, None
    it = iter(args)
    for a in it:
        if a == "--json":
            as_json = True
        elif a == "--lines":
            try:
                n = max(1, int(next(it, "")))
            except ValueError:
                return fail("--lines takes a number")
        elif not a.startswith("-") and bid is None:
            bid = a.strip().lower()
        else:
            print(usage("board"), file=sys.stderr)
            return 1
    try:
        rows = [json.loads(l) for l in BOARDS_LOG.read_text().splitlines() if l.strip()]
    except (OSError, ValueError):
        rows = []
    rows = [r for r in rows if isinstance(r, dict) and (not bid or r.get("board") == bid)][-n:]
    if as_json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    for r in rows:
        at = datetime.datetime.fromtimestamp(r.get("at") or 0).strftime("%m-%d %H:%M")
        what = " · ".join(str(x) for x in (r.get("label"), r.get("words") or r.get("text") or r.get("after"),
                                            r.get("column") if r.get("action") == "move" else None) if x)
        print(f"{at}  {r.get('board')}  {r.get('key') or r.get('card') or '-'}  {r.get('who')}  {r.get('action')}"
              f"{'  ' + cut_words(' '.join(str(what).split()), 80) if what else ''}")
    if not rows:
        print("none")
    return 0


def cmd_task(args):
    """amarchy task add | list | done: an agent's own tasks, cards on its own
    board (see "Tasks: boards")."""
    sub, rest = (args[0], args[1:]) if args else ("", [])
    if sub == "add":
        return task_add_cmd(rest)
    agent, as_json, ids = None, False, []
    it = iter(rest)
    for a in it:
        if a == "--agent":
            agent = next(it, None)
            if not agent:
                return fail("--agent takes an agent's id (amarchy agents lists them)")
        elif a == "--json" and sub in ("list", "ls"):
            as_json = True
        elif a.startswith("-") or sub not in ("done", "rm"):
            print(usage("task"), file=sys.stderr)
            return 1
        else:
            ids.append(a)
    if sub in ("list", "ls"):
        rows = [t for t in tasks_view() if not agent or t["agent"] == agent]
        if as_json:
            keys = {c["id"]: c.get("key") or "" for b in boards_all() for c in b["cards"]}
            print(json.dumps([{**{k: t.get(k) for k in ("id", "agent", "title", "note", "links", "buttons", "at")},
                               "key": keys.get(t["id"], ""), "agent_name": t["agent_name"], "until": t.get("until") or None,
                               "until_iso": datetime.datetime.fromtimestamp(t["until"]).astimezone().isoformat(timespec="minutes")
                               if t.get("until") else None} for t in rows]))
        else:
            for t in rows:
                print(f"{t['id']}\t{t['agent']}\t{task_clock(t['until']) if t.get('until') else '-'}\t{t.get('title') or ''}")
            if not rows:
                print("none")
        return 0
    if sub in ("done", "rm"):
        if not ids and not agent:
            print(usage("task"), file=sys.stderr)
            return 1
        if ids and agent:
            return fail("done takes the tasks' ids, or --agent <id> for all of an agent's: not both")

        def done(boards):
            gone = []
            for b in boards.values():
                if not b.get("task"):
                    continue
                for c in list(b["cards"]):
                    if c["id"] in ids or (agent and b["lead"] == agent and c.get("column") != board_done_column(b)):
                        b["cards"].remove(c)
                        board_log(b, c, b["lead"], "remove", text=card_text(c))
                        gone.append(c["id"])
            return gone
        gone = boards_change(done)
        for tid in gone:
            print(f"done\t{tid}")
        missing = [tid for tid in ids if tid not in gone]
        for tid in missing:
            print(f"amarchy: no task {tid} (done already, or its time ran out)", file=sys.stderr)
        if agent and not gone:
            print(f"{agent} has no task open")
        return 1 if missing else 0
    print(usage("task"), file=sys.stderr)
    return 1


def task_add_cmd(args):
    """amarchy task add: a task on the agent's own board, its id printed."""
    agent = os.environ.get("AMARCHY_SESSION") or None
    title = note = until_word = key = None
    links, buttons, notify = [], [], False
    it = iter(args)
    for a in it:
        if a in ("--agent", "--title", "--note", "--link", "--button", "--until", "--key"):
            v = next(it, None)
            if v is None:
                return fail(f"{a} takes a value (amarchy task --help)")
            if a == "--agent":
                agent = v.strip()
            elif a == "--title":
                title = v
            elif a == "--note":
                note = v
            elif a == "--link":
                links.append(v)
            elif a == "--button":
                buttons.append(v)
            elif a == "--until":
                until_word = v
            else:
                key = v.strip()
        elif a == "--notify":
            notify = True
        else:
            print(usage("task"), file=sys.stderr)
            return 1
    title = " ".join((title or "").split())
    if not title:
        return fail("--title takes what the task is, in a line")
    if len(title) > TASK_TITLE:
        return fail(f"--title is {TASK_TITLE} characters at most")
    note = (note or "").strip()
    if len(note) > TASK_NOTE:
        return fail(f"--note is {TASK_NOTE} characters at most")
    if len(links) > TASK_LINKS or len(buttons) > TASK_BUTTONS:
        return fail(f"a task has {TASK_LINKS} links and {TASK_BUTTONS} buttons at most")
    links = [task_link(v) for v in links]
    buttons = [board_parse_button(v) for v in buttons]
    bad = next((x for x in links + buttons if isinstance(x, str)), None)
    if bad:
        return fail(bad)
    for x in buttons:       # a task's button alone sends "<label>: <title>", as it always did
        if x["send"] is None:
            x["send"] = f"{x['label']}: {title}"
    if key is not None and not 0 < len(key) <= 200:
        return fail("--key is 1 to 200 characters")
    until = None
    if until_word is not None:
        until, why = task_until(until_word)
        if why:
            return fail(why)
    who, why = board_who(agent)
    if why:
        return fail(why.replace("keep boards", "have tasks"))
    bid = who["id"]

    def add(boards):
        b = boards.get(bid)
        if not b:
            b = boards[bid] = task_board_new(bid)
        same = next((x for x in b["cards"] if key and x.get("key") == key), None)
        if same:        # the same one again: changed in place, its card where it is
            same.update(title=title, note=note, links=links, buttons=buttons, until=until or 0)
            if same.get("column") == board_done_column(b):
                same["column"] = board_first(b)
            same["updated"] = time.time()
            return same, None
        now = time.time()
        if sum(1 for x in b["cards"] if x.get("column") != board_done_column(b) and card_open(b, x, now)) >= TASK_MAX:
            return None, f"{who['name']} has {TASK_MAX} tasks open already: take some down first (amarchy task done)"
        c = card_new(bid, bid, id=card_id(boards), key=key or "", title=title, note=note, links=links, buttons=buttons,
                     until=until or 0, column=board_first(b), task=True)
        c["wrote"] = now
        b["cards"].append(c)
        board_log(b, c, bid, "add", text=note, column=c["column"])
        return c, None
    c, why = boards_change(add)
    if why:
        return fail(why)
    print(c["id"])
    if notify:
        why = board_notify(board_get(bid), c)
        if why:
            print(f"amarchy: the task is up, but not on your phones: {why}", file=sys.stderr)
    return 0


def task_press(tid, n):
    """An older page's (or machine's) task button: the card's own button n,
    pressed. None, or what's wrong."""
    if not isinstance(tid, str) or not TASK_ID.fullmatch(tid) or not isinstance(n, int) or isinstance(n, bool):
        return "which task (id) and which of its buttons (button)"
    b = next((x for x in boards_all() if any(c["id"] == tid for c in x["cards"])), None)
    if not b:
        return "That task is gone: its agent took it down, or its time ran out"
    c = next(c for c in b["cards"] if c["id"] == tid)
    if c.get("column") == board_done_column(b):
        return "That task is gone: it's done"
    own = [i for i, x in enumerate(card_buttons(b, c)) if x["own"]]
    if not 0 <= n < len(own):
        return "That task has no such button"
    return board_press(b["id"], tid, own[n], "", "")


def board_guard(event):
    """PreToolUse: an agent's command that would do on a board what only the
    user does (the app's board actions: press, approve, edit, comment as
    them), or reach the boards' files or their key behind amarchy's back, is
    refused (naming them, in a grep of the code or a doc, is fine). The
    reason Claude gets, or None."""
    if not isinstance(event, dict) or event.get("tool_name") != "Bash":
        return None
    command = str((event.get("tool_input") or {}).get("command") or "")
    home = str(HOME)
    spelled = {p for folder in (str(BOARDS), str(BOARD_KEY))
               for p in (folder, folder.replace(home, "~", 1), folder.replace(home, "$HOME", 1), folder.replace(home, "${HOME}", 1))}
    paths = "|".join(re.escape(p) for p in sorted(spelled, key=len, reverse=True))
    calls = re.search(r"/api/(?:m/[^/\s]+/api/)?(?:boards|tasks/press)\b", command) and \
        re.search(r"(?:^|[\s;&|(`$])(?:curl|wget|http|https|xh|nc|ncat|socat|websocat)\b|urllib|requests\.|fetch\(|http\.client|aiohttp", command)
    touches = re.search(rf"(?:^|[\s;&|(`$])(?:{SECRET_READERS}|rm|truncate|install|dd)(?:\s[^\n;&|]*)?\s[\"']?(?:{paths})"
                        rf"|[<>]\s*[\"']?(?:{paths})|open\(\s*[\"'](?:{paths})", command)
    if calls or touches or ".board-key" in command and re.search(rf"(?:{SECRET_READERS})\b", command):
        return ("amarchy: what's done on a board in the user's name (pressing its buttons, approving, editing, "
                "commenting as them) is theirs alone, from the app, and the boards' files are amarchy's. Your side "
                "is `amarchy board` (card, move, comment, show --json, approved, log): amarchy board --help.")
    return None


# ---- search: a chat by its name, or by anything said in it
#
# Tasks' search box (app/tasks.js) asks /api/search?q=: every open chat whose
# name or conversation has all the words, the best first, with the lines that
# have them. What each conversation says (your messages and Claude's words,
# not tools' output) is kept in memory, read again only from where it grew.

_said_in = {}       # transcript path -> {"off": bytes read, "items": [(who, at, text, lower)]}
_said_lock = threading.Lock()
SEARCH_MAX = 30


def said_in(s):
    """What was said in a session's conversation: [(who: you|claude, at, text,
    its lowercase)], oldest first, read again only from where the file grew."""
    f = transcript(s)
    if not f:
        return []
    try:
        size = f.stat().st_size
    except OSError:
        return []
    with _said_lock:
        got = _said_in.get(str(f))
        if not got or got["off"] > size:
            got = _said_in[str(f)] = {"off": 0, "items": []}
        if got["off"] == size:
            return got["items"]
        try:
            with open(f, "rb") as fh:
                fh.seek(got["off"])
                data = fh.read(size - got["off"])
        except OSError:
            return got["items"]
        end = data.rfind(b"\n") + 1      # a line half written waits for the rest
        got["off"] += end
        for line in data[:end].splitlines():
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if not isinstance(r, dict) or r.get("isSidechain") or r.get("isMeta") or r.get("type") not in ("user", "assistant"):
                continue
            content = (r.get("message") or {}).get("content") if isinstance(r.get("message"), dict) else None
            if isinstance(content, list):
                text = "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
            else:
                text = content if isinstance(content, str) else ""
            text = without_goal(text).strip()
            if not text or (r["type"] == "user" and (text.startswith("<") or text.startswith("amarchy:"))):
                continue
            got["items"].append(("you" if r["type"] == "user" else "claude", timestamp(r) or 0, text, text.lower()))
        return got["items"]


def search_snippet(text, lower, words, width=90):
    """The part of a message around its first word found, in a line."""
    at = min((lower.find(w) for w in words if lower.find(w) >= 0), default=0)
    start = max(0, at - width // 2)
    end = min(len(text), at + width + width // 2)
    cut = " ".join(re.sub(r"(?m)\*\*|__|`+|^#+\s*|^>\s*", "", text[start:end]).split())       # words, not markdown's marks
    return ("…" if start else "") + cut + ("…" if end < len(text) else "")


def search_chats(q, ss):
    """The chats with every word of q in their name or what was said in them:
    [{id, name (its name has them all), hits (how many messages), lines:
    [{who, at, text}]}], the best first (its name, then the most and newest
    messages)."""
    words = [w for w in q.lower().split() if w][:8]
    if not words:
        return []
    out = []
    for s in ss:
        if s.get("setup"):
            continue
        name = " ".join(str(s.get(k) or "") for k in ("task", "claude_title", "repo", "name", "branch", "assistant_name")).lower()
        in_name = all(w in name for w in words)
        found = [it for it in said_in(s) if all(w in it[3] for w in words)]
        if not found and not in_name:
            # Every word somewhere: in its name or in one message or another.
            items = said_in(s)
            if not all(w in name or any(w in it[3] for it in items) for w in words):
                continue
            found = [it for it in items if any(w in it[3] for w in words)]
        lines = [{"who": who, "at": at, "text": search_snippet(text, low, words)} for who, at, text, low in reversed(found[-3:])]
        newest = max((it[1] for it in found), default=0)
        out.append({"id": s["id"], "name": in_name, "hits": len(found), "lines": lines, "at": newest})
    out.sort(key=lambda r: (not r["name"], -min(r["hits"], 20), -r["at"]))
    return out[:SEARCH_MAX]


def search_warm(st):
    """Read every open chat's conversation once in the background, so the first
    search doesn't wait for it; then keep up every minute."""
    while True:
        for s in list(st.view.get("sessions") or []):
            try:
                said_in(s)
            except Exception:
                pass
        time.sleep(60)


def app_row(s):
    """A session as the app shows it: one at work on what a timer, a script
    or another chat sent it, with nothing to show yet (quiet), as it was:
    idle, no step, not waking (no typing…, no "Working"). With the machine
    it's on (see "machines")."""
    s = {**s, "status": "idle", "doing": None, "waking": False, "running": ""} if s.get("quiet") else s
    return {**s, "machine": machine_name()}


def app_words(st, ss):
    """The list's words for each session: the last thing its Claude wrote
    (said), the step it's on while it works (doing: {tool, input}, which
    app.js says in words), and what it waits on you for (asks). A terminal's
    screen is read again every few seconds, not every second."""
    now = time.time()
    for s in ss:
        if s.get("setup"):
            s["said"], s["doing"], s["asks"], s["today"], s["permission"] = "", None, "", chat_reply({}), None
            continue
        s["today"] = chat_reply(s)      # its goal, its state, what its last reply asks you (Today)
        # When it last moved, to the minute (Today says "5m ago" at most): a
        # chat at work writes every second, and the list isn't new for that.
        s["today"] = {**s["today"], "at": s["today"]["at"] // 60 * 60}
        words = last_words(s, deep=s.get("assistant") in AGENT_ROLES)      # (session_view's, kept)
        if not s.get("assistant"):
            s["said"] = words["said"]
        s["doing"] = None
        if s.get("status") == "working" and not s.get("quiet"):
            act = agent_live(s["id"]).get("activity") if s.get("engine") == "chat" else None
            s["doing"] = {"tool": act.get("tool") or "", "input": step_input(act.get("input"))} \
                if isinstance(act, dict) and act.get("tool") else words["step"]
        s["asks"] = ask_line(s)
        # A permission it waits on (not a question or a plan: those have their
        # own cards), for Today's Allow and Deny.
        first = (app_asking(s) or [None])[0] if s.get("status") == "waiting" and not s.get("secret_asks") else None
        s["permission"] = {"request_id": first["request_id"], "tool": first.get("tool") or ""} \
            if isinstance(first, dict) and first.get("request_id") and first.get("tool") not in ("AskUserQuestion", "ExitPlanMode") else None


def app_moments(st, ss):
    """Notify about each session that went on to need you or finished, as the
    hook marks it (cmd_hook): unless it's the one on your phone's screen. A
    chat-engine session that asks something new while it waits already (the
    next of two permissions, a question after a plan) tells you that too.
    In words for someone who has never seen a terminal: the session's name,
    then what it asks or that it's done and what it said, then its project;
    tapped, it opens on that session (at its card, when it asks)."""
    now = {s["id"]: s["status"] for s in ss}
    was, st.statuses = st.statuses, now
    if was is None:
        return
    waiting = app_badge(ss)       # the app's badge: what needs you (Today), and your team's unread messages
    crew = None
    for s in ss:
        state, prev = s["status"], was.get(s["id"])
        pending = app_asking(s) if state == "waiting" else []
        asking = pending[0] if pending else None
        rid = asking.get("request_id") if asking else None
        told = st.asked.get(s["id"])
        if state != "waiting":
            st.asked.pop(s["id"], None)
        elif rid:
            st.asked[s["id"]] = rid
        kind = alert_kind(s, state, prev) if state != prev else \
            alert_kind(s, "waiting", "working") if rid and told and rid != told else None
        if not kind:
            continue
        if time.time() - st.seen.get(s["id"], 0) < APP_SEEN:
            continue
        if state == "waiting":
            body = ask_line(s)
        else:
            said = s.get("said") or last_said(s)
            body = f"Done: {said}" if said and kind != "assistant" else said or "Done"
        if kind == "assistant":
            # Your assistant or an agent: under its name and picture, what it
            # said (a brief's first words) or asks.
            crew = team() if crew is None else crew
            payload = {"title": s.get("assistant_name") or "Your assistant", "body": body,
                       "tag": f"assistant-{s['id']}", "url": f"/#/s/{s['id']}", "waiting": waiting,
                       "icon": team_icon(team_of(s, crew)[1])}
        else:
            # Its name, else the project it's in; under what it says, the project.
            title = s.get("task") or f"A new chat in {project_name(s['repo'])}"
            payload = {"title": title, "body": f"{body}\n{project_name(s['repo'])}" if s.get("task") else body,
                       "tag": s["id"], "url": f"/#/s/{s['id']}", "waiting": waiting}
        if state == "waiting":
            payload["ask"] = s["id"]        # tapped, it opens on the card (sw.js, Chat)
        # The desktop app's: which chat, its chime, its buttons.
        desktop = {"session": s["id"], "sound": notice_chime(s, kind == "assistant"),
                   "actions": notice_actions(s, pending)}
        threading.Thread(target=push_all, args=(payload, desktop), daemon=True).start()


# ------------------------------------------------------------------ machines
#
# amarchy on several machines, every machine's chats on one board
# (docs/plan-omarchy-and-machines.md, track A; its "contract between machines
# and apps" is protocol 1). This part: who may call the app's server besides
# a browser through tailscale serve.
#
# The desktop app on this machine comes straight to 127.0.0.1:<APP_PORT>, no
# Tailscale needed. It reads the local key (STATE/app/local.key, 0600: only you
# read it) and opens http://127.0.0.1:<port>/local?key=<key>, which sets a
# cookie (HttpOnly, SameSite=Strict, for that port) and sends it on to the
# app. A request to 127.0.0.1 itself with that cookie is let in, when it comes
# from you (the socket's owner, as the kernel says: not another user here who
# can reach localhost too) and not through a proxy (tailscale serve also comes
# from 127.0.0.1: it says whose request it is, and where it came from). A
# change, as from the app on Tailscale, only from the app's own page (Origin
# http://127.0.0.1:<port>), so another page in that window can't drive it.

LOCAL_KEY = APP / "local.key"
LOCAL_COOKIE = "amarchy_local"      # + _<port>: a browser's cookies for 127.0.0.1 are every port's
LOCAL_COOKIE_AGE = 400 * 86400      # as long as a browser keeps one


def local_key():
    """The local key (made the first time, 0600)."""
    for _ in range(50):
        try:
            if LOCAL_KEY.stat().st_mode & 0o077:
                os.chmod(LOCAL_KEY, 0o600)
            key = LOCAL_KEY.read_text().strip()
            if re.fullmatch(r"[\w-]{43,}", key):
                return key
        except FileNotFoundError:
            APP.mkdir(parents=True, exist_ok=True)
            tmp = APP / f".local.key.{os.getpid()}.{threading.get_ident()}"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(b64u(os.urandom(32)) + "\n")
            try:
                os.link(tmp, LOCAL_KEY)     # never over one another process just made
            except FileExistsError:
                pass
            finally:
                tmp.unlink(missing_ok=True)
            continue
        except OSError:
            pass
        time.sleep(0.02)        # being written: in a moment
    raise OSError(f"couldn't read or make {LOCAL_KEY}")


def local_cookie_value(key=None):
    """What the cookie holds: made from the key (not the key itself), so a
    new key (the file deleted) lets no old cookie in."""
    return hmac.new((key or local_key()).encode(), b"amarchy local cookie", hashlib.sha256).hexdigest()


def local_uid_ok(sock):
    """The other end of a connection on this machine is you: its socket's
    owner, as the kernel says. Where it can't say (not Linux), the key alone."""
    uid = peer_uid(sock)
    return uid == os.getuid() or (uid is None and not sys.platform.startswith("linux"))


# ---- this machine, and the machines paired with it
#
# A machine is a computer running amarchy. Its name is its Tailscale name
# (NAME= in ~/.config/amarchy/host, else Tailscale's short name: host_name);
# its label is what the app shows (the name until you change it, kept on the
# machine itself, so every machine shows the same). Paired machines are in
# ~/.config/amarchy/machines.json (0600: the keys): [{name, label, url, key}],
# one key for each pair, the same on both, so either calls the other with it.
#
# Pairing (amarchy machines add <name|url>, or Settings → Machines → Add):
# this machine asks the other's /api/peer/hello (through its tailscale serve:
# as you), checks it's yours and on the same protocol, makes a key, and hands
# it over with /api/peer/pair, saying who it is and where it's reached; both
# keep the other. A peer then calls with X-Amarchy-Peer: <its name> and
# Authorization: Bearer <the key>, through the other's tailscale serve (as
# you: Tailscale says so), or straight to 127.0.0.1 from you (two on one
# machine: the tests). A web page can't send those headers without a CORS
# yes, which the server never gives.

PROTOCOL = 1                    # the contract between machines (docs/plan-omarchy-and-machines.md)
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "amarchy"
MACHINES = CONFIG / "machines.json"
MACHINE_LABEL = CONFIG / "label"        # this machine's label, when you gave it one
MACHINE_ICON = CONFIG / "icon"          # this machine's icon on the board, when you picked one (see machine_icon)
MACHINES_AS = STATE / "machines-as"     # how the board shows a chat's machine: icon (the default) or name
MACHINE_ICONS = ("server", "desktop", "laptop", "cloud", "tower", "mini")
MACHINE_NAME_FILE = CONFIG / "name"          # its name, kept once paired (a tailnet that renames it breaks no pair)
PEERS_SEEN = APP / "peers"              # <name>.json: each machine's chats as last seen, for while it's off
PEER_TIMEOUT = 8                        # seconds to reach a machine
# Seconds a machine's stream may stay silent (it says "still here" every
# KEEPALIVE): longer, and it's taken as gone (a laptop shut, a network down).
PEER_SILENT = float(os.environ.get("AMARCHY_PEER_SILENT") or 45)
# Seconds a machine stays out of reach before it's "off": a restart (a ship:
# a few seconds) or a network blip is a reconnect, never off.
PEER_OFF_AFTER = float(os.environ.get("AMARCHY_PEER_OFF_AFTER") or 30)
MACHINE_NAME_RE = r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
LABEL_MAX = 40


class PeerError(Exception):
    """A machine didn't answer, or not as one of yours would."""


def machine_name():
    """This machine's name: NAME= (the tests'), else the one it was paired
    under, else its Tailscale name (host_name)."""
    if host_setting("NAME"):
        return host_setting("NAME").lower()
    try:
        kept = MACHINE_NAME_FILE.read_text().strip().lower()
        if re.fullmatch(MACHINE_NAME_RE, kept):
            return kept
    except OSError:
        pass
    return host_name().lower()


def machine_name_keep():
    """Paired: this machine's name stays what the others know it by, even
    when Tailscale gives it another (a move to another tailnet)."""
    if host_setting("NAME") or MACHINE_NAME_FILE.exists():
        return
    name = machine_name()
    if re.fullmatch(MACHINE_NAME_RE, name):
        write_file(MACHINE_NAME_FILE, name + "\n")


def machine_kind():
    """What this machine is, for its icon until you pick one: a laptop (it
    has a battery), a machine in a cloud (a cloud's VM), a server (another
    VM, or no desktop), or a desktop."""
    try:
        if any(Path("/sys/class/power_supply").glob("*/capacity")) or \
                any(d.name.upper().startswith("BAT") for d in Path("/sys/class/power_supply").iterdir()):
            return "laptop"
    except OSError:
        pass
    try:
        vendor = " ".join(Path(f"/sys/class/dmi/id/{k}").read_text().strip().lower() for k in ("sys_vendor", "product_name")
                          if Path(f"/sys/class/dmi/id/{k}").exists())
    except OSError:
        vendor = ""
    if any(c in vendor for c in ("google", "amazon", "ec2", "digitalocean", "hetzner", "linode", "vultr", "oracle", "azure",
                                 "microsoft corporation virtual", "scaleway", "ovh", "hostinger")):
        return "cloud"
    virt = sh("systemd-detect-virt").stdout.strip() if shutil.which("systemd-detect-virt") else ""
    if virt and virt != "none":
        return "server"
    if any(Path(p_).exists() for p_ in ("/usr/bin/Hyprland", "/usr/bin/hyprland", "/usr/bin/gnome-shell", "/usr/bin/plasmashell",
                                        "/usr/bin/sway", "/usr/bin/Xorg")):
        return "desktop"
    return "server"


def machine_icon():
    """Its icon on the board: the one you picked (amarchy machines icon),
    else its kind's."""
    try:
        icon = MACHINE_ICON.read_text().strip()
        if icon in MACHINE_ICONS:
            return icon
    except OSError:
        pass
    return machine_kind()


def machines_as():
    """How the board shows a chat's machine: its icon (its name in words
    with it on a hover or a long press), or its name."""
    try:
        return "name" if MACHINES_AS.read_text().strip() == "name" else "icon"
    except OSError:
        return "icon"


def machine_label():
    try:
        label = MACHINE_LABEL.read_text().strip()
    except OSError:
        label = ""
    return label[:LABEL_MAX] or machine_name()


_tailnet_memo = {"at": 0, "status": {}}


def tailnet_status(fresh=False):
    """tailscale status --json, read at most once a minute."""
    if fresh or time.time() - _tailnet_memo["at"] > 60:
        _tailnet_memo.update(at=time.time(), status=tailscale_status() if tailscale_here() else {})
    return _tailnet_memo["status"]


def machine_url():
    """Where the other machines reach this one's app: URL= in the host
    settings, else its tailnet address (as amarchy app on serves it)."""
    url = host_setting("URL")
    if url:
        return url.rstrip("/")
    address = app_address(tailnet_status())
    return app_url(address).rstrip("/") if address else None


def machine_user():
    """This machine's owner on Tailscale (the login hello says): its node's
    login, else the first of APP_USERS."""
    status = tailnet_status()
    users = app_users(status)
    return app_owner(status) or (sorted(users)[0] if users else None)


_version_memo = {}


def amarchy_version():
    """The git commit amarchy runs from (short): its checkout's, or the one a
    package was built from (its .version, see "a packaged amarchy"); "" when
    it's neither."""
    root = Path(SELF).parent.parent
    if not (root / ".git").exists():
        try:
            return (root / ".version").read_text().strip()[:40]
        except OSError:
            return ""
    try:
        head = (root / ".git").stat().st_mtime_ns if (root / ".git").is_dir() else os.stat(SELF).st_mtime_ns
    except OSError:
        head = 0
    if _version_memo.get("at") != (head, os.stat(SELF).st_mtime_ns):
        r = sh("git", "-C", str(root), "rev-parse", "--short=12", "HEAD")
        _version_memo.update(at=(head, os.stat(SELF).st_mtime_ns), version=r.stdout.strip() if r.returncode == 0 else "")
    return _version_memo["version"]


def hello():
    """What /api/peer/hello says of this machine."""
    return {"name": machine_name(), "label": machine_label(), "version": amarchy_version(),
            "protocol": PROTOCOL, "user": machine_user(), "users": sorted(app_users(tailnet_status())), "merges": True,
            "moves": True, "kind": machine_kind(), "icon": machine_icon(),
            # Its own model, never another's (see "dictation on the host"): a machine
            # without one sends dictations here.
            "dictation": {"ready": dictate_ready(), "engine": DICTATE_MODEL["name"]}}


def machine_url_ok(url):
    """A machine's address: https, or plain http only to this machine itself
    (a test's second server): a key never crosses a network in the clear."""
    u = urllib.parse.urlsplit(url or "")
    if u.scheme == "https":
        return bool(u.hostname) and not u.username and u.path in ("", "/") and not u.query
    return u.scheme == "http" and u.hostname in ("127.0.0.1", "localhost") and bool(u.port) and u.path in ("", "/")


def machine_row(m):
    """A machines.json entry as kept, or None when it isn't one."""
    if not isinstance(m, dict):
        return None
    name, url, key, label = m.get("name"), m.get("url"), m.get("key"), m.get("label")
    if not (isinstance(name, str) and re.fullmatch(MACHINE_NAME_RE, name) and isinstance(url, str) and machine_url_ok(url)
            and isinstance(key, str) and re.fullmatch(r"[\w-]{43,200}", key)):
        return None
    label = label.strip()[:LABEL_MAX] if isinstance(label, str) and label.strip() else name
    return {"name": name, "label": label, "url": url.rstrip("/"), "key": key}


_machines_memo = {"sig": None, "rows": []}


def machines_read():
    """The machines paired with this one (machines.json), read again only
    when it changed (every request from a peer looks)."""
    try:
        st_ = MACHINES.stat()
        sig = (st_.st_mtime_ns, st_.st_size)
    except OSError:
        return []
    if sig != _machines_memo["sig"]:
        try:
            raw = json.loads(MACHINES.read_text())
        except (OSError, ValueError):
            raw = []
        rows, names = [], set()
        for m in raw if isinstance(raw, list) else []:
            m = machine_row(m)
            if m and m["name"] not in names:
                rows.append(m)
                names.add(m["name"])
        _machines_memo.update(sig=sig, rows=rows)
    return [dict(m) for m in _machines_memo["rows"]]


@contextlib.contextmanager
def machines_lock():
    CONFIG.mkdir(parents=True, exist_ok=True)
    with open(CONFIG / ".machines.lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def machines_change(fn):
    """machines.json changed by fn(rows) -> rows, under a lock, 0600."""
    with machines_lock():
        rows = fn(machines_read())
        tmp = MACHINES.with_name(f".machines.json.{os.getpid()}")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(rows, indent=2) + "\n")
        os.replace(tmp, MACHINES)
        _machines_memo["sig"] = None
        return rows


def machine_find(name):
    return next((m for m in machines_read() if m["name"] == name), None)


def machine_keep(m):
    """Pair with m (or take its new key, label and address): kept in machines.json."""
    m = machine_row(m)
    if not m:
        raise ValueError("not a machine")
    machines_change(lambda rows: [r for r in rows if r["name"] != m["name"]] + [m])
    return m


def machine_drop(name):
    machines_change(lambda rows: [r for r in rows if r["name"] != name])
    (PEERS_SEEN / f"{name}.json").unlink(missing_ok=True)


def peer_open(url, timeout=PEER_TIMEOUT):
    """An HTTP(S) connection to a machine's app (not connected yet)."""
    import http.client
    import ssl
    u = urllib.parse.urlsplit(url)
    port = u.port or (443 if u.scheme == "https" else 80)
    via = tailnet_via(u.hostname)       # this computer on amarchy's own Tailscale node: through its proxy (track H)
    if u.scheme == "https":
        if via:
            conn = http.client.HTTPSConnection(via[0], via[1], timeout=timeout, context=ssl.create_default_context())
            conn.set_tunnel(u.hostname, port, headers={"Proxy-Authorization": via[2]})
            return conn
        return http.client.HTTPSConnection(u.hostname, u.port or 443, timeout=timeout,
                                           context=ssl.create_default_context())
    if via:
        conn = http.client.HTTPConnection(via[0], via[1], timeout=timeout)
        conn.set_tunnel(u.hostname, port, headers={"Proxy-Authorization": via[2]})
        return conn
    return http.client.HTTPConnection(u.hostname, u.port, timeout=timeout)


def peer_connect(url, timeout=PEER_TIMEOUT):
    """A raw socket to a machine's app (TLS for https), for what http.client
    doesn't carry: a WebSocket passed through (Handler.tunnel)."""
    import ssl
    u = urllib.parse.urlsplit(url)
    tls = u.scheme == "https"
    # (Straight, or through amarchy's own Tailscale node where it's this machine's: tailnet_dial.)
    sock = tailnet_dial(u.hostname, u.port or (443 if tls else 80), timeout)
    if tls:
        try:
            sock = ssl.create_default_context().wrap_socket(sock, server_hostname=u.hostname)
        except (OSError, ssl.SSLError):
            sock.close()
            raise
    return sock


def peer_ws_open(m, rest, key, ua=None):
    """A WebSocket to machine m's rest, opened as this machine (key: the
    Sec-WebSocket-Key): the socket, the answer's status, its head, and what
    came after the head. Raises PeerError (or OSError) when it doesn't
    answer as amarchy does."""
    u = urllib.parse.urlsplit(m["url"])
    sock = peer_connect(m["url"])
    try:
        hs = {"Host": u.hostname + (f":{u.port}" if u.port else ""), "Upgrade": "websocket", "Connection": "Upgrade",
              "Sec-WebSocket-Key": key, "Sec-WebSocket-Version": "13",
              **peer_headers(m, {"User-Agent": ua or f"amarchy/{PROTOCOL}"})}
        sock.sendall((f"GET {rest} HTTP/1.1\r\n" + "".join(f"{k}: {v}\r\n" for k, v in hs.items()) + "\r\n").encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = sock.recv(16384)
            if not chunk:
                raise PeerError("it hung up")
            head += chunk
            if len(head) > 65536:
                raise PeerError("it didn't answer as amarchy does")
    except (OSError, PeerError):
        sock.close()
        raise
    head, _, early = head.partition(b"\r\n\r\n")
    try:
        code = int(head.split(b" ", 2)[1])
    except (IndexError, ValueError):
        code = 502
    return sock, code, head, early


def peer_ws_refusal(sock, head, early):
    """What a machine said when it wouldn't open a WebSocket (its JSON, {}
    if none), the socket closed after it."""
    length = re.search(rb"(?im)^content-length:\s*(\d+)", head)
    body = early
    try:
        while length and len(body) < int(length.group(1)):
            more = sock.recv(65536)
            if not more:
                break
            body += more
    except OSError:
        pass
    sock.close()
    try:
        said = json.loads(body or b"{}")
    except ValueError:
        said = {}
    return said if isinstance(said, dict) else {}


def peer_headers(m, extra=None):
    """What a request to machine m carries: who's asking (this machine),
    the pair's key, and the protocol it speaks."""
    h = {"X-Amarchy-Peer": machine_name(), "X-Amarchy-Protocol": str(PROTOCOL), "User-Agent": f"amarchy/{PROTOCOL}"}
    me = machine_url()
    if me:
        h["X-Amarchy-Peer-URL"] = me        # where it's reached now (a tailnet changed: kept by the other)
    if m.get("key"):
        h["Authorization"] = f"Bearer {m['key']}"
    return {**h, **(extra or {})}


def peer_request(m, method, path, body=None, headers=None, timeout=PEER_TIMEOUT):
    """A request to machine m ({url, key}), as this machine: (connection,
    response); the caller reads the response and closes the connection.
    body: bytes, or a dict sent as JSON. Raises PeerError when it can't be
    reached."""
    if isinstance(body, dict):
        body = json.dumps(body).encode()
        headers = {"Content-Type": "application/json", **(headers or {})}
    conn = peer_open(m["url"], timeout)
    try:
        conn.request(method, path, body=body, headers=peer_headers(m, headers))
        sock = conn.sock        # (http.client lets go of it once the answer is one that ends with its connection)
        r = conn.getresponse()
        r.peer_sock = sock      # for a stream's own timeout
        return conn, r
    except (OSError, ValueError) as e:      # refused, no route, its name unknown, TLS, a timeout
        conn.close()
        raise PeerError(peer_why(e)) from None
    except Exception as e:                  # http.client's own (a connection that answered nothing)
        conn.close()
        raise PeerError(str(e) or type(e).__name__) from None


def peer_why(e):
    """Why a machine couldn't be reached, in words."""
    text = str(e)
    if isinstance(e, socket.timeout) or "timed out" in text:
        return "it didn't answer in time"
    if isinstance(e, ConnectionRefusedError) or "refused" in text.lower():
        return "nothing answers there (is amarchy's app on there?)"
    if isinstance(e, socket.gaierror) or "Name or service not known" in text or "nodename nor servname" in text \
            or "Temporary failure in name resolution" in text:
        return f"can't reach it from {machine_label()}: its name isn't known here (on another tailnet, or MagicDNS off?)"
    if isinstance(e, OSError) and e.errno in (101, 113):     # network / host unreachable
        return f"can't reach it from {machine_label()}: no route there"
    if "CERTIFICATE" in text.upper():
        return f"its HTTPS certificate isn't right ({text})"
    return text or type(e).__name__


def peer_json(m, method, path, body=None, timeout=PEER_TIMEOUT):
    """(status, the JSON it answered) from machine m."""
    conn, r = peer_request(m, method, path, body=body, timeout=timeout)
    try:
        raw = r.read()
    except (OSError, ValueError) as e:
        raise PeerError(peer_why(e)) from None
    finally:
        conn.close()
    if r.getheader("Content-Encoding") == "gzip":
        raw = zlib.decompress(raw, 31)
    try:
        data = json.loads(raw or b"{}")
    except ValueError:
        data = {"error": f"it answered {r.status}, not amarchy's way"}
    return r.status, data if isinstance(data, dict) else {}


def protocol_words(theirs, label):
    """What to do when a machine speaks another protocol, or None."""
    if theirs == PROTOCOL:
        return None
    if isinstance(theirs, int) and theirs > PROTOCOL:
        return f"Update amarchy on {machine_label()}: {label} is newer (amarchy update)"
    return f"Update amarchy on {label} (amarchy update there)"


def machine_hello(url, timeout=PEER_TIMEOUT):
    """What the machine at url says it is (its /api/peer/hello), checked:
    amarchy, on our protocol, yours. Raises PeerError saying why not."""
    status, h = peer_json({"url": url}, "GET", "/api/peer/hello", timeout=timeout)
    if status != 200 or not isinstance(h.get("name"), str):
        raise PeerError(h.get("error") or f"it answered {status}, not as amarchy does")
    label = str(h.get("label") or h["name"])[:LABEL_MAX]
    why = protocol_words(h.get("protocol"), label)
    if why:
        raise PeerError(why)
    # Its owner must be one of yours (this machine's owner, or in APP_USERS:
    # your login on another tailnet): pairing gives it this machine's chats.
    mine = app_users(tailnet_status())
    if mine and h.get("user") not in mine:
        raise PeerError(f"{label} is {h.get('user') or 'nobody'}'s, not yours (if that's you too, on another "
                        f"tailnet: APP_USERS={h.get('user') or '<that login>'} in {HOST_CONFIG}, then add it again)")
    if not re.fullmatch(MACHINE_NAME_RE, h["name"]):
        raise PeerError(f"its name ({h['name']}) isn't a machine's")
    return {**h, "label": label}


def machine_address(target):
    """A machine's address from what you typed: an address as it is, a name
    on your tailnet (omarchy, or omarchy.tail1234.ts.net) as its HTTPS one."""
    target = (target or "").strip().rstrip("/")
    if re.match(r"https?://", target, re.I):
        return target
    if re.fullmatch(MACHINE_NAME_RE, target.lower()):
        status = tailnet_status()
        suffix = (status.get("MagicDNSSuffix") or (status.get("CurrentTailnet") or {}).get("MagicDNSSuffix") or "").strip(".")
        if not suffix:
            raise PeerError("this machine isn't on Tailscale: give the other one's address (https://…)")
        return f"https://{target.lower()}.{suffix}"
    if re.fullmatch(r"[a-z0-9.-]+\.[a-z]{2,}(:\d+)?", target.lower()):
        return f"https://{target.lower()}"
    raise PeerError(f"{target!r} isn't a machine's name or address")


def machine_url_here(url):
    """An address this machine can reach a peer at: on its own tailnet (its
    MagicDNS name), or this machine itself (a test's second server). Not one
    on another tailnet a peer gives (it may reach this one through a proxy)."""
    u = urllib.parse.urlsplit(url)
    if u.scheme == "http":
        return u.hostname in ("127.0.0.1", "localhost")
    status = tailnet_status()
    suffix = (status.get("MagicDNSSuffix") or (status.get("CurrentTailnet") or {}).get("MagicDNSSuffix") or "").strip(".").lower()
    return bool(suffix) and (u.hostname or "").lower().endswith("." + suffix)


def machine_moved(m):
    """A machine that stopped answering at its address: is it at its name's
    address on this tailnet now (a tailnet moved)? Kept there if so."""
    if not re.fullmatch(MACHINE_NAME_RE, m["name"]) or urllib.parse.urlsplit(m["url"]).scheme != "https":
        return False
    try:
        url = machine_address(m["name"])
    except PeerError:
        return False
    if url == m["url"]:
        return False
    try:
        h = machine_hello(url, timeout=4)
    except PeerError:
        return False
    if h["name"] != m["name"]:
        return False
    machine_keep({**m, "url": url})
    return True


def machines_add(target):
    """Pair this machine with another (amarchy machines add): the machine
    as kept. Raises PeerError saying why not."""
    url = machine_address(target)
    if not machine_url_ok(url):
        raise PeerError("a machine is reached over https (plain http only on this machine itself)")
    h = machine_hello(url)
    if h["name"] == machine_name():
        raise PeerError("that's this machine")
    me = machine_url()
    if not me:
        raise PeerError("this machine isn't on your tailnet yet, so the other can't reach it back "
                        "(amarchy app on, with Tailscale up)")
    key = b64u(os.urandom(32))
    machine_name_keep()
    status, said = peer_json({"url": url, "key": key}, "POST", "/api/peer/pair",
                             {"name": machine_name(), "label": machine_label(), "url": me, "protocol": PROTOCOL})
    if status != 200:
        raise PeerError(said.get("error") or f"{h['label']} said no ({status})")
    return machine_keep({"name": h["name"], "label": h["label"], "url": url, "key": key})


def machines_remove(name):
    """Unpair (amarchy machines remove): it's told, when it answers, and
    forgets this one too. Returns the words to say."""
    m = machine_find(name)
    if not m:
        raise PeerError(f"no machine {name} (amarchy machines lists them)")
    told = True
    try:
        status, _ = peer_json(m, "POST", "/api/peer/unpair", {}, timeout=5)
        told = status in (200, 403)     # 403: it had forgotten us already
    except PeerError:
        told = False
    machine_drop(name)
    return f"{m['label']} removed" + ("" if told else f" here ({m['label']} didn't answer: it forgets this one "
                                                     "when it next can't get in)")


def machines_rename(name, label):
    """A machine's label, on the machine itself (every machine shows the
    same one): this one's, or another's that answers."""
    label = (label or "").strip()
    if not label or len(label) > LABEL_MAX or any(ord(c) < 32 for c in label):
        raise PeerError(f"a label of 1 to {LABEL_MAX} characters")
    if name == machine_name():
        write_file(MACHINE_LABEL, label + "\n")
        return label
    m = machine_find(name)
    if not m:
        raise PeerError(f"no machine {name} (amarchy machines lists them)")
    status, said = peer_json(m, "POST", "/api/peer/label", {"label": label}, timeout=5)
    if status != 200:
        raise PeerError(said.get("error") or f"{m['label']} said no ({status})")
    machine_keep({**m, "label": said.get("label") or label})
    return label


def machines_icon(name, icon):
    """A machine's icon, on the machine itself (every machine shows the
    same one): this one's, or another's that answers."""
    if icon not in MACHINE_ICONS:
        raise PeerError(f"an icon: {', '.join(MACHINE_ICONS)}")
    if name == machine_name():
        write_file(MACHINE_ICON, icon + "\n")
        return icon
    m = machine_find(name)
    if not m:
        raise PeerError(f"no machine {name} (amarchy machines lists them)")
    status, said = peer_json(m, "POST", "/api/peer/icon", {"icon": icon}, timeout=5)
    if status != 200:
        raise PeerError(said.get("error") or f"{m['label']} said no ({status})")
    return icon


def machine_state(m):
    """Whether machine m answers, as `amarchy machines` says it: {state:
    on|off|update, version, label, error}."""
    try:
        status, h = peer_json(m, "GET", "/api/peer/hello", timeout=4)
    except PeerError as e:
        return {"state": "off", "error": str(e)}
    if status != 200:
        return {"state": "off", "error": h.get("error") or f"it answered {status}"}
    why = protocol_words(h.get("protocol"), str(h.get("label") or m["label"]))
    return {"state": "update" if why else "on", "error": why, "version": h.get("version") or "",
            "label": str(h.get("label") or m["label"])[:LABEL_MAX]}


def machines_listed(check=True):
    """This machine, then the ones paired with it, each with its state
    (asked of each at once), never a key."""
    # merges: this amarchy's app shows another machine's chats and acts on
    # them (the desktop app opens this machine's board only then).
    me = {"name": machine_name(), "label": machine_label(), "url": machine_url(), "me": True,
          "state": "on", "version": amarchy_version(), "error": None, "merges": True}
    rows = machines_read()
    states = {}
    if check and rows:
        def ask(m):
            states[m["name"]] = machine_state(m)
        ts = [threading.Thread(target=ask, args=(m,), daemon=True) for m in rows]
        for t in ts:
            t.start()
        for t in ts:
            t.join(6)
    return [me] + [{"name": m["name"], "label": (states.get(m["name"]) or {}).get("label") or m["label"], "url": m["url"],
                    "me": False, **{"state": "unknown", "version": "", "error": None, **states.get(m["name"], {})}}
                   for m in rows]


def machines_found():
    """Machines of yours on the tailnet that answer as amarchy and aren't
    paired yet (Settings → Machines → Add): {name, label, url, version}
    each, asked of all at once."""
    status = tailnet_status(fresh=True)
    me = status.get("Self") or {}
    paired = {m["name"] for m in machines_read()} | {machine_name()}
    candidates = []
    for p in (status.get("Peer") or {}).values():
        name = (p.get("DNSName") or "").split(".")[0].lower()
        if (p.get("UserID") == me.get("UserID") and p.get("Online") and name and name not in paired
                and str(p.get("OS") or "").lower() not in ("ios", "android", "tvos")):
            candidates.append((name, f"https://{(p.get('DNSName') or '').rstrip('.')}"))
    found = []

    def ask(name, url):
        try:
            h = machine_hello(url, timeout=4)
            found.append({"name": h["name"], "label": h["label"], "url": url, "version": h.get("version") or ""})
        except PeerError as e:
            if str(e).startswith("Update amarchy"):
                found.append({"name": name, "label": name, "url": url, "update": str(e)})
    ts = [threading.Thread(target=ask, args=c, daemon=True) for c in candidates]
    for t in ts:
        t.start()
    for t in ts:
        t.join(6)
    return sorted(found, key=lambda f: f["label"].lower())


def cmd_machines(args):
    """amarchy machines [--json] | add <name|url> | remove <name> | rename <name> <label>."""
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    what = args[0] if args else "list"
    try:
        if what == "list" and len(args) <= 1:
            rows = machines_listed()
            if as_json:
                print(json.dumps(rows, indent=2))
                return 0
            for m in rows:
                state = "this machine" if m["me"] else m["state"]
                label = f" ({m['label']})" if m["label"] != m["name"] else ""
                print(f"{m['name']}{label}\t{state}\t{m['url'] or 'not on your tailnet'}"
                      + (f"\t{m['error']}" if m.get("error") and not m["me"] else ""))
            return 0
        if what == "add" and len(args) == 2:
            m = machines_add(args[1])
            if as_json:
                print(json.dumps({k: v for k, v in m.items() if k != "key"}))
            else:
                print(f"paired with {m['label']} ({m['url']}): its chats are on your board")
            return 0
        if what == "remove" and len(args) == 2:
            print(machines_remove(args[1]))
            return 0
        if what == "rename" and len(args) == 3:
            label = machines_rename(args[1], args[2])
            print(f"{args[1]} is {label} now")
            return 0
        if what == "icon" and len(args) == 3:
            icon = machines_icon(args[1], args[2])
            print(f"{args[1]}'s icon is {icon} now")
            return 0
        if what == "show" and len(args) == 2 and args[1] in ("icon", "name"):
            write_file(MACHINES_AS, args[1] + "\n")
            print(f"the board shows a chat's machine by its {args[1]}")
            return 0
        if what == "found" and len(args) == 1:
            found = machines_found()
            print(json.dumps(found, indent=2) if as_json else "\n".join(
                f"{f['name']}\t{f.get('update') or f['url']}" for f in found) or "none (nothing else of yours answers)")
            return 0
    except PeerError as e:
        return fail(str(e))
    return fail("usage: amarchy machines [--json] | add <name|url> | remove <name> | rename <name> <label>")


# ---- every machine's chats on one board
#
# The app's server follows each paired machine's own chats (/api/peer/events:
# never the ones it passes on from others, so machines don't echo each other)
# and puts them on its board beside its own (/api/state, /api/events), each
# chat with its machine. A machine that stops answering keeps its chats as
# last seen, marked machine_off (kept on disk too, for after a restart); one
# on another protocol says what to update instead.

class Peers:
    """The machines paired with this one, followed: each one's last state
    ({machine, sessions, projects, tasks}), whether it answers now, and why
    not."""

    def __init__(self, st):
        self.st, self.lock = st, threading.Lock()
        self.seen = {}          # name -> {"hello", "sessions", "projects", "tasks", "on", "error", "update", "since", "at"}
        self.followed = {}      # name -> its thread's Event (set: stop, or look again now)
        self.saved_at = {}
        for f in sorted(PEERS_SEEN.glob("*.json")) if PEERS_SEEN.is_dir() else []:
            try:
                kept = json.loads(f.read_text())
            except (OSError, ValueError):
                continue
            if isinstance(kept, dict) and isinstance(kept.get("sessions"), list):
                # As last seen: on then, reconnecting (this server just started: off
                # only if it stays out of reach); off then, off until it answers.
                was_on = kept.get("on") is not False
                self.seen[f.stem] = {**kept, "on": False, "error": None if was_on else "not reached yet", "update": None,
                                     "reconnecting": time.time() if was_on else None}

    def start(self):
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        """Follow every machine in machines.json, as it changes."""
        while True:
            try:
                self.sync()
            except Exception as e:      # never the list's end
                print(f"amarchy app: machines: {e}", file=sys.stderr, flush=True)
            time.sleep(3)

    def sync(self):
        names = {m["name"] for m in machines_read()}
        with self.lock:
            gone = [n for n in self.seen if n not in names]
            for name in gone:
                self.seen.pop(name, None)
            for name in names - set(self.followed):
                self.followed[name] = threading.Event()
                threading.Thread(target=self.follow, args=(name, self.followed[name]), daemon=True).start()
        if gone:
            self.st.bump()

    def poke(self, name=None):
        """Look again now at a machine that doesn't answer (it was just
        paired, or turned on)."""
        with self.lock:
            for n, ev in self.followed.items():
                if name in (None, n):
                    ev.set()

    def update(self, name, **change):
        with self.lock:
            was = self.seen.get(name) or {"sessions": [], "projects": [], "tasks": [], "hello": {}, "on": False,
                                          "error": None, "update": None, "since": time.time()}
            now = {**was, **change}
            if now.get("on") != was.get("on"):
                now["since"] = time.time()
                if now.get("on") and getattr(self.st, "sync", None):
                    self.st.sync.soon(name)     # back: what changed meanwhile, both ways
            if now == was:
                return
            self.seen[name] = now
        if change.get("on") is not None and (not change.get("on") or time.time() - self.saved_at.get(name, 0) > 10):
            self.save(name, now)
        self.st.bump()

    def save(self, name, now):
        self.saved_at[name] = time.time()
        try:
            write_file(PEERS_SEEN / f"{name}.json", json.dumps(
                {**{k: now.get(k) for k in ("hello", "sessions", "projects", "tasks", "boards", "moved", "at")}, "on": bool(now.get("on"))}))
        except OSError:
            pass

    def follow(self, name, wake):
        """One machine's chats as they change, for as long as it's paired.
        Its stream cut (a restart there, a network blip): back to it at once,
        then every half second, a second, two... while it's out of reach its
        chats stay as they were ("reconnecting"), and only once it has been out
        of reach PEER_OFF_AFTER seconds is it off; then every 30 s at most (at
        once when poked)."""
        wait, lost = 0.5, None          # lost: when it was last heard, while it isn't
        try:
            while True:
                m = machine_find(name)
                if not m:
                    return
                wake.clear()
                try:
                    self.stream(m, wake)
                    wait, lost = 0.5, None
                    continue            # it ended (a restart there): again at once
                except PeerError as e:
                    why = str(e)
                except Exception as e:  # a stream cut mid-event, its data not JSON
                    why = str(e) or type(e).__name__
                if machine_find(name) and machine_moved(m):
                    continue            # its address changed (another tailnet): there, at once
                if not machine_find(name):
                    return
                known = self.seen.get(name) or {}
                heard = known.get("heard") or 0
                if lost and heard > lost:
                    wait, lost = 0.5, None      # heard from since it was last lost: a new time out of reach
                lost = lost or known.get("reconnecting") or max(heard, time.time() - PEER_SILENT if heard else time.time())
                if time.time() - lost >= PEER_OFF_AFTER or not (known.get("on") or known.get("reconnecting")):
                    self.update(name, on=False, error=why, reconnecting=None)
                else:
                    self.update(name, reconnecting=lost, error=why)
                wake.wait(wait)
                wait = min(wait * 2, 5 if time.time() - lost < PEER_OFF_AFTER else 30)
        finally:
            with self.lock:
                if self.followed.get(name) is wake:
                    self.followed.pop(name)

    def stream(self, m, wake):
        """Its /api/peer/events, until it ends or the machine's unpaired."""
        name = m["name"]
        status, h = peer_json(m, "GET", "/api/peer/hello")
        if status != 200:
            raise PeerError(h.get("error") or f"it answered {status}")
        label = str(h.get("label") or m["label"])[:LABEL_MAX]
        why = protocol_words(h.get("protocol"), label)
        if why:
            self.update(name, on=False, update=why, error=why, hello=h)
            wake.wait(300)              # asked again in a while (or at once, poked)
            raise PeerError(why)
        conn, r = peer_request(m, "GET", "/api/peer/events", headers={"Accept": "text/event-stream",
                                                                      "Accept-Encoding": "gzip"})
        try:
            if r.status != 200:
                try:
                    said = json.loads(r.read() or b"{}")
                except (ValueError, OSError):
                    said = {}
                raise PeerError((said or {}).get("error") or f"it answered {r.status}")
            r.peer_sock.settimeout(PEER_SILENT)     # it says "still here" every 15 s: silent longer, it's gone
            unzip = zlib.decompressobj(31) if r.getheader("Content-Encoding") == "gzip" else None
            buf, event = b"", None
            while machine_find(name):
                try:
                    chunk = r.read1(65536)
                except (OSError, ValueError) as e:
                    raise PeerError(peer_why(e)) from None
                if not chunk:
                    raise PeerError("it stopped answering")
                with self.lock:
                    if name in self.seen:
                        self.seen[name]["heard"] = time.time()
                buf += unzip.decompress(chunk) if unzip else chunk
                while b"\n\n" in buf:
                    block, buf = buf.split(b"\n\n", 1)
                    event, data = None, []
                    for line in block.decode("utf-8", "replace").split("\n"):
                        if line.startswith("event:"):
                            event = line[6:].strip()
                        elif line.startswith("data:"):
                            data.append(line[5:].lstrip(" "))
                    if event == "state" and data:
                        got = json.loads("\n".join(data))
                        hello_now = got.get("machine") if isinstance(got.get("machine"), dict) else h
                        self.update(name, on=True, error=None, update=None, reconnecting=None, hello=hello_now, at=time.time(),
                                    sessions=[s for s in got.get("sessions") or [] if isinstance(s, dict) and s.get("id")],
                                    projects=got.get("projects") or [], tasks=got.get("tasks") or [],
                                    boards=got.get("boards") if isinstance(got.get("boards"), list) else None,
                                    moved=[r for r in got.get("moved") or [] if isinstance(r, dict)
                                           and isinstance(r.get("from"), str) and isinstance(r.get("to"), str)])
                        if hello_now.get("label") and hello_now["label"] != m["label"]:
                            try:
                                machine_keep({**m, "label": hello_now["label"]})
                            except ValueError:
                                pass
        finally:
            conn.close()

    def snapshot(self):
        with self.lock:
            return {k: dict(v) for k, v in self.seen.items()}


# What a request passed on to another machine carries of the page's, and
# what of that machine's answer comes back (the rest is this server's own:
# its security headers).
RELAY_HEADERS = ("Content-Type", "Accept", "Accept-Encoding", "Accept-Language", "Range", "If-None-Match",
                 "If-Modified-Since", "Last-Event-ID", "User-Agent")
RELAY_BACK = ("Content-Length", "Content-Encoding", "ETag", "Content-Range", "Accept-Ranges", "Vary", "Last-Modified")


def peer_state(view):
    """What another machine's board takes of this one: its own chats (never
    the ones it shows from others), its projects and its agents' tasks."""
    return {"machine": hello(), "sessions": view.get("sessions") or [], "projects": view.get("projects") or [],
            "tasks": (view.get("today") or {}).get("tasks") or [], "boards": (view.get("today") or {}).get("boards") or [],
            "moved": view.get("moved") or []}


def boards_of_tasks(tasks):
    """An older machine's tasks (before boards), as its agents' own boards:
    each a board of its own, its cards pressed through /api/tasks/press there."""
    out = {}
    for t in tasks:
        if not isinstance(t, dict) or not isinstance(t.get("agent"), str) or not isinstance(t.get("id"), str):
            continue
        b = out.setdefault(t["agent"], {"id": t["agent"], "title": t.get("agent_name") or "", "lead": t["agent"],
                                        "lead_name": t.get("agent_name") or "", "task": True, "legacy": True, "rev": 0,
                                        "updated": 0, "at": 0, "check": False, "yours": 0, "cards": [],
                                        "columns": [{"name": "For you", "yours": True, "approval": False, "done": False, "count": 0},
                                                    {"name": "Done", "yours": False, "approval": False, "done": True, "count": 0}]})
        b["cards"].append({"id": t["id"], "key": "", "title": t.get("title") or "", "column": "For you", "block": None,
                           "note": t.get("note") or "", "links": t.get("links") or [], "agent": t["agent"],
                           "agent_name": t.get("agent_name") or "", "by": t["agent"], "at": t.get("at") or 0,
                           "updated": t.get("at") or 0, "until": t.get("until") or 0, "task": True, "approved": None,
                           "sha256": "", "answered": False, "edited": False, "count": 0, "thread": [],
                           "buttons": [{"label": x.get("label") or "", "to": "", "asks": "", "own": True, "send": x.get("send") or ""}
                                       for x in t.get("buttons") or [] if isinstance(x, dict)]})
        b["yours"] = b["columns"][0]["count"] = len(b["cards"])
    return list(out.values())


def board_view(st):
    """The board: this machine's chats and every paired machine's, each
    with its machine; machines, this one first, and how each stands. Made
    once per change (st.version)."""
    with st.changed:
        view, version = st.view, st.version
    memo = getattr(st, "board", None)
    if memo and memo[0] == version:
        return memo[1]
    me = machine_name()
    machines = [{"name": me, "label": machine_label(), "icon": machine_icon(), "me": True, "on": True, "since": None, "error": None,
                 "update": None, "version": amarchy_version(), "seen": True,
                 "projects": [{"name": p["name"], "github": p.get("github")} for p in view.get("projects") or []]}]
    sessions = list(view.get("sessions") or [])
    tasks = list((view.get("today") or {}).get("tasks") or [])
    boards = list((view.get("today") or {}).get("boards") or [])
    peers = st.peers.snapshot() if getattr(st, "peers", None) else {}
    paired = {m["name"]: m for m in machines_read()} if peers else {}
    for name, p in peers.items():
        m = paired.get(name)
        if not m:
            continue
        h = p.get("hello") or {}
        off = not p.get("on") and not p.get("reconnecting")
        machines.append({"name": name, "label": str(h.get("label") or m["label"])[:LABEL_MAX], "me": False,
                         "icon": h.get("icon") if h.get("icon") in MACHINE_ICONS else "desktop",
                         "reconnecting": p.get("reconnecting") if not off else None,
                         "on": not off, "since": p.get("since"), "error": p.get("error"), "update": p.get("update"),
                         "version": h.get("version") or "", "seen": bool(p.get("sessions") or p.get("at")),
                         "projects": [{"name": x.get("name"), "github": x.get("github")} for x in p.get("projects") or []
                                      if isinstance(x, dict) and isinstance(x.get("name"), str)]})
        if p.get("update"):
            continue            # another protocol: what to update, not its chats (they may not read the same)
        for s in p.get("sessions") or []:
            sessions.append({**s, "machine": name, **({"machine_off": True} if off else {})})
        tasks += [{**x, "machine": name} for x in p.get("tasks") or [] if isinstance(x, dict) and not off]
        if not off:     # its boards (an older one's tasks, as boards), each with its machine
            theirs = p.get("boards") if isinstance(p.get("boards"), list) else boards_of_tasks(p.get("tasks") or [])
            boards += [{**x, "machine": name} for x in theirs if isinstance(x, dict) and isinstance(x.get("id"), str)]
    # Moved chats (see "moving a chat"): every machine's, each old key to
    # the one it's under now; and one that moved a moment ago, as it was,
    # under its new key, until its new machine's list has it (its card keeps
    # its place, never gone for a second).
    moved_rows = list(view.get("moved") or [])
    for name, p in peers.items():
        if name in paired:
            moved_rows += [r for r in p.get("moved") or [] if isinstance(r, dict)]
    board_keys = {f"{s.get('machine') or me}:{s['id']}" for s in sessions}
    now = time.time()
    for r in moved_rows:
        to, row = r.get("to"), r.get("row")
        where, _, to_id = (to or "").partition(":")
        if isinstance(row, dict) and to and to not in board_keys and where != me and where in paired \
                and now - (r.get("at") or 0) < MOVED_ROW and to_id:
            sessions.append({**row, "id": to_id, "machine": where, "moved_from": r["from"]})
            board_keys.add(to)
    # What needs you: not a chat on a machine that's off (nothing to answer it with until it's back).
    waiting = [{"id": i["id"], "machine": i["machine"], "chat": f"{i['machine']}:{i['chat']}", "kind": i["kind"], "text": i["text"],
                "pictures": i.get("pictures") or 0, "at": i["at"]} for i in outbox_list()]
    board = {**view, "sessions": sessions, "machine": me, "machines": machines, "merges": True, "machines_as": machines_as(),
             "outbox": waiting,
             "dictation": dictate_view(st, view.get("dictation") or dictate_status()),
             "needs": needs_you([s for s in sessions if not s.get("machine_off")]),
             "moved": moved_map([r for r in moved_rows if r.get("from") not in board_keys])}
    if len(machines) > 1:
        # Every machine's in the order tasks_view gives one's (then by machine):
        # the same on each machine's board, not this one's first.
        tasks.sort(key=lambda t: (not t.get("until"), t.get("until") or t.get("at") or 0, t.get("at") or 0,
                                  t.get("machine") or me, str(t.get("id") or "")))
        # Boards too: your assistant's first, then each machine's in its own order.
        order = {id(x): i for i, x in enumerate(boards)}
        boards.sort(key=lambda x: (x.get("role") != "main", x.get("machine") or me, order[id(x)]))
        board["today"] = {**(view.get("today") or {}), "tasks": tasks, "boards": boards}
    st.board = (version, board)
    return board


def list_all():
    """amarchy list --all: this machine's chats, then every paired machine's
    (each asked at once), each with its machine; one that doesn't answer:
    its chats as last seen (the app's server keeps them), machine_off."""
    me = machine_name()
    rows = [{**s, "machine": me} for s in session_view()]
    found = {}

    def ask(m):
        try:
            status, d = peer_json(m, "GET", "/api/peer/state", timeout=5)
            if status == 200:
                found[m["name"]] = [{**s, "machine": m["name"]} for s in d.get("sessions") or [] if isinstance(s, dict)]
                return
        except PeerError:
            pass
        try:
            kept = json.loads((PEERS_SEEN / f"{m['name']}.json").read_text())
        except (OSError, ValueError):
            kept = {}
        found[m["name"]] = [{**s, "machine": m["name"], "machine_off": True} for s in kept.get("sessions") or [] if isinstance(s, dict)]
    ms = machines_read()
    ts = [threading.Thread(target=ask, args=(m,), daemon=True) for m in ms]
    for t_ in ts:
        t_.start()
    for t_ in ts:
        t_.join(8)
    for m in ms:
        rows += found.get(m["name"], [])
    return rows


# ---- what waits for a machine out of reach (the outbox)
#
# A message, or an answer to what a chat asks, for a chat on a machine that
# doesn't answer (restarting, a network blip, off): kept here (on disk, so
# a restart of this one keeps it too) and sent once it answers, in the order
# they were made. The board lists them (outbox), the app shows each as
# waiting, with Cancel.

OUTBOX = APP / "outbox"         # <id>.json: {id, machine, rest, ctype, body (base64), chat, text, kind, at, tries}
OUTBOX_ROUTE = re.compile(r"/api/session/[\w.-]{1,120}/(send|answer)")
OUTBOX_TRIES = 6                # times a machine that answers refuses one for a moment (409: waking...) before it's let go


def outbox_add(machine, rest, ctype, body):
    """Keep a request for a machine out of reach: the item kept."""
    path = rest.partition("?")[0]
    kind = OUTBOX_ROUTE.fullmatch(path).group(1)
    try:
        data = json.loads(body or b"{}")
    except ValueError:
        data = {}
    text = (data.get("text") if kind == "send" else data.get("choice") or data.get("answer")) if isinstance(data, dict) else None
    item = {"id": f"{time.time_ns()}-{os.urandom(3).hex()}", "machine": machine, "rest": rest, "ctype": ctype,
            "body": base64.b64encode(body or b"").decode(), "chat": path.split("/")[3], "kind": kind,
            "text": str(text or "")[:500], "pictures": len((data.get("images") or []) if isinstance(data, dict) else []),
            "at": time.time(), "tries": 0}
    write_file(OUTBOX / f"{item['id']}.json", json.dumps(item))
    return item


def outbox_list(machine=None):
    out = []
    for f in sorted(OUTBOX.glob("*.json")) if OUTBOX.is_dir() else []:
        try:
            item = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(item, dict) and (machine is None or item.get("machine") == machine):
            out.append(item)
    return sorted(out, key=lambda i: i.get("id", ""))


def outbox_drop(item_id):
    """Take one back (Cancel), or done with it: whether it was there."""
    if not re.fullmatch(r"\d+-[0-9a-f]{6}", item_id or ""):
        return False
    f = OUTBOX / f"{item_id}.json"
    there = f.exists()
    f.unlink(missing_ok=True)
    return there


_outbox_flushing = threading.Lock()


def outbox_flush(name):
    """Send what waits for machine name, in order, while it answers. Whether
    anything was sent (or let go)."""
    m = machine_find(name)
    items = outbox_list(name)
    if not m or not items:
        return False
    done = False
    with _outbox_flushing:
        for item in outbox_list(name):
            try:
                status, said = peer_json(m, "POST", item["rest"], base64.b64decode(item["body"]) or b"{}", timeout=330) \
                    if item.get("ctype", "").startswith("application/json") else (None, {})
            except PeerError:
                return done             # still out of reach: the rest wait too, in their order
            if status is None:
                outbox_drop(item["id"])
                continue
            if status in (409, 502, 503) and item.get("tries", 0) + 1 < OUTBOX_TRIES:
                item["tries"] = item.get("tries", 0) + 1     # waking, busy: again in a moment
                write_file(OUTBOX / f"{item['id']}.json", json.dumps(item))
                return done
            if status >= 300:
                print(f"amarchy app: what waited for {name} wasn't taken ({status}: {said.get('error')}): {item['rest']}",
                      file=sys.stderr, flush=True)
            outbox_drop(item["id"])
            done = True
    return done


def outbox_tend(st):
    """Every couple of seconds: what waits for a machine that answers now, sent."""
    while True:
        try:
            names = {i.get("machine") for i in outbox_list()}
            peers = st.peers.snapshot() if st.peers else {}
            for name in names:
                if (peers.get(name) or {}).get("on") and outbox_flush(name):
                    st.bump()
        except Exception as e:
            print(f"amarchy app: outbox: {e}", file=sys.stderr, flush=True)
        time.sleep(2)


def peers_search(st, q, timeout=4):
    """What was said in the chats of every paired machine that's on, with
    each result's machine (Tasks' search)."""
    found, ms = [], {m["name"]: m for m in machines_read()}
    on = [ms[n] for n, p in st.peers.snapshot().items() if p.get("on") and n in ms]

    def ask(m):
        try:
            status, d = peer_json(m, "GET", f"/api/search?q={urllib.parse.quote(q)}", timeout=timeout)
        except PeerError:
            return
        if status == 200:
            found.extend({**r, "machine": m["name"]} for r in d.get("results") or [] if isinstance(r, dict) and r.get("id"))
    ts = [threading.Thread(target=ask, args=(m,), daemon=True) for m in on]
    for t_ in ts:
        t_.start()
    for t_ in ts:
        t_.join(timeout + 1)
    return list(found)


def peer_moments(st, board):
    """Tell this machine's phones about another machine's chat that went on
    to need you or finished (as app_moments does for its own), from what
    that machine said of it: its row."""
    me = board.get("machine")
    rows = {f"{s['machine']}:{s['id']}": s for s in board.get("sessions") or []
            if s.get("machine") and s.get("machine") != me and not s.get("machine_off")}
    now = {k: (s.get("status"), bool(s.get("unseen"))) for k, s in rows.items()}
    was = getattr(st, "peer_statuses", None)
    st.peer_statuses = now
    if was is None:
        return
    labels = {m["name"]: m["label"] for m in board.get("machines") or []}
    level = alerts()
    for k, s in rows.items():
        if k not in was:
            continue        # new to this board (a machine that came back): what it was isn't known
        state, unseen_now = now[k]
        prev, _ = was[k]
        finished = state == "idle" and prev in ("working", "running") and unseen_now
        if not (state == "waiting" and prev != "waiting" or finished):
            continue
        mine = s.get("assistant") in AGENT_ROLES
        if not mine and not (level == "all" or (level == "needs-you" and state == "waiting")):
            continue
        if time.time() - st.seen.get(k, 0) < APP_SEEN:
            continue
        body = (s.get("asks") or "Needs your answer") if state == "waiting" else \
            (f"Done: {s['said']}" if s.get("said") and not mine else s.get("said") or "Done")
        where = labels.get(s["machine"], s["machine"])
        url = f"/#/s/{s['machine']}:{s['id']}"
        if mine:
            payload = {"title": s.get("assistant_name") or "Your assistant", "body": body, "tag": f"assistant-{k}",
                       "url": url, "waiting": board.get("needs") or 0}
            if s.get("picture"):
                payload["icon"] = f"/api/m/{s['machine']}/picture/{s['picture']}-192.png"
        else:
            title = s.get("task") or f"A new chat in {project_name(s.get('repo') or '')}"
            payload = {"title": title, "body": f"{body}\n{project_name(s.get('repo') or '')} · {where}", "tag": k,
                       "url": url, "waiting": board.get("needs") or 0}
        if state == "waiting":
            payload["ask"] = k
        # The desktop app's: which chat, its chime, its buttons (through the pass-through).
        desktop = {"session": k, "sound": notice_chime(s, mine),
                   "actions": notice_actions(s, None, f"/api/m/{urllib.parse.quote(s['machine'], safe='')}")}
        threading.Thread(target=push_all, args=(payload, desktop), daemon=True).start()


# ------------------------------------------------------------------ moving a chat (track E)
#
# docs/plan-omarchy-and-machines.md, "Moving a chat". A chat lives on its
# machine, and you move it, never amarchy on its own: "Move to <label>" in its
# menu, or `amarchy move [<id>] --to <machine>`; only once its Claude's step
# is over (move_busy), and never your assistant or an agent. The machine it's
# on (A):
#   1. stops its Claude (as sleep does) and its previews;
#   2. commits what isn't committed as one WIP commit on its branch (the index
#      as it was kept, to put back) and pushes the branch to origin, forward
#      only (move_commit, move_push);
#   3. packs the rest (move_pack): its conversations, amarchy's own of it
#      (model, title, draft, who sent it what), and what git doesn't carry
#      (.amarchy/, the files git ignores but dependencies and builds, which are
#      made again there), and hands it to the other machine (B):
#      POST /api/peer/move;
#   4. B makes the worktree from the branch, puts everything in place, starts
#      its Claude on the conversation and answers once it's up (move_take);
#   5. A lets its own go (move_drop): tmux, worktree, branch, amarchy's state of
#      it; moved.json leads its old key to the new one, so its card keeps its
#      place and old links open it where it is.
# Anything wrong before B's answer: undone (move_undo). B's answer lost: A asks
# B to drop what it took (/api/peer/move/abort) first, and keeps asking
# (move_tend) until B answers. Each step is written down as it's done
# (MOVES/<id>.json on A, MOVES_IN/<move>.json on B), so a machine that dies in
# the middle finishes or undoes it once it's back.

MOVES = STATE / "moves"             # <id>.json: a move of one of this machine's chats (waiting, under way, failed); its lock; its package
MOVED = STATE / "moved.json"        # [{from, to, at, row}]: the chats moved away from here
MOVED_LOCK = STATE / "moved.lock"
MOVES_IN = STATE / "moves-in"       # <move>.json: a move this machine took (or is taking): what undoes it; <move>/ while it's unpacked
MOVE_MAX = 1 << 30                  # bytes of a move's package, at most
MOVE_CARRY_MAX = 512 << 20          # bytes of what git doesn't carry (the files it ignores), at most
MOVED_KEEP = 30 * 86400             # seconds a moved chat's old key leads to its new one
MOVED_ROW = 120                     # seconds a board shows a moved chat as it was, until its new machine's list has it
MOVE_FREE_WAIT = 24 * 3600          # how long a move waits for its chat to be free
MOVE_UP_WAIT = 90                   # seconds the new machine gives the chat's Claude to come up
MOVE_SEND_TIMEOUT = 900             # seconds the old machine waits for the new one to take it
MOVE_GIT_TIMEOUT = 180              # seconds a push or a fetch gets
MOVE_ERROR_KEEP = 7 * 86400         # a move that failed says so on its card this long (or until dismissed)
MOVE_TOKEN_RE = r"[0-9a-f]{32}"
# What's made again from the project (dependencies, builds, caches): never carried.
MOVE_REBUILT = {"node_modules", ".venv", "venv", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".tox",
                ".nox", "target", "dist", "build", "out", ".next", ".nuxt", ".svelte-kit", ".turbo", ".parcel-cache",
                ".cache", "coverage", ".gradle", ".terraform", "bower_components", ".expo", ".angular", ".vite",
                ".eggs", ".hypothesis", ".DS_Store"}
# Files that hold keys, not code: never in the WIP commit (it goes to origin), carried as they are.
MOVE_PRIVATE = re.compile(r"(?:^|/)(?:\.env(?!\.(?:example|sample|template|dist|defaults)$)(?:\.[\w.-]+)?|[^/]+\.(?:pem|key|p12|pfx|"
                          r"keystore|jks|kdbx)|id_(?:rsa|dsa|ecdsa|ed25519)(?:\.pub)?|\.npmrc|\.pypirc|\.netrc|\.pgpass|"
                          r"credentials(?:\.[\w-]+)?\.json|service[-_]account[\w.-]*\.json|secrets?\.(?:json|ya?ml|toml))$")
# Of amarchy's own for a chat (claude_dir), what goes with it.
MOVE_CHAT_FILES = ("conversation", "chosen.json", "title", "draft", "send", "attached.json")


class MoveError(Exception):
    """A move refused or failed, in words (undone already, or nothing done)."""


def move_read(sid):
    try:
        d = json.loads((MOVES / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) else None


def move_write(sid, rec):
    write_file(MOVES / f"{sid}.json", json.dumps(rec))


def move_forget(sid):
    for f in (MOVES / f"{sid}.json", MOVES / f"{sid}.pkg.tar.gz"):
        f.unlink(missing_ok=True)


def move_lock(sid):
    """The lock of a chat's move, held while it's under way (or waits for the
    chat to be free): the open file, or None when another move has it."""
    MOVES.mkdir(parents=True, exist_ok=True)
    lock = open(MOVES / f"{sid}.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return None
    return lock


def move_gate(sid, exclusive=False, wait=30):
    """The gate between a chat's move and what reaches it here (a message,
    an answer, a wake): held shared by each request to the chat from before
    it asks move_holds until it's done (its message with Claude, or queued),
    and an instant exclusively by a move once it says it's under way, so it
    looks at a chat with nothing left on its way in (move_busy sees it): a
    message sent as the move starts is either refused (move_holds) or in
    before it looks, never cut by the move stopping its Claude. The open
    file (closing it lets go), or None if it wasn't free within wait
    seconds."""
    MOVES.mkdir(parents=True, exist_ok=True)
    gate = open(MOVES / f"{sid}.gate", "a")
    end = time.time() + wait
    while True:
        try:
            fcntl.flock(gate, (fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH) | fcntl.LOCK_NB)
            return gate
        except OSError:
            if time.time() >= end:
                gate.close()
                return None
            time.sleep(0.05)


def move_running(sid):
    """Whether a move of this chat is under way now (its lock is held)."""
    lock = move_lock(sid)
    if lock:
        lock.close()
        return False
    return True


def move_shown(sid, rec=None):
    """A chat's move as its card shows it: (moving, move_error), each a dict or None."""
    rec = move_read(sid) if rec is None else rec
    if not rec or not rec.get("to"):
        return None, None
    if rec.get("error"):
        return None, {"to": rec["to"], "label": rec.get("label") or rec["to"], "error": rec["error"], "at": rec.get("at")}
    return {"to": rec["to"], "label": rec.get("label") or rec["to"], "step": rec.get("step") or "",
            "since": rec.get("since"), "when": "free" if rec.get("when") == "free" and not rec.get("started") else "now"}, None


def move_holds(sid):
    """Why nothing can be done to a chat here now, as it moves (sending it a
    message, waking it, completing it), or None. One that waits to be free
    still takes them: it's at work here until then."""
    moving, _ = move_shown(sid)
    if not moving or moving["when"] == "free":
        return None
    return f"It's moving to {moving['label']}: it's there in a moment"


# ---- the chats moved away from here

def moved_read():
    """moved.json, but what's older than MOVED_KEEP."""
    try:
        rows = json.loads(MOVED.read_text())
    except (OSError, ValueError):
        return []
    now = time.time()
    return [r for r in rows if isinstance(r, dict) and isinstance(r.get("from"), str) and isinstance(r.get("to"), str)
            and now - (r.get("at") or 0) < MOVED_KEEP] if isinstance(rows, list) else []


def moved_change(fn):
    """moved.json changed by fn(rows) -> rows, under its lock."""
    MOVED_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(MOVED_LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        rows = fn(moved_read())
        write_file(MOVED, json.dumps(rows))


def moved_add(entry):
    """A chat moved away from here: its old key leads to its new one."""
    moved_change(lambda rows: [r for r in rows if r["from"] != entry["from"]] + [entry])


def moved_back(key):
    """A chat comes (back) to this machine under key: its old key here leads nowhere now."""
    moved_change(lambda rows: [r for r in rows if r["from"] != key])


def moved_to(sid):
    """Where this machine's chat sid is now (<machine>:<id>), when it moved away, else None."""
    me = f"{machine_name()}:{sid}"
    return next((r["to"] for r in reversed(moved_read()) if r["from"] == me), None)


def moved_shared():
    """This machine's moved chats for the other machines' boards: the row
    only while it's fresh (it's on its new machine's list soon)."""
    now = time.time()
    return [{"from": r["from"], "to": r["to"], "at": r.get("at"),
             **({"row": r["row"]} if r.get("row") and now - (r.get("at") or 0) < MOVED_ROW else {})} for r in moved_read()]


def moved_map(rows):
    """{old key: the key it's under now}, each followed to the last (a chat
    moved twice), never round in a circle."""
    step = {}
    for r in sorted(rows, key=lambda r: r.get("at") or 0):
        step[r["from"]] = r["to"]
    out = {}
    for k in step:
        seen, at = {k}, step[k]
        while at in step and at not in seen:
            seen.add(at)
            at = step[at]
        if at != k:
            out[k] = at
    return out


# ---- what a move would do, and whether it can now

def move_busy(s):
    """Why a chat can't move this moment, its Claude's step not over (it
    moves once it is): [words], empty when it can."""
    sid = s["id"]
    reasons = []
    status = (STATUS / sid).read_text().strip() if (STATUS / sid).exists() else "idle"
    if status == "working":
        reasons.append("it's working")
    elif status == "waiting":
        reasons.append("it's waiting for your answer")
    if secret_asks(sid):
        reasons.append("it's asking you for a secret")
    live = agent_live(sid) if engine(s) == "chat" else {}
    if live.get("pending"):
        reasons.append("it's waiting for your answer")
    queued = send_queue(sid)
    if live.get("queue") or starting(sid) or (queued.is_dir() and any(queued.glob("[0-9]*"))):
        reasons.append("a message is on its way in")
    for d in background_sessions(s):
        if d.get("status") not in (None, "", "idle"):
            reasons.append(f"a background session is at work ({' '.join(str(d.get('name') or 'it').split())[:60]})")
    pane = host_pane(s)
    procs = processes()
    if pane and pane_claude(pane, procs):
        # What sleep says would be lost (a task running, a /loop, a command in
        # the background), but what only says it just finished a turn: the
        # move stops it as sleep does, its conversation all written.
        for why in sleep_blockers(s, pane, procs, auto=False):
            if why not in ("its conversation is still moving", "Claude isn't running in its pane"):
                reasons.append(why)
        f = transcript(s)
        subagents = f.with_suffix("") / "subagents" if f else None
        if subagents and subagents.is_dir() and any(time.time() - x.stat().st_mtime < QUIET for x in subagents.glob("*.jsonl")):
            reasons.append("a subagent of its is still at work")
    return list(dict.fromkeys(reasons))


def move_git(path, *args, timeout=60, net=False, input=None):
    """git in a worktree, for the move: its result (never waiting on a
    password: it fails instead)."""
    try:
        return subprocess.run(["git", *args], cwd=path, capture_output=True, text=True, input=input,
                              stdin=None if input is not None else subprocess.DEVNULL, timeout=timeout,
                              env=git_net_env() if net else None)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 1, "", f"no answer in {timeout}s")


def move_branch(path):
    """The branch a worktree is on, or None (a detached HEAD)."""
    r = move_git(path, "symbolic-ref", "--short", "-q", "HEAD")
    return r.stdout.strip() or None if r.returncode == 0 else None


def move_refused(s):
    """Why a chat can't move at all, whatever its Claude does (it says so,
    and what to do about it), or None."""
    if s.get("setup"):
        return "it's still being set up"
    if (CLOSING / f"{s['id']}.json").exists():
        return "it's being completed"
    role = team_of(s)[0]
    if role == "main":
        return "your assistant lives on its machine (amarchy assistant off makes it a chat like the others)"
    if role == "agent":
        return f"an agent lives on its machine (amarchy agents {s['id']} off makes it a chat like the others)"
    path, repo_dir = Path(s["path"]), WORK / s["repo"]
    if not path.is_dir():
        return "its worktree isn't there"
    if not has_origin(repo_dir):
        return f"{s['repo']} has no origin to carry its branch to the other machine (git remote add origin <its address>)"
    if not move_branch(path):
        return "its worktree isn't on a branch (a detached HEAD): check one out first"
    git_dir = Path(move_git(path, "rev-parse", "--absolute-git-dir").stdout.strip() or path / ".git")
    for mark, what in (("MERGE_HEAD", "a merge"), ("rebase-merge", "a rebase"), ("rebase-apply", "a rebase"),
                       ("CHERRY_PICK_HEAD", "a cherry-pick"), ("REVERT_HEAD", "a revert"), ("BISECT_LOG", "a bisect")):
        if (git_dir / mark).exists():
            return f"it's in the middle of {what}: finish it (or abort it) first"
    if move_git(path, "ls-files", "-u").stdout.strip():
        return "it has conflicts to resolve first"
    return None


def move_files(path):
    """What of a worktree git won't carry, sorted out: carry (what git
    ignores, a path each: .amarchy/, .env.local...), private (files git would
    commit that hold keys: carried, never committed), left (dependencies and
    builds, made again there), size (bytes carried)."""
    path = Path(path)
    carry, left, size = [], [], 0

    def tally(full):
        nonlocal size
        if full.is_symlink():
            return
        if full.is_file():
            size += full.stat().st_size
            return
        for root, dirs, files in os.walk(full):
            for d in list(dirs):
                if d in MOVE_REBUILT:
                    dirs.remove(d)
                    left.append(str((Path(root) / d).relative_to(path)) + "/")
            for f in files:
                try:
                    st_ = os.lstat(os.path.join(root, f))
                except OSError:
                    continue
                if st_.st_mode & 0o170000 == 0o100000:     # a regular file
                    size += st_.st_size

    r = move_git(path, "ls-files", "-z", "--others", "--ignored", "--exclude-standard", "--directory")
    for e in (x for x in r.stdout.split("\0") if x):
        rel = e.rstrip("/")
        if any(p in MOVE_REBUILT for p in rel.split("/")):
            left.append(e)
            continue
        full = path / rel
        if full.is_symlink() and not move_link_ok(path, full):
            left.append(e)
            continue
        tally(full)
        carry.append(rel)
    # What git would commit: kept out of the WIP commit when it holds a key
    # (it goes to origin, GitHub), and carried as it is instead.
    private = []
    r = move_git(path, "ls-files", "-z", "--others", "--exclude-standard")
    values = secret_values()
    for rel in (x for x in r.stdout.split("\0") if x):
        full = path / rel
        if MOVE_PRIVATE.search(rel) or move_has_secret(full, values):
            if not full.is_symlink() or move_link_ok(path, full):
                tally(full)
                private.append(rel)
    return {"carry": carry, "private": private, "left": sorted(set(left)), "size": size}


def move_link_ok(root, link):
    """Whether a symlink can go as it is: it points inside the worktree."""
    try:
        target = os.readlink(link)
    except OSError:
        return False
    if os.path.isabs(target):
        return False
    return os.path.normpath(os.path.join(os.path.dirname(os.path.relpath(link, root)), target)).split(os.sep)[0] != ".."


def move_has_secret(f, values=None):
    """Whether a file (a small one) has one of your secrets' values in it."""
    values = secret_values() if values is None else values
    if not values:
        return False
    try:
        if f.is_symlink() or not f.is_file() or f.stat().st_size > 4 << 20:
            return False
        text = f.read_bytes().decode("utf-8", "replace")
    except OSError:
        return False
    return any(v in text for v in values)


def move_committed_secrets(path, private):
    """The files a WIP commit would take that hold one of your secrets (a
    changed file git tracks: it would go to origin): their paths."""
    values = secret_values()
    if not values:
        return []
    r = move_git(path, "diff", "--name-only", "-z", "HEAD")
    return [rel for rel in r.stdout.split("\0") if rel and rel not in private and move_has_secret(Path(path) / rel, values)]


def move_secrets_asked(s):
    """The secrets this chat's Claude asked you for (amarchy secret ask, in its
    conversations) that are kept here: [{name, scope}]."""
    names = []
    for f in move_conversations(s):
        for _, use in tool_uses(conversation_records(f)):
            if use.get("name") == "Bash":
                for m in re.finditer(r"\bamarchy\s+secret\s+ask\s+([A-Za-z_][A-Za-z0-9_]*)", str((use.get("input") or {}).get("command") or "")):
                    names.append(m.group(1))
    out = []
    for name in dict.fromkeys(names):
        scope = secret_scope(s["repo"], name)
        if scope:
            out.append({"name": name, "scope": scope})
    return out


def move_conversations(s):
    """The chat's own conversations here (Claude Code's files): the one it's in,
    and the others written since it was made (after a /clear)."""
    folder = projects_dir(s["path"])
    current = conversation_id(s["id"])
    since = (s.get("created") or 0) - 60
    out = []
    for f in sorted(folder.glob("*.jsonl")) if folder.is_dir() else []:
        try:
            if f.stem == current or f.stat().st_mtime >= since:
                out.append(f)
        except OSError:
            continue
    return out


def move_check(s, to=None):
    """What moving a chat to machine `to` would do, for the app and
    `amarchy move --check`: where (to, label, on), busy (why not this moment),
    refused (why not at all), changes (files not committed), secrets (the
    names it asked for), previews, left (what isn't carried), size."""
    m = machine_find(to) if to else None
    label = m["label"] if m else to or ""
    out = {"id": s["id"], "to": to, "label": label, "on": False, "busy": [], "refused": None, "changes": 0,
           "secrets": [], "previews": [preview_label(p) for p in previews(s) if p.get("run")], "left": [], "size": 0,
           "moving": move_shown(s["id"])[0], "origin": "GitHub" if project_github(s["repo"]) else "origin"}
    if to and to == machine_name():
        out["refused"] = "it's on this machine already"
    elif to and not m:
        out["refused"] = f"no machine {to} is paired with this one (amarchy machines lists them)"
    out["refused"] = out["refused"] or move_refused(s)
    if m and not out["refused"]:
        try:
            status, h = peer_json(m, "GET", "/api/peer/hello", timeout=5)
            why = protocol_words(h.get("protocol"), label) if status == 200 else (h.get("error") or f"it answered {status}")
            if not why and not h.get("moves"):
                why = f"Update amarchy on {label}: it doesn't take chats from other machines yet"
            out["on"] = not why
            if why:
                out["refused"] = why
        except PeerError as e:
            out["refused"] = f"{label} is off: {e}"
    path = Path(s["path"])
    if path.is_dir():
        out["changes"] = len(move_git(path, "status", "--porcelain").stdout.splitlines())
        files = move_files(path)
        out["left"], out["size"] = files["left"], files["size"]
        if files["size"] > MOVE_CARRY_MAX and not out["refused"]:
            out["refused"] = (f"what git ignores in it is too big to carry ({files['size'] >> 20} MB, "
                              f"{MOVE_CARRY_MAX >> 20} MB at most): remove what it doesn't need")
        bad = move_committed_secrets(path, files["private"])
        if bad and not out["refused"]:
            out["refused"] = (f"{bad[0]} has one of your secrets in it, and moving would commit it to origin: "
                              f"take the secret out first (amarchy secret keeps it)")
    out["secrets"] = [x["name"] for x in move_secrets_asked(s)]
    if not out["refused"]:
        out["busy"] = move_busy(s)
    return out


# ---- on the old machine: the move, and what undoes it

def move_spawn(argv):
    """A move of its own, outside whoever asked (the app's server restarts
    with an update; a chat's own Claude stops as it moves): a systemd unit
    when there is one, else a process let go."""
    keep = {k: v for k, v in os.environ.items()
            if k in ("HOME", "PATH", "LANG", "XDG_STATE_HOME", "XDG_CONFIG_HOME", "XDG_RUNTIME_DIR", "SSH_AUTH_SOCK",
                     "DBUS_SESSION_BUS_ADDRESS")
            or k.startswith(("GIT_AUTHOR_", "GIT_COMMITTER_"))
            or (k.startswith("AMARCHY") and k not in SESSION_ENV)}
    full = [sys.executable, SELF, *argv]
    if shutil.which("systemd-run"):
        r = sh("systemd-run", "--user", "--quiet", "--collect", f"--unit=amarchy-move-{time.time_ns()}",
               f"--description=amarchy move {' '.join(argv[:1])}", f"--working-directory={HOME}",
               *(f"--setenv={k}={v}" for k, v in keep.items()), *full)
        if r.returncode == 0:
            return True
    subprocess.Popen(full, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True, cwd=str(HOME), env={**clean_env(), **keep})
    return True


def move_out(sid, to, secrets=False, when="now", say=None):
    """Move this machine's chat sid to machine `to` (see above), its secrets
    too when you said so; with when="free", once its Claude's step is over.
    None once it's there; else MoveError, saying why (undone)."""
    say = say or (lambda text: None)
    lock = move_lock(sid)
    if not lock:
        raise MoveError("it's being moved already")
    try:
        s = session(sid)
        if not s:
            raise MoveError(f"no chat {sid} here")
        m = machine_find(to)
        if not m:
            raise MoveError(f"no machine {to} is paired with this one (amarchy machines lists them)")
        if m["name"] == machine_name():
            raise MoveError("it's on this machine already")
        rec = {"to": m["name"], "label": m["label"], "when": when, "secrets": bool(secrets), "since": time.time(),
               "step": "Waiting for it to be free" if when == "free" else "Getting ready", "pid": os.getpid()}
        was = move_read(sid) or {}
        if was.get("since") and not was.get("error") and was.get("to") == m["name"]:
            rec["since"] = was["since"]         # (the one the app wrote, a moment ago)
        move_write(sid, rec)
        try:
            if when == "free":
                move_wait_free(s, m, rec, say)
            return move_go(session(sid) or s, m, rec, say)
        except MoveError as e:
            if (move_read(sid) or {}).get("cancel"):
                move_forget(sid)
            else:
                move_write(sid, {"to": m["name"], "label": m["label"], "error": str(e), "at": time.time(),
                                 **{k: rec[k] for k in ("abort", "move") if rec.get(k)}})
            raise
    finally:
        lock.close()


def move_wait_free(s, m, rec, say):
    """Until the chat's Claude's step is over (and the other machine answers):
    the move waits, saying so on its card. MoveError when it's called off, or
    can't move at all any more."""
    sid, end, said = s["id"], time.time() + MOVE_FREE_WAIT, None
    while True:
        now = move_read(sid) or {}
        if not now or now.get("cancel"):
            raise MoveError("called off")
        s = session(sid)
        if not s:
            raise MoveError("it was closed")
        why = move_refused(s)
        if why:
            raise MoveError(why)
        busy = move_busy(s)
        if not busy:
            try:
                status, h = peer_json(m, "GET", "/api/peer/hello", timeout=5)
                if status == 200 and h.get("moves") and not protocol_words(h.get("protocol"), m["label"]):
                    return
                busy = [f"{m['label']} doesn't take it yet"]
            except PeerError:
                busy = [f"{m['label']} is off"]
        words = f"Waiting: {busy[0]}"
        if words != said:
            rec["step"] = words
            move_write(sid, {**now, "step": words, "pid": os.getpid()})
            say(words)
            said = words
        if time.time() > end:
            raise MoveError(f"it wasn't free in {MOVE_FREE_WAIT // 3600} hours ({busy[0]})")
        time.sleep(2)


def move_project_there(m, s, say):
    """The chat's project on machine m, cloned there first from GitHub when it
    isn't there (as Where does). MoveError when it can't be."""
    status, there = peer_json(m, "GET", "/api/peer/state", timeout=15)
    if status != 200:
        raise MoveError(there.get("error") or f"{m['label']} said no ({status})")
    slug = project_github(s["repo"])
    mine = {p.get("name"): p.get("github") for p in there.get("projects") or [] if isinstance(p, dict)}
    if slug and slug in mine.values():
        return
    if not slug and s["repo"] in mine:
        return          # (no GitHub address: the same name, its origin checked there)
    if not slug:
        raise MoveError(f"{s['repo']} isn't on {m['label']}, and has no GitHub address to clone it from there: add it there first")
    say(f"Cloning {slug} on {m['label']} first")
    status, added = peer_json(m, "POST", "/api/add", {"repo": slug}, timeout=930)
    if status != 200:
        raise MoveError(f"couldn't clone {slug} on {m['label']}: {added.get('error') or status}")


def move_die(at):
    """The tests: a move's process killed right here (AMARCHY_MOVE_DIE=at, a
    step's words or one of the points in between), as one killed would be."""
    if os.environ.get("AMARCHY_MOVE_DIE") == at:
        os._exit(9)


def move_go(s, m, rec, say):
    sid, label, path = s["id"], m["label"], Path(s["path"])
    if (move_read(sid) or {}).get("cancel"):
        raise MoveError("called off")
    rec.update(started=True, move=uuid.uuid4().hex)

    def step(text):
        move_die(text)
        rec["step"] = text
        move_write(sid, rec)
        say(text)

    step("Getting ready")
    # What was sent it as this started: in first (or refused), then looked at.
    gate = move_gate(sid, exclusive=True, wait=60)
    if not gate:
        raise MoveError("a message is on its way in")
    gate.close()
    why = move_refused(s)
    if why:
        raise MoveError(why)
    busy = move_busy(s)
    if busy:
        raise MoveError("; ".join(busy))
    try:
        status, h = peer_json(m, "GET", "/api/peer/hello", timeout=8)
    except PeerError as e:
        raise MoveError(f"{label} is off: {e}") from None
    why = protocol_words(h.get("protocol"), label) if status == 200 else (h.get("error") or f"{label} answered {status}")
    if why:
        raise MoveError(why)
    if not h.get("moves"):
        raise MoveError(f"Update amarchy on {label}: it doesn't take chats from other machines yet")
    try:
        move_project_there(m, s, step)
    except PeerError as e:
        raise MoveError(f"{label} is off: {e}") from None
    files = move_files(path)
    if files["size"] > MOVE_CARRY_MAX:
        raise MoveError(f"what git ignores in it is too big to carry ({files['size'] >> 20} MB): remove what it doesn't need")
    bad = move_committed_secrets(path, files["private"])
    if bad:
        raise MoveError(f"{bad[0]} has one of your secrets in it, and moving would commit it to origin: take it out first")
    asked = move_secrets_asked(s) if rec.get("secrets") else []
    # From here on, each step is undone when a later one fails (move_undo).
    undo = rec.setdefault("undo", {})
    undo["previews"] = [p["key"] for p in previews(s) if p.get("run") and preview_state(s, p) in ("up", "starting")]
    undo["private"] = files["private"]      # (carried, not committed: all that may be left of it here)
    move_write(sid, rec)
    try:
        step("Stopping its Claude")
        lock = sleep_lock(wait=True)
        try:
            why = put_to_sleep(s, force=True)       # (its step is over: nothing it would lose)
        finally:
            if lock:
                lock.close()
        if why:
            raise MoveError(f"its Claude didn't stop: {why}")
        left = preview_close(s)
        if left:
            raise MoveError(PREVIEW_LEFT + "; ".join(left))
        # Each written down before git does it: a mover killed in the middle
        # (move --tend undoes it) knows what it had begun.
        def noted(**what):
            undo.update(what)
            move_write(sid, rec)
        step("Committing its work")
        move_commit(s, label, files, noted)
        step("Pushing its branch")
        move_push(path, undo["branch"], noted)
        step("Packing its conversation")
        pkg = MOVES / f"{sid}.pkg.tar.gz"
        move_pack(s, rec, files, [{**x, "value": session_secrets(s["repo"]).get(x["name"])} for x in asked], pkg)
        step(f"Handing it to {label}")
        rec["sent"] = True
        move_write(sid, rec)
        kind, said = move_send(m, pkg, rec["move"])
        if kind == "lost":
            step(f"{label} didn't answer: asking it to let go")
            gone, kept = move_abort_ask(m, rec["move"])
            if gone == "kept":
                kind, said = "ok", {**kept, "notes": [f"{label} didn't answer in time, but has it, and it was used there since"]}
            elif gone is None:
                rec["abort"] = True     # (move_tend asks again until it answers)
                raise MoveError(f"{label} didn't answer ({said}): it's here as it was. If it shows up on {label} "
                                f"too, amarchy takes it off there once {label} answers again")
            else:
                raise MoveError(f"{label} didn't take it ({said})")
        if kind != "ok":
            raise MoveError(said)
    except MoveError:
        move_undo(s, rec, say)
        raise
    except Exception as e:      # a bug: never half moved
        move_undo(s, rec, say)
        raise MoveError(f"it failed ({type(e).__name__}: {e})") from None
    rec["answered"] = said
    step(f"On {label}: letting it go here")
    notes = move_drop(s, m, said, rec)
    move_forget(sid)
    return {"key": said.get("key"), "id": said.get("id"), "notes": [*(said.get("notes") or []), *notes]}


MOVE_WIP = "WIP: moving to "      # a move's WIP commit's subject begins so


def move_commit(s, label, files, noted):
    """What isn't committed in the chat's worktree, as one WIP commit on its
    branch (but the files that hold keys: files["private"], carried instead).
    Noted (for move_undo) before each step: {branch, head (before it), index
    (the index as it was, a tree)}, then {wip: the commit} once it's made (none:
    nothing to commit). All of it, too."""
    path = Path(s["path"])
    branch = move_branch(path)
    if not branch:
        raise MoveError("its worktree isn't on a branch")
    head = move_git(path, "rev-parse", "HEAD").stdout.strip()
    r = move_git(path, "write-tree")
    if r.returncode != 0:
        raise MoveError(f"couldn't read its index: {gist(r.stderr) or 'git write-tree failed'}")
    out = {"branch": branch, "head": head, "index": r.stdout.strip(), "wip": None}
    noted(**out)
    r = move_git(path, "add", "-A")
    if r.returncode != 0:
        move_git(path, "read-tree", out["index"])
        raise MoveError(f"couldn't take its changes: {gist(r.stderr)}")
    if files["private"]:
        move_git(path, "reset", "-q", "--pathspec-from-file=-", "--pathspec-file-nul", input="\0".join(files["private"]))
    if move_git(path, "diff", "--cached", "--quiet").returncode == 0:
        move_git(path, "read-tree", out["index"])
        return out
    task = session_task(s, "") or s["name"]
    message = (f"{MOVE_WIP}{label} (amarchy move)\n\nWhat \"{task}\" hadn't committed yet when it moved from "
               f"{machine_label()} to {label}, so its work goes with it. Amend or squash it before it's merged.\n")
    ident = []
    if not move_git(path, "config", "user.email").stdout.strip():
        ident = ["-c", "user.name=amarchy", "-c", f"user.email=amarchy@{machine_name()}"]
    r = move_git(path, *ident, "-c", "commit.gpgsign=false", "commit", "-q", "--no-verify", "-m", message)
    if r.returncode != 0:
        move_git(path, "read-tree", out["index"])
        raise MoveError(f"couldn't commit its work: {gist(r.stderr or r.stdout)}")
    out["wip"] = move_git(path, "rev-parse", "HEAD").stdout.strip()
    move_die("committed")
    noted(wip=out["wip"])
    return out


def move_push(path, branch, noted):
    """The branch pushed to origin, forward only. Noted (for move_undo) before
    it pushes: {origin (its branch there before, or None), pushed (what it
    pushes)}. All of it, too."""
    r = move_git(path, "ls-remote", "origin", f"refs/heads/{branch}", net=True, timeout=MOVE_GIT_TIMEOUT)
    if r.returncode != 0:
        raise MoveError(f"couldn't reach origin: {gist(r.stderr) or 'git ls-remote failed'}")
    before = (r.stdout.split() or [None])[0]
    head = move_git(path, "rev-parse", "HEAD").stdout.strip()
    if before and before != head:
        f = move_git(path, "fetch", "-q", "origin", f"+refs/heads/{branch}:refs/remotes/origin/{branch}", net=True,
                     timeout=MOVE_GIT_TIMEOUT)
        if f.returncode != 0:
            raise MoveError(f"couldn't fetch origin's {branch}: {gist(f.stderr)}")
        if not is_ancestor(before, head, path):
            raise MoveError(f"origin's {branch} has commits this chat doesn't: bring them in first (git pull), then move it")
    out = {"origin": before, "pushed": None}
    if before != head:
        out["pushed"] = head
        noted(**out)
        p = move_git(path, "push", "-q", "--no-verify", "-u", "origin", f"HEAD:refs/heads/{branch}", net=True, timeout=MOVE_GIT_TIMEOUT)
        if p.returncode != 0:
            raise MoveError(f"couldn't push its branch to origin: {gist(p.stderr) or 'git push failed'}")
        move_die("pushed")
    else:
        noted(**out)
        move_git(path, "branch", "-q", f"--set-upstream-to=origin/{branch}")
    return out


def move_pack(s, rec, files, secrets, out):
    """The chat's package for the other machine (see the plan): move.json,
    its conversations, amarchy's own of it, what git doesn't carry."""
    import io
    import tarfile
    sid, path = s["id"], Path(s["path"])
    convs = move_conversations(s)
    undo = rec.get("undo") or {}
    keep = {k: v for k, v in s.items() if k not in VIEW_FIELDS and k not in ("setup", "prompt", "previews", "preview",
                                                                            "status", "moving", "move_error")}
    stamp = lambda f: f.stat().st_mtime if f.exists() else None
    manifest = {
        "version": 1, "move": rec["move"], "from": {"machine": machine_name(), "id": sid, "label": machine_label()},
        "session": keep, "repo": s["repo"], "github": project_github(s["repo"]),
        "origin": hashlib.sha256(sh("git", "remote", "get-url", "origin", cwd=WORK / s["repo"]).stdout.strip().encode()).hexdigest(),
        "branch": undo.get("branch") or s["branch"], "commit": undo.get("pushed") or move_git(path, "rev-parse", "HEAD").stdout.strip(),
        "base": s.get("base"), "conversation": conversation_id(sid),
        "seen": seen_at(sid), "unseen": stamp(UNSEEN / sid), "status_at": stamp(STATUS / sid),
        "secrets": [x for x in secrets if x.get("value")],
        "run": {"command": (RUN / s["repo"]).read_text().strip() if (RUN / s["repo"]).is_file() else None,
                "saved": saved_commands(s["repo"])},
        "previews": [{**preview_stored(p), "local": bool(preview_local(p["url"]))} for p in previews(s)],
        "merges": merges_read().get(sid),
        "wip": {"commit": undo["wip"], "label": rec.get("label")} if undo.get("wip") else None,
        "left": files["left"],
    }
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(f".{out.name}.{os.getpid()}")

    def skip(info):
        parts = info.name.split("/")
        if any(p in MOVE_REBUILT for p in parts[1:]) or not (info.isfile() or info.isdir() or info.issym()):
            return None
        if info.issym() and (os.path.isabs(info.linkname) or ".." in Path(info.linkname).parts):
            return None
        return info

    with tarfile.open(tmp, "w:gz", compresslevel=6) as tar:
        data = json.dumps(manifest).encode()
        info = tarfile.TarInfo("move.json")
        info.size, info.mtime, info.mode = len(data), time.time(), 0o600
        tar.addfile(info, io.BytesIO(data))
        for f in convs:
            tar.add(f, f"claude-projects/{f.name}")
            folder = f.with_suffix("")
            if folder.is_dir():
                tar.add(folder, f"claude-projects/{folder.name}", filter=skip)
            history = HOME / ".claude/file-history" / f.stem
            if history.is_dir():
                tar.add(history, f"claude-home/file-history/{f.stem}", filter=skip)
            for todo in sorted((HOME / ".claude/todos").glob(f"{f.stem}-*.json")):
                tar.add(todo, f"claude-home/todos/{todo.name}")
        for name in MOVE_CHAT_FILES:
            f = claude_dir(sid) / name
            if f.is_file():
                tar.add(f, f"chat/{name}")
        for f, name in ((SENT_BY / f"{sid}.jsonl", "sent-by.jsonl"), (QUIET_TURNS / f"{sid}.jsonl", "quiet-turns.jsonl")):
            if f.is_file():
                tar.add(f, f"chat/{name}")
        for rel in [*files["carry"], *files["private"]]:
            full = path / rel
            if full.exists() or full.is_symlink():
                tar.add(full, f"worktree/{rel}", filter=skip)
    size = tmp.stat().st_size
    if size > MOVE_MAX:
        tmp.unlink()
        raise MoveError(f"it's too big to move ({size >> 20} MB, {MOVE_MAX >> 20} MB at most)")
    os.chmod(tmp, 0o600)
    os.replace(tmp, out)


def move_send(m, pkg, token):
    """The package to machine m: ("ok", its answer), ("refused", why: it
    took nothing), or ("lost", why: it may have taken it, or not)."""
    size = pkg.stat().st_size
    headers = {"Content-Type": "application/x-amarchy-move", "Content-Length": str(size), "X-Amarchy-Move": token}
    try:
        with open(pkg, "rb") as body:
            conn, r = peer_request(m, "POST", "/api/peer/move", body=body, headers=headers, timeout=MOVE_SEND_TIMEOUT)
            try:
                raw = r.read()
            except (OSError, ValueError) as e:
                return "lost", peer_why(e)
            finally:
                conn.close()
    except PeerError as e:
        return "lost", str(e)
    try:
        said = json.loads(zlib.decompress(raw, 31) if r.getheader("Content-Encoding") == "gzip" else raw or b"{}")
    except (ValueError, zlib.error):
        said = None
    if not isinstance(said, dict):
        return "lost", f"it answered {r.status}, not amarchy's way"
    if r.status == 200 and said.get("key") and said.get("id"):
        return "ok", said
    if said.get("undone") or r.status in (400, 403, 404, 409, 413):
        return "refused", said.get("error") or f"{m['label']} said no ({r.status})"
    return "lost", said.get("error") or f"it answered {r.status}"


def move_abort_ask(m, token, tries=3):
    """Ask machine m to drop the move it may have taken: ("dropped", None)
    (or it never took it), ("kept", {id, key}) (used there since: it stays
    there), (None, None) (no answer)."""
    for i in range(tries):
        try:
            status, said = peer_json(m, "POST", "/api/peer/move/abort", {"move": token}, timeout=150)
            if status == 200:
                return "dropped", None
            if status == 409 and said.get("kept") and isinstance(said.get("key"), str):
                return "kept", {"key": said["key"], "id": said["key"].split(":", 1)[-1]}
        except PeerError:
            pass
        if i + 1 < tries:
            time.sleep(3 * (i + 1))
    return None, None


def move_undo(s, rec, say=None):
    """Put a chat back as it was before a move that failed: the WIP commit
    undone (its changes and the index as they were), origin's branch as it
    was, its previews started again. Its Claude stays asleep: what you send
    wakes it, its conversation as it was."""
    say = say or (lambda text: None)
    sid, path, undo = s["id"], Path(s["path"]), rec.get("undo") or {}
    notes = []
    if path.is_dir() and undo.get("head") and undo.get("index"):
        now = move_git(path, "rev-parse", "HEAD").stdout.strip()
        wip = undo.get("wip")
        if not wip and now != undo["head"]:
            # Its mover went right after committing, before it said so: the
            # WIP commit is the one on what it had, by its subject.
            parent = move_git(path, "rev-parse", "--verify", "--quiet", f"{now}^").stdout.strip()
            if parent == undo["head"] and move_git(path, "log", "-1", "--format=%s", now).stdout.startswith(MOVE_WIP):
                wip = now
        if wip and now == wip:
            move_git(path, "reset", "-q", "--soft", undo["head"])
            move_git(path, "read-tree", undo["index"])
        elif wip:
            notes.append(f"its WIP commit {wip[:9]} stays: its branch moved on since")
        elif now == undo["head"]:
            move_git(path, "read-tree", undo["index"])      # (its changes taken in, not committed yet: the index as it was)
    if undo.get("pushed") and path.is_dir():
        branch = undo["branch"]
        lease = f"--force-with-lease=refs/heads/{branch}:{undo['pushed']}"
        target = f"{undo['origin']}:refs/heads/{branch}" if undo.get("origin") else f":refs/heads/{branch}"
        p = move_git(path, "push", "-q", "--no-verify", lease, "origin", target, net=True, timeout=MOVE_GIT_TIMEOUT)
        if p.returncode != 0:
            # Never pushed (its mover went before it did): origin's as it was.
            there = move_git(path, "ls-remote", "origin", f"refs/heads/{branch}", net=True, timeout=MOVE_GIT_TIMEOUT)
            if there.returncode != 0 or ((there.stdout.split() or [None])[0] or None) != (undo.get("origin") or None):
                notes.append(f"origin's {branch} has its WIP commit still ({gist(p.stderr)})")
        elif not undo.get("origin"):
            move_git(path, "branch", "-q", "--unset-upstream")
    for key in undo.get("previews") or []:
        p = preview_pick(session(sid) or s, key)
        if p and p.get("run"):
            preview_start(session(sid) or s, p)
    (MOVES / f"{sid}.pkg.tar.gz").unlink(missing_ok=True)
    for n in notes:
        say(n)
    return notes


def move_drop(s, m, answer, rec):
    """The chat is on machine m now (it answered): let it go here. Its old key
    leads to the new one; its tmux, worktree (never with work not committed),
    branch (origin has it) and amarchy's state of it go; Claude's files of its
    conversations stay, as closing leaves them. Not a mission completed; its
    merges went with it. Notes, in words, of what stayed."""
    sid, path, repo_dir = s["id"], Path(s["path"]), WORK / s["repo"]
    notes = []
    row = next((app_row(x) for x in session_view() if x["id"] == sid), None)
    if row:
        row = {k: v for k, v in row.items() if k not in ("moving", "move_error", "secret_asks", "previews", "agent",
                                                        "path", "awake", "background", "running", "serving")}
        row.update(machine=m["name"], id=answer["id"], sleeping=True, status="idle")
    moved_add({"from": f"{machine_name()}:{sid}", "to": answer["key"], "at": time.time(), **({"row": row} if row else {})})
    (SESSIONS / f"{sid}.json").unlink(missing_ok=True)
    (STATUS / sid).unlink(missing_ok=True)
    (UNSEEN / sid).unlink(missing_ok=True)
    (SEEN / sid).unlink(missing_ok=True)
    (MOVES / f"{sid}.gate").unlink(missing_ok=True)
    move_merges_drop(sid)
    stop_background(s, only_idle=False)
    pane, term = host_pane(s), term_pane(s)
    scopes = [x for x in (pane_scope(pane["pid"]) if pane else None, pane_scope(term) if term else None) if x]
    host_stop(s)
    if installed_from(path) and (repo_dir / "install.sh").exists():
        put = sh(str(repo_dir / "install.sh"), "--force", cwd=repo_dir)
        if put.returncode != 0:
            notes.append(f"amarchy ran from it, and putting it back on {repo_dir} failed: its folder stays")
    stop_leftovers(path, scopes)
    if path.exists() and not installed_from(path):
        # Nothing of its work may be lost: what git would still see in it is
        # only what was carried (the files with keys, never committed), and
        # its HEAD is what origin has. Else the folder stays, said.
        undo = rec.get("undo") or {}
        carried = set(undo.get("private") or [])
        status = move_git(path, "status", "--porcelain", "-z", "--untracked-files=all").stdout
        left = [e[3:] for e in status.split("\0") if e]
        head = move_git(path, "rev-parse", "HEAD").stdout.strip()
        safe = all(e in carried for e in left) and head in (undo.get("pushed"), undo.get("head") if not undo.get("wip") else None,
                                                             answer.get("commit"))
        removed = sh("git", "worktree", "remove", *(["--force"] if safe and left else []), str(path), cwd=repo_dir)
        if path.exists() and removed.returncode != 0:
            notes.append(f"its folder stays at {path} on {machine_label()}: {last_line(removed, 'git worktree remove failed')}")
    sh("git", "worktree", "prune", cwd=repo_dir)
    branch = (rec.get("undo") or {}).get("branch") or s["branch"]
    tip = sh("git", "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=repo_dir).stdout.strip()
    there = sh("git", "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}", cwd=repo_dir).stdout.strip()
    pushed = (rec.get("undo") or {}).get("pushed") or there
    if tip and tip in (there, pushed) and not path.exists():
        sh("git", "branch", "-D", branch, cwd=repo_dir)
    shutil.rmtree(claude_dir(sid), ignore_errors=True)
    for x in (PREVIEWS / f"{sid}.json", PREVIEWS / f"{sid}.log", SENT_BY / f"{sid}.jsonl", QUIET_TURNS / f"{sid}.jsonl"):
        x.unlink(missing_ok=True)
    for x in PREVIEWS.glob(f"{sid}--*") if PREVIEWS.is_dir() else ():
        x.unlink(missing_ok=True)
    if not path.exists():
        set_trust(path, False)
    return notes


def move_merges_drop(sid):
    """A chat's merges go with it (the new machine counts them, once)."""
    MERGES_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(MERGES_LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        d = merges_read()
        if sid in d:
            d = {k: v for k, v in d.items() if k != sid}
            write_file(MERGES, json.dumps(d))


def move_merges_add(sid, entry):
    MERGES_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(MERGES_LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        d = dict(merges_read())
        d[sid] = entry
        write_file(MERGES, json.dumps(d))


# ---- on the new machine: taking a chat (POST /api/peer/move)

def move_find_project(man):
    """The project here a moving chat's is: the one with its GitHub address,
    else the one of the same name with the same origin. Its name, or MoveError."""
    slug = man.get("github")
    for p in projects(remotes=False):
        if slug and project_github(p["name"]) == slug:
            return p["name"]
    name = man.get("repo")
    if isinstance(name, str) and re.fullmatch(r"[\w.-]+", name) and (WORK / name / ".git").exists():
        origin = sh("git", "remote", "get-url", "origin", cwd=WORK / name).stdout.strip()
        if not slug and hashlib.sha256(origin.encode()).hexdigest() == man.get("origin"):
            return name
    raise MoveError(f"{slug or name} isn't on {machine_label()}")


def move_in_read(token):
    try:
        d = json.loads((MOVES_IN / f"{token}.json").read_text())
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) else None


def move_in_write(rec):
    write_file(MOVES_IN / f"{rec['move']}.json", json.dumps(rec))


@contextlib.contextmanager
def move_in_lock(token):
    """One at a time on a move taken here: undoing it (an abort, a take cut
    short found when the app starts) never twice at once."""
    MOVES_IN.mkdir(parents=True, exist_ok=True)
    with open(MOVES_IN / f"{token}.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def move_take(pkg, peer):
    """Take the chat in package pkg from machine peer (see the plan): its
    answer ({id, key, notes}) once its Claude is up here, or MoveError (all of
    it undone). The same move again: the answer it had."""
    import tarfile
    if not re.fullmatch(MACHINE_NAME_RE, peer or ""):
        raise MoveError("from which machine?")
    try:
        with tarfile.open(pkg) as tar:
            member = tar.getmember("move.json")
            if not member.isfile() or member.size > 4 << 20:
                raise ValueError
            man = json.loads(tar.extractfile(member).read())
    except (OSError, KeyError, ValueError, tarfile.TarError):
        raise MoveError("that isn't a chat's package") from None
    token = man.get("move")
    if not isinstance(token, str) or not re.fullmatch(MOVE_TOKEN_RE, token):
        raise MoveError("that isn't a chat's package")
    before = move_in_read(token)
    if before and before.get("state") == "done":
        return before["answer"]
    if before and before.get("state") == "taking" and pid_alive(before.get("pid")):
        raise MoveError("it's being taken already")
    rec = {"move": token, "from": f"{peer}:{(man.get('from') or {}).get('id')}", "label": (man.get("from") or {}).get("label") or peer,
           "state": "taking", "pid": os.getpid(), "at": time.time(), "undo": []}
    MOVES_IN.mkdir(parents=True, exist_ok=True)
    move_in_write(rec)
    stage = MOVES_IN / token
    try:
        shutil.rmtree(stage, ignore_errors=True)
        with tarfile.open(pkg) as tar:
            tar.extractall(stage, filter="data")
        answer = move_install(man, stage, rec)
    except BaseException as e:
        move_take_undo(rec)
        rec.update(state="undone", error=str(e))
        move_in_write(rec)
        if isinstance(e, MoveError):
            raise
        if isinstance(e, (KeyboardInterrupt, SystemExit)):
            raise
        raise MoveError(f"it failed on {machine_label()} ({type(e).__name__}: {e})") from None
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    rec.update(state="done", answer=answer, done_at=time.time())
    move_in_write(rec)
    return answer


def move_install(man, stage, rec):
    """Everything of a moving chat in place here, each step written down in
    rec["undo"] before it's done (a step cut short, by this server killed in
    the middle of it, is undone too: a worktree git had only begun, a file
    half copied); then its Claude started. Its answer."""
    label, here = rec["label"], machine_label()
    undo = rec["undo"]

    def did(*action):
        undo.append(list(action))
        move_in_write(rec)

    given = man.get("session") or {}
    name = slug(str(given.get("name") or ""))
    branch = man.get("branch")
    commit = man.get("commit")
    if not name or not isinstance(branch, str) or not re.fullmatch(r"[\w./-]{1,200}", branch) or ".." in branch \
            or not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40,64}", commit):
        raise MoveError("that isn't a chat's package")
    repo = move_find_project(man)
    repo_dir = WORK / repo
    sid = f"{repo}-{name}"
    path = WORKTREES / repo / name
    if session(sid) or (CLOSING / f"{sid}.json").exists():
        raise MoveError(f"a chat called {name} is on {here} already")
    if path.exists():
        raise MoveError(f"{path} is on {here} already (an old worktree?): remove it there first")
    # Its branch, from origin, at the commit it was pushed at.
    r = move_git(repo_dir, "fetch", "-q", "origin", f"+refs/heads/{branch}:refs/remotes/origin/{branch}", net=True,
                 timeout=MOVE_GIT_TIMEOUT)
    if r.returncode != 0:
        raise MoveError(f"couldn't fetch its branch from origin on {here}: {gist(r.stderr)}")
    if move_git(repo_dir, "rev-parse", f"refs/remotes/origin/{branch}").stdout.strip() != commit:
        raise MoveError(f"origin's {branch} isn't where {label} pushed it (someone pushed since?)")
    # Its base as origin has it now (not as this machine last fetched it): its
    # Changes here are what it changed, not what main did since.
    if str(given.get("base") or "").startswith("origin/"):
        fetch_base(repo_dir, given["base"])
    tip = move_git(repo_dir, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}").stdout.strip()
    if tip and tip != commit and not is_ancestor(tip, commit, repo_dir):
        raise MoveError(f"{here} has a branch {branch} with commits of its own: rename or delete it there first")
    listed = move_git(repo_dir, "worktree", "list", "--porcelain").stdout
    if f"branch refs/heads/{branch}\n" in listed + "\n":
        raise MoveError(f"its branch {branch} is checked out somewhere else on {here}")
    did("branch", branch, tip or None, str(repo_dir))
    if tip:
        move_git(repo_dir, "branch", "-q", "-f", branch, commit)
    else:
        move_git(repo_dir, "branch", "-q", branch, commit)
    move_git(repo_dir, "branch", "-q", f"--set-upstream-to=origin/{branch}", branch)
    path.parent.mkdir(parents=True, exist_ok=True)
    move_git(repo_dir, "worktree", "prune")
    did("worktree", str(path), str(repo_dir))
    r = move_git(repo_dir, "worktree", "add", "-q", str(path), branch)
    move_die("worktree made")
    if r.returncode != 0:
        raise MoveError(f"couldn't make its worktree on {here}: {gist(r.stderr)}")
    # What git doesn't carry: as it was there.
    carried = stage / "worktree"
    if carried.is_dir():
        for src in sorted(carried.rglob("*")):
            rel = src.relative_to(carried)
            dst = path / rel
            if src.is_dir() and not src.is_symlink():
                dst.mkdir(parents=True, exist_ok=True)
            elif not dst.exists() and not dst.is_symlink():
                dst.parent.mkdir(parents=True, exist_ok=True)
                os.replace(src, dst) if src.is_symlink() else shutil.copy2(src, dst)
    # Its conversations, where its Claude looks for them here (the worktree's
    # folder, as Claude Code names it); what was there kept, to put back.
    backup = MOVES_IN / f"{rec['move']}.backup"
    folder = projects_dir(path)
    for src in sorted((stage / "claude-projects").glob("*")) if (stage / "claude-projects").is_dir() else []:
        move_put(src, folder / src.name, backup, did)
    home = stage / "claude-home"
    for sub in ("file-history", "todos"):
        for src in sorted((home / sub).glob("*")) if (home / sub).is_dir() else []:
            move_put(src, HOME / ".claude" / sub / src.name, backup, did)
    # The chat: its record, amarchy's own of it.
    s = {k: v for k, v in given.items() if k not in VIEW_FIELDS and k not in ("setup", "prompt", "preview", "previews", "moving", "move_error")}
    s.update(id=sid, repo=repo, name=name, branch=branch, path=str(path), engine="chat")
    if not s.get("created"):
        s["created"] = int(time.time())
    ps = move_previews_here(man.get("previews") or [])
    if ps:
        s["previews"] = ps
    did("session", sid)
    d = claude_dir(sid)
    for f in MOVE_CHAT_FILES:
        src = stage / "chat" / f
        if src.is_file():
            write_file(d / f, src.read_bytes())
    if man.get("conversation") and re.fullmatch(r"[0-9a-f-]{36}", str(man["conversation"])):
        write_file(d / "conversation", man["conversation"])
    for src, dst in ((stage / "chat/sent-by.jsonl", SENT_BY / f"{sid}.jsonl"), (stage / "chat/quiet-turns.jsonl", QUIET_TURNS / f"{sid}.jsonl")):
        if src.is_file():
            write_file(dst, src.read_bytes())
    write_file(d / "moved-note", move_note(man, rec, path))
    notes = []
    notes += move_run_here(repo, man.get("run") or {}, did)
    notes += move_secrets_here(repo, man.get("secrets") or [], did)
    if isinstance(man.get("merges"), dict):
        move_merges_add(sid, man["merges"])
    # Seen and unread, as they were (their files' times say it).
    STATUS.mkdir(parents=True, exist_ok=True)
    (STATUS / sid).write_text("idle")
    if isinstance(man.get("status_at"), (int, float)):
        os.utime(STATUS / sid, (man["status_at"], man["status_at"]))
    if isinstance(man.get("seen"), (int, float)):
        SEEN.mkdir(parents=True, exist_ok=True)
        (SEEN / sid).touch()
        os.utime(SEEN / sid, (man["seen"], man["seen"]))
    if isinstance(man.get("unseen"), (int, float)):
        mark_unseen(sid)
        os.utime(UNSEEN / sid, (man["unseen"], man["unseen"]))
    save_session(s)
    moved_back(f"{machine_name()}:{sid}")
    did("trust", str(path))
    set_trust(path, True)
    # Its Claude, on the conversation: up (its broker idle, Claude running) before it answers.
    clear_asleep(sid)
    host_start(s, wake=True)
    why = move_wait_up(sid)
    if why:
        raise MoveError(f"its Claude didn't start on {here}: {why}")
    for left in man.get("left") or []:
        if isinstance(left, str):
            notes.append(f"not carried (made again there): {left}")
            break
    return {"id": sid, "key": f"{machine_name()}:{sid}", "notes": notes}


def move_put(src, dst, backup, did):
    """One of Claude Code's files of the chat (a conversation, its folder), in
    place: what was there kept in backup first, for its undo (written down
    before: move_take_undo puts back what's in backup, and leaves what never
    got there)."""
    keep = None
    if dst.exists() or dst.is_symlink():
        keep = backup / hashlib.sha1(str(dst).encode()).hexdigest()
        keep.parent.mkdir(parents=True, exist_ok=True)
        shutil.rmtree(keep, ignore_errors=True) if keep.is_dir() else keep.unlink(missing_ok=True)
    did("file", str(dst), str(keep) if keep else None)
    if keep:
        shutil.move(str(dst), str(keep))
    dst.parent.mkdir(parents=True, exist_ok=True)
    if src.is_dir():
        shutil.copytree(src, dst, symlinks=True)
    else:
        shutil.copy2(src, dst)


def move_previews_here(ps):
    """A moving chat's previews, at this machine's address: one served where
    it was (local) at the same port here (https://<this machine>:<port> over
    HTTPS where amarchy serves previews so, else http://<its name>:<port>);
    one served elsewhere (a deploy) as it was. Registered, not started."""
    out = []
    tls, (host, _) = preview_tls(), host_network()
    for p in ps:
        if not isinstance(p, dict) or not isinstance(p.get("url"), str):
            continue
        p = {k: v for k, v in p.items() if k in ("key", "name", "url", "run", "stop", "ports", "memory", "idle")}
        try:
            u = urllib.parse.urlsplit(p["url"])
            port = u.port
        except ValueError:
            continue
        local = any(isinstance(x, dict) and x.get("url") == p["url"] and x.get("local") for x in ps)
        if local and port:
            p["url"] = urllib.parse.urlunsplit(("https", f"{tls}:{port}", u.path, u.query, u.fragment) if tls
                                               else ("http", f"{host or 'localhost'}:{port}", u.path, u.query, u.fragment))
        out.append(p)
    return out


def move_run_here(repo, run, did):
    """The project's run commands from the other machine: the ones it hasn't
    got here (its own win). Notes, in words."""
    notes = []
    command, saved = run.get("command"), run.get("saved") if isinstance(run.get("saved"), dict) else {}
    if isinstance(command, str) and command.strip():
        mine = (RUN / repo).read_text().strip() if (RUN / repo).is_file() else None
        if mine is None:
            did("run", repo)
            set_run_command(repo, command)
        elif mine != command.strip():
            notes.append(f"its run command here is {machine_label()}'s own ({mine})")
    have = saved_commands(repo)
    for name, cmd in saved.items():
        if isinstance(name, str) and isinstance(cmd, str) and name not in have and cmd.strip():
            did("saved", repo, name)
            save_command(repo, name, cmd)
    return notes


def move_secrets_here(repo, secrets, did):
    """The secrets you said to copy: each kept here as it was there (this
    project's, or every project's), but one this machine has already. Notes."""
    notes = []
    for x in secrets:
        if not isinstance(x, dict) or not isinstance(x.get("name"), str) or not isinstance(x.get("value"), str):
            continue
        scope = None if x.get("scope") == "all" else repo
        if x["name"] in secrets_read(secret_file(scope)):
            notes.append(f"{x['name']}: {machine_label()} has its own, kept")
            continue
        did("secret", scope, x["name"])      # (written down first: one set as this was cut short is undone too)
        why = secret_set(scope, x["name"], x["value"])
        if why:
            notes.append(f"{x['name']}: {why}")
    return notes


def move_note(man, rec, path):
    """What the chat's Claude is told with its next message, after the move
    (Agent.deliver): where it is now, what came with it, what didn't."""
    frm, here = rec["label"], machine_label()
    wip = man.get("wip") or {}
    lines = [f"amarchy: this chat moved from {frm} to {here} (amarchy move), at your user's word. Same conversation, "
             f"same branch ({man.get('branch')}), its worktree at {path}."]
    if wip.get("commit"):
        lines.append(f"What you hadn't committed came as one commit, {wip['commit'][:9]} \"WIP: moving to {here} "
                     f"(amarchy move)\", pushed to origin: amend or squash it before it's merged.")
    left = [x for x in man.get("left") or [] if isinstance(x, str)]
    lines.append("The files git ignores came too" + (f", but dependencies and builds ({', '.join(left[:5])}"
                                                      f"{'...' if len(left) > 5 else ''}): make them again before you run the project."
                                                      if left else "."))
    lines.append(f"What ran in the background stopped on {frm}. This machine ({here}) is another computer: its "
                 f"config, its services and what's installed are its own, not {frm}'s.")
    return "<system-reminder>\n" + "\n".join(lines) + "\n</system-reminder>"


def move_wait_up(sid, wait=MOVE_UP_WAIT):
    """Until a chat's Claude is up on the chat engine (its broker idle, Claude
    running, still running a moment later): None, else why not (what Claude
    said as it stopped, when it did: not signed in, no such conversation)."""
    end, up_since, dead_since = time.time() + wait, None, None
    while time.time() < end:
        live = agent_live(sid)
        cpid = live.get("claude_pid")
        try:        # (one that exited is a zombie until its broker waits for it: not alive)
            alive = isinstance(cpid, int) and Path(f"/proc/{cpid}/stat").read_text().rpartition(")")[2].split()[0] != "Z"
        except (OSError, IndexError):
            alive = False
        if agent_up(sid, live) and live.get("state") in ("idle", "working", "waiting") and alive:
            up_since, dead_since = up_since or time.time(), None
            if time.time() - up_since > 2:
                return None
        else:
            up_since = None
            gone = live.get("state") == "exited" or (isinstance(cpid, int) and not alive)
            dead_since = (dead_since or time.time()) if gone else None
            if dead_since and time.time() - dead_since > 1.5:
                return move_pane_why(sid) or live.get("error") or f"Claude Code exited ({live.get('exit_code')})"
        time.sleep(0.3)
    return move_pane_why(sid) or agent_live(sid).get("error") or "it didn't come up in time"


def move_pane_why(sid):
    """The last thing a chat's Claude pane printed (why it stopped), or ""."""
    lines = [l.strip() for l in (tty_text(sid, "claude") or "").splitlines()]
    lines = [l for l in lines if l and not l.startswith(("·", "amarchy", "Claude Code exited"))]
    return lines[-1][:240] if lines else ""


def move_take_undo(rec):
    """Undo what a move taken here did, last first (rec["undo"])."""
    for action in reversed(rec.get("undo") or []):
        try:
            kind = action[0]
            if kind == "session":
                sid = action[1]
                s = session(sid) or {"id": sid, "path": ""}
                host_stop(s)
                for f in (SESSIONS / f"{sid}.json", STATUS / sid, UNSEEN / sid, SEEN / sid, SENT_BY / f"{sid}.jsonl",
                          QUIET_TURNS / f"{sid}.jsonl"):
                    f.unlink(missing_ok=True)
                shutil.rmtree(claude_dir(sid), ignore_errors=True)
                move_merges_drop(sid)
            elif kind == "worktree":
                path, repo_dir = Path(action[1]), Path(action[2])
                stop_leftovers(path)
                # (One git was still making stays locked, "initializing": --force twice.)
                sh("git", "worktree", "remove", "--force", "--force", str(path), cwd=repo_dir)
                shutil.rmtree(path, ignore_errors=True)
                sh("git", "worktree", "unlock", str(path), cwd=repo_dir)
                sh("git", "worktree", "prune", cwd=repo_dir)
            elif kind == "branch":
                branch, was, repo_dir = action[1], action[2], action[3]
                if was:
                    sh("git", "branch", "-q", "-f", branch, was, cwd=repo_dir)
                else:
                    sh("git", "branch", "-q", "-D", branch, cwd=repo_dir)
            elif kind == "file":
                dst, keep = Path(action[1]), action[2]
                # What was there: put back from backup; never moved there (cut short before), it's still in place.
                if keep and not (Path(keep).exists() or Path(keep).is_symlink()):
                    continue
                shutil.rmtree(dst, ignore_errors=True) if dst.is_dir() and not dst.is_symlink() else dst.unlink(missing_ok=True)
                if keep:
                    shutil.move(keep, str(dst))
            elif kind == "run":
                (RUN / action[1]).unlink(missing_ok=True)
            elif kind == "saved":
                save_command(action[1], action[2], "")
            elif kind == "secret":
                secret_forget(action[1], action[2])
            elif kind == "trust":
                set_trust(Path(action[1]), False)
        except Exception as e:      # the rest is undone all the same
            print(f"amarchy: undoing a move: {action[0]}: {e}", file=sys.stderr)
    shutil.rmtree(MOVES_IN / f"{rec['move']}.backup", ignore_errors=True)


def move_abort_in(token, peer):
    """POST /api/peer/move/abort: the machine that sent move `token` lost the
    answer, so this one lets it go. (code, answer)."""
    rec = move_in_read(token)
    if not rec or rec.get("from", "").split(":")[0] != peer:
        return 200, {"dropped": False}
    end = time.time() + 120
    while rec.get("state") == "taking" and pid_alive(rec.get("pid")) and time.time() < end:
        time.sleep(0.5)
        rec = move_in_read(token) or rec
    if rec.get("state") == "taking" and pid_alive(rec.get("pid")):
        return 503, {"error": "it's still being taken: ask again in a moment"}
    with move_in_lock(token):
        rec = move_in_read(token) or rec
        if rec.get("state") != "done":
            if rec.get("state") == "taking":
                move_take_undo(rec)
                rec["state"] = "undone"
                move_in_write(rec)
            return 200, {"dropped": True}
        return move_abort_done(rec)


def move_abort_done(rec):
    """move_abort_in for a move taken whole: dropped, unless it's been used here since."""
    sid = (rec.get("answer") or {}).get("id")
    s = session(sid) if sid else None
    if s:
        f = transcript(s)
        used = f and f.stat().st_mtime > (rec.get("done_at") or 0) + 5
        if used or ((STATUS / sid).read_text().strip() if (STATUS / sid).exists() else "idle") != "idle":
            return 409, {"kept": True, "key": rec["answer"]["key"],
                         "error": f"it's been used on {machine_label()} since: it stays there"}
    move_take_undo(rec)
    rec["state"] = "undone"
    move_in_write(rec)
    return 200, {"dropped": True}


# ---- each minute, and when the app starts: moves cut short

def move_tend():
    """What a move cut short left (amarchy stopped in the middle of one, a
    reboot): on this machine as the old one, finished or undone; a move that
    waits for its chat to be free, waiting again; an abort the other machine
    hasn't answered, asked again. As the new one: a take cut short, undone.
    Old records forgotten."""
    now = time.time()
    for f in sorted(MOVES.glob("*.json")) if MOVES.is_dir() else []:
        sid = f.stem
        rec = move_read(sid)
        if not rec or move_running(sid):
            continue
        s = session(sid)
        if rec.get("error"):
            if rec.get("abort"):
                m = machine_find(rec.get("to") or "")
                gone = move_abort_ask(m, rec["move"], tries=1)[0] if m and rec.get("move") else "dropped"
                if gone == "dropped":
                    rec.pop("abort", None)
                    move_write(sid, rec)
                elif gone == "kept":
                    rec.pop("abort", None)
                    rec["error"] = (f"{rec.get('label') or rec['to']} took it after all, and it was used there: it's on "
                                    f"both machines now. Complete the one you don't want")
                    move_write(sid, rec)
            elif now - (rec.get("at") or 0) > MOVE_ERROR_KEEP or not s:
                move_forget(sid)
            continue
        if not s:
            move_forget(sid)
            continue
        if not rec.get("started"):
            if now - (rec.get("since") or 0) < 90:
                continue        # (its mover may still be starting)
            if rec.get("when") == "free" and not rec.get("cancel"):
                move_spawn(["move", sid, "--to", rec["to"], "--when-free", "--spawned",
                            "--secrets" if rec.get("secrets") else "--no-secrets"])
            else:
                move_forget(sid)
            continue
        lock = move_lock(sid)
        if not lock:
            continue
        try:
            m = machine_find(rec.get("to") or "")
            label = rec.get("label") or rec.get("to")
            if rec.get("answered") and m:
                move_drop(s, m, rec["answered"], rec)
                move_forget(sid)
                continue
            if rec.get("sent") and m and rec.get("move"):
                gone, kept = move_abort_ask(m, rec["move"], tries=1)
                if gone is None:
                    rec["step"] = f"Waiting for {label} to answer"
                    move_write(sid, rec)
                    continue
                if gone == "kept":
                    move_drop(s, m, kept, rec)
                    move_forget(sid)
                    continue
            move_undo(s, rec)
            move_write(sid, {"to": rec["to"], "label": label, "at": now,
                             "error": "amarchy stopped in the middle of moving it: it's here as it was"})
        finally:
            lock.close()
    move_in_tend(now)


def move_in_tend(now=None, only=None):
    """The takes here cut short (the process taking it gone in the middle):
    undone. Old records forgotten. only: that move's, now (its take's process
    died before it answered)."""
    now = now or time.time()
    for f in sorted(MOVES_IN.glob("*.json")) if MOVES_IN.is_dir() else []:
        if only and f.stem != only:
            continue
        rec = move_in_read(f.stem)
        if not rec:
            continue
        if rec.get("state") == "taking" and not pid_alive(rec.get("pid")):
            with move_in_lock(f.stem):
                rec = move_in_read(f.stem) or rec
                if rec.get("state") == "taking" and not pid_alive(rec.get("pid")):
                    move_take_undo(rec)
                    rec.update(state="undone", error=rec.get("error") or "it stopped in the middle of taking it")
                    move_in_write(rec)
        elif rec.get("state") != "taking" and now - (rec.get("at") or 0) > MOVED_KEEP:
            f.unlink(missing_ok=True)


def move_tend_loop(st):
    """The app's server: move_tend when it starts, then each minute."""
    while True:
        try:
            move_tend()
        except Exception as e:      # never the server's end
            print(f"amarchy app: moves: {e}", file=sys.stderr, flush=True)
        st.poke.set()
        time.sleep(60)


# ---- amarchy move

def cmd_move(args):
    """amarchy move [<id>] --to <machine> [--when-free] [--secrets|--no-secrets];
    --check [--json]; --cancel; --dismiss. Plumbing: --take <package> --from
    <machine> (the app's server, for /api/peer/move); --tend."""
    opts, rest = {}, []
    it = iter(args)
    for a in it:
        if a in ("--to", "--take", "--from"):
            opts[a] = next(it, None)
            if not opts[a]:
                return fail(f"{a} needs a value")
        elif a.startswith("--to="):
            opts["--to"] = a.split("=", 1)[1]
        elif a.startswith("--"):
            opts[a] = True
        else:
            rest.append(a)
    if "--tend" in opts:
        move_tend()
        return 0
    if "--spawned" in opts:
        # The move itself, in a process of its own (the app's, or one that
        # waits until the chat is free): whatever stops it, its card says why.
        sid = rest[0] if rest else ""
        to = opts.get("--to") or ""
        try:
            done = move_out(sid, to, secrets="--secrets" in opts, when="free" if "--when-free" in opts else "now",
                            say=lambda text: print(f"  {text}…", file=sys.stderr, flush=True))
        except MoveError as e:
            return fail(f"{sid} didn't move to {to}: {e}")
        print(done["key"])
        return 0
    if "--take" in opts:
        try:
            print(json.dumps(move_take(Path(opts["--take"]), opts.get("--from") or "")))
            return 0
        except MoveError as e:
            print(json.dumps({"error": str(e)}))
            return 3
    if len(rest) > 1:
        print(usage("move"), file=sys.stderr)
        return 1
    sid = rest[0] if rest else own_session_id()
    if not sid:
        return fail("Not in a session (name one: amarchy move <id> --to <machine>)")
    s = session(sid)
    if not s:
        to = moved_to(sid)
        return fail(f"{sid} moved to {to} already" if to else f"No session {sid!r}")
    if "--dismiss" in opts:
        rec = move_read(sid)
        if rec and rec.get("error") and not rec.get("abort"):
            move_forget(sid)
        return 0
    if "--cancel" in opts:
        rec = move_read(sid)
        if not rec or rec.get("error"):
            return fail(f"{sid} isn't waiting to move")
        if rec.get("started"):
            return fail(f"{sid} is moving already: it can't be called off now")
        move_write(sid, {**rec, "cancel": True})
        print(f"{sid} stays here")
        return 0
    to = opts.get("--to")
    if not to:
        print(usage("move"), file=sys.stderr)
        return 1
    if to == machine_name():
        return fail(f"{sid} is on this machine already")
    m = machine_find(to)
    if "--check" in opts:
        out = move_check(s, to)
        if "--json" in opts:
            print(json.dumps(out, indent=2))
        else:
            print(move_check_words(out))
        return 0 if not out["refused"] else 1
    if not m:
        return fail(f"no machine {to} is paired with this one (amarchy machines lists them)")
    out = move_check(s, to)
    if out["refused"]:
        return fail(f"{sid} can't move to {m['label']}: {out['refused']}")
    if move_running(sid):
        return fail(f"{sid} is moving to {(out.get('moving') or {}).get('label') or 'another machine'} already")
    asked = out["secrets"]
    secrets = True if "--secrets" in opts else False if "--no-secrets" in opts else None
    if asked and secrets is None:
        if sys.stdin.isatty() and sys.stdout.isatty():
            answer = input(f"It asked you for {', '.join(asked)}: copy {'it' if len(asked) == 1 else 'them'} to {m['label']} too? [y/N] ")
            secrets = answer.strip().lower() in ("y", "yes")
        else:
            return fail(f"{sid} asked you for {', '.join(asked)}: say --secrets to copy {'it' if len(asked) == 1 else 'them'} "
                        f"to {m['label']} too, or --no-secrets")
    own = sid == os.environ.get("AMARCHY_SESSION")
    free = "--when-free" in opts or own
    if out["busy"] and not free:
        return fail(f"{sid} can't move this moment: {'; '.join(out['busy'])}. amarchy move {sid} --to {m['name']} "
                    f"--when-free moves it once it's free")
    if free:
        # It waits in a process of its own (from the chat's own Claude: its
        # turn is the one to end first, and that Claude stops as it moves).
        move_write(sid, {"to": m["name"], "label": m["label"], "when": "free", "secrets": bool(secrets),
                         "since": time.time(), "step": "Waiting for it to be free"})
        move_spawn(["move", sid, "--to", m["name"], "--when-free", "--spawned", "--secrets" if secrets else "--no-secrets"])
        print(f"{sid} moves to {m['label']} once it's free" + (" (once this turn ends)" if own else "")
              + f": amarchy move {sid} --cancel calls it off")
        return 0
    try:
        done = move_out(sid, m["name"], secrets=bool(secrets), when="now",
                        say=lambda text: print(f"  {text}…", file=sys.stderr, flush=True))
    except MoveError as e:
        return fail(f"{sid} didn't move to {m['label']}: {e}")
    print(done["key"])
    for n in done.get("notes") or []:
        print(f"  {n}", file=sys.stderr)
    return 0


def move_check_words(out):
    """amarchy move --check, in words."""
    lines = [f"{out['id']} to {out['label'] or out['to']}:"]
    if out["refused"]:
        lines.append(f"  can't: {out['refused']}")
    elif out["busy"]:
        lines.append(f"  not this moment ({'; '.join(out['busy'])}): --when-free moves it once it's free")
    else:
        lines.append("  it can move now")
    if out["changes"]:
        lines.append(f"  {out['changes']} file{'s' if out['changes'] != 1 else ''} not committed: one WIP commit, pushed to origin")
    if out["secrets"]:
        lines.append(f"  it asked for {', '.join(out['secrets'])}: --secrets copies them, --no-secrets doesn't")
    if out["previews"]:
        lines.append(f"  its preview{'s' if len(out['previews']) > 1 else ''} ({', '.join(out['previews'])}): stopped here, ready there")
    if out["left"]:
        lines.append(f"  not carried, made again there: {', '.join(out['left'][:6])}{'...' if len(out['left']) > 6 else ''}")
    return "\n".join(lines)


# ------------------------------------------------------------------ your stuff on every machine (track D)
#
# What's yours, not a chat's, is the same on every machine
# (docs/plan-omarchy-and-machines.md, "Your stuff on every machine"): each
# machine keeps a copy, changes go to the others as they're made, and one
# that was off catches up when it's back, through any other. No main
# machine.
#
# - Items, last change wins: what a setting is now ({value, at, by}). A
#   change is found where it's made (the app, the CLI, a timer: whatever
#   wrote the file), by looking every couple of seconds; one taken from
#   another machine is written as if made here, with its stamp, so it isn't
#   taken for a change of this one's.
# - Sets kept whole: your missions' records (each machine's, rid
#   <machine>:<n>), the badges (the earliest wins), when the reminders were
#   last told, your own chimes and themes.
# - Files (a wallpaper, a chime, a theme's font) go by their SHA-256.

SYNC = STATE / "sync"
SYNC_ITEMS = SYNC / "items.json"        # {key: {value, at, by}}: as last stamped, here or anywhere
SYNC_FILES = SYNC / "files"             # <sha256>: files another machine may ask for
SYNC_LEARNED = SYNC / "missions"        # <machine>.jsonl: other machines' mission records
SYNC_THEMES = SYNC / "themes.json"      # {key: {files, at, by}}: your own themes, as last stamped
SYNC_LOOK_EVERY = 2                     # seconds between looks for a change made here
SYNC_PULL_EVERY = 60                    # seconds between asking each machine what it has (a push missed: caught up then)
SYNC_FILE_MAX = 60_000_000


def sync_text(f):
    try:
        return f.read_text().strip() or None
    except OSError:
        return None


def sync_write_text(f, value):
    if value is None:
        f.unlink(missing_ok=True)
    else:
        write_file(f, f"{value}\n")


_sha_memo = {}


def file_sha(f):
    """A file's SHA-256 (hex), read again only when it changes; None if it's not there."""
    try:
        st_ = f.stat()
    except OSError:
        return None
    key, sig = str(f), (st_.st_mtime_ns, st_.st_size)
    kept = _sha_memo.get(key)
    if kept and kept[0] == sig:
        return kept[1]
    h = hashlib.sha256()
    with open(f, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    _sha_memo[key] = (sig, h.hexdigest())
    return _sha_memo[key][1]


def sync_keep_file(f):
    """A file of yours, kept by its hash for the others to ask for: its hash."""
    sha = file_sha(f)
    if sha and not (SYNC_FILES / sha).exists():
        SYNC_FILES.mkdir(parents=True, exist_ok=True)
        tmp = SYNC_FILES / f".{sha}.{os.getpid()}"
        shutil.copyfile(f, tmp)
        os.replace(tmp, SYNC_FILES / sha)
    return sha


def sync_file(sha):
    """A file by its hash, if this machine has it."""
    f = SYNC_FILES / sha if re.fullmatch(r"[0-9a-f]{64}", sha or "") else None
    return f if f and f.is_file() else None


# ---- the items: each one read and written where it lives

def look_value():
    choice = look_choice()
    own = choice.get("own") if isinstance(choice.get("own"), dict) else {}
    files = {}
    for name in own.values():
        sha = sync_keep_file(APP_PICK / name) if isinstance(name, str) else None
        if sha:
            files[name] = sha
    return {"choice": choice, "files": files} if choice else None


def look_take(value, fetch):
    """The look as another machine has it: its own wallpaper's files (fetched
    by their hash), then its choice; Claude Code here wears its theme."""
    if not isinstance(value, dict) or not isinstance(value.get("choice"), dict):
        return
    for name, sha in (value.get("files") or {}).items():
        if not re.fullmatch(r"own-[0-9a-f]{12}-(phone|wide)\.(jpg|png|webp)", name or ""):
            continue
        if file_sha(APP_PICK / name) != sha:
            data = fetch(sha)
            if data is None:
                raise PeerError(f"the wallpaper {name} didn't come")
            write_file(APP_PICK / name, data)
    was = look_choice().get("theme")
    write_file(APP_PICK / "choice.json", json.dumps(value["choice"], indent=1))
    keep = set((value["choice"].get("own") or {}).values()) | {"choice.json"}
    for f in APP_PICK.iterdir():
        if f.name not in keep and not f.name.startswith("."):
            f.unlink(missing_ok=True)
    if value["choice"].get("theme") != was:
        try:
            look_claude(look_worn()["claude"])
        except Exception:
            pass


def text_item(f, ok=None):
    """An item that's one line in a file: (read, write)."""
    def read():
        v = sync_text(f)
        return v if v is None or ok is None or ok(v) else None

    def write(v, fetch):
        if v is None or ok is None or ok(v):
            sync_write_text(f, v)
    return read, write


def order_item():
    def read():
        order = project_order()
        return order or None

    def write(v, fetch):
        if isinstance(v, list) and all(isinstance(n, str) and n.strip() and "\n" not in n for n in v):
            write_file(PROJECT_ORDER, "".join(n + "\n" for n in v))
    return read, write


def reset_item():
    """Your last reset (amarchy missions --reset), on any machine: from then
    on, the same score everywhere. (A machine's own first look, when it
    starts counting merges, isn't one.)"""
    def read():
        return sync_text(MISSIONS_RESET)

    def write(v, fetch):
        if v is None or not str(v).isdigit():
            return
        write_file(MISSIONS_RESET, f"{v}\n")
        if missions_since() < int(v):
            write_file(MISSIONS_SINCE, f"{v}\n")       # merges here count from then on too
        # The badges earned before it go here too.
        kept = {k: at for k, at in mission_badges_kept().items() if isinstance(at, (int, float)) and at >= int(v)}
        write_file(MISSION_BADGES, json.dumps(kept))
        _missions.clear()
    return read, write


def missions_reset_at():
    """Your last reset's time, on any machine (0: never)."""
    v = sync_text(MISSIONS_RESET)
    return int(v) if v and v.isdigit() else 0


SYNC_KEYS = {
    "look": (look_value, look_take),
    "project-order": order_item(),
    "new-model": text_item(NEW_MODEL_FILE, lambda v: bool(re.fullmatch(MODEL_RE, v))),
    "new-effort": text_item(NEW_EFFORT_FILE, lambda v: bool(effort_choice(v))),
    "alerts": text_item(ALERTS_FILE, lambda v: v in ALERTS),
    "sound": text_item(SOUND_FILE, lambda v: len(v) <= 200),
    "sound-assistant": text_item(ASSISTANT_SOUND_FILE, lambda v: len(v) <= 200),
    "show-terminals": text_item(SHOW_TERMINALS, lambda v: v in ("on", "off")),
    "machines-as": text_item(MACHINES_AS, lambda v: v in ("icon", "name")),
    "missions-goal": text_item(MISSION_GOAL, lambda v: v.isdigit() and int(v) <= 50),
    "missions-since": reset_item(),
}


SYNC_KEY_FILES = {"look": APP_PICK / "choice.json", "project-order": PROJECT_ORDER, "new-model": NEW_MODEL_FILE,
                  "new-effort": NEW_EFFORT_FILE, "alerts": ALERTS_FILE, "sound": SOUND_FILE,
                  "sound-assistant": ASSISTANT_SOUND_FILE, "show-terminals": SHOW_TERMINALS, "machines-as": MACHINES_AS,
                  "missions-goal": MISSION_GOAL, "missions-since": MISSIONS_RESET}


def sync_set_at(key):
    """When an item was last set here, before sync knew it: its file's time (0: never)."""
    try:
        return SYNC_KEY_FILES[key].stat().st_mtime
    except (KeyError, OSError):
        return 0


# What a setting is when you never set it (an install may have written it
# so): on a machine's first look, as if never set, so the machine where you
# did set it wins, however new this one's file is.
SYNC_DEFAULTS = {"new-model": (NEW_MODEL,), "new-effort": ("auto",), "alerts": ("needs-you",), "machines-as": ("icon",),
                 "missions-goal": (str(MISSION_GOAL_DEFAULT),), "show-terminals": (), "project-order": ((),),
                 "missions-since": (), "sound": (), "sound-assistant": ()}


def sync_unset(key, value):
    """Whether an item's value is what it is when never set."""
    if value is None:
        return True
    if key == "look":
        c = (value or {}).get("choice") or {}
        return (c.get("theme") in (None, LOOK_DEFAULT) and not c.get("own") and c.get("wallpaper") in (None, "theme")
                and c.get("font") in (None, "jetbrains-mono") and not c.get("backgrounds"))
    return value in SYNC_DEFAULTS.get(key, ()) or (isinstance(value, list) and not value)


def sync_newer(a, b):
    """Whether stamp a ({at, by}) is later than b (the same at: the greater by)."""
    if not b:
        return True
    return (float(a.get("at") or 0), str(a.get("by") or "")) > (float(b.get("at") or 0), str(b.get("by") or ""))


@contextlib.contextmanager
def sync_lock():
    SYNC.mkdir(parents=True, exist_ok=True)
    with open(SYNC / ".lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def sync_json(f, default):
    try:
        v = json.loads(f.read_text())
        return v if isinstance(v, type(default)) else default
    except (OSError, ValueError):
        return default


def sync_items_look():
    """A change made here since the last look: each item whose value isn't
    the one last stamped, stamped now, by this machine. The keys stamped."""
    with sync_lock():
        items = sync_json(SYNC_ITEMS, {})
        changed = sync_items_seen(items)
        if changed:
            write_file(SYNC_ITEMS, json.dumps(items))
    return changed


_sync_stamped = set()       # keys stamped here, wherever (a look, before a take): pushed by Sync


def sync_stamped():
    """The keys stamped here since last asked."""
    with _sync_stamped_lock:
        keys = set(_sync_stamped)
        _sync_stamped.clear()
    return keys


_sync_stamped_lock = threading.Lock()


def sync_items_seen(items):
    """(Under sync_lock.) Each item here whose value isn't the one stamped in
    items, stamped in it now. The keys stamped."""
    changed = []
    me, now = machine_name(), time.time()
    for key, (read, _) in SYNC_KEYS.items():
        try:
            value = read()
        except Exception as e:
            print(f"amarchy app: sync: {key}: {e}", file=sys.stderr, flush=True)
            continue
        kept = items.get(key)
        if kept is None or kept.get("value") != value:
            # When it was changed: its file's time (found a while after,
            # a machine stopped in between: still its own time, so a later
            # change elsewhere wins); one taken away, now. The first look:
            # as old as its file (never set: as old as can be), so the
            # latest change of any machine's wins, whichever looked first.
            at = sync_set_at(key)
            if kept is None and sync_unset(key, value):
                at = 0
            items[key] = {"value": value, "at": at if kept is None else (at if value is not None and at else now), "by": me}
            changed.append(key)
    if changed:
        with _sync_stamped_lock:
            _sync_stamped.update(changed)
    return changed


def sync_items_take(theirs, fetch):
    """Items from another machine: each one later than ours, written here
    as if changed here, with its stamp. The keys taken."""
    taken = []
    if not isinstance(theirs, dict):
        return taken
    with sync_lock():
        items = sync_json(SYNC_ITEMS, {})
        # A change made here a moment ago, not looked at yet: stamped first,
        # so one from elsewhere doesn't overwrite it unseen.
        if sync_items_seen(items):
            write_file(SYNC_ITEMS, json.dumps(items))
        for key, item in theirs.items():
            if key not in SYNC_KEYS or not isinstance(item, dict) or not sync_newer(item, items.get(key)):
                continue
            try:
                SYNC_KEYS[key][1](item.get("value"), fetch)
            except PeerError as e:
                print(f"amarchy app: sync: {key}: {e}", file=sys.stderr, flush=True)
                continue
            except Exception as e:
                print(f"amarchy app: sync: {key}: {e}", file=sys.stderr, flush=True)
                continue
            # As it reads here now (a file just written), so the next look sees no change.
            try:
                now = SYNC_KEYS[key][0]()
            except Exception:
                now = item.get("value")
            items[key] = {"value": now, "at": float(item.get("at") or 0), "by": str(item.get("by") or "")}
            taken.append(key)
        if taken:
            write_file(SYNC_ITEMS, json.dumps(items))
    return taken


# ---- the sets: kept whole

def badges_take(theirs):
    """Badges from another machine: each the earliest it was earned, since the last reset."""
    if not isinstance(theirs, dict):
        return False
    since = missions_reset_at()
    kept = mission_badges_kept()
    out = dict(kept)
    for k, at in theirs.items():
        if isinstance(k, str) and isinstance(at, (int, float)) and at >= since and (k not in out or at < out[k]):
            out[k] = int(at)
    if out != kept:
        write_file(MISSION_BADGES, json.dumps(out))
        return True
    return False


def told_take(theirs):
    """When the reminder and the recap were last told: the latest of any machine's."""
    if not isinstance(theirs, dict):
        return False
    kept = sync_json(MISSION_TOLD, {})
    out = dict(kept)
    for k, day in theirs.items():
        if k in ("reminder", "recap") and isinstance(day, str) and re.fullmatch(r"\d{4}-\d\d-\d\d", day) and day > str(out.get(k) or ""):
            out[k] = day
    if out != kept:
        write_file(MISSION_TOLD, json.dumps(out))
        return True
    return False


def sounds_value():
    """Your own chimes: name → hash."""
    out = {}
    if USER_SOUNDS.is_dir():
        for f in sorted(USER_SOUNDS.iterdir()):
            if f.is_file() and not f.name.startswith(".") and f.suffix.lower() in AUDIO:
                sha = sync_keep_file(f)
                if sha:
                    out[f.name] = sha
    return out


def sounds_take(theirs, fetch):
    if not isinstance(theirs, dict):
        return False
    mine, got = sounds_value(), False
    for name, sha in theirs.items():
        if name in mine or not re.fullmatch(r"[\w .()-]{1,120}", name or "") or Path(name).suffix.lower() not in AUDIO:
            continue
        data = fetch(sha)
        if data is not None:
            write_file(USER_SOUNDS / name, data)
            got = True
    return got


def themes_value():
    """Your own themes: key → {files: name → hash, at, by}, stamped when one changes here."""
    with sync_lock():
        kept = sync_json(SYNC_THEMES, {})
        out, me, changed = {}, machine_name(), False
        for d in sorted(CUSTOM.iterdir()) if CUSTOM.is_dir() else []:
            if not d.is_dir() or not re.fullmatch(r"[\w-]{1,60}", d.name) or not (d / "theme.json").is_file():
                continue
            files = {f.name: sync_keep_file(f) for f in sorted(d.iterdir()) if f.is_file() and not f.name.startswith(".")}
            was = kept.get(d.name)
            if was and was.get("files") == files:
                out[d.name] = was
            else:
                out[d.name] = {"files": files, "at": time.time() if was else 0, "by": me}
                changed = True
        if changed or set(out) != set(kept):
            write_file(SYNC_THEMES, json.dumps(out))
    return out


def themes_take(theirs, fetch):
    """Themes of yours from another machine: each newer than ours, put in place whole."""
    if not isinstance(theirs, dict):
        return False
    mine, got = themes_value(), False
    for key, t in theirs.items():
        if not re.fullmatch(r"[\w-]{1,60}", key or "") or not isinstance(t, dict) or not isinstance(t.get("files"), dict) \
                or "theme.json" not in t["files"] or not sync_newer(t, mine.get(key)):
            continue
        tmp = CUSTOM / f".{key}.{os.getpid()}"
        shutil.rmtree(tmp, ignore_errors=True)
        tmp.mkdir(parents=True)
        try:
            for name, sha in t["files"].items():
                if not re.fullmatch(r"[\w.-]{1,80}", name or ""):
                    raise PeerError(f"a theme's file named {name!r}")
                data = fetch(sha)
                if data is None:
                    raise PeerError(f"{key}'s {name} didn't come")
                (tmp / name).write_bytes(data)
            old = CUSTOM / f".{key}.old.{os.getpid()}"
            if (CUSTOM / key).exists():
                os.replace(CUSTOM / key, old)
            os.replace(tmp, CUSTOM / key)
            shutil.rmtree(old, ignore_errors=True)
        except PeerError as e:
            shutil.rmtree(tmp, ignore_errors=True)
            print(f"amarchy app: sync: theme {key}: {e}", file=sys.stderr, flush=True)
            continue
        with sync_lock():
            kept = sync_json(SYNC_THEMES, {})
            kept[key] = {"files": t["files"], "at": float(t.get("at") or 0), "by": str(t.get("by") or "")}
            write_file(SYNC_THEMES, json.dumps(kept))
        got = True
    return got


# ---- the missions: every machine's records

def mission_records_own():
    """This machine's records, each with its rid (<machine>:<n>; one written
    before machines: its line's number)."""
    me = machine_name()
    try:
        lines = MISSIONS.read_text().splitlines()
    except OSError:
        lines = []
    out = []
    for i, line in enumerate(lines):
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if isinstance(r, dict):
            r.setdefault("rid", f"{me}:{i}")
            out.append(r)
    return out


def mission_records_learned():
    out = []
    for f in sorted(SYNC_LEARNED.glob("*.jsonl")) if SYNC_LEARNED.is_dir() else []:
        try:
            for line in f.read_text().splitlines():
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if isinstance(r, dict) and isinstance(r.get("rid"), str):
                    out.append(r)
        except OSError:
            continue
    return out


def rid_parts(rid):
    origin, _, n = str(rid).rpartition(":")
    try:
        return origin, int(n)
    except ValueError:
        return origin, -1


def missions_have():
    """For each machine, the last of its records this one has: {machine: n}."""
    have = {}
    for r in mission_records_own() + mission_records_learned():
        origin, n = rid_parts(r["rid"])
        if origin and n > have.get(origin, -1):
            have[origin] = n
    return have


def missions_after(have):
    """The records this one has (its own and learned) that have doesn't."""
    have = have if isinstance(have, dict) else {}
    out = []
    for r in mission_records_own() + mission_records_learned():
        origin, n = rid_parts(r["rid"])
        if origin and n > int(have.get(origin, -1) if str(have.get(origin, -1)).lstrip("-").isdigit() else -1):
            out.append(r)
    return out[-20000:]


def missions_take(records):
    """Other machines' records, each kept once (none of this one's)."""
    if not isinstance(records, list):
        return False
    me, have = machine_name(), missions_have()
    new = {}
    for r in records:
        if not isinstance(r, dict) or not isinstance(r.get("rid"), str) or not isinstance(r.get("at"), (int, float)):
            continue
        origin, n = rid_parts(r["rid"])
        if not re.fullmatch(MACHINE_NAME_RE, origin or "") or origin == me or n <= have.get(origin, -1):
            continue
        new.setdefault(origin, {})[n] = r
    for origin, rs in new.items():
        SYNC_LEARNED.mkdir(parents=True, exist_ok=True)
        with open(SYNC_LEARNED / f"{origin}.jsonl", "a") as fh:
            for n in sorted(rs):
                fh.write(json.dumps(rs[n]) + "\n")
    if new:
        _missions.clear()
    return bool(new)


# ---- the exchange

def sync_state(have=None):
    """What this machine knows of what's yours (its own and what it learned
    from others), for another machine: GET /api/peer/sync."""
    sync_items_look()
    return {"items": sync_json(SYNC_ITEMS, {}), "badges": mission_badges_kept(), "told": sync_json(MISSION_TOLD, {}),
            "sounds": sounds_value(), "themes": themes_value(), "missions": missions_after(have) if have is not None else [],
            "have": missions_have()}


_sync_taking = threading.Lock()     # one machine's at a time (a push and a pull can come at once)


def sync_take(theirs, fetch):
    """What another machine knows: taken where it's newer, kept whole where
    it's a set. Whether anything changed here."""
    if not isinstance(theirs, dict):
        return False
    with _sync_taking:
        return sync_taking(theirs, fetch)


def sync_taking(theirs, fetch):
    changed = False
    # Files first (a theme a look wears), then the look.
    changed |= themes_take(theirs.get("themes"), fetch)
    changed |= sounds_take(theirs.get("sounds"), fetch)
    changed |= bool(sync_items_take(theirs.get("items"), fetch))
    changed |= badges_take(theirs.get("badges"))
    changed |= told_take(theirs.get("told"))
    changed |= missions_take(theirs.get("missions"))
    return changed


def peer_fetch(m):
    """fetch(sha) for what machine m has: its file's bytes, checked, or None."""
    def fetch(sha):
        kept = sync_file(sha)
        if kept:
            return kept.read_bytes()
        if not re.fullmatch(r"[0-9a-f]{64}", sha or ""):
            return None
        try:
            conn, r = peer_request(m, "GET", f"/api/peer/sync/file/{sha}", timeout=30)
            try:
                data = r.read(SYNC_FILE_MAX + 1) if r.status == 200 else None
            finally:
                conn.close()
        except (PeerError, OSError):
            return None
        if data is None or len(data) > SYNC_FILE_MAX or hashlib.sha256(data).hexdigest() != sha:
            return None
        SYNC_FILES.mkdir(parents=True, exist_ok=True)
        write_file(SYNC_FILES / sha, data)
        return data
    return fetch


class Sync:
    """Your stuff kept the same on every machine: a change made here goes to
    each machine that answers at once; each machine is asked what it has
    when it's paired, when it comes back on, and every few minutes."""

    def __init__(self, st):
        self.st, self.wake, self.asked = st, threading.Event(), {}
        self.lock = threading.Lock()
        self.sets = None        # the sets and the missions as last looked at (a change: pushed)
        self.pending = set()    # items changed here and not pushed yet (kept through a failure)

    def start(self):
        threading.Thread(target=self.run, daemon=True).start()

    def soon(self, name=None):
        """Ask (that machine, or every one) what it has, now."""
        with self.lock:
            for n in [name] if name else [m["name"] for m in machines_read()]:
                self.asked[n] = 0
        self.wake.set()

    def run(self):
        while True:
            try:
                sync_items_look()
                self.pending.update(sync_stamped())
                sets = json.dumps([mission_badges_kept(), sync_json(MISSION_TOLD, {}), sounds_value(), themes_value(),
                                   missions_have()], sort_keys=True)
                if self.pending or (self.sets is not None and sets != self.sets):
                    self.push(set(self.pending))
                    self.pending.clear()        # (only once it's on its way)
                self.sets = sets
                ms = machines_read()
                peers = self.st.peers.snapshot() if self.st.peers else {}
                for m in ms:
                    on = (peers.get(m["name"]) or {}).get("on")
                    if on and time.time() - self.asked.get(m["name"], 0) > SYNC_PULL_EVERY:
                        self.asked[m["name"]] = time.time()
                        threading.Thread(target=self.pull, args=(m,), daemon=True).start()
            except Exception as e:
                print(f"amarchy app: sync: {e}", file=sys.stderr, flush=True)
            self.wake.wait(SYNC_LOOK_EVERY)
            self.wake.clear()

    def pull(self, m):
        """What machine m has that this one hasn't."""
        try:
            have = urllib.parse.quote(json.dumps(missions_have()))
            status, theirs = peer_json(m, "GET", f"/api/peer/sync?have={have}", timeout=30)
            if status == 200 and sync_take(theirs, peer_fetch(m)):
                self.st.poke.set()
        except PeerError:
            self.asked[m["name"]] = 0       # (again when it answers)

    def push(self, keys):
        """A change made here, to each machine that answers (one that
        doesn't asks again when it's back; one that missed it, at its next
        pull)."""
        state = sync_state()
        body = {k: state[k] for k in ("items", "badges", "told", "sounds", "themes", "have")}
        body["items"] = {k: v for k, v in state["items"].items() if k in keys}
        # Every machine paired (one taken for off a moment may answer; one
        # that's off doesn't, and pulls it when it's back).
        for m in machines_read():
            threading.Thread(target=self.send, args=(m, body), daemon=True).start()

    def send(self, m, body):
        for wait in (0, 1, 3, 10):      # (a machine busy a moment: again)
            time.sleep(wait)
            try:
                status, _ = peer_json(m, "POST", "/api/peer/sync", body, timeout=30)
                if status == 200:
                    return
            except PeerError:
                pass


def app_handler(st, users, address):
    import http.server
    trusted = tailscale_uids()
    # Who's let in through Tailscale, and at which address: app_serve reads
    # them again while Tailscale isn't up (the desktop app works without it).
    tailnet = {"users": set(users), "address": address}

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "amarchy"
        sys_version = ""
        net = tailnet
        via = None          # how this request came: "tailscale", "local" or "peer" (allowed)
        peer = None         # the machine asking, for "peer"

        def log_message(self, fmt, *args):
            pass

        def log_error(self, fmt, *args):
            print("amarchy app: " + fmt % args, file=sys.stderr)

        def head(self, code, ctype, extra=(), cache="no-cache", nonce=None):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            # The dictation's and the terminals' WebSockets, to this host (not
            # every browser counts wss: as 'self').
            host = self.headers.get("Host", "")
            ws = "ws" if self.via == "local" else "wss"
            csp = APP_CSP.replace("connect-src 'self'", f"connect-src 'self' {ws}://{host}") \
                if re.fullmatch(r"[\w.-]+(:\d+)?", host) else APP_CSP
            # The terminals (xterm.js) style themselves: <style> elements the
            # page made (its nonce), and style attributes.
            if nonce:
                csp = csp.replace("style-src 'self'", f"style-src 'self' 'nonce-{nonce}'; style-src-attr 'unsafe-inline'")
            for k, v in (("Content-Security-Policy", csp), ("X-Content-Type-Options", "nosniff"),
                         ("Referrer-Policy", "no-referrer"), ("X-Frame-Options", "DENY"),
                         ("Cache-Control", cache), *extra):
                self.send_header(k, v)

        def send(self, code, body, ctype="application/json"):
            # A secret's value never goes out (see "secrets"), whatever said it.
            data = mask_secrets(json.dumps(body)).encode() if ctype == "application/json" else body
            data, extra = self.squeezed(data, ctype)
            self.head(code, ctype, [("Content-Length", str(len(data))), *extra])
            self.end_headers()
            self.wfile.write(data)

        def squeezed(self, data, ctype, packed=None):
            """data gzipped, when it's text worth it and the browser takes it
            (a phone's network: the list, a chat's files, a third the size or
            less), with the headers that say so. packed: it gzipped already."""
            if not (ctype.startswith(("text/", "application/json", "application/manifest", "image/svg"))
                    and len(data) >= 1024):
                return data, []
            if "gzip" not in self.headers.get("Accept-Encoding", ""):
                return data, [("Vary", "Accept-Encoding")]
            return packed or gzip_bytes(data), [("Content-Encoding", "gzip"), ("Vary", "Accept-Encoding")]

        def error(self, code, why):
            self.send(code, {"error": why})

        def send_media(self, f, kind, cache):
            """A picture or video (a file), whole or the bytes asked for (Range:
            Safari plays a video only that way); not again when the browser has
            this one (its ETag)."""
            try:
                info = f.stat()
            except OSError:
                return self.error(404, "gone")
            size, tag = info.st_size, f'"{info.st_mtime_ns:x}-{info.st_size:x}"'
            if self.headers.get("If-None-Match") == tag:
                self.head(304, kind, [("ETag", tag)], cache=cache)
                self.end_headers()
                return
            start, end, code = 0, size - 1, 200
            want = re.fullmatch(r"bytes=(\d*)-(\d*)", self.headers.get("Range", "").strip())
            if want and (want.group(1) or want.group(2)):
                if want.group(1):
                    start = int(want.group(1))
                    end = min(int(want.group(2)), size - 1) if want.group(2) else size - 1
                else:
                    start = max(0, size - int(want.group(2)))
                if start >= size or start > end:
                    self.head(416, kind, [("Content-Range", f"bytes */{size}"), ("Content-Length", "0")], cache=cache)
                    self.end_headers()
                    return
                code = 206
            extra = [("Content-Length", str(end - start + 1)), ("Accept-Ranges", "bytes"), ("ETag", tag)]
            if code == 206:
                extra.append(("Content-Range", f"bytes {start}-{end}/{size}"))
            self.head(code, kind, extra, cache=cache)
            self.end_headers()
            try:
                with open(f, "rb") as fh:
                    fh.seek(start)
                    left = end - start + 1
                    while left > 0:
                        chunk = fh.read(min(left, 1 << 20))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass        # the browser had enough (a video it plays from elsewhere in it)

        def allowed(self, write=False):
            """Only you, through tailscale serve, at this machine's address,
            or the desktop app here (the local key: local_allowed); changes
            only from the app's own pages."""
            self.via = None
            if self.headers.get("X-Amarchy-Peer") is not None:
                return self.peer_allowed()
            if self.straight():
                return self.local_allowed(write)
            if not self.tailscale_ok():
                return False
            host = self.headers.get("Host", "")
            if write:
                site = self.headers.get("Sec-Fetch-Site")
                if (self.headers.get("Origin") != f"https://{host}" or (site and site != "same-origin")
                        or not self.headers.get("Content-Type", "").startswith("application/json")):
                    self.error(403, "only from the app")
                    return False
            self.via = "tailscale"
            return True

        def tailscale_ok(self):
            """You, through tailscale serve, at this machine's address (else
            it says why not)."""
            host = self.headers.get("Host", "")
            if self.headers.get("Tailscale-User-Login", "") not in self.net["users"] \
                    or not self.net["address"] or host.split(":")[0] != self.net["address"]:
                self.error(403, "not yours")
                return False
            # Through tailscale serve: that header is Tailscale's, not another
            # user's on this machine who can reach localhost too.
            uid = peer_uid(self.connection)
            if uid not in trusted:
                trusted.update(tailscale_uids())        # tailscaled restarted as someone else?
            if uid not in trusted:
                self.error(403, "not through Tailscale")
                return False
            return True

        # ---- another machine of yours (see "machines")

        def peer_way(self):
            """A machine's request came the way one may: through tailscale
            serve as you, or straight to 127.0.0.1 from you (a second amarchy
            on this machine). Else it says why not."""
            if self.straight():
                if local_uid_ok(self.connection):
                    return True
                self.error(403, "not yours")
                return False
            return self.tailscale_ok()

        def peer_allowed(self):
            """A paired machine: its name (X-Amarchy-Peer) and the pair's key
            (Authorization: Bearer), the way peer_way says. It needs no
            Origin: no page can send those headers (the server never says yes
            to a page elsewhere asking to)."""
            if not self.peer_way():
                return False
            name = self.headers.get("X-Amarchy-Peer", "")
            m = machine_find(name) if re.fullmatch(MACHINE_NAME_RE, name) else None
            given = self.headers.get("Authorization", "")
            given = given[7:].strip() if given[:7].lower() == "bearer " else ""
            if not m or not given or not hmac.compare_digest(given.encode(), m["key"].encode()):
                self.error(403, f"{machine_label()} isn't paired with {name or 'that machine'}")
                return False
            theirs = self.headers.get("X-Amarchy-Protocol")
            if theirs and theirs != str(PROTOCOL):
                self.send(409, {"error": protocol_words(int(theirs) if theirs.isdigit() else 0, m["label"]),
                                "protocol": PROTOCOL})
                return False
            self.via, self.peer = "peer", name
            # Where it's reached now (its tailnet changed): kept, so this one calls it there.
            now = self.headers.get("X-Amarchy-Peer-URL", "").rstrip("/")
            if now and now != m["url"] and machine_url_ok(now) and machine_url_here(now):
                try:
                    machine_keep({**m, "url": now})
                except ValueError:
                    pass
            return True

        def peer_hello(self):
            """GET /api/peer/hello: what this machine is, to you (through
            Tailscale, or from you here), paired or not yet."""
            if not self.peer_way():
                return
            return self.send(200, hello())

        def peer_pair(self):
            """POST /api/peer/pair {name, label, url, protocol}, with the new
            key (Authorization: Bearer) and X-Amarchy-Peer: a machine of yours
            pairs with this one. Only from a program (a page can't send those
            headers), the way peer_way says (you), on the same protocol."""
            if not self.peer_way():
                return
            data = self.body()
            name, url = data.get("name"), data.get("url")
            given = self.headers.get("Authorization", "")
            key = given[7:].strip() if given[:7].lower() == "bearer " else ""
            if self.headers.get("X-Amarchy-Peer") != name or not self.headers.get("Content-Type", "").startswith("application/json"):
                return self.error(403, "only from another machine of yours")
            if data.get("protocol") != PROTOCOL:
                return self.send(409, {"error": protocol_words(data.get("protocol"), str(name)), "protocol": PROTOCOL})
            if name == machine_name():
                return self.error(400, "that's this machine")
            machine_name_keep()
            try:
                m = machine_keep({"name": name, "label": data.get("label"), "url": url, "key": key})
            except ValueError:
                return self.error(400, "a name, an https address and a key")
            if st.peers:
                st.peers.sync()
                st.peers.poke(m["name"])
            return self.send(200, hello())

        def peer_post(self, what, data):
            """What a paired machine asks of this one: forget it (unpair), or
            this machine's label (label: {label})."""
            if what == "send":      # amarchy send <this machine>:<id>, from another machine
                sid, text, origin = data.get("id"), data.get("text"), data.get("from") or ""
                # One that moved away from here: it goes on to where it is (amarchy send does).
                if not isinstance(sid, str):
                    return self.error(400, "which chat (id)")
                if not (re.fullmatch(r"[\w][\w.-]{0,119}", sid) and not session(sid) and moved_to(sid)) and not self.session(sid):
                    return None
                if not isinstance(text, str) or not text.strip() or len(text) > 60_000:
                    return self.error(400, "nothing to send")
                if not isinstance(origin, str) or not re.fullmatch(r"([\w.-]{1,63}:[\w.-]{1,120})?", origin):
                    return self.error(400, "from: <machine>:<chat>")
                r = run_amarchy("send", sid, "-", "--no-wait", input=text,
                                env={"AMARCHY_SESSION": origin or f"{self.peer}:", **({"AMARCHY_SENT_BY": "you"} if data.get("you") is True else {})})
                return self.send(200, {}) if r.returncode == 0 else self.error(409, gist(r.stderr) or "it couldn't be sent")
            if what == "icon":      # this machine's icon, picked on another machine
                try:
                    icon = machines_icon(machine_name(), data.get("icon") if isinstance(data.get("icon"), str) else "")
                except PeerError as e:
                    return self.error(400, str(e))
                st.poke.set()
                return self.send(200, {"icon": icon})
            if what == "unpair":
                machine_drop(self.peer)
                if st.peers:
                    st.peers.sync()
                return self.send(200, {})
            label = data.get("label")
            try:
                label = machines_rename(machine_name(), label if isinstance(label, str) else "")
            except PeerError as e:
                return self.error(400, str(e))
            st.poke.set()
            return self.send(200, {"label": label})

        # ---- moving a chat (see "moving a chat")

        def move_post(self, s, data):
            """POST /api/session/<id>/move: {to, secrets, when: now|free} moves
            it (409 {busy} when it's busy and when is now); {cancel: true} calls
            off one waiting to be free; {dismiss: true} drops a failed one's
            words from its card."""
            sid = s["id"]
            if data.get("dismiss") is True:
                run_amarchy("move", sid, "--dismiss")
                return self.send(200, {})
            if data.get("cancel") is True:
                r = run_amarchy("move", sid, "--cancel")
                return self.send(200, {}) if r.returncode == 0 else self.error(409, gist(r.stderr) or "it can't be called off now")
            to, when = data.get("to"), data.get("when") or "now"
            if not isinstance(to, str) or not re.fullmatch(MACHINE_NAME_RE, to) or when not in ("now", "free") \
                    or not isinstance(data.get("secrets", False), bool):
                return self.error(400, "{to: <machine>, secrets: true|false, when: now|free}")
            m = machine_find(to)
            if not m:
                return self.error(404, f"no machine {to} is paired with {machine_label()}")
            out = move_check(s, to)
            if out["refused"]:
                return self.error(409, out["refused"])
            if out.get("moving"):
                return self.error(409, f"It's moving to {out['moving']['label']} already")
            if out["busy"] and when == "now":
                return self.send(409, {"error": f"It can't move this moment: {out['busy'][0]}", "busy": out["busy"]})
            secrets = "--secrets" if data.get("secrets") else "--no-secrets"
            move_write(sid, {"to": m["name"], "label": m["label"], "when": when, "secrets": bool(data.get("secrets")),
                             "since": time.time(), "step": "Waiting for it to be free" if when == "free" else "Getting ready"})
            move_spawn(["move", sid, "--to", m["name"], secrets, "--spawned", *(["--when-free"] if when == "free" else [])])
            st.poke.set()
            return self.send(200, {"moving": move_shown(sid)[0]})

        def peer_move_in(self):
            """POST /api/peer/move: a chat from the machine asking (its package,
            a gzipped tar, as the body), taken here (move_take): its new id and
            key once its Claude is up, else why not (all of it undone)."""
            try:
                n = int(self.headers.get("Content-Length") or -1)
            except ValueError:
                n = -1
            token = self.headers.get("X-Amarchy-Move", "")
            if not re.fullmatch(MOVE_TOKEN_RE, token):
                return self.error(400, "which move (X-Amarchy-Move)?")
            if n < 0 or n > MOVE_MAX:
                return self.error(413, f"a chat's package is {MOVE_MAX >> 20} MB at most, with its length")
            MOVES_IN.mkdir(parents=True, exist_ok=True)
            pkg = MOVES_IN / f"{token}.tar.gz"
            try:
                with open(pkg, "wb") as out:
                    left = n
                    while left > 0:
                        chunk = self.rfile.read(min(left, 1 << 20))
                        if not chunk:
                            break
                        out.write(chunk)
                        left -= len(chunk)
                if left:
                    return self.error(400, "the package came cut short")
                print(f"amarchy app: a chat moving here from {self.peer} ({n >> 10} KB)", file=sys.stderr, flush=True)
                r = run_amarchy("move", "--take", str(pkg), "--from", self.peer, timeout=MOVE_SEND_TIMEOUT - 30)
            finally:
                pkg.unlink(missing_ok=True)
            try:
                said = json.loads(r.stdout.strip().splitlines()[-1])
            except (ValueError, IndexError):
                said = {"error": gist(r.stderr) or "it failed here"}
                # Its process went without a word (killed): what it had done
                # undone now, so "undone" is so when the other machine hears it.
                if token:
                    move_in_tend(only=token)
            st.poke.set()
            if r.returncode == 0 and said.get("key"):
                return self.send(200, said)
            refused = re.search(r"already|isn't on|has a branch|checked out|isn't where|a chat's package", said.get("error") or "")
            return self.send(409 if refused else 500, {"error": said.get("error") or "it failed here", "undone": True})

        def peer_move_abort(self, data):
            """POST /api/peer/move/abort {move}: the machine that sent it lost
            the answer; this one lets the chat go (unless it's been used here)."""
            token = data.get("move")
            if not isinstance(token, str) or not re.fullmatch(MOVE_TOKEN_RE, token):
                return self.error(400, "which move?")
            code, said = move_abort_in(token, self.peer)
            st.poke.set()
            return self.send(code, said)

        def peer_events(self):
            """GET /api/peer/events: this machine's own chats (never the ones
            it shows from others), and again on every change; "still here"
            well within the silence a machine is taken as gone after."""
            self.stream_start()
            version, beat = -1, time.time()
            every = min(KEEPALIVE, PEER_SILENT / 3)
            try:
                while True:
                    with st.changed:
                        if st.own_version == version or not st.view:
                            st.changed.wait(every)
                        if not st.view:
                            continue
                        view, changed, version = st.view, st.own_version != version, st.own_version
                    if changed:
                        self.event("state", peer_state(view))
                        beat = time.time()
                    elif time.time() - beat >= every:
                        self.out(b": still here\n\n")
                        beat = time.time()
            except OSError:
                pass

        def machines_post(self, data):
            """Settings → Machines: {action: add, target} (a name on your
            tailnet or an address), {action: remove, name}, {action: rename,
            name, label}: amarchy machines, as from a terminal."""
            action = data.get("action")
            if action == "add" and isinstance(data.get("target"), str) and data["target"].strip() \
                    and not data["target"].startswith("-"):
                r = run_amarchy("machines", "add", data["target"].strip(), "--json", timeout=60)
            elif action == "remove" and isinstance(data.get("name"), str) and re.fullmatch(MACHINE_NAME_RE, data["name"]):
                r = run_amarchy("machines", "remove", data["name"], timeout=30)
            elif action == "rename" and isinstance(data.get("name"), str) and re.fullmatch(MACHINE_NAME_RE, data["name"]) \
                    and isinstance(data.get("label"), str):
                r = run_amarchy("machines", "rename", data["name"], data["label"], timeout=30)
            elif action == "icon" and isinstance(data.get("name"), str) and re.fullmatch(MACHINE_NAME_RE, data["name"]) \
                    and data.get("icon") in MACHINE_ICONS:
                r = run_amarchy("machines", "icon", data["name"], data["icon"], timeout=30)
            elif action == "show" and data.get("as") in ("icon", "name"):
                r = run_amarchy("machines", "show", data["as"], timeout=30)
            else:
                return self.error(400, "add (target), remove (name), rename (name, label), icon (name, icon) or show (as)")
            if r.returncode != 0:
                return self.error(409, gist(r.stderr or r.stdout) or "it didn't work")
            if st.peers:
                st.peers.sync()
                st.peers.poke()
            st.poke.set()
            return self.send(200, {"said": (r.stdout.strip().splitlines() or [""])[-1], "machines": machines_listed(check=False)})

        # ---- the pass-through: /api/m/<machine>/<rest> is /<rest> there

        def pass_through(self):
            """A chat on another machine, from this machine's app: the
            request goes on to that machine as this one (its key), and its
            answer comes back as it comes: REST, an event stream as it's
            written, uploads and pictures, a WebSocket both ways (tunnel)."""
            m = re.fullmatch(r"/api/m/([^/?#]{1,63})(/[^#]*)", self.path)
            if not m:
                return self.error(404, "not found")
            name, rest = m.group(1), m.group(2)
            if self.via == "peer":
                return self.error(403, "a machine doesn't pass on another's requests")
            if rest.startswith(("/api/m/", "/local", "/api/peer/")) or not re.fullmatch(r"/[!-~]*", rest):
                return self.error(400, "not through another machine")
            peer = machine_find(name)
            if not peer:
                return self.error(404, f"no machine {name} is paired with {machine_label()}")
            known = (st.peers.snapshot().get(name) if st.peers else None) or {}
            label = str((known.get("hello") or {}).get("label") or peer["label"])
            if known.get("update"):
                return self.send(409, {"error": known["update"], "update": True, "machine": name})
            seen = re.fullmatch(r"/api/session/([^/?]+)/(seen|send|answer|keys|interrupt)", rest.partition("?")[0])
            if seen:
                st.seen[f"{name}:{seen.group(1)}"] = time.time()     # its notifications here: you're looking
            if self.headers.get("Upgrade", "").lower() == "websocket":
                return self.tunnel(peer, rest, label)
            return self.relay(peer, rest, label)

        def off_answer(self, name, label, why):
            if st.peers:
                st.peers.poke(name)
            return self.send(502, {"error": f"{label} is off: {why}", "machine_off": True, "machine": name})

        def relay(self, peer, rest, label):
            import http.client
            method = self.command
            body = None
            if "chunked" in self.headers.get("Transfer-Encoding", "").lower():
                body = self.read_body(UPLOAD_MAX)
                if body is None:
                    return self.error(413, "too big")
                size = len(body)
            else:
                try:
                    size = int(self.headers.get("Content-Length") or 0)
                except ValueError:
                    return self.error(400, "its length")
                if size > UPLOAD_MAX:
                    return self.error(413, "That file is too big (50 MB at most)")
            # A message or an answer can wait for its machine: read whole first, to keep.
            waits = method == "POST" and OUTBOX_ROUTE.fullmatch(rest.partition("?")[0])
            if waits and body is None:
                if size > CLIP_MAX:
                    return self.error(413, "too big")
                body = self.rfile.read(size) if size else b""
            conn = peer_open(peer["url"], PEER_TIMEOUT)
            try:
                conn.putrequest(method, rest, skip_accept_encoding=True)
                for k in RELAY_HEADERS:
                    if self.headers.get(k) is not None:
                        conn.putheader(k, self.headers[k])
                for k, v in peer_headers(peer).items():
                    if k != "User-Agent" or self.headers.get("User-Agent") is None:
                        conn.putheader(k, v)
                if method == "POST" or size:
                    conn.putheader("Content-Length", str(size))
                conn.endheaders()
                if body is not None:
                    conn.send(body)
                else:
                    left = size
                    while left > 0:
                        chunk = self.rfile.read(min(left, 1 << 20))
                        if not chunk:
                            break
                        conn.send(chunk)
                        left -= len(chunk)
                # Its answer: a new chat there takes minutes, a project cloned there longer.
                sock = conn.sock
                sock.settimeout(930 if rest.startswith("/api/add") else 330 if method == "POST" else 60)
                r = conn.getresponse()
            except (OSError, ValueError, http.client.HTTPException) as e:
                conn.close()
                if waits:
                    # Out of reach (a restart there, a network blip, off): kept here, sent once it's back.
                    item = outbox_add(peer["name"], rest, self.headers.get("Content-Type") or "application/json", body)
                    st.bump()                   # (on the board: it waits)
                    if st.peers:
                        st.peers.poke(peer["name"])
                    return self.send(202, {"ok": True, "waits": {"id": item["id"], "machine": peer["name"], "label": label}})
                return self.off_answer(peer["name"], label, peer_why(e))
            try:
                ctype = r.getheader("Content-Type") or "application/octet-stream"
                if ctype.startswith("text/event-stream"):
                    sock.settimeout(PEER_SILENT)            # silent longer than its "still here": it's gone
                extra = [(k, r.getheader(k)) for k in RELAY_BACK if r.getheader(k) is not None]
                self.head(r.status, ctype, extra, cache=r.getheader("Cache-Control") or "no-cache")
                self.end_headers()
                self.close_connection = True
                while True:
                    data = r.read1(65536)
                    if not data:
                        break
                    self.wfile.write(data)
            except (OSError, http.client.HTTPException, ValueError):
                pass        # the page or the machine went away: the other end is closed with it
            finally:
                conn.close()

        def tunnel(self, peer, rest, label):
            """A WebSocket on another machine (a terminal, dictation): opened
            there as this machine, then its frames both ways as they come."""
            if not self.ws_check():
                return
            try:
                sock, code, head, early = peer_ws_open(peer, rest, self.headers["Sec-WebSocket-Key"],
                                                       self.headers.get("User-Agent"))
            except (OSError, PeerError) as e:
                return self.off_answer(peer["name"], label, peer_why(e) if isinstance(e, OSError) else str(e))
            if code != 101:
                # Its refusal as it said it (a chat gone: 404; not set up: 409).
                said = peer_ws_refusal(sock, head, early)
                return self.send(code, said or {"error": f"{label} said no ({code})"})
            self.ws_handshake()
            # A terminal there pings every TTY_PING s: silent much longer, it's gone.
            sock.settimeout(TTY_PING * 3 if "/tty/" in rest else 900)
            done = threading.Event()

            def close_both():
                done.set()
                for s_ in (sock, self.connection):
                    try:
                        s_.shutdown(socket.SHUT_RDWR)
                    except OSError:
                        pass

            def down():         # the machine → the page
                try:
                    if early:
                        with self.ws_lock:
                            self.wfile.write(early)
                    while not done.is_set():
                        data = sock.recv(65536)
                        if not data:
                            break
                        with self.ws_lock:
                            self.wfile.write(data)
                except OSError:
                    pass
                finally:
                    close_both()
            threading.Thread(target=down, daemon=True).start()
            try:
                while not done.is_set():
                    data = self.rfile.read1(65536)
                    if not data:
                        break
                    sock.sendall(data)
            except (OSError, ValueError):
                pass
            finally:
                close_both()
                try:
                    sock.close()
                except OSError:
                    pass

        # ---- the desktop app on this machine (see "machines": the local key)

        def straight(self):
            """Whether this came straight to 127.0.0.1:<this port>, not
            through a proxy: tailscale serve comes from 127.0.0.1 too, but to
            this machine's name, saying whose request it is and from where."""
            return (self.headers.get("Host", "") == f"127.0.0.1:{self.server.server_address[1]}"
                    and self.client_address[0] == "127.0.0.1"
                    and not any(self.headers.get(h) is not None for h in (
                        "Tailscale-User-Login", "Tailscale-User-Name", "X-Forwarded-For", "X-Forwarded-Host",
                        "Forwarded", "Via")))

        def local_cookie(self):
            name = f"{LOCAL_COOKIE}_{self.server.server_address[1]}"
            for part in self.headers.get_all("Cookie") or []:
                for c in part.split(";"):
                    k, _, v = c.strip().partition("=")
                    if k == name:
                        return v
            return None

        def local_allowed(self, write=False):
            """The desktop app here: its cookie (from /local), from you; a
            change only from its own page."""
            given = self.local_cookie()
            try:
                good = bool(given) and hmac.compare_digest(given.encode(), local_cookie_value().encode())
            except OSError:
                good = False
            if not good or not local_uid_ok(self.connection):
                self.error(403, "not yours")
                return False
            if write:
                site = self.headers.get("Sec-Fetch-Site")
                if (self.headers.get("Origin") != f"http://{self.headers.get('Host')}" or (site and site != "same-origin")
                        or not self.headers.get("Content-Type", "").startswith("application/json")):
                    self.error(403, "only from the app")
                    return False
            self.via = "local"
            return True

        def local_in(self, args):
            """GET /local?key=<the local key>[&next=/<path>]: the desktop app
            comes in. Its cookie set, it's sent on to the app (or next: a
            path here), so the key stays out of the page's address."""
            given = (args.get("key") or [""])[0]
            try:
                key = local_key()
            except OSError as e:
                return self.error(500, str(e))
            if not self.straight() or not local_uid_ok(self.connection) or not given \
                    or not hmac.compare_digest(given.encode(), key.encode()):
                return self.error(403, "not yours")
            to = (args.get("next") or ["/"])[0]
            if not re.fullmatch(r"/(?![/\\])[^\s\\\x00-\x1f\x7f]*", to) or to.startswith("/local"):
                to = "/"
            self.via = "local"
            port = self.server.server_address[1]
            self.head(303, "text/plain", [
                ("Location", to), ("Content-Length", "0"),
                ("Set-Cookie", f"{LOCAL_COOKIE}_{port}={local_cookie_value(key)}; Path=/; HttpOnly; "
                               f"SameSite=Strict; Max-Age={LOCAL_COOKIE_AGE}")], cache="no-store")
            self.end_headers()

        def here(self):
            """/api/m/<this machine>/<rest> is /<rest> here."""
            mine = f"/api/m/{machine_name()}/"
            if self.path.startswith(mine):
                self.path = self.path[len(mine) - 1:]

        def own_origin(self):
            """The app's own page's origin, for this request."""
            host = self.headers.get("Host", "")
            return f"http://{host}" if self.via == "local" else f"https://{host}"

        def board_post(self, what, data):
            """A board's card, by your hand: {board, card, ...}. Who you are
            is Tailscale's (an approval's by)."""
            by = self.headers.get("Tailscale-User-Login", "") or ""
            bid, cid = data.get("board"), data.get("card")
            if what == "add":           # a task you wrote: {board, text, column}
                r, why = board_add_you(bid, data.get("text"), data.get("column"))
                return self.error(409, why) if why else self.send(200, r)
            if what == "comment":       # {board, card, text}: on its thread, and to its agent
                why = board_comment_you(bid, cid, data.get("text"))
            elif what == "press":       # {board, card, button, words, base: the card's sha256 as you saw it}
                why = board_press(bid, cid, data.get("button"), data.get("words"), by, str(data.get("base") or ""))
            elif what == "move":        # {board, card, column, base}
                why = board_move_you(bid, cid, data.get("column"), by, str(data.get("base") or ""))
            elif what == "edit":        # {board, card, title, body, base}
                title, text = data.get("title"), data.get("body")
                if (title is not None and not isinstance(title, str)) or (text is not None and not isinstance(text, str)):
                    return self.error(400, "a title and a text")
                r = board_edit_you(bid, cid, title, text, data.get("base") if isinstance(data.get("base"), str) else None)
                why = r if isinstance(r, str) else None
            elif what == "remove":      # {board, card}
                why = board_remove_you(bid, cid)
            else:
                return self.error(404, "no such board action")
            return self.error(409, why) if why else self.send(200, {})

        def body(self, limit=200_000):
            try:
                n = int(self.headers.get("Content-Length") or 0)
                data = json.loads(self.rfile.read(n) if 0 < n <= limit else b"{}")
            except ValueError:
                data = None
            return data if isinstance(data, dict) else {}

        def session(self, sid):
            s = session(sid) if re.fullmatch(r"[\w][\w.-]{0,119}", sid) else None
            if not s or (CLOSING / f"{sid}.json").exists():
                self.error(404, "no such chat")
                return None
            return s

        def ws_check(self):
            """Whether this is a WebSocket from one of the app's own pages (a
            page elsewhere can open one to it too: its Origin says whose it is).
            Else it says why not."""
            host = self.headers.get("Host", "")
            site = self.headers.get("Sec-Fetch-Site")
            if self.headers.get("Upgrade", "").lower() != "websocket":
                self.error(400, "a WebSocket")
                return False
            if self.via != "peer" and (self.headers.get("Origin") != self.own_origin() or (site and site != "same-origin")):
                self.error(403, "only from the app")
                return False
            if self.headers.get("Sec-WebSocket-Version") != "13" or not self.headers.get("Sec-WebSocket-Key"):
                self.error(400, "a WebSocket")
                return False
            return True

        def ws_handshake(self):
            key = base64.b64encode(hashlib.sha1((self.headers["Sec-WebSocket-Key"]
                                                 + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
            self.protocol_version = "HTTP/1.1"     # a WebSocket's answer is HTTP/1.1, whatever the server's
            self.send_response(101)
            for k, v in (("Upgrade", "websocket"), ("Connection", "Upgrade"), ("Sec-WebSocket-Accept", key)):
                self.send_header(k, v)
            self.end_headers()
            self.wfile.flush()
            self.close_connection = True
            if not hasattr(self, "ws_lock"):
                self.ws_lock = threading.Lock()

        def tty(self, s, which, args):
            """A session's real terminal, Claude's or its own (which), for
            xterm.js in a browser: a WebSocket whose binary messages are what
            it shows (the pty's output) one way and the keys (its input) the
            other; text ones are JSON: {"resize": [cols, rows]} from the page,
            and {"exit": code} to it. On the pty, `amarchy attach`: it starts
            what isn't running, waits for a new worktree, says so when the
            session is gone, and is then tmux."""
            if not self.ws_check():
                return
            try:
                cols = min(max(int((args.get("cols") or ["80"])[0]), 2), 1000)
                rows = min(max(int((args.get("rows") or ["24"])[0]), 2), 500)
            except ValueError:
                return self.error(400, "its size")
            sid = s["id"]
            master, slave = os.openpty()
            fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
            env = {**clean_env(), "TERM": "xterm-256color", "COLORTERM": "truecolor"}
            env.pop("TMUX", None)
            try:
                proc = subprocess.Popen([sys.executable, SELF, "attach", sid, which], stdin=slave, stdout=slave,
                                        stderr=slave, env=env, cwd=HOME, start_new_session=True)
            except OSError as e:
                os.close(master)
                os.close(slave)
                return self.error(500, f"couldn't attach: {e}")
            os.close(slave)
            st.looking(sid, True)
            done = threading.Event()

            def out():          # the terminal, as it draws, to the page
                try:
                    # Never a read once the page is gone (done): its pty is
                    # closed then, and its number may already be another
                    # connection's (a request read here would never be answered).
                    while not done.is_set():
                        try:
                            ready, _, _ = select.select([master], [], [], 0.5)
                            if not ready:
                                continue
                            data = os.read(master, 65536)
                        except (OSError, ValueError):   # attach has ended
                            break
                        if not data:
                            break
                        self.ws_send(data, op=2)
                    code = proc.wait()
                    self.ws_send({"exit": code})
                    self.ws_send(b"", op=8)
                except OSError:
                    pass
                finally:
                    done.set()
                    try:
                        self.connection.shutdown(socket.SHUT_RDWR)
                    except OSError:
                        pass

            def ping():         # a quiet terminal's connection stays open through the proxy
                while not done.wait(TTY_PING):
                    try:
                        self.ws_send(b"", op=9)
                    except OSError:
                        return
            reader = threading.Thread(target=out, daemon=True)
            try:
                self.ws_handshake()
                reader.start()
                threading.Thread(target=ping, daemon=True).start()
                while not done.is_set():
                    try:
                        op, data = self.ws_recv()
                    except (OSError, ValueError):
                        break
                    if op in (None, 8):
                        break
                    if op in (0, 2):
                        while data:
                            data = data[os.write(master, data):]
                    elif op == 1:
                        try:
                            msg = json.loads(data)
                        except ValueError:
                            continue
                        if not isinstance(msg, dict):
                            continue
                        size = msg.get("resize")
                        if isinstance(size, list) and len(size) == 2 and all(isinstance(n, int) for n in size):
                            fcntl.ioctl(master, termios.TIOCSWINSZ,
                                        struct.pack("HHHH", min(max(size[1], 2), 500), min(max(size[0], 2), 1000), 0, 0))
                        # Before what the message line sends or a Paste: back
                        # at the bottom (out of copy mode), done before the
                        # keys that come after it are written.
                        if msg.get("bottom") is True:
                            tty_bottom(sid, which)
                    elif op == 9:
                        self.ws_send(data, op=10)
            except OSError:
                pass
            finally:
                done.set()
                st.looking(sid, False)
                try:
                    proc.terminate()
                    proc.wait(3)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
                except OSError:
                    pass
                # Its reader stopped first (done: within half a second), then its pty closed.
                if reader.is_alive():
                    reader.join(2)
                try:
                    os.close(master)
                except OSError:
                    pass

        # ---- dictation on the host (see "dictation on the host")

        def dictate(self, args):
            """Dictation written down here, for any box in the app: a
            WebSocket, the audio in it (16 kHz, 16-bit, mono) while the mic is
            on and "end" when it's let go. Back come {"state": "listening"},
            {"interim"} (all of it written down so far) as you talk,
            {"state": "transcribing"} and then {"text"}, or {"error"}. Without
            the WebSocket: whether it's set up (dictate_view). Without a
            model here, it's another machine's that has one, passed on
            (dictate_helper); asked by another machine, never further."""
            status = dictate_status()
            helper = None if status["ready"] or self.via == "peer" else dictate_helper(st)
            if self.headers.get("Upgrade", "").lower() != "websocket":
                return self.send(200, {**status, "via": dictate_via(helper)})
            if not status["ready"]:
                if helper:
                    return self.tunnel(helper, self.path, helper["label"])
                return self.error(409, f"Dictation isn't set up on {machine_label()}: {status['how']}")
            if not self.ws_check():
                return
            device = device_name(self.headers.get("User-Agent"), args.get("standalone", [""])[0] == "1")
            self.ws_lock = threading.Lock()     # the words as they come go out from another thread
            said, outcome, text, let_go = 0, "cut off", "", None
            st.transcriber.warm()       # the model loads while you speak

            def heard(words):
                self.ws_send({"interim": words})

            d = Dictation(st.transcriber, heard)
            try:
                self.ws_handshake()
                self.connection.settimeout(MIC_QUIET)      # gone quiet: let go
                self.ws_send({"state": "listening"})
                started, ended = time.time(), False
                while time.time() - started < MIC_MAX:
                    try:
                        op, data = self.ws_recv()
                    except (OSError, ValueError):
                        break
                    if op in (None, 8):
                        break
                    if op == 1 and data == b"end":
                        ended = True
                        break
                    if op in (0, 2):
                        d.add(data)
                        said += len(data)
                    elif op == 9:
                        self.ws_send(data, op=10)
                if not ended and not said:
                    return
                let_go = time.time()
                self.ws_send({"state": "transcribing"})
                try:
                    text = d.finish()
                except OSError as e:
                    outcome = str(e)
                    self.ws_send({"error": f"It couldn't be written down: {e}"})
                    return
                if text:
                    outcome = None
                    self.ws_send({"text": text})
                else:
                    outcome = "no words heard" if d.loud else "only silence from the microphone" if said else "no audio"
                    self.ws_send({"error": "No words heard" if d.loud else
                                  "The microphone gave only silence" if said else "No sound came from the microphone"})
            except OSError:
                pass
            finally:
                d.drop()
                dictate_log({"engine": "host", **({"for": self.peer} if self.via == "peer" else {}), "device": device,
                             "said_s": round(said / 32000, 1),
                             "wait_ms": int((time.time() - let_go) * 1000) if let_go else None,
                             "pieces": d.pieces, "text": text, **({"error": outcome} if outcome else {})})

        def dictate_logged(self, data):
            """How a dictation the browser wrote down itself (its own speech
            recognition) went, or why one for the host never reached it (the
            microphone didn't start), for amarchy dictation log."""
            def num(k, most):
                v = data.get(k)
                return round(min(float(v), most), 1) if isinstance(v, (int, float)) and v >= 0 else None
            lang = str(data.get("lang") or "")[:20]
            dictate_log({"engine": "host" if data.get("engine") == "host" else "device", "device": device_name(self.headers.get("User-Agent"), bool(data.get("standalone"))),
                         "lang": lang, "said_s": num("said_s", 3600), "wait_ms": num("wait_ms", 600000),
                         "text": str(data.get("text") or "")[:5000],
                         **({"error": str(data["error"])[:300]} if data.get("error") else {})})
            return self.send(200, {})

        def secrets(self, data):
            """Settings → Secrets: keep a secret ({name, value, project}:
            project null for every project) or forget one ({name, project,
            forget: true}). Answers with the names, never a value."""
            name, project = data.get("name"), data.get("project")
            if project is not None and (not isinstance(project, str) or not (WORK / project / ".git").exists()):
                return self.error(400, "no such project")
            if not isinstance(name, str):
                return self.error(400, "which secret?")
            if data.get("forget") is True:
                if not secret_forget(project, name):
                    return self.error(404, f"no secret {name}")
            else:
                why = secret_set(project, name, data.get("value"))
                if why:
                    return self.error(400, why)
            return self.send(200, {**secrets_list(), "suggestions": list(SECRET_SUGGESTIONS),
                                   "projects_known": project_names()})

        def dictate_fetch(self):
            """Settings' "Set up dictation" (and the mic's first tap): what
            dictation needs here fetched in the background (amarchy dictation
            setup: the engine where no package has it, then the model); the
            list says how far."""
            status = dictate_status()
            if not status["auto"]:
                return self.error(409, f"Dictation can't be set up on {machine_label()} by itself: {status['how']}")
            under_way = status["setup"] and not status["setup"].get("error")
            if not status["ready"] and not under_way and not dictate_kick():
                return self.error(500, "couldn't start dictation's setup")
            return self.send(200, {})

        def ws_recv(self):
            """A WebSocket frame from the phone: (opcode, payload), or (None,
            b"") when it's gone. Frames from a browser are masked."""
            head = self.rfile.read(2)
            if len(head) < 2:
                return None, b""
            n = head[1] & 0x7F
            if n == 126:
                n = int.from_bytes(self.rfile.read(2), "big")
            elif n == 127:
                n = int.from_bytes(self.rfile.read(8), "big")
            if not head[1] & 0x80 or n > 1 << 20:
                raise ValueError("not a frame from a browser")
            mask = self.rfile.read(4)
            data = self.rfile.read(n)
            if len(data) < n:
                return None, b""
            if n:
                data = (int.from_bytes(data, "big") ^ int.from_bytes((mask * (n // 4 + 1))[:n], "big")).to_bytes(n, "big")
            return head[0] & 0x0F, data

        def ws_send(self, body, op=1):
            data = json.dumps(body).encode() if isinstance(body, dict) else body
            n = len(data)
            size = (bytes([n]) if n < 126 else bytes([126]) + n.to_bytes(2, "big") if n < 1 << 16
                    else bytes([127]) + n.to_bytes(8, "big"))
            with self.ws_lock:      # the words as they come go out from another thread
                self.wfile.write(bytes([0x80 | op]) + size + data)

        def do_GET(self):
            self.here()
            path, _, query = self.path.partition("?")
            args = urllib.parse.parse_qs(query)
            if path == "/local":        # the desktop app on this machine comes in (see "machines")
                return self.local_in(args)
            if path == "/api/peer/hello":       # what this machine is, to another of yours (see "machines")
                return self.peer_hello()
            if not self.allowed():
                return
            if path.startswith("/api/m/"):      # a chat on another machine (the pass-through)
                return self.pass_through()
            if path == "/api/peer/state":       # this machine's own chats, for another machine's board
                with st.changed:
                    view = st.view
                return self.send(200, peer_state(view))
            if path == "/api/peer/events":
                return self.peer_events()
            if path == "/api/peer/sync" or path.startswith("/api/peer/sync/file/"):    # your stuff (see "your stuff on every machine")
                if self.via != "peer":
                    return self.error(403, "only from another machine of yours")
                if path == "/api/peer/sync":
                    try:
                        have = json.loads((args.get("have") or ["{}"])[0])
                    except ValueError:
                        have = {}
                    return self.send(200, sync_state(have if isinstance(have, dict) else {}))
                f = sync_file(path.rsplit("/", 1)[1])
                if not f:
                    return self.error(404, "no such file here")
                data = f.read_bytes()
                self.head(200, "application/octet-stream", [("Content-Length", str(len(data)))], cache="no-store")
                self.end_headers()
                self.wfile.write(data)
                return
            if path == "/api/machines":         # Settings → Machines: each one and how it stands
                return self.send(200, {"machines": board_view(st)["machines"],
                                       "listed": machines_listed(check=False)})
            if path == "/api/machines/found":   # Add: machines of yours on the tailnet that answer as amarchy
                return self.send(200, {"found": machines_found()})
            if path == "/api/state":
                view = dict(board_view(st))
                name, bind = host_network()
                user = self.headers.get("Tailscale-User-Login") if self.via == "tailscale" else \
                    next(iter(sorted(self.net["users"])), None)
                return self.send(200, {**view, "key": app_public(), "host": {"name": name, "address": bind, "out": _links_out},
                                       "user": user})
            if path == "/api/events":
                return self.list_stream()
            if path == "/api/notices":      # the desktop app's notifications (see "the desktop app's notices")
                return self.notices_stream()
            m = re.fullmatch(r"/api/boards/([^/]+)", path)
            if m:       # one of your boards, whole (Tasks, a board open): every card in sight, its thread
                b = board_whole(urllib.parse.unquote(m.group(1)))
                return self.send(200, b) if b else self.error(404, "That board is gone")
            if path == "/api/github":       # your repos, for a new project
                r = run_amarchy("projects", "--github", "--json")
                try:
                    repos = json.loads(r.stdout) if r.returncode == 0 else None
                except ValueError:
                    repos = None
                if not isinstance(repos, list):      # not a fault: GitHub just isn't connected here
                    return self.send(200, {"repos": None, "error": "GitHub isn't connected on this server, "
                                                                   "so its repos can't be listed"})
                return self.send(200, {"repos": [{"name": x.get("name"), "private": bool(x.get("private")),
                                                  "added": bool(x.get("added"))} for x in repos if isinstance(x, dict)]})
            if path == "/api/share/key":    # the Shortcut's address, for Settings (see "sharing into amarchy")
                # On the tailnet, where a phone's Shortcut reaches (not 127.0.0.1, from the desktop app).
                base = f"https://{self.headers.get('Host', '')}/" if self.via != "local" else \
                    app_url(self.net["address"]) if self.net["address"] else None
                if not base:
                    return self.error(409, "This machine isn't on Tailscale yet: a phone can't reach it")
                return self.send(200, {"url": f"{base}api/share?key={share_key()}"})
            m = re.fullmatch(r"/api/share/(\d{1,2})", path)
            if m:       # a picture of what you shared: ?id= says which share's
                found = share_picture(int(m.group(1)), (args.get("id") or [None])[0])
                if not found:
                    return self.error(404, "that share is gone")
                self.head(200, found[0], [("Content-Length", str(len(found[1])))], cache="private, no-cache")
                self.end_headers()
                self.wfile.write(found[1])
                return
            if path == "/api/dictate":      # dictation written down here (see "dictation on the host")
                return self.dictate(args)
            if path == "/api/search":       # Tasks' search: a chat by its name or what was said in it
                q = (args.get("q") or [""])[0][:200]
                with st.changed:
                    ss = list(st.view.get("sessions") or [])
                results = [{**r, "machine": machine_name()} for r in search_chats(q, ss)]
                # Every machine's chats (see "machines"), asked of each at once;
                # a machine's own search only (a peer asking isn't passed on).
                if self.via != "peer" and st.peers and q.strip():
                    results += peers_search(st, q)
                    results.sort(key=lambda r: (not r.get("name"), -min(r.get("hits") or 0, 20), -(r.get("at") or 0)))
                return self.send(200, {"q": q, "results": results[:SEARCH_MAX]})
            if path == "/api/automations":      # what runs by itself (see "automations"), and the chats' previews
                return self.send(200, {"automations": automation_list(), "previews": preview_running(), "at": time.time()})
            if path == "/api/automations/log":
                a = automation_find((args.get("id") or [""])[0])
                if not a:
                    return self.error(404, "no such automation")
                return self.send(200, {"log": automation_log(a)})
            # The wide layout's side panel (desk.js, B3): what a session changed, and its details.
            # The composer's (phase C2): its / menu, models and mode; an image
            # in what you said.
            m = re.fullmatch(r"/api/session/([^/]+)/composer", path)
            if m:
                s = self.session(m.group(1))
                return self.send(200, composer_info(s)) if s else None
            m = re.fullmatch(r"/api/session/([^/]+)/image/([\w-]+)/(\d{1,2})", path)
            if m:
                s = self.session(m.group(1))
                if not s:
                    return
                found = transcript_image(s, m.group(2), int(m.group(3)))
                if not found:
                    return self.error(404, "no such image")
                self.head(200, found[0], [("Content-Length", str(len(found[1])))], cache="private, max-age=604800, immutable")
                self.end_headers()
                self.wfile.write(found[1])
                return
            m = re.fullmatch(r"/api/session/([^/]+)/media", path)
            if m:       # a block's picture or video (an xpost's avatar, its media): ?src=<a path here, or an https address>
                s = self.session(m.group(1))
                if not s:
                    return
                src = (args.get("src") or [""])[0]
                if re.match(r"^https://", src, re.I):
                    found, kind = media_fetch(src)
                    cache = "private, max-age=86400"
                else:
                    found, kind = media_path(src, s.get("path"))
                    cache = "private, no-cache"     # a draft's picture may change under the same name
                if not found:
                    return self.error(404, f"no picture or video there ({kind})")
                return self.send_media(found, kind, cache)
            m = re.fullmatch(r"/api/session/([^/]+)/preview", path)
            if m:       # one of a chat's previews, whole (its sheet): ?key=<its key>, else its first
                s = self.session(m.group(1))
                if not s:
                    return
                p = preview_pick(s, args["key"][0] if "key" in args else None)
                if not p:
                    return self.error(404, "This chat has no such preview" if "key" in args else "This chat has no preview")
                info = preview_info(s, p, lines=60)
                with st.changed:
                    row = next((x for x in st.view.get("sessions") or [] if x.get("id") == s["id"]), {})
                return self.send(200, {**info, "task": row.get("task") or s.get("title") or s["name"], "id": s["id"]})
            m = re.fullmatch(r"/api/session/([^/]+)/(changes|details)", path)
            if m:
                s = self.session(m.group(1))
                if not s:
                    return
                d = app_changes(s) if m.group(2) == "changes" else app_details(s)
                if d.get("error"):
                    return self.error(410, d["error"])
                # ?sig=: the side panel has this one already (the same diff), so not again.
                if m.group(2) == "changes" and d.get("sig") and args.get("sig") == [d["sig"]]:
                    return self.send(200, {"same": True, "sig": d["sig"]})
                return self.send(200, d)
            if path == "/api/secrets":      # the secrets' names (never a value): Settings → Secrets
                return self.send(200, {**secrets_list(), "suggestions": list(SECRET_SUGGESTIONS),
                                       "projects_known": project_names()})
            m = re.fullmatch(r"/api/session/([^/]+)/(stream|earlier|closing|move|tty/claude|tty/term|tty/claude/text|tty/term/text|commands|agent)", path)
            if m:
                s = self.session(m.group(1))
                if not s:
                    return
                if m.group(2) == "move":        # what moving it there would do (see "moving a chat")
                    to = (args.get("to") or [""])[0]
                    if not re.fullmatch(MACHINE_NAME_RE, to):
                        return self.error(400, "to: a machine (amarchy machines lists them)")
                    return self.send(200, move_check(s, to))
                if m.group(2) == "agent":
                    return self.chat(s, "agent", {})
                if m.group(2).endswith("/text"):        # Select text: what the terminal printed, as text
                    text = tty_text(s["id"], m.group(2).split("/")[1])
                    if text is None:
                        return self.error(409, "That terminal isn't running")
                    return self.send(200, {"text": text})
                if m.group(2).startswith("tty/"):
                    return self.tty(s, m.group(2)[4:], args)
                if m.group(2) == "commands":
                    return self.send(200, {"commands": app_commands(s)})
                if m.group(2) == "stream":
                    return self.session_stream(s)
                if m.group(2) == "closing":
                    return self.send(200, app_closing(s))
                try:
                    items, start = app_earlier(s, int(args.get("before", ["0"])[0]))
                except (ValueError, OSError):
                    return self.error(400, "bad offset")
                return self.send(200, {"items": items, "start": start})
            if path == "/api/sounds":       # what amarchy sound offers, and the two picked
                return self.send(200, app_sounds())
            m = re.fullmatch(r"/sound/([^/]{1,200})", path)
            if m:
                found = app_sound_file(urllib.parse.unquote(m.group(1)))
                if not found:
                    return self.error(404, "not found")
                data = found[0].read_bytes()
                self.head(200, found[1], [("Content-Length", str(len(data)))], cache="no-cache")
                self.end_headers()
                self.wfile.write(data)
                return
            if path == "/theme.css":
                return self.send(200, app_theme_css().encode(), "text/css; charset=utf-8")
            # Your assistant's picture (amarchy assistant --picture), or an
            # agent's (amarchy agents <id> --picture), by its hash.
            m = re.fullmatch(r"/picture/([0-9a-f]{12})-(512|192)\.png", path)
            if m:
                f = picture_by_sig(m.group(1), small=m.group(2) == "192")
                try:
                    data = f.read_bytes() if f else b""
                except OSError:
                    data = b""
                if not data:
                    return self.error(404, "not found")
                self.head(200, "image/png", [("Content-Length", str(len(data)))], cache="max-age=31536000, immutable")
                self.end_headers()
                self.wfile.write(data)
                return
            if path == "/api/look":       # the themes, fonts and wallpapers to pick from
                return self.send(200, look_info())
            if path == "/api/tailscale":  # Settings → Tailscale (see "amarchy tailscale"); here: from this machine itself
                return self.send(200, self.tailscale_view(tailscale_state()))
            # Omarchy's wallpapers fetched here, and their cuts; the look's
            # own files cut (named after their hash).
            m = re.fullmatch(r"/wallpapers/([\w-]+)/([\w.-]+)", path) or re.fullmatch(r"/cuts/([\w.-]+)", path)
            if m:
                f = (CUTS / m.group(1) if CUT_NAME.fullmatch(m.group(1)) else None) if path.startswith("/cuts/") else \
                    wall_served(m.group(1), m.group(2))
                if not f or not f.is_file():
                    return self.error(404, "not found")
                data = f.read_bytes()
                kind = APP_LOOK_TYPES.get(f.suffix[1:].lower(), "image/jpeg")
                self.head(200, kind, [("Content-Length", str(len(data)))], cache="max-age=31536000, immutable")
                self.end_headers()
                self.wfile.write(data)
                return
            # The look's own files: a theme's wallpapers, a font, your own wallpaper.
            m = re.fullmatch(r"/themes/([\w-]+)/(wallpaper|wallpaper-wide)\.svg", path) or \
                re.fullmatch(r"/fonts/([\w-]+)/(regular|bold)\.woff2", path) or \
                re.fullmatch(r"/own/(own-[0-9a-f]{12}-(?:phone|wide)\.(jpg|png|webp))", path) or \
                re.fullmatch(r"/custom/([\w-]+)/((?:wallpaper|wallpaper-wide|regular|bold)\.(?:jpg|png|webp|ttf|otf|woff2?))", path)
            if m:
                f = (APP_PICK / m.group(1) if path.startswith("/own/") else CUSTOM / m.group(1) / m.group(2)
                     if path.startswith("/custom/") else
                     (THEMES if path.startswith("/themes/") else FONTS) / m.group(1) / path.rsplit("/", 1)[1])
                if not f.is_file():
                    return self.error(404, "not found")
                data = f.read_bytes()
                kind = {".svg": "image/svg+xml", ".woff2": "font/woff2"}.get(f.suffix) or APP_LOOK_TYPES[f.suffix[1:]]
                # Asked for with ?v=<its hash>, or named after it (your own): the same address is the same file.
                self.head(200, kind, [("Content-Length", str(len(data)))], cache="max-age=31536000, immutable")
                self.end_headers()
                self.wfile.write(data)
                return
            return self.page(path)

        def page(self, path):
            name = "index.html" if path == "/" else path.lstrip("/")
            # The libraries it uses (vendor/), named with their versions: the
            # same name is always the same file.
            folder, _, name = name.rpartition("/") if name.startswith("vendor/") else ("", "", name)
            f = APP_PAGES / folder / name
            # The blocks' catalog (blocks.json), for the app's scripts: blocks.js.
            script = "BLOCK_CATALOG" if name == "blocks.js" and not folder else None
            if script:
                f = APP_PAGES / "blocks.json"
            if not re.fullmatch(r"[\w-]+(\.[\w-]+)+", name) or Path(name).suffix not in APP_TYPES or not f.is_file():
                return self.error(404, "not found")
            # The build this page is (index.html knows it, sw.js caches by it,
            # and every app file says which build it is: a worker keeps only
            # files of one build, never a mix of two).
            build = app_build()
            extra = [("Service-Worker-Allowed", "/")] if name == "sw.js" else []
            extra.append(("X-Amarchy-Build", build))
            ctype = APP_TYPES[Path(name).suffix]
            # index.html and sw.js are made for each asking (the build, a
            # nonce in them): always sent. Every other file is the build's,
            # asked for as name?b=<build> (index.html's links, sw.js): that
            # address is that file for good, kept by the browser without
            # asking again. Asked for otherwise, it's checked (its ETag, the
            # build) and comes again only when it changed.
            made = name in ("index.html", "sw.js")
            stamped = not made and urllib.parse.parse_qs(self.path.partition("?")[2]).get("b") == [build]
            cache = "max-age=31536000, immutable" if folder or stamped else "no-cache"
            if not made:
                tag = f'"{build}"'
                extra.append(("ETag", tag))
                if tag in self.headers.get("If-None-Match", ""):
                    self.head(304, ctype, extra, cache=cache)
                    self.end_headers()
                    return
            nonce = None
            if made:
                data = f.read_bytes().replace(b"{{build}}", build.encode())
                if name == "index.html":
                    nonce = b64u(os.urandom(16))
                    data = data.replace(b"{{nonce}}", nonce.encode())
                data, more = self.squeezed(data, ctype)
            else:
                data, packed = app_file(f, script)
                data, more = self.squeezed(data, ctype, packed)
            self.head(200, ctype, [("Content-Length", str(len(data))), *extra, *more], cache=cache, nonce=nonce)
            self.end_headers()
            self.wfile.write(data)

        def stream_start(self):
            # Gzipped as it goes, each write flushed through (a list goes from
            # tens of KB to a few hundred bytes), when the browser takes it;
            # ?plain=1 if gzip held it back on the way (the client asks so
            # when its first event doesn't come).
            plain = urllib.parse.parse_qs(self.path.partition("?")[2]).get("plain") == ["1"]
            self.zip = zlib.compressobj(6, zlib.DEFLATED, 31) \
                if not plain and "gzip" in self.headers.get("Accept-Encoding", "") else None
            self.head(200, "text/event-stream", [("X-Accel-Buffering", "no"), ("Vary", "Accept-Encoding"),
                                                 *([("Content-Encoding", "gzip")] if self.zip else [])])
            self.end_headers()
            self.close_connection = True
            self.out(b"retry: 1000\n\n")      # back a second after the server restarts (a ship), not three

        def out(self, data):
            """A stream's bytes, sent now."""
            if self.zip:
                data = self.zip.compress(data) + self.zip.flush(zlib.Z_SYNC_FLUSH)
            self.wfile.write(data)
            self.wfile.flush()

        def event(self, name, data):
            self.out(f"event: {name}\ndata: {mask_secrets(json.dumps(data))}\n\n".encode())

        def notices_stream(self):
            """The desktop app's notices as they're kept (notice_put), from
            now on: none from before it connected."""
            self.stream_start()
            key = f"{threading.get_ident()}-{time.time_ns()}"
            last = max((n["id"] for n in notices_after(0)), default=0)
            # Back after a moment away (a reconnect): from the one it saw last,
            # if that's from the last few minutes; never older ones.
            try:
                after = int(urllib.parse.parse_qs(self.path.partition("?")[2]).get("after", ["0"])[0])
            except ValueError:
                after = 0
            if after and time.time_ns() - after < NOTICES_RESUME * 1_000_000_000:
                last = min(last, after)
            mtime, beat, seen = None, time.time(), 0
            try:
                while True:
                    if time.time() - seen > KEEPALIVE / 3:
                        desktop_seen(key)
                        seen = time.time()
                    try:
                        m = NOTICES.stat().st_mtime_ns
                    except OSError:
                        m = None
                    if m != mtime:
                        mtime = m
                        for n in notices_after(last):
                            self.event("notice", n)
                            last = n["id"]
                            beat = time.time()
                    if time.time() - beat > KEEPALIVE:
                        self.out(b": still here\n\n")
                        beat = time.time()
                    time.sleep(0.25)
            except OSError:
                pass
            finally:
                desktop_seen(key, gone=True)

        def list_stream(self):
            """The list, and again on every change."""
            self.stream_start()
            version = -1
            try:
                while True:
                    with st.changed:
                        if st.version == version or not st.view:
                            st.changed.wait(KEEPALIVE)
                        if not st.view:
                            continue
                        changed, version = st.version != version, st.version
                    if changed:
                        self.event("list", board_view(st))
                    else:
                        self.out(b": still here\n\n")
            except OSError:
                pass

        def session_stream(self, s):
            """A session as it goes on: its row in the list, its conversation
            (the latest of it first), and its screen with any question on it."""
            if not s.get("setup") and Path(s["path"]).is_dir() and not tmux_has(tmux_name(s["id"])):
                host_start(s)       # after a reboot, before anyone attached: asleep, until you send it something
            self.stream_start()
            conv, screen, row, beat = AppConversation(s), None, None, time.time()
            screen_at = 0       # when its pane was last read (app_screen)
            # On the chat engine, its live state too (live.json, chat_live) as
            # it changes: what Claude is writing, doing and asking.
            live, live_sig, tick = None, None, 0
            st.looking(s["id"], True)
            try:
                while True:
                    chat = engine(st.row(s["id"]) or s) == "chat"
                    if chat:
                        try:
                            sig = agent_live_file(s["id"]).stat().st_mtime_ns
                        except OSError:
                            sig = None
                        if sig != live_sig:
                            live_sig, was = sig, live
                            live = chat_live(agent_live(s["id"]), st.row(s["id"]) or s)
                            if live != was:
                                self.event("live", live)
                                if any((live or {}).get(k) != (was or {}).get(k) for k in ("pending", "state")):
                                    tick = 0        # what it asks: on the screen's dialog now
                    elif live is not None or live_sig is not None:
                        live, live_sig = None, None
                        self.event("live", None)    # back on the terminal engine
                    if time.time() - tick < 0.5:
                        time.sleep(0.12)
                        continue
                    tick = time.time()
                    now = st.row(s["id"])
                    if now is None and (not session(s["id"]) or (CLOSING / f"{s['id']}.json").exists()):
                        self.event("gone", {})
                        return
                    # The list's preview of it (app_words) isn't news to its own chat.
                    if now is not None and not now.get("assistant"):
                        now = {k: v for k, v in now.items() if k not in ("said", "doing")}
                    if now is not None and now != row:
                        row = now
                        self.event("session", row)
                    # Its screen (the question on it) before its conversation: the
                    # card isn't held up by hundreds of KB of it, or by git.
                    # On the chat engine, with its broker running, the screen's
                    # facts are live.json's (chat_screen): its pane isn't read.
                    # Without it (asleep, exited), the pane says, every few seconds.
                    seen = chat_screen(s) if chat else None
                    if seen is not None:
                        screen_at = 0
                    elif not chat or time.time() - screen_at > 2:
                        seen, screen_at = app_screen(s), time.time()
                    if seen is not None and seen != screen:
                        screen = seen
                        self.event("screen", screen)
                    items, reset = conv.poll()
                    if reset:
                        self.event("conversation", {"reset": True, "items": items, "start": conv.start})
                    elif items:
                        self.event("conversation", {"items": items})
                    if time.time() - beat > KEEPALIVE:
                        self.out(b": still here\n\n")
                        beat = time.time()
                    time.sleep(0.12 if chat else 0.5)
            except OSError:
                pass
            finally:
                st.looking(s["id"], False)

        def do_POST(self):
            # What it did is on every screen at once (app_watch reads the list
            # now), and again a moment on, as Claude takes it up.
            # (Not when it changed nothing: a chat that was seen already, seen.)
            self.here()
            self.changed_nothing = False
            self.gate = None
            try:
                self.post_request()
            finally:
                if self.gate:       # (gate_in: what it sent the chat is in)
                    self.gate.close()
                    self.gate = None
                if not self.changed_nothing:
                    st.poke.set()
                    later = threading.Timer(0.4, st.poke.set)
                    later.daemon = True
                    later.start()

        def gate_in(self, s):
            """Through the chat's move gate (move_gate), held until this
            request is done; False (answered) when a move holds it too long."""
            self.gate = move_gate(s["id"])
            if self.gate:
                return True
            self.error(409, move_holds(s["id"]) or "It's moving to another machine: try again in a moment")
            return False

        def tailscale_post(self, data):
            """POST /api/tailscale {do: login | up | switch, account}: what
            Settings → Tailscale does (see "amarchy tailscale"). Switching
            accounts only from this machine itself (its desktop app): from
            elsewhere it would cut that device off."""
            if self.via == "peer":
                return self.error(403, "not from another machine")
            what = data.get("do")
            if what == "login":
                url, why = tailscale_login()
                return self.send(200, self.tailscale_view(tailscale_state())) if url else self.error(409, why)
            if what == "own":       # amarchy's own node started (a user service)
                why = tailscale_own_start()
                return self.error(409, why) if why else self.send(200, self.tailscale_view(tailscale_state()))
            if what == "up":
                why = tailscale_up()
                return self.error(409, why) if why else self.send(200, self.tailscale_view(tailscale_state()))
            if what == "switch":
                if self.via != "local":
                    return self.error(403, f"switch accounts on {machine_label()} itself: from here it would cut this "
                                           "device off")
                why = tailscale_switch(str(data.get("account") or ""))
                return self.error(409, why) if why else self.send(200, self.tailscale_view(tailscale_state()))
            return self.error(400, "do: login, own, up or switch")

        def tailscale_view(self, st):
            """tailscale_state for Settings: with it in words, this machine's
            name, and whether the asking device is this machine itself."""
            return {**st, "words": tailscale_words(st), "here": self.via == "local", "host": machine_label()}

        def do_PUT(self):
            """PUT /api/peer/look: "Omarchy (live)" from an Omarchy desktop of
            yours (see "the theme live"); only another machine of yours sends
            it (its pairing key), never a page."""
            self.here()
            if self.path.partition("?")[0] != "/api/peer/look":
                return self.error(404, "not found")
            # Its body read first (bounded): whatever is said back then
            # reaches the sender whole, not cut off by its own sending.
            raw = self.read_body(LOOK_PUT_MAX)
            if raw is None:
                return self.error(413, "that theme is too big")
            if not self.allowed(write=True):
                return
            if self.via != "peer":
                return self.error(403, "only from another machine of yours")
            try:
                data = json.loads(raw or b"{}")
                files = {str(f): base64.b64decode(str(v), validate=True) for f, v in (data.get("files") or {}).items()}
            except (ValueError, AttributeError, TypeError):
                return self.error(400, "a theme is JSON: {key, theme, files: {name: base64}}")
            if data.get("key") != OMARCHY_LIVE:
                return self.error(400, f"only {OMARCHY_LIVE} comes from another machine")
            why = look_custom_put(OMARCHY_LIVE, data.get("theme"), files)
            if why:
                return self.error(400, why)
            st.poke.set()       # on every page now: theme.css again, if it's worn
            print(f"amarchy app: {OMARCHY_LIVE_NAME} from {self.peer}", file=sys.stderr, flush=True)
            return self.send(200, {"key": OMARCHY_LIVE, "worn": look_worn()["theme"] == OMARCHY_LIVE})

        def post_request(self):
            if self.path.partition("?")[0] == "/api/share":     # from the phone's share sheet: not a page's
                return self.share_in()
            if self.path == "/api/peer/pair":       # another machine of yours pairs with this one (see "machines")
                return self.peer_pair()
            if not self.allowed(write=True):
                return
            if self.path.startswith("/api/m/"):     # a chat on another machine (the pass-through)
                self.changed_nothing = True         # (that machine's list says what changed)
                return self.pass_through()
            if self.path == "/api/peer/sync":       # what changed on another machine of yours (see "your stuff on every machine")
                if self.via != "peer":
                    return self.error(403, "only from another machine of yours")
                theirs = self.body(limit=4_000_000)
                m = machine_find(self.peer)

                def take():
                    try:
                        if sync_take(theirs, peer_fetch(m)):
                            st.poke.set()
                        # Records it has that this one hasn't (a merge there): asked for now.
                        mine = missions_have()
                        if getattr(st, "sync", None) and any(isinstance(n, int) and n > mine.get(o, -1)
                                                             for o, n in (theirs.get("have") or {}).items()):
                            st.sync.soon(self.peer)
                    except Exception as e:
                        print(f"amarchy app: sync from {self.peer}: {e}", file=sys.stderr, flush=True)
                threading.Thread(target=take, daemon=True).start()
                return self.send(200, {})
            if self.path in ("/api/peer/unpair", "/api/peer/label", "/api/peer/send", "/api/peer/icon"):
                if self.via != "peer":
                    return self.error(403, "only from another machine of yours")
                return self.peer_post(self.path.rsplit("/", 1)[1], self.body())
            if self.path in ("/api/peer/move", "/api/peer/move/abort"):     # a chat moving here (see "moving a chat")
                if self.via != "peer":
                    return self.error(403, "only from another machine of yours")
                return self.peer_move_in() if self.path == "/api/peer/move" else self.peer_move_abort(self.body())
            if self.path == "/api/machines":        # Settings → Machines: add, remove, rename
                return self.machines_post(self.body())
            if self.path == "/api/outbox/cancel":   # a message waiting for its machine, taken back: {id}
                data = self.body()
                if not outbox_drop(data.get("id") if isinstance(data.get("id"), str) else ""):
                    return self.error(404, "It's gone already: sent, or taken back")
                st.bump()
                return self.send(200, {})
            big = self.path in ("/api/clip", "/api/assistant/picture", "/api/sound/add", "/api/look/wallpaper", "/api/new") \
                or bool(re.fullmatch(r"/api/session/[^/]+/(send|agent/picture)", self.path))      # images, on the chat engine; an agent's picture
            upload = bool(re.fullmatch(r"/api/session/[^/]+/upload", self.path))
            data = self.body(UPLOAD_MAX if upload else CLIP_MAX if big else 200_000)
            if upload:      # a file for Claude, into the worktree (the composer's, phase C2)
                if len(data.get("data") or "") == 0 and "remove" not in data and \
                        int(self.headers.get("Content-Length") or 0) > UPLOAD_MAX:
                    return self.error(413, "That file is too big (50 MB at most)")
                s = self.session(self.path.split("/")[3])
                if not s:
                    return
                r = app_upload(s, data)
                return self.error(*r) if isinstance(r, tuple) else self.send(200, r)
            if self.path == "/api/clip":
                return self.clip(data)
            if self.path in ("/api/sound", "/api/sound/add"):
                return self.sound(data)
            if self.path in ("/api/assistant", "/api/assistant/picture"):
                return self.assistant(None, data)
            if self.path == "/api/dictate/log":
                return self.dictate_logged(data)
            if self.path == "/api/missions/goal":     # your daily goal: {goal} (0: none)
                g = data.get("goal")
                if not isinstance(g, int) or not 0 <= g <= 50:
                    return self.error(400, "a goal from 0 to 50")
                write_file(MISSION_GOAL, f"{g}\n")
                return self.send(200, {"goal": g})
            if self.path == "/api/missions/clear":    # all clear: nothing needed you, nothing left to complete
                mission_log({"kind": "clear"})
                return self.send(200, {})
            if self.path == "/api/today/loop":      # Done, Chase, Ask or New chat on one of your loops: {key, action, text}, to your assistant
                why = loop_tell(data.get("key"), data.get("action"), data.get("text") or "")
                return self.error(409, why) if why else self.send(200, {})
            if self.path.startswith("/api/boards/"):        # what you do on a board (see "Tasks: boards")
                return self.board_post(self.path[len("/api/boards/"):], data)
            if self.path == "/api/tasks/press":     # a button on one of your agents' tasks: {id, button}, its message to the agent
                why = task_press(data.get("id"), data.get("button"))
                return self.error(409, why) if why else self.send(200, {})
            if self.path == "/api/today/loops":     # your loops file: {path} ("" for none)
                p = data.get("path")
                if not isinstance(p, str):
                    return self.error(400, "which file (path)")
                r = run_amarchy("today", "--loops", p.strip() or "off")
                return self.send(200, {"source": loops_path() and str(loops_path()) or ""}) if r.returncode == 0 \
                    else self.error(400, gist(r.stderr))
            if self.path == "/api/automations":     # {id, action: run|pause|resume}
                a = automation_find(data.get("id") if isinstance(data.get("id"), str) else "")
                if not a:
                    return self.error(404, "no such automation")
                why = automation_act(a, data.get("action"))
                if why:
                    return self.error(409, why)
                return self.send(200, {"automation": automation_find(a["id"])})
            if self.path == "/api/dictate/setup":
                return self.dictate_fetch()
            if self.path == "/api/new":
                return self.new(data)
            if self.path == "/api/share/clear":   # a chat took what you shared, or you let it go: {id}
                if not isinstance(data.get("id"), str):
                    return self.error(400, "which share (id)")
                share_clear(data["id"])
                return self.send(200, {})
            if self.path == "/api/new/model":     # the model every new chat starts on, from now on
                model = data.get("model")
                if not isinstance(model, str) or not re.fullmatch(MODEL_RE, model):
                    return self.error(400, "which model")
                write_file(NEW_MODEL_FILE, model + "\n")
                return self.send(200, {"new_model": new_model()})
            if self.path == "/api/new/effort":    # how hard every new chat thinks, from now on
                if not effort_choice(data.get("effort")):
                    return self.error(400, "which effort")
                write_file(NEW_EFFORT_FILE, data["effort"] + "\n")
                return self.send(200, {"new_effort": new_effort()})
            if self.path == "/api/add":
                return self.add(data)
            if self.path in ("/api/push", "/api/push/remove", "/api/push/test"):
                return self.push(data)
            if self.path == "/api/alerts":    # what the other sessions tell you about (amarchy alerts)
                if data.get("alerts") not in ALERTS:
                    return self.error(400, "all, needs-you or assistant")
                write_file(ALERTS_FILE, data["alerts"] + "\n")
                return self.send(200, {})
            if self.path == "/api/look/fetch":     # fetch Omarchy's wallpapers again (amarchy theme --refresh-wallpapers)
                walls_kick(force=True)
                return self.send(200, look_info(kick=False))
            if self.path == "/api/tailscale":     # Settings → Tailscale: sign in, turn it on, switch accounts
                return self.tailscale_post(data)
            if self.path in ("/api/look", "/api/look/wallpaper"):     # the theme, font, wallpaper (amarchy theme)
                own = None
                if self.path == "/api/look/wallpaper":
                    try:
                        own = tuple(base64.b64decode(str(data.get(k) or ""), validate=True) for k in ("phone", "wide"))
                    except ValueError:
                        own = None
                    if not own or not all(own):
                        return self.error(400, "no picture came (at most 8 MB)")
                pick = {k: data.get(k) for k in ("theme", "font", "wallpaper", "background")}
                if any(v is not None and not isinstance(v, str) for v in pick.values()):
                    return self.error(400, "theme, font, wallpaper and background are names")
                look = look_set(**pick, own=own)
                return self.error(400, look) if isinstance(look, str) else self.send(200, look_info())
            if self.path == "/api/projects/move":     # a project up, down... in your order (amarchy projects move)
                name, where, other = data.get("name"), data.get("where"), data.get("other")
                why = move_project(name, where, other) if isinstance(name, str) else "which project?"
                return self.error(400, why) if why else self.send(200, {"projects": project_names()})
            if self.path == "/api/sleep":     # when idle sessions sleep (amarchy sleep --after), or all of them now
                return self.sleep(data)
            # The terminals and the secrets (phase C3 of docs/plan-chat-app.md).
            if self.path == "/api/terminals":     # Show terminals (amarchy terminals on|off)
                if not isinstance(data.get("on"), bool):
                    return self.error(400, "on: true or false")
                write_file(SHOW_TERMINALS, ("on" if data["on"] else "off") + "\n")
                return self.send(200, {"show_terminals": data["on"]})
            if self.path == "/api/secrets":       # keep one, or forget it: {name, value, project|null} / {name, project, forget}
                return self.secrets(data)
            m = re.fullmatch(r"/api/session/([^/]+)/secret", self.path)
            if m:       # what Claude asked for (amarchy secret ask): {ask, value, scope} or {ask, decline, message}
                s = self.session(m.group(1))
                if not s:
                    return
                why = secret_answer(s, data.get("ask"), data.get("value"), data.get("scope") or "project",
                                    decline=data.get("decline") is True, message=data.get("message") or "")
                if why == "gone":
                    return self.error(409, "Claude doesn't ask for it any more")
                return self.error(400, why) if why else self.send(200, {})
            # The chat engine's own (docs/agent-protocol.md, "The app's API").
            m = re.fullmatch(r"/api/session/([^/]+)/(answer|interrupt|model|effort|mode|unqueue|engine|classic)", self.path)
            if m:
                s = self.session(m.group(1))
                if s and not self.gate_in(s):
                    return
                held = move_holds(s["id"]) if s else None
                if held:
                    return self.error(409, held)
                return self.chat(s, m.group(2), data) if s else None
            m = re.fullmatch(r"/api/session/([^/]+)/(send|keys|priority|seen|close|rename|run|commands|assistant|agent|agent/picture|wake|sleep|preview|ghostty|move)", self.path)
            s = self.session(m.group(1)) if m else self.error(404, "not found")
            if not s:
                return
            what = m.group(2)
            if what == "move":
                return self.move_post(s, data)
            # Moving to another machine: nothing reaches it here until it's there.
            gated = what in ("send", "keys", "priority", "close", "rename", "run", "commands", "assistant", "agent", "wake", "sleep", "preview")
            if gated and not self.gate_in(s):
                return
            held = move_holds(s["id"]) if gated else None
            if held:
                return self.error(409, held)
            if what in ("rename", "run", "commands"):
                return self.desk_action(s, what, data)
            if what == "preview":       # {action: start|restart|stop, key}: its Preview button, its sheet
                action = data.get("action")
                if action not in ("start", "restart", "stop"):
                    return self.error(400, "start, restart or stop")
                key = data.get("key")
                if key is not None and not isinstance(key, str):
                    return self.error(400, "key: a preview's key")
                p = preview_pick(s, key)
                if not p:
                    return self.error(404, "This chat has no such preview" if key is not None else "This chat has no preview")
                if not p.get("run"):
                    return self.error(409, "Its preview has no command to start it with")
                if action == "stop":
                    left = preview_stop(s, p)
                    if left:
                        return self.send(409, {"error": "Stopped, but something is left", "left": left,
                                               "preview": preview_info(s, p)})
                else:
                    why = preview_start(s, p, restart=action == "restart")
                    if why:
                        return self.error(409, f"It didn't start: {why}")
                return self.send(200, {"preview": preview_info(s, p)})
            if what == "assistant":
                return self.assistant(s, data)
            if what == "ghostty":     # this chat in a Ghostty window on this machine's desktop (see "a chat in Ghostty")
                self.changed_nothing = True
                why = ghostty_open(s, data.get("which") if data.get("which") in ("term", "claude") else "term")
                return self.error(409, why) if why else self.send(200, {"opened": True})
            if what in ("agent", "agent/picture"):
                return self.agent(s, what, data)
            if what == "seen":
                st.seen[s["id"]] = time.time()
                st.looking(s["id"])
                # Seen already: no list to read again (but your assistant's or an
                # agent's unread count may change with it).
                self.changed_nothing = not (UNSEEN / s["id"]).exists() and not is_agent(s)
                mark_seen(s["id"])
                return self.send(200, {})
            if what == "wake":
                if asleep_since(s["id"]) is not None:
                    wake(s)
                else:
                    host_start(s, wake=True)    # not started since a reboot
                return self.send(200, {})
            if what == "sleep":
                lock = sleep_lock(wait=True)
                if not lock:
                    return self.error(409, "Amarchy is putting chats to sleep already: try again in a moment")
                with lock:
                    why = put_to_sleep(s)
                return self.error(409, f"It stays awake: {why}") if why else self.send(200, {})
            if what == "close":
                # Uncommitted work goes only when the phone said so, having
                # been told about it (app_closing); else it asks again.
                closing = app_closing(s)
                if closing["changes"] and data.get("discard") is not True:
                    return self.send(409, {"error": "It has uncommitted changes", **closing})
                # Its preview stopped and checked gone first: what's left, its Claude stops.
                left = preview_close(s)
                if left:
                    return self.send(409, {"error": "Its preview is still running", "preview_left": left, **closing})
                r = run_amarchy("close", s["id"], *(["--force"] if closing["changes"] else []), timeout=150)
                return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            if what == "priority":
                level = data.get("level")
                if level not in PRIORITIES:
                    return self.error(400, "high, normal or low")
                r = run_amarchy("priority", level, "--id", s["id"])
                return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            if what == "send" and engine(s) == "terminal":
                # A message is the chat's: a session on Claude's classic terminal
                # comes back to the chat once it's idle, and the chat takes it.
                why = switch_engine(s, "chat")
                if why:
                    return self.error(409, why)
                s = session(s["id"]) or s
            st.looking(s["id"])
            screen = app_screen(s)
            if screen["waking"]:
                # On its way back: what's sent waits for its prompt.
                end = time.time() + 30
                while screen["waking"] and time.time() < end:
                    time.sleep(0.3)
                    screen = app_screen(s)
                if screen["waking"]:
                    return self.error(409, "Claude is still waking up: try again in a moment")
                time.sleep(0.5)     # its first screen drawn
                screen = app_screen(s)
            if engine(s) == "chat":
                return self.chat_input(s, what, data, screen)
            # Claude's classic terminal: its keys (the keys row: arrows, Enter, Esc, 1 2 3) go to its pane.
            keys = data.get("keys")
            if not valid_keys(keys):
                return self.error(400, "keys it doesn't send")
            if screen["asleep"]:
                wake(s)
                return self.error(409, "It was asleep: Claude is waking up, try again in a moment")
            why = app_keys(s, keys)
            st.seen[s["id"]] = time.time()
            return self.send(200, {}) if why is None else self.error(500, why)

        # ---- the chat engine (phase A2 of docs/plan-chat-app.md)

        def chat(self, s, what, data):
            """A session on the chat engine: answer what Claude asks
            ({request_id, choice: allow|always|deny, message, answers, mode},
            or {request_id, question, answer} for one of several questions),
            Stop ({everything}: and what's queued), the model ({model}), the
            permission mode ({mode}), a queued message back ({uuid}); GET
            agent: what Claude said it has (commands, models...) and its live
            state. engine ({engine: chat|terminal}) switches any session: terminal
            is Claude's classic terminal (Show terminals on), held while classic
            (the heartbeat: what classic does every few seconds while it's open)."""
            sid = s["id"]
            if what == "engine":
                if data.get("engine") == "terminal" and not show_terminals():
                    return self.error(409, "Show terminals is off: Claude's classic terminal is under Advanced")
                why = switch_engine(s, data.get("engine"))
                return self.error(409, why) if why else self.send(200, {"ok": True, "engine": engine(session(sid) or s)})
            if what == "classic":       # the app has Claude's classic terminal open here: keep it on the TUI a while
                if engine(s) != "terminal":
                    return self.error(409, "It's not on Claude's classic terminal")
                touch_classic(sid)
                return self.send(200, {"ok": True})
            if engine(s) != "chat":
                return self.error(409, "It's on Claude's classic terminal")
            if what == "agent":
                try:
                    told = json.loads((claude_dir(sid) / "agent.json").read_text())
                except (OSError, ValueError):
                    told = {}
                return self.send(200, {"agent": told, "live": chat_live(agent_live(sid), s)})
            st.seen[sid] = time.time()
            st.looking(sid)
            if what in ("model", "effort", "mode") and not agent_up(sid):
                # Asleep: it wakes in it.
                value = data.get(what)
                if what == "mode" and value not in AGENT_MODES or what == "model" and not (
                        isinstance(value, str) and re.fullmatch(MODEL_RE, value)) \
                        or what == "effort" and not effort_choice(value):
                    return self.error(400, f"which {what}")
                agent_remember(sid, **{what: value})
                return self.send(200, {"ok": True, "later": True})
            if not agent_up(sid):
                return self.error(409, "Claude isn't running: it's asleep, or starting")
            if what == "answer":
                rid = data.get("request_id")
                if not isinstance(rid, str):
                    return self.error(400, "which request (request_id)")
                request = {"request_id": rid}
                if "question" in data:
                    request.update(question=data.get("question"), answer=data.get("answer"))
                else:
                    request.update({k: data[k] for k in ("choice", "message", "answers", "mode", "suggestions",
                                                         "annotations") if k in data})
                why = chat_answer(s, request)
                return self.error(*why) if why else self.send(200, {"ok": True})
            if what == "interrupt":
                request = {"op": "interrupt", "everything": data.get("everything") is True}
            elif what == "unqueue":
                if not isinstance(data.get("uuid"), str):
                    return self.error(400, "which message (uuid)")
                request = {"op": "unqueue", "uuid": data["uuid"]}
            elif what == "model":
                model = data.get("model")
                if not isinstance(model, str) or not re.fullmatch(MODEL_RE, model):
                    return self.error(400, "which model")
                request = {"op": "control", "request": {"subtype": "set_model", "model": model}}
            elif what == "effort":
                if not effort_choice(data.get("effort")):
                    return self.error(400, f"effort is one of {', '.join(EFFORTS)}, or auto")
                request = {"op": "effort", "effort": data["effort"]}
            else:   # mode
                if data.get("mode") not in AGENT_MODES:
                    return self.error(400, f"mode is one of {', '.join(AGENT_MODES)}")
                request = {"op": "control", "request": {"subtype": "set_permission_mode", "mode": data["mode"]}}
            try:
                r = agent_call(sid, request)
                if request["op"] == "effort" and str(r.get("error") or "").startswith("unknown op"):
                    # A broker from before efforts (it started before amarchy
                    # knew them): set on its Claude all the same, and kept.
                    r = agent_call(sid, {"op": "control", "request": {"subtype": "apply_flag_settings", "settings": {
                        "effortLevel": data["effort"] if data["effort"] in EFFORTS else None}}})
                    if r.get("ok"):
                        agent_remember(sid, effort=data["effort"])
                        r["response"] = {"effort": data["effort"]} if data["effort"] in EFFORTS else None
            except OSError as e:
                return self.error(500, f"Claude's broker didn't answer: {e}")
            if not r.get("ok"):
                return self.error(409, r.get("error") or "Claude didn't take it")
            return self.send(200, {"ok": True, **({"response": r["response"]} if r.get("response") else {})})

        def chat_input(self, s, what, data, screen):
            """/send and /keys for a session on the chat engine. send: {text,
            images: [{type, data (base64)}], when: idle (the default: once
            Claude is free) | next (into the turn under way) | now (ending
            it)}, to its broker; asleep, it wakes with it. keys: today's card
            (chat_dialog) picks an answer by its keys; Esc says no to what
            Claude asks and stops it, as in the TUI; Enter starts a Claude that
            exited; other keys are refused (the broker reads text, not keys)."""
            sid = s["id"]
            dialog = screen["dialog"]
            if what == "keys":
                keys = data.get("keys")
                if not valid_keys(keys):
                    return self.error(400, "keys it doesn't send")
                if data.get("dialog") is not None:
                    if (dialog or {}).get("id") != data["dialog"]:
                        return self.error(409, "The question changed: look again")
                    why = chat_pick(s, dialog, keys)
                elif keys == ["Escape"] and screen["live"] and not (screen["asleep"] or screen["exited"]):
                    if dialog:
                        why = chat_answer(s, {"request_id": dialog["request"], "response": {
                            "behavior": "deny", "message": "The user doesn't want to proceed with this tool use.",
                            "interrupt": True}})
                    else:
                        try:
                            r = agent_call(sid, {"op": "interrupt"})
                            why = None if r.get("ok") else (409, r.get("error") or "Claude didn't stop")
                        except OSError:
                            why = (409, "Claude isn't running")
                elif screen["asleep"]:
                    wake(s)
                    return self.error(409, "It was asleep: Claude is waking up, try again in a moment")
                elif screen["exited"]:
                    why = app_keys(s, keys)     # Enter starts the Claude that exited
                    why = (500, why) if why else None
                else:
                    # The broker reads what's typed, not keys: the classic terminal has them.
                    return self.error(409, "Keys are for the classic terminal (the app's chat takes messages)")
                st.seen[sid] = time.time()
                return self.error(*why) if why else self.send(200, {})
            text, when = data.get("text", ""), data.get("when") or "idle"
            if not isinstance(text, str) or len(text) > 60_000:
                return self.error(400, "nothing to send")
            text = text.replace("\r\n", "\n").replace("\r", "\n")
            images = chat_images(data.get("images"))
            if isinstance(images, str):
                return self.error(400, images)
            if not text.strip() and not images:
                return self.error(400, "nothing to send")
            if when not in ("idle", "next", "now"):
                return self.error(400, "when is idle, next or now")
            answer = data.get("answer") if isinstance(data.get("answer"), dict) else None
            if answer:      # in your own words, to what Claude asks (today's card)
                if (dialog or {}).get("id") != answer.get("dialog"):
                    return self.error(409, "The question changed: look again")
                why = chat_pick(s, dialog, answer.get("keys"), text)
                return self.error(*why) if why else self.send(200, {})
            if s.get("setup"):
                return self.error(409, "It's still being set up: try again in a moment")
            if screen["asleep"] or not screen["live"] or screen["exited"]:
                # It wakes with this as its first message, the images
                # attached to it.
                if starting(sid):
                    return self.error(409, "Claude is starting with another message: try again in a moment")
                if images:
                    chat_attach_later(sid, images)
                if not text.strip():
                    if screen["asleep"]:
                        wake(s)
                    elif screen["exited"]:
                        woken(sid)
                        tmux("send-keys", "-t", f"={tmux_name(sid)}:", "Enter")
                    else:
                        woken(sid)
                        host_start(s, wake=True)
                    return self.send(200, {"waking": True})
                threading.Thread(target=send_start, args=(s, text), daemon=True).start()
                return self.send(200, {"waking": True})
            end = time.time() + 30          # starting: its broker listens in a moment
            while not agent_up(sid) and time.time() < end:
                time.sleep(0.3)
            content = [*images, *([{"type": "text", "text": text}] if text.strip() else [])] if images else text
            try:
                r = agent_call(sid, {"op": "send", "content": content, "when": when})
            except OSError as e:
                return self.error(409, f"Claude isn't running yet: try again in a moment ({e})")
            if not r.get("ok"):
                return self.error(409, r.get("error") or "Claude didn't take it")
            st.seen[sid] = time.time()
            return self.send(200, {"ok": True, "uuid": r.get("uuid"), "queued": r.get("queued")})

        def sleep(self, data):
            """{"after": minutes|"off"}: how long a session idle and open
            nowhere waits before it sleeps. {"all": true}: every idle one
            open nowhere sleeps now (amarchy sleep --all)."""
            if data.get("all") is True:
                lock = sleep_lock(wait=True)
                if not lock:
                    return self.error(409, "Amarchy is putting chats to sleep already: try again in a moment")
                with lock:
                    slept, kept = sleep_all()
                return self.send(200, {"slept": len(slept), "kept": len(kept)})
            after = data.get("after")
            if after != "off" and (isinstance(after, bool) or not isinstance(after, (int, float)) or not 0 <= after <= 1440):
                return self.error(400, "minutes (0 to 1440) or off")
            write_file(SLEEP_AFTER, f"{'off' if after == 'off' else f'{after:g}'}\n")
            return self.send(200, {})

        def clip(self, data):
            """What you pasted (or copied) in a browser or on the phone: the web
            clipboard now, for wl-paste in your sessions (see "clipboard").
            {type, data (base64)} for an image, {text} for text; with
            {session, paste: true}, Claude in that session pastes it (Ctrl+V)."""
            kind, text = data.get("type"), data.get("text")
            if isinstance(text, str):
                if not text or len(text) > 1_000_000:
                    return self.error(400, "no text")
                items = [("text/plain;charset=utf-8", text.encode())]
            else:
                if not isinstance(kind, str) or not CLIP_TYPES.fullmatch(kind):
                    return self.error(400, "only an image (PNG, JPEG, GIF or WebP)")
                try:
                    raw = base64.b64decode(data.get("data") or "", validate=True)
                except (ValueError, TypeError):
                    raw = b""
                if not raw:
                    return self.error(400, "no image")
                items = [(kind, raw)]
            s = None
            if data.get("paste") is True:
                s = self.session(data.get("session")) if isinstance(data.get("session"), str) else self.error(400, "which chat")
                if not s:
                    return
                if engine(s) == "chat":
                    try:
                        web_clip_save(items)
                    except OSError as e:
                        return self.error(500, f"couldn't keep it: {e}")
                    if kind is None:
                        return self.send(200, {})       # text: the clipboard only
                    why = chat_attach(s, [{"type": kind, "data": data.get("data")}])
                    st.seen[s["id"]] = time.time()
                    return self.error(*why) if why else self.send(200, {})
                screen = app_screen(s)
                if not screen["live"] or screen["exited"]:
                    return self.error(409, "Claude isn't running: start it first")
                if screen["dialog"]:
                    return self.error(409, "Claude is asking you something: answer that first")
            try:
                web_clip_save(items)
            except OSError as e:
                return self.error(500, f"couldn't keep it: {e}")
            if s:
                r = tmux("send-keys", "-t", f"={tmux_name(s['id'])}:", "C-v")
                if r.returncode != 0:
                    return self.error(500, r.stderr.strip() or "tmux failed")
                st.seen[s["id"]] = time.time()
            return self.send(200, {})

        def desk_action(self, s, what, data):
            """What the wide layout's menus do to a session: name it, run its
            command or another one in its terminal, save one."""
            if what == "rename":
                title = data.get("title")
                if data.get("reset") is True:
                    r = run_amarchy("rename", "--id", s["id"], "--reset")
                elif isinstance(title, str) and title.strip() and len(title) <= 200:
                    r = run_amarchy("rename", "--id", s["id"], title.strip())
                else:
                    return self.error(400, "what to call it")
                return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            env = {"AMARCHY_SESSION": s["id"]}
            if what == "commands" and data.get("forget") is True:     # drop one: {name, forget}
                name = data.get("name")
                if not isinstance(name, str) or not re.fullmatch(r"[\w.-]{1,40}", name) or name == RUN_DEFAULT:
                    return self.error(400, "which command (the run command itself stays: change it instead)")
                r = run_amarchy("run", "--forget", name, env=env)
                return self.send(200, {"commands": app_commands(s)}) if r.returncode == 0 \
                    else self.error(500, gist(r.stderr or r.stdout))
            if what == "commands":       # save one: {name, command}; the run command itself is "run"
                name, command = data.get("name"), data.get("command")
                if not isinstance(name, str) or not re.fullmatch(r"[\w.-]{1,40}", name) or \
                        not isinstance(command, str) or not command.strip() or len(command) > 4000:
                    return self.error(400, "a name and a command")
                r = run_amarchy("run", *(["--set", command] if name == RUN_DEFAULT else ["--save", name, command]), env=env)
                return self.send(200, {"commands": app_commands(s)}) if r.returncode == 0 else self.error(500, gist(r.stderr))
            name = data.get("name")
            if name is not None and (not isinstance(name, str) or not re.fullmatch(r"[\w.-]{1,40}", name)):
                return self.error(400, "no such command")
            if s.get("setup"):
                return self.error(409, "It's still being set up: run it once Claude has started")
            if name in (None, RUN_DEFAULT) and not run_command(s):
                return self.send(409, {"error": "No run command for this project yet", "ask": True})
            r = run_amarchy("run", *([name] if name and name != RUN_DEFAULT else []), env=env)
            return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr or r.stdout))

        def sound(self, data):
            """The chime (amarchy sound): {name} sets it ("off" for none),
            {name, assistant: true} your assistant's; /api/sound/add takes one
            of yours, {name (its file name), data (base64)}."""
            if self.path == "/api/sound/add":
                try:
                    raw = base64.b64decode(data.get("data") or "", validate=True)
                except (ValueError, TypeError):
                    raw = b""
                name, why = app_add_sound(data.get("name") if isinstance(data.get("name"), str) else "", raw)
                return self.send(200, {"name": name, **app_sounds()}) if name else self.error(400, why)
            name = data.get("name")
            if not isinstance(name, str) or not (name == "off" or sound_key(name)):
                return self.error(400, "no such sound")
            agent = data.get("agent")
            if agent is not None and not (isinstance(agent, str) and any(a["id"] == agent for a in team())):
                return self.error(409, "It isn't one of your agents")
            r = run_amarchy("agents", agent, "--sound", name) if agent else \
                run_amarchy("sound", *(["--assistant"] if data.get("assistant") is True else []), name)
            return self.send(200, app_sounds()) if r.returncode == 0 else self.error(500, gist(r.stderr))

        def agent(self, s, what, data):
            """One of your agents (amarchy agents): /api/session/<id>/agent
            makes that session one ({name} optional), renames it ({name}), or
            makes it a chat again ({off: true}); /api/session/<id>/agent/picture
            takes its picture ({data (base64), crop: [x, y, size]}) or none
            again ({off: true}). Your assistant's too, but off (that's
            /api/session/<id>/assistant)."""
            name = data.get("name")
            if name is not None and (not isinstance(name, str) or not name.strip() or len(name.strip()) > 40):
                return self.error(400, "a name of 40 characters at most")
            ours = is_agent(s)
            if what == "agent/picture":
                if not ours:
                    return self.error(409, "It isn't one of your agents")
                if data.get("off") is True:
                    r = run_amarchy("agents", s["id"], "--picture", "off")
                else:
                    crop = data.get("crop")
                    if crop is not None and not (isinstance(crop, list) and len(crop) == 3
                                                 and all(isinstance(n, int) and n >= 0 for n in crop) and crop[2] > 0):
                        return self.error(400, "crop: x, y and size, in the picture's pixels")
                    pic = data.get("data")
                    if not isinstance(pic, str) or not pic:
                        return self.error(400, "no picture")
                    r = run_amarchy("agents", s["id"], "--picture", "-", *(["--crop", "%d,%d,%d" % tuple(crop)] if crop else []),
                                    input=pic, timeout=120)
            elif data.get("off") is True:
                if team_of(s)[0] != "agent":
                    return self.error(409, "It isn't one of your agents")
                r = run_amarchy("agents", s["id"], "off")
            else:
                r = run_amarchy("agents", s["id"], *(["--name", name.strip()] if name else []))
            return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr or r.stdout))

        def assistant(self, s, data):
            """Your assistant (amarchy assistant): /api/session/<id>/assistant
            makes that session it ({name} optional), or not ({off: true});
            /api/assistant {name} renames the one you have; /api/assistant/
            picture takes its picture ({data (base64), crop: [x, y, size]}) or
            amarchy's own again ({off: true})."""
            name = data.get("name")
            if name is not None and (not isinstance(name, str) or not name.strip() or len(name.strip()) > 40):
                return self.error(400, "a name of 40 characters at most")
            if self.path == "/api/assistant/picture":
                if data.get("off") is True:
                    r = run_amarchy("assistant", "--picture", "off")
                else:
                    crop = data.get("crop")
                    if crop is not None and not (isinstance(crop, list) and len(crop) == 3
                                                 and all(isinstance(n, int) and n >= 0 for n in crop) and crop[2] > 0):
                        return self.error(400, "crop: x, y and size, in the picture's pixels")
                    pic = data.get("data")
                    if not isinstance(pic, str) or not pic:
                        return self.error(400, "no picture")
                    r = run_amarchy("assistant", "--picture", "-", *(["--crop", "%d,%d,%d" % tuple(crop)] if crop else []),
                                    input=pic, timeout=120)
            elif s is None:
                if name is None:
                    return self.error(400, "what to call it")
                r = run_amarchy("assistant", "--name", name.strip())
            elif data.get("off") is True:
                mine = assistant()
                if not mine or mine["id"] != s["id"]:
                    return self.error(409, "It isn't your assistant")
                r = run_amarchy("assistant", "off")
            else:
                r = run_amarchy("assistant", s["id"], *(["--name", name.strip()] if name else []))
            return self.send(200, {}) if r.returncode == 0 else self.error(500, gist(r.stderr or r.stdout))

        def add(self, data):
            """A new project (the menu's New project…): a repo (owner/repo or a git URL),
            or an empty one ({new, github})."""
            repo, new = data.get("repo"), data.get("new")
            if isinstance(new, str) and re.fullmatch(r"[\w.-]{1,100}", new) and not new.startswith("-"):
                r = run_amarchy("add", "--new", new, *(["--github"] if data.get("github") is True else []), timeout=900)
            elif isinstance(repo, str) and re.fullmatch(r"[\w.@:/~+-]{1,300}", repo) and not repo.startswith("-"):
                r = run_amarchy("add", repo, timeout=900)
            else:
                return self.error(400, "which repo")
            if r.returncode != 0:
                return self.error(500, gist(r.stderr or r.stdout) or "couldn't add it")
            st.projects_stale.set()
            # (amarchy add prints its path: the project's name is its folder's.)
            where = (r.stdout.strip().splitlines() or [""])[-1]
            return self.send(200, {"name": Path(where).name if where else "", "path": where})

        def new(self, data):
            """{repo, prompt, model, effort, images: [{type, data (base64)}],
            agent}: a new chat, the pictures (a screenshot pasted) going with
            its prompt; agent: a name, and it's one of your agents from its
            start (amarchy new --agent)."""
            repo, prompt, model = data.get("repo"), data.get("prompt"), data.get("model")
            if not isinstance(repo, str) or repo not in {p["name"] for p in st.view.get("projects", [])} \
                    and repo not in {p["name"] for p in projects()}:      # one just added: not in the list yet
                return self.error(400, "no such project")
            # The model the new chat's pill shows (else the default: new_model).
            if model is not None and not (isinstance(model, str) and re.fullmatch(MODEL_RE, model)):
                return self.error(400, "which model")
            on = ["--model", model] if model else []
            effort = data.get("effort")
            if effort is not None and not effort_choice(effort):
                return self.error(400, "which effort")
            on += ["--effort", effort] if effort else []
            named = data.get("name")        # (amarchy new <project> <name> --on, from another machine)
            if named is not None and not (isinstance(named, str) and re.fullmatch(r"[\w.-]{1,60}", named) and not named.startswith("-")):
                return self.error(400, "a chat's name: letters, digits, . _ -")
            agent = data.get("agent")
            if agent is not None:
                if not isinstance(agent, str) or not agent.strip() or len(agent.strip()) > 40:
                    return self.error(400, "what to call the agent (40 characters at most)")
                on += ["--agent", agent.strip()]
            images = chat_images(data.get("images"))
            if isinstance(images, str):
                return self.error(400, images)
            # Without a prompt when it's to be dictated, once it's up.
            if prompt is None or isinstance(prompt, str) and not prompt.strip():
                if images:
                    return self.error(400, "say what it's for: the pictures go with it")
                r = run_amarchy("new", repo, *([named] if named else []), *on, timeout=300)
            elif not isinstance(prompt, str) or len(prompt) > 60_000:
                return self.error(400, "say what it's for")
            else:
                # The pictures as files for `amarchy new --attach`, gone once it has them.
                with tempfile.TemporaryDirectory(prefix="amarchy-new-") as tmp:
                    attach = []
                    for i, b in enumerate(images):
                        ext = next(e for e, t in PICTURE_TYPES.items() if t == b["source"]["media_type"])
                        f = Path(tmp) / f"{i + 1}{ext}"
                        f.write_bytes(base64.b64decode(b["source"]["data"]))
                        attach += ["--attach", str(f)]
                    r = run_amarchy("new", repo, *([named] if named else []), *on, "--prompt", "-", *attach, input=prompt, timeout=300)
            sid = (r.stdout.strip().splitlines() or [""])[-1]
            if r.returncode != 0 or not sid:
                return self.error(500, gist(r.stderr) or "couldn't start it")
            # Once the list has it (app_watch reads it now), so the page that
            # asked has its card as it hears back.
            st.poke.set()
            until = time.time() + 5
            with st.changed:
                while st.row(sid) is None and time.time() < until:
                    st.changed.wait(until - time.time())
            return self.send(200, {"id": sid})

        def read_body(self, limit):
            """The request's body as it came (with a Content-Length, or
            chunked), or None when it's over limit bytes."""
            if "chunked" in self.headers.get("Transfer-Encoding", "").lower():
                parts, size = [], 0
                while True:
                    try:
                        n = int(self.rfile.readline(100).split(b";")[0].strip() or b"0", 16)
                    except ValueError:
                        return b""
                    if n == 0:
                        self.rfile.readline(100)
                        return b"".join(parts)
                    size += n
                    if size > limit:
                        return None
                    parts.append(self.rfile.read(n))
                    self.rfile.readline(100)
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                return b""
            return None if n > limit else self.rfile.read(n) if n > 0 else b""

        def share_in(self):
            """POST /api/share: something shared into amarchy (see "sharing
            into amarchy"). From a browser, only one of its own doing: the
            app's pages or Android's share sheet (Sec-Fetch-Site same-origin,
            or none: no page asked for it), never a page elsewhere. From
            anything else (an iPhone's Shortcut: it says nothing of where it
            comes from), only at the address with the share key. To Android's
            share sheet the app's page; to the Shortcut a line it can show."""
            if not self.allowed():
                return
            args = urllib.parse.parse_qs(self.path.partition("?")[2])
            site = self.headers.get("Sec-Fetch-Site")
            key = (args.get("key") or [""])[0]
            if site not in ("same-origin", "none") and (site is not None or not hmac.compare_digest(key.encode(), share_key().encode())):
                return self.error(403, "only from your share sheet: Settings, Share to Amarchy, has the address")
            body = self.read_body(SHARE_BODY_MAX)
            if body is None:
                return self.error(413, "too big: 60 MB at most")
            if not body:
                return self.error(400, "nothing came")
            images, text = share_parse(self.headers.get("Content-Type", ""), body)
            text = "\n".join(x for x in (text, *(args.get("text") or [])) if x.strip())
            why = share_add(images, text)
            if self.headers.get("Sec-Fetch-Mode") == "navigate":       # Android's share sheet opened the app with it
                self.head(303, "text/plain", [("Location", "/" if not why else f"/?share-error={urllib.parse.quote(why)}"),
                                              ("Content-Length", "0")])
                return self.end_headers()
            if why:
                return self.error(400, why)
            n = share_state()["pictures"] if share_state() else 0
            return self.send(200, {"ok": True, "pictures": n,
                                   "said": "In Amarchy: open it, and pick the chat to send it to"})

        def push(self, data):
            if self.path == "/api/push/test":
                # The desktop apps ring your chime with it, as with a chat's
                # (a phone's rings with its own sound).
                chime = sound_name()
                n = push_all({"title": "Amarchy", "body": "Notifications work.", "tag": "amarchy-test", "url": "/"},
                             {"sound": chime} if chime != "off" else None)
                return self.send(200, {"sent": n})
            endpoint = data.get("endpoint")
            if not isinstance(endpoint, str) or not endpoint.startswith("https://"):
                return self.error(400, "not a push subscription")
            if self.path == "/api/push/remove":
                for sub in app_subscriptions():
                    if sub["endpoint"] == endpoint:
                        push_log("off", sub, "turned off on that device (Settings, or the browser took its permission back)")
                app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] != endpoint])
                return self.send(200, {})
            # One its push service ended: not kept (nothing sent to it would
            # arrive). That device makes a new one (app.js's pushRefresh).
            if endpoint in push_gone():
                return self.send(200, {"gone": True})
            keys = data.get("keys") if isinstance(data.get("keys"), dict) else {}
            try:
                if len(unb64u(keys["p256dh"])) != 65 or len(unb64u(keys["auth"])) != 16:
                    raise ValueError
            except (KeyError, ValueError, TypeError):
                return self.error(400, "not a push subscription")
            sub = {"endpoint": endpoint, "keys": {"p256dh": keys["p256dh"], "auth": keys["auth"]},
                   "added": int(time.time()), "device": str(self.headers.get("User-Agent", ""))[:200]}
            phone = phone_app(data.get("app"))      # a phone app's (see "the phone apps"): where its buttons go
            if phone:
                host = self.headers.get("Host", "")
                if self.via != "tailscale" or not re.fullmatch(r"[A-Za-z0-9.-]+(:\d{1,5})?", host):
                    return self.error(400, "a phone app registers through its machine's address on the tailnet")
                sub.update(app=phone, server=f"https://{host}")
            if not any(s["endpoint"] == endpoint for s in app_subscriptions()):
                push_log("on", sub)
            app_save_subscriptions(lambda subs: [s for s in subs if s["endpoint"] != endpoint] + [sub])
            return self.send(200, {})

    return Handler


def run_amarchy(*args, input=None, timeout=60, env=None):
    try:
        return subprocess.run([sys.executable, SELF, *args], capture_output=True, text=True, input=input,
                              stdin=None if input is not None else subprocess.DEVNULL, timeout=timeout,
                              env={**clean_env(), **(env or {})})
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(args, 1, "", str(e))


def app_server_class():
    """The app's server: a thread for each connection, and room for a page's
    burst of them. A page asks for its ~25 files at once, and each is a
    connection of its own (tailscale serve to here): with the default five
    waiting at most, the rest were refused and asked again a second later,
    a page that took a second and a half to come, a chat to open."""
    import http.server

    class AppServer(http.server.ThreadingHTTPServer):
        request_queue_size = 256
        daemon_threads = True
    return AppServer


LINKS_PORT = 7398                           # on the host's own address; APP_LINKS= in ~/.config/amarchy/host
_links_out = None                           # http://<address>:<port>/<token>/ once it listens (this process: the app's)


def links_token():
    """What a link out carries, so only the app's own pages get a link sent
    on: from the app's key, so it stays the same across restarts (a page
    loaded before one still opens its links)."""
    import hashlib
    return hashlib.sha256(app_key().read_bytes() + b"links-out").hexdigest()[:32]


def links_out(url):
    """A link out, as a Mac's Dock app opens it: this machine's address for
    it, which sends the browser on to it. None when that isn't listening."""
    if not _links_out or not re.match(r"https?://", url or "", re.I):
        return None
    return _links_out + url.encode().hex()


def links_handler(token):
    """What sends a Mac's links on: GET /<token>/<the address, in hex> answers
    with the address to go to. A Mac's Dock app (Safari's Add to Dock) keeps
    for itself a link that reads like a sign-in page (…/login) and one to a
    name like the app's own, whatever is done with it; one to a plain number
    address it gives to the default browser. So there every link out goes to
    this one, which reads like nothing (hex), and the browser is sent on."""
    import http.server

    class Links(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *args):
            pass

        def answer(self, code, headers=()):
            self.send_response(code)
            for k, v in headers:
                self.send_header(k, v)
            self.send_header("Content-Length", "0")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Referrer-Policy", "no-referrer")
            self.end_headers()

        def do_GET(self):
            m = re.fullmatch(r"/([0-9a-f]+)/([0-9a-f]{2,8000})", self.path)
            url = None
            if m and hmac.compare_digest(m.group(1), token):
                try:
                    url = bytes.fromhex(m.group(2)).decode()
                except ValueError:
                    url = None
            if not url or not re.fullmatch(r"https?://[^\s\x00-\x1f\x7f]+", url, re.I):
                return self.answer(404)
            self.answer(302, [("Location", urllib.parse.quote(url, safe="%/:=&?~#+!$,;'@()*[]"))])

        do_HEAD = do_GET
    return Links


def links_serve():
    """Listen for a Mac's links out, on this machine's own address (your
    tailnet only). Not listening (no address, the port taken): the app opens
    them as it did."""
    global _links_out
    bind = host_network()[1]
    if not bind or host_setting("APP_LINKS") == "off":
        return None
    try:
        port = int(host_setting("APP_LINKS") or LINKS_PORT)
    except ValueError:
        port = LINKS_PORT
    token = links_token()
    try:
        server = app_server_class()((bind, port), links_handler(token))
    except OSError as e:
        print(f"amarchy app: links out aren't sent on ({bind}:{port}: {e})", file=sys.stderr, flush=True)
        return None
    threading.Thread(target=server.serve_forever, daemon=True).start()
    _links_out = f"http://{bind}:{server.server_address[1]}/{token}/"
    return server


APP_TAILNET = APP / "tailnet.json"      # the app's address and logins on the tailnet, as Tailscale last said


def tailnet_last(address=None, users=None):
    """Kept (address and users given), or as last kept: {address, users}."""
    if address and users:
        try:
            write_file(APP_TAILNET, json.dumps({"address": address, "users": sorted(users), "at": int(time.time())}))
        except OSError:
            pass
        return {}
    try:
        kept = json.loads(APP_TAILNET.read_text())
        return kept if isinstance(kept, dict) else {}
    except (OSError, ValueError):
        return {}


def app_serve():
    """Run the app's server (what amarchy-app.service runs) until amarchy is
    updated, when systemd starts the new one."""
    import http.server
    status = tailscale_status()
    address, users = app_address(status), app_users(status)
    # Tailscale logged out for a moment (signing in again, a move to another
    # tailnet): who and where it last said, until it says again.
    if not (address and users):
        last = tailnet_last()
        address, users = address or last.get("address"), users or set(last.get("users") or [])
    else:
        tailnet_last(address, users)
    # Without Tailscale (not set up yet, or offline) it still serves the
    # desktop app here (the local key), and takes the tailnet once it's up.
    if not address:
        print("amarchy app: this machine isn't on Tailscale (or Tailscale isn't up): only the desktop app here "
              "gets in until it is", file=sys.stderr, flush=True)
    elif not users:
        print("amarchy app: couldn't tell who owns this machine on Tailscale: set APP_USERS=<your login> "
              f"in {HOST_CONFIG} (until then, only the desktop app here gets in)", file=sys.stderr, flush=True)
    app_key()
    local_key()
    migrate()
    st = AppState()
    st.transcriber = Transcriber()      # dictation on the host
    handler = app_handler(st, users, address)
    server = app_server_class()(("127.0.0.1", app_port()), handler)
    links_serve()                       # a Mac's links out (see links_handler)

    def tailnet():
        """Tailscale came up after the server started, or this machine moved
        to another tailnet (its address, its owner): followed."""
        while True:
            time.sleep(15 if not handler.net["address"] else 60)
            now = tailscale_status()
            found, who = app_address(now), app_users(now)
            if found and who and (found, who) != (handler.net["address"], handler.net["users"]):
                handler.net.update(address=found, users=who)
                tailnet_last(found, who)
                print(f"amarchy app: on the tailnet as {app_url(found)}, for {', '.join(sorted(who))}", file=sys.stderr, flush=True)

    threading.Thread(target=tailnet, daemon=True).start()
    st.peers = Peers(st)                # every paired machine's chats on the board (see "machines")
    st.peers.start()
    st.sync = Sync(st)                  # your stuff the same on every machine (see "your stuff on every machine")
    st.sync.start()
    threading.Thread(target=outbox_tend, args=(st,), daemon=True).start()     # what waits for a machine, sent once it's back
    threading.Thread(target=app_watch, args=(st,), daemon=True).start()
    threading.Thread(target=search_warm, args=(st,), daemon=True).start()     # Tasks' search, ready
    threading.Thread(target=app_merges, args=(st,), daemon=True).start()      # each chat's merges: your score
    threading.Thread(target=move_tend_loop, args=(st,), daemon=True).start()  # moves cut short (see "moving a chat")
    version = os.stat(SELF).st_mtime_ns

    def updated():
        while True:
            time.sleep(2)
            try:
                if os.stat(SELF).st_mtime_ns != version:
                    break
            except OSError:
                pass
        server.shutdown()

    threading.Thread(target=updated, daemon=True).start()
    where = f"{app_url(address)} for {', '.join(sorted(users))}" if address and users else "this machine only"
    print(f"amarchy app: {where} (on 127.0.0.1:{app_port()}; the desktop app here: its local key, {LOCAL_KEY})",
          file=sys.stderr, flush=True)
    server.serve_forever()
    return 0


def app_unit():
    return f"""[Unit]
Description=amarchy app: your sessions on your phone and in your browser, on your tailnet
After=network-online.target tailscaled.service

[Service]
ExecStart={ENTRY} app serve
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
"""


def serve_config():
    """What tailscale serve proxies the app's HTTPS port to, or None."""
    try:
        conf = json.loads(sh("tailscale", "serve", "status", "--json").stdout or "{}")
    except ValueError:
        return None
    for hostport, web in (conf.get("Web") or {}).items():
        if hostport.endswith(f":{app_https()}"):
            return ((web.get("Handlers") or {}).get("/") or {}).get("Proxy")
    return None


def app_service_on():
    """The app's server running, now and after every reboot (on 127.0.0.1
    only: the desktop app here needs no more). Else why not."""
    app_key()
    local_key()
    UNITS.mkdir(parents=True, exist_ok=True)
    unit = UNITS / APP_UNIT
    if not unit.exists() or unit.read_text() != app_unit():
        write_file(unit, app_unit())
        sh("systemctl", "--user", "daemon-reload")
    r = sh("systemctl", "--user", "enable", "--now", APP_UNIT)
    if r.returncode != 0:
        return f"couldn't start {APP_UNIT}: {gist(r.stderr)}"
    sh("systemctl", "--user", "restart", APP_UNIT)
    return None


def app_on():
    """The app's server on, now and after every reboot, then on the tailnet
    (tailscale serve). The server runs whatever the tailnet's state (the
    desktop app here needs only it); what's missing for the tailnet is said,
    and the exit is 1 until it's there."""
    status = tailscale_status()
    address = app_address(status)
    why = app_service_on()
    if why:
        return fail(why)
    here = f"on, for this machine (the desktop app here, on 127.0.0.1:{app_port()})"
    if not tailscale_here() or not address:
        # The desktop app here works without it (the local key); a phone needs the tailnet.
        if tailnet_own():       # amarchy's own Tailscale node, not signed in yet (track H)
            print(f"{here}. For your phone and other machines: sign in to Tailscale (amarchy-tailnet login), "
                  f"then amarchy app on again")
        else:
            print(f"{here}. For your phone and other machines: install Tailscale and run `sudo tailscale up`, "
                  f"then amarchy app on again")
        return 0
    if not status.get("CertDomains"):
        return fail(f"{here}, but not on your tailnet yet: Tailscale has no HTTPS certificates for it. Turn them on at "
                    "https://login.tailscale.com/admin/dns (HTTPS Certificates), then run this again")
    if not app_users(status):
        return fail(f"{here}, but not on your tailnet yet: couldn't tell who owns this machine on Tailscale. "
                    f"Set APP_USERS=<your login> in {HOST_CONFIG}, then run this again")
    target = f"http://127.0.0.1:{app_port()}"
    taken = serve_config()
    if taken and taken != target:
        return fail(f"{here}, but not on your tailnet yet: tailscale serve already sends port {app_https()} to {taken}. "
                    f"Set APP_HTTPS=8443 in {HOST_CONFIG} to put the app on another port, then run this again")
    if taken != target:
        r = sh("tailscale", "serve", "--bg", f"--https={app_https()}", target)
        if r.returncode != 0:
            why = gist(r.stderr or r.stdout)
            if "access denied" in (r.stderr + r.stdout).lower():
                why = "Tailscale won't let you change it: run `sudo tailscale set --operator=$USER` once, then this again"
            return fail(f"{here}, but couldn't serve it on your tailnet: {why}")
    print(app_url(address))
    # A server, with no desktop session of yours: logging out stops it unless
    # it lingers. (On a desktop you log out of, its chats ending with it is
    # what any app does.)
    desktop = any(os.environ.get(k) for k in ("WAYLAND_DISPLAY", "DISPLAY", "XDG_CURRENT_DESKTOP"))
    if not desktop and sh("loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger").stdout.strip() == "Linger=no":
        print("  Note: it stops when you log out of this machine. `sudo loginctl enable-linger $USER` keeps it running.")
    paired = machines_read()
    if paired:
        # Your phone has a board already (another machine's): this one's chats are on it.
        names = ", ".join(m["label"] for m in paired)
        print(f"  Paired with {names}: this machine's chats are on {'their boards' if len(paired) > 1 else 'its board'}, "
              f"on your phone too (amarchy machines)")
    else:
        print("  On your phone (on your tailnet): open it in Safari, then Share → Add to Home Screen.\n"
              "  Open it from the home screen and turn on notifications there. Another machine of yours running\n"
              "  amarchy: pair them instead (amarchy machines add <name>), and its board has this one's chats.")
    return 0


def app_off():
    if serve_config() == f"http://127.0.0.1:{app_port()}":
        sh("tailscale", "serve", f"--https={app_https()}", "off")
    sh("systemctl", "--user", "disable", "--now", APP_UNIT)
    (UNITS / APP_UNIT).unlink(missing_ok=True)
    sh("systemctl", "--user", "daemon-reload")
    print("off: the app is no longer served (your phones keep it, and it works again with `amarchy app on`)")
    return 0


def app_status():
    running = sh("systemctl", "--user", "is-active", APP_UNIT).stdout.strip() == "active"
    served = serve_config() == f"http://127.0.0.1:{app_port()}"
    address = app_address()
    subs = app_subscriptions()
    phones = len(subs)
    apps = sum(1 for x in subs if isinstance(x.get("app"), dict))     # the phone apps among them (see "the phone apps")
    if not running and not served:
        print("off (amarchy app on starts it)")
        return 1
    where = app_url(address) if address and served else \
        "this machine only (the desktop app here): not on your tailnet (amarchy app on)"
    print(f"{'on' if running else 'stopped'}: {where}, {phones} phone{'' if phones == 1 else 's'} notified"
          + (f" ({apps} through the phone app{'' if apps == 1 else 's'})" if apps else ""))
    return 0 if running and served else 1


def cmd_app(args):
    """amarchy app [on|off|--status|--test|serve]."""
    what = args[0] if args else "--status"
    if what == "serve":
        return app_serve()
    if what == "on":
        return app_on()
    if what == "off":
        return app_off()
    if what == "--test":
        if not notified_anywhere():
            return fail("no phone has turned on notifications yet (in the app: the gear, then Turn on notifications)")
        n = push_all({"title": "Amarchy", "body": "Notifications work.", "tag": "amarchy-test", "url": "/"})
        print(f"sent to {n} of {len(app_subscriptions()) + desktops_listening()}")
        return 0 if n else 1
    if what == "--status":
        return app_status()
    return fail("usage: amarchy app [on|off|--status|--test]")


# ------------------------------------------------------------------ send and notify
#
# What a script or another agent does as you would from the phone: a message
# for a session's Claude (a timer waking an assistant for a check-in), a
# notification on your phones.
#
# A message waits its turn in the session's queue (a file each, oldest first),
# so two senders never type into one prompt at once and messages arrive in
# the order they were sent. It's typed, as the phone types one, once Claude is
# free: up, at its prompt, not in the middle of a turn (Claude Code would hand
# it to the turn under way, between two of its steps) and not asking you
# anything (it would answer the question). Something you're typing in its
# prompt goes first if it sits still, and is back in the prompt after. A
# Claude asleep or exited starts again with it as its first message, the way
# Enter does in its asleep terminal.

SEND_TIMEOUT = 60       # minutes a message waits for Claude to be free, unless told otherwise
SEND_START = 180        # seconds a Claude asleep or exited has to come back and take one


def send_queue(sid):
    return claude_dir(sid) / "queue"


def send_entry(f):
    try:
        d = json.loads(f.read_text())
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) and isinstance(d.get("text"), str) else None


def send_turn(f):
    """Whether it's this message's turn: the oldest in its queue, once the
    ones whose sender is gone are dropped. None when it's gone itself."""
    for g in sorted(f.parent.glob("[0-9]*")):
        if g == f:
            return True
        pid = (send_entry(g) or {}).get("pid")
        if not isinstance(pid, int) or not Path(f"/proc/{pid}").exists():
            g.unlink(missing_ok=True)
            continue
        return False
    return None


def starting(sid):
    """Whether the session's Claude is starting with a message: one left for
    it to take, lately. One that's sat there longer is gone: Claude, up by
    now, never took it."""
    try:
        return time.time() - (claude_dir(sid) / "send").stat().st_mtime < SEND_START
    except OSError:
        return False


def send_start(s, text, mine=True):
    """Start the session's Claude (asleep, exited or not running) with text
    as its first message. None once it took it, else why not. mine: yours;
    else a script's, a timer's or another chat's (amarchy send)."""
    sid = s["id"]
    d = claude_dir(sid)
    since = time.time()
    # You wrote to it: what it did before is seen. (The list says it's working
    # while this waits for its Claude: should that never come, it's idle
    # again, and not "done" a second time.) A timer waking it isn't you: what
    # you haven't read stays unread, and it wakes unseen (quiet_waking) until
    # it has something to say (turn_hold).
    if mine:
        mark_seen(sid)
        (d / "send-quiet").unlink(missing_ok=True)
    else:
        write_file(d / "send-quiet", "")
    write_file(d / "send", text)
    if asleep_since(sid) is not None:
        wake(s)
    elif tmux_has(tmux_name(sid)):
        woken(sid)
        tmux("send-keys", "-t", f"={tmux_name(sid)}:", "Enter")     # it exited: Enter starts it again
    else:
        woken(sid)
        host_start(s, wake=True)
    return send_started(sid, text, since)


def send_taken(sid, since):
    """Whether the session's Claude took a message typed at `since`: it
    started a turn on it."""
    try:
        f = STATUS / sid
        return f.stat().st_mtime >= since - 0.5 and f.read_text().strip() == "working"
    except OSError:
        return False


def send_started(sid, text, since):
    """Wait for a Claude started with text (send_start) to take it. None once
    it did, else why not."""
    d = claude_dir(sid)
    # Taken once its Claude starts on it: the next message waits for that
    # turn instead of landing in a Claude still starting up.
    end = time.time() + SEND_START
    while time.time() < end:
        if send_taken(sid, since):
            return None
        time.sleep(0.3)
    try:
        if (d / "send").read_text() == text:
            (d / "send").unlink()
            (d / "send-quiet").unlink(missing_ok=True)
            return "its Claude didn't start"
    except OSError:
        pass
    return None     # it started with it, and hasn't said it's working on it (a /command)


def send_deliver(sid, text, deadline, mine=False):
    """Deliver a message to the session's Claude once it's free (see above).
    None once Claude has it, else why not. mine: yours (a button of yours),
    not a script's, a timer's or another chat's."""
    wait = ""
    while True:
        s = session(sid)
        if not s and moved_to(sid):
            # It moved to another machine while this waited: it goes on there.
            to = moved_to(sid)
            r = run_amarchy("send", to, "-", "--no-wait", input=text, env={"AMARCHY_SESSION": os.environ.get("AMARCHY_SESSION", ""),
                                                                            **({"AMARCHY_SENT_BY": "you"} if mine else {})})
            return None if r.returncode == 0 else f"it moved to {to}, and sending it there failed: {gist(r.stderr)}"
        if not s or (CLOSING / f"{sid}.json").exists():
            return "the session was closed"
        if move_holds(sid):
            wait = "it's moving to another machine"
            time.sleep(1)
            continue
        if time.time() > deadline:
            return f"its Claude wasn't free in time ({wait})"
        if s.get("setup"):
            wait = "it's being set up"
        elif engine(s) == "terminal":
            # A message is the chat's: a session on Claude's classic terminal goes back
            # to the chat once it's idle (switch_engine), and the chat delivers it.
            why = switch_engine(s, "chat")
            if why is None:
                continue
            wait = why
        elif asleep_since(sid) is None:
            # The broker takes it (or is starting up): its Claude exited, Enter starts it again.
            if agent_up(sid):
                try:
                    answer = agent_call(sid, {"op": "send", "content": text})
                except OSError as e:
                    answer = {"ok": False, "error": str(e)}
                if answer.get("ok"):
                    return None     # the broker has it, and gives it to Claude once it's free
                wait = answer.get("error") or "its broker didn't take it"
            elif asleep_if_gone(s):
                continue        # its tmux went with a restart: asleep, it wakes with the message
            else:
                pane = host_pane(s)
                if pane and pane_claude(pane, processes()) is None and not starting(sid):
                    return send_start(s, text, mine)
                wait = "its Claude is starting up"
        elif starting(sid):
            wait = "its Claude is starting with another message"
        elif waking_now(sid):
            wait = "its Claude is waking up"
        else:
            return send_start(s, text, mine)        # asleep: it wakes with the message
        time.sleep(0.5)


def send_run(sid, f, deadline):
    """Deliver the message in queue file f, in its turn, and drop it."""
    try:
        entry = send_entry(f)
        text, mine = entry["text"], entry.get("mine") is True
        while True:
            turn = send_turn(f)
            if turn is None:
                return fail(f"{sid}: the message left the queue unsent")
            if turn:
                break
            if time.time() > deadline:
                return fail(f"{sid}: not sent: messages sent before it were still waiting")
            time.sleep(0.5)
        why = send_deliver(sid, text, deadline, mine)
    finally:
        f.unlink(missing_ok=True)
    if why:
        return fail(f"{sid}: not sent: {why}")
    print(f"sent to {sid}")
    return 0


def send_later(sid, f):
    """Deliver queue file f from a process of its own, which outlives this
    one (and the unit it may run in: amarchy send --no-wait from a timer)."""
    argv = [sys.executable, SELF, "send", sid, "--queued", str(f)]
    started = False
    if shutil.which("systemd-run"):
        keep = ("PATH", "XDG_STATE_HOME", "XDG_CONFIG_HOME", "XDG_RUNTIME_DIR", "AMARCHY_WORK",
                "AMARCHY_WORKTREES")
        r = sh("systemd-run", "--user", "--quiet", "--collect", f"--unit=amarchy-send-{time.time_ns()}",
               f"--description=amarchy send {sid}",
               *(f"--setenv={k}={os.environ[k]}" for k in keep if k in os.environ), *argv)
        started = r.returncode == 0
    if not started:
        detach(argv)
    # It's ours until that process takes it: a queue drops a message whose sender is gone.
    end = time.time() + 15
    while time.time() < end:
        if (send_entry(f) or {}).get("pid") != os.getpid():
            return True
        time.sleep(0.1)
    f.unlink(missing_ok=True)
    return False


def cmd_send(args):
    """amarchy send <id> <text|-> [--no-wait] [--timeout <minutes>]. --queued
    <file> is the process --no-wait leaves to deliver it."""
    wait, minutes, queued, rest = True, SEND_TIMEOUT, None, []
    it = iter(args)
    for a in it:
        if a == "--no-wait":
            wait = False
        elif a == "--timeout":
            try:
                minutes = float(next(it, ""))
                if minutes <= 0:
                    raise ValueError
            except ValueError:
                return fail("--timeout takes the minutes a message may wait, e.g. --timeout 30")
        elif a == "--queued":
            queued = Path(next(it, ""))
        else:
            rest.append(a)
    if queued:
        entry = send_entry(queued)
        if not entry or len(rest) != 1:
            return fail("send --queued: no such message")
        entry["pid"] = os.getpid()
        write_file(queued, json.dumps(entry))
        return send_run(rest[0], queued, entry.get("deadline") or time.time() + SEND_TIMEOUT * 60)
    if len(rest) != 2:
        print(usage("send"), file=sys.stderr)
        return 1
    sid, text = rest
    if text == "-":
        text = sys.stdin.read()
    text = text.replace("\r\n", "\n").replace("\r", "\n").strip("\n")
    if not text.strip():
        return fail("nothing to send")
    where, _, local = sid.rpartition(":")
    if where and where != machine_name():
        return send_on(where, local, text)
    sid = local
    # Moving to another machine: it goes there once it's moved (or here, if it didn't).
    end = time.time() + 600
    while session(sid) and move_holds(sid) and time.time() < end:
        time.sleep(1)
    if not session(sid):
        to = moved_to(sid)
        if to:
            print(f"{sid} moved to {to}: sent there", file=sys.stderr)
            return send_on(*to.split(":", 1), text)
        return fail(f"No session {sid!r}")
    # From the session's own Claude, waiting would wait on itself: its turn
    # is the one running.
    if wait and sid == os.environ.get("AMARCHY_SESSION"):
        wait = False
    deadline = time.time() + minutes * 60
    # Not you (a script, a timer, another chat), unless it's a button of
    # yours (task_press): your assistant's and your agents' chats show it
    # apart from what you said (app_items "from").
    mine = os.environ.get("AMARCHY_SENT_BY") == "you"
    if not mine:
        sent_by_note(sid, text, os.environ.get("AMARCHY_SESSION", ""), deadline)
    f = send_queue(sid) / f"{time.time_ns()}-{os.getpid()}"
    write_file(f, json.dumps({"pid": os.getpid(), "text": text, "deadline": deadline, "mine": mine}))
    if wait:
        return send_run(sid, f, deadline)
    if not send_later(sid, f):
        return fail(f"{sid}: couldn't start what delivers it")
    print(f"queued for {sid}: its Claude gets it once it's free")
    return 0


def send_on(name, sid, text):
    """amarchy send <machine>:<id>: the message to a chat on another machine
    of yours, handed to amarchy send there (/api/peer/send): it wakes the
    chat for it and delivers it once its Claude is free, as a message from
    a script or another chat (from this one, here). Doesn't wait."""
    m = machine_find(name)
    if not m:
        return fail(f"no machine {name} is paired with this one (amarchy machines lists them)")
    me = os.environ.get("AMARCHY_SESSION")
    try:
        status, d = peer_json(m, "POST", "/api/peer/send", {"id": sid, "text": text,
                                                            "from": (me if ":" in me else f"{machine_name()}:{me}") if me else "",
                                                            "you": os.environ.get("AMARCHY_SENT_BY") == "you"}, timeout=60)
    except PeerError as e:
        return fail(f"{m['label']} is off: {e}")
    if status != 200:
        return fail(d.get("error") or f"{m['label']} said no ({status})")
    print(f"queued for {name}:{sid}: its Claude gets it once it's free")
    return 0


SENT_BY_KEPT = 300      # what amarchy send sent each session, remembered (the newest)


def sent_hash(text):
    """A message's words, whatever spacing they arrive with, as a short key."""
    return hashlib.sha1(" ".join(str(text or "").split()).encode()).hexdigest()[:16]


def sent_by_note(sid, text, origin, deadline=None):
    """amarchy send sent a session text, not you: from origin (the session
    it ran in), or a script or timer (""); deadline: when it stops waiting
    for Claude to be free (sent_by_taken)."""
    try:
        SENT_BY.mkdir(parents=True, exist_ok=True)
        f = SENT_BY / f"{sid}.jsonl"
        with open(f, "a") as fh:
            fh.write(json.dumps({"at": time.time(), "hash": sent_hash(text),
                                 # (another machine's chat: <machine>:<id>, as the board keys it)
                                 "from": origin if origin and (session(origin) or re.fullmatch(r"[\w.-]+:[\w.-]+", origin))
                                 and origin != sid else "",
                                 **({"until": round(deadline)} if deadline else {})}) + "\n")
        if f.stat().st_size > SENT_BY_KEPT * 200:
            lines = f.read_text().splitlines()[-SENT_BY_KEPT:]
            write_file(f, "\n".join(lines) + "\n")
    except OSError:
        pass


_sent_by = {}


def sent_by_read(sid):
    """What amarchy send sent a session, not you: [{at, hash, from}], oldest first."""
    f = SENT_BY / f"{sid}.jsonl"
    try:
        stamp = f.stat().st_mtime_ns
    except OSError:
        return []
    if _sent_by.get(sid, (None,))[0] == stamp:
        return _sent_by[sid][1]
    out = []
    try:
        for line in f.read_text().splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if isinstance(e, dict) and isinstance(e.get("at"), (int, float)) and isinstance(e.get("hash"), str):
                out.append(e)
    except OSError:
        return []
    _sent_by[sid] = (stamp, out)
    return out


def sent_by_taken(sid, text, taken):
    """Whether text, reaching the session's Claude now, is what amarchy send
    sent it (sent_by_note: a script's, a timer's, another chat's), not yours:
    the newest note of those words still waiting (its until, else
    SEND_TIMEOUT from when it was sent) that isn't taken yet (taken: what
    the broker matched already, a set it keeps), which it takes."""
    key, now = sent_hash(text), time.time()
    for e in reversed(sent_by_read(sid)):
        mark = (e["at"], e["hash"])
        until = e.get("until") if isinstance(e.get("until"), (int, float)) else e["at"] + SEND_TIMEOUT * 60
        if e["hash"] == key and mark not in taken and e["at"] - 5 <= now <= until + SEND_START + 60:
            taken.add(mark)
            return True
    return False


# ---- quiet turns: what a timer, a script or another chat started, that
# ended with nothing for you to see
#
# A turn's Claude ends with SILENT (NO_REPLY, OpenClaw's word for it) when what
# woke it leaves nothing you'd want to see: a check that found nothing, a merge
# not worth a post. The turn is then gone from everything you see (its chat,
# the list's words, unread, the notifications, Today), as if it never ran: it
# stays in the conversation, its Claude remembers it, and `amarchy quiet` lists
# them. Only a turn you didn't start (the broker knows who did: Agent.turn) and
# nobody asked you anything in: the Stop hook (cmd_hook, quiet_stop) sends
# anything else back to be answered. While such a turn works, nothing of it
# shows (turn_hold): no typing…, no words, the chat idle as it was; once it
# ends, it's all there at once unless it ended quiet.

SILENT = "NO_REPLY"
SILENT_RE = re.compile(r"^[\s*_`>]*NO_REPLY(?![A-Za-z0-9])[\s\S]*$|^[\s\S]*(?<![A-Za-z0-9])NO_REPLY[\s*_`.!]*$")
SILENT_MARK = "amarchy: NO_REPLY hides only a turn a timer, a script or another chat started"
SILENT_ASK = (SILENT_MARK + ", when nobody needed them during it. They wrote to you themselves in this one (or answered you "
              "in it), so they're waiting to hear from you: reply to them as usual, in full.")
QUIET_TURNS = STATE / "quiet-turns"     # <id>.jsonl: its quiet turns, {since, until, what, note}
QUIET_KEPT = 500        # quiet turns remembered for each session (the newest)


def silent_note(text):
    """None unless a turn's reply is SILENT: alone, or first or last with a
    few words of why around it (those words: its note, "" for none)."""
    t = (text or "").strip()
    if not t or not SILENT_RE.match(t):
        return None
    return " ".join(re.sub(r"[*_`]*NO_REPLY[*_`.!]*", " ", t).split()).strip(" —–-:;,.")[:300]


def quiet_note(sid, turn, note):
    """A quiet turn, written down: from when the broker began it to now."""
    try:
        QUIET_TURNS.mkdir(parents=True, exist_ok=True)
        f = QUIET_TURNS / f"{sid}.jsonl"
        with open(f, "a") as fh:
            fh.write(json.dumps({"since": float(turn["since"]), "until": time.time(),
                                 "what": " ".join(str(turn.get("what") or "").split())[:200], "note": note}) + "\n")
        if f.stat().st_size > QUIET_KEPT * 400:
            write_file(f, "\n".join(f.read_text().splitlines()[-QUIET_KEPT:]) + "\n")
    except (OSError, KeyError, TypeError, ValueError):
        pass


_quiet = {}


def quiet_turns(sid):
    """A session's quiet turns, oldest first: [{since, until, what, note}]."""
    f = QUIET_TURNS / f"{sid}.jsonl"
    try:
        stamp = f.stat().st_mtime_ns
    except OSError:
        return []
    if _quiet.get(sid, (None,))[0] == stamp:
        return _quiet[sid][1]
    out = []
    try:
        for line in f.read_text().splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if isinstance(e, dict) and isinstance(e.get("since"), (int, float)) and isinstance(e.get("until"), (int, float)):
                out.append(e)
    except OSError:
        return []
    out.sort(key=lambda e: e["since"])
    _quiet[sid] = (stamp, out)
    if len(_quiet) > 500:
        _quiet.clear()
    return out


def quiet_last(sid):
    """Whether the session's last turn ended quiet: it's idle since (the Stop
    hook wrote it down, then set it idle: quiet_stop)."""
    turns = quiet_turns(sid)
    try:
        f = STATUS / sid
        return bool(turns) and f.read_text().strip() == "idle" and 0 <= f.stat().st_mtime - turns[-1]["until"] < 5
    except OSError:
        return False


def quiet_waking(sid):
    """Whether the session's Claude is starting (asleep, exited) with what a
    timer, a script or another chat sent it (send_start): unseen, as its
    turn will be (turn_hold), not "typing…"."""
    try:
        return time.time() - (claude_dir(sid) / "send-quiet").stat().st_mtime < SEND_START + 60
    except OSError:
        return False


def turn_hold(s, live=None):
    """When the turn under way began, if a timer, a script or another chat
    started it (the broker's turn: elsewhere), nobody's been asked anything
    in it and its Claude still works on it: what it says waits until it
    ends, and is shown then unless it ended quiet. None otherwise. The
    Stop hook sets the status idle once it knows (quiet or not): from then
    on, nothing is held."""
    if not s or engine(s) != "chat":
        return None
    try:
        if (STATUS / s["id"]).read_text().strip() != "working":
            return None
    except OSError:
        return None
    live = agent_live(s["id"]) if live is None else live
    turn = live.get("turn") if isinstance(live, dict) else None
    if not isinstance(turn, dict) or live.get("state") in ("waiting", "exited") or live.get("pending") \
            or not turn.get("elsewhere") or turn.get("asked") or not isinstance(turn.get("since"), (int, float)):
        return None
    return float(turn["since"])


def turns_hidden(s, live=None):
    """What of a session's conversation isn't shown: its quiet turns (their
    spans, sorted) and the turn held under way (its start, or None)."""
    spans = [(e["since"], e["until"]) for e in quiet_turns(s["id"])] if s and s.get("id") else []
    return spans, turn_hold(s, live)


def record_at(r):
    """A conversation record's time (its timestamp, to the millisecond), or 0."""
    t = r.get("timestamp") if isinstance(r, dict) else None
    if not isinstance(t, str):
        return 0
    try:
        return datetime.datetime.fromisoformat(t.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0


def record_hidden(r, hidden):
    """Whether a conversation record belongs to a turn that isn't shown
    (turns_hidden): a quiet one, or the one held under way."""
    if not hidden:
        return False
    spans, hold = hidden
    if not spans and hold is None:
        return False
    t = record_at(r)
    if not t:
        return False
    if hold is not None and t >= hold:
        return True
    i = bisect.bisect_right(spans, (t, float("inf"))) - 1
    return i >= 0 and spans[i][0] <= t <= spans[i][1]


def quiet_stop(s, event):
    """At a turn's end (the Stop hook): True when its reply is SILENT and the
    turn is one to hide (a timer, a script or another chat started it, and
    nobody was asked anything in it): written down, and idle without being
    done (nothing new, nothing told). SILENT_ASK when the reply is SILENT
    but the turn is yours: it's sent back, to be answered. None otherwise."""
    text = event.get("last_assistant_message") if isinstance(event.get("last_assistant_message"), str) else None
    if not text:
        text = turn_reply(event.get("transcript_path"))
    note = silent_note(text)
    if note is None:
        return None
    turn = (agent_live(s["id"]).get("turn") if engine(s) == "chat" else None) or {}
    if turn.get("elsewhere") and not turn.get("asked") and isinstance(turn.get("since"), (int, float)):
        quiet_note(s["id"], turn, note)
        return True
    return SILENT_ASK


def cmd_quiet(args):
    """amarchy quiet [<id>] [--json]: the turns hidden as quiet (NO_REPLY):
    when, what woke it, the few words its Claude said why."""
    as_json = "--json" in args
    rest = [a for a in args if a != "--json"]
    if len(rest) > 1 or rest and rest[0].startswith("-"):
        print(usage("quiet"), file=sys.stderr)
        return 1
    sid = rest[0] if rest else own_session_id()
    if not sid or not session(sid):
        return fail(f"No session {sid!r}" if sid else "Not in a session: name one, amarchy quiet <id>")
    turns = quiet_turns(sid)
    if as_json:
        print(json.dumps(turns, indent=1))
        return 0
    if not turns:
        print(f"{sid}: no quiet turns")
        return 0
    for e in turns[-50:]:
        when = time.strftime("%a %d %b %H:%M", time.localtime(e["since"]))
        print(f"{when}  {e.get('what') or '(another chat, or its own background job)'}")
        if e.get("note"):
            print(f"                  → {e['note']}")
    return 0


def cmd_notify(args):
    """amarchy notify <title> <body> [--session <id>] [--urgent]: a
    notification on every phone (and browser) with the app's notifications
    on, as the app's own are sent."""
    urgent, sid, rest = False, None, []
    it = iter(args)
    for a in it:
        if a == "--urgent":
            urgent = True
        elif a == "--session":
            sid = next(it, None)
            if not sid:
                return fail("--session takes a session's id")
        else:
            rest.append(a)
    if len(rest) not in (1, 2) or not rest[0].strip():
        print(usage("notify"), file=sys.stderr)
        return 1
    title, body = rest[0], rest[1] if len(rest) > 1 else ""
    if len(title) > 200 or len(body) > 2000:
        return fail("too long for a notification (a title of 200 characters, a body of 2000)")
    if sid and not session(sid):
        return fail(f"No session {sid!r}")
    # From your assistant or an agent (or another session of its project):
    # under its name and picture, and a tap opens it unless it says where.
    me = session(os.environ.get("AMARCHY_SESSION", ""))
    mine = team_of(me)[1] if me else None
    # Sent from a session: tapped, it opens that session, unless it says where.
    sid = sid or (me["id"] if me else None)
    if mine:
        if not title.lower().startswith(mine["name"].lower()):
            title = f"{mine['name']}: {title}"
    if not notified_anywhere():
        return fail("no phone or browser has turned on notifications yet "
                    "(in the app: the gear, then Turn on notifications)")
    # A tag of its own: it doesn't replace the one before it (the app's own
    # replace each other per session).
    payload = {"title": title, "body": body, "tag": f"amarchy-notify-{time.time_ns()}",
               "url": f"/#/s/{sid}" if sid else "/"}
    if urgent:
        payload["urgent"] = True
    if mine:
        payload["icon"] = team_icon(mine)
    n = push_all(payload)
    print(f"sent to {n} of {len(app_subscriptions()) + desktops_listening()}")
    return 0 if n else 1


# ------------------------------------------------------------------ from before
#
# amarchy ran on an Omarchy desktop too, once: Hyprland windows, a shell
# plugin, desktops showing a host's sessions over ssh. What that left in the
# state goes, once (the app's server runs this as it starts, install.sh as it
# installs): the look the last desktop sent the app is kept whole as a theme
# of your own, and picked, so the app looks exactly as it did; its chimes
# become the ones picked here; and the desktop's own files are dropped.

MIGRATED = STATE / "migrated"       # the last of MIGRATIONS done
# 1: the desktop's look as amarchy's theme of the same name (its colors
# weren't quite the desktop's); 2: as a theme of your own; 3: Show terminals
# on for an install from before it (a new one starts with them hidden).
MIGRATIONS = 3
DESKTOP_STATE = ("zen", "layout.lua", "last", "keys.lua", "keys.bound", "remote", "remote.json",
                 "remote-assistant.png", "preview", "watch.lock", "theme.log", "clipboard.sock", "host",
                 "theme", "notes")


def migrate():
    """Bring the state from before up to date, once (see above). Says what it did."""
    try:
        if int(MIGRATED.read_text().strip() or 0) >= MIGRATIONS:
            return
    except (OSError, ValueError):
        pass
    STATE.mkdir(parents=True, exist_ok=True)
    # An install from before (it has sessions, or migrated already) keeps its
    # terminals in sight: they were all it had. A new one starts without.
    before = MIGRATED.exists() or any(SESSIONS.glob("*.json"))
    with open(STATE / "migrate.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if int(MIGRATED.read_text().strip() or 0) >= MIGRATIONS:
                return      # another amarchy did it meanwhile
        except (OSError, ValueError):
            pass
        migrate_look()
        for name in DESKTOP_STATE:
            f = STATE / name
            if f.is_dir() and not f.is_symlink():
                shutil.rmtree(f, ignore_errors=True)
            else:
                f.unlink(missing_ok=True)
        for f in [*STATE.glob("ssh-*"), *CLIP_DIR.glob("*.sock"), *CLIP_DIR.glob("*.addr")]:
            f.unlink(missing_ok=True)
        # What a session's file said about its windows.
        for f in SESSIONS.glob("*.json"):
            try:
                s = json.loads(f.read_text())
            except (OSError, ValueError):
                continue
            if isinstance(s, dict) and {"prefix", "workspace", "no_jump"} & s.keys():
                for k in ("prefix", "workspace", "no_jump"):
                    s.pop(k, None)
                save_session(s)
        if before and not SHOW_TERMINALS.exists():
            write_file(SHOW_TERMINALS, "on\n")
        write_file(MIGRATED, f"{MIGRATIONS}\n")


def migrate_look():
    """The look a desktop last sent the app (app/look/look.json) as a theme
    of your own (custom_themes), "<its name> (yours)": its colors exactly as
    the app wore them, its terminals' size and opacity, its wallpaper, and
    its font when that isn't one of amarchy's. Picked, with its font, unless
    you had picked a theme of amarchy's in the app; its chimes too, unless
    you had picked those. Claude Code's colors stay as they were (the
    desktop's look never had them here)."""
    old = APP / "look"
    try:
        desk = json.loads((old / "look.json").read_text())
    except (OSError, ValueError):
        desk = None
    variables = desk.get("vars") if isinstance(desk, dict) and isinstance(desk.get("vars"), dict) else None
    if variables:
        name = re.sub(r"[^\w .'+-]", "", str(desk.get("name") or "")).strip()[:40] or "Your desktop's"
        key = (slug(name) or "desktop") + "-yours"
        files = desk.get("files") if isinstance(desk.get("files"), dict) else {}
        d = CUSTOM / key
        shutil.rmtree(d, ignore_errors=True)
        d.mkdir(parents=True)

        def keep(what, as_name):
            """A file of the old look, kept under the theme as as_name (its
            own extension): the name it got, or None."""
            src = old / Path(str(files.get(what) or "")).name if files.get(what) else None
            m = re.search(r"\.(jpg|png|webp|ttf|otf|woff2?)$", src.name) if src else None
            if not m or not src.is_file():
                return None
            shutil.copyfile(src, d / f"{as_name}.{m.group(1)}")
            return f"{as_name}.{m.group(1)}"
        phone = keep("wallpaper", "wallpaper")
        wide = keep("wallpaper-wide", "wallpaper-wide") or (keep("wallpaper", "wallpaper-wide") if phone else None)
        family = str(desk.get("family") or "")
        ours = next((k for k, (_, f) in LOOK_FONTS.items() if f and f == family), None)
        fonts = {w: f for w in ("regular", "bold") for f in [None if ours else keep(w, w)] if f}
        term = desk.get("terminal") if isinstance(desk.get("terminal"), dict) else {}
        write_file(d / "theme.json", json.dumps({
            "name": f"{name} (yours)", "mode": desk.get("mode") if desk.get("mode") in ("light", "dark") else "dark",
            "vars": look_tokens(variables),
            "terminal": {k: term[k] for k in ("size", "alpha") if isinstance(term.get(k), (int, float))},
            "wallpaper": {"phone": phone, "wide": wide} if phone else None,
            "font": {"family": family, "nerd": bool(desk.get("nerd")), "files": fonts} if fonts else None,
            "from": "the look your Omarchy desktop sent the app"}, indent=1))
        choice = look_choice()
        theme = font = own = None
        # What showed was the desktop's look until a theme of amarchy's was picked.
        if choice.get("theme") in (None, "desktop"):
            theme = key
            if "font" not in choice:
                font = ours or (f"custom-{key}" if fonts else LOOK_FONT)
        # Your own wallpaper was the desktop's, until you chose a picture.
        if choice.get("wallpaper") == "own" and not look_own() and phone:
            own = ((d / phone).read_bytes(), (d / wide).read_bytes())
        look = look_set(theme, font, own=own, claude=False)
        if isinstance(look, str):
            print(f"amarchy: couldn't keep the desktop's look: {look}", file=sys.stderr)
        for f, k in ((SOUND_FILE, "sound"), (ASSISTANT_SOUND_FILE, "assistant_sound")):
            sound = desk.get(k)
            if not f.exists() and isinstance(sound, str) and (sound == "off" or sound in CHIMES):
                write_file(f, sound + "\n")
    shutil.rmtree(old, ignore_errors=True)


# ------------------------------------------------------------------ Omarchy home
#
# What makes amarchy at home on an Omarchy desktop (track C of
# docs/plan-omarchy-and-machines.md). install.sh puts the pieces in place when
# Omarchy is there, and its --uninstall takes them all away:
#
# - `amarchy open [chat]`: the desktop app (amarchy-desktop) at the front, on
#   that chat. Super+D (amarchy key; omarchy/hypr/amarchy.lua), Amarchy in the Omarchy
#   menu and the Ⓐ in the bar all run it. Without the desktop app, the board
#   in a browser window.
# - `amarchy bar --follow`: what the Ⓐ in Omarchy's bar shows (omarchy/plugin):
#   how many chats need you and which, printed again on every change of the
#   board's events (/api/events), never polled.
# - The board both find the way the desktop app does (board_source): this
#   machine's own app server when it answers (in with the local key), else
#   the first of your machines (`amarchy machines`).

CHAT_LINK = re.compile(r"amarchy://chat/([a-z0-9][a-z0-9-]{0,62})/([\w][\w.-]{0,119})")
CHAT_ID = re.compile(r"[\w][\w.-]{0,119}")
MACHINE_NAME = re.compile(r"[a-z0-9][a-z0-9-]{0,62}")
DESKTOP_CONF = CONFIG / "desktop.json"     # the desktop app's server set by hand ({"server"}: amarchy-desktop --server)
BAR_SHOWN = 8           # the chats that need you the Ⓐ names in its tooltip, at most
BAR_RETRY = (1, 2, 5, 10, 30)   # seconds before trying the board again, while it doesn't answer


def port_answers(host, port, timeout=0.5):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def board_source():
    """The board this desktop shows, found as the desktop app finds it
    (docs/plan-omarchy-and-machines.md, "The desktop app: how it's opened,
    what it opens"): AMARCHY_URL; else this machine's own amarchy when its
    board has something (chats here, or other machines' it merges in) and
    its app server answers on 127.0.0.1 (in with the local key); else the
    first paired machine that answers; else the server set by hand in the
    desktop app. {"url", "local": this machine's own, "machine": whose
    board} or None, with why in "why" ({"url": None, "why"}) when there's
    one but it doesn't answer."""
    url = os.environ.get("AMARCHY_URL", "").strip().rstrip("/")
    if re.fullmatch(r"https?://[\w.-]+(:\d+)?", url):
        host = urllib.parse.urlsplit(url).hostname
        local = host in ("127.0.0.1", "localhost")
        return {"url": url, "local": local, "machine": machine_name() if local else host.split(".")[0]}
    me = machines_listed(check=False)[0]
    paired = machines_read()
    if (sessions() or (paired and me.get("merges"))) and LOCAL_KEY.is_file() and port_answers("127.0.0.1", app_port()):
        return {"url": f"http://127.0.0.1:{app_port()}", "local": True, "machine": machine_name()}
    why = None
    for m in paired:
        state = machine_state(m)
        if state.get("state") == "on":
            return {"url": m["url"], "local": False, "machine": m["name"]}
        why = why or f"{state.get('label') or m['label']}: {state.get('error') or 'it does not answer'}"
    try:
        server = json.loads(DESKTOP_CONF.read_text()).get("server")
    except (OSError, ValueError, AttributeError):
        server = None
    if isinstance(server, str) and re.fullmatch(r"https://[\w.-]+(:\d+)?/?", server):
        return {"url": server.rstrip("/"), "local": False, "machine": urllib.parse.urlsplit(server).hostname.split(".")[0]}
    return {"url": None, "why": why} if why else None


_local_cookie = {}


def board_request(src, path, headers=None, timeout=10):
    """A GET of path on the board, in as you: on this machine's own server
    the local key's cookie (GET /local?key=, as the contract has it); on
    another machine's, your Tailscale login (its tailscale serve says who)."""
    import urllib.error
    import urllib.request
    headers = dict(headers or {})
    if src["local"]:
        if src["url"] not in _local_cookie:
            class Stay(urllib.request.HTTPRedirectHandler):
                def redirect_request(self, *a, **k):
                    return None     # the cookie is on the redirect itself
            try:
                key = LOCAL_KEY.read_text().strip()
            except OSError as e:
                raise OSError(f"no local key ({e.strerror})")
            try:
                with urllib.request.build_opener(Stay).open(
                        f"{src['url']}/local?key={urllib.parse.quote(key)}", timeout=timeout) as r:
                    cookies = r.headers.get_all("Set-Cookie") or []
            except urllib.error.HTTPError as e:
                cookies = e.headers.get_all("Set-Cookie") or [] if e.code in (301, 302, 303, 307) else []
            cookie = next((c.split(";")[0] for c in cookies if c.startswith(LOCAL_COOKIE)), None)
            if not cookie:
                raise OSError("this machine's amarchy didn't take the local key")
            _local_cookie[src["url"]] = cookie
        headers["Cookie"] = _local_cookie[src["url"]]
    return urllib.request.urlopen(urllib.request.Request(src["url"] + path, headers=headers), timeout=timeout)


def asks_you(s):
    """Whether a chat waits on you (needs_you counts them; the Ⓐ lights up
    for them): it asks (a permission, a question, a secret), or its last
    reply asks you something you haven't answered."""
    return not s.get("setup") and bool(
        s.get("status") == "waiting" or s.get("secret_asks")
        or (s.get("status") != "working" and (s.get("today") or {}).get("asks")))


def bar_state(view, src):
    """What the Ⓐ shows of a board (/api/state, or one of its "list"
    events): how many chats need you and which, in the board's order (the
    first is the one a click opens). A machine that's off can't be answered:
    its chats wait, but not on you now."""
    here = str(view.get("machine") or view.get("hostname") or src.get("machine") or "")

    def words(v, n):
        return re.sub(r"\s+", " ", str(v or "")).strip()[:n]
    chats = []
    for s in view.get("sessions") or []:
        if not isinstance(s, dict) or s.get("machine_off") or not asks_you(s):
            continue
        sid, machine = str(s.get("id") or ""), str(s.get("machine") or here)
        if CHAT_ID.fullmatch(sid) and MACHINE_NAME.fullmatch(machine):
            chats.append({"machine": machine, "id": sid, "name": words(s.get("task") or s.get("name") or sid, 60),
                          "why": words(s.get("asks") or "Needs your answer", 80),
                          "link": f"amarchy://chat/{machine}/{sid}"})
    return {"up": True, "board": src["url"], "needs": len(chats), "chats": chats[:BAR_SHOWN]}


def bar_events(src):
    """The board's "list" events as they come (/api/events), each one's data
    parsed: gzipped, as a browser takes them (a list is tens of KB, a tenth
    of that zipped); plain when the zip doesn't come through (a proxy holding
    it back), as the app does. Ends when the stream does; a stream silent
    past three of its keepalives is taken as gone."""
    for plain in (False, True):
        r = board_request(src, "/api/events" + ("?plain=1" if plain else ""),
                          {"Accept": "text/event-stream", **({} if plain else {"Accept-Encoding": "gzip"})},
                          timeout=KEEPALIVE * 3)
        with r:
            unzip = zlib.decompressobj(31) if r.headers.get("Content-Encoding") == "gzip" else None
            buf, event, data, began, got = b"", None, [], time.time(), False
            while True:
                try:
                    chunk = r.read1(65536)
                except TimeoutError:
                    if got or plain:
                        return
                    break       # nothing at all, zipped: plain instead
                if not chunk:
                    return
                if reader_gone():
                    raise BrokenPipeError("no one reads it")
                buf += unzip.decompress(chunk) if unzip else chunk
                *lines, buf = buf.split(b"\n")
                for raw in lines:
                    line = raw.decode("utf-8", "replace").rstrip("\r")
                    if not line:
                        if event == "list" and data:
                            try:
                                view = json.loads("\n".join(data))
                            except ValueError:
                                view = None
                            if isinstance(view, dict):
                                got = True
                                yield view
                        event, data = None, []
                    elif line.startswith("event:"):
                        event = line[6:].strip()
                    elif line.startswith("data:"):
                        data.append(line[5:].removeprefix(" "))
                if not got and not plain and unzip and time.time() - began > 8:
                    break       # keepalives but no list, zipped: plain instead


def reader_gone():
    """Whether no one reads what this prints any more: the widget that
    started it is gone (a pipe's reader closed shows on its writer)."""
    try:
        p = select.poll()
        p.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        return any(ev & (select.POLLERR | select.POLLHUP) for _, ev in p.poll(0))
    except (OSError, ValueError):
        return False


def bar_say(state):
    print(json.dumps(state), flush=True)


def cmd_bar(args):
    """`amarchy bar [--follow]`: what the Ⓐ in Omarchy's bar shows, as JSON.
    --follow: again on every change, from the board's events, for as long as
    it runs (the widget's own process); while the board doesn't answer, it
    says so and tries again, a little later each time."""
    import urllib.error
    follow = "--follow" in args
    tries, last = 0, None
    while True:
        src = board_source()
        try:
            if not src:
                raise LookupError("No board here yet: pair this desktop with your server (amarchy machines add <server>)")
            if not src["url"]:
                raise LookupError(src["why"])
            if not follow:
                with board_request(src, "/api/state") as r:
                    bar_say(bar_state(json.loads(r.read()), src))
                return 0
            for view in bar_events(src):
                tries = 0
                state = bar_state(view, src)
                if state != last:
                    bar_say(state)
                    last = state
            why = "The board's events ended"
        except BrokenPipeError:
            return 0        # the widget is gone
        except urllib.error.HTTPError as e:
            why = f"The board said no ({e.code})" + (": this desktop isn't one of yours there" if e.code == 403 else "")
            _local_cookie.clear()
        except (LookupError, OSError, ValueError) as e:
            why = str(getattr(e, "reason", None) or e) or "The board doesn't answer"
            _local_cookie.clear()
        state = {"up": False, "board": (src or {}).get("url"), "why": why[:200]}
        if not follow:
            bar_say(state)
            return 1
        if state != last:
            try:
                bar_say(state)
            except BrokenPipeError:
                return 0
            last = state
        time.sleep(BAR_RETRY[min(tries, len(BAR_RETRY) - 1)])
        tries += 1


def hypr_env():
    """The environment hyprctl reaches Hyprland with: as it is, or with the
    running Hyprland's instance found (a systemd service, ssh, the app's
    server have none). None without Hyprland."""
    env = dict(os.environ)
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run = Path(env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "hypr"
        try:
            socks = sorted(run.glob("*/.socket.sock"), key=lambda p: p.stat().st_mtime)
        except OSError:
            socks = []
        if not socks:
            return None
        env["HYPRLAND_INSTANCE_SIGNATURE"] = socks[-1].parent.name
    if not env.get("WAYLAND_DISPLAY"):
        found = sorted(Path(env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}").glob("wayland-[0-9]"))
        if found:
            env["WAYLAND_DISPLAY"] = found[0].name
    return env if shutil.which("hyprctl") else None


def hypr_windows(cls, env):
    """The addresses of Hyprland's windows of a class, the one it focused
    last first."""
    try:
        r = subprocess.run(["hyprctl", "clients", "-j"], env=env, capture_output=True, text=True, timeout=5)
        clients = json.loads(r.stdout or "[]")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return []
    found = [c for c in clients if isinstance(c, dict) and c.get("class") == cls
             and re.fullmatch(r"0x[0-9a-f]+", str(c.get("address") or ""))]
    return [c["address"] for c in sorted(found, key=lambda c: c.get("focusHistoryID", 1 << 30))]


def hypr_focus(address, env):
    """Bring a window to the front, the way Omarchy's launch-or-focus does
    (its Lua dispatcher, or the one from before)."""
    try:
        r = subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{address}" }})'],
                           env=env, capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip() in ("ok", ""):
            return True
        r = subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{address}"],
                           env=env, capture_output=True, text=True, timeout=5)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def launch_app(argv, env=None):
    """Start an app apart from us, as Omarchy starts one: through uwsm-app
    (a scope of its own) when it's there."""
    if shutil.which("uwsm-app"):
        argv = ["uwsm-app", "--", *argv]
    subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def chat_link(target, board=lambda: None):
    """amarchy://chat/<machine>/<id> for what `amarchy open` was given (that
    link, <machine>/<id>, or a chat's id: this machine's if it has it, else
    the board's machine's, board() asked only then); "" for nothing; None
    for what isn't a chat."""
    if not target:
        return ""
    if CHAT_LINK.fullmatch(target):
        return target
    machine, slash, sid = target.rpartition("/")
    if slash and MACHINE_NAME.fullmatch(machine) and CHAT_ID.fullmatch(sid):
        return f"amarchy://chat/{machine}/{sid}"
    if slash or not CHAT_ID.fullmatch(target):
        return None
    src = None if session(target) else board()
    return f"amarchy://chat/{(src or {}).get('machine') or machine_name()}/{target}"


def cmd_open(args):
    """`amarchy open [chat]`: the desktop app at the front, on that chat."""
    target = args[0] if args else ""
    found = []

    def board():
        """The board (board_source), looked for once, and only when needed."""
        if not found:
            found.append(board_source())
        return found[0]
    link = chat_link(target, board)
    if link is None:
        return fail(f"{target!r} isn't a chat: give its id, <machine>/<id> or amarchy://chat/<machine>/<id>")
    env = hypr_env()
    windows = hypr_windows("amarchy", env) if env else []
    desktop = shutil.which("amarchy-desktop")
    if desktop:
        # Wayland lets no app take the focus itself: Hyprland gives it. The
        # app, single instance, takes the link from the second one it starts.
        if windows:
            hypr_focus(windows[0], env)
        if link or not windows:
            launch_app([desktop, *([link] if link else [])], env)
        return 0
    # No desktop app here: the board, in a browser window of its own, at the
    # chat (the routes the desktop app takes).
    src = board()
    if not src or not src["url"]:
        return fail(((src or {}).get("why") or "no board here yet") + ": pair this desktop with your server "
                    "(amarchy machines add <server>), or install the desktop app")
    m = CHAT_LINK.fullmatch(link) if link else None
    route = (m.group(2) if m.group(1) == src["machine"] else f"{m.group(1)}:{m.group(2)}") if m else ""
    if src["local"]:
        url = (f"{src['url']}/local?key={urllib.parse.quote(LOCAL_KEY.read_text().strip())}&next=/"
               + (urllib.parse.quote(f"#/s/{route}", safe="") if route else ""))
    else:
        url = src["url"] + "/" + (f"#/s/{urllib.parse.quote(route, safe=':')}" if route else "")
    if not m and shutil.which("omarchy-launch-or-focus-webapp"):
        launch_app(["omarchy-launch-or-focus-webapp", "Amarchy", url], env)
    elif shutil.which("omarchy-launch-webapp"):
        launch_app(["omarchy-launch-webapp", url], env)
    elif shutil.which("xdg-open"):
        launch_app(["xdg-open", url], env)
    else:
        print(url)
    return 0


# ---- the key (Omarchy)
#
# One key brings amarchy to the front on an Omarchy desktop (omarchy/hypr/
# amarchy.lua binds it to `amarchy open`): Super+D, which Omarchy leaves free
# (one hand reaches it), unless you set another (one Omarchy uses gives way to
# amarchy while it's picked). With no setting it's the default, so a new
# default reaches every machine that never picked one. `amarchy key` says when
# this machine's Hyprland has something else on the key (hyprctl binds). Kept in ~/.config/amarchy/key as a chord the way Omarchy's
# Lua config writes them ("SUPER + CTRL + M"), or "off"; no file: the default.

OMARCHY_KEY_FILE = CONFIG / "key"
OMARCHY_KEY_DEFAULT = "SUPER + D"
HYPR_MODMASK = {"SHIFT": 1, "CAPS": 2, "CTRL": 4, "ALT": 8, "MOD2": 16, "MOD3": 32, "SUPER": 64, "MOD5": 128}
KEY_MODS = {"super": "SUPER", "win": "SUPER", "meta": "SUPER", "shift": "SHIFT", "ctrl": "CTRL", "control": "CTRL",
            "alt": "ALT", "mod3": "MOD3", "mod5": "MOD5"}
KEY_LOWER = {"comma", "period", "slash", "backslash", "semicolon", "apostrophe", "grave", "minus", "equal",
             "bracketleft", "bracketright"}      # xkb's own names: "COMMA" doesn't match


def key_chord(text):
    """A key as you'd type it (Super+Shift+A, "super shift a") as Omarchy's
    Lua config writes one ("SUPER + SHIFT + A"), or None when it isn't one."""
    parts = [p for p in re.split(r"[\s+]+", str(text or "").strip()) if p]
    if len(parts) < 2:
        return None         # a key alone, without a modifier, would take it from every app
    mods, key = parts[:-1], parts[-1]
    mods = [KEY_MODS.get(m.lower()) for m in mods]
    if None in mods or len(set(mods)) != len(mods):
        return None
    if re.fullmatch(r"code:\d{1,3}", key, re.I):
        key = key.lower()
    elif key.lower() in KEY_LOWER:
        key = key.lower()
    elif re.fullmatch(r"[A-Za-z0-9]|F\d{1,2}|[A-Za-z_]{2,20}", key):
        key = key.upper()
    else:
        return None
    order = ["SUPER", "SHIFT", "CTRL", "ALT", "MOD3", "MOD5"]
    return " + ".join(sorted(mods, key=order.index) + [key])


def key_words(chord):
    """"SUPER + SHIFT + A" as people write it: Super+Shift+A."""
    return "+".join(p.capitalize() if p.isupper() and len(p) > 1 else p for p in chord.split(" + "))


def key_taken(chord):
    """What else this machine's Hyprland binds to a chord (hyprctl binds:
    each one's description, or what it runs), amarchy's own left out; None
    when there's no Hyprland to ask."""
    env = hypr_env()
    if not env:
        return None
    try:
        binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"], env=env, capture_output=True, text=True,
                                          timeout=5).stdout or "[]")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    parts = chord.split(" + ")
    mods, key = sum(HYPR_MODMASK.get(p, 0) for p in parts[:-1]), parts[-1]
    code = key.lower().removeprefix("code:") if key.lower().startswith("code:") else None
    taken = []
    for b in binds if isinstance(binds, list) else []:
        if not isinstance(b, dict) or b.get("modmask") != mods or b.get("submap"):
            continue
        if not (str(b.get("keycode")) == code if code else str(b.get("key") or "").lower() == key.lower()):
            continue
        said = f"{b.get('description') or ''} {b.get('arg') or ''}"
        if "amarchy" in said.lower():
            continue
        taken.append(re.sub(r"\s+", " ", str(b.get("description") or f"{b.get('dispatcher') or ''} {b.get('arg') or ''}")).strip()[:80]
                     or "something")
    return taken


def omarchy_key():
    """The key now: a chord, or "off"; and whether it's the default."""
    try:
        said = OMARCHY_KEY_FILE.read_text().strip()
    except OSError:
        said = ""
    if said == "off":
        return "off", False
    chord = key_chord(said) if said else None
    return (chord, False) if chord else (OMARCHY_KEY_DEFAULT, True)


def cmd_key(args):
    """`amarchy key [<keys>|off|default] [--check]`."""
    check = "--check" in args
    args = [a for a in args if a != "--check"]
    if check and not args:      # only what else is on the key here (install.sh says it)
        chord, _ = omarchy_key()
        taken = key_taken(chord) if chord != "off" else None
        if taken:
            print(f"{key_words(chord)} is also bound here: {'; '.join(taken)}. Another key: amarchy key <keys>")
        return 0
    if len(args) > 1:
        return fail("usage: amarchy key [<keys>|off|default]   (keys like Super+Shift+A)")
    if args:
        want = args[0].strip()
        if want == "default":
            OMARCHY_KEY_FILE.unlink(missing_ok=True)
        elif want == "off":
            write_file(OMARCHY_KEY_FILE, "off\n")
        else:
            chord = key_chord(want)
            if not chord:
                return fail(f"{want!r} isn't a key amarchy can take: a modifier or two and a key, like "
                            "Super+Shift+A or Super+Ctrl+M")
            write_file(OMARCHY_KEY_FILE, chord + "\n") if chord != OMARCHY_KEY_DEFAULT else \
                OMARCHY_KEY_FILE.unlink(missing_ok=True)
        # The Omarchy menu's hint says it, and Hyprland binds it now (a reload
        # binds everything afresh: the key from before is Omarchy's again).
        if (Path(SELF).parent.parent / "omarchy/install.sh").is_file():
            sh(str(Path(SELF).parent.parent / "omarchy/install.sh"), "--menu")
        env = hypr_env()
        if env:
            subprocess.run(["hyprctl", "reload"], env=env, capture_output=True, timeout=10)
    chord, default = omarchy_key()
    if chord == "off":
        print(f"No key brings amarchy to the front (amarchy key default: {key_words(OMARCHY_KEY_DEFAULT)} again)")
    else:
        print(f"{key_words(chord)} brings amarchy to the front" + (" (the default)" if default else
              ", in place of anything Omarchy had there") + ". Another: amarchy key <keys>; none: amarchy key off")
        taken = key_taken(chord) if default else None
        if taken:
            print(f"But this machine's Hyprland has something else on {key_words(chord)} too: {'; '.join(taken)}. "
                  "Pick another key: amarchy key <keys>")
    return 0


# ---- the theme live: "Omarchy (live)"
#
# A theme of yours (custom_themes, app/custom/omarchy-live) made from this
# desktop's Omarchy theme as it is now: its colors (current/theme/colors.toml)
# and what its shell.toml says of menus, popups and controls (your own
# ~/.config/omarchy/shell.toml over it, as the shell reads them), turned into
# the app's tokens the way amarchy's own themes are (app_look_vars,
# docs/design-tokens.md); Hyprland's rounding; the wallpaper on the desktop
# now (current/background), cut for a phone and a computer; and the monospace
# font Omarchy set (fontconfig), with its files, so it's worn everywhere.
#
# `amarchy theme --omarchy` makes it, keeps it here and sends it to every
# machine paired with this one (PUT /api/peer/look), so the board wears it
# wherever you pick it (Settings → Look); a machine keeps the last one it was
# sent. It's made again when Omarchy's changes, by events, never by polling:
# Omarchy's theme-set hook, and a systemd path unit (amarchy-omarchy-look.path,
# installed by omarchy/install.sh) for the wallpaper, the font, the theme's
# name and your shell.toml and looknfeel.lua. Made the same as last time and
# sent everywhere already, it does nothing.

# Where Omarchy keeps them: under $HOME always, as its own scripts do (not XDG's).
OMARCHY_CURRENT = HOME / ".local/state/omarchy/current"
OMARCHY_CONFIG = HOME / ".config"
OMARCHY_LIVE = "omarchy-live"               # its key, in app/custom
OMARCHY_LIVE_NAME = "Omarchy (live)"
OMARCHY_LIVE_SENT = STATE / "omarchy-live.json"     # what was made last ({"sig"}) and sent where ({"sent": {machine: sig}})
LOOK_FONT_MAX = 12_000_000          # bytes of one font file a live theme carries
LOOK_PUT_MAX = 48_000_000           # bytes of a theme a machine of yours sends (its files, in base64)
FONT_MAGIC = {"ttf": (b"\x00\x01\x00\x00", b"true"), "otf": (b"OTTO",), "woff": (b"wOFF",), "woff2": (b"wOF2",)}


def toml_merge(base, over):
    """over's keys on base's, section by section (as the shell takes your
    shell.toml over the theme's)."""
    out = dict(base)
    for k, v in over.items():
        out[k] = toml_merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def omarchy_rounding(theme_dir):
    """The corners Hyprland draws now (decoration:rounding), else what the
    theme's hyprland.lua says, else Omarchy's 0."""
    env = hypr_env()
    if env:
        try:
            r = subprocess.run(["hyprctl", "-j", "getoption", "decoration:rounding"], env=env, capture_output=True,
                               text=True, timeout=5)
            value = json.loads(r.stdout or "{}").get("int")
            if isinstance(value, int) and not isinstance(value, bool):
                return min(max(value, 0), 40)
        except (OSError, subprocess.TimeoutExpired, ValueError, AttributeError):
            pass
    try:
        m = re.search(r"(?m)^\s*rounding\s*=\s*(\d+)", (theme_dir / "hyprland.lua").read_text())
    except OSError:
        m = None
    return min(int(m.group(1)), 40) if m else 0


def omarchy_font():
    """The monospace font Omarchy set (fontconfig, as omarchy-font-current
    reads it): {"family", "nerd", "files": {"regular": (name, bytes),
    "bold": ...}}: amarchy's own files when it's one of amarchy's fonts, else
    the font's own (TTF or OTF, not too big). None when there's none to send."""
    if not shutil.which("fc-match"):
        return None
    family = sh("fc-match", "monospace", "-f", "%{family}").stdout.split(",")[0].strip()
    if not family:
        return None
    ours = next((k for k, (_, f) in LOOK_FONTS.items() if f and f.lower() == family.lower()), None)
    files = {}
    for weight, style in (("regular", "regular"), ("bold", "bold")):
        if ours:
            f = FONTS / ours / f"{weight}.woff2"
        else:
            found = sh("fc-match", f"{family}:style={style}", "-f", "%{file}").stdout.strip()
            f = Path(found) if found else None
            if f and sh("fc-match", f"{family}:style={style}", "-f", "%{family}").stdout.split(",")[0].strip().lower() \
                    != family.lower():
                f = None        # fontconfig fell back to another font: not this one's
        kind = f.suffix[1:].lower() if f else ""
        try:
            raw = f.read_bytes() if f and kind in FONT_MAGIC and f.stat().st_size <= LOOK_FONT_MAX else b""
        except OSError:
            raw = b""
        if raw.startswith(FONT_MAGIC.get(kind, (b"\xff",))):
            files[weight] = (f"{weight}.{kind}", raw)
    if "regular" not in files:
        return None
    return {"family": re.sub(r"[^\w .-]", "", family)[:64], "nerd": "nerd" in family.lower() or bool(ours),
            "files": files}


def omarchy_live_make():
    """"Omarchy (live)" as this desktop's Omarchy theme is now: {"theme": its
    theme.json, "files": {name: bytes}, "sig"}, or a string saying why not."""
    import tomllib
    theme_dir = OMARCHY_CURRENT / "theme"
    try:
        colors = theme_colors((theme_dir / "colors.toml").read_text())
    except OSError:
        return "no Omarchy theme here (~/.local/state/omarchy/current/theme)"
    if not colors:
        return "Omarchy's colors.toml doesn't read"
    shell = {}
    for f in (theme_dir / "shell.toml", OMARCHY_CONFIG / "omarchy/shell.toml"):
        try:
            shell = toml_merge(shell, tomllib.loads(f.read_text()))
        except (OSError, tomllib.TOMLDecodeError):
            pass
    variables, mode = app_look_vars(colors, shell or look_shell(colors, {}), omarchy_rounding(theme_dir))
    try:
        name = (OMARCHY_CURRENT / "theme.name").read_text().strip()[:40]
    except OSError:
        name = ""
    files, wallpaper = {}, None
    background = OMARCHY_CURRENT / "background"
    if background.exists():
        cut = {w: wallpaper_small(background.resolve(), w) for w in ("phone", "wide")}
        if all(cut.values()):
            wallpaper = {}
            for w, raw in cut.items():
                f = f"{'wallpaper' if w == 'phone' else 'wallpaper-wide'}.{image_kind(raw)}"
                files[f], wallpaper[w] = raw, f
    font = omarchy_font()
    if font:
        files.update(dict(font["files"].values()))
        font = {**font, "files": {w: f for w, (f, _) in font["files"].items()}}
    theme = {"name": OMARCHY_LIVE_NAME, "mode": mode, "vars": variables, "terminal": {}, "wallpaper": wallpaper,
             "font": font, "from": f"{name or 'Omarchy'} on {machine_label()}",
             "omarchy": {"theme": name, "machine": machine_name()}}
    sig = hashlib.sha1(json.dumps(theme, sort_keys=True).encode()
                       + b"".join(hashlib.sha1(files[f]).digest() for f in sorted(files))).hexdigest()
    return {"theme": theme, "files": files, "sig": sig}


def look_custom_put(key, theme, files):
    """A theme of yours put whole into app/custom/<key>: theme, its
    theme.json as a dict; files, {name: bytes}, every file it names and
    nothing else. Written beside it, then <key> (a link to it) turned to it
    in one step, so the app never reads it half written or missing. None, or
    why it isn't one."""
    if not isinstance(theme, dict) or not isinstance(files, dict):
        return "a theme is its theme.json and its files"
    variables = theme.get("vars")
    if (not isinstance(variables, dict) or not variables or len(variables) > 300
            or not all(isinstance(k, str) and re.fullmatch(r"[\w-]{1,64}", k) and isinstance(v, str)
                       and re.fullmatch(r"[\w#().,/% -]{1,300}", v) for k, v in variables.items())):
        return "its colors (vars) don't read"
    named = []
    if theme.get("wallpaper") is not None:
        wall = theme["wallpaper"]
        if not isinstance(wall, dict) or set(wall) != {"phone", "wide"}:
            return "its wallpaper is {phone, wide}"
        named += list(wall.values())
    if theme.get("font") is not None:
        font = theme["font"]
        if not isinstance(font, dict) or not isinstance(font.get("files"), dict) or "regular" not in font["files"] \
                or not set(font["files"]) <= {"regular", "bold"}:
            return "its font is {family, nerd, files: {regular, bold}}"
        named += list(font["files"].values())
    for f in named:
        if not isinstance(f, str) or not CUSTOM_FILE.fullmatch(f) or f not in files:
            return f"it names a file it doesn't send ({str(f)[:40]})"
    if set(files) != set(named):
        return "it sends files it doesn't name"
    for f, raw in files.items():
        kind = f.rsplit(".", 1)[1]
        ok = (image_kind(raw) == kind and len(raw) <= APP_WALLPAPER_MAX) if f.startswith("wallpaper") else \
            (raw.startswith(FONT_MAGIC.get(kind, (b"\xff",))) and len(raw) <= LOOK_FONT_MAX)
        if not ok:
            return f"{f} isn't what its name says"
    kept = {"name": str(theme.get("name") or key)[:60], "mode": "light" if theme.get("mode") == "light" else "dark",
            "vars": variables, "terminal": theme.get("terminal") if isinstance(theme.get("terminal"), dict) else {},
            "wallpaper": theme.get("wallpaper"), "font": theme.get("font"),
            "from": str(theme.get("from") or "")[:120],
            **({"omarchy": theme["omarchy"]} if isinstance(theme.get("omarchy"), dict) else {})}
    CUSTOM.mkdir(parents=True, exist_ok=True)
    here = CUSTOM / key
    was = os.readlink(here) if here.is_symlink() else None
    new = Path(tempfile.mkdtemp(prefix=f".{key}.", dir=CUSTOM))
    link = CUSTOM / f".{key}.link.{os.getpid()}"
    try:
        for f, raw in files.items():
            (new / f).write_bytes(raw)
        (new / "theme.json").write_text(json.dumps(kept, indent=1))
        new.chmod(0o755)
        if here.is_dir() and not here.is_symlink():     # one from before kept as a folder: aside, once
            os.replace(here, CUSTOM / f".{key}.old.{os.getpid()}")
            was = f".{key}.old.{os.getpid()}"
        link.unlink(missing_ok=True)
        os.symlink(new.name, link)
        os.replace(link, here)
    except OSError as e:
        shutil.rmtree(new, ignore_errors=True)
        link.unlink(missing_ok=True)
        return f"couldn't keep it ({e.strerror or e})"
    # What it was before, and anything left from a put cut short.
    for d in CUSTOM.glob(f".{key}.*"):
        if d.name != new.name and (d.name == was or time.time() - d.lstat().st_mtime > 600):
            shutil.rmtree(d, ignore_errors=True) if d.is_dir() and not d.is_symlink() else d.unlink(missing_ok=True)
    return None


def omarchy_live_send(made, m):
    """Send "Omarchy (live)" to machine m (PUT /api/peer/look): None, or why
    it didn't take it."""
    body = {"key": OMARCHY_LIVE, "theme": made["theme"],
            "files": {f: base64.b64encode(raw).decode() for f, raw in made["files"].items()}}
    try:
        status, said = peer_json(m, "PUT", "/api/peer/look", body, timeout=60)
    except PeerError as e:
        return str(e)
    return None if status == 200 else said.get("error") or f"it answered {status}"


def omarchy_live_inputs():
    """What "Omarchy (live)" is made from, as a signature that changes with
    any of it (cheap: no picture cut, no font read)."""
    h = hashlib.sha1()
    theme_dir = OMARCHY_CURRENT / "theme"
    for f in (theme_dir / "colors.toml", theme_dir / "shell.toml", theme_dir / "hyprland.lua",
              OMARCHY_CONFIG / "omarchy/shell.toml", OMARCHY_CURRENT / "theme.name"):
        try:
            h.update(f.read_bytes())
        except OSError:
            h.update(b"-")
    for f in (OMARCHY_CURRENT / "background",):
        try:
            st_ = f.stat()
            h.update(f"{f.resolve()}:{st_.st_mtime_ns}:{st_.st_size}".encode())
        except OSError:
            h.update(b"-")
    if shutil.which("fc-match"):
        h.update(sh("fc-match", "monospace", "-f", "%{family}|%{file}").stdout.encode())
    h.update(str(omarchy_rounding(theme_dir)).encode())
    h.update(machine_label().encode())
    return h.hexdigest()


def omarchy_live(force=False):
    """Make "Omarchy (live)" again, keep it, send it to every machine paired
    with this one that doesn't have this one yet. What happened, in lines, and
    whether all of it went: ([words], ok). Made again until what it's made
    from holds still (a theme switch writes several files)."""
    try:
        last = json.loads(OMARCHY_LIVE_SENT.read_text())
    except (OSError, ValueError):
        last = {}
    inputs = omarchy_live_inputs()
    paired = machines_read()
    sent = last.get("sent") if isinstance(last.get("sent"), dict) else {}
    if (not force and inputs == last.get("inputs") and (CUSTOM / OMARCHY_LIVE / "theme.json").is_file()
            and all(sent.get(m["name"]) == last.get("sig") for m in paired)):
        return [], True     # made and sent as it is already
    for _ in range(3):
        made = omarchy_live_make()
        if isinstance(made, str):
            return [made], False
        now = omarchy_live_inputs()
        if now == inputs:
            break
        inputs = now        # it changed while it was made (a theme switch under way): again
    if last.get("sig") != made["sig"]:
        sent = {}
    out, ok = [], True
    if force or last.get("sig") != made["sig"] or not (CUSTOM / OMARCHY_LIVE / "theme.json").is_file():
        why = look_custom_put(OMARCHY_LIVE, made["theme"], made["files"])
        if why:
            return [f"couldn't keep it here: {why}"], False
        out.append(f"{OMARCHY_LIVE_NAME}: made from {made['theme']['from']}")
    for m in paired:
        if not force and sent.get(m["name"]) == made["sig"]:
            continue
        why = omarchy_live_send(made, m)
        if why:
            ok = False
            out.append(f"not sent to {m['label']}: {why}")
        else:
            sent[m["name"]] = made["sig"]
            out.append(f"sent to {m['label']}")
    write_file(OMARCHY_LIVE_SENT, json.dumps({"sig": made["sig"], "inputs": inputs, "sent": sent,
                                              "at": int(time.time())}))
    return out, ok


def cmd_theme_omarchy(args):
    """`amarchy theme --omarchy [--force] [--quiet] [--in-background]`."""
    if "--in-background" in args:
        unit = "amarchy-omarchy-look"
        if shutil.which("systemctl") and sh("systemctl", "--user", "cat", f"{unit}.service").returncode == 0:
            r = sh("systemctl", "--user", "start", "--no-block", f"{unit}.service")
        else:
            r = sh("systemd-run", "--user", "--quiet", "--collect", f"--unit={unit}-{int(time.time())}",
                   ENTRY, "theme", "--omarchy", "--quiet") if shutil.which("systemd-run") else None
        if r is None or r.returncode != 0:
            subprocess.Popen([ENTRY, "theme", "--omarchy", "--quiet"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    lines, ok = omarchy_live(force="--force" in args)
    if lines and ("--quiet" not in args or not ok):
        print("\n".join(lines), file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


# ---- keep-awake
#
# While a chat on this machine works (its turn, or what it started that runs
# to an end), amarchy holds off the machine's idle sleep: a systemd-inhibit
# lock of the kind "idle", which logind's IdleAction and the idle daemons that
# honor it (hypridle) wait on. Only "idle": the screen still locks on
# Omarchy (its idle only locks), and closing the lid, or Suspend, still
# sleeps it. Let go as soon as none works. The app's server holds it (it reads
# the chats every second, app_watch); the lock is held through a pipe of its,
# so if the server goes the lock goes with it. `amarchy awake off` stops it.

AWAKE_OFF = STATE / "awake-off"          # amarchy awake off: never held
AWAKE_STATE = STATE / "awake.json"       # what the server holds now, for amarchy awake
AWAKE_WHY = "A chat in amarchy is working"
AWAKE_RETRY = 60                         # seconds before trying again after systemd-inhibit failed
_awake = {"proc": None, "since": 0, "error": None, "failed": 0, "said": None}


def awake_working(ss):
    """This machine's chats at work: in a turn, or running what they started."""
    return [s for s in ss if not s.get("setup") and s.get("status") in ("working", "running")]


def awake_hold():
    """systemd-inhibit holding "idle" until its stdin closes (cat ends): the
    process, or None with why in _awake["error"]."""
    exe = shutil.which("systemd-inhibit")
    if not exe:
        _awake["error"] = "no systemd-inhibit on this machine"
        return None
    try:
        p = subprocess.Popen([exe, "--what=idle", "--who=amarchy", f"--why={AWAKE_WHY}", "--mode=block", "cat"],
                             stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except OSError as e:
        _awake["error"] = f"systemd-inhibit didn't start ({e.strerror or e})"
        return None
    try:
        p.wait(0.3)         # one that can't take the lock ends at once, saying why
    except subprocess.TimeoutExpired:
        return p
    _awake["error"] = (p.stderr.read().decode(errors="replace").strip().splitlines() or ["systemd-inhibit ended"])[-1][:200]
    return None


def awake_release():
    p, _awake["proc"] = _awake["proc"], None
    if p is None:
        return
    try:
        p.stdin.close()     # cat ends, and the lock with it
        p.wait(3)
    except (OSError, subprocess.TimeoutExpired):
        p.terminate()
        try:
            p.wait(3)
        except subprocess.TimeoutExpired:
            p.kill()


def awake_want(ss):
    """Hold off idle sleep while a chat here works (ss: this machine's chats,
    as app_watch reads them every second), let go when none does. Never
    raises: the list goes on whatever happens here."""
    try:
        working = awake_working(ss)
        off = AWAKE_OFF.exists()
        p = _awake["proc"]
        alive = p is not None and p.poll() is None
        if working and not off and not alive:
            if p is not None:       # it ended by itself (logind restarted?): again
                _awake["proc"] = None
            if time.time() - _awake["failed"] > AWAKE_RETRY:
                _awake["proc"] = awake_hold()
                if _awake["proc"]:
                    _awake.update(since=time.time(), error=None)
                else:
                    _awake["failed"] = time.time()
        elif (not working or off) and (alive or p is not None):
            awake_release()
        held = _awake["proc"] is not None and _awake["proc"].poll() is None
        said = {"held": held, "working": [s["id"] for s in working], "off": off,
                "since": int(_awake["since"]) if held else None, "error": None if held or not working else _awake["error"],
                "pid": os.getpid()}
        if said != _awake["said"]:
            write_file(AWAKE_STATE, json.dumps(said))
            _awake["said"] = said
    except Exception as e:      # never the list's end
        print(f"amarchy app: keep-awake: {e}", file=sys.stderr, flush=True)


def cmd_awake(args):
    """`amarchy awake [on|off] [--json]`."""
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    if args[:1] in (["on"], ["off"]) and len(args) == 1:
        if args[0] == "off":
            write_file(AWAKE_OFF, "off\n")
        else:
            AWAKE_OFF.unlink(missing_ok=True)
    elif args:
        return fail("usage: amarchy awake [on|off] [--json]")
    try:
        said = json.loads(AWAKE_STATE.read_text())
    except (OSError, ValueError):
        said = {}
    server = isinstance(said.get("pid"), int) and Path(f"/proc/{said['pid']}").exists() \
        and "amarchy" in Path(f"/proc/{said['pid']}/cmdline").read_bytes().decode(errors="replace")
    off = AWAKE_OFF.exists()
    held = bool(server and said.get("held") and not off)
    working = (said.get("working") or []) if server else []
    state = {"on": not off, "held": held, "working": working, "since": said.get("since") if held else None,
             "server": bool(server), "error": said.get("error") if server else None}
    if as_json:
        print(json.dumps(state))
        return 0
    n = len(working)
    chats = f"{n} chat{'s' * (n != 1)} working here"
    if off:
        print("Off: amarchy doesn't hold off this machine's sleep (amarchy awake on)")
    elif not server:
        print("On, but amarchy's app isn't running here, so nothing holds off sleep (amarchy app on)")
    elif held:
        since = time.strftime("%H:%M", time.localtime(state["since"])) if state["since"] else "now"
        print(f"Holding off idle sleep since {since}: {chats}. The screen still locks, and closing the lid "
              "still sleeps it")
    elif working:
        print(f"Can't hold off idle sleep ({state['error'] or 'systemd-inhibit failed'}): {chats}")
    else:
        print("On: no chat works here now, so this machine sleeps when it's idle")
    return 0


# ---- amarchy tailscale
#
# Tailscale is the network amarchy's devices and machines meet on (the
# plan's decision 5). `amarchy tailscale`, and Settings → Tailscale in the
# app, take a machine through it: installed (Omarchy's own installer there,
# which also puts its Tailscale panel in the bar), its daemon running, you
# allowed to drive it (the operator), signed in (the sign-in link), on, and
# the tailnet's MagicDNS and HTTPS certificates on (the admin page where each
# is turned on, when one's off). More than one account on a machine (fast
# user switching): which one is in use, and a switch; your other machines on
# another tailnet than this one's is said. What needs root (installing,
# starting the daemon, the operator) is done only in a terminal, asked first;
# elsewhere it says what to run.

TS_ADMIN_DNS = "https://login.tailscale.com/admin/dns"
TS_ADMIN_MACHINES = "https://login.tailscale.com/admin/machines"
TS_LINUX = "https://tailscale.com/download/linux"


def tailscale_cli(*args, timeout=8):
    """tailscale <args> on this computer (the system's, or amarchy's own
    node's: tailscale_argv): (exit code, what it printed), 127 when there's
    none."""
    try:
        r = subprocess.run(tailscale_argv(list(args)), capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL)
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except FileNotFoundError:
        return 127, ""
    except subprocess.TimeoutExpired:
        return 124, "tailscale didn't answer in time"


def tailscale_state():
    """Where Tailscale stands on this machine: {"installed", "running" (its
    daemon answers), "state" (Running, NeedsLogin, NeedsMachineAuth, Stopped,
    Starting), "operator" (you may drive it), "account", "tailnet", "name"
    (this machine's address), "magicdns", "https", "auth_url" (the sign-in
    link, while one is under way), "accounts" [{id, account, tailnet,
    selected}], "elsewhere" (your machines on another tailnet: [{name,
    suffix}]), "omarchy", "node" ("system", or "own": amarchy's own node, track
    H), "ready", "steps"}: steps, what's left in order, each {"do", "words",
    and a "url" to open or a "command" to run ("root": it needs sudo); one
    marked "alt" is another way to the step before it."""
    import pwd
    me = pwd.getpwuid(os.getuid()).pw_name
    omarchy = bool(shutil.which("omarchy-install-service-tailscale"))
    # Which Tailscale: the system's when its daemon answers (or it's there
    # and amarchy has no node of its own); else amarchy's own node, when
    # it's built here; else none yet.
    own_only = (host_setting("TAILSCALE") or "").lower() == "own"      # (track H's: the system's set aside)
    system = not own_only and (system_tailscale() or (bool(shutil.which("tailscale")) and not tailnet_bin()))
    node = "system" if system else "own" if tailnet_bin() else None
    out = {"installed": node is not None, "running": False, "state": None, "operator": None,
           "account": None, "tailnet": None, "name": None, "magicdns": None, "https": None, "auth_url": None,
           "accounts": [], "elsewhere": [], "omarchy": omarchy, "node": node, "ready": False, "steps": []}
    steps = out["steps"]
    if node is None:
        # amarchy's own node first (nothing else to install: amarchy builds
        # it), the system's Tailscale the other way.
        steps.append({"do": "own-install", "words": "Use amarchy's own Tailscale node: nothing else to install",
                      "command": str(Path(SELF).parent.parent / "tailnet/install.sh"), "root": False})
        if omarchy:
            cmd = "omarchy-install-service-tailscale"
        elif shutil.which("pacman"):
            cmd = (f"sudo pacman -S --needed tailscale && sudo systemctl enable --now tailscaled "
                   f"&& sudo tailscale set --operator={me}")
        else:
            cmd = None
        steps.append({"do": "install", "words": "Or install the system's Tailscale", "command": cmd,
                      "url": None if cmd else TS_LINUX, "root": True, "alt": True})
        return out
    if node == "own" and not (TAILNET_SOCKET.exists() and (tailnet_status_words() or {}).get("running")):
        steps.append({"do": "own-start", "words": "Start amarchy's own Tailscale node",
                      "command": f"systemctl --user enable --now {TAILNET_UNIT}", "root": False})
        return out
    code, said = tailscale_cli("status", "--json", "--peers=false")
    try:
        status = json.loads(said) if code == 0 or said.lstrip().startswith("{") else None
    except ValueError:
        status = None
    if not isinstance(status, dict) or not status.get("BackendState"):
        steps.append({"do": "start", "words": "Start Tailscale's service", "command": "sudo systemctl enable --now tailscaled",
                      "root": True})
        return out
    out["running"] = True
    code, said = tailscale_cli("debug", "prefs")
    try:
        prefs = json.loads(said) if code == 0 else {}
    except ValueError:
        prefs = {}
    out["operator"] = os.geteuid() == 0 or prefs.get("OperatorUser") == me or node == "own"     # (its node is yours)
    state = status.get("BackendState")
    tailnet = status.get("CurrentTailnet") or {}
    selfnode = status.get("Self") or {}
    user = (status.get("User") or {}).get(str(selfnode.get("UserID"))) or {}
    out.update(state=state, account=user.get("LoginName") or None, tailnet=tailnet.get("Name") or None,
               name=(selfnode.get("DNSName") or "").rstrip(".") or None,
               magicdns=bool(tailnet.get("MagicDNSEnabled")) if tailnet else None,
               https=bool(status.get("CertDomains")) if state == "Running" else None,
               auth_url=status.get("AuthURL") if re.match(r"https://login\.tailscale\.com/", status.get("AuthURL") or "") else None)
    code, said = tailscale_cli("switch", "--list", "--json")
    try:
        profiles = json.loads(said) if code == 0 else []
    except ValueError:
        profiles = []
    out["accounts"] = [{"id": str(p.get("id") or ""), "account": str(p.get("account") or p.get("nickname") or ""),
                        "tailnet": str(p.get("tailnet") or ""), "selected": bool(p.get("selected"))}
                       for p in profiles if isinstance(p, dict) and p.get("id")] if isinstance(profiles, list) else []
    # Driving it (signing in, turning it on, switching accounts) needs you
    # allowed to, but only when one of those is to be done.
    if not out["operator"] and (state in ("NeedsLogin", "Stopped") or len(out["accounts"]) > 1):
        steps.append({"do": "operator", "words": "Let amarchy drive Tailscale as you",
                      "command": f"sudo tailscale set --operator={me}", "root": True})
    if state == "NeedsLogin":
        steps.append({"do": "login", "words": "Sign in to Tailscale", "url": out["auth_url"]})
    elif state == "NeedsMachineAuth":
        steps.append({"do": "approve", "words": "Approve this machine in Tailscale's admin", "url": TS_ADMIN_MACHINES})
    elif state == "Stopped":
        steps.append({"do": "up", "words": "Turn Tailscale on"})
    elif state == "Running":
        if not out["magicdns"]:
            steps.append({"do": "magicdns", "words": "Turn on MagicDNS for your tailnet", "url": TS_ADMIN_DNS})
        if not out["https"]:
            steps.append({"do": "https", "words": "Turn on HTTPS certificates for your tailnet", "url": TS_ADMIN_DNS})
        suffix = tailnet.get("MagicDNSSuffix") or status.get("MagicDNSSuffix") or ""
        for m in machines_read():
            host = urllib.parse.urlsplit(m["url"]).hostname or ""
            if suffix and host.endswith(".ts.net") and not host.endswith("." + suffix):
                out["elsewhere"].append({"name": m["label"], "suffix": host.split(".", 1)[1]})
        if out["elsewhere"]:
            others = ", ".join(f"{e['name']} ({e['suffix']})" for e in out["elsewhere"])
            steps.append({"do": "switch", "words": f"Your machines are on another tailnet: {others}. Switch this one to "
                                                   "the account they're on"})
    out["ready"] = state == "Running" and bool(out["magicdns"]) and bool(out["https"]) and not out["elsewhere"]
    return out


def tailscale_login(wait=10):
    """Start signing in (tailscale up, left running until it's done, as
    Omarchy's panel does) and the sign-in link, once Tailscale has one: (link,
    the process) or (None, why)."""
    st = tailscale_state()
    if st["auth_url"]:
        return st["auth_url"], None
    if st["state"] != "NeedsLogin":
        return None, "Tailscale is signed in already" if st["running"] else "Tailscale isn't running"
    if not st["operator"]:
        return None, "Tailscale doesn't let amarchy drive it yet: sudo tailscale set --operator=" + os.environ.get("USER", "you")
    if st["node"] == "own":     # amarchy's own node: its own sign-in (amarchy-tailnet login)
        try:
            r = subprocess.run([tailnet_bin(), "login", "--no-open"], capture_output=True, text=True, timeout=wait + 20,
                               stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as e:
            return None, f"amarchy's own node gave no sign-in link ({e})"
        url = next((w for w in r.stdout.split() if re.match(r"https://login\.tailscale\.com/", w)), None)
        return (url, None) if url else (None, (r.stdout + r.stderr).strip()[:300] or "amarchy's own node gave no sign-in link")
    p = subprocess.Popen(tailscale_argv(["up", "--timeout=15m"]), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    end = time.time() + wait
    while time.time() < end:        # the link shows in its status within a moment
        time.sleep(0.3)
        st = tailscale_state()
        if st["auth_url"] or st["state"] == "Running":
            return st["auth_url"], p
        if p.poll() not in (None, 0):
            break
    return None, "Tailscale gave no sign-in link (try tailscale up in a terminal)"


def tailscale_own_start():
    """amarchy's own node started, now and from each login (a user service:
    no root). None, or why not."""
    r = sh("systemctl", "--user", "enable", "--now", TAILNET_UNIT)
    if r.returncode != 0:
        return (r.stderr or r.stdout).strip()[:300] or f"systemctl couldn't start {TAILNET_UNIT}"
    for _ in range(40):         # its socket, once it's up
        if TAILNET_SOCKET.exists():
            _tailnet_own["at"] = 0
            return None
        time.sleep(0.25)
    return f"{TAILNET_UNIT} started, but its node isn't answering yet (amarchy-tailnet status)"


def tailscale_up():
    """Tailscale on again (it was turned off): None, or why not."""
    code, said = tailscale_cli("up", "--timeout=30s", timeout=40)
    return None if code == 0 else (said.strip().splitlines() or ["tailscale up failed"])[-1][:300]


def tailscale_switch(which):
    """Switch to another of the accounts signed in here (an id, an account,
    or a tailnet, as tailscale switch takes them): None, or why not."""
    st = tailscale_state()
    found = next((a for a in st["accounts"] if which in (a["id"], a["account"], a["tailnet"])), None)
    if not found:
        return f"no account {which!r} here (" + ", ".join(a["account"] for a in st["accounts"]) + ")"
    if found["selected"]:
        return None
    code, said = tailscale_cli("switch", found["id"], timeout=30)
    return None if code == 0 else (said.strip().splitlines() or ["tailscale switch failed"])[-1][:300]


def tailscale_words(st):
    """Where Tailscale stands, in a line."""
    if not st["installed"]:
        return "No Tailscale here yet"
    if st.get("node") == "own":
        return "amarchy's own node: " + (tailscale_words({**st, "node": "system"}) if st["running"] else "not running")
    if not st["running"]:
        return "Tailscale's service isn't running"
    state = st["state"]
    who = f", as {st['account']}" if st["account"] else ""
    if state == "Running":
        checks = f"MagicDNS {'on' if st['magicdns'] else 'off'}, HTTPS {'on' if st['https'] else 'off'}"
        return f"On: {st['name'] or 'this machine'}{who}. {checks}"
    return {"NeedsLogin": "Not signed in", "NeedsMachineAuth": f"Signed in{who}, waiting for the machine's approval",
            "Stopped": f"Off{who}", "Starting": f"Starting{who}"}.get(state, f"{state}{who}")


def cmd_tailscale(args):
    """`amarchy tailscale [--json] [--no-open] | switch <account>`."""
    as_json, no_open = "--json" in args, "--no-open" in args
    args = [a for a in args if a not in ("--json", "--no-open")]
    if args[:1] == ["switch"]:
        if len(args) != 2:
            st = tailscale_state()
            for a in st["accounts"]:
                print(f"{'*' if a['selected'] else ' '} {a['account']}\t{a['tailnet']}\t{a['id']}")
            return 0 if st["accounts"] else fail("no accounts signed in here")
        why = tailscale_switch(args[1])
        if why:
            return fail(why)
        print(tailscale_words(tailscale_state()))
        return 0
    if args:
        return fail("usage: amarchy tailscale [--json] [--no-open] | switch [<account>]")
    st = tailscale_state()
    if as_json:
        print(json.dumps(st, indent=1))
        return 0
    tty = sys.stdin.isatty() and sys.stdout.isatty()
    display = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")) and shutil.which("xdg-open")

    def show(url):
        print(f"  {url}")
        if display and not no_open:
            subprocess.Popen(["xdg-open", url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)

    def ask(question):
        if not tty:
            return False
        try:
            return input(f"{question} [Y/n] ").strip().lower() in ("", "y", "yes")
        except EOFError:
            return False

    for _ in range(6):      # each step done takes it to the next
        step = st["steps"][0] if st["steps"] else None
        if not step or step["do"] in ("magicdns", "https", "switch"):
            break
        print(f"{tailscale_words(st)}. Next: {step['words']}.")
        if step["do"] == "own-start":       # a user service of amarchy's: no root, nothing to ask
            why = tailscale_own_start()
            if why:
                return fail(why)
        elif step["do"] == "own-install":
            # amarchy's own node, or else the system's Tailscale (the step after it).
            other = next((s for s in st["steps"] if s.get("alt")), None)
            if ask(f"Set up amarchy's own Tailscale node now? It's built here (with Go, asked first): `{step['command']}`"):
                if subprocess.run([step["command"]]).returncode != 0:
                    return fail("amarchy's own node: that didn't work")
            elif other and other.get("command") and ask(f"Then install the system's Tailscale: `{other['command']}`"
                                                        " (it asks for your password)?"):
                if subprocess.run(["sh", "-c", other["command"]]).returncode != 0:
                    return fail("installing Tailscale didn't work")
            else:
                print(f"  amarchy's own node (nothing else to install): {step['command']}")
                if other:
                    print(f"  Or the system's Tailscale: {other.get('command') or other.get('url')}")
                return 1
        elif step.get("command"):
            if not ask(f"Run `{step['command']}` now (it may ask for your password)?"):
                print(f"  Run it in a terminal: {step['command']}")
                return 1
            if subprocess.run(["sh", "-c", step["command"]]).returncode != 0:
                return fail(f"{step['words']}: that didn't work")
        elif step["do"] == "install":
            print(f"  How to install it here: {step['url']}")
            return 1
        elif step["do"] == "login":
            url, p = tailscale_login()
            if not url:
                return fail(p)
            print("  Sign in at:")
            show(url)
            if not tty:
                return 0        # it goes on in the background, signed in once you've done it
            print("  Waiting until you've signed in…")
            if p is not None:
                p.wait()
            else:               # amarchy's own node: until its state says so (ten minutes at most)
                end = time.time() + 600
                while time.time() < end and tailscale_state()["state"] == "NeedsLogin":
                    time.sleep(2)
        elif step["do"] == "approve":
            print("  Approve it at:")
            show(step["url"])
            return 1
        elif step["do"] == "up":
            why = tailscale_up()
            if why:
                return fail(why)
        st = tailscale_state()
    print(f"{tailscale_words(st)}.")
    left = [s for s in st["steps"] if s["do"] in ("magicdns", "https")]
    if left:
        print(f"  {' and '.join(s['words'].replace(' for your tailnet', '') for s in left)} for your tailnet, at:")
        show(TS_ADMIN_DNS)
    if st["elsewhere"]:
        print("  " + next(s["words"] for s in st["steps"] if s["do"] == "switch") + ":")
        for a in st["accounts"]:
            print(f"    amarchy tailscale switch {a['account']}{'   (in use)' if a['selected'] else ''}")
        print("    (another account: tailscale login)")
    elif len(st["accounts"]) > 1:
        print("  Accounts here: " + ", ".join(f"{a['account']}{' (in use)' if a['selected'] else ''}" for a in st["accounts"])
              + "; amarchy tailscale switch <account>" + (", or Omarchy's Tailscale panel in the bar" if st["omarchy"] else ""))
    if st["ready"]:
        print("  Ready: your phone and your other machines reach this one by its name, over HTTPS.")
    return 0 if st["ready"] else 1


# ---- a chat in Ghostty
#
# A chat's menu → Advanced → Open in Ghostty (`amarchy ghostty <id>` here)
# opens a chat of this machine's in a real Ghostty window on this machine's
# desktop: tmux attached to its session (its terminal, or with claude,
# Claude's pane), as the app's terminals are. One window per chat: again,
# the one it has comes to the front (Hyprland).

GHOSTTY_HERE = {"at": 0, "here": False}


def display_env():
    """The environment a window opens in on this machine's desktop:
    Hyprland's (hypr_env), else a Wayland or X display it has; None when it
    has none (a server)."""
    env = hypr_env()
    if env:
        return env
    env = dict(os.environ)
    if env.get("WAYLAND_DISPLAY") or env.get("DISPLAY"):
        return env
    found = sorted(Path(env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}").glob("wayland-[0-9]"))
    if found:
        env["WAYLAND_DISPLAY"] = found[0].name
        return env
    return None


def ghostty_here():
    """Whether a chat here can open in Ghostty: Ghostty installed, and a
    desktop to open it on (looked at again every half minute)."""
    if time.time() - GHOSTTY_HERE["at"] > 30:
        GHOSTTY_HERE.update(at=time.time(), here=bool(shutil.which("ghostty")) and display_env() is not None)
    return GHOSTTY_HERE["here"]


def ghostty_open(s, which="term"):
    """Chat s (this machine's) in a Ghostty window: the one it has to the
    front, else a new one attached to its tmux. None, or why not."""
    if which not in ("term", "claude"):
        return "term or claude"
    if not shutil.which("ghostty"):
        return "Ghostty isn't installed here"
    env = display_env()
    if env is None:
        return f"{machine_label()} has no desktop to open a window on"
    # Its own window class (a GTK application id), so it's found again.
    cls = "dev.amarchy." + ("term-" if which == "term" else "claude-") + re.sub(r"[^A-Za-z0-9_-]", "_", s["id"])[:80]
    for address in hypr_windows(cls, env)[:1]:
        hypr_focus(address, env)
        return None
    title = f"{s.get('title') or s.get('name') or s['id']} · {'Claude' if which == 'claude' else 'terminal'} · amarchy"
    launch_app(["ghostty", f"--class={cls}", f"--title={title}", "-e", ENTRY, "attach", s["id"], which], env)
    return None


def cmd_ghostty(args):
    """`amarchy ghostty [<id>] [term|claude]`."""
    which = next((a for a in args if a in ("term", "claude")), "term")
    ids = [a for a in args if a not in ("term", "claude")]
    sid = ids[0] if ids else os.environ.get("AMARCHY_SESSION", "")
    if len(ids) > 1 or not sid:
        return fail("usage: amarchy ghostty [<id>] [term|claude] (from a chat's terminal, that chat)")
    s = session(sid)
    if not s:
        m = CHAT_LINK.fullmatch(sid) or re.fullmatch(r"([a-z0-9][a-z0-9-]{0,62})[:/]([\w][\w.-]{0,119})", sid)
        return fail(f"{m.group(2)} is on {m.group(1)}: open it in Ghostty there" if m and m.group(1) != machine_name()
                    else f"no chat {sid} on this machine")
    why = ghostty_open(s, which)
    return fail(why) if why else 0


# ------------------------------------------------------------------ the chat engine (amarchy agent)
#
# Phases A1 and A2 of docs/plan-chat-app.md. Any session can opt in ("Try
# the new chat" in its menu, or amarchy agent engine <id> chat) and go back.
# A session's engine is "terminal" (Claude Code's TUI, as every session runs
# by default) or "chat": then its Claude pane runs
# `amarchy agent <id>`, a broker around `claude -p` with stream-json in and
# out (the control protocol the Agent SDKs speak; docs/agent-protocol.md has
# what it does, checked by bin/amarchy-protocol-test). The broker:
#
# - keeps Claude's conversation where the TUI keeps it (the same transcript,
#   --resume both ways), with amarchy's hooks, so the list, the app's chat,
#   sleep and send see a session as they always have;
# - writes live.json beside it: what the transcript can't have yet (state,
#   the questions and permissions waiting, the text being written, the tool
#   under way, background tasks, usage limits, model and mode, the messages
#   queued for Claude);
# - listens on a unix socket for messages, answers, Stop and the rest
#   (agent_call), one JSON line each way;
# - draws the conversation as it goes in its tmux pane, and takes what's
#   typed or pasted there (the app's composer, amarchy send) as a message, or
#   as the answer to what Claude asks.
#
# Claude runs with the subscription login: ANTHROPIC_API_KEY and
# ANTHROPIC_AUTH_TOKEN never reach it (with one, -p bills that API account).

AGENT_ARGS = ("-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
              "--include-partial-messages", "--include-hook-events", "--replay-user-messages",
              "--permission-prompt-tool", "stdio")
API_CREDENTIALS = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")
AGENT_LIVE_EVERY = 0.15     # seconds between two writes of live.json while text streams in
AGENT_STREAM_MAX = 20_000_000   # bytes of stream.jsonl (Claude's raw output) kept, the older half dropped
AGENT_MODES = ("default", "acceptEdits", "plan", "auto", "dontAsk", "bypassPermissions")


ENGINES = ("chat", "terminal")
ENGINE_CHECK_FILE = STATE / "engine-check.json"  # the protocol test's last result, for the Claude Code it ran on (see protocol_problem)
CLASSIC_HOLD = 60   # seconds the app's classic terminal keeps a session on the TUI after its last look (see classic_viewed)


def engine(s):
    """How a session's Claude runs right now: "chat" (amarchy agent, the only
    chat there is) or "terminal" (Claude Code's TUI: Claude's classic terminal,
    for what the chat can't do, while the app has it open). A session with no
    "engine" in its record runs on the TUI, as every session did before the chat
    engine, and moves to the chat (follow_engines)."""
    return "chat" if s.get("engine") == "chat" else "terminal"


def classic_viewed(sid):
    """Whether the app has Claude's classic terminal open on the session right
    now: its heartbeat (the classic file, touched while it's open) is recent."""
    try:
        return time.time() - (claude_dir(sid) / "classic").stat().st_mtime < CLASSIC_HOLD
    except OSError:
        return False


def protocol_problem():
    """Why the default isn't the chat engine because the protocol test failed,
    else None. The test records its result for a Claude Code version
    (ENGINE_CHECK_FILE); one that failed on this version keeps new sessions
    on the terminal engine until it passes (amarchy update runs it again)."""
    try:
        check = json.loads(ENGINE_CHECK_FILE.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(check, dict) or check.get("ok") is not False:
        return None
    return check.get("why") or "the chat engine's protocol test failed"


def settle_engine(s):
    """Before a session's Claude starts (its pane starts it, or it wakes), a
    session with nothing running starts on the chat engine, unless the
    classic terminal is open on the app for it right now. Returns the session."""
    if engine(s) != "chat" and not claude_driver(s["id"]) and not classic_viewed(s["id"]):
        s["engine"] = "chat"
        save_session(s)
    return s


def claude_driver(sid):
    """What runs the session's conversation now, if anything: {pid, engine,
    claude_pid} of the TUI's Claude (amarchy claude, become claude) or of
    the broker and its claude -p. Each says the session in its arguments."""
    try:
        d = json.loads((claude_dir(sid) / "driver").read_text())
    except (OSError, ValueError):
        return None
    for pid in (d.get("pid"), d.get("claude_pid")) if isinstance(d, dict) else ():
        if not isinstance(pid, int) or pid == os.getpid():
            continue
        args = cmdline(pid)
        if f"hook {sid} " in " ".join(args) or any(a == sid and args[i - 1] in ("claude", "agent")
                                                   for i, a in enumerate(args) if i):
            return d
    return None


def claim_driver(sid, kind, wait=15):
    """Make this process the one that runs the session's conversation: one
    Claude at a time on it, the TUI's or the chat engine's, or both would
    write it. One that's going away (its pane restarted, the engine switched)
    has wait seconds to go. None once it's ours, else what still runs it."""
    d = claude_dir(sid)
    d.mkdir(parents=True, exist_ok=True)
    end = time.time() + wait
    while True:
        with open(d / "driver.lock", "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            other = claude_driver(sid)
            if not other:
                write_file(d / "driver", json.dumps({"pid": os.getpid(), "engine": kind, "since": time.time()}))
                return None
        if time.time() > end:
            return other
        time.sleep(0.2)


def agent_live_file(sid):
    return claude_dir(sid) / "live.json"


def agent_socket(sid):
    """The broker's socket: beside its state, unless that path is too long for
    a unix socket (108 bytes), then in the runtime folder."""
    p = claude_dir(sid) / "agent.sock"
    if len(str(p).encode()) < 100:
        return p
    run = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
    return run / f"amarchy-agent-{hashlib.sha1(sid.encode()).hexdigest()[:16]}.sock"


def agent_live(sid):
    try:
        return json.loads(agent_live_file(sid).read_text())
    except (OSError, ValueError):
        return {}


def live_tasks(live):
    """What a chat's Claude runs in the background now (live.json's tasks):
    nothing once its broker has stopped (asleep, a crash, a restart), as what
    it ran stopped with it."""
    pid = live.get("pid")
    up = live.get("state") != "exited" and isinstance(pid, int) and Path(f"/proc/{pid}").exists()
    return [t for t in live.get("tasks") or [] if isinstance(t, dict)] if up else []


def live_cut(live):
    """What a chat's Claude ran in the background when it stopped, that never
    reached its end (a test run, a CI watch, a helper; not a server, which
    sleep stops by design): Claude Code won't say it ended, so its Claude
    would wait for it forever. live.json's cut (Agent.claude_ended), and what
    a broker that's gone without saying so (killed outright, a reboot) still
    lists as running. Told to its Claude with the next message (Agent.deliver)."""
    cut = [t for t in live.get("cut") or [] if isinstance(t, dict)]
    if live.get("tasks") and not live_tasks(live):
        cut += [t for t in live["tasks"] if isinstance(t, dict) and not task_serves(t)]
    return cut


CUT_KEEP = 5        # runs cut kept for the next Claude to be told of, the latest


def cut_note(cut):
    """What a chat's Claude is told, after the next message, of what it ran
    in the background that stopped with the Claude before it (live_cut): a
    reminder the chat doesn't show (user_item). Without it, it would wait for
    a notification that never comes."""
    lines = []
    for t in cut[-CUT_KEEP:]:
        what = task_words(t)
        command = " ".join(str(t.get("command") or "").split())[:300]
        lines.append(f"- {what}" + (f" (`{command}`)" if command and command != what else ""))
    one = len(lines) == 1
    return ("<system-reminder>\namarchy: your Claude Code stopped since your last turn (it slept, restarted or "
            f"crashed), and what you left running in the background stopped with it, before it ended:\n"
            + "\n".join(lines) + f"\nNo notification will come for {'it' if one else 'them'}, and "
            f"{'its' if one else 'their'} output may be cut short or gone. Run {'it' if one else 'them'} again "
            "if you still need to, then go on.\n</system-reminder>")


# A turn cut off: Claude was stopped in the middle of one (the machine ran
# out of memory, it restarted, Claude crashed), so it never ended with a
# result. Told by Claude's own output (stream.jsonl): the last of it that says
# anything about a turn is a turn under way (Claude writing, a tool's
# answer, a message going in), not a result. What a Claude writes as it
# starts (init, its hooks, amarchy's control requests) and a turn's
# "completed" after its result say nothing either way.
TURN_CUT_READ = 1 << 20     # bytes read from the end of stream.jsonl at a time
TURN_CUT_QUIET = 10         # seconds still before a turn under way counts as cut off (it may just be starting)
_turn_cut = {}              # sid -> ((size, mtime), cut)


def turn_record(o):
    """What a line of stream.jsonl says of a turn: "end", "on", or None."""
    if not isinstance(o, dict):
        return None
    kind = o.get("type")
    if kind == "result":
        return "end"
    if kind in ("assistant", "user", "stream_event"):
        return "on"
    if kind == "command_lifecycle":
        return "on" if o.get("state") in ("queued", "started") else None
    if kind == "system":
        return "on" if o.get("subtype") in ("thinking_tokens", "task_started", "task_progress") or o.get("status") == "requesting" else None
    sent = o.get("_sent")
    if isinstance(sent, dict) and sent.get("type") == "user":
        return "on"
    return None


def turn_cut(sid):
    """Whether the session's last turn was cut off before it ended (see
    above): what its stream.jsonl says, read once per change of it."""
    f = claude_dir(sid) / "stream.jsonl"
    try:
        st = f.stat()
    except OSError:
        return False
    key = (st.st_size, st.st_mtime_ns)
    known = _turn_cut.get(sid)
    if known and known[0] == key:
        return known[1]
    cut, said = False, None
    try:
        with open(f, "rb") as fh:
            end, rest = st.st_size, b""
            while end > 0 and said is None and st.st_size - end < 8 * TURN_CUT_READ:
                start = max(0, end - TURN_CUT_READ)
                fh.seek(start)
                data = fh.read(end - start) + rest
                lines = data.split(b"\n")
                rest = lines.pop(0) if start > 0 else b""     # most likely cut in half: read with what's before it
                for line in reversed(lines):
                    if not line.strip():
                        continue
                    try:
                        said = turn_record(json.loads(line))
                    except ValueError:
                        continue
                    if said:
                        break
                end = start
    except OSError:
        return False
    cut = said == "on"
    if len(_turn_cut) > 500:
        _turn_cut.clear()
    _turn_cut[sid] = (key, cut)
    return cut


def interrupted(s):
    """Whether a chat's last turn was cut off and nothing is carrying it on:
    it isn't working, waiting or running, its Claude's output has been still
    a while (a turn just starting isn't cut off), and its conversation didn't
    go on in Claude's classic terminal since."""
    if s.get("setup") or s.get("status") != "idle" or not turn_cut(s["id"]):
        return False
    try:
        stream = (claude_dir(s["id"]) / "stream.jsonl").stat().st_mtime
    except OSError:
        return False
    if time.time() - stream < TURN_CUT_QUIET and agent_up(s["id"]):
        return False
    f = transcript(s)
    try:
        return not f or f.stat().st_mtime < stream + 60
    except OSError:
        return True


def agent_up(sid, live=None):
    """Whether the session's broker is running (its live state says its pid, and that's it)."""
    live = agent_live(sid) if live is None else live
    pid = live.get("pid")
    return bool(isinstance(pid, int) and live.get("state") != "exited" and Path(f"/proc/{pid}").exists()
                and sid in cmdline(pid))


def agent_call(sid, request, timeout=40):
    """Ask the session's broker something: the answer (a dict, "ok" true or
    false with "error"). Raises OSError when it isn't there."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
        c.settimeout(timeout)
        c.connect(str(agent_socket(sid)))
        c.sendall((json.dumps(request) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = c.recv(65536)
            if not chunk:
                break
            data += chunk
    try:
        return json.loads(data)
    except ValueError:
        return {"ok": False, "error": "no answer from the broker"}


def claude_resume(s):
    """How a session's Claude picks its conversation back up: the one it was
    in, else the latest of its own in its folder (sessions from before amarchy
    kept track), else none."""
    if transcript(s):
        return ["--resume", conversation_id(s["id"])]
    # (Claude's --continue takes the folder's latest: only when that one is its own.)
    mine, logs = latest_conversation(s), list(projects_dir(s["path"]).glob("*.jsonl"))
    if not mine:
        return []
    try:
        newest = max(logs, key=lambda f: f.stat().st_mtime)
    except (OSError, ValueError):
        return []
    return ["--continue"] if newest == mine else ["--resume", mine.stem]


def agent_argv(s):
    """claude -p for the session's broker: the protocol, the user's own
    claude arguments, its conversation, amarchy's hooks."""
    return ["claude", *AGENT_ARGS, *CLAUDE_ARGS, *claude_resume(s), *reply_format_args(s),
            "--settings", hook_settings(s["id"])]


def agent_env(s=None):
    env = {k: v for k, v in os.environ.items() if k not in INHERITED_CLAUDE_ENV + API_CREDENTIALS}
    env["PATH"] = paste_path()
    if s:
        env.update(secret_env(s))       # the project's secrets (see "secrets"); never an API credential
    return env


def agent_status(sid, state, done=True):
    """The session's status, as its hooks set it (cmd_hook), for what Claude's
    hooks don't say under -p: that it waits for an answer, that it's working
    again once it has one, and that it's idle after a turn that ended with no
    Stop hook (you stopped it, or it failed)."""
    if session(sid) and not (CLOSING / f"{sid}.json").exists():
        set_status(sid, state, done)


def tool_line(name, given):
    """A tool call in a few words, for the pane: what Claude says it does, or
    the gist of its input."""
    given = given if isinstance(given, dict) else {}
    what = (given.get("description") or given.get("file_path") or given.get("to") or given.get("path") or given.get("pattern")
            or given.get("query") or given.get("url") or given.get("command") or given.get("prompt") or "")
    what = " ".join(str(what).split())
    return f"{name}: {what}" if what else name


TITLE_PROMPT = """Give this coding session a title: what it's about, in 3 to 7 words, as a short sentence in sentence case, like "Fix login redirect loop after OAuth" or "Add dark mode toggle to settings". In the language of the request. Reply with the title only: no quotes, no period.

The session starts with this request:
{text}"""


def conversation_title(text):
    """A title for a conversation, from its first message (Haiku), or None."""
    try:
        r = subprocess.run(
            ["claude", "-p", "--model", "haiku", "--no-session-persistence", "--setting-sources", "", "--tools", "",
             "--strict-mcp-config", TITLE_PROMPT.format(text=text[:3000])],
            capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL, env=agent_env(), cwd=STATE)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = [l.strip() for l in r.stdout.strip().splitlines() if l.strip()]
    title = lines[0].strip("\"'`*#. ") if r.returncode == 0 and len(lines) == 1 else ""
    return title if 0 < len(title) <= 80 else None


# An old conversation's replies may be calls to update_brief, the tool amarchy
# once had Claude write each reply with (until 2026-11): app_items shows them
# as the text they held (brief_text).
BRIEF_TOOL = "mcp__amarchy__update_brief"


# ---- the reply format: how Claude writes, for the app to show as it is
#
# Given at every start (--append-system-prompt, both engines): a reply leads
# with its outcome, then markdown (sections, lists, tables, links), and the
# blocks of app/blocks.json (the catalog: what each is for, its attributes,
# its body), which the app draws in their place with buttons (chat.js
# claudeView) and the Stop hook checks (reply_issues). What Claude wrote is
# what you read, every word of it, in its order: nothing summarized, folded
# away or moved.

def blocks_guidance(skip=(), rules=None):
    """The catalog's blocks, as the reply format shows them to Claude: an
    example of each (the short ones on one line), then their rules. skip:
    kinds left out; rules: a kind's rule said another way (CHAT_FORMAT's)."""
    def fence(b):
        ex = b.get("example", {})
        head = f"```{b['kind']}{' ' + ex['attrs'] if ex.get('attrs') else ''}"
        body = [f"  {line}" for line in (ex.get("body") or "").split("\n") if ex.get("body")]
        return [f"  {head}", *body, "  ```"]
    shown = [b for b in block_catalog()["blocks"] if not b.get("hidden") and not b.get("old") and b["kind"] not in skip]      # (old: still drawn, no longer asked for)
    out = []
    for b in shown:
        if not b.get("short"):
            out += [f"  {b['for'][0].upper()}{b['for'][1:]}:", *fence(b)]
    short = [b for b in shown if b.get("short")]
    if short:
        out.append("  (also " + " and ".join(f"```{b['kind']} {b['example']['attrs']}``` for {b['for']}" for b in short) + ")")
    for b in shown:
        rule = (rules or {}).get(b["kind"], b.get("rule"))
        if rule:
            out.append(f"- {rule}")
    return "\n".join(out)


def goal_guidance():
    b = block_kinds()["goal"]
    return "\n".join([f"- {b['rule']}", *[f"  {line}" for line in [f"```goal {b['example']['attrs']}", b["example"]["body"], "```"]]])


REPLY_FORMAT = f"""amarchy shows the person your replies as you write them, rendered as markdown, on their phone or computer: every word, in your order, nothing summarized or moved (a long reply's sections folded under their headings). Write each reply (your final message of a turn, not your working notes in between) to be read there. It holds whatever else says how to end or style a reply (a persona, a project's closing line): keep that voice and content, and use these blocks, because buttons come only from them.

- Lead with the outcome in one plain sentence, as you'd say it to them. No greeting, no "Here's...".
- A reply that fits in a few lines (under {REPLY_LONG} words) is just that: the outcome, and what they need with it.
- Anything longer is read at a glance or not at all, so give it this shape, every time, in this order. The app shows it as three parts: Briefing, Action items, Content.
  1. Your opening sentence (at most {REPLY_LEAD} words), then the brief block.
  2. What they act on, as buttons: your choices (every decision they have to make is one) and what they'll use (a link, a command, a draft). What they need to do, in words, is the brief's You row, not a list here. Nothing to tap: nothing here.
  3. The content: every idea under its own "## " heading, nothing without one. The app shows only the headings, folded, and they open the ones they want: so the heading states the point itself in a few words ("## Tests pass on phone and wide", not "## Testing"), and the headings alone tell the story. Under each, only what backs that point: short bullets or two or three short sentences (at most {SECTION_MAX} words; split a longer one), a table for any comparison or side-by-side data, links as [words](url), code in fenced blocks. Every finding, number, name, link and caveat they need is in some section, with its reason. What they must see or do never goes only in a section: it's folded.
- Anything they will use goes in a fenced block named for it, where it belongs in the reply; the app draws it there with its buttons (Copy, Open in WhatsApp, Add to calendar, a chart...). Attributes go on the opening line as key="value", in straight double quotes; title="..." and note="..." fit any block:
{blocks_guidance()}
- A link for them to open goes in a link block; a date to keep, in an event block.
- When your turn ends, amarchy checks your blocks: one it can't draw (a date that isn't one, a question with no options, an attribute it doesn't know) is sent back to you to fix.
- Something live for them to look at: a dev server, register it as the chat's preview instead of starting it in your shell (`amarchy preview --run '<command>' <url>`: amarchy runs it, keeps it through your sleep, and stops it when the chat is completed); a deploy, `amarchy preview <url>`. Either puts a Preview button on this chat and its card that stays, so they never ask for the address or look for it in the conversation (it starts the server again when it isn't running). Two or more to look at (an app and its admin, a storybook): register each with `--name <what it is>`, and the button is Previews, a list to pick from. Run it again when the address changes, and `amarchy preview --clear` when you stop serving it for good. Still give it in a link block when it's new.
- Sources you used are the last section, "## Sources", as links.
- What a timer, a script or another chat sent you, not them, when it leaves nothing they'd want to see (a check that found nothing): reply {SILENT} alone, with no goal block (a few words of why after it are kept for you, never shown). amarchy hides that whole turn: no notification, the chat as it was. Never to what they wrote themselves.
{goal_guidance()}
- When your turn ends, amarchy checks that shape too: a long reply in one piece, a section that runs on, a missing brief block, or a brief or choices block after a heading is sent back to you to write again.
- Never put what they need only in an earlier message: each reply stands on its own."""
FORMAT_VERSION = hashlib.sha1(REPLY_FORMAT.encode()).hexdigest()[:10]

# Your assistant's and your agents' (is_agent): the app shows their chats as a
# messaging app does (chat.js, bubbles), not as a working chat's replies, so
# they write as someone you text: short messages, no brief, no sections, no
# goal (they live on: nothing to finish). Their blocks are the same.
CHAT_FORMAT = f"""amarchy shows the person your messages in a chat that looks and works like WhatsApp, with superpowers: you're someone they text, not a report they read. Everything you write, at any point of your turn, reaches them as message bubbles from you, rendered as markdown (bold, lists, tables, links), with your blocks drawn in them as cards with buttons. It holds whatever else says how to talk to them (a persona, your project's own instructions): keep that voice and content.

- Write the way people text: several short messages, not one long one. A line holding only --- ends a message and starts the next, as hitting send would: each is a bubble of its own. One idea a message, the answer in the first, at most {CHAT_MESSAGE_MAX} words in each (a block, a table or code doesn't count). For example:
  Your 3 pm with Felipe moved to 4.
  ---
  He wants the deck before then. Want me to send it?
  ```choices question="Send Felipe the deck?"
  - Send it | Send Felipe the deck now
  - Not yet
  ```
- No headings, no brief, no goal block, no greeting before the point, no "Here's...". **Bold** the words that matter, a short list for a few items, a table for side-by-side data, a link where it helps.
- What you write between your steps reaches them too, as messages: only what you'd text a person ("On it, checking your inbox"), never your working notes. Or nothing, until you have the answer.
- What a timer, a script or another chat sent you, not them, when it leaves nothing they'd want to see (a check that found nothing, a merge not worth a post): end your turn with {SILENT} alone (a few words of why after it are kept for you, never shown). amarchy then hides that whole turn as if it never ran: no message, no notification, nothing unread. Anything they'd want to know or act on, say as usual. Never {SILENT} to what they wrote themselves.
- A long report doesn't belong in a chat: the gist in a few messages, then offer the rest (or send it as a file block).
- Anything they will use goes in a fenced block named for it, where it belongs in your message; the app draws it there with its buttons (Copy, Open in WhatsApp, Add to calendar, a chart...). Attributes go on the opening line as key="value", in straight double quotes; title="..." and note="..." fit any block:
{blocks_guidance(skip=("brief",), rules={"choices": "A question with a few clear answers (a yes or no, one of three) goes in a choices block, so they answer with a tap; any other question, just ask it."})}
- A link for them to open goes in a link block; a date to keep, in an event block; a picture you made, in a file block.
- When your turn ends, amarchy checks your messages: one over {CHAT_MESSAGE_MAX} words, a heading, or a block it can't draw is sent back to you to fix.
- Work that needs a chat of its own (code to write, something to build and ship): start one (`amarchy new <project> --prompt "<brief>"`), where they get the whole working view, and tell them in a line with its session block.
- What they need to do or decide later (a post to review, a form to sign) goes on their Tasks, not in a message they'd scroll past: a card on a board of yours (`amarchy board card`; a board of its own for a project, `amarchy board set`), or a one-off task (`amarchy task add`). What they comment on a card reaches you as their message, "About “<card>” (board <b>, card <k>): ...", and a task they write you there says its board and card: answer on the card, revising it (`amarchy board card <b> --key <k> ...`) or on its thread (`amarchy board comment <b> <k> "..."`), and help them get it done. Only they approve, edit as themselves or press its buttons: `amarchy board --help`."""
CHAT_VERSION = hashlib.sha1(CHAT_FORMAT.encode()).hexdigest()[:10]


def reply_format(s):
    """The format a session's Claude writes in: CHAT_FORMAT for your
    assistant and your agents, REPLY_FORMAT for every other chat."""
    return CHAT_FORMAT if s and is_agent(s) else REPLY_FORMAT


def format_version(s):
    """The version of the format a session's Claude should have (reply_format)."""
    return CHAT_VERSION if s and is_agent(s) else FORMAT_VERSION


def reply_format_args(s=None):
    """The reply format, for a session's Claude (both engines)."""
    return ["--append-system-prompt", reply_format(s)]


def claude_format_version():
    """Which reply format the Claude a hook runs for was started with: None
    for none, else the hash of its --append-system-prompt (FORMAT_VERSION
    when it's the current one)."""
    pid = os.getppid()
    for _ in range(6):
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
            if stat[stat.find("(") + 1:stat.rfind(")")] == "claude":
                args = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
                for i, a in enumerate(args[:-1]):
                    if a == b"--append-system-prompt":
                        text = args[i + 1].decode(errors="replace")
                        return hashlib.sha1(text.encode()).hexdigest()[:10] if text.startswith("amarchy shows") else None
                return None
            pid = int(stat[stat.rfind(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            return None
    return None


RELOAD_EVERY = 600     # seconds between two tries to start a session's Claude again for a newer reply format


def claude_reload(sid):
    """amarchy claude-reload <id>: start a session's Claude again, with the
    same conversation, so it gets what amarchy gives a Claude now (the reply
    format; the Stop hook starts this when the one it has is older). Only once
    it's idle and nothing would be lost (a turn, a question, a background
    task), waiting for that up to RELOAD_EVERY seconds, and at most once
    in that time."""
    mark = claude_dir(sid) / "format-reload"
    try:
        if time.time() - mark.stat().st_mtime < RELOAD_EVERY:
            return 0
    except OSError:
        pass
    write_file(mark, f"{time.time()}\n")
    end = time.time() + RELOAD_EVERY      # a quiet moment can take a while: its conversation settles after a turn
    while time.time() < end:
        time.sleep(5)
        s = session(sid)
        if not s or asleep_since(sid) is not None:
            return 0        # asleep, it wakes with the new one anyway
        try:
            status = (STATUS / sid).read_text().strip()
        except OSError:
            status = "idle"
        live = agent_live(sid) if engine(s) == "chat" else {}
        if status != "idle" or live.get("pending") or live.get("queue") or (live.get("state") not in (None, "idle")):
            continue
        if engine_blockers(s):
            continue
        pane = host_pane(s)
        if not pane:
            return 0
        stop_claude(pane)
        until = time.time() + 10
        while claude_driver(sid) and time.time() < until:
            time.sleep(0.1)
        host_respawn(session(sid) or s)
        return 0
    return 0


def human_message(text):
    """Whether a message in your name is one you wrote, not one Claude Code
    put there: a background task that ended, a message from another session,
    the summary a compacted conversation goes on from."""
    t = text.lstrip()
    if re.match(r"<(task-notification|cross-session-message|system-reminder|local-command|command-|bash-)", t):
        return False
    if t.startswith(HOOK_FEEDBACK):
        return False
    return not t.startswith("This session is being continued from a previous conversation")


def our_title(sid, f):
    """The title the chat engine gave the session's conversation in the
    transcript f (Agent.name_conversation), or ""."""
    try:
        t = json.loads((claude_dir(sid) / "title").read_text())
    except (OSError, ValueError):
        return ""
    ok = isinstance(t, dict) and t.get("conversation") == f.stem and isinstance(t.get("title"), str)
    return t["title"] if ok else ""


def chosen_model(sid):
    """The model chosen for a session (chosen.json), or None."""
    try:
        m = json.loads((claude_dir(sid) / "chosen.json").read_text()).get("model")
    except (OSError, ValueError, AttributeError):
        return None
    return m if isinstance(m, str) and re.fullmatch(MODEL_RE, m) else None


def chosen_effort(sid):
    """The effort chosen for a session (chosen.json: one of EFFORTS, or
    "auto"), or None."""
    try:
        return effort_choice(json.loads((claude_dir(sid) / "chosen.json").read_text()).get("effort"))
    except (OSError, ValueError, AttributeError):
        return None


def agent_remember(sid, **chosen):
    """The permission mode and model you chose (or that a plan approved left)
    outlive the session's Claude on the chat engine: it sleeps when idle, and
    wakes in them (Agent.restore). Not the TUI's: it starts in your claude
    arguments'."""
    f = claude_dir(sid) / "chosen.json"
    try:
        had = json.loads(f.read_text())
    except (OSError, ValueError):
        had = {}
    had = had if isinstance(had, dict) else {}
    now = {**had, **{k: v for k, v in chosen.items() if isinstance(v, str) and v}}
    if now != had:
        write_file(f, json.dumps(now))


def message_text(content):
    """A message's text, its images left out."""
    if isinstance(content, str):
        return content
    return "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")


def message_images(content):
    return sum(1 for b in content if isinstance(b, dict) and b.get("type") == "image") if isinstance(content, list) else 0


def agent_response(p, choice, message=None, answers=None, mode=None, suggestions=None, annotations=None):
    """The answer to one of Claude's requests (live["pending"]), from what
    was chosen: allow, always (allow, and the rules Claude suggests so it
    doesn't ask again: by default only those, addRules, as the other
    suggestions reach further; suggestions: which of them, by their index
    in the request's, e.g. its setMode "accept edits for the session"), or
    deny (with why, or what to change in a plan). answers: AskUserQuestion's,
    {question: answer}; annotations: {question: {preview, notes}}, the
    preview of the option picked and your note on it. mode: the permission
    mode to go on in, as a plan is approved ("acceptEdits"). A str when it
    doesn't add up."""
    if choice == "deny":
        why = message.strip() if isinstance(message, str) and message.strip() else ""
        no = "The user doesn't want to proceed with this tool use."
        return {"behavior": "deny", "message": f"{no} The user said:\n{why}" if why else no}
    if choice not in ("allow", "always"):
        return f"allow, always or deny, not {choice!r}"
    given = p.get("input") or {}
    response = {"behavior": "allow", "updatedInput": given}
    if p.get("tool") == "AskUserQuestion":
        answers = {**(p.get("answered") or {}), **(answers if isinstance(answers, dict) else {})}
        asked = [q.get("question") for q in given.get("questions") or [] if isinstance(q, dict)]
        if not all(isinstance(answers.get(q), str) and answers[q].strip() for q in asked):
            return "an answer to each question"
        response["updatedInput"] = {**given, "answers": {q: answers[q] for q in asked}}
        if annotations is not None:
            notes = question_annotations(given, annotations)
            if isinstance(notes, str):
                return notes
            if notes:
                response["updatedInput"]["annotations"] = notes
    offered = p.get("suggestions") or []
    if choice != "always":
        rules = []
    elif suggestions is None:
        # The rules; for a request with none (an edit), what the TUI's second
        # choice does: accept edits for the session.
        rules = [x for x in offered if x.get("type") == "addRules"] or \
            [x for x in offered if x.get("type") == "setMode" and x.get("destination") == "session"]
    elif isinstance(suggestions, list) and suggestions and all(
            isinstance(i, int) and not isinstance(i, bool) and 0 <= i < len(offered) for i in suggestions):
        rules = [offered[i] for i in dict.fromkeys(suggestions)]
    else:
        return "suggestions: the indexes of the suggestions to take"
    if choice == "always" and not rules:
        return "Claude suggested no rule to always allow this by"
    if mode is not None:
        if mode not in AGENT_MODES:
            return f"mode is one of {', '.join(AGENT_MODES)}"
        rules.append({"type": "setMode", "mode": mode, "destination": "session"})
    if rules:
        response["updatedPermissions"] = rules
    return response


def question_annotations(given, annotations):
    """AskUserQuestion's annotations as Claude takes them ({question:
    {preview, notes}}, a preview only one of that question's options has),
    or why not (a str)."""
    if not isinstance(annotations, dict):
        return "annotations: {question: {preview, notes}}"
    questions = {q.get("question"): q for q in given.get("questions") or [] if isinstance(q, dict)}
    out = {}
    for question, a in annotations.items():
        if question not in questions or not isinstance(a, dict):
            return "annotations: {question: {preview, notes}}, for questions Claude asked"
        one = {}
        preview, notes = a.get("preview"), a.get("notes")
        if isinstance(preview, str) and preview:
            if preview not in [o.get("preview") for o in questions[question].get("options") or [] if isinstance(o, dict)]:
                return "a preview that isn't one of the options'"
            one["preview"] = preview
        if isinstance(notes, str) and notes.strip():
            one["notes"] = notes.strip()[:4000]
        if one:
            out[question] = one
    return out


class Agent:
    """The broker of one session: its claude -p, live state, socket and pane."""

    def __init__(self, s):
        self.s, self.sid = s, s["id"]
        self.lock = threading.RLock()
        # The status file (the list's working, waiting, idle) written one at a
        # time, each as what's known says it when it's written: one worked out
        # a moment earlier (working, as a message went in) never lands after
        # one worked out since (idle: that turn ended in the instant between),
        # which left a chat "working" with nothing at work until its next turn.
        self.status_lock = threading.Lock()
        self.write_lock = threading.Lock()
        self.live_lock = threading.Lock()
        self.dir = claude_dir(self.sid)
        self.sock_path = agent_socket(self.sid)
        self.live = {"pid": os.getpid(), "claude_pid": None, "state": "starting", "since": time.time(),
                     "conversation": conversation_id(self.sid) or None, "model": None, "effort": None, "permission_mode": None,
                     "pending": [], "partial": "", "thinking": False, "activity": None, "tasks": [],
                     "cut": [],      # what the Claude before ran that never reached its end (live_cut)
                     "queue": [], "attachments": 0, "rate_limits": {}, "turns": 0, "cost_usd": 0.0,
                     "last_result": None, "account": None, "version": None, "socket": str(self.sock_path),
                     "title": None, "error": None,
                     "working_since": None,     # when the turn under way started (a question's wait included)
                     "before_plan": None,       # the mode plan mode came from: approving a plan goes back to it
                     # The turn under way: when it began (since), whether a timer, a script or another chat
                     # started it and nothing of yours joined it (elsewhere), whether it asked you anything
                     # (asked), what started it (what). turn_hold and quiet_stop read it.
                     "turn": None}
        self.version = self.written = 0     # of live, as changed and as written to live.json
        self.last_written = None    # live.json's text, as last written
        self.queue = []             # our messages waiting for Claude to be free (live["queue"] says what they are)
        self.attached = self.load_attached()    # images for the next message (attach)
        self.live["attachments"] = len(self.attached)
        self.waiting = {}           # our control requests: request_id -> [threading.Event, response]
        self.watchers = []
        self.busy = False           # Claude is in a turn (ours, or one it took on its own)
        self.dirty = threading.Event()
        self.done = threading.Event()
        self.at_line_start = True
        self.typed = []             # a paste arriving in the pane, line by line
        self.pasting = False
        self.titled = False         # asked for a title for the conversation already
        self.taken = set()          # amarchy send's notes matched to a message already (sent_by_taken)
        self.delivered = {}         # our messages given to Claude: uuid -> {elsewhere, at, what}, until it starts on them
        self.ended = time.time()    # when the last turn ended (its result): what comes after is the next one's
        self.bg_calls = {}          # Bash calls run in the background: tool_use id -> command
        self.bg_commands = {}       # their tasks: task id -> command (live["tasks"]' command: task_serves)

    # ---- output to the pane

    def out(self, text, dim=False, newline=True):
        text = mask_secrets(text)       # a secret's value, should Claude say it, isn't shown
        with self.write_lock:
            if not self.at_line_start and newline:
                sys.stdout.write("\n")
            sys.stdout.write(f"\033[2m{text}\033[0m" if dim else text)
            if newline:
                sys.stdout.write("\n")
            self.at_line_start = newline or text.endswith("\n")
            sys.stdout.flush()

    # ---- live state

    def changed(self, now=False):
        self.dirty.set()
        if now:
            self.flush_live()

    def flush_live(self):
        # Taken in this order only (never live_lock, then lock: a caller may
        # hold lock), and an older state never written over a newer one.
        # The same state as last written isn't written again: each write is
        # a live event to every open chat, and a redraw of its dock.
        with self.lock:
            self.live.pop("updated", None)      # once a stamp of each write; nothing read it
            data = json.dumps(self.live)
            if data == self.last_written:
                return
            self.last_written = data
            self.version += 1
            version = self.version
        with self.live_lock:
            if version > self.written:
                write_file(agent_live_file(self.sid), data)
                self.written = version

    def live_writer(self):
        while not self.done.is_set():
            if self.dirty.wait(0.5):
                self.dirty.clear()
                self.flush_live()
                time.sleep(AGENT_LIVE_EVERY)

    def set_state(self):
        """state from what's known: waiting (something asked), working, idle."""
        with self.status_lock:
            with self.lock:
                if self.live["state"] in ("starting", "exited"):
                    return
                state = "waiting" if self.live["pending"] else "working" if self.busy else "idle"
                if state == self.live["state"]:
                    return
                if state == "idle":
                    self.live["working_since"] = None
                elif not self.live["working_since"]:
                    self.live["working_since"] = time.time()
                self.live["state"] = state
            if state == "waiting":
                agent_status(self.sid, "waiting")
            elif state == "working":
                agent_status(self.sid, "working")
        self.changed(True)

    def status_as(self, decide, done=True):
        """The status file as decide() (under the lock) says it now, if it says
        one: written in its turn (status_lock), never over one decided since."""
        with self.status_lock:
            with self.lock:
                state = decide()
            if state:
                agent_status(self.sid, state, done)

    # ---- talking to claude

    def write(self, o):
        line = json.dumps(o) + "\n"
        with self.write_lock:
            self.claude.stdin.write(line)
            self.claude.stdin.flush()
        self.log({"_sent": o})

    def control(self, request, timeout=30):
        """A control request to Claude, and its response (a dict with
        subtype success or error)."""
        rid = str(uuid.uuid4())
        slot = [threading.Event(), None]
        with self.lock:
            self.waiting[rid] = slot
        self.write({"type": "control_request", "request_id": rid, "request": request})
        if not slot[0].wait(timeout):
            with self.lock:
                self.waiting.pop(rid, None)
            return {"subtype": "error", "error": f"Claude didn't answer {request.get('subtype')} in {timeout}s"}
        return slot[1]

    def send(self, content, when="idle", uid=None):
        """A message for Claude: queued here until Claude is free (when
        "idle"), or handed to Claude now, taken into the turn under way
        ("next") or ending it ("now")."""
        uid = uid or str(uuid.uuid4())
        if isinstance(content, str):
            content = content.replace("\r\n", "\n").strip("\n")
        with self.lock:
            # The images attached since the last message go with this one,
            # as a pasted image goes with what's sent next in the TUI.
            if self.attached:
                content = [*self.attached, *([{"type": "text", "text": content}] if isinstance(content, str)
                                             else content)]
                self.attached = []
                self.save_attached()
            # A script's, a timer's or another chat's (amarchy send), not yours:
            # its turn may end quiet (quiet_stop).
            elsewhere = sent_by_taken(self.sid, message_text(content), self.taken)
            message = {"uuid": uid, "content": content, "at": time.time(), "elsewhere": elsewhere}
            if when == "idle" and (self.busy or self.live["pending"] or self.queue
                                   or self.live["state"] == "starting"):
                self.queue.append(message)
                self.queue_changed()
                return {"ok": True, "uuid": uid, "queued": True}
        self.deliver(message, None if when == "idle" else when)
        return {"ok": True, "uuid": uid, "queued": False}

    def queue_changed(self):
        """live["queue"] from the queue: each message's text and how many images."""
        with self.lock:
            self.live["queue"] = [{"uuid": m["uuid"], "text": message_text(m["content"]),
                                   "images": message_images(m["content"]), "at": m["at"],
                                   **({"elsewhere": True} if m.get("elsewhere") else {})} for m in self.queue]
        self.changed(True)

    def load_attached(self):
        try:
            images = json.loads((self.dir / "attached.json").read_text())
        except (OSError, ValueError):
            return []
        return [b for b in images if isinstance(b, dict) and b.get("type") == "image"] if isinstance(images, list) else []

    def save_attached(self):
        """The images attached and not sent yet, kept for the next Claude of
        the session if this one stops (asleep) before they go."""
        f = self.dir / "attached.json"
        if self.attached:
            write_file(f, json.dumps(self.attached))
        else:
            f.unlink(missing_ok=True)
        self.live["attachments"] = len(self.attached)
        self.changed(True)

    def attach(self, images):
        """Images for the next message, whoever sends it (the app, the pane,
        amarchy send)."""
        blocks = []
        for im in images if isinstance(images, list) else []:
            kind, data = (im.get("type"), im.get("data")) if isinstance(im, dict) else (None, None)
            if not (isinstance(kind, str) and CLIP_TYPES.fullmatch(kind) and isinstance(data, str) and data):
                return {"ok": False, "error": "images are {type: image/png|jpeg|gif|webp, data: base64}"}
            blocks.append({"type": "image", "source": {"type": "base64", "media_type": kind, "data": data}})
        if not blocks:
            return {"ok": False, "error": "no image"}
        with self.lock:
            self.attached += blocks
            self.save_attached()
            n = len(self.attached)
        self.out(f"  · {n} image{'s' if n > 1 else ''} attached: {'they go' if n > 1 else 'it goes'} "
                 f"with the next message", dim=True)
        return {"ok": True, "attachments": n}

    def deliver(self, message, priority=None):
        now = time.time()
        with self.lock:
            self.busy = True
            elsewhere = bool(message.get("elsewhere"))
            what = message_text(message["content"])[:200]
            # What stopped with the Claude before this one, before it ended
            # (live_cut): said to Claude after your words, unseen in the chat.
            cut, self.live["cut"] = self.live.get("cut") or [], []
            if cut:
                content = message["content"]
                blocks = [{"type": "text", "text": content}] if isinstance(content, str) else list(content)
                message = {**message, "content": [*blocks, {"type": "text", "text": cut_note(cut)}]}
                self.out(f"  · told Claude what stopped before it ended: {', '.join(task_words(t) for t in cut)}"[:400], dim=True)
            # It moved here from another machine (move_note): said once, after your words, unseen in the chat.
            moved = self.dir / "moved-note"
            try:
                note = moved.read_text()
                moved.unlink()
            except OSError:
                note = ""
            if note.strip():
                content = message["content"]
                blocks = [{"type": "text", "text": content}] if isinstance(content, str) else list(content)
                message = {**message, "content": [*blocks, {"type": "text", "text": note}]}
                self.out("  · told Claude this chat moved here", dim=True)
            self.delivered[message["uuid"]] = {"elsewhere": elsewhere, "at": now, "what": what}
            if len(self.delivered) > 50:        # (ones Claude never started on: a stop, an exit)
                self.delivered = dict(list(self.delivered.items())[-50:])
            # The turn it starts, as it's handed over: anything its Claude
            # writes of it comes after (turn_hold). One taken into a turn under
            # way joins that one when Claude starts on it (turn_started).
            if priority is None and not self.live["turn"]:
                self.live["turn"] = {"since": now, "elsewhere": elsewhere, "asked": False, "what": what}
        self.changed(True)
        # Claude's hook says working when it takes it (UserPromptSubmit), a
        # moment later: said now, so the chat is never idle (or "done") with
        # your message on its way. Not one taken into a turn under way: that
        # one says how it stands (working, or waiting for your answer).
        if priority is None:
            self.status_as(lambda: "working" if self.busy else None)
        self.write({"type": "user", "message": {"role": "user", "content": message["content"]},
                    "parent_tool_use_id": None, "session_id": "", "uuid": message["uuid"],
                    **({"priority": priority} if priority else {})})
        self.set_state()

    def next_queued(self):
        """Claude is free: the oldest queued message goes in."""
        with self.lock:
            if self.busy or self.live["pending"] or not self.queue or self.live["state"] == "starting":
                return
            message = self.queue.pop(0)
        self.queue_changed()
        self.deliver(message)

    def answer(self, request_id, response):
        """Settle one of Claude's requests (a permission, a question, a plan)."""
        with self.lock:
            pending = next((p for p in self.live["pending"] if p["request_id"] == request_id), None)
            if not pending:
                return {"ok": False, "error": "Claude doesn't wait for that answer anymore", "gone": True}
            self.live["pending"].remove(pending)
        self.write({"type": "control_response", "response": {"subtype": "success", "request_id": request_id,
                                                             "response": response}})
        verdict = response.get("behavior", "?")
        self.out(f"  ↳ {'allowed' if verdict == 'allow' else 'not allowed'}"
                 f"{': ' + response['message'] if response.get('message') else ''}", dim=True)
        self.set_state()
        self.changed(True)
        return {"ok": True}

    def answer_question(self, request_id, question, answer):
        """One of AskUserQuestion's questions answered; the last one sends
        them all."""
        with self.lock:
            p = next((p for p in self.live["pending"] if p["request_id"] == request_id), None)
            if not p or p["tool"] != "AskUserQuestion":
                return {"ok": False, "error": "Claude doesn't wait for that answer anymore", "gone": True}
            asked = [q.get("question") for q in p["input"].get("questions") or [] if isinstance(q, dict)]
            if question not in asked:
                return {"ok": False, "error": "Claude didn't ask that"}
            if not isinstance(answer, str) or not answer.strip():
                return {"ok": False, "error": "no answer"}
            p["answered"][question] = answer.strip()
            left = [q for q in asked if q not in p["answered"]]
        if left:
            self.out(f"  next: {left[0]}", dim=True)
            self.changed(True)
            return {"ok": True, "left": len(left)}
        return self.answer(request_id, agent_response(p, "allow"))

    def remember(self, **chosen):
        agent_remember(self.sid, **chosen)

    def set_mode(self, mode):
        """The permission mode Claude is in now (under the lock), and the one
        it went into plan mode from: approving a plan goes back to that one."""
        was = self.live["permission_mode"]
        if mode == "plan" and was and was != "plan":
            self.live["before_plan"] = was
        elif mode and mode != "plan":
            self.live["before_plan"] = None
        self.live["permission_mode"] = mode

    def restore(self):
        try:
            chosen = json.loads((self.dir / "chosen.json").read_text())
        except (OSError, ValueError):
            chosen = {}
        chosen = chosen if isinstance(chosen, dict) else {}
        if chosen.get("mode") in AGENT_MODES and chosen["mode"] != self.live["permission_mode"]:
            if self.control({"subtype": "set_permission_mode", "mode": chosen["mode"]}).get("subtype") == "success":
                with self.lock:
                    self.set_mode(chosen["mode"])
        if isinstance(chosen.get("model"), str):
            res = self.control({"subtype": "set_model", "model": chosen["model"]})
            if res.get("subtype") == "success":
                self.live["model"] = (res.get("response") or {}).get("model") or chosen["model"]
        if chosen.get("effort") in EFFORTS:
            self.control({"subtype": "apply_flag_settings", "settings": {"effortLevel": chosen["effort"]}})
        self.read_effort()

    def read_effort(self):
        """The effort Claude thinks at now (live["effort"]), as Claude Code
        applies it: what you picked, else its default for the model. Asked
        (get_settings) when it starts, after a turn (a /effort Claude took
        itself) and when the model or the effort changes. Not from the
        thread that reads Claude: it waits on what that reads."""
        res = self.control({"subtype": "get_settings"}, timeout=15)
        if res.get("subtype") != "success":
            return
        applied = (res.get("response") or {}).get("applied") or {}
        effort = applied.get("effort") if applied.get("effort") in EFFORTS else None
        if effort and effort_choice(chosen_effort(self.sid)) in (None, "auto"):
            saw_default_effort(applied.get("model") or self.live.get("model"), effort)
        with self.lock:
            if self.live.get("effort") == effort:
                return
            self.live["effort"] = effort
        self.changed(True)

    def set_effort(self, effort):
        """effort (EFFORTS, or "auto": Claude Code's default) for this chat,
        from now on and when it wakes."""
        res = self.control({"subtype": "apply_flag_settings",
                            "settings": {"effortLevel": effort if effort in EFFORTS else None}})
        ok = res.get("subtype") == "success"
        if ok:
            self.remember(effort=effort)
            self.read_effort()
        return {"ok": ok, "response": {"effort": self.live.get("effort")} if ok else None, "error": res.get("error")}

    # ---- what claude says

    def log(self, o):
        try:
            f = self.dir / "stream.jsonl"
            if f.exists() and f.stat().st_size > AGENT_STREAM_MAX:
                data = f.read_bytes()
                f.write_bytes(data[len(data) // 2:].split(b"\n", 1)[-1])
            with open(f, "a") as fh:
                fh.write(mask_secrets(json.dumps(o)) + "\n")     # no secret's value in the log
        except OSError:
            pass

    def read_claude(self):
        for line in self.claude.stdout:
            try:
                o = json.loads(line)
            except ValueError:
                self.out(line.rstrip(), dim=True)
                continue
            self.log(o)
            try:
                self.handle(o)
            except Exception as e:      # one odd message mustn't end the session
                self.out(f"  (amarchy agent: couldn't handle a {o.get('type')} message: {e})", dim=True)
            self.broadcast(o)

    def read_claude_err(self):
        for line in self.claude.stderr:
            if line.strip():
                self.out(f"  {line.rstrip()}", dim=True)

    def handle(self, o):
        kind, sub = o.get("type"), o.get("subtype")
        live = self.live
        if kind == "control_response":
            r = o.get("response") or {}
            with self.lock:
                slot = self.waiting.pop(r.get("request_id"), None)
            if slot:
                slot[1] = r
                slot[0].set()
        elif kind == "control_request":
            self.on_request(o)
        elif kind == "control_cancel_request":
            with self.lock:
                live["pending"] = [p for p in live["pending"] if p["request_id"] != o.get("request_id")]
            self.out("  ↳ Claude withdrew its question", dim=True)
            self.set_state()
        elif kind == "system" and sub == "init":
            with self.lock:
                live.update(conversation=o.get("session_id"), model=o.get("model"),
                            version=o.get("claude_code_version"))
                self.set_mode(o.get("permissionMode"))
            set_conversation_id(self.sid, o.get("session_id") or "")
            self.changed()
        elif kind == "system" and sub == "status":
            if o.get("permissionMode"):
                self.remember(mode=o["permissionMode"])
            with self.lock:
                if "permissionMode" in o:
                    self.set_mode(o["permissionMode"])
                if o.get("status") == "requesting":
                    self.busy = True
            self.set_state()
            self.changed()
        elif kind == "system" and sub == "background_tasks_changed":
            with self.lock:
                # When each began (Claude Code doesn't say): when we first saw it.
                # Its command, the Bash call's (task_started says which call).
                was = {t.get("task_id"): t for t in live.get("tasks") or []}
                live["tasks"] = [{**t, "started": (was.get(t.get("task_id")) or {}).get("started") or time.time(),
                                  **self.task_command(t.get("task_id"))}
                                 for t in o.get("tasks") or [] if isinstance(t, dict)]
            self.changed(True)
        elif kind == "system" and sub == "task_started":
            # Which Bash call a background task runs: its command, so what it
            # is (a run, a server: task_serves) is known whether it runs or not.
            with self.lock:
                command = self.bg_calls.pop(o.get("tool_use_id"), None)
                if command and o.get("task_id"):
                    self.bg_commands[o["task_id"]] = command
                    while len(self.bg_commands) > 200:
                        self.bg_commands.pop(next(iter(self.bg_commands)))
                    for t in live.get("tasks") or []:
                        if t.get("task_id") == o["task_id"]:
                            t["command"] = command
            self.changed()
        elif kind == "system" and sub == "task_notification":
            self.out(f"  ⏺ background task {o.get('status', 'done')}: {o.get('summary') or o.get('task_id')}", dim=True)
        elif kind == "system" and sub == "session_title_changed":
            self.set_title(o.get("title"))
        elif kind == "system" and sub == "compact_boundary":
            self.out("  · conversation compacted", dim=True)
        elif kind == "system" and sub == "peer_message_hold":
            self.out(f"  · a message from {o.get('from_name') or o.get('from')} was {o.get('state')}", dim=True)
        elif kind == "command_lifecycle" and o.get("state") == "started":
            with self.lock:
                self.busy = True
                self.turn_started(o.get("command_uuid"))
            self.set_state()
            self.changed(True)
        elif kind == "stream_event":
            self.on_stream(o.get("event") or {})
        elif kind == "assistant":
            self.on_assistant(o)
        elif kind == "user":
            self.on_user(o)
        elif kind == "rate_limit_event":
            info = o.get("rate_limit_info") or {}
            with self.lock:
                live["rate_limits"] = info
            self.changed()
        elif kind == "result":
            self.on_result(o)
            threading.Thread(target=self.read_effort, daemon=True).start()

    def turn_started(self, uid):
        """Claude starts on a message (under the lock): ours (delivered), or
        one Claude Code had of its own (another Claude's, a background task
        that ended): neither is yours. With no turn under way it begins one;
        yours taken into one makes it yours."""
        mine = self.delivered.pop(uid, None) if uid else None
        elsewhere = mine["elsewhere"] if mine else True
        turn = self.live["turn"]
        if not turn:
            # One of Claude Code's own: the message it starts on may be written
            # a moment before it says so; whatever came since the last turn
            # ended is this one's (a turn's words come before its result).
            since = mine["at"] if mine else max(time.time() - 2, self.ended)
            self.live["turn"] = {"since": since, "elsewhere": elsewhere, "asked": False, "what": mine["what"] if mine else ""}
        elif not elsewhere:
            turn["elsewhere"] = False

    def on_request(self, o):
        req = o.get("request") or {}
        if req.get("subtype") != "can_use_tool":
            # Nothing else was declared in initialize (hooks, MCP servers,
            # dialogs): say so, so Claude doesn't wait on it.
            self.write({"type": "control_response", "response": {
                "subtype": "error", "request_id": o.get("request_id"),
                "error": f"amarchy agent doesn't handle {req.get('subtype')}"}})
            return
        pending = {"request_id": o["request_id"], "tool": req.get("tool_name"), "input": req.get("input") or {},
                   "description": req.get("description") or req.get("display_name"),
                   "suggestions": req.get("permission_suggestions") or [], "reason": req.get("decision_reason"),
                   "tool_use_id": req.get("tool_use_id"), "at": time.time(),
                   "answered": {}}     # AskUserQuestion's questions answered so far, one by one
        with self.lock:
            self.live["pending"].append(pending)
            if self.live["turn"]:
                self.live["turn"]["asked"] = True       # it needs you: shown, and never quiet
        self.draw_request(pending)
        self.set_state()
        self.status_as(lambda: "waiting" if self.live["pending"] else None)      # again: a hook may have said working since the first
        self.changed(True)

    def draw_request(self, p):
        tool, given = p["tool"], p["input"]
        if tool == "AskUserQuestion":
            for q in given.get("questions") or []:
                self.out(f"\n  \033[1m? {q.get('question')}\033[0m" + ("  (several: 1,3)" if q.get("multiSelect") else ""))
                for i, opt in enumerate(q.get("options") or [], 1):
                    self.out(f"    {i}. {opt.get('label')}" + (f" \033[2m{opt.get('description')}\033[0m"
                                                              if opt.get("description") else ""))
            self.out("  Type the number of your answer (one question at a time), or your own words.", dim=True)
        elif tool == "ExitPlanMode":
            self.out("\n  \033[1m? Claude's plan:\033[0m")
            for line in str(given.get("plan") or "").splitlines():
                self.out(f"    {line}")
            self.out("  y: approve and start · a: approve, and accept edits without asking · "
                     "n <what to change>: keep planning", dim=True)
        else:
            self.out(f"\n  \033[1m? Claude wants to use {tool_line(tool, given)}\033[0m")
            if p["reason"]:
                self.out(f"    {p['reason']}", dim=True)
            self.out("  y: allow · a: always allow · n [why]: don't allow", dim=True)

    def on_stream(self, ev):
        t = ev.get("type")
        if t == "message_start":
            with self.lock:
                self.busy = True
                self.live["partial"] = ""
            self.set_state()
        elif t == "content_block_start":
            block = ev.get("content_block") or {}
            with self.lock:
                self.live["thinking"] = block.get("type") == "thinking"
                if block.get("type") == "text":
                    self.live["partial"] = ""
            if block.get("type") == "text" and not self.at_line_start:
                self.out("")
            self.changed()
        elif t == "content_block_delta":
            delta = ev.get("delta") or {}
            if delta.get("type") == "text_delta":
                text = delta.get("text") or ""
                with self.lock:
                    self.live["partial"] += text
                self.out(text, newline=False)
                self.changed()
        elif t == "content_block_stop":
            with self.lock:
                self.live["thinking"] = False
            self.changed()

    def task_command(self, task_id):
        """A background task's command, as a field of its live["tasks"] entry ({} unknown)."""
        command = self.bg_commands.get(task_id)
        return {"command": command} if command else {}

    def on_assistant(self, o):
        # A command run in the background (a helper's too): its task says
        # which call it is when it starts (task_started).
        for block in o["message"].get("content") or []:
            given = block.get("input") if block.get("type") == "tool_use" and block.get("name") == "Bash" else None
            if isinstance(given, dict) and given.get("run_in_background") and isinstance(given.get("command"), str):
                with self.lock:
                    self.bg_calls[block.get("id")] = given["command"][:2000]
                    while len(self.bg_calls) > 200:
                        self.bg_calls.pop(next(iter(self.bg_calls)))
        if o.get("parent_tool_use_id"):
            # A helper's (subagent's): the step it's on, under its Agent call's.
            steps = [b for b in o["message"].get("content") or [] if b.get("type") == "tool_use"]
            with self.lock:
                act = self.live["activity"]
                stepped = bool(steps and act and act.get("id") == o["parent_tool_use_id"])
                if stepped:
                    act["step"] = {"tool": steps[-1].get("name"), "input": steps[-1].get("input")}
            if stepped:         # a helper's under an activity that's over: nothing new to say
                self.changed()
            return
        for block in o["message"].get("content") or []:
            if block.get("type") == "text":
                with self.lock:
                    self.live["partial"] = ""
                self.changed()
            elif block.get("type") == "tool_use":
                with self.lock:
                    self.live["activity"] = {"tool": block.get("name"), "input": block.get("input"),
                                             "id": block.get("id"), "since": time.time()}
                if block.get("name") not in ("ToolSearch",):
                    self.out(f"  ⏺ {tool_line(block.get('name'), block.get('input'))}"[:400], dim=True)
                self.changed()
        if not self.at_line_start:
            self.out("", newline=True)

    def on_user(self, o):
        content = o["message"].get("content")
        if o.get("isReplay") or isinstance(content, str):
            # What went in to Claude: ours, or a message from another session.
            text = content if isinstance(content, str) else " ".join(
                b.get("text", "") if b.get("type") == "text" else f"[{b.get('type')}]" for b in content or [])
            with self.lock:
                turn = self.live["turn"]
                if turn and not turn.get("what") and text.strip():     # (one Claude Code began: amarchy quiet says what)
                    turn["what"] = " ".join(re.sub(r"<[^>]*>|^\s*Another Claude session sent a message:", " ", text).split())[:200]
            m = re.fullmatch(r"\s*<local-command-std(?:out|err)>(.*)</local-command-std(?:out|err)>\s*", text, re.S)
            if m:
                self.out(f"  · {m.group(1).strip()}", dim=True)
            elif text.strip():
                self.out(f"\n\033[1m› {text.strip()}\033[0m\n")
            return
        for block in content if isinstance(content, list) else []:
            if block.get("type") == "tool_result":
                with self.lock:
                    act = self.live["activity"]
                    if act and act.get("id") == block.get("tool_use_id"):
                        self.live["activity"] = None
                if block.get("is_error") and not o.get("parent_tool_use_id"):
                    first = json.dumps(block.get("content"))[:160] if not isinstance(block.get("content"), str) \
                        else block["content"].splitlines()[0][:160] if block["content"] else ""
                    self.out(f"    ✗ {first}", dim=True)
                self.changed()

    def on_result(self, o):
        with self.lock:
            self.busy = False
            self.live["turn"] = None        # (its Stop hook has read it: quiet_stop)
            self.ended = time.time()
            self.live["turns"] += 1
            self.live["activity"] = None
            self.live["partial"] = ""
            self.live["cost_usd"] = round(self.live["cost_usd"] + float(o.get("total_cost_usd") or 0), 6)
            self.live["last_result"] = {k: o.get(k) for k in ("subtype", "is_error", "duration_ms", "num_turns",
                                                               "total_cost_usd", "stop_reason", "session_id")}
            if o.get("session_id"):
                self.live["conversation"] = o["session_id"]
        set_conversation_id(self.sid, o.get("session_id") or "")
        took = (o.get("duration_ms") or 0) / 1000
        stopped = o.get("subtype") == "error_during_execution"
        note = "interrupted" if stopped else (
            "error: " + str(o.get("result") or o.get("subtype")) if o.get("is_error") else "done")
        self.out(f"  · {note} · {took:.1f}s", dim=True)
        self.set_state()
        self.changed(True)
        # The Stop hook says idle (and done) after a turn that ended on its
        # own; one you stopped, or one that failed, ends without it.
        self.status_as(lambda: "idle" if not self.busy and not self.live["pending"] and not self.queue else None, done=not stopped)
        self.next_queued()
        if not self.titled:
            self.titled = True
            threading.Thread(target=self.name_conversation, daemon=True).start()

    def name_conversation(self):
        """Claude Code's TUI titles a conversation (the list's name for the
        session comes from it); under -p it doesn't. A conversation without
        one gets one, from its first message, the way the TUI's would read."""
        s = session(self.sid) or self.s
        f = transcript(s)
        if not f:
            self.titled = False     # no conversation yet: after the next turn
            return
        first, title = None, None
        try:
            with open(f, "rb") as fh:
                for line in fh:
                    if b'"ai-title"' in line or b'"custom-title"' in line:
                        try:
                            d = json.loads(line)
                            title = d.get("customTitle") or d.get("aiTitle") or title
                        except ValueError:
                            pass
                    elif first is None and b'"type":"user"' in line:
                        try:
                            r = json.loads(line)
                        except ValueError:
                            continue
                        content = (r.get("message") or {}).get("content")
                        if r.get("isMeta") or r.get("isSidechain") or not isinstance(content, (str, list)):
                            continue
                        item = user_item(message_text(content))
                        first = item["text"] if item and item["kind"] == "user" else None
        except OSError:
            return
        title = title or our_title(self.sid, f)
        if title:
            self.set_title(title)
            return
        if not first:
            self.titled = False     # nothing said yet: after the next turn
            return
        title = conversation_title(first)
        if title:
            # Kept by amarchy (saved_title reads it), not given to Claude:
            # rename_session would rename the session for ListAgents too.
            write_file(self.dir / "title", json.dumps({"conversation": f.stem, "title": title}))
            self.set_title(title)

    def set_title(self, title):
        """The conversation's title, as the TUI shows it: the pane's title,
        which the list reads (host_titles)."""
        title = " ".join(str(title or "").split())[:200]
        if not title:
            return
        with self.lock:
            self.live["title"] = title
        with self.write_lock:
            sys.stdout.write(f"\033]0;{title}\007")
            sys.stdout.flush()
        self.changed()

    # ---- watchers on the socket

    def broadcast(self, o):
        if not self.watchers:
            return
        line = (json.dumps(o) + "\n").encode()
        with self.lock:
            watchers = list(self.watchers)
        for w in watchers:
            try:
                w.sendall(line)
            except OSError:
                with self.lock:
                    if w in self.watchers:
                        self.watchers.remove(w)

    # ---- the socket

    def serve(self):
        self.sock_path.unlink(missing_ok=True)
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(str(self.sock_path))
        os.chmod(self.sock_path, 0o600)
        self.server.listen(16)
        while not self.done.is_set():
            try:
                conn, _ = self.server.accept()
            except OSError:
                break
            threading.Thread(target=self.client, args=(conn,), daemon=True).start()

    def client(self, conn):
        keep = False
        try:
            data = b""
            while not data.endswith(b"\n") and len(data) < 32_000_000:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
            try:
                request = json.loads(data)
                if not isinstance(request, dict):
                    raise ValueError
            except ValueError:
                request = {}
            if request.get("op") == "watch":
                conn.sendall((json.dumps({"ok": True, "live": self.live}) + "\n").encode())
                with self.lock:
                    self.watchers.append(conn)
                keep = True
                return
            try:
                answer = self.op(request)
            except Exception as e:
                answer = {"ok": False, "error": f"{type(e).__name__}: {e}"}
            conn.sendall((json.dumps(answer) + "\n").encode())
        except OSError:
            pass
        finally:
            if not keep:
                conn.close()

    def op(self, r):
        """One request on the socket: its answer."""
        op = r.get("op")
        if op == "state":
            with self.lock:
                return {"ok": True, "live": dict(self.live)}
        if self.live["state"] == "exited":
            return {"ok": False, "error": "Claude isn't running"}
        if op == "send":
            content = r.get("content")
            if not (isinstance(content, str) and content.strip()) and not (isinstance(content, list) and content):
                return {"ok": False, "error": "nothing to send"}
            when = r.get("when") or "idle"
            if when not in ("idle", "next", "now", "later"):
                return {"ok": False, "error": f"when is idle, next, now or later, not {when!r}"}
            return self.send(content, "idle" if when == "idle" else when, r.get("uuid"))
        if op == "attach":
            return self.attach(r.get("images"))
        if op == "unqueue":
            # Taken back: its content comes with the answer (Send now, Edit
            # keep its images).
            with self.lock:
                taken = next((m for m in self.queue if m["uuid"] == r.get("uuid")), None)
                self.queue = [m for m in self.queue if m is not taken]
            self.queue_changed()
            return {"ok": True, "response": {"content": taken["content"]}} if taken \
                else {"ok": False, "error": "no such message waiting"}
        if op == "answer":
            # {request_id, choice: allow|always|deny, message, answers, mode},
            # {request_id, question, answer} (one of several questions), or
            # {request_id, response} (the control response's, as is).
            with self.lock:
                p = next((p for p in self.live["pending"] if p["request_id"] == r.get("request_id")), None)
            if not p:
                return {"ok": False, "error": "Claude doesn't wait for that answer anymore", "gone": True}
            if "question" in r:
                return self.answer_question(p["request_id"], r.get("question"), r.get("answer"))
            response = r.get("response")
            if response is None:
                response = agent_response(p, r.get("choice"), r.get("message"), r.get("answers"), r.get("mode"),
                                          r.get("suggestions"), r.get("annotations"))
                if isinstance(response, str):
                    return {"ok": False, "error": response}
            if not isinstance(response, dict) or response.get("behavior") not in ("allow", "deny"):
                return {"ok": False, "error": "response is {behavior: allow|deny, ...}"}
            if response["behavior"] == "allow" and "updatedInput" not in response:
                response = {**response, "updatedInput": p["input"]}
            if response["behavior"] == "deny" and not response.get("message"):
                response = {**response, "message": "The user doesn't want to proceed with this tool use."}
            return self.answer(r.get("request_id"), response)
        if op == "interrupt":
            res = self.control({"subtype": "interrupt", **({"cancel_queued": True} if r.get("everything") else {})})
            if r.get("everything"):
                with self.lock:
                    self.queue = []
                self.queue_changed()
            return {"ok": res.get("subtype") == "success", "response": res.get("response"), "error": res.get("error")}
        if op == "control":
            request = r.get("request")
            if not isinstance(request, dict) or not request.get("subtype"):
                return {"ok": False, "error": "request is {subtype: ..., ...}"}
            res = self.control(request, timeout=float(r.get("timeout") or 30))
            ok = res.get("subtype") == "success"
            if ok and request["subtype"] == "set_permission_mode":
                with self.lock:
                    self.set_mode(request.get("mode"))
                self.remember(mode=request.get("mode"))
                self.changed(True)
            if ok and request["subtype"] == "set_model":
                with self.lock:
                    self.live["model"] = (res.get("response") or {}).get("model") or request.get("model")
                self.remember(model=request.get("model"))
                self.changed(True)
                self.read_effort()       # another model may think at another effort
            return {"ok": ok, "response": res.get("response"), "error": res.get("error")}
        if op == "effort":
            if not effort_choice(r.get("effort")):
                return {"ok": False, "error": f"effort is one of {', '.join(EFFORTS)}, or auto"}
            return self.set_effort(r["effort"])
        if op == "stop":
            threading.Thread(target=self.stop, daemon=True).start()
            return {"ok": True}
        return {"ok": False, "error": f"unknown op {op!r}"}

    # ---- the pane's keyboard

    def read_tty(self):
        """What's typed in the pane: a message for Claude, or the answer to
        what it asks. A paste (the app's composer, amarchy send) arrives
        bracketed, so its lines stay one message."""
        for line in sys.stdin:
            line = line.rstrip("\n")
            if "\033[200~" in line:
                self.pasting = True
                line = line.replace("\033[200~", "")
            if "\033[201~" in line:
                self.pasting = False
                line = line.replace("\033[201~", "")
            self.typed.append(line)
            if self.pasting:
                continue
            text, self.typed = "\n".join(self.typed).strip("\n"), []
            if text.strip():
                try:
                    self.typed_text(text)
                except OSError:
                    break

    def typed_text(self, text):
        with self.lock:
            p = self.live["pending"][0] if self.live["pending"] else None
        if not p:
            self.send(text)
            return
        word, _, rest = text.strip().partition(" ")
        word = word.lower()
        if p["tool"] == "AskUserQuestion":
            # One question at a time, in order; the last answer sends them all.
            questions = [q for q in p["input"].get("questions") or [] if isinstance(q, dict)]
            q = next((q for q in questions if q.get("question") not in p["answered"]), None)
            if q:
                opts = q.get("options") or []
                picks = [x.strip() for x in text.split(",")]
                chosen = [opts[int(x) - 1]["label"] for x in picks if x.isdigit() and 0 < int(x) <= len(opts)]
                self.answer_question(p["request_id"], q.get("question"),
                                     ", ".join(chosen) if chosen and len(chosen) == len(picks) else text.strip())
        elif word in ("y", "yes", "a", "always", "n", "no"):
            choice = {"y": "allow", "a": "always", "n": "deny"}[word[0]]
            plan = p["tool"] == "ExitPlanMode"
            response = agent_response(p, "allow" if plan and choice == "always" else choice, rest,
                                      mode="acceptEdits" if plan and choice == "always" else None)
            if isinstance(response, str):
                self.out(f"  {response}", dim=True)
            else:
                self.answer(p["request_id"], response)
        else:
            self.out("  y, a or n (with why, if you like)", dim=True)

    # ---- the whole of it

    def stop(self):
        """End Claude as quitting it would; run() then returns."""
        try:
            self.claude.stdin.close()
        except (OSError, AttributeError):
            pass
        try:
            self.claude.terminate()
            self.claude.wait(8)
        except subprocess.TimeoutExpired:
            self.claude.kill()
        except AttributeError:
            pass

    def claude_ended(self, code):
        """Its Claude has exited (asleep, stopped, crashed), and what it ran in
        the background with it. What would have run to an end (a test run, a
        CI watch, a helper) is cut: it never will, and Claude Code won't say so
        (live_cut). A server only stops, as sleep means it to."""
        with self.lock:
            runs = [{**t, "cut_at": time.time()} for t in self.live.get("tasks") or []
                    if isinstance(t, dict) and not task_serves(t)]
            self.live.update(state="exited", pending=[], partial="", activity=None, exit_code=code, tasks=[],
                             cut=([*(self.live.get("cut") or []), *runs])[-CUT_KEEP:])

    def run(self):
        s = self.s
        self.dir.mkdir(parents=True, exist_ok=True)
        # One Claude per conversation: one going (its pane restarted, the
        # engine switched) has a few seconds to let it go.
        other = claim_driver(self.sid, "chat")
        if other:
            print(f"\n  \033[31mThis conversation is open in another Claude already (pid {other.get('pid')}, "
                  f"the {other.get('engine')} engine).\033[0m\n", flush=True)
            return 1
        # What the Claude before this one ran in the background that never
        # reached its end (live_cut): this one is told with its first message.
        self.live["cut"] = live_cut(agent_live(self.sid))[-CUT_KEEP:]
        path = Path(s["path"])
        os.chdir(path)
        os.environ["PWD"] = str(path)
        prompt = s.pop("prompt", None)
        if prompt is not None:
            save_session(s)
        sent = take(self.dir / "send")
        first = [m for m in (prompt, sent) if m is not None and m.strip()]
        # Taken, and Claude takes a few seconds to start: the chat is working
        # on it all along (the list said so while the message waited here).
        if first:
            agent_status(self.sid, "working")
        if sys.stdin.isatty():
            sh("stty", "sane", "-echoctl")      # raw from the sleep loop's wait for a key; a paste's end unseen
            print("\033[H\033[2J\033[3J", end="")
        print(f"\033]0;amarchy:{s['id']}\007", end="")      # the list then reads the conversation's title
        if transcript(s) and sys.stdout.isatty():
            # The conversation so far, as the pane showed it before (asleep,
            # or in the TUI): Claude under -p doesn't print it again.
            try:
                width = os.get_terminal_size().columns
            except OSError:
                width = 100
            self.out("\n".join(conversation_lines(s, width)))
        self.out(f"\n  \033[1m{s['repo']} · {s['name']}\033[0m \033[2m· Claude Code on amarchy's chat engine "
                 f"(the new chat)\033[0m\n")
        argv = agent_argv(s)
        try:
            self.claude = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                           text=True, bufsize=1, env=agent_env(s), cwd=path,
                                           start_new_session=True)    # the pane's Ctrl+C is ours (Stop), not its
        except OSError as e:
            self.out(f"  \033[31mCouldn't start Claude Code: {e}\033[0m")
            return 1
        self.live["claude_pid"] = self.claude.pid
        write_file(self.dir / "driver", json.dumps({"pid": os.getpid(), "claude_pid": self.claude.pid,
                                                    "engine": "chat", "since": time.time()}))
        self.flush_live()
        self.titled = True
        threading.Thread(target=self.name_conversation, daemon=True).start()     # one it has already
        for target in (self.read_claude, self.read_claude_err, self.serve, self.live_writer):
            threading.Thread(target=target, daemon=True).start()
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, lambda *_: threading.Thread(target=self.stop, daemon=True).start())
        # Ctrl+C in the pane stops the turn, as Esc does in the TUI.
        signal.signal(signal.SIGINT, lambda *_: threading.Thread(
            target=lambda: self.busy and self.control({"subtype": "interrupt"}), daemon=True).start())
        info = self.control({"subtype": "initialize"}, timeout=60)
        if info.get("subtype") == "success":
            r = info.get("response") or {}
            write_file(self.dir / "agent.json", json.dumps({k: r.get(k) for k in (
                "commands", "models", "agents", "account", "output_style", "claude_code_version")}))
            with self.lock:
                self.live.update(account=r.get("account"), version=r.get("claude_code_version"),
                                 permission_mode=r.get("current_permission_mode"), state="idle")
            self.restore()
        else:
            with self.lock:
                self.live.update(state="idle", error=info.get("error"))
            self.out(f"  {info.get('error')}", dim=True)
        # Started, it hasn't finished a turn: idle, with nothing done (a new
        # chat was working while it was set up). With a message to start on
        # (its first prompt, what you sent while it slept), or one that came
        # in meanwhile, it's working all along: deliver says so.
        self.status_as(lambda: None if first or self.queue or self.busy else "idle", done=False)
        self.changed(True)
        for text in first:
            self.send(text)
        (self.dir / "send-quiet").unlink(missing_ok=True)      # (quiet_waking: it's the turn's to say now)
        self.next_queued()
        if sys.stdin.isatty():
            sys.stdout.write("\033[?2004h")     # pastes come bracketed (read_tty)
            sys.stdout.flush()
            threading.Thread(target=self.read_tty, daemon=True).start()
        code = self.claude.wait()
        self.done.set()
        self.claude_ended(code)
        with self.lock:
            queued, self.queue = self.queue, []
            # Not sent yet: the next Claude of this session starts with them,
            # their images attached again for it.
            self.attached = [b for m in queued if isinstance(m["content"], list)
                             for b in m["content"] if b.get("type") == "image"] + self.attached
            self.save_attached()
            self.live["queue"] = []
        text = "\n\n".join(t for t in (message_text(m["content"]).strip() for m in queued) if t)
        if text:
            write_file(self.dir / "send", text)
        self.flush_live()
        # It won't say it's idle, if it stopped in a turn or a question.
        if asleep_since(self.sid) is None:
            agent_status(self.sid, "idle", done=False)
        try:
            self.server.close()
        except AttributeError:
            pass
        self.sock_path.unlink(missing_ok=True)
        self.out(f"  · Claude Code exited ({code})", dim=True)
        return 0


def touch_classic(sid):
    """The app has Claude's classic terminal open on the session: keep it on
    the TUI (classic_viewed), for CLASSIC_HOLD seconds from now."""
    write_file(claude_dir(sid) / "classic", f"{time.time()}\n")


def switch_engine(s, want, force=False):
    """Put a session's Claude on the other engine ("chat" or "terminal"),
    with the same conversation: once it's idle (a turn under way, or a
    question, would be cut), unless forced. Running, it stops (as quitting
    it would), and its pane starts again on the other one once it's gone (the
    two never run one conversation at once: claim_driver); asleep or not
    started, it wakes on it. "terminal" is Claude's classic terminal, and it
    holds only while the app keeps its heartbeat (touch_classic, classic_viewed):
    left alone, the session comes back to the chat by itself (follow_engines).
    None once done, else why not."""
    sid = s["id"]
    if want not in ENGINES:
        return "the engine is chat or terminal"
    if engine(s) == want:
        if want == "terminal":
            touch_classic(sid)
        else:
            (claude_dir(sid) / "classic").unlink(missing_ok=True)
        return None
    try:
        status = (STATUS / sid).read_text().strip()
    except OSError:
        status = "idle"
    if status in ("working", "waiting") and not force:
        return ("Claude is working: switch once it's done" if status == "working"
                else "Claude is asking you something: answer it first")
    if want == "terminal":
        touch_classic(sid)
    else:
        (claude_dir(sid) / "classic").unlink(missing_ok=True)
    s = session(sid) or s
    s["engine"] = want
    save_session(s)
    pane = host_pane(s)
    if pane and asleep_since(sid) is None and not s.get("setup"):
        if want == "terminal" and agent_up(sid):
            try:
                agent_call(sid, {"op": "stop"}, timeout=5)      # its queue kept for the TUI (send)
            except OSError:
                pass
        stop_claude(pane)
        end = time.time() + 10
        while claude_driver(sid) and time.time() < end:
            time.sleep(0.1)
        host_respawn(s)
    return None


def engine_blockers(s):
    """Why a session's Claude shouldn't go over to the other engine now, if
    anything: what the move would lose. The things that keep a session awake
    (sleep_blockers, which has a message typed in a classic terminal's prompt),
    and a classic terminal whose prompt isn't on its screen."""
    pane = host_pane(s)
    if not pane:
        return ["its pane isn't running"]
    reasons = sleep_blockers(s, pane, processes(), auto=False)
    if not reasons and engine(s) == "terminal" and claude_prompt(s) is None:
        reasons.append("its prompt isn't on screen")
    return reasons


def follow_engines():
    """What the timer does with the engines (before sleep_idle): every session
    runs on the chat engine. One on the TUI (from before the chat engine, or
    left on Claude's classic terminal with nobody looking at it any more) moves
    to the chat when it's safe: asleep at once (it wakes on the chat), awake
    once it's idle with nothing pending, no background task, no message queued
    and nothing typed in the TUI's prompt (engine_blockers). Its conversation
    carries over. One the app has its classic terminal open on stays put."""
    for s in sessions():
        sid = s["id"]
        if s.get("setup") or engine(s) == "chat" or classic_viewed(sid):
            continue
        if asleep_since(sid) is None:
            try:
                status = (STATUS / sid).read_text().strip()
            except OSError:
                status = "idle"
            if status != "idle" or engine_blockers(s):
                continue
        switch_engine(s, "chat")


def cmd_agent(args):
    """amarchy agent <id> (the broker, in a session's Claude pane), or one of
    its commands for a session on the chat engine (see usage)."""
    if not args:
        print(usage("agent"), file=sys.stderr)
        return 1
    commands = ("engine", "state", "send", "answer", "interrupt", "mode", "model", "effort", "watch", "control")
    if args[0] not in commands:
        if len(args) != 1:
            print(usage("agent"), file=sys.stderr)
            return 1
        s = session(args[0])
        if not s:
            return fail(f"no session {args[0]!r}")
        return Agent(s).run()
    cmd, rest = args[0], args[1:]
    if not rest:
        print(usage("agent"), file=sys.stderr)
        return 1
    s = session(rest[0])
    if not s:
        return fail(f"no session {rest[0]!r}")
    sid, rest = s["id"], rest[1:]
    if cmd == "engine":
        force = "--force" in rest
        rest = [a for a in rest if a != "--force"]
        if not rest:
            print(engine(s))
            return 0
        if len(rest) > 1 or rest[0] not in ("chat", "terminal"):
            return fail("amarchy agent engine <id> [chat|terminal] [--force]")
        why = switch_engine(s, rest[0], force)
        if why:
            return fail(f"{sid}: {why}")
        print(rest[0])
        return 0
    if engine(s) != "chat":
        return fail(f"{sid} runs on the terminal engine (amarchy agent engine {sid} chat switches it)")
    if cmd == "state":
        print(json.dumps(agent_live(sid), indent=1))
        return 0
    if not agent_up(sid):
        return fail(f"{sid}: its broker isn't running (asleep? amarchy wake {sid})")
    if cmd == "watch":
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.connect(str(agent_socket(sid)))
            c.sendall(b'{"op": "watch"}\n')
            try:
                for line in c.makefile():
                    print(line, end="", flush=True)
            except KeyboardInterrupt:
                pass
        return 0
    if cmd == "send":
        when = "idle"
        for flag in ("--now", "--next", "--later"):
            if flag in rest:
                rest.remove(flag)
                when = flag[2:]
        if len(rest) != 1:
            return fail("amarchy agent send <id> <text|-> [--next|--now|--later]")
        text = sys.stdin.read() if rest[0] == "-" else rest[0]
        request = {"op": "send", "content": text, "when": when}
    elif cmd == "answer":
        if len(rest) < 2:
            return fail("amarchy agent answer <id> <request id> allow|always|deny [why] | --json <response>")
        rid, verdict = rest[0], rest[1]
        if verdict == "--json":
            try:
                response = json.loads(rest[2])
            except (IndexError, ValueError):
                return fail("--json takes the response, e.g. '{\"behavior\": \"allow\"}'")
        elif verdict in ("allow", "always", "deny"):
            request = {"op": "answer", "request_id": rid, "choice": verdict, "message": " ".join(rest[2:])}
        else:
            return fail(f"allow, always or deny, not {verdict!r}")
        if verdict == "--json":
            request = {"op": "answer", "request_id": rid, "response": response}
    elif cmd == "interrupt":
        request = {"op": "interrupt", "everything": "--all" in rest}
    elif cmd == "mode":
        if len(rest) != 1 or rest[0] not in AGENT_MODES:
            return fail(f"amarchy agent mode <id> {'|'.join(AGENT_MODES)}")
        request = {"op": "control", "request": {"subtype": "set_permission_mode", "mode": rest[0]}}
    elif cmd == "model":
        if len(rest) != 1:
            return fail("amarchy agent model <id> <model>")
        request = {"op": "control", "request": {"subtype": "set_model", "model": rest[0]}}
    elif cmd == "effort":
        if len(rest) != 1 or not effort_choice(rest[0]):
            return fail(f"amarchy agent effort <id> {'|'.join(EFFORTS)}|auto")
        request = {"op": "effort", "effort": rest[0]}
    else:   # control
        try:
            request = {"op": "control", "request": json.loads(rest[0])}
        except (IndexError, ValueError):
            return fail("amarchy agent control <id> '<control request as JSON>'")
    try:
        answer = agent_call(sid, request)
    except OSError as e:
        return fail(f"{sid}: no answer from its broker: {e}")
    print(json.dumps(answer))
    return 0 if answer.get("ok") else 1


# ------------------------------------------------------------------ main

# What each command takes, for `amarchy <command> --help` and for catching an
# option it doesn't know before it acts on it: `close --help` would otherwise
# close the session, `new --help` start one named --help. Flags are the
# options it knows; values, those that take the next word (skipped when
# checking); text, those after which the rest is free text (a command, a
# prompt), left alone. Commands with None are plumbing whose arguments come
# from amarchy itself or from Claude Code: only a first --help is theirs (none for editor).
OPTIONS = {
    "new": ({"--prompt", "--no-jump", "--model", "--effort", "--attach", "--agent", "--on"}, {"--prompt", "--model", "--effort", "--attach", "--agent", "--on"}, set()),
    "add": ({"--new", "--github"}, set(), set()),
    "projects": ({"--github", "--json"}, set(), set()),
    "list": ({"--compact", "--all"}, set(), set()),
    "close": ({"--force"}, set(), set()),
    "rename": ({"--id", "--reset"}, {"--id"}, set()),
    "run": ({"--show", "--set", "--save", "--forget", "--list"}, {"--forget"}, {"--set", "--save"}),
    "preview": ({"--id", "--clear", "--run", "--stop", "--url", "--port", "--memory", "--idle", "--lines", "--no-start", "--name", "--rename"},
                {"--id", "--run", "--stop", "--url", "--port", "--memory", "--idle", "--lines", "--name", "--rename"}, set()),
    "priority": ({"--id"}, {"--id"}, set()),
    "sleep": ({"--force", "--all", "--after", "--idle"}, {"--after"}, set()),
    "wake": (set(), set(), set()),
    "theme": ({"--show", "--list", "--json", "--font", "--wallpaper", "--refresh-wallpapers", "--cut",
               "--in-background", "--quiet", "--omarchy", "--force"}, {"--font", "--wallpaper"}, set()),
    "sound": ({"--show", "--list", "--json", "--assistant"}, set(), set()),
    "app": ({"--status", "--test"}, set(), set()),
    "send": ({"--no-wait", "--timeout", "--queued"}, {"--timeout", "--queued"}, set()),
    "notify": ({"--session", "--urgent"}, {"--session"}, set()),
    "quiet": ({"--json"}, set(), set()),
    "assistant": ({"--name", "--picture", "--crop"}, {"--name", "--picture", "--crop"}, set()),
    "agents": ({"--json", "--name", "--picture", "--crop", "--sound"}, {"--name", "--picture", "--crop", "--sound"}, set()),
    "alerts": (set(), set(), set()),
    "missions": ({"--goal", "--reset"}, {"--goal"}, set()),
    "update": ({"--auto"}, set(), set()),
    "protocol-check": ({"--broker"}, set(), set()),
    "migrate": (set(), set(), set()),
    "dictation": ({"--status", "--json", "--engine", "--in-background", "--quiet", "--on"}, {"--on"}, set()),
    "automations": ({"--json"}, set(), set()),
    "today": ({"--json", "--loops"}, set(), set()),
    "task": ({"--agent", "--title", "--note", "--link", "--button", "--until", "--key", "--notify", "--json"},
             {"--agent", "--title", "--note", "--link", "--button", "--until", "--key"}, set()),
    "board": ({"--json", "--agent", "--title", "--lead", "--column", "--yours", "--approval", "--done", "--button", "--to",
               "--asks", "--quiet", "--check", "--no-check", "--key", "--block", "--body", "--xpost", "--attr", "--media",
               "--handle", "--name", "--avatar", "--note", "--link", "--until", "--notify", "--base", "--over-edit",
               "--clear-buttons", "--clear-links", "--card", "--text", "--lines"},
              {"--agent", "--title", "--lead", "--column", "--button", "--to", "--asks", "--check", "--key", "--block",
               "--body", "--xpost", "--attr", "--media", "--handle", "--name", "--avatar", "--note", "--link", "--until",
               "--base", "--card", "--text", "--lines"}, set()),
    "secret": ({"--why", "--all", "--all-projects", "--global", "--again", "--timeout", "--project", "--json"},
               {"--why", "--timeout", "--project"}, set()),
    "terminals": (set(), set(), set()),
    "machines": ({"--json"}, set(), set()),
    "move": ({"--to", "--when-free", "--spawned", "--secrets", "--no-secrets", "--check", "--json", "--cancel", "--dismiss",
              "--take", "--from", "--tend"}, {"--to", "--take", "--from"}, set()),
    "open": (set(), set(), set()),
    "awake": ({"--json"}, set(), set()),
    "tailscale": ({"--json", "--no-open"}, set(), set()),
    "ghostty": (set(), set(), set()),
    "key": ({"--check"}, set(), set()),
    "setup": None,
    "bar": ({"--follow"}, set(), set()),
    "shell": None,
    "claude": None, "asleep": None, "woke": None, "hook": None, "seen": None,
    "reap": None, "preview-exec": None, "previews-off": None, "shorten": None, "attach": None, "held": None,
    "paste": None, "agent": None, "claude-reload": None,
}
HELP = ("-h", "--help")
OLD_USAGE = {"order": "  amarchy order [opened|activity]       from before `amarchy group`: activity is "
                      "`group status on`, opened `group status off`"}


def usage(cmd):
    """The lines of this file's docstring for one command (with the ones
    continuing them), or None for a command it doesn't know."""
    lines, found, keep = __doc__.splitlines(), [], False
    for line in lines:
        words = line.split()
        if line.startswith("  amarchy ") and len(words) > 1:
            names, i = [words[1]], 2
            while i + 1 < len(words) and words[i] == "|" and re.fullmatch(r"[a-z]+", words[i + 1]):
                names.append(words[i + 1])
                i += 2
            keep = cmd in names
            if keep:
                found.append(line)
        elif keep and line.startswith(" " * 40) and line.strip():
            found.append(line)
        else:
            keep = False
    if not found and cmd in OLD_USAGE:
        found = [OLD_USAGE[cmd]]
    return "usage:\n" + "\n".join(found) if found else None


def check_args(cmd, args):
    """`--help` or `-h` for a command: its usage (0). An option it doesn't know:
    the usage on stderr (1). Otherwise None, and the command runs."""
    spec = OPTIONS.get(cmd)
    if spec is None:
        if args[:1] and args[0] in HELP:
            print(usage(cmd))
            return 0
        return None
    flags, values, text = spec
    it = iter(args)
    for a in it:
        if a in HELP:
            print(usage(cmd))
            return 0
        name = a.split("=", 1)[0] if cmd == "new" and re.match(r"--(prompt|model|attach)=", a) else a     # new's --option=value
        if name in text:
            break
        if name in values and name == a:
            next(it, None)
        elif re.fullmatch(r"--[A-Za-z][\w-]*(=.*)?", a) and name not in flags:
            print(f"amarchy {cmd}: unknown option {name}\n{usage(cmd)}", file=sys.stderr)
            return 1
    return None


def cmd_help(args):
    """`amarchy help [command]`: everything, or one command's usage."""
    if not args:
        print(__doc__)
        return 0
    cmd = args[0]
    text = usage(cmd) if cmd in OPTIONS else None
    if not text:
        return fail(f"unknown command {args[0]!r} (amarchy help lists them)")
    print(text)
    return 0


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("help", [])
    if cmd in ("help", *HELP):
        return cmd_help(args)
    if cmd not in OPTIONS:
        return fail(f"unknown command {cmd!r} (amarchy help lists them)")
    checked = check_args(cmd, args)
    if checked is not None:
        return checked
    if cmd == "new":
        return cmd_new(args)
    elif cmd == "add":
        return cmd_add(args)
    elif cmd == "projects":
        return cmd_projects(args)
    elif cmd == "close":
        return cmd_close(args)
    elif cmd == "rename":
        return cmd_rename(args)
    elif cmd == "priority":
        return cmd_priority(args)
    elif cmd == "list":
        rows = list_all() if "--all" in args else session_view()
        print(json.dumps(rows, indent=None if "--compact" in args else 2))
    elif cmd == "run":
        return cmd_run(args)
    elif cmd == "preview":
        return cmd_preview(args)
    elif cmd == "theme":
        return cmd_theme(args)
    elif cmd == "sound":
        return cmd_sound(args)
    elif cmd == "hook" and len(args) == 2:
        cmd_hook(*args)
    elif cmd == "seen" and len(args) == 1:
        return cmd_seen(args[0])
    elif cmd == "sleep":
        return cmd_sleep(args)
    elif cmd == "wake":
        return cmd_wake(args)
    elif cmd == "preview-exec" and args:
        return cmd_preview_exec(args)
    elif cmd == "previews-off" and not args:
        return cmd_previews_off(args)
    elif cmd == "reap" and len(args) == 1:
        return cmd_reap(args[0])
    elif cmd == "claude" and len(args) == 1:
        return cmd_claude(args[0])
    elif cmd == "shorten" and len(args) == 2:
        return cmd_shorten(*args)
    elif cmd == "asleep" and len(args) == 1:
        return cmd_asleep(args[0])
    elif cmd == "woke" and len(args) in (1, 2):
        return cmd_woke(args[0], args[1] if len(args) > 1 else "")
    elif cmd == "attach" and args:
        return cmd_attach(args)
    elif cmd == "held" and len(args) == 1:
        return cmd_held(args[0])
    elif cmd == "paste":
        return cmd_paste(args)
    elif cmd == "claude-reload" and len(args) == 1:
        return claude_reload(args[0])
    elif cmd == "agent":
        return cmd_agent(args)
    elif cmd == "app":
        return cmd_app(args)
    elif cmd == "send":
        return cmd_send(args)
    elif cmd == "notify":
        return cmd_notify(args)
    elif cmd == "quiet":
        return cmd_quiet(args)
    elif cmd == "assistant":
        return cmd_assistant(args)
    elif cmd == "agents":
        return cmd_agents(args)
    elif cmd == "alerts":
        return cmd_alerts(args)
    elif cmd == "missions":
        return cmd_missions(args)
    elif cmd == "update" and not [a for a in args if a != "--auto"]:
        return cmd_update(args)
    elif cmd == "migrate" and not args:
        migrate()
    elif cmd == "dictation":
        return cmd_dictation(args)
    elif cmd == "secret":
        return cmd_secret(args)
    elif cmd == "automations":
        return cmd_automations(args)
    elif cmd == "today":
        return cmd_today(args)
    elif cmd == "task":
        return cmd_task(args)
    elif cmd == "board":
        return cmd_board(args)
    elif cmd == "terminals":
        return cmd_terminals(args)
    elif cmd == "machines":
        return cmd_machines(args)
    elif cmd == "move":
        return cmd_move(args)
    elif cmd == "protocol-check":
        return cmd_protocol_check(args)
    elif cmd == "shell" and args:
        return cmd_shell(args)
    elif cmd == "awake":
        return cmd_awake(args)
    elif cmd == "tailscale":
        return cmd_tailscale(args)
    elif cmd == "ghostty":
        return cmd_ghostty(args)
    elif cmd == "key":
        return cmd_key(args)
    elif cmd == "setup":
        return cmd_setup(args)
    elif cmd == "open" and len(args) <= 1:
        return cmd_open(args)
    elif cmd == "bar" and not [a for a in args if a != "--follow"]:
        return cmd_bar(args)
    else:   # a command it knows, with the wrong number of arguments
        print(usage(cmd), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
