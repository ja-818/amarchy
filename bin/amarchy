BRIEF_ASK = (
    "amarchy: now write this turn's reply by calling update_brief once (ToolSearch can load it). The person reads it "
    "instead of your messages, so it must hold everything from this turn they need: the outcome as its title, a summary "
    "(answer) as complete points (every finding, decision, name, number, URL and result that matters: it's what they read "
    "first, so leave nothing important out, just keep each point short), the plan if there is one, what needs them, how "
    "to check it, and caveats. If they asked you to explain or answer something, the explanation itself goes in "
    "explanation, in full: a point never says you explained or found something without saying what. A question's "
    "turn is kind answer: the short answer, verdicts when it judges or compares, the explanation in '## ' topics, and "
    "summary points only for takeaways not already said. A comparison or side-by-side data goes in tables (shown open), "
    "not flattened into points. Anything you made for them to use (a message to send, a link, "
    "a command, an event, to-dos, a contact, a place, a chat you started, a table, a file, a document) goes in "
    "artifacts, complete, so nothing they need is left in your messages; so do lists they track (still open, waiting "
    "on, loops), as todos. Give each summary point its why (detail). Every source you cite goes in sources. Only what "
    "helps: every part is optional but the title, so a simple answer is a title and a point or two, "
    "and the plan, tests, checks, notes and questions are left out when there are none. Write for someone glancing at a "
    "phone who may not remember this conversation: name things, plain words. "
    "Don't list the steps you took, the files you changed or the commits: the app shows those from the record. Never "
    "invent anything. What git says now: {facts}. Your reply was already delivered: after update_brief, end your turn "
    "with no text."
)


# ---- the reply format: Claude writes each reply as the card it becomes
#
# Given at every start (--append-system-prompt, both engines): a reply leads
# with its outcome, then markdown sections, tables for comparisons, and fenced
# blocks named for what they hold (a draft, a command, an event...) that the
# app gives buttons (chat.js parseReply). No second rendition of the reply, so
# nothing is lost or said twice, and no extra step at the end of a turn.
REPLY_FORMAT = """amarchy shows the person each of your replies as a card built from your markdown, on their phone or computer. They read that, so write every reply (not your working notes in between, only your final message of a turn) like this. It holds whatever else says how to end or style a reply (a persona, a project's closing line): keep that voice and content, and put it in these blocks, because buttons come only from them.

- First line: the outcome in one plain sentence, as you'd say it to them. It becomes the card's title. No greeting, no "Here's...", no heading mark.
- Then the rest, as you normally would, in markdown: short paragraphs and lists, "## " headings for sections (each folds in the card), a table for any comparison or side-by-side data, code in fenced blocks. Every finding, number, name, link and caveat they need, and the reason behind each point: the card is all they read.
- Anything they will use goes in a fenced block named for it, so the card gives it buttons (Copy, Open in WhatsApp, Add to calendar...). Attributes go on the opening line as key="value":
  ```whatsapp to="Felipe" phone="+57 300 111 2233"
  the whole message, ready to send
  ```
  ```email to="ana@example.com" subject="Contract"
  the whole email
  ```
  (also ```slack to="#channel"``` and ```sms phone="+1 555 0100"```)
  ```command cwd="~/Work/houston"
  exactly what to run
  ```
  ```link label="Sign in to Gmail" note="Expires in 10 minutes"
  https://...
  ```
  ```event title="ECOS panel" when="2026-10-29T15:40:00-05:00" end="2026-10-29T17:00:00-05:00" where="Teatro Panorama, Bogotá"
  any notes
  ```
  ```todos title="Still open"
  - [ ] Send the C21 summary (today)
  - [x] Twilio top-up
  ```
  ```contact name="Gaby Mendez" role="Quantística" phone="+57 310 555 0101" email="gaby@example.com"
  ```
  ```place name="Spinning Center Rosales" where="Cl. 72 #5-83, Bogotá" hours="Mon-Fri 6am-9pm"
  ```
  ```session id="houston-os-c21-crm"
  what that chat is doing
  ```
- Lists they track (still open, waiting on, loops) go in a todos block, every time you list them.
- Any question you ask them, a yes or no included, goes in a choices block at the end, never only in your prose; each option is "- Label | the full message it sends" (or just "- Label"):
  ```choices question="Ship it to main?"
  - Ship it | Ship it: merge to main and push
  - Not yet
  ```
- A link for them to open goes in a link block; a date to keep, in an event block.
- Sources you used go last, under "## Sources", as links.
- The very end of every reply is this chat's goal and where it stands, in a goal block (it isn't shown in the card: the app puts the goal under the chat's name and on its Today page, and offers to close a done chat). state is working (more to do, or under way), waiting (you need them: your choices block says what), blocked (you can't go on), or done (the goal is reached: built and shipped, answered, sent; nothing is left for this chat). When it's done, the reply gives them a link block to see or check the result (the page, the deploy, the PR, the document) whenever there is one: it's the Review button on the chat's card. The goal is one short sentence of what they want from this chat, the same every reply unless it changed:
  ```goal state="working"
  Make Today the app's home screen
  ```
- Never put what they need only in an earlier message: each reply stands on its own."""
FORMAT_VERSION = hashlib.sha1(REPLY_FORMAT.encode()).hexdigest()[:10]


def reply_format_args():
    """The reply format, for a session's Claude (both engines)."""
    return ["--append-system-prompt", REPLY_FORMAT]


def claude_format_version():
    """Which reply format the Claude a hook runs for was started with: None
    for none, else the hash of its --append-system-prompt (FORMAT_VERSION
    when it's the current one)."""
    pid = os.getppid()
    for _ in range(6):
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
            if stat[stat.find("(") + 1:stat.rfind(")")] == "claude":
                args = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
                for i, a in enumerate(args[:-1]):
                    if a == b"--append-system-prompt":
                        text = args[i + 1].decode(errors="replace")
                        return hashlib.sha1(text.encode()).hexdigest()[:10] if text.startswith("amarchy shows") else None
                return None
            pid = int(stat[stat.rfind(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            return None
    return None


# Which update_brief a Claude has: a hash of what the tool says it takes (the
# ask changes need no new Claude: the hook sends it each turn). A
# Claude started with another (before amarchy changed the tool) is started
# again at an idle moment (claude_reload), so a chat that's always open (an
# assistant) gets the new one too.
BRIEF_VERSION = hashlib.sha1(json.dumps(BRIEF_DEF, sort_keys=True).encode()).hexdigest()[:10]
BRIEF_RELOAD_EVERY = 600    # seconds between two tries to start a session's Claude again for it


def brief_mcp_args():
    """The brief's tool for a session's Claude (both engines): amarchy's MCP
    server (its version in its arguments: claude_brief_version), allowed
    without asking."""
    mcp = {"mcpServers": {BRIEF_SERVER: {"type": "stdio", "command": sys.executable, "args": [SELF, "brief-mcp", BRIEF_VERSION]}}}
    return ["--mcp-config", json.dumps(mcp), "--allowedTools", BRIEF_TOOL]


def brief_mcp():
    """amarchy brief-mcp: the MCP server (stdio, JSON lines) that gives a
    session's Claude update_brief. The tool only answers: the app draws the
    brief from what Claude sent, in the transcript (app_items)."""
    def send(reply):
        sys.stdout.write(json.dumps(reply) + "\n")
        sys.stdout.flush()
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if not isinstance(msg, dict) or "id" not in msg:       # a notification: nothing to answer
            continue
        method, params = msg.get("method"), msg.get("params") if isinstance(msg.get("params"), dict) else {}
        if method == "initialize":
            result = {"protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}},
                      "serverInfo": {"name": BRIEF_SERVER, "version": "1"}}
        elif method == "tools/list":
            result = {"tools": [BRIEF_DEF]}
        elif method == "tools/call":
            ok = params.get("name") == BRIEF_DEF["name"]
            result = {"content": [{"type": "text", "text": "Brief updated. The person already has your answer: end your turn now, "
                                                           "with no text." if ok else f"No tool {params.get('name')}."}],
                      "isError": not ok}
        elif method == "ping":
            result = {}
        else:
            send({"jsonrpc": "2.0", "id": msg["id"], "error": {"code": -32601, "message": f"Unknown method: {method}"}})
            continue
        send({"jsonrpc": "2.0", "id": msg["id"], "result": result})
    return 0


def brief_facts(s):
    """What git says about a session's work, for its brief: exact, written by
    no one. {branch, base, commits (since it left its base), recent (their
    subjects), files, added, removed (against the base, uncommitted work in),
    uncommitted, unpushed, merged (into the base)}; {} outside a repository."""
    path = s.get("path")
    if not path or not Path(path).is_dir():
        return {}

    def git(*a):
        r = sh("git", *a, cwd=path)
        return r.stdout.strip() if r.returncode == 0 else None
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if not branch:
        return {}
    base, mb = git_base(s)
    out = {"branch": branch, "base": base}
    if mb:
        commits = (git("log", "--format=%s", f"{mb}..HEAD") or "").splitlines()
        out["commits"], out["recent"] = len(commits), commits[:3]
        stat = git("diff", "--shortstat", mb) or ""
        for key, word in (("files", "file"), ("added", "insertion"), ("removed", "deletion")):
            m = re.search(rf"(\d+) {word}", stat)
            out[key] = int(m.group(1)) if m else 0
        if commits:
            out["merged"] = sh("git", "merge-base", "--is-ancestor", "HEAD", base, cwd=path).returncode == 0
    out["uncommitted"] = len((git("status", "--porcelain") or "").splitlines())
    unpushed = git("rev-list", "--count", "@{upstream}..HEAD")
    if unpushed and unpushed.isdigit():
        out["unpushed"] = int(unpushed)
    return out


def claude_brief_version():
    """Which update_brief the Claude a hook runs for has: None for none (it
    started before amarchy served it), "" for the first one (no version),
    else its version (BRIEF_VERSION when it's the current one)."""
    pid = os.getppid()
    for _ in range(6):
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
            if stat[stat.find("(") + 1:stat.rfind(")")] == "claude":
                args = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
                for i, a in enumerate(args):
                    if b'"brief-mcp"' in a or a == b"brief-mcp":
                        m = re.search(rb'"brief-mcp",\s*"([0-9a-f]+)"', a)
                        return m.group(1).decode() if m else ""
                return None
            pid = int(stat[stat.rfind(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            return None
    return None


def claude_reload(sid):
    """amarchy claude-reload <id>: start a session's Claude again, with the
    same conversation, so it gets what amarchy gives a Claude now (the reply
    format; the Stop hook starts this when the one it has is older). Only once
    it's idle and nothing would be lost (a turn, a question, a background
    task), waiting for that up to BRIEF_RELOAD_EVERY seconds, and at most once
    in that time."""
    mark = claude_dir(sid) / "brief-reload"
    try:
        if time.time() - mark.stat().st_mtime < BRIEF_RELOAD_EVERY:
            return 0
    except OSError:
        pass
    write_file(mark, f"{time.time()}\n")
    end = time.time() + BRIEF_RELOAD_EVERY      # a quiet moment can take a while: its conversation settles after a turn
    while time.time() < end:
        time.sleep(5)
        s = session(sid)
        if not s or asleep_since(sid) is not None:
            return 0        # asleep, it wakes with the new one anyway
        try:
            status = (STATUS / sid).read_text().strip()
        except OSError:
            status = "idle"
        live = agent_live(sid) if engine(s) == "chat" else {}
        if status != "idle" or live.get("pending") or live.get("queue") or (live.get("state") not in (None, "idle")):
            continue
        if engine_blockers(s):
            continue
        pane = host_pane(s)
        if not pane:
            return 0
        stop_claude(pane)
        until = time.time() + 10
        while claude_driver(sid) and time.time() < until:
            time.sleep(0.1)
        host_respawn(session(sid) or s)
        return 0
    return 0


def brief_needed(path, tail=4_000_000):
    """Whether a conversation's Claude has done something its reply (the
    brief) doesn't have yet: steps since it last called update_brief, or,
    with no call since your last message, any words or steps. Words after a
    call don't count: they're what Claude says again once it's written
    (app_items marks them aside), and asking again would only repeat it."""
    try:
        with open(path, "rb") as fh:
            end = fh.seek(0, 2)
            fh.seek(max(0, end - tail))
            lines = fh.read().splitlines()
    except (OSError, TypeError):
        return False
    steps = words = False       # since the newest record, going back
    for line in reversed(lines):
        if b'"type":"assistant"' not in line and b'"type":"user"' not in line:
            continue
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if human_record(r):
            return steps or words       # your message, and what Claude did after it
        if r.get("type") != "assistant" or r.get("isSidechain"):
            continue
        for b in reversed((r.get("message") or {}).get("content") or []):
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_use" and b.get("name") == BRIEF_TOOL:
                return steps            # its reply is written: only steps after it need another
            if b.get("type") == "tool_use" and b.get("name") != "ToolSearch":
                steps = True
            elif b.get("type") == "text" and (b.get("text") or "").strip():
                words = True
    return False


def human_message(text):
    """Whether a message in your name is one you wrote, not one Claude Code
    put there: a background task that ended, a message from another session,
    the summary a compacted conversation goes on from."""
    t = text.lstrip()
    if re.match(r"<(task-notification|cross-session-message|system-reminder|local-command|command-|bash-)", t):
        return False
    return not t.startswith("This session is being continued from a previous conversation")


def our_title(sid, f):
    """The title the chat engine gave the session's conversation in the
    transcript f (Agent.name_conversation), or ""."""
    try:
        t = json.loads((claude_dir(sid) / "title").read_text())
    except (OSError, ValueError):
        return ""
    ok = isinstance(t, dict) and t.get("conversation") == f.stem and isinstance(t.get("title"), str)
    return t["title"] if ok else ""


def chosen_model(sid):
    """The model chosen for a session (chosen.json), or None."""
    try:
        m = json.loads((claude_dir(sid) / "chosen.json").read_text()).get("model")
    except (OSError, ValueError, AttributeError):
        return None
    return m if isinstance(m, str) and re.fullmatch(MODEL_RE, m) else None


def agent_remember(sid, **chosen):
    """The permission mode and model you chose (or that a plan approved left)
    outlive the session's Claude on the chat engine: it sleeps when idle, and
    wakes in them (Agent.restore). Not the TUI's: it starts in your claude
    arguments'."""
    f = claude_dir(sid) / "chosen.json"
    try:
        had = json.loads(f.read_text())
    except (OSError, ValueError):
        had = {}
    had = had if isinstance(had, dict) else {}
    now = {**had, **{k: v for k, v in chosen.items() if isinstance(v, str) and v}}
    if now != had:
        write_file(f, json.dumps(now))


def message_text(content):
    """A message's text, its images left out."""
    if isinstance(content, str):
        return content
    return "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")


def message_images(content):
    return sum(1 for b in content if isinstance(b, dict) and b.get("type") == "image") if isinstance(content, list) else 0


def agent_response(p, choice, message=None, answers=None, mode=None, suggestions=None, annotations=None):
    """The answer to one of Claude's requests (live["pending"]), from what
    was chosen: allow, always (allow, and the rules Claude suggests so it
    doesn't ask again: by default only those, addRules, as the other
    suggestions reach further; suggestions: which of them, by their index
    in the request's, e.g. its setMode "accept edits for the session"), or
    deny (with why, or what to change in a plan). answers: AskUserQuestion's,
    {question: answer}; annotations: {question: {preview, notes}}, the
    preview of the option picked and your note on it. mode: the permission
    mode to go on in, as a plan is approved ("acceptEdits"). A str when it
    doesn't add up."""
    if choice == "deny":
        why = message.strip() if isinstance(message, str) and message.strip() else ""
        no = "The user doesn't want to proceed with this tool use."
        return {"behavior": "deny", "message": f"{no} The user said:\n{why}" if why else no}
    if choice not in ("allow", "always"):
        return f"allow, always or deny, not {choice!r}"
    given = p.get("input") or {}
    response = {"behavior": "allow", "updatedInput": given}
    if p.get("tool") == "AskUserQuestion":
        answers = {**(p.get("answered") or {}), **(answers if isinstance(answers, dict) else {})}
        asked = [q.get("question") for q in given.get("questions") or [] if isinstance(q, dict)]
        if not all(isinstance(answers.get(q), str) and answers[q].strip() for q in asked):
            return "an answer to each question"
        response["updatedInput"] = {**given, "answers": {q: answers[q] for q in asked}}
        if annotations is not None:
            notes = question_annotations(given, annotations)
            if isinstance(notes, str):
                return notes
            if notes:
                response["updatedInput"]["annotations"] = notes
    offered = p.get("suggestions") or []
    if choice != "always":
        rules = []
    elif suggestions is None:
        # The rules; for a request with none (an edit), what the TUI's second
        # choice does: accept edits for the session.
        rules = [x for x in offered if x.get("type") == "addRules"] or \
            [x for x in offered if x.get("type") == "setMode" and x.get("destination") == "session"]
    elif isinstance(suggestions, list) and suggestions and all(
            isinstance(i, int) and not isinstance(i, bool) and 0 <= i < len(offered) for i in suggestions):
        rules = [offered[i] for i in dict.fromkeys(suggestions)]
    else:
        return "suggestions: the indexes of the suggestions to take"
    if choice == "always" and not rules:
        return "Claude suggested no rule to always allow this by"
    if mode is not None:
        if mode not in AGENT_MODES:
            return f"mode is one of {', '.join(AGENT_MODES)}"
        rules.append({"type": "setMode", "mode": mode, "destination": "session"})
    if rules:
        response["updatedPermissions"] = rules
    return response


def question_annotations(given, annotations):
    """AskUserQuestion's annotations as Claude takes them ({question:
    {preview, notes}}, a preview only one of that question's options has),
    or why not (a str)."""
    if not isinstance(annotations, dict):
        return "annotations: {question: {preview, notes}}"
    questions = {q.get("question"): q for q in given.get("questions") or [] if isinstance(q, dict)}
    out = {}
    for question, a in annotations.items():
        if question not in questions or not isinstance(a, dict):
            return "annotations: {question: {preview, notes}}, for questions Claude asked"
        one = {}
        preview, notes = a.get("preview"), a.get("notes")
        if isinstance(preview, str) and preview:
            if preview not in [o.get("preview") for o in questions[question].get("options") or [] if isinstance(o, dict)]:
                return "a preview that isn't one of the options'"
            one["preview"] = preview
        if isinstance(notes, str) and notes.strip():
            one["notes"] = notes.strip()[:4000]
        if one:
            out[question] = one
    return out


class Agent:
    """The broker of one session: its claude -p, live state, socket and pane."""

    def __init__(self, s):
        self.s, self.sid = s, s["id"]
        self.lock = threading.RLock()
        self.write_lock = threading.Lock()
        self.live_lock = threading.Lock()
        self.dir = claude_dir(self.sid)
        self.sock_path = agent_socket(self.sid)
        self.live = {"pid": os.getpid(), "claude_pid": None, "state": "starting", "since": time.time(),
                     "conversation": conversation_id(self.sid) or None, "model": None, "permission_mode": None,
                     "pending": [], "partial": "", "thinking": False, "activity": None, "tasks": [],
                     "queue": [], "attachments": 0, "rate_limits": {}, "turns": 0, "cost_usd": 0.0,
                     "last_result": None, "account": None, "version": None, "socket": str(self.sock_path),
                     "title": None, "error": None,
                     "working_since": None,     # when the turn under way started (a question's wait included)
                     "before_plan": None}       # the mode plan mode came from: approving a plan goes back to it
        self.version = self.written = 0     # of live, as changed and as written to live.json
        self.queue = []             # our messages waiting for Claude to be free (live["queue"] says what they are)
        self.attached = self.load_attached()    # images for the next message (attach)
        self.live["attachments"] = len(self.attached)
        self.waiting = {}           # our control requests: request_id -> [threading.Event, response]
        self.watchers = []
        self.busy = False           # Claude is in a turn (ours, or one it took on its own)
        self.dirty = threading.Event()
        self.done = threading.Event()
        self.at_line_start = True
        self.typed = []             # a paste arriving in the pane, line by line
        self.pasting = False
        self.titled = False         # asked for a title for the conversation already

    # ---- output to the pane

    def out(self, text, dim=False, newline=True):
        text = mask_secrets(text)       # a secret's value, should Claude say it, isn't shown
        with self.write_lock:
            if not self.at_line_start and newline:
                sys.stdout.write("\n")
            sys.stdout.write(f"\033[2m{text}\033[0m" if dim else text)
            if newline:
                sys.stdout.write("\n")
            self.at_line_start = newline or text.endswith("\n")
            sys.stdout.flush()

    # ---- live state

    def changed(self, now=False):
        self.dirty.set()
        if now:
            self.flush_live()

    def flush_live(self):
        # Taken in this order only (never live_lock, then lock: a caller may
        # hold lock), and an older state never written over a newer one.
        with self.lock:
            self.live["updated"] = time.time()
            data = json.dumps(self.live)
            self.version += 1
            version = self.version
        with self.live_lock:
            if version > self.written:
                write_file(agent_live_file(self.sid), data)
                self.written = version

    def live_writer(self):
        while not self.done.is_set():
            if self.dirty.wait(0.5):
                self.dirty.clear()
                self.flush_live()
                time.sleep(AGENT_LIVE_EVERY)

    def set_state(self):
        """state from what's known: waiting (something asked), working, idle."""
        with self.lock:
            if self.live["state"] in ("starting", "exited"):
                return
            state = "waiting" if self.live["pending"] else "working" if self.busy else "idle"
            if state == self.live["state"]:
                return
            if state == "idle":
                self.live["working_since"] = None
            elif not self.live["working_since"]:
                self.live["working_since"] = time.time()
            self.live["state"] = state
        if state == "waiting":
            agent_status(self.sid, "waiting")
        elif state == "working":
            agent_status(self.sid, "working")
        self.changed(True)

    # ---- talking to claude

    def write(self, o):
        line = json.dumps(o) + "\n"
        with self.write_lock:
            self.claude.stdin.write(line)
            self.claude.stdin.flush()
        self.log({"_sent": o})

    def control(self, request, timeout=30):
        """A control request to Claude, and its response (a dict with
        subtype success or error)."""
        rid = str(uuid.uuid4())
        slot = [threading.Event(), None]
        with self.lock:
            self.waiting[rid] = slot
        self.write({"type": "control_request", "request_id": rid, "request": request})
        if not slot[0].wait(timeout):
            with self.lock:
                self.waiting.pop(rid, None)
            return {"subtype": "error", "error": f"Claude didn't answer {request.get('subtype')} in {timeout}s"}
        return slot[1]

    def send(self, content, when="idle", uid=None):
        """A message for Claude: queued here until Claude is free (when
        "idle"), or handed to Claude now, taken into the turn under way
        ("next") or ending it ("now")."""
        uid = uid or str(uuid.uuid4())
        if isinstance(content, str):
            content = content.replace("\r\n", "\n").strip("\n")
        with self.lock:
            # The images attached since the last message go with this one,
            # as a pasted image goes with what's sent next in the TUI.
            if self.attached:
                content = [*self.attached, *([{"type": "text", "text": content}] if isinstance(content, str)
                                             else content)]
                self.attached = []
                self.save_attached()
            message = {"uuid": uid, "content": content, "at": time.time()}
            if when == "idle" and (self.busy or self.live["pending"] or self.queue
                                   or self.live["state"] == "starting"):
                self.queue.append(message)
                self.queue_changed()
                return {"ok": True, "uuid": uid, "queued": True}
        self.deliver(message, None if when == "idle" else when)
        return {"ok": True, "uuid": uid, "queued": False}

    def queue_changed(self):
        """live["queue"] from the queue: each message's text and how many images."""
        with self.lock:
            self.live["queue"] = [{"uuid": m["uuid"], "text": message_text(m["content"]),
                                   "images": message_images(m["content"]), "at": m["at"]} for m in self.queue]
        self.changed(True)

    def load_attached(self):
        try:
            images = json.loads((self.dir / "attached.json").read_text())
        except (OSError, ValueError):
            return []
        return [b for b in images if isinstance(b, dict) and b.get("type") == "image"] if isinstance(images, list) else []

    def save_attached(self):
        """The images attached and not sent yet, kept for the next Claude of
        the session if this one stops (asleep) before they go."""
        f = self.dir / "attached.json"
        if self.attached:
            write_file(f, json.dumps(self.attached))
        else:
            f.unlink(missing_ok=True)
        self.live["attachments"] = len(self.attached)
        self.changed(True)

    def attach(self, images):
        """Images for the next message, whoever sends it (the app, the pane,
        amarchy send)."""
        blocks = []
        for im in images if isinstance(images, list) else []:
            kind, data = (im.get("type"), im.get("data")) if isinstance(im, dict) else (None, None)
            if not (isinstance(kind, str) and CLIP_TYPES.fullmatch(kind) and isinstance(data, str) and data):
                return {"ok": False, "error": "images are {type: image/png|jpeg|gif|webp, data: base64}"}
            blocks.append({"type": "image", "source": {"type": "base64", "media_type": kind, "data": data}})
        if not blocks:
            return {"ok": False, "error": "no image"}
        with self.lock:
            self.attached += blocks
            self.save_attached()
            n = len(self.attached)
        self.out(f"  · {n} image{'s' if n > 1 else ''} attached: {'they go' if n > 1 else 'it goes'} "
                 f"with the next message", dim=True)
        return {"ok": True, "attachments": n}

    def deliver(self, message, priority=None):
        with self.lock:
            self.busy = True
        self.write({"type": "user", "message": {"role": "user", "content": message["content"]},
                    "parent_tool_use_id": None, "session_id": "", "uuid": message["uuid"],
                    **({"priority": priority} if priority else {})})
        self.set_state()

    def next_queued(self):
        """Claude is free: the oldest queued message goes in."""
        with self.lock:
            if self.busy or self.live["pending"] or not self.queue or self.live["state"] == "starting":
                return
            message = self.queue.pop(0)
        self.queue_changed()
        self.deliver(message)

    def answer(self, request_id, response):
        """Settle one of Claude's requests (a permission, a question, a plan)."""
        with self.lock:
            pending = next((p for p in self.live["pending"] if p["request_id"] == request_id), None)
            if not pending:
                return {"ok": False, "error": "Claude doesn't wait for that answer anymore", "gone": True}
            self.live["pending"].remove(pending)
        self.write({"type": "control_response", "response": {"subtype": "success", "request_id": request_id,
                                                             "response": response}})
        verdict = response.get("behavior", "?")
        self.out(f"  ↳ {'allowed' if verdict == 'allow' else 'not allowed'}"
                 f"{': ' + response['message'] if response.get('message') else ''}", dim=True)
        self.set_state()
        self.changed(True)
        return {"ok": True}

    def answer_question(self, request_id, question, answer):
        """One of AskUserQuestion's questions answered; the last one sends
        them all."""
        with self.lock:
            p = next((p for p in self.live["pending"] if p["request_id"] == request_id), None)
            if not p or p["tool"] != "AskUserQuestion":
                return {"ok": False, "error": "Claude doesn't wait for that answer anymore", "gone": True}
            asked = [q.get("question") for q in p["input"].get("questions") or [] if isinstance(q, dict)]
            if question not in asked:
                return {"ok": False, "error": "Claude didn't ask that"}
            if not isinstance(answer, str) or not answer.strip():
                return {"ok": False, "error": "no answer"}
            p["answered"][question] = answer.strip()
            left = [q for q in asked if q not in p["answered"]]
        if left:
            self.out(f"  next: {left[0]}", dim=True)
            self.changed(True)
            return {"ok": True, "left": len(left)}
        return self.answer(request_id, agent_response(p, "allow"))

    def remember(self, **chosen):
        agent_remember(self.sid, **chosen)

    def set_mode(self, mode):
        """The permission mode Claude is in now (under the lock), and the one
        it went into plan mode from: approving a plan goes back to that one."""
        was = self.live["permission_mode"]
        if mode == "plan" and was and was != "plan":
            self.live["before_plan"] = was
        elif mode and mode != "plan":
            self.live["before_plan"] = None
        self.live["permission_mode"] = mode

    def restore(self):
        try:
            chosen = json.loads((self.dir / "chosen.json").read_text())
        except (OSError, ValueError):
            return
        if chosen.get("mode") in AGENT_MODES and chosen["mode"] != self.live["permission_mode"]:
            if self.control({"subtype": "set_permission_mode", "mode": chosen["mode"]}).get("subtype") == "success":
                with self.lock:
                    self.set_mode(chosen["mode"])
        if isinstance(chosen.get("model"), str):
            res = self.control({"subtype": "set_model", "model": chosen["model"]})
            if res.get("subtype") == "success":
                self.live["model"] = (res.get("response") or {}).get("model") or chosen["model"]

    # ---- what claude says

    def log(self, o):
        try:
            f = self.dir / "stream.jsonl"
            if f.exists() and f.stat().st_size > AGENT_STREAM_MAX:
                data = f.read_bytes()
                f.write_bytes(data[len(data) // 2:].split(b"\n", 1)[-1])
            with open(f, "a") as fh:
                fh.write(mask_secrets(json.dumps(o)) + "\n")     # no secret's value in the log
        except OSError:
            pass

    def read_claude(self):
        for line in self.claude.stdout:
            try:
                o = json.loads(line)
            except ValueError:
                self.out(line.rstrip(), dim=True)
                continue
            self.log(o)
            try:
                self.handle(o)
            except Exception as e:      # one odd message mustn't end the session
                self.out(f"  (amarchy agent: couldn't handle a {o.get('type')} message: {e})", dim=True)
            self.broadcast(o)

    def read_claude_err(self):
        for line in self.claude.stderr:
            if line.strip():
                self.out(f"  {line.rstrip()}", dim=True)

    def handle(self, o):
        kind, sub = o.get("type"), o.get("subtype")
        live = self.live
        if kind == "control_response":
            r = o.get("response") or {}
            with self.lock:
                slot = self.waiting.pop(r.get("request_id"), None)
            if slot:
                slot[1] = r
                slot[0].set()
        elif kind == "control_request":
            self.on_request(o)
        elif kind == "control_cancel_request":
            with self.lock:
                live["pending"] = [p for p in live["pending"] if p["request_id"] != o.get("request_id")]
            self.out("  ↳ Claude withdrew its question", dim=True)
            self.set_state()
        elif kind == "system" and sub == "init":
            with self.lock:
                live.update(conversation=o.get("session_id"), model=o.get("model"),
                            version=o.get("claude_code_version"))
                self.set_mode(o.get("permissionMode"))
            set_conversation_id(self.sid, o.get("session_id") or "")
            self.changed()
        elif kind == "system" and sub == "status":
            if o.get("permissionMode"):
                self.remember(mode=o["permissionMode"])
            with self.lock:
                if "permissionMode" in o:
                    self.set_mode(o["permissionMode"])
                if o.get("status") == "requesting":
                    self.busy = True
            self.set_state()
            self.changed()
        elif kind == "system" and sub == "background_tasks_changed":
            with self.lock:
                # When each began (Claude Code doesn't say): when we first saw it.
                began = {t.get("task_id"): t.get("started") for t in live.get("tasks") or []}
                live["tasks"] = [{**t, "started": began.get(t.get("task_id")) or time.time()}
                                 for t in o.get("tasks") or [] if isinstance(t, dict)]
            self.changed(True)
        elif kind == "system" and sub == "task_notification":
            self.out(f"  ⏺ background task {o.get('status', 'done')}: {o.get('summary') or o.get('task_id')}", dim=True)
        elif kind == "system" and sub == "session_title_changed":
            self.set_title(o.get("title"))
        elif kind == "system" and sub == "compact_boundary":
            self.out("  · conversation compacted", dim=True)
        elif kind == "system" and sub == "peer_message_hold":
            self.out(f"  · a message from {o.get('from_name') or o.get('from')} was {o.get('state')}", dim=True)
        elif kind == "command_lifecycle" and o.get("state") == "started":
            with self.lock:
                self.busy = True
            self.set_state()
        elif kind == "stream_event":
            self.on_stream(o.get("event") or {})
        elif kind == "assistant":
            self.on_assistant(o)
        elif kind == "user":
            self.on_user(o)
        elif kind == "rate_limit_event":
            info = o.get("rate_limit_info") or {}
            with self.lock:
                live["rate_limits"] = info
            self.changed()
        elif kind == "result":
            self.on_result(o)

    def on_request(self, o):
        req = o.get("request") or {}
        if req.get("subtype") != "can_use_tool":
            # Nothing else was declared in initialize (hooks, MCP servers,
            # dialogs): say so, so Claude doesn't wait on it.
            self.write({"type": "control_response", "response": {
                "subtype": "error", "request_id": o.get("request_id"),
                "error": f"amarchy agent doesn't handle {req.get('subtype')}"}})
            return
        pending = {"request_id": o["request_id"], "tool": req.get("tool_name"), "input": req.get("input") or {},
                   "description": req.get("description") or req.get("display_name"),
                   "suggestions": req.get("permission_suggestions") or [], "reason": req.get("decision_reason"),
                   "tool_use_id": req.get("tool_use_id"), "at": time.time(),
                   "answered": {}}     # AskUserQuestion's questions answered so far, one by one
        with self.lock:
            self.live["pending"].append(pending)
        self.draw_request(pending)
        self.set_state()
        agent_status(self.sid, "waiting")      # again: a hook may have said working since the first
        self.changed(True)

    def draw_request(self, p):
        tool, given = p["tool"], p["input"]
        if tool == "AskUserQuestion":
            for q in given.get("questions") or []:
                self.out(f"\n  \033[1m? {q.get('question')}\033[0m" + ("  (several: 1,3)" if q.get("multiSelect") else ""))
                for i, opt in enumerate(q.get("options") or [], 1):
                    self.out(f"    {i}. {opt.get('label')}" + (f" \033[2m{opt.get('description')}\033[0m"
                                                              if opt.get("description") else ""))
            self.out("  Type the number of your answer (one question at a time), or your own words.", dim=True)
        elif tool == "ExitPlanMode":
            self.out("\n  \033[1m? Claude's plan:\033[0m")
            for line in str(given.get("plan") or "").splitlines():
                self.out(f"    {line}")
            self.out("  y: approve and start · a: approve, and accept edits without asking · "
                     "n <what to change>: keep planning", dim=True)
        else:
            self.out(f"\n  \033[1m? Claude wants to use {tool_line(tool, given)}\033[0m")
            if p["reason"]:
                self.out(f"    {p['reason']}", dim=True)
            self.out("  y: allow · a: always allow · n [why]: don't allow", dim=True)

    def on_stream(self, ev):
        t = ev.get("type")
        if t == "message_start":
            with self.lock:
                self.busy = True
                self.live["partial"] = ""
            self.set_state()
        elif t == "content_block_start":
            block = ev.get("content_block") or {}
            with self.lock:
                self.live["thinking"] = block.get("type") == "thinking"
                if block.get("type") == "text":
                    self.live["partial"] = ""
            if block.get("type") == "text" and not self.at_line_start:
                self.out("")
            self.changed()
        elif t == "content_block_delta":
            delta = ev.get("delta") or {}
            if delta.get("type") == "text_delta":
                text = delta.get("text") or ""
                with self.lock:
                    self.live["partial"] += text
                self.out(text, newline=False)
                self.changed()
        elif t == "content_block_stop":
            with self.lock:
                self.live["thinking"] = False
            self.changed()

    def on_assistant(self, o):
        if o.get("parent_tool_use_id"):
            # A helper's (subagent's): the step it's on, under its Agent call's.
            steps = [b for b in o["message"].get("content") or [] if b.get("type") == "tool_use"]
            with self.lock:
                act = self.live["activity"]
                if steps and act and act.get("id") == o["parent_tool_use_id"]:
                    act["step"] = {"tool": steps[-1].get("name"), "input": steps[-1].get("input")}
            if steps:
                self.changed()
            return
        for block in o["message"].get("content") or []:
            if block.get("type") == "text":
                with self.lock:
                    self.live["partial"] = ""
                self.changed()
            elif block.get("type") == "tool_use":
                with self.lock:
                    self.live["activity"] = {"tool": block.get("name"), "input": block.get("input"),
                                             "id": block.get("id"), "since": time.time()}
                if block.get("name") not in ("ToolSearch",):
                    self.out(f"  ⏺ {tool_line(block.get('name'), block.get('input'))}"[:400], dim=True)
                self.changed()
        if not self.at_line_start:
            self.out("", newline=True)

    def on_user(self, o):
        content = o["message"].get("content")
        if o.get("isReplay") or isinstance(content, str):
            # What went in to Claude: ours, or a message from another session.
            text = content if isinstance(content, str) else " ".join(
                b.get("text", "") if b.get("type") == "text" else f"[{b.get('type')}]" for b in content or [])
            m = re.fullmatch(r"\s*<local-command-std(?:out|err)>(.*)</local-command-std(?:out|err)>\s*", text, re.S)
            if m:
                self.out(f"  · {m.group(1).strip()}", dim=True)
            elif text.strip():
                self.out(f"\n\033[1m› {text.strip()}\033[0m\n")
            return
        for block in content if isinstance(content, list) else []:
            if block.get("type") == "tool_result":
                with self.lock:
                    act = self.live["activity"]
                    if act and act.get("id") == block.get("tool_use_id"):
                        self.live["activity"] = None
                if block.get("is_error") and not o.get("parent_tool_use_id"):
                    first = json.dumps(block.get("content"))[:160] if not isinstance(block.get("content"), str) \
                        else block["content"].splitlines()[0][:160] if block["content"] else ""
                    self.out(f"    ✗ {first}", dim=True)
                self.changed()

    def on_result(self, o):
        with self.lock:
            self.busy = False
            self.live["turns"] += 1
            self.live["activity"] = None
            self.live["partial"] = ""
            self.live["cost_usd"] = round(self.live["cost_usd"] + float(o.get("total_cost_usd") or 0), 6)
            self.live["last_result"] = {k: o.get(k) for k in ("subtype", "is_error", "duration_ms", "num_turns",
                                                               "total_cost_usd", "stop_reason", "session_id")}
            if o.get("session_id"):
                self.live["conversation"] = o["session_id"]
        set_conversation_id(self.sid, o.get("session_id") or "")
        took = (o.get("duration_ms") or 0) / 1000
        stopped = o.get("subtype") == "error_during_execution"
        note = "interrupted" if stopped else (
            "error: " + str(o.get("result") or o.get("subtype")) if o.get("is_error") else "done")
        self.out(f"  · {note} · {took:.1f}s", dim=True)
        self.set_state()
        self.changed(True)
        # The Stop hook says idle (and done) after a turn that ended on its
        # own; one you stopped, or one that failed, ends without it.
        with self.lock:
            idle = not self.busy and not self.live["pending"] and not self.queue
        if idle:
            agent_status(self.sid, "idle", done=not stopped)
        self.next_queued()
        if not self.titled:
            self.titled = True
            threading.Thread(target=self.name_conversation, daemon=True).start()

    def name_conversation(self):
        """Claude Code's TUI titles a conversation (the list's name for the
        session comes from it); under -p it doesn't. A conversation without
        one gets one, from its first message, the way the TUI's would read."""
        s = session(self.sid) or self.s
        f = transcript(s)
        if not f:
            self.titled = False     # no conversation yet: after the next turn
            return
        first, title = None, None
        try:
            with open(f, "rb") as fh:
                for line in fh:
                    if b'"ai-title"' in line or b'"custom-title"' in line:
                        try:
                            d = json.loads(line)
                            title = d.get("customTitle") or d.get("aiTitle") or title
                        except ValueError:
                            pass
                    elif first is None and b'"type":"user"' in line:
                        try:
                            r = json.loads(line)
                        except ValueError:
                            continue
                        content = (r.get("message") or {}).get("content")
                        if r.get("isMeta") or r.get("isSidechain") or not isinstance(content, (str, list)):
                            continue
                        item = user_item(message_text(content))
                        first = item["text"] if item and item["kind"] == "user" else None
        except OSError:
            return
        title = title or our_title(self.sid, f)
        if title:
            self.set_title(title)
            return
        if not first:
            self.titled = False     # nothing said yet: after the next turn
            return
        title = conversation_title(first)
        if title:
            # Kept by amarchy (saved_title reads it), not given to Claude:
            # rename_session would rename the session for ListAgents too.
            write_file(self.dir / "title", json.dumps({"conversation": f.stem, "title": title}))
            self.set_title(title)

    def set_title(self, title):
        """The conversation's title, as the TUI shows it: the pane's title,
        which the list reads (host_titles)."""
        title = " ".join(str(title or "").split())[:200]
        if not title:
            return
        with self.lock:
            self.live["title"] = title
        with self.write_lock:
            sys.stdout.write(f"\033]0;{title}\007")
            sys.stdout.flush()
        self.changed()

    # ---- watchers on the socket

    def broadcast(self, o):
        if not self.watchers:
            return
        line = (json.dumps(o) + "\n").encode()
        with self.lock:
            watchers = list(self.watchers)
        for w in watchers:
            try:
                w.sendall(line)
            except OSError:
                with self.lock:
                    if w in self.watchers:
                        self.watchers.remove(w)

    # ---- the socket

    def serve(self):
        self.sock_path.unlink(missing_ok=True)
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(str(self.sock_path))
        os.chmod(self.sock_path, 0o600)
        self.server.listen(16)
        while not self.done.is_set():
            try:
                conn, _ = self.server.accept()
            except OSError:
                break
            threading.Thread(target=self.client, args=(conn,), daemon=True).start()

    def client(self, conn):
        keep = False
        try:
            data = b""
            while not data.endswith(b"\n") and len(data) < 32_000_000:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
            try:
                request = json.loads(data)
                if not isinstance(request, dict):
                    raise ValueError
            except ValueError:
                request = {}
            if request.get("op") == "watch":
                conn.sendall((json.dumps({"ok": True, "live": self.live}) + "\n").encode())
                with self.lock:
                    self.watchers.append(conn)
                keep = True
                return
            try:
                answer = self.op(request)
            except Exception as e:
                answer = {"ok": False, "error": f"{type(e).__name__}: {e}"}
            conn.sendall((json.dumps(answer) + "\n").encode())
        except OSError:
            pass
        finally:
            if not keep:
                conn.close()

    def op(self, r):
        """One request on the socket: its answer."""
        op = r.get("op")
        if op == "state":
            with self.lock:
                return {"ok": True, "live": dict(self.live)}
        if self.live["state"] == "exited":
            return {"ok": False, "error": "Claude isn't running"}
        if op == "send":
            content = r.get("content")
            if not (isinstance(content, str) and content.strip()) and not (isinstance(content, list) and content):
                return {"ok": False, "error": "nothing to send"}
            when = r.get("when") or "idle"
            if when not in ("idle", "next", "now", "later"):
                return {"ok": False, "error": f"when is idle, next, now or later, not {when!r}"}
            return self.send(content, "idle" if when == "idle" else when, r.get("uuid"))
        if op == "attach":
            return self.attach(r.get("images"))
        if op == "unqueue":
            # Taken back: its content comes with the answer (Send now, Edit
            # keep its images).
            with self.lock:
                taken = next((m for m in self.queue if m["uuid"] == r.get("uuid")), None)
                self.queue = [m for m in self.queue if m is not taken]
            self.queue_changed()
            return {"ok": True, "response": {"content": taken["content"]}} if taken \
                else {"ok": False, "error": "no such message waiting"}
        if op == "answer":
            # {request_id, choice: allow|always|deny, message, answers, mode},
            # {request_id, question, answer} (one of several questions), or
            # {request_id, response} (the control response's, as is).
            with self.lock:
                p = next((p for p in self.live["pending"] if p["request_id"] == r.get("request_id")), None)
            if not p:
                return {"ok": False, "error": "Claude doesn't wait for that answer anymore", "gone": True}
            if "question" in r:
                return self.answer_question(p["request_id"], r.get("question"), r.get("answer"))
            response = r.get("response")
            if response is None:
                response = agent_response(p, r.get("choice"), r.get("message"), r.get("answers"), r.get("mode"),
                                          r.get("suggestions"), r.get("annotations"))
                if isinstance(response, str):
                    return {"ok": False, "error": response}
            if not isinstance(response, dict) or response.get("behavior") not in ("allow", "deny"):
                return {"ok": False, "error": "response is {behavior: allow|deny, ...}"}
            if response["behavior"] == "allow" and "updatedInput" not in response:
                response = {**response, "updatedInput": p["input"]}
            if response["behavior"] == "deny" and not response.get("message"):
                response = {**response, "message": "The user doesn't want to proceed with this tool use."}
            return self.answer(r.get("request_id"), response)
        if op == "interrupt":
            res = self.control({"subtype": "interrupt", **({"cancel_queued": True} if r.get("everything") else {})})
            if r.get("everything"):
                with self.lock:
                    self.queue = []
                self.queue_changed()
            return {"ok": res.get("subtype") == "success", "response": res.get("response"), "error": res.get("error")}
        if op == "control":
            request = r.get("request")
            if not isinstance(request, dict) or not request.get("subtype"):
                return {"ok": False, "error": "request is {subtype: ..., ...}"}
            res = self.control(request, timeout=float(r.get("timeout") or 30))
            ok = res.get("subtype") == "success"
            if ok and request["subtype"] == "set_permission_mode":
                with self.lock:
                    self.set_mode(request.get("mode"))
                self.remember(mode=request.get("mode"))
                self.changed(True)
            if ok and request["subtype"] == "set_model":
                with self.lock:
                    self.live["model"] = (res.get("response") or {}).get("model") or request.get("model")
                self.remember(model=request.get("model"))
                self.changed(True)
            return {"ok": ok, "response": res.get("response"), "error": res.get("error")}
        if op == "stop":
            threading.Thread(target=self.stop, daemon=True).start()
            return {"ok": True}
        return {"ok": False, "error": f"unknown op {op!r}"}

    # ---- the pane's keyboard

    def read_tty(self):
        """What's typed in the pane: a message for Claude, or the answer to
        what it asks. A paste (the app's composer, amarchy send) arrives
        bracketed, so its lines stay one message."""
        for line in sys.stdin:
            line = line.rstrip("\n")
            if "\033[200~" in line:
                self.pasting = True
                line = line.replace("\033[200~", "")
            if "\033[201~" in line:
                self.pasting = False
                line = line.replace("\033[201~", "")
            self.typed.append(line)
            if self.pasting:
                continue
            text, self.typed = "\n".join(self.typed).strip("\n"), []
            if text.strip():
                try:
                    self.typed_text(text)
                except OSError:
                    break

    def typed_text(self, text):
        with self.lock:
            p = self.live["pending"][0] if self.live["pending"] else None
        if not p:
            self.send(text)
            return
        word, _, rest = text.strip().partition(" ")
        word = word.lower()
        if p["tool"] == "AskUserQuestion":
            # One question at a time, in order; the last answer sends them all.
            questions = [q for q in p["input"].get("questions") or [] if isinstance(q, dict)]
            q = next((q for q in questions if q.get("question") not in p["answered"]), None)
            if q:
                opts = q.get("options") or []
                picks = [x.strip() for x in text.split(",")]
                chosen = [opts[int(x) - 1]["label"] for x in picks if x.isdigit() and 0 < int(x) <= len(opts)]
                self.answer_question(p["request_id"], q.get("question"),
                                     ", ".join(chosen) if chosen and len(chosen) == len(picks) else text.strip())
        elif word in ("y", "yes", "a", "always", "n", "no"):
            choice = {"y": "allow", "a": "always", "n": "deny"}[word[0]]
            plan = p["tool"] == "ExitPlanMode"
            response = agent_response(p, "allow" if plan and choice == "always" else choice, rest,
                                      mode="acceptEdits" if plan and choice == "always" else None)
            if isinstance(response, str):
                self.out(f"  {response}", dim=True)
            else:
                self.answer(p["request_id"], response)
        else:
            self.out("  y, a or n (with why, if you like)", dim=True)

    # ---- the whole of it

    def stop(self):
        """End Claude as quitting it would; run() then returns."""
        try:
            self.claude.stdin.close()
        except (OSError, AttributeError):
            pass
        try:
            self.claude.terminate()
            self.claude.wait(8)
        except subprocess.TimeoutExpired:
            self.claude.kill()
        except AttributeError:
            pass

    def run(self):
        s = self.s
        self.dir.mkdir(parents=True, exist_ok=True)
        # One Claude per conversation: one going (its pane restarted, the
        # engine switched) has a few seconds to let it go.
        other = claim_driver(self.sid, "chat")
        if other:
            print(f"\n  \033[31mThis conversation is open in another Claude already (pid {other.get('pid')}, "
                  f"the {other.get('engine')} engine).\033[0m\n", flush=True)
            return 1
        path = Path(s["path"])
        os.chdir(path)
        os.environ["PWD"] = str(path)
        prompt = s.pop("prompt", None)
        if prompt is not None:
            save_session(s)
        sent = take(self.dir / "send")
        first = [m for m in (prompt, sent) if m is not None and m.strip()]
        if sys.stdin.isatty():
            sh("stty", "sane", "-echoctl")      # raw from the sleep loop's wait for a key; a paste's end unseen
            print("\033[H\033[2J\033[3J", end="")
        print(f"\033]0;amarchy:{s['id']}\007", end="")      # the list then reads the conversation's title
        if transcript(s) and sys.stdout.isatty():
            # The conversation so far, as the pane showed it before (asleep,
            # or in the TUI): Claude under -p doesn't print it again.
            try:
                width = os.get_terminal_size().columns
            except OSError:
                width = 100
            self.out("\n".join(conversation_lines(s, width)))
        self.out(f"\n  \033[1m{s['repo']} · {s['name']}\033[0m \033[2m· Claude Code on amarchy's chat engine "
                 f"(the new chat)\033[0m\n")
        argv = agent_argv(s)
        try:
            self.claude = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                           text=True, bufsize=1, env=agent_env(s), cwd=path,
                                           start_new_session=True)    # the pane's Ctrl+C is ours (Stop), not its
        except OSError as e:
            self.out(f"  \033[31mCouldn't start Claude Code: {e}\033[0m")
            return 1
        self.live["claude_pid"] = self.claude.pid
        write_file(self.dir / "driver", json.dumps({"pid": os.getpid(), "claude_pid": self.claude.pid,
                                                    "engine": "chat", "since": time.time()}))
        self.flush_live()
        self.titled = True
        threading.Thread(target=self.name_conversation, daemon=True).start()     # one it has already
        for target in (self.read_claude, self.read_claude_err, self.serve, self.live_writer):
            threading.Thread(target=target, daemon=True).start()
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, lambda *_: threading.Thread(target=self.stop, daemon=True).start())
        # Ctrl+C in the pane stops the turn, as Esc does in the TUI.
        signal.signal(signal.SIGINT, lambda *_: threading.Thread(
            target=lambda: self.busy and self.control({"subtype": "interrupt"}), daemon=True).start())
        info = self.control({"subtype": "initialize"}, timeout=60)
        if info.get("subtype") == "success":
            r = info.get("response") or {}
            write_file(self.dir / "agent.json", json.dumps({k: r.get(k) for k in (
                "commands", "models", "agents", "account", "output_style", "claude_code_version")}))
            with self.lock:
                self.live.update(account=r.get("account"), version=r.get("claude_code_version"),
                                 permission_mode=r.get("current_permission_mode"), state="idle")
            self.restore()
            agent_status(self.sid, "idle")
        else:
            with self.lock:
                self.live.update(state="idle", error=info.get("error"))
            self.out(f"  {info.get('error')}", dim=True)
        self.changed(True)
        for text in first:
            self.send(text)
        self.next_queued()
        if sys.stdin.isatty():
            sys.stdout.write("\033[?2004h")     # pastes come bracketed (read_tty)
            sys.stdout.flush()
            threading.Thread(target=self.read_tty, daemon=True).start()
        code = self.claude.wait()
        self.done.set()
        with self.lock:
            self.live.update(state="exited", pending=[], partial="", activity=None, exit_code=code)
            queued, self.queue = self.queue, []
            # Not sent yet: the next Claude of this session starts with them,
            # their images attached again for it.
            self.attached = [b for m in queued if isinstance(m["content"], list)
                             for b in m["content"] if b.get("type") == "image"] + self.attached
            self.save_attached()
            self.live["queue"] = []
        text = "\n\n".join(t for t in (message_text(m["content"]).strip() for m in queued) if t)
        if text:
            write_file(self.dir / "send", text)
        self.flush_live()
        # It won't say it's idle, if it stopped in a turn or a question.
        if asleep_since(self.sid) is None:
            agent_status(self.sid, "idle", done=False)
        try:
            self.server.close()
        except AttributeError:
            pass
        self.sock_path.unlink(missing_ok=True)
        self.out(f"  · Claude Code exited ({code})", dim=True)
        return 0


def touch_classic(sid):
    """The app has Claude's classic terminal open on the session: keep it on
    the TUI (classic_viewed), for CLASSIC_HOLD seconds from now."""
    write_file(claude_dir(sid) / "classic", f"{time.time()}\n")


def switch_engine(s, want, force=False):
    """Put a session's Claude on the other engine ("chat" or "terminal"),
    with the same conversation: once it's idle (a turn under way, or a
    question, would be cut), unless forced. Running, it stops (as quitting
    it would), and its pane starts again on the other one once it's gone (the
    two never run one conversation at once: claim_driver); asleep or not
    started, it wakes on it. "terminal" is Claude's classic terminal, and it
    holds only while the app keeps its heartbeat (touch_classic, classic_viewed):
    left alone, the session comes back to the chat by itself (follow_engines).
    None once done, else why not."""
    sid = s["id"]
    if want not in ENGINES:
        return "the engine is chat or terminal"
    if engine(s) == want:
        if want == "terminal":
            touch_classic(sid)
        else:
            (claude_dir(sid) / "classic").unlink(missing_ok=True)
        return None
    try:
        status = (STATUS / sid).read_text().strip()
    except OSError:
        status = "idle"
    if status in ("working", "waiting") and not force:
        return ("Claude is working: switch once it's done" if status == "working"
                else "Claude is asking you something: answer it first")
    if want == "terminal":
        touch_classic(sid)
    else:
        (claude_dir(sid) / "classic").unlink(missing_ok=True)
    s = session(sid) or s
    s["engine"] = want
    save_session(s)
    pane = host_pane(s)
    if pane and asleep_since(sid) is None and not s.get("setup"):
        if want == "terminal" and agent_up(sid):
            try:
                agent_call(sid, {"op": "stop"}, timeout=5)      # its queue kept for the TUI (send)
            except OSError:
                pass
        stop_claude(pane)
        end = time.time() + 10
        while claude_driver(sid) and time.time() < end:
            time.sleep(0.1)
        host_respawn(s)
    return None


def engine_blockers(s):
    """Why a session's Claude shouldn't go over to the other engine now, if
    anything: what the move would lose. The things that keep a session awake
    (sleep_blockers, which has a message typed in a classic terminal's prompt),
    and a classic terminal whose prompt isn't on its screen."""
    pane = host_pane(s)
    if not pane:
        return ["its pane isn't running"]
    reasons = sleep_blockers(s, pane, processes(), auto=False)
    if not reasons and engine(s) == "terminal" and claude_prompt(s) is None:
        reasons.append("its prompt isn't on screen")
    return reasons


def follow_engines():
    """What the timer does with the engines (before sleep_idle): every session
    runs on the chat engine. One on the TUI (from before the chat engine, or
    left on Claude's classic terminal with nobody looking at it any more) moves
    to the chat when it's safe: asleep at once (it wakes on the chat), awake
    once it's idle with nothing pending, no background task, no message queued
    and nothing typed in the TUI's prompt (engine_blockers). Its conversation
    carries over. One the app has its classic terminal open on stays put."""
    for s in sessions():
        sid = s["id"]
        if s.get("setup") or engine(s) == "chat" or classic_viewed(sid):
            continue
        if asleep_since(sid) is None:
            try:
                status = (STATUS / sid).read_text().strip()
            except OSError:
                status = "idle"
            if status != "idle" or engine_blockers(s):
                continue
        switch_engine(s, "chat")


def cmd_agent(args):
    """amarchy agent <id> (the broker, in a session's Claude pane), or one of
    its commands for a session on the chat engine (see usage)."""
    if not args:
        print(usage("agent"), file=sys.stderr)
        return 1
    commands = ("engine", "state", "send", "answer", "interrupt", "mode", "model", "watch", "control")
    if args[0] not in commands:
        if len(args) != 1:
            print(usage("agent"), file=sys.stderr)
            return 1
        s = session(args[0])
        if not s:
            return fail(f"no session {args[0]!r}")
        return Agent(s).run()
    cmd, rest = args[0], args[1:]
    if not rest:
        print(usage("agent"), file=sys.stderr)
        return 1
    s = session(rest[0])
    if not s:
        return fail(f"no session {rest[0]!r}")
    sid, rest = s["id"], rest[1:]
    if cmd == "engine":
        force = "--force" in rest
        rest = [a for a in rest if a != "--force"]
        if not rest:
            print(engine(s))
            return 0
        if len(rest) > 1 or rest[0] not in ("chat", "terminal"):
            return fail("amarchy agent engine <id> [chat|terminal] [--force]")
        why = switch_engine(s, rest[0], force)
        if why:
            return fail(f"{sid}: {why}")
        print(rest[0])
        return 0
    if engine(s) != "chat":
        return fail(f"{sid} runs on the terminal engine (amarchy agent engine {sid} chat switches it)")
    if cmd == "state":
        print(json.dumps(agent_live(sid), indent=1))
        return 0
    if not agent_up(sid):
        return fail(f"{sid}: its broker isn't running (asleep? amarchy wake {sid})")
    if cmd == "watch":
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.connect(str(agent_socket(sid)))
            c.sendall(b'{"op": "watch"}\n')
            try:
                for line in c.makefile():
                    print(line, end="", flush=True)
            except KeyboardInterrupt:
                pass
        return 0
    if cmd == "send":
        when = "idle"
        for flag in ("--now", "--next", "--later"):
            if flag in rest:
                rest.remove(flag)
                when = flag[2:]
        if len(rest) != 1:
            return fail("amarchy agent send <id> <text|-> [--next|--now|--later]")
        text = sys.stdin.read() if rest[0] == "-" else rest[0]
        request = {"op": "send", "content": text, "when": when}
    elif cmd == "answer":
        if len(rest) < 2:
            return fail("amarchy agent answer <id> <request id> allow|always|deny [why] | --json <response>")
        rid, verdict = rest[0], rest[1]
        if verdict == "--json":
            try:
                response = json.loads(rest[2])
            except (IndexError, ValueError):
                return fail("--json takes the response, e.g. '{\"behavior\": \"allow\"}'")
        elif verdict in ("allow", "always", "deny"):
            request = {"op": "answer", "request_id": rid, "choice": verdict, "message": " ".join(rest[2:])}
        else:
            return fail(f"allow, always or deny, not {verdict!r}")
        if verdict == "--json":
            request = {"op": "answer", "request_id": rid, "response": response}
    elif cmd == "interrupt":
        request = {"op": "interrupt", "everything": "--all" in rest}
    elif cmd == "mode":
        if len(rest) != 1 or rest[0] not in AGENT_MODES:
            return fail(f"amarchy agent mode <id> {'|'.join(AGENT_MODES)}")
        request = {"op": "control", "request": {"subtype": "set_permission_mode", "mode": rest[0]}}
    elif cmd == "model":
        if len(rest) != 1:
            return fail("amarchy agent model <id> <model>")
        request = {"op": "control", "request": {"subtype": "set_model", "model": rest[0]}}
    else:   # control
        try:
            request = {"op": "control", "request": json.loads(rest[0])}
        except (IndexError, ValueError):
            return fail("amarchy agent control <id> '<control request as JSON>'")
    try:
        answer = agent_call(sid, request)
    except OSError as e:
        return fail(f"{sid}: no answer from its broker: {e}")
    print(json.dumps(answer))
    return 0 if answer.get("ok") else 1


# ------------------------------------------------------------------ main

# What each command takes, for `amarchy <command> --help` and for catching an
# option it doesn't know before it acts on it: `close --help` would otherwise
# close the session, `new --help` start one named --help. Flags are the
# options it knows; values, those that take the next word (skipped when
# checking); text, those after which the rest is free text (a command, a
# prompt), left alone. Commands with None are plumbing whose arguments come
# from amarchy itself or from Claude Code: only a first --help is theirs (none for editor).
OPTIONS = {
    "new": ({"--prompt", "--no-jump", "--model", "--attach"}, {"--prompt", "--model", "--attach"}, set()),
    "add": ({"--new", "--github"}, set(), set()),
    "projects": ({"--github", "--json"}, set(), set()),
    "list": ({"--compact"}, set(), set()),
    "close": ({"--force"}, set(), set()),
    "rename": ({"--id", "--reset"}, {"--id"}, set()),
    "run": ({"--show", "--set", "--save", "--forget", "--list"}, {"--forget"}, {"--set", "--save"}),
    "priority": ({"--id"}, {"--id"}, set()),
    "group": (set(), set(), set()),
    "sort": (set(), set(), set()),
    "order": (set(), set(), set()),
    "sleep": ({"--force", "--all", "--after", "--idle"}, {"--after"}, set()),
    "wake": (set(), set(), set()),
    "theme": ({"--show", "--list", "--json", "--font", "--wallpaper", "--refresh-wallpapers", "--in-background",
               "--quiet"}, {"--font", "--wallpaper"}, set()),
    "sound": ({"--show", "--list", "--json", "--assistant"}, set(), set()),
    "app": ({"--status", "--test"}, set(), set()),
    "send": ({"--no-wait", "--timeout", "--queued"}, {"--timeout", "--queued"}, set()),
    "notify": ({"--session", "--urgent"}, {"--session"}, set()),
    "assistant": ({"--name", "--picture", "--crop"}, {"--name", "--picture", "--crop"}, set()),
    "alerts": (set(), set(), set()),
    "update": ({"--auto"}, set(), set()),
    "protocol-check": ({"--broker"}, set(), set()),
    "migrate": (set(), set(), set()),
    "dictation": ({"--status", "--json"}, set(), set()),
    "automations": ({"--json"}, set(), set()),
    "today": ({"--json", "--loops"}, set(), set()),
    "secret": ({"--why", "--all", "--all-projects", "--global", "--again", "--timeout", "--project", "--json"},
               {"--why", "--timeout", "--project"}, set()),
    "terminals": (set(), set(), set()),
    "shell": None,
    "claude": None, "asleep": None, "woke": None, "hook": None, "seen": None,
    "reap": None, "shorten": None, "attach": None, "held": None,
    "paste": None, "agent": None, "brief-mcp": None, "claude-reload": None,
}
HELP = ("-h", "--help")
OLD_USAGE = {"order": "  amarchy order [opened|activity]       from before `amarchy group`: activity is "
                      "`group status on`, opened `group status off`"}


def usage(cmd):
    """The lines of this file's docstring for one command (with the ones
    continuing them), or None for a command it doesn't know."""
    lines, found, keep = __doc__.splitlines(), [], False
    for line in lines:
        words = line.split()
        if line.startswith("  amarchy ") and len(words) > 1:
            names, i = [words[1]], 2
            while i + 1 < len(words) and words[i] == "|" and re.fullmatch(r"[a-z]+", words[i + 1]):
                names.append(words[i + 1])
                i += 2
            keep = cmd in names
            if keep:
                found.append(line)
        elif keep and line.startswith(" " * 40) and line.strip():
            found.append(line)
        else:
            keep = False
    if not found and cmd in OLD_USAGE:
        found = [OLD_USAGE[cmd]]
    return "usage:\n" + "\n".join(found) if found else None


def check_args(cmd, args):
    """`--help` or `-h` for a command: its usage (0). An option it doesn't know:
    the usage on stderr (1). Otherwise None, and the command runs."""
    spec = OPTIONS.get(cmd)
    if spec is None:
        if args[:1] and args[0] in HELP:
            print(usage(cmd))
            return 0
        return None
    flags, values, text = spec
    it = iter(args)
    for a in it:
        if a in HELP:
            print(usage(cmd))
            return 0
        name = a.split("=", 1)[0] if cmd == "new" and re.match(r"--(prompt|model|attach)=", a) else a     # new's --option=value
        if name in text:
            break
        if name in values and name == a:
            next(it, None)
        elif re.fullmatch(r"--[A-Za-z][\w-]*(=.*)?", a) and name not in flags:
            print(f"amarchy {cmd}: unknown option {name}\n{usage(cmd)}", file=sys.stderr)
            return 1
    return None


def cmd_help(args):
    """`amarchy help [command]`: everything, or one command's usage."""
    if not args:
        print(__doc__)
        return 0
    cmd = args[0]
    text = usage(cmd) if cmd in OPTIONS else None
    if not text:
        return fail(f"unknown command {args[0]!r} (amarchy help lists them)")
    print(text)
    return 0


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("help", [])
    if cmd in ("help", *HELP):
        return cmd_help(args)
    if cmd not in OPTIONS:
        return fail(f"unknown command {cmd!r} (amarchy help lists them)")
    checked = check_args(cmd, args)
    if checked is not None:
        return checked
    if cmd == "new":
        return cmd_new(args)
    elif cmd == "add":
        return cmd_add(args)
    elif cmd == "projects":
        return cmd_projects(args)
    elif cmd == "close":
        return cmd_close(args)
    elif cmd == "rename":
        return cmd_rename(args)
    elif cmd == "priority":
        return cmd_priority(args)
    elif cmd == "list":
        print(json.dumps(session_view(), indent=None if "--compact" in args else 2))
    elif cmd == "run":
        return cmd_run(args)
    elif cmd == "theme":
        return cmd_theme(args)
    elif cmd == "sound":
        return cmd_sound(args)
    elif cmd == "group":
        return cmd_group(args)
    elif cmd == "sort":
        return cmd_sort(args)
    elif cmd == "order":
        return cmd_order(args)
    elif cmd == "hook" and len(args) == 2:
        cmd_hook(*args)
    elif cmd == "seen" and len(args) == 1:
        return cmd_seen(args[0])
    elif cmd == "sleep":
        return cmd_sleep(args)
    elif cmd == "wake":
        return cmd_wake(args)
    elif cmd == "reap" and len(args) == 1:
        return cmd_reap(args[0])
    elif cmd == "claude" and len(args) == 1:
        return cmd_claude(args[0])
    elif cmd == "shorten" and len(args) == 2:
        return cmd_shorten(*args)
    elif cmd == "asleep" and len(args) == 1:
        return cmd_asleep(args[0])
    elif cmd == "woke" and len(args) in (1, 2):
        return cmd_woke(args[0], args[1] if len(args) > 1 else "")
    elif cmd == "attach" and args:
        return cmd_attach(args)
    elif cmd == "held" and len(args) == 1:
        return cmd_held(args[0])
    elif cmd == "paste":
        return cmd_paste(args)
    elif cmd == "brief-mcp" and len(args) <= 1:
        return brief_mcp()
    elif cmd == "claude-reload" and len(args) == 1:
        return claude_reload(args[0])
    elif cmd == "agent":
        return cmd_agent(args)
    elif cmd == "app":
        return cmd_app(args)
    elif cmd == "send":
        return cmd_send(args)
    elif cmd == "notify":
        return cmd_notify(args)
    elif cmd == "assistant":
        return cmd_assistant(args)
    elif cmd == "alerts":
        return cmd_alerts(args)
    elif cmd == "update" and not [a for a in args if a != "--auto"]:
        return cmd_update(args)
    elif cmd == "migrate" and not args:
        migrate()
    elif cmd == "dictation":
        return cmd_dictation(args)
    elif cmd == "secret":
        return cmd_secret(args)
    elif cmd == "automations":
        return cmd_automations(args)
    elif cmd == "today":
        return cmd_today(args)
    elif cmd == "terminals":
        return cmd_terminals(args)
    elif cmd == "protocol-check":
        return cmd_protocol_check(args)
    elif cmd == "shell" and args:
        return cmd_shell(args)
    else:   # a command it knows, with the wrong number of arguments
        print(usage(cmd), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
