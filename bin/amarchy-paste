#!/bin/sh
# wl-paste for a session's Claude: Claude Code reads a pasted image (Ctrl+V)
# with wl-paste, and the server has no clipboard, so this reads what you last
# pasted or copied in the app (phone or browser). A session's Claude finds it
# first on its PATH, as a link named wl-paste. See "clipboard" in amarchy.
exec "$(dirname "$(readlink -f "$0")")/amarchy" paste "$@"
