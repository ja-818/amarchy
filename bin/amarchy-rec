#!/bin/sh
# rec (SoX) for a session's Claude on a host (amarchy remote): Claude Code's
# voice mode records with rec, and while you dictate on the phone (amarchy
# app) this is the phone's microphone; otherwise the real rec. A session's
# Claude finds it first on its PATH, as a link named rec. See "dictation from
# the phone" in amarchy.
#
# Straight on to the real rec unless a dictation is going on somewhere (one
# of its sockets is there): Claude asks rec --version at every key of voice
# mode, and gives up on one that's slow to answer.
self=$(readlink -f "$0")
uid=$(id -u)
for sock in "$HOME/.local/state/amarchy/app/mic/"*.sock "/run/user/$uid/amarchy-mic/"*.sock \
            "/tmp/amarchy-$uid/amarchy-mic/"*.sock; do
  if [ -S "$sock" ]; then
    case " $* " in
      *" --version "*) ;;
      *) exec "$(dirname "$self")/amarchy" rec "$@" ;;
    esac
  fi
done
IFS=:
for dir in $PATH; do
  # Not one of amarchy's (this one, or another checkout's: they'd hand it back).
  if [ -x "$dir/rec" ] && [ "${dir#/}" != "$dir" ] && [ "$(basename "$(readlink -f "$dir/rec")")" != amarchy-rec ]; then
    unset IFS
    exec "$dir/rec" "$@"
  fi
done
echo "rec (amarchy): SoX's rec isn't installed" >&2
exit 127
