pkgbase = amarchy-git
	pkgdesc = Stop babysitting your agents. Manage them: Claude Code chats in parallel, on one board
	pkgver = r0
	pkgrel = 1
	url = https://github.com/ja-818/amarchy
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = go
	makedepends = cargo
	makedepends = webkit2gtk-4.1
	makedepends = gtk3
	makedepends = libayatana-appindicator
	makedepends = python
	makedepends = tmux
	makedepends = jq
	makedepends = gst-plugins-base
	makedepends = gst-plugins-good
	makedepends = gst-plugin-pipewire
	makedepends = xdg-utils
	options = !lto
	options = !debug
	source = git+https://github.com/ja-818/amarchy.git
	sha256sums = SKIP
	source_x86_64 = transcribe-native-0.4.2-linux-x86_64.tar.gz::https://github.com/handy-computer/transcribe.cpp/releases/download/v0.4.2/transcribe-native-0.4.2-linux-x86_64-cpu-vulkan.tar.gz
	sha256sums_x86_64 = 4fe87db8919ea34e461db7987713b580f54e6f3ed610457c5d8fb8eac1a15046
	source_aarch64 = transcribe-native-0.4.2-linux-aarch64.tar.gz::https://github.com/handy-computer/transcribe.cpp/releases/download/v0.4.2/transcribe-native-0.4.2-linux-aarch64-cpu-vulkan.tar.gz
	sha256sums_aarch64 = 5e9cc7b244949fc686d1272e796e965411e80cc768533f1704c3c53e4c7d695e

pkgname = amarchy-git
	pkgdesc = Stop babysitting your agents. Manage them: Claude Code chats in parallel, on one board, from your phone and your desktop
	install = amarchy.install
	depends = python
	depends = git
	depends = tmux>=3.5
	depends = jq
	depends = glibc
	depends = bash
	depends = libgcc
	depends = libstdc++
	optdepends = claude-code: Claude Code, which every chat runs (or its own installer)
	optdepends = tailscale: your phone and your other machines reach this one (else amarchy-tailnet, included)
	optdepends = amarchy-desktop-git: the desktop app
	optdepends = ghostty: a chat in a Ghostty window (its menu, Advanced)
	optdepends = imagemagick: wallpapers cut for a phone and a computer
	optdepends = ffmpeg: wallpapers cut without ImageMagick, and dictation from any recording
	optdepends = python-fonttools: the fonts cut smaller for the app
	optdepends = quickshell: the Ⓐ in the bar on Omarchy (Omarchy has it)
	provides = amarchy
	conflicts = amarchy

pkgname = amarchy-desktop-git
	pkgdesc = amarchy's desktop app: stop babysitting your agents, manage them (the board, chats and notifications of your amarchy)
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = libayatana-appindicator
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = gst-plugin-pipewire
	depends = hicolor-icon-theme
	depends = xdg-utils
	depends = glibc
	depends = libgcc
	depends = glib2
	depends = cairo
	depends = gdk-pixbuf2
	depends = libsoup3
	depends = dbus
	optdepends = amarchy-git: run chats on this computer too
	optdepends = tailscale: reach your amarchy on your tailnet
	provides = amarchy-desktop
	conflicts = amarchy-desktop
