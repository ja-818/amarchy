# Maintainer: Julian Arango <julianarango1818 at gmail dot com>
# amarchy's main, pinned by the upstream watch in .omarchy/package.json
# (bin/sync-upstream): every new commit on main becomes a commit pin here,
# versioned r<commits on main>.g<sha>, built and checksummed like a release.
# The recipe is amarchy's packaging/arch/PKGBUILD (made by its
# packaging/omarchy-pkgs/make-recipe.sh).

pkgbase=amarchy-git
pkgname=('amarchy-git' 'amarchy-desktop-git')
_repo=amarchy
pkgver=r500.g3adcb77
pkgrel=1
_commit=3adcb7776ecd33ec4c79e094b51f763d73f8f5f5
pkgdesc="Stop babysitting your agents. Manage them: Claude Code chats in parallel, on one board"
arch=('x86_64' 'aarch64')
url="https://github.com/ja-818/amarchy"
license=('MIT')
# Every package's depends too: makepkg installs only these for a split build.
makedepends=('git' 'go' 'cargo' 'webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator'
             'python' 'tmux' 'jq' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugin-pipewire' 'xdg-utils')
options=('!lto' '!debug')
source=("$_repo::git+$url.git#commit=${_commit}")
sha256sums=('07f53f7b3d19c906d8fe296de171a1785214c807b30cb15e38bb0d079faa67ec')

prepare() {
  cd "$_repo/desktop"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  cd ../tailnet
  export GOPATH="$srcdir/gopath"
  go mod download -x >/dev/null
}

build() {
  cd "$_repo/desktop"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # The build's own paths out of the binary (its panic messages name them).
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/usr/src/debug/cargo"
  cargo build --frozen --release

  # amarchy's own Tailscale node, as Arch builds Go.
  cd ../tailnet
  export GOPATH="$srcdir/gopath"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-linkmode=external -X main.version=$(git rev-parse --short HEAD)" \
    -o build/amarchy-tailnet ./cmd/amarchy-tailnet
}

check() {
  cd "$_repo"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/usr/src/debug/cargo"
  python -m py_compile bin/amarchy
  rm -rf bin/__pycache__
  local script
  for script in install.sh omarchy/install.sh tailnet/install.sh desktop/install.sh; do bash -n "$script"; done
  ./tailnet/build/amarchy-tailnet --version
  cd desktop
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package_amarchy-git() {
  pkgdesc="Stop babysitting your agents. Manage them: Claude Code chats in parallel, on one board, from your phone and your desktop"
  # git, tmux and jq are run, not linked: namcap can't see them.
  depends=('python' 'git' 'tmux>=3.5' 'jq' 'glibc' 'bash')
  optdepends=('claude-code: Claude Code, which every chat runs (or its own installer)'
              'tailscale: your phone and your other machines reach this one (else amarchy-tailnet, included)'
              'amarchy-desktop-git: the desktop app'
              'ghostty: a chat in a Ghostty window (Ctrl+Alt+O)'
              'imagemagick: wallpapers cut for a phone and a computer'
              'ffmpeg: wallpapers cut without ImageMagick, and dictation from any recording'
              'python-fonttools: the fonts cut smaller for the app'
              'whisper-cpp: dictation written down on this machine'
              'quickshell: the Ⓐ in the bar on Omarchy (Omarchy has it)')
  provides=('amarchy')
  conflicts=('amarchy')
  install=amarchy.install

  cd "$_repo"
  local share="$pkgdir/usr/share/amarchy"
  install -d "$share/bin" "$share/tailnet" "$share/desktop"
  install -m755 bin/amarchy bin/amarchy-paste bin/amarchy-protocol-test "$share/bin/"
  cp -r --no-preserve=ownership app themes fonts sounds skill omarchy "$share/"
  install -m755 install.sh "$share/install.sh"
  # Their installers, which defer to the packages: the node and the desktop
  # app are built here, not by them.
  install -m755 tailnet/install.sh "$share/tailnet/install.sh"
  install -m755 desktop/install.sh "$share/desktop/install.sh"
  # The commit it's built from: amarchy's version (what a machine says to
  # its peers), and how its updates are noticed (amarchy update).
  git rev-parse --short=12 HEAD >"$share/.version"
  find "$share" -name __pycache__ -prune -exec rm -rf {} +
  chmod -R u=rwX,go=rX "$share"
  chmod 755 "$share/bin/"* "$share/install.sh" "$share/omarchy/install.sh" "$share/tailnet/install.sh" \
    "$share/desktop/install.sh"

  install -d "$pkgdir/usr/bin"
  ln -s /usr/share/amarchy/bin/amarchy "$pkgdir/usr/bin/amarchy"
  install -Dm755 tailnet/build/amarchy-tailnet "$pkgdir/usr/bin/amarchy-tailnet"

  install -Dm644 README.md "$pkgdir/usr/share/doc/amarchy/README.md"
  install -Dm644 docs/guide.md "$pkgdir/usr/share/doc/amarchy/guide.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_amarchy-desktop-git() {
  pkgdesc="amarchy's desktop app: stop babysitting your agents, manage them (the board, chats and notifications of your amarchy)"
  # libayatana-appindicator (the tray), GStreamer's plugins (sound, the mic)
  # and xdg-utils are opened at run time, not linked: namcap can't see them.
  depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugin-pipewire'
           'hicolor-icon-theme' 'xdg-utils' 'glibc' 'libgcc' 'glib2' 'cairo' 'gdk-pixbuf2' 'libsoup3' 'dbus')
  optdepends=('amarchy-git: run chats on this computer too'
              'tailscale: reach your amarchy on your tailnet')
  provides=('amarchy-desktop')
  conflicts=('amarchy-desktop')

  cd "$_repo/desktop"
  install -Dm755 target/release/amarchy-desktop "$pkgdir/usr/bin/amarchy-desktop"
  install -Dm644 amarchy.desktop "$pkgdir/usr/share/applications/amarchy.desktop"
  install -Dm644 icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/amarchy.png"
  install -Dm644 icons/64x64.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/amarchy.png"
  install -Dm644 icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/amarchy.png"
  install -Dm644 icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/amarchy.png"
  install -Dm644 icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/amarchy.png"
  install -Dm644 ../app/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/amarchy.svg"
  # In the tray from login, so its notifications come with its window closed.
  install -Dm644 /dev/stdin "$pkgdir/etc/xdg/autostart/amarchy.desktop" <<ENTRY
[Desktop Entry]
Type=Application
Name=Amarchy
Comment=amarchy in the tray, so its notifications come with its window closed
Exec=amarchy-desktop --hidden
Icon=amarchy
NoDisplay=true
X-GNOME-Autostart-enabled=true
ENTRY
  install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
