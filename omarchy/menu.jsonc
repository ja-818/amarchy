  // >>> amarchy (managed by amarchy/install.sh)
  // The amarchy menu (Ctrl+Alt+M, Super+Space → Amarchy). Rows guarded with
  // `when` show only on a session's workspace (or only off one).
  "amarchy": {"icon":"Ⓐ","label":"Amarchy","aliases":["agents","sessions"]},
  "amarchy.open": {"icon":"󰁔","label":"Go to amarchy","when":"! hyprctl activeworkspace | grep -q '^workspace ID .* ([AF]:'","action":"~/.local/bin/amarchy open"},
  "amarchy.new": {"icon":"󰐕","label":"New session","action":"~/.local/bin/amarchy new"},
  "amarchy.search": {"icon":"󰍉","label":"Search sessions","action":"~/.local/bin/amarchy search"},
  "amarchy.run": {"icon":"󰐊","label":"Run","when":"hyprctl activeworkspace | grep -q '^workspace ID .* ([AF]:'"},
  "amarchy.run.project": {"icon":"󰐊","label":"Run project","action":"~/.local/bin/amarchy run"},
  "amarchy.run.command": {"icon":"󰐊","label":"Run a command","action":"~/.local/bin/amarchy run --pick"},
  "amarchy.run.terminal": {"icon":"󰆍","label":"Terminal","action":"~/.local/bin/amarchy terminal"},
  "amarchy.session": {"icon":"󰘔","label":"This session","when":"hyprctl activeworkspace | grep -q '^workspace ID .* ([AF]:'"},
  "amarchy.session.rename": {"icon":"󰏫","label":"Rename","action":"~/.local/bin/amarchy rename"},
  "amarchy.session.raise": {"icon":"󰁝","label":"Raise priority","action":"~/.local/bin/amarchy priority up"},
  "amarchy.session.lower": {"icon":"󰁅","label":"Lower priority","action":"~/.local/bin/amarchy priority down"},
  "amarchy.session.sleep": {"icon":"󰒲","label":"Sleep","action":"~/.local/bin/amarchy sleep"},
  "amarchy.session.close": {"icon":"󰆴","label":"Close","action":"~/.local/bin/amarchy close --confirm"},
  "amarchy.sessions": {"icon":"󰕰","label":"Sessions"},
  "amarchy.sessions.next": {"icon":"󰁅","label":"Next session","when":"hyprctl activeworkspace | grep -q '^workspace ID .* ([AF]:'","action":"~/.local/bin/amarchy next"},
  "amarchy.sessions.prev": {"icon":"󰁝","label":"Previous session","when":"hyprctl activeworkspace | grep -q '^workspace ID .* ([AF]:'","action":"~/.local/bin/amarchy prev"},
  "amarchy.sessions.zen": {"icon":"󰊓","label":"Zen mode","when":"hyprctl activeworkspace | grep -q '^workspace ID .* ([AF]:'","action":"~/.local/bin/amarchy zen"},
  "amarchy.sessions.sleep": {"icon":"󰒲","label":"Sleep idle sessions","action":"~/.local/bin/amarchy sleep --all"},
  "amarchy.sessions.close": {"icon":"󰅖","label":"Close a session","action":"~/.local/bin/amarchy pick close"},
  "amarchy.add": {"icon":"󰉋","label":"Add project","action":"~/.local/bin/amarchy add"},
  "amarchy.settings": {"icon":"󰒓","label":"Settings"},
  "amarchy.settings.theme": {"icon":"󰏘","label":"Theme","action":"~/.local/bin/amarchy theme"},
  "amarchy.settings.sound": {"icon":"󰕾","label":"Sound","action":"~/.local/bin/amarchy sound"},
  "amarchy.settings.keys": {"icon":"󰌌","label":"Keys"},
  // The modifiers `amarchy keys` offers (KEY_MODS in bin/amarchy), ✓ on the one bound now.
  "amarchy.settings.keys.inside": {"icon":"󰌌","label":"Inside amarchy"},
  "amarchy.settings.keys.inside.ctrl-alt": {"icon":"󰌌","label":"Ctrl+Alt","checked":"grep -qx 'inside Ctrl+Alt' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'CTRL + ALT'"},
  "amarchy.settings.keys.inside.ctrl-shift": {"icon":"󰌌","label":"Ctrl+Shift","checked":"grep -qx 'inside Ctrl+Shift' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'CTRL + SHIFT'"},
  "amarchy.settings.keys.inside.alt-shift": {"icon":"󰌌","label":"Alt+Shift","checked":"grep -qx 'inside Alt+Shift' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'ALT + SHIFT'"},
  "amarchy.settings.keys.inside.ctrl-alt-shift": {"icon":"󰌌","label":"Ctrl+Alt+Shift","checked":"grep -qx 'inside Ctrl+Alt+Shift' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'CTRL + ALT + SHIFT'"},
  "amarchy.settings.keys.inside.super-alt": {"icon":"󰌌","label":"Super+Alt","checked":"grep -qx 'inside Super+Alt' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'SUPER + ALT'"},
  "amarchy.settings.keys.inside.super-ctrl": {"icon":"󰌌","label":"Super+Ctrl","checked":"grep -qx 'inside Super+Ctrl' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'SUPER + CTRL'"},
  "amarchy.settings.keys.inside.super-shift": {"icon":"󰌌","label":"Super+Shift","checked":"grep -qx 'inside Super+Shift' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'SUPER + SHIFT'"},
  "amarchy.settings.keys.inside.super-ctrl-alt": {"icon":"󰌌","label":"Super+Ctrl+Alt","checked":"grep -qx 'inside Super+Ctrl+Alt' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'SUPER + CTRL + ALT'"},
  "amarchy.settings.keys.inside.hyper": {"icon":"󰌌","label":"Hyper","checked":"grep -qx 'inside Hyper' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys inside 'MOD3'"},
  "amarchy.settings.keys.anywhere": {"icon":"󰌌","label":"From anywhere"},
  "amarchy.settings.keys.anywhere.ctrl-alt": {"icon":"󰌌","label":"Ctrl+Alt","checked":"grep -qx 'anywhere Ctrl+Alt' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'CTRL + ALT'"},
  "amarchy.settings.keys.anywhere.ctrl-shift": {"icon":"󰌌","label":"Ctrl+Shift","checked":"grep -qx 'anywhere Ctrl+Shift' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'CTRL + SHIFT'"},
  "amarchy.settings.keys.anywhere.alt-shift": {"icon":"󰌌","label":"Alt+Shift","checked":"grep -qx 'anywhere Alt+Shift' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'ALT + SHIFT'"},
  "amarchy.settings.keys.anywhere.ctrl-alt-shift": {"icon":"󰌌","label":"Ctrl+Alt+Shift","checked":"grep -qx 'anywhere Ctrl+Alt+Shift' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'CTRL + ALT + SHIFT'"},
  "amarchy.settings.keys.anywhere.super-alt": {"icon":"󰌌","label":"Super+Alt","checked":"grep -qx 'anywhere Super+Alt' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'SUPER + ALT'"},
  "amarchy.settings.keys.anywhere.super-ctrl": {"icon":"󰌌","label":"Super+Ctrl","checked":"grep -qx 'anywhere Super+Ctrl' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'SUPER + CTRL'"},
  "amarchy.settings.keys.anywhere.super-shift": {"icon":"󰌌","label":"Super+Shift","checked":"grep -qx 'anywhere Super+Shift' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'SUPER + SHIFT'"},
  "amarchy.settings.keys.anywhere.super-ctrl-alt": {"icon":"󰌌","label":"Super+Ctrl+Alt","checked":"grep -qx 'anywhere Super+Ctrl+Alt' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'SUPER + CTRL + ALT'"},
  "amarchy.settings.keys.anywhere.hyper": {"icon":"󰌌","label":"Hyper","checked":"grep -qx 'anywhere Hyper' ~/.local/state/amarchy/keys.bound","action":"~/.local/bin/amarchy keys anywhere 'MOD3'"},
  // <<< amarchy
