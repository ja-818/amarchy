# amarchy-relay as a systemd service on your own server, behind a reverse
# proxy that serves its HTTPS (Caddy, nginx). Install:
#
#   go build -trimpath -ldflags "-s -w" -o amarchy-relay ./cmd/amarchy-relay   (in relay/)
#   sudo install -m 755 amarchy-relay /usr/local/bin/
#   sudo install -m 600 deploy/amarchy-relay.env.example /etc/amarchy-relay.env   (then fill it in)
#   sudo install -m 644 deploy/amarchy-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now amarchy-relay
#   journalctl -u amarchy-relay -f
[Unit]
Description=amarchy-relay: a Web Push service in front of APNs and FCM for amarchy's phone apps
Documentation=https://github.com/ja-818/amarchy/tree/main/relay
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/amarchy-relay
# Read by systemd itself, as root: keep it 0600 root.
EnvironmentFile=/etc/amarchy-relay.env
# Keys as files, readable by this service only (uncomment, and leave
# APNS_KEY / FCM_CREDENTIALS out of the env file):
#LoadCredential=apns.p8:/etc/amarchy-relay/AuthKey.p8
#Environment=APNS_KEY_FILE=%d/apns.p8
#LoadCredential=fcm.json:/etc/amarchy-relay/service-account.json
#Environment=FCM_CREDENTIALS=%d/fcm.json
Restart=on-failure
RestartSec=2s
# 2 is a configuration problem: starting again won't fix it.
RestartPreventExitStatus=2
TimeoutStopSec=40s

# It needs the network and nothing else: no files, no privileges.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
