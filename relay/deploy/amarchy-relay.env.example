# amarchy-relay's configuration: copy it to /etc/amarchy-relay.env (0600,
# root), fill it in, and check it with:
#   sudo sh -c 'set -a; . /etc/amarchy-relay.env; amarchy-relay check'

# Where it listens: behind your reverse proxy, on this machine only.
RELAY_LISTEN=127.0.0.1:8099
# Its public address, as phones and machines reach it (your proxy's HTTPS).
RELAY_URL=https://relay.example.com
# Addresses it had before, comma separated: the endpoints phones hold there
# keep working (point them at it too).
#RELAY_OLD_URLS=
# The proxy appends the client's address to X-Forwarded-For (Caddy, nginx's
# $proxy_add_x_forwarded_for): the per-address limits use it. A proxy that
# puts it in a header of its own instead: name it.
RELAY_TRUST_PROXY=1
#RELAY_CLIENT_IP_HEADER=X-Real-IP

# The handles' secret: `amarchy-relay secret` makes one. Keep it: the
# endpoints phones hold open only with it. To change it, put the old one in
# RELAY_SECRETS (comma separated) so they still open.
RELAY_SECRET=
#RELAY_SECRETS=

# APNs (iPhone), on when these are set, all of them. A key from
# developer.apple.com (Keys, with Apple Push Notifications on): the base64
# inside its .p8 on one line,
#   grep -v -- ----- AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
# or the file itself, with the unit's LoadCredential (and no APNS_KEY here).
#APNS_KEY=
#APNS_KEY_ID=XXXXXXXXXX
#APNS_TEAM_ID=YYYYYYYYYY
# The iPhone apps it sends for: their bundle ids, comma separated.
#APNS_TOPICS=io.github.ja818.amarchy

# FCM (Android), on when FCM_PROJECT is set: your Firebase project, and a
# service account's key that may send with it (Firebase Cloud Messaging
# Admin), as a file: the unit's LoadCredential sets FCM_CREDENTIALS.
#FCM_PROJECT=
# The Android apps it sends for (none: any).
#FCM_APPS=io.github.ja818.amarchy

# Limits (these are the defaults): a device 30 at once then 15 a minute; an
# address 20 registrations then 20 an hour, and 300 pushes then 600 a minute.
#RELAY_DEVICE_BURST=30
#RELAY_DEVICE_PER_MIN=15
#RELAY_REGISTER_BURST=20
#RELAY_REGISTER_PER_HOUR=20
#RELAY_PUSH_BURST=300
#RELAY_PUSH_PER_MIN=600
